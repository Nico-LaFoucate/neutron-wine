+#pragma once
+
+#include <atomic>
+
+#include "d3d11_device_child.h"
+
+namespace dxvk {
+
+  class DxvkAdapter;
+
+  /**
+   * \brief Intel's "Intel Device Information" D3D11 counter
+   *
+   * NEUTRON (Neutron#53). Intel's Windows D3D11 driver exposes one device-dependent counter named
+   * "Intel Device Information" (description "Version 2"). Its GetData returns the ADDRESS of a
+   * driver-owned IntelDeviceInfoV2 block, not the data. Intel's GPU Detect sample
+   * (github.com/GameTechDev/gpudetect, GPUDetect.cpp GetIntelDeviceInfo) and apps built on it read
+   * the GPU generation and EU count from it; Premiere Pro's GPUSniffer does not initialize an Intel
+   * OpenCL device without it. Exposed only on Intel adapters (Vulkan vendor 0x8086).
+   * Kill switch NEUTRON_DXVK_INTEL_DEVINFO=0.
+   */
+  struct D3D11IntelDeviceInfoV2 {
+    DWORD GPUMaxFreq;     // MHz
+    DWORD GPUMinFreq;     // MHz
+    DWORD GTGeneration;   // Intel PRODUCT_FAMILY (gpudetect: INTEL_GPU_ARCHITECTURE)
+    DWORD EUCount;
+    DWORD PackageTDP;     // Watts, 0 = not known
+    DWORD MaxFillRate;    // pixels/clock, 0 = not known
+  };
+
+  static_assert(sizeof(D3D11IntelDeviceInfoV2) == 24, "IntelDeviceInfoV2 is 24 bytes");
+
+  class D3D11IntelDeviceInfo {
+
+  public:
+
+    /**
+     * \brief Whether the counter is exposed on this adapter
+     */
+    static bool IsExposed(const Rc<DxvkAdapter>& adapter);
+
+    /**
+     * \brief Counter strings as Intel's driver reports them
+     */
+    static const char* Name()        { return "Intel Device Information"; }
+    static const char* Units()       { return "Size 24"; }
+    static const char* Description() { return "Version 2"; }
+
+    /**
+     * \brief The process-lifetime info block for an adapter
+     *
+     * Gathered once per adapter, never freed: the counter hands out its
+     * address, as Intel's driver hands out driver-owned memory.
+     * \param [in] adapter The adapter
+     * \param [in] deviceId PCI device id the app sees through DXGI
+     */
+    static const D3D11IntelDeviceInfoV2* Get(const Rc<DxvkAdapter>& adapter, uint32_t deviceId);
+
+    /**
+     * \brief Intel PRODUCT_FAMILY value for a PCI device id, 0 if unknown
+     */
+    static uint32_t GetGTGeneration(uint32_t deviceId);
+
+  };
+
+
+  class D3D11IntelDeviceInfoCounter : public D3D11DeviceChild<ID3D11Counter> {
+
+  public:
+
+    D3D11IntelDeviceInfoCounter(
+            D3D11Device*                  pDevice,
+      const D3D11_COUNTER_DESC&           Desc,
+      const D3D11IntelDeviceInfoV2*       pInfo);
+
+    ~D3D11IntelDeviceInfoCounter();
+
+    HRESULT STDMETHODCALLTYPE QueryInterface(
+            REFIID                        riid,
+            void**                        ppvObject) final;
+
+    UINT STDMETHODCALLTYPE GetDataSize() final;
+
+    void STDMETHODCALLTYPE GetDesc(
+            D3D11_COUNTER_DESC*           pDesc) final;
+
+    HRESULT GetData(
+            void*                         pData,
+            UINT                          DataSize);
+
+    /**
+     * \brief Returns the counter if an async object is one
+     *
+     * Costs one atomic load while no counter exists. DXVK has no
+     * other ID3D11Counter, so the QueryInterface identifies ours.
+     */
+    static D3D11IntelDeviceInfoCounter* FromAsync(
+            ID3D11Asynchronous*           pAsync);
+
+  private:
+
+    D3D11_COUNTER_DESC                    m_desc;
+    const D3D11IntelDeviceInfoV2*         m_info;
+
+    static std::atomic<uint32_t>          s_liveCount;
+
+  };
+
