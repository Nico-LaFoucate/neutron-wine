+#ifdef _WIN32
+  static bool ReadUnixFile(const std::string& unixPath, std::string& data) {
+    typedef WCHAR* (CDECL *PFN_WineGetDosFileName)(LPCSTR);
+
+    static const auto wineGetDosFileName = reinterpret_cast<PFN_WineGetDosFileName>(
+      ::GetProcAddress(::GetModuleHandleW(L"kernel32.dll"), "wine_get_dos_file_name"));
+
+    if (!wineGetDosFileName)
+      return false;
+
+    WCHAR* dosName = wineGetDosFileName(unixPath.c_str());
+
+    if (!dosName)
+      return false;
+
+    HANDLE file = ::CreateFileW(dosName, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE,
+      nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+    ::HeapFree(::GetProcessHeap(), 0, dosName);
+
+    if (file == INVALID_HANDLE_VALUE)
+      return false;
+
+    char buffer[4096];
+    DWORD read = 0;
+    BOOL ok = ::ReadFile(file, buffer, sizeof(buffer) - 1, &read, nullptr);
+    ::CloseHandle(file);
+
+    if (!ok || !read)
+      return false;
+
+    data.assign(buffer, read);
+    return true;
+  }
+
+
+  static uint32_t ReadUnixNumber(const std::string& unixPath) {
+    std::string data;
+
+    if (!ReadUnixFile(unixPath, data))
+      return 0;
+
+    return uint32_t(std::strtoul(data.c_str(), nullptr, 10));
+  }
