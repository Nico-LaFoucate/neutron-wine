+
+  static IntelClInfo QueryIntelOpenCl(const IntelPciAddress& pci) {
+    IntelClInfo result;
+
+    HMODULE cl = ::LoadLibraryW(L"opencl.dll");
+
+    if (!cl) {
+      result.how = "no opencl.dll";
+      return result;
+    }
+
+    // Not freed: OpenCL ICDs do not all survive being unloaded, and the app may use it too
+    auto clGetPlatformIDs  = reinterpret_cast<PFN_ClGetPlatformIDs> (::GetProcAddress(cl, "clGetPlatformIDs"));
+    auto clGetPlatformInfo = reinterpret_cast<PFN_ClGetPlatformInfo>(::GetProcAddress(cl, "clGetPlatformInfo"));
+    auto clGetDeviceIDs    = reinterpret_cast<PFN_ClGetDeviceIDs>   (::GetProcAddress(cl, "clGetDeviceIDs"));
+    auto clGetDeviceInfo   = reinterpret_cast<PFN_ClGetDeviceInfo>  (::GetProcAddress(cl, "clGetDeviceInfo"));
+
+    if (!clGetPlatformIDs || !clGetPlatformInfo || !clGetDeviceIDs || !clGetDeviceInfo)
+      return result;
+
+    uint32_t platformCount = 0;
+
+    if (clGetPlatformIDs(0, nullptr, &platformCount) || !platformCount)
+      return result;
+
+    std::vector<void*> platforms(platformCount);
+
+    if (clGetPlatformIDs(platformCount, platforms.data(), nullptr))
+      return result;
+
+    struct Candidate { void* device; bool hasPci; uint32_t pci[4]; };
+    std::vector<Candidate> candidates;
+
+    for (void* platform : platforms) {
+      char vendor[256] = { };
+
+      if (clGetPlatformInfo(platform, ClPlatformVendor, sizeof(vendor) - 1, vendor, nullptr)
+       || !std::strstr(vendor, "Intel(R) Corporation"))
+        continue;
+
+      uint32_t deviceCount = 0;
+
+      if (clGetDeviceIDs(platform, ClDeviceTypeGpu, 0, nullptr, &deviceCount) || !deviceCount)
+        continue;
+
+      std::vector<void*> devices(deviceCount);
+
+      if (clGetDeviceIDs(platform, ClDeviceTypeGpu, deviceCount, devices.data(), nullptr))
+        continue;
+
+      for (void* device : devices) {
+        uint32_t vendorId = 0;
+
+        if (clGetDeviceInfo(device, ClDeviceVendorId, sizeof(vendorId), &vendorId, nullptr) || vendorId != 0x8086u)
+          continue;
+
+        Candidate c = { device, false, { } };
+        c.hasPci = !clGetDeviceInfo(device, ClDevicePciBusInfoKhr, sizeof(c.pci), c.pci, nullptr);
+        candidates.push_back(c);
+      }
+    }
+
+    const Candidate* chosen = nullptr;
+
+    if (pci.valid) {
+      for (const auto& c : candidates) {
+        if (c.hasPci && c.pci[0] == pci.domain && c.pci[1] == pci.bus
+         && c.pci[2] == pci.device && c.pci[3] == pci.function) {
+          chosen = &c;
+          result.how = "Intel OpenCL, same PCI address";
+        }
+      }
+    }
+
+    if (!chosen && candidates.size() == 1u) {
+      chosen = &candidates[0];
+      result.how = "the only Intel OpenCL GPU";
+    }
+
+    if (!chosen) {
+      if (!candidates.empty())
+        result.how = "no Intel OpenCL GPU at this PCI address";
+      return result;
+    }
+
+    uint32_t computeUnits = 0;
+    uint32_t maxClock = 0;
+    int32_t cuError = clGetDeviceInfo(chosen->device, ClDeviceMaxComputeUnits, sizeof(computeUnits), &computeUnits, nullptr);
+    int32_t clockError = clGetDeviceInfo(chosen->device, ClDeviceMaxClockFrequency, sizeof(maxClock), &maxClock, nullptr);
+
+    if (cuError || clockError)
+      Logger::warn(str::format("D3D11: Intel Device Information: OpenCL compute units error ", cuError, ", clock error ", clockError));
+
+    result.found = true;
+    result.computeUnits = computeUnits;
+    result.maxClockMhz = maxClock;
+    return result;
+  }
+
+
+  static std::string FindDrmCard(const IntelPciAddress& pci) {
+    if (!pci.valid)
+      return std::string();
+
+    char slot[64];
+    std::snprintf(slot, sizeof(slot), "PCI_SLOT_NAME=%04x:%02x:%02x.%x\n",
+      pci.domain, pci.bus, pci.device, pci.function);
+
+    for (uint32_t i = 0; i < 64u; i++) {
+      std::string card = str::format("/sys/class/drm/card", i);
+      std::string uevent;
+
+      if (ReadUnixFile(card + "/device/uevent", uevent) && uevent.find(slot) != std::string::npos)
+        return card;
+    }
+
+    return std::string();
+  }
+#endif
+
+
+  static IntelPciAddress GetPciAddress(const Rc<DxvkAdapter>& adapter) {
+    IntelPciAddress result;
+
+    auto vki = adapter->vki();
+    uint32_t count = 0;
+
+    if (vki->vkEnumerateDeviceExtensionProperties(adapter->handle(), nullptr, &count, nullptr) != VK_SUCCESS)
+      return result;
+
+    std::vector<VkExtensionProperties> extensions(count);
+
+    if (vki->vkEnumerateDeviceExtensionProperties(adapter->handle(), nullptr, &count, extensions.data()) != VK_SUCCESS)
+      return result;
+
+    bool supported = false;
+
+    for (const auto& e : extensions)
+      supported |= !std::strcmp(e.extensionName, VK_EXT_PCI_BUS_INFO_EXTENSION_NAME);
+
+    if (!supported)
+      return result;
+
+    VkPhysicalDevicePCIBusInfoPropertiesEXT pciInfo = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PCI_BUS_INFO_PROPERTIES_EXT };
+    VkPhysicalDeviceProperties2 properties = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_PROPERTIES_2 };
+    properties.pNext = &pciInfo;
+    vki->vkGetPhysicalDeviceProperties2(adapter->handle(), &properties);
+
+    result.valid = true;
+    result.domain = pciInfo.pciDomain;
+    result.bus = pciInfo.pciBus;
+    result.device = pciInfo.pciDevice;
+    result.function = pciInfo.pciFunction;
+    return result;
+  }
+
+
+  const D3D11IntelDeviceInfoV2* D3D11IntelDeviceInfo::Get(const Rc<DxvkAdapter>& adapter, uint32_t deviceId) {
+    std::lock_guard lock(g_intelInfoMutex);
+
+    DxvkAdapterInfo adapterInfo = adapter->info();
+
+    for (const auto& e : g_intelInfoEntries) {
+      if (e.deviceId == deviceId && !std::memcmp(e.uuid, adapterInfo.deviceUuid, VK_UUID_SIZE))
+        return e.info;
+    }
+
+    auto info = new D3D11IntelDeviceInfoV2();
+    info->GTGeneration = GetGTGeneration(deviceId);
+
+    IntelPciAddress pci = GetPciAddress(adapter);
+    const char* euSource = "not available";
+    std::string freqSource = "no DRM card at this PCI address";
+
+#ifdef _WIN32
+    IntelClInfo cl = QueryIntelOpenCl(pci);
+    euSource = cl.how;
+
+    if (cl.found)
+      info->EUCount = cl.computeUnits;
+
+    std::string card = FindDrmCard(pci);
+
+    if (!card.empty()) {
+      freqSource = str::format("no xe/i915 frequency files in ", card);
+
+      if ((info->GPUMaxFreq = ReadUnixNumber(card + "/device/tile0/gt0/freq0/rp0_freq"))) {
+        info->GPUMinFreq = ReadUnixNumber(card + "/device/tile0/gt0/freq0/rpn_freq");
+        freqSource = "xe sysfs rp0/rpn";
+      } else if ((info->GPUMaxFreq = ReadUnixNumber(card + "/gt_RP0_freq_mhz"))) {
+        info->GPUMinFreq = ReadUnixNumber(card + "/gt_RPn_freq_mhz");
+        freqSource = "i915 sysfs RP0/RPn";
+      }
+    }
+
+    if (!info->GPUMaxFreq && cl.found && cl.maxClockMhz) {
+      info->GPUMaxFreq = cl.maxClockMhz;
+      freqSource = str::format("max from OpenCL, min unknown; ", freqSource);
+    }
+#endif
+
+    Logger::info(str::format("D3D11: Intel Device Information v2 for device 0x", std::hex, deviceId,
+      ": GTGeneration 0x", info->GTGeneration, std::dec,
+      ", EUCount ", info->EUCount, " (", euSource, ")",
+      ", GPUMaxFreq ", info->GPUMaxFreq, " MHz, GPUMinFreq ", info->GPUMinFreq, " MHz (", freqSource, ")",
+      pci.valid ? str::format(", PCI ", pci.domain, ":", pci.bus, ":", pci.device, ".", pci.function) : std::string()));
+
+    IntelInfoEntry entry;
+    std::memcpy(entry.uuid, adapterInfo.deviceUuid, VK_UUID_SIZE);
+    entry.deviceId = deviceId;
+    entry.info = info;
+    g_intelInfoEntries.push_back(entry);
+    return info;
+  }
+
+
+  D3D11IntelDeviceInfoCounter::D3D11IntelDeviceInfoCounter(
+          D3D11Device*                  pDevice,
+    const D3D11_COUNTER_DESC&           Desc,
+    const D3D11IntelDeviceInfoV2*       pInfo)
+  : D3D11DeviceChild<ID3D11Counter>(pDevice),
+    m_desc(Desc), m_info(pInfo) {
+    s_liveCount++;
+  }
+
+
+  D3D11IntelDeviceInfoCounter::~D3D11IntelDeviceInfoCounter() {
+    s_liveCount--;
+  }
+
+
+  HRESULT STDMETHODCALLTYPE D3D11IntelDeviceInfoCounter::QueryInterface(
+          REFIID                        riid,
+          void**                        ppvObject) {
+    if (ppvObject == nullptr)
+      return E_POINTER;
+
+    *ppvObject = nullptr;
+
+    if (riid == __uuidof(IUnknown)
+     || riid == __uuidof(ID3D11DeviceChild)
+     || riid == __uuidof(ID3D11Asynchronous)
+     || riid == __uuidof(ID3D11Counter)) {
+      *ppvObject = ref(this);
+      return S_OK;
+    }
+
+    return E_NOINTERFACE;
+  }
+
+
+  UINT STDMETHODCALLTYPE D3D11IntelDeviceInfoCounter::GetDataSize() {
+    // The data is the block's address. Intel's sample reads it into a
+    // uintptr_t (and, in its older version, into two DWORDs).
+    return sizeof(uint64_t);
+  }
+
+
+  void STDMETHODCALLTYPE D3D11IntelDeviceInfoCounter::GetDesc(
+          D3D11_COUNTER_DESC*           pDesc) {
+    if (pDesc)
+      *pDesc = m_desc;
+  }
+
+
+  HRESULT D3D11IntelDeviceInfoCounter::GetData(
+          void*                         pData,
+          UINT                          DataSize) {
+    if (pData && DataSize >= sizeof(uint64_t)) {
+      uint64_t address = uint64_t(reinterpret_cast<uintptr_t>(m_info));
+      std::memcpy(pData, &address, sizeof(address));
+    }
+
+    return S_OK;
+  }
+
+
+  D3D11IntelDeviceInfoCounter* D3D11IntelDeviceInfoCounter::FromAsync(
+          ID3D11Asynchronous*           pAsync) {
+    if (likely(!s_liveCount.load(std::memory_order_acquire)) || !pAsync)
+      return nullptr;
+
+    ID3D11Counter* counter = nullptr;
+
+    if (FAILED(pAsync->QueryInterface(__uuidof(ID3D11Counter), reinterpret_cast<void**>(&counter))))
+      return nullptr;
+
+    counter->Release();
+    return static_cast<D3D11IntelDeviceInfoCounter*>(counter);
+  }
+
+}
