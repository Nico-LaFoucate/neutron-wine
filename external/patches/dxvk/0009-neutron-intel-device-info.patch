+  uint32_t D3D11IntelDeviceInfo::GetGTGeneration(uint32_t deviceId) {
+    // Exact ids first: kernel include/drm/intel/pciids.h, values from igfxfmid.h
+    static const struct { uint16_t id; uint16_t family; } exact[] = {
+      // PTL (IGFX_PTL = 1300): INTEL_PTL_IDS
+      { 0xb080, 1300 }, { 0xb081, 1300 }, { 0xb082, 1300 }, { 0xb083, 1300 }, { 0xb084, 1300 },
+      { 0xb085, 1300 }, { 0xb086, 1300 }, { 0xb087, 1300 }, { 0xb08f, 1300 }, { 0xb090, 1300 },
+      { 0xb0a0, 1300 }, { 0xb0a1, 1300 }, { 0xb0b0, 1300 },
+      // LNL (IGFX_LUNARLAKE = 1275): INTEL_LNL_IDS
+      { 0x6420, 1275 }, { 0x64a0, 1275 }, { 0x64b0, 1275 },
+      // BMG (IGFX_BMG = 1274): INTEL_BMG_IDS
+      { 0xe202, 1274 }, { 0xe209, 1274 }, { 0xe20b, 1274 }, { 0xe20c, 1274 }, { 0xe20d, 1274 },
+      { 0xe210, 1274 }, { 0xe211, 1274 }, { 0xe212, 1274 }, { 0xe216, 1274 }, { 0xe220, 1274 },
+      { 0xe221, 1274 }, { 0xe222, 1274 }, { 0xe223, 1274 },
+      // ARL (IGFX_ARROWLAKE = 1273): INTEL_ARL_IDS
+      { 0x7d41, 1273 }, { 0x7d51, 1273 }, { 0x7d67, 1273 }, { 0x7dd1, 1273 }, { 0xb640, 1273 },
+      // MTL (IGFX_METEORLAKE = 1272): INTEL_MTL_IDS + gmmlib's 7D57/7DD7
+      { 0x7d40, 1272 }, { 0x7d45, 1272 }, { 0x7d55, 1272 }, { 0x7d57, 1272 }, { 0x7d60, 1272 },
+      { 0x7dd5, 1272 }, { 0x7dd7, 1272 },
+    };
+
+    for (const auto& e : exact) {
+      if (e.id == deviceId)
+        return e.family;
+    }
+
+    // Intel's GPU Detect table (gpudetect DeviceId.cpp GetIntelGPUArchitecture)
+    const uint32_t idhi = deviceId & 0xff00u;
+    const uint32_t idlo = deviceId & 0x00ffu;
+
+    if (idhi == 0x0100u)
+      return ((idlo & 0xf0u) == 0x50u || (idlo & 0xf0u) == 0x60u) ? 0x0d : 0x0c;   // IVYBRIDGE : SANDYBRIDGE
+    if (idhi == 0x0400u || idhi == 0x0a00u || idhi == 0x0d00u || idhi == 0x0c00u)
+      return 0x0e;                    // HASWELL
+    if (idhi == 0x1600u || idhi == 0x0b00u)
+      return 0x10;                    // BROADWELL
+    if (idhi == 0x1900u || idhi == 0x0900u)
+      return 0x12;                    // SKYLAKE
+    if (idhi == 0x5900u)
+      return 0x13;                    // KABYLAKE
+    if (idhi == 0x3100u)
+      return 0x17;                    // GEMINILAKE
+    if (idhi == 0x5a00u)
+      return 0x1a;                    // CANNONLAKE
+    if (idhi == 0x3e00u || idhi == 0x9b00u)
+      return 0x14;                    // COFFEELAKE (gpudetect's Whiskey/Comet Lake have no value of their own)
+    if (idhi == 0x8a00u)
+      return 0x1d;                    // ICELAKE_LP
+    if (idhi == 0x9a00u)
+      return 0x21;                    // TIGERLAKE_LP
+    if (idhi == 0x4900u)
+      return 0x4ba;                   // DG1 (1210)
+    if (idhi == 0x4c00u)
+      return 0x23;                    // ROCKETLAKE
+    if (idhi == 0x4600u)
+      return 0x24;                    // ADL
+    if (idhi == 0x5600u)
+      return 1270;                    // Alchemist (DG2)
+
+    return 0;                         // IGFX_UNKNOWN
+  }
