+
+  HRESULT D3D11SwapChain::PresentImageGdi() {
+    // neutron round-38 N2-HYBRID synchronous GDI present:
+    //   backbuffer -> staging (CopyResource) -> Map (waits for the GPU copy;
+    //   this is the ONLY wait, bounded by copy speed) -> StretchDIBits into
+    //   GetDC(hwnd) -> the ONE toplevel GDI window surface.
+    // Faithful to Windows bitblt-model semantics:
+    //   * temporal painter's-algorithm composition with GDI + CEP content
+    //     (whoever painted last wins) -- fixes home-blank / hover-to-see;
+    //   * a stable, persistent backbuffer (no vk image rotation) -- partial
+    //     D2D redraws accumulate exactly like on Windows;
+    //   * pixels persist in the window surface across present-idle gaps;
+    //   * GetDC clipping handles hidden/minimized states like Windows.
+    // Runs on the app thread under the (recursive) device lock it already
+    // holds; no other thread, no SEH, no vk WSI, no starvation, no wedge.
+    auto t0 = dxvk::high_resolution_clock::now();
+
+    HWND hwnd = static_cast<DxgiSurfaceFactory*>(m_surfaceFactory.ptr())->GetWindow();
+    ID3D11DeviceContext* ctx = m_parent->GetContext();
+
+    if (m_backBuffers.empty() || !hwnd)
+      return S_OK;
+
+    // ============ neutron ROOTDUMP (env NEUTRON_ROOTDUMP=1): grounded localization ============
+    // Dump (1) the RAW mapped staging = EXACTLY what Premiere's D2D rendered into the DXGI
+    // backbuffer, BEFORE any StretchDIBits/scale/clip, and (2) the post-present window surface,
+    // per window, first few frames, as BMP to %TEMP%\neutron-rootdump\. Filename carries hwnd +
+    // class + WxH + fmt + frame so the Tools panel / timeline are identifiable. No behavior change.
+    static const bool s_rootdump = env::getEnvVar("NEUTRON_ROOTDUMP") == "1";
+    if (s_rootdump) {
+      // per-hwnd frame counter (small static map)
+      static dxvk::mutex s_dmtx;
+      static std::unordered_map<HWND, uint32_t> s_dframes;
+      uint32_t frame;
+      { std::lock_guard<dxvk::mutex> lk(s_dmtx); frame = s_dframes[hwnd]++; }
+      if (frame < 4u) {
+        wchar_t cls[64] = L"?"; ::GetClassNameW(hwnd, cls, 63);
+        RECT cr = { }; ::GetClientRect(hwnd, &cr);
+        // sanitize class for filename
+        for (wchar_t* p = cls; *p; ++p) if (*p==L' '||*p==L'\\'||*p==L'/'||*p==L':') *p=L'_';
+        wchar_t path[320];
+        // RAW: full backbuffer via a throwaway staging (independent of the band staging)
+        D3D11_TEXTURE2D_DESC dd = { };
+        dd.Width = m_desc.Width; dd.Height = m_desc.Height; dd.MipLevels = 1; dd.ArraySize = 1;
+        dd.Format = m_desc.Format; dd.SampleDesc.Count = 1;
+        dd.Usage = D3D11_USAGE_STAGING; dd.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        Com<ID3D11Texture2D> dtex;
+        if (SUCCEEDED(m_parent->CreateTexture2D(&dd, nullptr, &dtex))) {
+          ctx->CopyResource(dtex.ptr(), m_backBuffers[0].ptr());
+          D3D11_MAPPED_SUBRESOURCE dm = { };
+          if (SUCCEEDED(ctx->Map(dtex.ptr(), 0, D3D11_MAP_READ, 0, &dm))) {
+            _snwprintf(path, 320, L"%ls%08llx_%ls_%ldx%ld_fmt%d_f%u_RAW.bmp",
+              NeutronRootdumpDir().c_str(), (unsigned long long)(ULONG_PTR)hwnd, cls, cr.right, cr.bottom, m_desc.Format, frame);
+            NeutronDumpBmp(path, dm.pData, int(m_desc.Width), int(m_desc.Height), int(dm.RowPitch));
+            ctx->Unmap(dtex.ptr(), 0);
+          }
+        }
+        Logger::warn(str::format("neutron-rootdump: hwnd=", (void*)hwnd,
+          " ", m_desc.Width, "x", m_desc.Height, " fmt=", m_desc.Format,
+          " effect=", m_desc.SwapEffect, " frame=", frame));
+      }
+    }
+
+    // neutron round-43 RPC epoch: signal winewayland that THIS flush is a chain
+    // present of `hwnd` (band = full window in toplevel client coords), so it
+    // fills the shadow FROM the surface. Interlocked seqlock (odd during write);
+    // winewayland reads it in the flush repair. DXVK stays dumb -- 6 stores.
+    static const LONG NeutronRpcRing = 512;
+    struct NeutronRpcEntry { LONG hwnd, bl, bt, br, bb; };
+    struct NeutronRpcEpoch { volatile LONG head, vl, vt, vr, vb; NeutronRpcEntry ring[NeutronRpcRing]; };
+    static NeutronRpcEpoch* s_epoch = [] () -> NeutronRpcEpoch* {
+      HANDLE h = ::CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0,
+        sizeof(NeutronRpcEpoch), L"__neutron_rpc_epoch");
+      return h ? reinterpret_cast<NeutronRpcEpoch*>(
+        ::MapViewOfFile(h, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0, sizeof(NeutronRpcEpoch))) : nullptr;
+    }();
+    if (s_epoch) {
+      HWND root = ::GetAncestor(hwnd, GA_ROOT);
+      POINT o = { 0, 0 };
+      ::MapWindowPoints(hwnd, root, &o, 1);
+      RECT cr = { }; ::GetClientRect(hwnd, &cr);
+      LONG slot = ::InterlockedIncrement(&s_epoch->head) - 1; // reserve a ring slot
+      NeutronRpcEntry* e = &s_epoch->ring[slot & (NeutronRpcRing - 1)];
+      e->hwnd = LONG(reinterpret_cast<ULONG_PTR>(hwnd));
+      e->bl = o.x; e->bt = o.y; e->br = o.x + cr.right; e->bb = o.y + cr.bottom;
+    }
