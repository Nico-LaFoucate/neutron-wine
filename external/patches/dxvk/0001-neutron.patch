+  // neutron ROOTDUMP: write a 32-bit BGRA buffer as a bottom-up BMP (no PNG lib in
+  // DXVK; the capture script converts BMP->PNG). Pure Win32 file I/O.
+  static void NeutronDumpBmp(const wchar_t* path, const void* bgra, int w, int h, int pitch) {
+    if (!bgra || w <= 0 || h <= 0) return;
+    HANDLE f = ::CreateFileW(path, GENERIC_WRITE, 0, nullptr, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (f == INVALID_HANDLE_VALUE) return;
+    uint32_t rowBytes = uint32_t(w) * 4u, imgBytes = rowBytes * uint32_t(h);
+    uint8_t fh[14] = { }; uint8_t ih[40] = { };
+    uint32_t off = 54, fsz = 54 + imgBytes;
+    fh[0]='B'; fh[1]='M';
+    fh[2]=uint8_t(fsz); fh[3]=uint8_t(fsz>>8); fh[4]=uint8_t(fsz>>16); fh[5]=uint8_t(fsz>>24);
+    fh[10]=uint8_t(off); fh[11]=uint8_t(off>>8);
+    ih[0]=40;
+    ih[4]=uint8_t(w); ih[5]=uint8_t(w>>8); ih[6]=uint8_t(w>>16); ih[7]=uint8_t(w>>24);
+    ih[8]=uint8_t(h); ih[9]=uint8_t(h>>8); ih[10]=uint8_t(h>>16); ih[11]=uint8_t(h>>24); // +h => bottom-up
+    ih[12]=1; ih[14]=32;
+    DWORD wr = 0;
+    ::WriteFile(f, fh, 14, &wr, nullptr);
+    ::WriteFile(f, ih, 40, &wr, nullptr);
+    // BMP is bottom-up: write rows from bottom
+    for (int y = h - 1; y >= 0; --y)
+      ::WriteFile(f, reinterpret_cast<const uint8_t*>(bgra) + size_t(y) * pitch, rowBytes, &wr, nullptr);
+    ::CloseHandle(f);
+  }
+
+  // neutron ROOTDUMP output directory: %TEMP%\neutron-rootdump\ (created on first use).
+  static const std::wstring& NeutronRootdumpDir() {
+    static const std::wstring dir = [] {
+      wchar_t tmp[MAX_PATH] = L"";
+      DWORD n = ::GetTempPathW(MAX_PATH, tmp);
+      std::wstring d = (n && n < MAX_PATH) ? std::wstring(tmp, n) : std::wstring(L".\\");
+      d += L"neutron-rootdump\\";
+      ::CreateDirectoryW(d.c_str(), nullptr);
+      return d;
+    }();
+    return dir;
+  }
+
+  // neutron round-38 N2 perf counters (5s cadence)
+  static std::atomic<uint64_t> g_gdiPresents = { 0u };
+  static std::atomic<uint64_t> g_gdiBlitUs   = { 0u };
+  static std::atomic<uint64_t> g_gdiMaxUs    = { 0u };
+  static std::atomic<uint64_t> g_gdiSkips    = { 0u }; // round-41: fully-covered skip
