+      for (HWND c = ::GetWindow(hwnd, GW_CHILD); c && n < 64u;
+           c = ::GetWindow(c, GW_HWNDNEXT), ++n) {
+        RECT cr = { };
+        if (!::GetWindowRect(c, &cr))
+          continue; /* no visibility filter: that IS the lifecycle race */
