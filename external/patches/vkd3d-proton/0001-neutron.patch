diff --git a/libs/vkd3d/blit_to_window.h b/libs/vkd3d/blit_to_window.h
new file mode 100644
index 00000000..176cc402
--- /dev/null
+++ b/libs/vkd3d/blit_to_window.h
@@ -0,0 +1,736 @@
+/* blit_to_window.h  (TIMER-THREAD, scan-all-buffers build + IDENT probe)
+ *
+ * Background thread, every ~33 ms, scans every swapchain backbuffer, copies each
+ * to a host buffer, samples it, and GDI-blits the first non-empty one to
+ * chain->user_hwnd.  Logs each index's first sample so we can see which buffer
+ * (if any) Premiere actually renders the video into.
+ *
+ * Monitor backbuffer is VK_FORMAT_A2B10G10R10_UNORM_PACK32 (vk_format 64);
+ * unpacked to GDI 32bpp BGRA before blit.
+ *
+ * IDENT probe (added): paints chain->user_hwnd solid magenta, taking the HWND
+ * BY VALUE so it never dereferences `chain` and cannot use-after-free on teardown.
+ *
+ * #included textually into libs/vkd3d/swapchain.c.
+ */
+#ifndef VKD3D_BLIT_TO_WINDOW_H
+#define VKD3D_BLIT_TO_WINDOW_H
+
+typedef struct BTW_RECT { int left, top, right, bottom; } BTW_RECT;
+
+typedef struct BTW_BMIH
+{
+    uint32_t biSize; int32_t biWidth; int32_t biHeight;
+    uint16_t biPlanes; uint16_t biBitCount;
+    uint32_t biCompression; uint32_t biSizeImage;
+    int32_t biXPelsPerMeter; int32_t biYPelsPerMeter;
+    uint32_t biClrUsed; uint32_t biClrImportant;
+} BTW_BMIH;
+
+typedef struct BTW_BMI { BTW_BMIH bmiHeader; uint32_t bmiColors[1]; } BTW_BMI;
+
+typedef void *BTW_HDC;
+typedef BTW_HDC (*PFN_BTW_GetDC)(HWND);
+typedef int     (*PFN_BTW_ReleaseDC)(HWND, BTW_HDC);
+typedef int     (*PFN_BTW_GetClientRect)(HWND, BTW_RECT *);
+typedef int     (*PFN_BTW_SetStretchBltMode)(BTW_HDC, int);
+typedef int     (*PFN_BTW_StretchDIBits)(BTW_HDC, int, int, int, int,
+                                         int, int, int, int,
+                                         const void *, const BTW_BMI *, uint32_t, uint32_t);
+typedef void  (*PFN_BTW_Sleep)(uint32_t);
+typedef void *(*PFN_BTW_CreateThread)(void *, size_t, void *, void *, uint32_t, uint32_t *);
+
+#define BTW_BI_RGB 0u
+#define BTW_DIB_RGB_COLORS 0u
+#define BTW_SRCCOPY 0x00CC0020u
+#define BTW_COLORONCOLOR 3
+
+static PFN_BTW_GetDC             btw_GetDC;
+static PFN_BTW_ReleaseDC         btw_ReleaseDC;
+static PFN_BTW_GetClientRect     btw_GetClientRect;
+static PFN_BTW_SetStretchBltMode btw_SetStretchBltMode;
+static PFN_BTW_StretchDIBits     btw_StretchDIBits;
+static int                       btw_gdi_resolved;
+
+static VkDevice        btw_device;
+static VkBuffer        btw_buffer;
+static VkDeviceMemory  btw_memory;
+static void           *btw_mapped;
+static VkDeviceSize    btw_capacity;
+static VkCommandPool   btw_pool;
+static VkCommandBuffer btw_cmd;
+static VkFence         btw_fence;
+
+static int btw_idx_logged[8];
+
+/* ---- cold-start fix: capture serialization + teardown registry ---- */
+/* One lock guards the shared scratch resources (btw_buffer/btw_cmd/btw_fence/
+   btw_mapped) so the per-swapchain poller can run on multiple chains safely. */
+typedef void (WINAPI *PFN_BTW_InitCS)(CRITICAL_SECTION*);
+typedef void (WINAPI *PFN_BTW_EnterCS)(CRITICAL_SECTION*);
+typedef void (WINAPI *PFN_BTW_LeaveCS)(CRITICAL_SECTION*);
+static CRITICAL_SECTION btw_cap_cs;
+static int              btw_cap_cs_ready;
+static PFN_BTW_EnterCS  btw_enter_cs;
+static PFN_BTW_LeaveCS  btw_leave_cs;
+/* chains whose poller must stop (set under the lock during swapchain cleanup) */
+static void            *btw_stopped[64];
+static int              btw_stopped_count;
+
+static void btw_cap_lock_init(void)
+{
+    HMODULE k;
+    PFN_BTW_InitCS init;
+    if (btw_cap_cs_ready) return;
+    k = GetModuleHandleA("kernel32.dll");
+    if (!k) return;
+    init        = (PFN_BTW_InitCS)GetProcAddress(k, "InitializeCriticalSection");
+    btw_enter_cs = (PFN_BTW_EnterCS)GetProcAddress(k, "EnterCriticalSection");
+    btw_leave_cs = (PFN_BTW_LeaveCS)GetProcAddress(k, "LeaveCriticalSection");
+    if (!init || !btw_enter_cs || !btw_leave_cs) return;
+    init(&btw_cap_cs);
+    btw_cap_cs_ready = 1;
+}
+static void btw_cap_lock(void)   { if (btw_cap_cs_ready && btw_enter_cs) btw_enter_cs(&btw_cap_cs); }
+static void btw_cap_unlock(void) { if (btw_cap_cs_ready && btw_leave_cs) btw_leave_cs(&btw_cap_cs); }
+
+/* Mark a chain's poller to stop (called from swapchain cleanup, under lock). */
+void btw_mark_stopped(void *chain)
+{
+    int i;
+    btw_cap_lock_init();
+    btw_cap_lock();
+    for (i = 0; i < btw_stopped_count; i++)
+        if (btw_stopped[i] == chain) { btw_cap_unlock(); return; }
+    if (btw_stopped_count < 64) btw_stopped[btw_stopped_count++] = chain;
+    btw_cap_unlock();
+}
+static int btw_is_stopped(void *chain)
+{
+    int i, r = 0;
+    btw_cap_lock();
+    for (i = 0; i < btw_stopped_count; i++)
+        if (btw_stopped[i] == chain) { r = 1; break; }
+    btw_cap_unlock();
+    return r;
+}
+/* same check, but caller already holds btw_cap_cs */
+static int btw_is_stopped_locked(void *chain)
+{
+    int i;
+    for (i = 0; i < btw_stopped_count; i++)
+        if (btw_stopped[i] == chain) return 1;
+    return 0;
+}
+static int btw_dbg_ensure, btw_dbg_gdi, btw_dbg_paint;
+
+static void btw_resolve_gdi(void)
+{
+    HMODULE u, g;
+    if (btw_gdi_resolved) return;
+    btw_gdi_resolved = 1;
+    u = GetModuleHandleA("user32.dll"); if (!u) u = LoadLibraryA("user32.dll");
+    g = GetModuleHandleA("gdi32.dll");  if (!g) g = LoadLibraryA("gdi32.dll");
+    if (u)
+    {
+        btw_GetDC         = (PFN_BTW_GetDC)        GetProcAddress(u, "GetDC");
+        btw_ReleaseDC     = (PFN_BTW_ReleaseDC)    GetProcAddress(u, "ReleaseDC");
+        btw_GetClientRect = (PFN_BTW_GetClientRect)GetProcAddress(u, "GetClientRect");
+    }
+    if (g)
+    {
+        btw_SetStretchBltMode = (PFN_BTW_SetStretchBltMode)GetProcAddress(g, "SetStretchBltMode");
+        btw_StretchDIBits     = (PFN_BTW_StretchDIBits)    GetProcAddress(g, "StretchDIBits");
+    }
+}
+
+static uint32_t btw_find_host_mem_type(struct d3d12_device *device, uint32_t type_bits)
+{
+    const VkPhysicalDeviceMemoryProperties *mp = &device->memory_properties;
+    const VkMemoryPropertyFlags want = VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT;
+    uint32_t i;
+    for (i = 0; i < mp->memoryTypeCount; i++)
+        if ((type_bits & (1u << i)) && (mp->memoryTypes[i].propertyFlags & want) == want)
+            return i;
+    return UINT32_MAX;
+}
+
+static bool btw_ensure_resources(struct dxgi_vk_swap_chain *chain, VkDeviceSize needed)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &chain->queue->device->vk_procs;
+    struct d3d12_device *device = chain->queue->device;
+    VkDevice vk_device = device->vk_device;
+    VkResult vr;
+
+    if (btw_device != vk_device)
+    {
+        VkCommandPoolCreateInfo pool_info; VkCommandBufferAllocateInfo cb_info; VkFenceCreateInfo fence_info;
+        btw_pool = VK_NULL_HANDLE; btw_cmd = VK_NULL_HANDLE; btw_fence = VK_NULL_HANDLE;
+        btw_buffer = VK_NULL_HANDLE; btw_memory = VK_NULL_HANDLE; btw_mapped = NULL;
+        btw_capacity = 0; btw_device = vk_device;
+
+        memset(&pool_info, 0, sizeof(pool_info));
+        pool_info.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO;
+        pool_info.queueFamilyIndex = chain->queue->vkd3d_queue->vk_family_index;
+        pool_info.flags = VK_COMMAND_POOL_CREATE_TRANSIENT_BIT | VK_COMMAND_POOL_CREATE_RESET_COMMAND_BUFFER_BIT;
+        if ((vr = VK_CALL(vkCreateCommandPool(vk_device, &pool_info, NULL, &btw_pool))) != VK_SUCCESS)
+        { if(!btw_dbg_ensure){btw_dbg_ensure=1; ERR("blit-to-window: vkCreateCommandPool vr=%d\n", vr);} btw_pool=VK_NULL_HANDLE; return false; }
+
+        memset(&cb_info, 0, sizeof(cb_info));
+        cb_info.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO;
+        cb_info.commandPool = btw_pool; cb_info.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY; cb_info.commandBufferCount = 1;
+        if ((vr = VK_CALL(vkAllocateCommandBuffers(vk_device, &cb_info, &btw_cmd))) != VK_SUCCESS)
+        { if(!btw_dbg_ensure){btw_dbg_ensure=1; ERR("blit-to-window: vkAllocateCommandBuffers vr=%d\n", vr);} btw_cmd=VK_NULL_HANDLE; return false; }
+
+        memset(&fence_info, 0, sizeof(fence_info));
+        fence_info.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO;
+        if ((vr = VK_CALL(vkCreateFence(vk_device, &fence_info, NULL, &btw_fence))) != VK_SUCCESS)
+        { if(!btw_dbg_ensure){btw_dbg_ensure=1; ERR("blit-to-window: vkCreateFence vr=%d\n", vr);} btw_fence=VK_NULL_HANDLE; return false; }
+    }
+
+    if (btw_buffer != VK_NULL_HANDLE && needed <= btw_capacity)
+        return true;
+
+    if (btw_buffer != VK_NULL_HANDLE)
+    {
+        if (btw_mapped) { VK_CALL(vkUnmapMemory(vk_device, btw_memory)); btw_mapped = NULL; }
+        VK_CALL(vkDestroyBuffer(vk_device, btw_buffer, NULL));
+        VK_CALL(vkFreeMemory(vk_device, btw_memory, NULL));
+        btw_buffer = VK_NULL_HANDLE; btw_memory = VK_NULL_HANDLE; btw_capacity = 0;
+    }
+
+    {
+        VkBufferCreateInfo buf_info; VkMemoryRequirements req; VkMemoryAllocateInfo alloc_info; VkBindBufferMemoryInfo bind_info; uint32_t mem_type;
+        memset(&buf_info, 0, sizeof(buf_info));
+        buf_info.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO;
+        buf_info.size = needed; buf_info.usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT; buf_info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+        if ((vr = VK_CALL(vkCreateBuffer(vk_device, &buf_info, NULL, &btw_buffer))) != VK_SUCCESS)
+        { if(!btw_dbg_ensure){btw_dbg_ensure=1; ERR("blit-to-window: vkCreateBuffer vr=%d\n", vr);} btw_buffer=VK_NULL_HANDLE; return false; }
+
+        VK_CALL(vkGetBufferMemoryRequirements(vk_device, btw_buffer, &req));
+        mem_type = btw_find_host_mem_type(device, req.memoryTypeBits);
+        if (mem_type == UINT32_MAX)
+        { if(!btw_dbg_ensure){btw_dbg_ensure=1; ERR("blit-to-window: no host mem type\n");} VK_CALL(vkDestroyBuffer(vk_device, btw_buffer, NULL)); btw_buffer=VK_NULL_HANDLE; return false; }
+
+        memset(&alloc_info, 0, sizeof(alloc_info));
+        alloc_info.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO;
+        alloc_info.allocationSize = req.size; alloc_info.memoryTypeIndex = mem_type;
+        if ((vr = VK_CALL(vkAllocateMemory(vk_device, &alloc_info, NULL, &btw_memory))) != VK_SUCCESS)
+        { if(!btw_dbg_ensure){btw_dbg_ensure=1; ERR("blit-to-window: vkAllocateMemory vr=%d\n", vr);} VK_CALL(vkDestroyBuffer(vk_device, btw_buffer, NULL)); btw_buffer=VK_NULL_HANDLE; btw_memory=VK_NULL_HANDLE; return false; }
+
+        memset(&bind_info, 0, sizeof(bind_info));
+        bind_info.sType = VK_STRUCTURE_TYPE_BIND_BUFFER_MEMORY_INFO;
+        bind_info.buffer = btw_buffer; bind_info.memory = btw_memory; bind_info.memoryOffset = 0;
+        if ((vr = VK_CALL(vkBindBufferMemory2(vk_device, 1, &bind_info))) != VK_SUCCESS)
+        { if(!btw_dbg_ensure){btw_dbg_ensure=1; ERR("blit-to-window: vkBindBufferMemory2 vr=%d\n", vr);} return false; }
+
+        if ((vr = VK_CALL(vkMapMemory(vk_device, btw_memory, 0, VK_WHOLE_SIZE, 0, &btw_mapped))) != VK_SUCCESS)
+        { if(!btw_dbg_ensure){btw_dbg_ensure=1; ERR("blit-to-window: vkMapMemory vr=%d\n", vr);} btw_mapped=NULL; return false; }
+
+        btw_capacity = req.size;
+    }
+    return true;
+}
+
+/* copy backbuffers[index] into btw_mapped; out: width/height/fmt. returns false on skip/fail */
+static bool btw_copy_to_host(struct dxgi_vk_swap_chain *chain, uint32_t index,
+        uint32_t *out_w, uint32_t *out_h, VkFormat *out_fmt)
+{
+    const struct vkd3d_vk_device_procs *vk_procs = &chain->queue->device->vk_procs;
+    VkDevice vk_device = chain->queue->device->vk_device;
+    struct d3d12_resource *res;
+    uint32_t width, height;
+    VkCommandBufferBeginInfo begin;
+    VkImageMemoryBarrier2 img_barrier;
+    VkBufferMemoryBarrier2 buf_barrier;
+    VkDependencyInfo dep;
+    VkBufferImageCopy2 region;
+    VkCopyImageToBufferInfo2 copy_info;
+    VkCommandBufferSubmitInfo cmd_si;
+    VkSubmitInfo2 submit;
+    VkQueue vk_queue;
+
+    res = chain->user.backbuffers[index];
+    if (!res) return false;
+    width = chain->desc.Width; height = chain->desc.Height;
+    if (!width || !height) return false;
+    if (!btw_ensure_resources(chain, (VkDeviceSize)width * height * 4u)) return false;
+
+    *out_w = width; *out_h = height; *out_fmt = res->format->vk_format;
+
+    VK_CALL(vkResetCommandBuffer(btw_cmd, 0));
+    memset(&begin, 0, sizeof(begin));
+    begin.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+    begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    VK_CALL(vkBeginCommandBuffer(btw_cmd, &begin));
+
+    memset(&img_barrier, 0, sizeof(img_barrier));
+    img_barrier.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2;
+    img_barrier.srcStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    img_barrier.srcAccessMask = VK_ACCESS_2_MEMORY_WRITE_BIT;
+    img_barrier.dstStageMask = VK_PIPELINE_STAGE_2_COPY_BIT;
+    img_barrier.dstAccessMask = VK_ACCESS_2_TRANSFER_READ_BIT;
+    img_barrier.oldLayout = res->common_layout;            /* match the engine's tracked layout */
+    img_barrier.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    img_barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    img_barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    img_barrier.image = res->res.vk_image;
+    img_barrier.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    img_barrier.subresourceRange.levelCount = 1;
+    img_barrier.subresourceRange.layerCount = 1;
+    memset(&dep, 0, sizeof(dep));
+    dep.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO;
+    dep.imageMemoryBarrierCount = 1; dep.pImageMemoryBarriers = &img_barrier;
+    VK_CALL(vkCmdPipelineBarrier2(btw_cmd, &dep));
+
+    memset(&region, 0, sizeof(region));
+    region.sType = VK_STRUCTURE_TYPE_BUFFER_IMAGE_COPY_2;
+    region.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    region.imageSubresource.layerCount = 1;
+    region.imageExtent.width = width; region.imageExtent.height = height; region.imageExtent.depth = 1;
+    memset(&copy_info, 0, sizeof(copy_info));
+    copy_info.sType = VK_STRUCTURE_TYPE_COPY_IMAGE_TO_BUFFER_INFO_2;
+    copy_info.srcImage = res->res.vk_image;
+    copy_info.srcImageLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    copy_info.dstBuffer = btw_buffer; copy_info.regionCount = 1; copy_info.pRegions = &region;
+    VK_CALL(vkCmdCopyImageToBuffer2(btw_cmd, &copy_info));
+
+    memset(&buf_barrier, 0, sizeof(buf_barrier));
+    buf_barrier.sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER_2;
+    buf_barrier.srcStageMask = VK_PIPELINE_STAGE_2_COPY_BIT;
+    buf_barrier.srcAccessMask = VK_ACCESS_2_TRANSFER_WRITE_BIT;
+    buf_barrier.dstStageMask = VK_PIPELINE_STAGE_2_HOST_BIT;
+    buf_barrier.dstAccessMask = VK_ACCESS_2_HOST_READ_BIT;
+    buf_barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    buf_barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    buf_barrier.buffer = btw_buffer; buf_barrier.offset = 0; buf_barrier.size = VK_WHOLE_SIZE;
+    memset(&dep, 0, sizeof(dep));
+    dep.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO;
+    dep.bufferMemoryBarrierCount = 1; dep.pBufferMemoryBarriers = &buf_barrier;
+    VK_CALL(vkCmdPipelineBarrier2(btw_cmd, &dep));
+
+    /* restore the image to its original tracked layout so we don't corrupt the
+       engine's layout bookkeeping for the next present/use. */
+    {
+        VkImageMemoryBarrier2 restore_barrier;
+        VkDependencyInfo restore_dep;
+        memset(&restore_barrier, 0, sizeof(restore_barrier));
+        restore_barrier.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2;
+        restore_barrier.srcStageMask = VK_PIPELINE_STAGE_2_COPY_BIT;
+        restore_barrier.srcAccessMask = VK_ACCESS_2_TRANSFER_READ_BIT;
+        restore_barrier.dstStageMask = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+        restore_barrier.dstAccessMask = 0;
+        restore_barrier.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+        restore_barrier.newLayout = res->common_layout;
+        restore_barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        restore_barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+        restore_barrier.image = res->res.vk_image;
+        restore_barrier.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+        restore_barrier.subresourceRange.levelCount = 1;
+        restore_barrier.subresourceRange.layerCount = 1;
+        memset(&restore_dep, 0, sizeof(restore_dep));
+        restore_dep.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO;
+        restore_dep.imageMemoryBarrierCount = 1;
+        restore_dep.pImageMemoryBarriers = &restore_barrier;
+        VK_CALL(vkCmdPipelineBarrier2(btw_cmd, &restore_dep));
+    }
+
+    VK_CALL(vkEndCommandBuffer(btw_cmd));
+
+    memset(&cmd_si, 0, sizeof(cmd_si));
+    cmd_si.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_SUBMIT_INFO;
+    cmd_si.commandBuffer = btw_cmd;
+    memset(&submit, 0, sizeof(submit));
+    submit.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO_2;
+    submit.commandBufferInfoCount = 1; submit.pCommandBufferInfos = &cmd_si;
+
+    VK_CALL(vkResetFences(vk_device, 1, &btw_fence));
+    vk_queue = vkd3d_queue_acquire(chain->queue->vkd3d_queue);
+    VK_CALL(vkQueueSubmit2(vk_queue, 1, &submit, btw_fence));
+    vkd3d_queue_release(chain->queue->vkd3d_queue);
+    VK_CALL(vkWaitForFences(vk_device, 1, &btw_fence, VK_TRUE, UINT64_MAX));
+    return true;
+}
+
+static void btw_unpack_and_paint(struct dxgi_vk_swap_chain *chain, uint32_t width, uint32_t height, VkFormat fmt)
+{
+    static int btw_disabled = -1;
+    HWND hwnd = chain->user_hwnd;
+    uint32_t *px = (uint32_t *)btw_mapped;
+    size_t count = (size_t)width * height, i;
+    /* NEUTRON diag: VKD3D_NEUTRON_DISABLE_BTW=1 disables the GDI blit-to-window path entirely,
+       so we can test whether the native Vulkan present alone displays the surface. Off by default. */
+    if (btw_disabled < 0)
+    {
+        char _e[8];
+        btw_disabled = (vkd3d_get_env_var("VKD3D_NEUTRON_DISABLE_BTW", _e, sizeof(_e)) && _e[0] == '1') ? 1 : 0;
+        if (btw_disabled) ERR("blit-to-window: DISABLED via VKD3D_NEUTRON_DISABLE_BTW (native present only)\n");
+    }
+    if (btw_disabled) return;
+
+    if (fmt == VK_FORMAT_A2B10G10R10_UNORM_PACK32)
+        for (i = 0; i < count; i++)
+        { uint32_t v = px[i]; uint32_t r=((v>>0)&0x3FFu)>>2, g=((v>>10)&0x3FFu)>>2, b=((v>>20)&0x3FFu)>>2; px[i]=0xFF000000u|(r<<16)|(g<<8)|b; }
+    else if (fmt == VK_FORMAT_A2R10G10B10_UNORM_PACK32)
+        for (i = 0; i < count; i++)
+        { uint32_t v = px[i]; uint32_t b=((v>>0)&0x3FFu)>>2, g=((v>>10)&0x3FFu)>>2, r=((v>>20)&0x3FFu)>>2; px[i]=0xFF000000u|(r<<16)|(g<<8)|b; }
+    else if (fmt == VK_FORMAT_R8G8B8A8_UNORM || fmt == VK_FORMAT_R8G8B8A8_SRGB)
+    { unsigned char *p=(unsigned char*)btw_mapped; size_t n=count*4,j; for(j=0;j<n;j+=4){unsigned char t=p[j];p[j]=p[j+2];p[j+2]=t;} }
+
+    btw_resolve_gdi();
+    if (!hwnd || !btw_GetDC || !btw_StretchDIBits) return;
+    {
+        BTW_HDC hdc = btw_GetDC(hwnd);
+        if (!hdc) { if(!btw_dbg_gdi){btw_dbg_gdi=1; ERR("blit-to-window: GetDC NULL\n");} return; }
+        {
+            BTW_BMI bmi; BTW_RECT rc; int dw=(int)width, dh=(int)height;
+            memset(&bmi, 0, sizeof(bmi));
+            bmi.bmiHeader.biSize = sizeof(BTW_BMIH);
+            bmi.bmiHeader.biWidth = (int32_t)width;
+            bmi.bmiHeader.biHeight = -(int32_t)height;
+            bmi.bmiHeader.biPlanes = 1; bmi.bmiHeader.biBitCount = 32; bmi.bmiHeader.biCompression = BTW_BI_RGB;
+            if (btw_GetClientRect && btw_GetClientRect(hwnd, &rc))
+            { if(rc.right-rc.left>0) dw=rc.right-rc.left; if(rc.bottom-rc.top>0) dh=rc.bottom-rc.top; }
+            if (btw_SetStretchBltMode) btw_SetStretchBltMode(hdc, BTW_COLORONCOLOR);
+            btw_StretchDIBits(hdc, 0, 0, dw, dh, 0, 0, (int)width, (int)height, btw_mapped, &bmi, BTW_DIB_RGB_COLORS, BTW_SRCCOPY);
+            if (btw_ReleaseDC) btw_ReleaseDC(hwnd, hdc);
+            if (!btw_dbg_gdi) { btw_dbg_gdi = 1; ERR("blit-to-window: GDI blit OK dst=%dx%d\n", dw, dh); }
+        }
+    }
+}
