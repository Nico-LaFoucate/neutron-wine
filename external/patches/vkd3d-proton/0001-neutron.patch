+/* kept for the present-callback call site (harmless if present never runs) */
+static void blit_user_backbuffer_to_window(struct dxgi_vk_swap_chain *chain)
+{
+    uint32_t w, h; VkFormat fmt;
+    if (btw_copy_to_host(chain, chain->request.user_index, &w, &h, &fmt))
+        btw_unpack_and_paint(chain, w, h, fmt);
+}
+
+static unsigned long btw_thread_proc(void *arg)
+{
+    struct dxgi_vk_swap_chain *chain = arg;
+    HMODULE k = GetModuleHandleA("kernel32.dll");
+    PFN_BTW_Sleep pSleep = k ? (PFN_BTW_Sleep)GetProcAddress(k, "Sleep") : NULL;
+    ERR("blit-to-window: blit thread running chain=%p\n", chain);
+    {
+    unsigned int btw_iter = 0;     /* for throttled logging */
+    for (;;)
+    {
+        uint32_t count, idx, w, h, cur; VkFormat fmt; int painted = 0;
+        if (pSleep) pSleep(33);
+        /* teardown safety: stop if this swapchain is being destroyed, or if its
+           queue has already been released/NULL'd. */
+        if (btw_is_stopped(chain)) break;
+        if (!chain->queue || !chain->queue->device) break;
+        if (!chain->user_hwnd) continue;
+        ++btw_iter;
+        count = chain->desc.BufferCount;
+        cur = chain->user.index;       /* the buffer Premiere renders into now */
+
+        /* Try the live render-target index first, then the rest. This ordering
+           means we capture the freshest content and don't paint a stale buffer. */
+        for (idx = 0; idx < count + 1; idx++)
+        {
+            uint32_t nz, sampidx;
+            int got;
+            sampidx = (idx == 0) ? cur : (idx - 1);   /* idx 0 == current, then 0..count-1 */
+            if (sampidx >= count) continue;
+            if (idx > 0 && sampidx == cur) continue;  /* don't re-do current */
+
+            btw_cap_lock();
+            if (btw_is_stopped_locked(chain) || !chain->queue || !chain->queue->device)
+            { btw_cap_unlock(); painted = -1; break; }
+            got = btw_copy_to_host(chain, sampidx, &w, &h, &fmt);
+            if (!got) { btw_cap_unlock(); continue; }
+            {
+                uint32_t *px = (uint32_t *)btw_mapped;
+                size_t c = (size_t)(h / 2) * w + (w / 2);
+                nz = px[0] | px[c] | px[(size_t)w * h - 1];
+            }
+            /* throttled log of the CURRENT index over time (~once/sec at 33ms),
+               so we can see whether/when the live buffer gets content. */
+            if (sampidx == cur && (btw_iter % 30u) == 1u)
+                ERR("blit-to-window: cur idx %u sample center=0x%08x nonzero=%d fmt=%d (iter %u)\n",
+                    sampidx, ((uint32_t *)btw_mapped)[(size_t)(h/2)*w + w/2], nz != 0, (int)fmt, btw_iter);
+            if (nz)
+            { btw_unpack_and_paint(chain, w, h, fmt); painted = 1; if(!btw_dbg_paint){btw_dbg_paint=1; ERR("blit-to-window: painting from idx %u\n", sampidx);} btw_cap_unlock(); break; }
+            btw_cap_unlock();
+        }
+        if (painted < 0) break;   /* stopped mid-scan */
+        (void)painted;
+    }
+    }
+    return 0;
+}
+
+static struct dxgi_vk_swap_chain *btw_started[16];
+static int btw_started_count;
+
+static void btw_start_blit_thread(struct dxgi_vk_swap_chain *chain)
+{
+    HMODULE k; PFN_BTW_CreateThread pCreateThread; void *h;
+    btw_cap_lock_init();
+    /* NEUTRON: per-chain idempotent start (replaces the buggy never-cleared cap-16 global
+       array; safe to call from the present thread on every present). */
+    if (InterlockedExchange(&chain->btw_thread_started, 1)) return;
+    k = GetModuleHandleA("kernel32.dll");
+    pCreateThread = k ? (PFN_BTW_CreateThread)GetProcAddress(k, "CreateThread") : NULL;
+    if (pCreateThread)
+    { h = pCreateThread(NULL, 0, (void *)btw_thread_proc, chain, 0, NULL); ERR("blit-to-window: started blit thread chain=%p hwnd=%p handle=%p\n", chain, chain->user_hwnd, h); }
+    else ERR("blit-to-window: CreateThread unresolved\n");
+}
+
+/* ---- IDENT probe ---------------------------------------------------------
+ * Paint a window solid magenta so we can SEE on screen which window a given
+ * vkd3d swapchain's user_hwnd actually is. Takes the HWND BY VALUE (thread
+ * arg), so it never dereferences `chain` and cannot use-after-free when
+ * Premiere tears the swapchain down during scrubbing/teardown.
+ * -------------------------------------------------------------------------- */
+static int btw_ident_started;
+
+static unsigned long btw_ident_thread(void *arg)
+{
+    HWND hwnd = (HWND)arg;
+    HMODULE k = GetModuleHandleA("kernel32.dll");
+    PFN_BTW_Sleep pSleep = k ? (PFN_BTW_Sleep)GetProcAddress(k, "Sleep") : NULL;
+    /* 2x2 source DIB, all magenta. 32bpp BI_RGB pixel bytes are B,G,R,X
+     * (little-endian uint32 0x00RRGGBB) -> magenta (R=255,G=0,B=255)=0x00FF00FF. */
+    static const uint32_t magenta[4] = { 0x00FF00FFu, 0x00FF00FFu, 0x00FF00FFu, 0x00FF00FFu };
+    btw_resolve_gdi();
+    ERR("blit-to-window: IDENT thread painting hwnd=%p solid magenta\n", hwnd);
+    for (;;)
+    {
+        if (pSleep) pSleep(200);
+        if (!hwnd || !btw_GetDC || !btw_StretchDIBits) continue;
+        {
+            BTW_HDC hdc = btw_GetDC(hwnd);
+            BTW_BMI bmi; BTW_RECT rc; int dw = 256, dh = 256;
+            if (!hdc) { if(!btw_dbg_gdi){btw_dbg_gdi=1; ERR("blit-to-window: IDENT GetDC NULL hwnd=%p\n", hwnd);} continue; }
+            memset(&bmi, 0, sizeof(bmi));
+            bmi.bmiHeader.biSize = sizeof(BTW_BMIH);
+            bmi.bmiHeader.biWidth = 2; bmi.bmiHeader.biHeight = -2;
+            bmi.bmiHeader.biPlanes = 1; bmi.bmiHeader.biBitCount = 32; bmi.bmiHeader.biCompression = BTW_BI_RGB;
+            if (btw_GetClientRect && btw_GetClientRect(hwnd, &rc))
+            { if (rc.right - rc.left > 0) dw = rc.right - rc.left; if (rc.bottom - rc.top > 0) dh = rc.bottom - rc.top; }
+            if (btw_SetStretchBltMode) btw_SetStretchBltMode(hdc, BTW_COLORONCOLOR);
+            btw_StretchDIBits(hdc, 0, 0, dw, dh, 0, 0, 2, 2, magenta, &bmi, BTW_DIB_RGB_COLORS, BTW_SRCCOPY);
+            if (btw_ReleaseDC) btw_ReleaseDC(hwnd, hdc);
+            if (!btw_dbg_paint) { btw_dbg_paint = 1; ERR("blit-to-window: IDENT painted hwnd=%p %dx%d\n", hwnd, dw, dh); }
+        }
+    }
+    return 0;
+}
+
+static void btw_start_ident(HWND hwnd)
+{
+    HMODULE k; PFN_BTW_CreateThread pCreateThread;
+    if (btw_ident_started) return;
+    btw_ident_started = 1;
+    k = GetModuleHandleA("kernel32.dll");
+    pCreateThread = k ? (PFN_BTW_CreateThread)GetProcAddress(k, "CreateThread") : NULL;
+    if (pCreateThread)
+        pCreateThread(NULL, 0, (void *)btw_ident_thread, (void *)hwnd, 0, NULL);
+    else
+        ERR("blit-to-window: IDENT CreateThread unresolved\n");
+}
+
+/* ===== Neutron RT probe ====================================================
+ * Reads ONE specific vkd3d render target (captured by resource.c into the
+ * globals below) and paints it to chain->user_hwnd. Bounded ~20s loop so it
+ * exits on its own and cannot use-after-free against swapchain teardown.
+ * Globals are NON-static so resource.c can set them via a block-scope extern.
+ * Spliced textually into blit_to_window.h, before the include-guard #endif,
+ * so all the helpers above (btw_ensure_resources, btw_unpack_and_paint,
+ * btw_mapped/buffer/fence/cmd, PFN_BTW_*) are already in scope.
+ * ========================================================================= */
+VkImage        g_neutron_rt_image = VK_NULL_HANDLE;
+uint32_t       g_neutron_rt_w;
+uint32_t       g_neutron_rt_h;
+VkFormat       g_neutron_rt_fmt;
+VkImageLayout  g_neutron_rt_layout;
+
+/* Copy an arbitrary color VkImage (1 mip, 1 layer) into btw_mapped, going
+ * cur_layout -> GENERAL -> copy -> GENERAL -> cur_layout to preserve it. */
+static bool btw_copy_image_to_host(struct dxgi_vk_swap_chain *chain,
+        VkImage image, uint32_t width, uint32_t height, VkImageLayout cur_layout)
+{
+    /* neutron-rt teardown guard: the rt-probe thread can outlive the
+     * swapchain's queue. chain->queue is released/NULL'd during destroy,
+     * so bail instead of dereferencing chain->queue->device. The probe
+     * loop treats a false return as 'skip frame' and winds down safely. */
+    if (!chain || !chain->queue || !chain->queue->device)
+        return false;
+    const struct vkd3d_vk_device_procs *vk_procs = &chain->queue->device->vk_procs;
+    VkDevice vk_device = chain->queue->device->vk_device;
+    VkCommandBufferBeginInfo begin;
+    VkImageMemoryBarrier2 to_copy, from_copy;
+    VkDependencyInfo dep;
+    VkBufferImageCopy2 region;
+    VkCopyImageToBufferInfo2 copy_info;
+    VkCommandBufferSubmitInfo cmd_si;
+    VkSubmitInfo2 submit;
+    VkQueue vk_queue;
+
+    if (image == VK_NULL_HANDLE || !width || !height)
+        return false;
+    if (!btw_ensure_resources(chain, (VkDeviceSize)width * height * 4u))
+        return false;
+
+    VK_CALL(vkResetCommandBuffer(btw_cmd, 0));
+    memset(&begin, 0, sizeof(begin));
+    begin.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO;
+    begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    VK_CALL(vkBeginCommandBuffer(btw_cmd, &begin));
+
+    memset(&to_copy, 0, sizeof(to_copy));
+    to_copy.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2;
+    to_copy.srcStageMask  = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    to_copy.srcAccessMask = VK_ACCESS_2_MEMORY_WRITE_BIT | VK_ACCESS_2_MEMORY_READ_BIT;
+    to_copy.dstStageMask  = VK_PIPELINE_STAGE_2_COPY_BIT;
+    to_copy.dstAccessMask = VK_ACCESS_2_TRANSFER_READ_BIT;
+    to_copy.oldLayout = cur_layout;
+    to_copy.newLayout = VK_IMAGE_LAYOUT_GENERAL;
+    to_copy.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    to_copy.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    to_copy.image = image;
+    to_copy.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    to_copy.subresourceRange.levelCount = 1;
+    to_copy.subresourceRange.layerCount = 1;
+    memset(&dep, 0, sizeof(dep));
+    dep.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO;
+    dep.imageMemoryBarrierCount = 1;
+    dep.pImageMemoryBarriers = &to_copy;
+    VK_CALL(vkCmdPipelineBarrier2(btw_cmd, &dep));
+
+    memset(&region, 0, sizeof(region));
+    region.sType = VK_STRUCTURE_TYPE_BUFFER_IMAGE_COPY_2;
+    region.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    region.imageSubresource.layerCount = 1;
+    region.imageExtent.width = width;
+    region.imageExtent.height = height;
+    region.imageExtent.depth = 1;
+    memset(&copy_info, 0, sizeof(copy_info));
+    copy_info.sType = VK_STRUCTURE_TYPE_COPY_IMAGE_TO_BUFFER_INFO_2;
+    copy_info.srcImage = image;
+    copy_info.srcImageLayout = VK_IMAGE_LAYOUT_GENERAL;
+    copy_info.dstBuffer = btw_buffer;
+    copy_info.regionCount = 1;
+    copy_info.pRegions = &region;
+    VK_CALL(vkCmdCopyImageToBuffer2(btw_cmd, &copy_info));
+
+    memset(&from_copy, 0, sizeof(from_copy));
+    from_copy.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER_2;
+    from_copy.srcStageMask  = VK_PIPELINE_STAGE_2_COPY_BIT;
+    from_copy.srcAccessMask = VK_ACCESS_2_TRANSFER_READ_BIT;
+    from_copy.dstStageMask  = VK_PIPELINE_STAGE_2_ALL_COMMANDS_BIT;
+    from_copy.dstAccessMask = VK_ACCESS_2_MEMORY_READ_BIT | VK_ACCESS_2_MEMORY_WRITE_BIT;
+    from_copy.oldLayout = VK_IMAGE_LAYOUT_GENERAL;
+    from_copy.newLayout = cur_layout;
+    from_copy.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    from_copy.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    from_copy.image = image;
+    from_copy.subresourceRange.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    from_copy.subresourceRange.levelCount = 1;
+    from_copy.subresourceRange.layerCount = 1;
+    memset(&dep, 0, sizeof(dep));
+    dep.sType = VK_STRUCTURE_TYPE_DEPENDENCY_INFO;
+    dep.imageMemoryBarrierCount = 1;
+    dep.pImageMemoryBarriers = &from_copy;
+    VK_CALL(vkCmdPipelineBarrier2(btw_cmd, &dep));
+
+    VK_CALL(vkEndCommandBuffer(btw_cmd));
+
+    memset(&cmd_si, 0, sizeof(cmd_si));
+    cmd_si.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_SUBMIT_INFO;
+    cmd_si.commandBuffer = btw_cmd;
+    memset(&submit, 0, sizeof(submit));
+    submit.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO_2;
+    submit.commandBufferInfoCount = 1;
+    submit.pCommandBufferInfos = &cmd_si;
+
+    VK_CALL(vkResetFences(vk_device, 1, &btw_fence));
+    vk_queue = vkd3d_queue_acquire(chain->queue->vkd3d_queue);
+    VK_CALL(vkQueueSubmit2(vk_queue, 1, &submit, btw_fence));
+    vkd3d_queue_release(chain->queue->vkd3d_queue);
+    VK_CALL(vkWaitForFences(vk_device, 1, &btw_fence, VK_TRUE, UINT64_MAX));
+    return true;
+}
+
+static unsigned long btw_rt_probe_thread(void *arg)
+{
+    struct dxgi_vk_swap_chain *chain = arg;
+    HMODULE k = GetModuleHandleA("kernel32.dll");
+    PFN_BTW_Sleep pSleep = k ? (PFN_BTW_Sleep)GetProcAddress(k, "Sleep") : NULL;
+    int iter, logged_present = 0, logged_nz = 0;
+
+    ERR("neutron-rt: probe thread start chain=%p\n", chain);
+    for (iter = 0; iter < 3000; iter++)   /* ~100s diagnostic window */
+    {
+        VkImage img;
+        uint32_t w, h, nz = 0;
+        VkFormat fmt;
+        VkImageLayout lay;
+
+        if (pSleep)
+            pSleep(33);
+
+        img = g_neutron_rt_image;
+        w   = g_neutron_rt_w;
+        h   = g_neutron_rt_h;
+        fmt = g_neutron_rt_fmt;
+        lay = g_neutron_rt_layout;
+
+        if (img == VK_NULL_HANDLE || !w || !h)
+            continue;
+
+        if (!logged_present)
+        {
+            logged_present = 1;
+            ERR("neutron-rt: captured RT %ux%u vkfmt=%d layout=%d\n",
+                    w, h, (int)fmt, (int)lay);
+        }
+
+        btw_cap_lock();
+        if (!btw_copy_image_to_host(chain, img, w, h, lay))
+        { btw_cap_unlock(); continue; }
+
+        {
+            uint32_t *px = (uint32_t *)btw_mapped;
+            size_t c = (size_t)(h / 2) * w + (w / 2);
+            nz = px[0] | px[c] | px[(size_t)w * h - 1u];
+        }
+
+        if ((iter % 30) == 0)   /* ~once/sec time course */
+        {
+            (void)logged_nz;
+            ERR("neutron-rt: read center=0x%08x nonzero=%d iter=%d\n",
+                    ((uint32_t *)btw_mapped)[(size_t)(h / 2) * w + (w / 2)], nz != 0, iter);
+        }
+
+        if (nz)
+            btw_unpack_and_paint(chain, w, h, fmt);
+        btw_cap_unlock();
+    }
+    ERR("neutron-rt: probe thread exit (safe)\n");
+    return 0;
+}
+
+static int btw_rt_started;
+static void btw_start_rt_probe(struct dxgi_vk_swap_chain *chain)
+{
+    HMODULE k;
+    PFN_BTW_CreateThread pCreateThread;
+
+    if (btw_rt_started)
+        return;
+    btw_rt_started = 1;
+
+    k = GetModuleHandleA("kernel32.dll");
+    pCreateThread = k ? (PFN_BTW_CreateThread)GetProcAddress(k, "CreateThread") : NULL;
+    if (pCreateThread)
+        pCreateThread(NULL, 0, (void *)btw_rt_probe_thread, chain, 0, NULL);
+    else
+        ERR("neutron-rt: CreateThread unresolved\n");
+}
