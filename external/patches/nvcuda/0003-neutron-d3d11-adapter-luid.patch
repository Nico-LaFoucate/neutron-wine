+/* Neutron (#49): which CUDA devices drive this DXGI adapter. Windows answers by the adapter's LUID:
+ * the CUDA device whose LUID equals it, and CUDA_ERROR_NO_DEVICE for an adapter no CUDA device
+ * drives (the AMD/Intel GPU of a hybrid laptop). Each device's LUID comes from the same registry
+ * key cuDeviceGetLuid reads (win32u writes it next to the Vulkan UUID). Only when no device's LUID
+ * can be read at all do we fall back to the old answer, device 0, and then for an NVIDIA adapter
+ * only. */
+#define NEUTRON_CUDA_ERROR_NO_DEVICE 100
+static CUresult neutron_cuda_devices_for_adapter(IDXGIAdapter *adapter, unsigned int *count,
+                                                 CUdevice *devices, unsigned int max)
+{
+    DXGI_ADAPTER_DESC desc;
+    int n = 0, i, readable = 0;
+    unsigned int found = 0;
+    CUresult ret;
+
+    *count = 0;
+    if (!adapter || FAILED(IDXGIAdapter_GetDesc(adapter, &desc))) return CUDA_ERROR_INVALID_VALUE;
+    if ((ret = pcuDeviceGetCount(&n))) return ret;
+    for (i = 0; i < n; i++)
+    {
+        LUID luid;
+        unsigned int mask;
+        if (device_luid_from_registry((char *)&luid, &mask, i)) continue;
+        readable++;
+        if (luid.LowPart != desc.AdapterLuid.LowPart || luid.HighPart != desc.AdapterLuid.HighPart) continue;
+        if (found < max && devices) devices[found] = i;
+        found++;
+    }
+    if (!readable && n > 0 && desc.VendorId == 0x10de)
+    {
+        WARN("no CUDA device LUID readable; NVIDIA adapter -> device 0\n");
+        if (max && devices) devices[0] = 0;
+        found = 1;
+    }
+    TRACE("adapter %04x:%04x LUID %08x:%08x -> %u CUDA device(s) of %d\n", desc.VendorId, desc.DeviceId,
+          (unsigned)desc.AdapterLuid.HighPart, (unsigned)desc.AdapterLuid.LowPart, found, n);
+    if (!found) return NEUTRON_CUDA_ERROR_NO_DEVICE;
+    *count = found;
+    if (max && devices)
+    {
+        g_neutron_adapter_luid = desc.AdapterLuid;
+        g_neutron_adapter_luid_dev = devices[0];
+        g_neutron_adapter_luid_anydev = 0;
+        g_neutron_adapter_luid_valid = 1;
+    }
+    return CUDA_SUCCESS;
+}
+
+static int neutron_cuda_d3d_any_adapter(void)
+{
+    const char *e = getenv("NEUTRON_CUDA_D3D_ANY_ADAPTER");
+    return e && *e == '1';
+}
+
 CUresult WINAPI wine_cuD3D11GetDevice(CUdevice *pCudaDevice, IDXGIAdapter *pAdapter)
 {
-    FIXME("(%p, %p) - semi-stub\n", pCudaDevice, pAdapter);
+    unsigned int count;
+    CUresult ret;
+
+    TRACE("(%p, %p)\n", pCudaDevice, pAdapter);
+    if (!neutron_cuda_d3d_any_adapter())
+    {
+        if (!pCudaDevice) return CUDA_ERROR_INVALID_VALUE;
+        ret = neutron_cuda_devices_for_adapter(pAdapter, &count, pCudaDevice, 1);
+        TRACE("-> %d, device %d\n", ret, ret ? -1 : *pCudaDevice);
+        return ret;
+    }
+    FIXME("(%p, %p) - semi-stub (NEUTRON_CUDA_D3D_ANY_ADAPTER=1)\n", pCudaDevice, pAdapter);
     if (pAdapter)
     {
         DXGI_ADAPTER_DESC _nd;
         if (SUCCEEDED(pAdapter->lpVtbl->GetDesc(pAdapter, &_nd)))
         {
             g_neutron_adapter_luid = _nd.AdapterLuid;
+            g_neutron_adapter_luid_anydev = 1;
             g_neutron_adapter_luid_valid = 1;
             ERR("neutron-luid: D3D adapter LUID=%08x:%08x\n",
                 (unsigned)_nd.AdapterLuid.HighPart, (unsigned)_nd.AdapterLuid.LowPart);
@@ -6969,6 +7045,35 @@
     return pcuDeviceGet(pCudaDevice, 0);
 }
 
+/* Neutron (#49): was an unimplemented stub (calling it crashed the caller). The D3D11 device's DXGI
+ * adapter, then the same LUID match as cuD3D11GetDevice. One adapter per D3D11 device, so every
+ * CUd3d11DeviceList value (all / current frame / next frame) has the same answer. */
+CUresult WINAPI wine_cuD3D11GetDevices(unsigned int *pCudaDeviceCount, CUdevice *pCudaDevices,
+                                       unsigned int cudaDeviceCount, ID3D11Device *pD3D11Device, int deviceList)
+{
+    IDXGIDevice *dxgi_device;
+    IDXGIAdapter *adapter;
+    unsigned int count = 0;
+    CUresult ret;
+
+    TRACE("(%p, %p, %u, %p, %d)\n", pCudaDeviceCount, pCudaDevices, cudaDeviceCount, pD3D11Device, deviceList);
+    if (!pCudaDeviceCount || !pD3D11Device || deviceList < 1 || deviceList > 3) return CUDA_ERROR_INVALID_VALUE;
+    *pCudaDeviceCount = 0;
+    if (FAILED(ID3D11Device_QueryInterface(pD3D11Device, &IID_IDXGIDevice, (void **)&dxgi_device)))
+        return CUDA_ERROR_INVALID_VALUE;
+    if (FAILED(IDXGIDevice_GetAdapter(dxgi_device, &adapter)))
+    {
+        IDXGIDevice_Release(dxgi_device);
+        return CUDA_ERROR_INVALID_VALUE;
+    }
+    ret = neutron_cuda_devices_for_adapter(adapter, &count, pCudaDevices, pCudaDevices ? cudaDeviceCount : 0);
+    IDXGIAdapter_Release(adapter);
+    IDXGIDevice_Release(dxgi_device);
+    if (!ret) *pCudaDeviceCount = count;
+    TRACE("-> %d, %u device(s)\n", ret, count);
+    return ret;
+}
