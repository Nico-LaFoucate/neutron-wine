+/* Only ever treat a CUgraphicsResource as ours if we handed it out: never dereference a handle
+ * that belongs to the real driver. */
+static struct neutron_gfx_resource *neutron_gfx_find(CUgraphicsResource res)
+{
+    struct neutron_gfx_resource *r, *found = NULL;
+
+    pthread_mutex_lock(&neutron_gfx_lock);
+    LIST_FOR_EACH_ENTRY(r, &neutron_gfx_list, struct neutron_gfx_resource, entry)
+    {
+        if ((CUgraphicsResource)r == res) { found = r; break; }
+    }
+    pthread_mutex_unlock(&neutron_gfx_lock);
+    return found;
+}
