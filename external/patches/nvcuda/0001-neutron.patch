+/* ===== Neutron LIVE presenter =========================================== */
+/* ⚠️ EXPERIMENT, OFF BY DEFAULT -- set NEUTRON_CUDA_PLAYBACK_EXPERIMENT=1 to arm.
+ *
+ * This is the old "present Premiere's playback buffer ourselves" experiment. It is NOT
+ * diagnostics: neutron_present_thread() locates the PROGRAM MONITOR window via
+ * neutron_find_monitor() and BLITS its own BGRA buffer into that window every 50 ms, and
+ * neutron_live_thread() reads live GPU allocations back to the host once a second.
+ *
+ * It used to arm ITSELF, with no env gate, as soon as a 69,918,720-byte CUDA allocation
+ * appeared -- which is exactly what Premiere allocates for playback. Rebuilding nvcuda.dll for
+ * the After Effects CUDA interop on 2026-08-03 restaged it into the live prefix, and Premiere's
+ * Program Monitor went BLACK with smearing on resize, because this thread was painting over it.
+ *
+ * That cost a full day: the symptom looked exactly like a present-path bug, so the search went
+ * through dcomp, DXVK, win32u, opengl32 and winewayland before reaching the one component that
+ * was actually drawing on the window. Anything that WRITES to a window must be env-gated off by
+ * default -- a passive-looking name ("capture", "live") is not a licence to run in production. */
+static int neutron_playback_experiment(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        const char *e = getenv("NEUTRON_CUDA_PLAYBACK_EXPERIMENT");
+        v = (e && e[0] == '1') ? 1 : 0;
+    }
+    return v;
+}
+
+static CUcontext      g_neutron_ctx;
+static CUdeviceptr_v2 g_neutron_cand[32];
+static int            g_neutron_cand_n;
+static int            g_neutron_present_started;
+
+typedef struct { int left, top, right, bottom; } N_RECT;
+typedef struct { unsigned biSize; int biWidth, biHeight; unsigned short biPlanes, biBitCount;
+                 unsigned biCompression, biSizeImage; int biXPPM, biYPPM; unsigned biClrUsed, biClrImp; } N_BMIH;
+typedef struct { N_BMIH h; unsigned colors[1]; } N_BMI;
+typedef void* N_HDC;
+
+typedef N_HDC (WINAPI *PFN_GetDC)(HWND);
+typedef int   (WINAPI *PFN_ReleaseDC)(HWND, N_HDC);
+typedef int   (WINAPI *PFN_GetClientRect)(HWND, N_RECT*);
+typedef int   (WINAPI *PFN_SetStretchBltMode)(N_HDC, int);
+typedef int   (WINAPI *PFN_StretchDIBits)(N_HDC,int,int,int,int,int,int,int,int,const void*,const N_BMI*,unsigned,unsigned);
+typedef int   (WINAPI *PFN_EnumWindows)(void*, LPARAM);
+typedef int   (WINAPI *PFN_EnumChildWindows)(HWND, void*, LPARAM);
+
+static PFN_GetDC             p_GetDC;
+static PFN_ReleaseDC         p_ReleaseDC;
+static PFN_GetClientRect     p_GetClientRect;
+static PFN_SetStretchBltMode p_SetStretchBltMode;
+static PFN_StretchDIBits     p_StretchDIBits;
+static PFN_EnumWindows       p_EnumWindows;
+static PFN_EnumChildWindows  p_EnumChildWindows;
+static HWND g_best_hwnd;
+static int  g_best_area;
+
+static BOOL WINAPI neutron_enum_proc(HWND hwnd, LPARAM lp)
+{
+    N_RECT r;
+    if (p_GetClientRect && p_GetClientRect(hwnd, &r))
+    {
+        int w = r.right - r.left, h = r.bottom - r.top;
+        if (w >= 1200 && h >= 600 && w > h)
+        {
+            int area = w * h;
+            ERR("neutron-win: hwnd=%p %dx%d\n", hwnd, w, h);
+            if (area > g_best_area) { g_best_area = area; g_best_hwnd = hwnd; }
+        }
+    }
+    if (p_EnumChildWindows) p_EnumChildWindows(hwnd, neutron_enum_proc, 0);
+    return TRUE;
+}
+
+static HWND neutron_find_monitor(void)
+{
+    HMODULE u = GetModuleHandleA("user32.dll");
+    HMODULE g = GetModuleHandleA("gdi32.dll");
+    const char *env = getenv("NEUTRON_HWND");
+    if (!u || !g) { ERR("neutron-win: user32/gdi32 missing u=%p g=%p\n", u, g); return NULL; }
+    p_GetDC             = (PFN_GetDC)GetProcAddress(u, "GetDC");
+    p_ReleaseDC         = (PFN_ReleaseDC)GetProcAddress(u, "ReleaseDC");
+    p_GetClientRect     = (PFN_GetClientRect)GetProcAddress(u, "GetClientRect");
+    p_EnumWindows       = (PFN_EnumWindows)GetProcAddress(u, "EnumWindows");
+    p_EnumChildWindows  = (PFN_EnumChildWindows)GetProcAddress(u, "EnumChildWindows");
+    p_SetStretchBltMode = (PFN_SetStretchBltMode)GetProcAddress(g, "SetStretchBltMode");
+    p_StretchDIBits     = (PFN_StretchDIBits)GetProcAddress(g, "StretchDIBits");
+    if (env && *env)
+    {
+        unsigned long long h = strtoull(env, NULL, 0);
+        ERR("neutron-win: using NEUTRON_HWND=%#llx\n", h);
+        return (HWND)(UINT_PTR)h;
+    }
+    g_best_hwnd = NULL; g_best_area = 0;
+    if (p_EnumWindows) p_EnumWindows((void*)neutron_enum_proc, 0);
+    ERR("neutron-win: chosen hwnd=%p area=%d\n", g_best_hwnd, g_best_area);
+    return g_best_hwnd;
+}
+
+static void neutron_paint(HWND hwnd, const unsigned char *bgra, unsigned w, unsigned h)
+{
+    N_HDC dc; N_RECT rc; N_BMI bmi;
+    if (!hwnd || !p_GetDC || !p_StretchDIBits || !p_GetClientRect) return;
+    if (!p_GetClientRect(hwnd, &rc)) return;
+    dc = p_GetDC(hwnd);
+    if (!dc) return;
+    memset(&bmi, 0, sizeof(bmi));
+    bmi.h.biSize = sizeof(N_BMIH);
+    bmi.h.biWidth = (int)w;
+    bmi.h.biHeight = -(int)h;          /* top-down */
+    bmi.h.biPlanes = 1;
+    bmi.h.biBitCount = 32;
+    bmi.h.biCompression = 0;           /* BI_RGB */
+    if (p_SetStretchBltMode) p_SetStretchBltMode(dc, 3 /*COLORONCOLOR*/);
+    p_StretchDIBits(dc, 0, 0, rc.right - rc.left, rc.bottom - rc.top,
+                    0, 0, (int)w, (int)h, bgra, &bmi, 0 /*DIB_RGB_COLORS*/, 0x00CC0020 /*SRCCOPY*/);
+    p_ReleaseDC(hwnd, dc);
+}
+
+static DWORD WINAPI neutron_present_thread(LPVOID arg)
+{
+    const unsigned N = 2560, H = 1707;
+    size_t full = (size_t)N * H * 16ull;
+    const char *cs = getenv("NEUTRON_CAND");
+    int cand = cs ? atoi(cs) : 0;
+    int auto_track = (cs == NULL);     /* no NEUTRON_CAND => follow freshest buffer */
+    int gamma_on = (getenv("NEUTRON_GAMMA") != NULL);
+    int last_sel = -1, clk = 0;
+    unsigned long long sig[32];
+    int gen[32];
+    float smp[4096];                   /* 16 KB center sample for change detection */
+    float *host;
+    unsigned char *bgra;
+    HWND hwnd;
+    int it;
+
+    Sleep(8000);
+    if (g_neutron_ctx) pcuCtxSetCurrent(g_neutron_ctx);
+    host = VirtualAlloc(NULL, full, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
+    bgra = VirtualAlloc(NULL, (size_t)N * H * 4, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE);
+    hwnd = neutron_find_monitor();
+    ERR("neutron-present: start hwnd=%p cand=%d cand_n=%d host=%p bgra=%p\n",
+        hwnd, cand, g_neutron_cand_n, host, bgra);
+    if (!host || !bgra) { ERR("neutron-present: host alloc fail\n"); return 0; }
+    memset(sig, 0, sizeof(sig));
+    memset(gen, 0, sizeof(gen));
+    ERR("neutron-track: auto=%d (NEUTRON_CAND %s)\n", auto_track, cs ? cs : "unset");
+
+    for (it = 0; it < 100000; it++)        /* continuous; kill -9 to stop */
+    {
+        CUdeviceptr_v2 p;
+        CUresult r;
+        unsigned i, n = N * H;
+        int sel, k;
+        Sleep(50);
+        if (!hwnd || g_neutron_cand_n <= 0) continue;
+        if (auto_track)
+        {
+            int best = -1, bestgen = -1;
+            size_t soff = ((size_t)(H / 2) * N + (N / 2)) * 16ull;
+            clk++;
+            for (k = 0; k < g_neutron_cand_n; k++)
+            {
+                CUdeviceptr_v2 cp = g_neutron_cand[k];
+                unsigned long long s = 1469598103934665603ull;
+                int z;
+                if (!cp) continue;
+                if (pcuMemcpyDtoH_v2(smp, cp + soff, sizeof(smp))) continue;
+                for (z = 0; z < (int)(sizeof(smp) / sizeof(smp[0])); z++)
+                {
+                    unsigned bits;
+                    memcpy(&bits, &smp[z], sizeof(bits));
+                    s = (s ^ bits) * 1099511628211ull;
+                }
+                if (s != sig[k]) { sig[k] = s; gen[k] = clk; }
+                if (gen[k] > bestgen) { bestgen = gen[k]; best = k; }
+            }
+            sel = (best >= 0) ? best : ((cand >= 0 && cand < g_neutron_cand_n) ? cand : 0);
+        }
+        else
+        {
+            sel = (cand >= 0 && cand < g_neutron_cand_n) ? cand : 0;
+        }
+        if (sel != last_sel) { ERR("neutron-track: presenting cand[%d] of %d\n", sel, g_neutron_cand_n); last_sel = sel; }
+        p = g_neutron_cand[sel];
+        if (!p) continue;
+        r = pcuMemcpyDtoH_v2(host, p, full);
+        if (r) continue;
+        for (i = 0; i < n; i++)
+        {
+            float b = host[i*4+0], g = host[i*4+1], rr = host[i*4+2];  /* BGRA: ch0=B, ch2=R */
+            if (b < 0) b = 0; if (b > 1) b = 1;
+            if (g < 0) g = 0; if (g > 1) g = 1;
+            if (rr < 0) rr = 0; if (rr > 1) rr = 1;
+            if (gamma_on) { b = __builtin_sqrtf(b); g = __builtin_sqrtf(g); rr = __builtin_sqrtf(rr); }
+            bgra[i*4+0] = (unsigned char)(b  * 255.0f + 0.5f);  /* GDI memory order B,G,R,A */
+            bgra[i*4+1] = (unsigned char)(g  * 255.0f + 0.5f);
+            bgra[i*4+2] = (unsigned char)(rr * 255.0f + 0.5f);
+            bgra[i*4+3] = 255;
+        }
+        neutron_paint(hwnd, bgra, N, H);
+    }
+    return 0;
+}
+
+static void neutron_start_present(void)
+{
+    if (g_neutron_present_started) return;
+    g_neutron_present_started = 1;
+    CreateThread(NULL, 0, neutron_present_thread, NULL, 0, NULL);
+}
+
+/* ----- Neutron live-buffer finder (diagnostic) ----- */
+static CUdeviceptr_v2 g_all[64];
+static size_t         g_all_sz[64];
+static int            g_all_n;
+static int            g_live_started;
+
+static DWORD WINAPI neutron_live_thread(LPVOID arg)
+{
+    static unsigned long long sig[64];
+    static unsigned char buf[8192];
+    int it, k;
+    Sleep(8000);
+    if (g_neutron_ctx) pcuCtxSetCurrent(g_neutron_ctx);
+    ERR("neutron-live: finder start n=%d\n", g_all_n);
+    for (it = 0; it < 120; it++)
+    {
+        Sleep(1000);
+        for (k = 0; k < g_all_n; k++)
+        {
+            CUdeviceptr_v2 p = g_all[k];
+            size_t sz = g_all_sz[k];
+            size_t off = (sz / 2) & ~((size_t)15);
+            unsigned long long s = 1469598103934665603ull;
+            double sum = 0.0;
+            int z;
+            if (!p) continue;
+            if (off + sizeof(buf) > sz) off = 0;
+            if (pcuMemcpyDtoH_v2(buf, p + off, sizeof(buf))) continue;
+            for (z = 0; z < (int)sizeof(buf); z++) { s = (s ^ buf[z]) * 1099511628211ull; sum += buf[z]; }
+            if (s != sig[k])
+            {
+                sig[k] = s;
+                ERR("neutron-live: CHANGED idx=%d ptr=%#llx size=%zu mean=%.1f\n",
+                    k, (unsigned long long)p, sz, sum / (double)sizeof(buf));
+            }
+        }
+    }
+    ERR("neutron-live: finder exit\n");
+    return 0;
+}
+
+static void neutron_live_record(CUresult _r, CUdeviceptr_v2 *dptr, size_t bytesize)
+{
+    CUdeviceptr_v2 p;
+    int i;
+    if (_r != CUDA_SUCCESS || bytesize < 4000000ull || g_all_n >= 64) return;
+    p = dptr ? *dptr : 0;
+    if (!p) return;
+    for (i = 0; i < g_all_n; i++) if (g_all[i] == p) return;
+    g_all[g_all_n] = p; g_all_sz[g_all_n] = bytesize; g_all_n++;
+    if (!g_live_started)
+    {
+        g_live_started = 1;
+        if (g_neutron_ctx == NULL) pcuCtxGetCurrent(&g_neutron_ctx);
+        CreateThread(NULL, 0, neutron_live_thread, NULL, 0, NULL);
+    }
+}
+/* ---------------------------------------------------- */
+
+static void neutron_capture(CUresult _r, CUdeviceptr_v2 *dptr, size_t bytesize)
+{
+    CUdeviceptr_v2 p;
+    int i;
+    if (_r != CUDA_SUCCESS) return;
+    /* Single choke point for the whole experiment: no recording, no live thread, and above all
+     * no present thread painting into the Program Monitor, unless explicitly armed. */
+    if (!neutron_playback_experiment()) return;
+    neutron_live_record(_r, dptr, bytesize);
+    if (bytesize >= 8000000ull)
+        ERR("neutron-allocsz: %zu\n", (size_t)bytesize);   /* discover playback buffer sizes */
+    if (bytesize != 69918720ull || g_neutron_cand_n >= 32) return;
+    p = dptr ? *dptr : 0;
+    if (!p) return;
+    for (i = 0; i < g_neutron_cand_n; i++) if (g_neutron_cand[i] == p) return;
+    pcuCtxGetCurrent(&g_neutron_ctx);
