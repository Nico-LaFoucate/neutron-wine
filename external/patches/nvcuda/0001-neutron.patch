+/* NEUTRON 2026-08-03 -- resolve an NT shared-GPU-resource handle to its host file descriptor.
+ *
+ * WHY THIS EXISTS: get_shared_resource_fd() above speaks IOCTL_SHARED_GPU_RESOURCE_GET_UNIX_RESOURCE,
+ * which is a *Proton* invention. Our Wine does not have it at all -- it implements shared GPU
+ * resources through its own D3DKMT object subsystem in win32u instead, so that ioctl failed every
+ * single time and the CUDA <-> D3D11 interop dead-ended one step from working.
+ *
+ * The route that DOES exist: a shared texture's memory is Vulkan memory that winevulkan exported
+ * as an opaque fd and handed to the wineserver, which wraps it in a D3DKMT object. Re-opening that
+ * object by its NT handle gives back a server handle over the very same fd. win32u does exactly
+ * this internally -- dlls/win32u/vulkan.c calls d3dkmt_open_resource() then d3dkmt_object_get_fd()
+ * -- but neither helper is exported, and adding a win32u syscall thunk to reach them would put a
+ * core, every-app-in-every-prefix component at risk for one app's overlay. Both helpers are thin
+ * wrappers over plain wineserver requests, which any winelib DLL may issue, so we issue them here.
+ *
+ * VERIFIED, not assumed: the request opcode (index 302 in `enum request`) and the byte layout of
+ * d3dkmt_object_open_request/_reply and `enum d3dkmt_type` are identical between the protocol
+ * headers this DLL is built against and the running runtime's -- checked field by field before
+ * writing this, because a silent opcode shift would invoke a completely different server request.
+ *
+ * Returns a host fd suitable for cuImportExternalMemory(OPAQUE_FD), or -1. */
+int get_shared_resource_fd_d3dkmt(HANDLE shared)
+{
+    unsigned int status, runtime_size = 0;
+    HANDLE object = NULL;
+    void *runtime = NULL;
+    int unix_fd = -1;
+
+    SERVER_START_REQ( d3dkmt_object_query )
+    {
+        req->type   = D3DKMT_RESOURCE;
+        req->global = 0;
+        req->handle = wine_server_obj_handle( shared );
+        status = wine_server_call( req );
+        runtime_size = reply->runtime_size;
+    }
+    SERVER_END_REQ;
+
+    if (status)
+    {
+        ERR("neutron-d3dkmt: the server does not know shared handle %p as a resource (status %#x)\n",
+             shared, status);
+        return -1;
+    }
+
+    /* mirror win32u's d3dkmt_open_resource(): query for the runtime-data size, then open with a
+     * buffer that big. The data itself is the DXGI descriptor and we have no use for it. */
+    if (runtime_size && !(runtime = malloc( runtime_size )))
+        return -1;
+
+    SERVER_START_REQ( d3dkmt_object_open )
+    {
+        req->type   = D3DKMT_RESOURCE;
+        req->global = 0;
+        req->handle = wine_server_obj_handle( shared );
+        if (runtime) wine_server_set_reply( req, runtime, runtime_size );
+        status = wine_server_call( req );
+        object = wine_server_ptr_handle( reply->handle );
+    }
+    SERVER_END_REQ;
+    free( runtime );
+
+    if (status || !object)
+    {
+        ERR("neutron-d3dkmt: failed to open resource %p (status %#x)\n", shared, status);
+        return -1;
+    }
+
+    status = wine_server_handle_to_fd( object, GENERIC_ALL, &unix_fd, NULL );
+    NtClose( object );
+
+    if (status || unix_fd < 0)
+    {
+        ERR("neutron-d3dkmt: resource object has no fd (status %#x)\n", status);
+        return -1;
+    }
+
+    return unix_fd;
+}
