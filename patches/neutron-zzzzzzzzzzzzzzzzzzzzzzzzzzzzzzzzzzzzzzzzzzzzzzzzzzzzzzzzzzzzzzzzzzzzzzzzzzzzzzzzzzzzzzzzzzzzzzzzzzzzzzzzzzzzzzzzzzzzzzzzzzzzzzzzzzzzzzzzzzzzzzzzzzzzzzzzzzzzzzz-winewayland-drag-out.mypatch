# neutron-winewayland-drag-out -- drag files, text and links out of a Windows application onto Linux applications
#
# Touches: dlls/ole32/ole2.c, dlls/winewayland.drv/{wayland_data_device.c,wayland_pointer.c,waylanddrv.h,window.c,wayland.c}.
# Applies on the 185 tree after every earlier winewayland drag-and-drop patch (zzzzzzzj, zzzzzzzk,
# ...h dnd-with-data-control).
#
# WHAT WAS SEEN (lab, 11-07, Adobe Bridge 2026 on 11.10-185): dragging a JPG from Bridge's content panel onto the Linux
# desktop or a file manager does nothing (2/2). Dropping from the file manager INTO Bridge works. The same for every
# Windows application: Premiere's project panel, Explorer-style views, text dragged out of an editor.
#
# MECHANISM (source): Windows applications drag with OLE DoDragDrop(IDataObject, IDropSource, effects). ole32's loop finds
# the target with WindowFromPoint, which knows only Wine's windows, and nothing told the compositor that a drag was running:
# winewayland implemented the receiving side of wl_data_device only (it never called wl_data_device.start_drag). winex11
# has no drag source either (its XDND code only receives), so this is not specific to Wayland. winewayland also bound
# wl_data_device_manager at version 2, which has no drag actions and no drop/finish events for a source.
#
# WINDOWS: DoDragDrop runs one modal loop for every target, in or out of the process: the target under the cursor (real
# z-order) gets DragEnter/DragOver/Drop with the source's IDataObject and calls GetData when it needs the data; DoDragDrop
# returns DRAGDROP_S_DROP with the effect the target answered, DRAGDROP_S_CANCEL on Escape, DROP with no effect over a window
# that is no target.
#
# FIX (kill switch NEUTRON_DRAG_OUT=0: the driver refuses, wl_data_device_manager stays at version 2 = 11.10-185):
#  - ole32: at the start of DoDragDrop the tracker asks the user driver (WM_WINE_DRAG_SOURCE = WM_WINE_LAST_DRIVER_MSG on its
#    tracker window, by SendMessageTimeout, the path that reaches the driver; a driver without it answers 0 and nothing
#    changes) to run the drag on the desktop, with the kinds the data object has (QueryGetData): files (CF_HDROP, or
#    FileGroupDescriptorW + FileContents), text (CF_UNICODETEXT/CF_TEXT), a link (UniformResourceLocatorW/A).
#  - winewayland: a wl_data_source (version 3) started with wl_data_device.start_drag from the press that holds the pointer's
#    implicit grab, offering text/uri-list (files: file:// URIs of the real unix paths; a link), text/plain;charset=utf-8 and
#    text/plain; DROPEFFECT copy/link -> copy, move -> move. Data is rendered by ole32 on the DoDragDrop thread only when a
#    target asks for a type (wl_data_source.send wakes the tracker, which calls GetData and hands the bytes back); virtual
#    files are written to %TEMP%\WineDrag-xxxxxxxx then.
#  - Wine windows keep the old path: a last, private offered type names the tracker window and a cookie (window property). A
#    Wine window of the same wineserver under the pointer, in any process, recognizes it, marks itself on the tracker (window
#    property WineDragTarget), accepts only that type and turns the drag's motion and drop into the hardware mouse move and
#    button release they are on Windows; they reach the source's OLE loop through its capture window, which does
#    WindowFromPoint and calls the target's IDropTarget with the application's own IDataObject, across processes too. The
#    compositor decides which surface is under the pointer, so a Linux window above a Wine window gets the drop.
#  - over a Linux client ole32 has no Wine target and reports the client's action as the effect. dnd_drop_performed sends the
#    button release the compositor consumed; DoDragDrop then waits (dispatching messages, at most 15 s) for dnd_finished or
#    cancelled and returns DRAGDROP_S_DROP with the finished action's effect (copy/move), or no effect when cancelled.
#    Escape that reaches the application cancels as before and destroys the source; a cancel by the compositor releases the
#    button and ends the drag with no effect.
#
# NOT COVERED / IMPERFECT VS WINDOWS:
#  - no drag image: the compositor shows its own drag cursor; IDropSource::GiveFeedback cursors and IDragSourceHelper images
#    are not shown while the compositor runs the drag, and over a Wine window the compositor cursor shows "copy" even where
#    the Wine target refuses (the drop itself is decided by the target, as on Windows).
#  - Escape the compositor keeps: DoDragDrop returns DRAGDROP_S_DROP with no effect instead of DRAGDROP_S_CANCEL.
#  - move to a Linux file manager: the manager moves the file itself; DoDragDrop returns DROPEFFECT_MOVE (Windows' shell
#    reports an optimized move differently; not measured).
#  - a drag started after the button is already up, or from a touch/pen press the compositor holds as a tablet grab, stays
#    on Wine's windows (as before).
#  - virtual files stay in %TEMP%\WineDrag-* (the Linux client may read them after the drop).
#  - only CF_HDROP, FileGroupDescriptorW (not the ANSI FileGroupDescriptor), text and links reach Linux clients; private
#    formats only reach Wine windows.
#
#  - Dolphin's own drop menu (Move Here / Copy Here) opens after the Wayland drop is finished, so DoDragDrop reports the
#    negotiated action (copy) before the user picks; the file operation itself is Dolphin's.
#
# LAB EVIDENCE (lab runtime 11.10-185dg = 11.10-185 + this patch's ole32 and winewayland, nested KWin, fakeptr drags):
#  - test program (OLE source + target): file -> Linux (QML DropArea) delivered file:// URI, DoDragDrop DROP effect copy
#    4/4 (t5, t8, u1, t20 second drag); text with non-ASCII 2/2 exact (t10; t9 = drag started after the button was up,
#    driver declined, old path); virtual file (FileGroupDescriptorW/FileContents) 3/3 (written to %TEMP%, drive_c path);
#    drop on its own Wine target through the compositor drag 2/2 (t13 file, t14 text). Kill switch, same build: file ->
#    Linux nothing delivered, DROP effect 0, 2/2 (t15, t16); own-window drop unchanged 1/1 (t17).
#  - Escape during a drag over the Linux client 1/1: DRAGDROP_S_CANCEL, the client got no drop, the source and the held
#    button were released, the next drag in the same process delivered normally.
#  - Adobe Bridge 2026 (lab copies of BrIc-base): JPG -> Dolphin (Linux, inside the same sandbox) delivered 8/8 drags;
#    Copy Here 2/2 (byte-identical copy, source kept), Move Here 1/1 (file moved); 4 more menu clicks did nothing in Dolphin
#    after a completed transfer (not established; transfer side finished every time). Kill switch, same build: no drag
#    reaches Dolphin 1/1. Bridge -> Photoshop 2026 (another Wine process) through the compositor drag: Photoshop placed the
#    JPG into the open document 1/1 (cross-process OLE drop on the Wine path).
#  - drag IN (Dolphin -> Bridge) with the version-3 binding: 2/2 delivered (effect copy); kill switch arm 1/1 the same.
--- a/dlls/ole32/ole2.c
+++ b/dlls/ole32/ole2.c
@@ -40,6 +40,7 @@
 #include "winreg.h"
 #include "ole2.h"
 #include "ole2ver.h"
+#include "shlobj.h"
 
 #include "compobj_private.h"
 #include "olestd.h"
@@ -72,6 +73,14 @@
   IDropTarget* curDragTarget;
   POINTL     curMousePos;       /* current position of the mouse in screen coordinates */
   DWORD      dwKeyState;        /* current state of the shift and ctrl keys and the mouse buttons */
+
+  /* NEUTRON drag-out: the drag also runs on the host desktop (see host_drag_start) */
+  HWND       hwndTracker;
+  BOOL       hostDrag;
+  DWORD      hostKinds;         /* HOST_KIND_* the data object has */
+  DWORD      hostRendered;      /* HOST_KIND_* handed to the driver */
+  DWORD      hostState;         /* HOST_STATE_* */
+  DWORD      hostAction;        /* the host's dnd action */
 } TrackerWindowInfo;
 
 typedef struct tagOleMenuDescriptor  /* OleMenuDescriptor */
@@ -730,6 +739,398 @@
   return S_OK;
 }
 
+/******************************************************************************
+ * NEUTRON drag-out: a drag the user driver runs on the host desktop.
+ *
+ * WindowFromPoint knows only Wine's windows, so a drag could never leave them: dropping a file from a Windows
+ * application on a Linux file manager did nothing. At the start of every DoDragDrop the tracker asks the user
+ * driver (WM_WINE_DRAG_SOURCE on the tracker window; a driver without it answers 0 and nothing changes) to run the
+ * drag on the desktop too. The driver turns the pointer over any Wine window back into hardware mouse input to this
+ * loop, so Wine targets are found and called as before; over a host application the driver reports its state
+ * (HOST_STATE_*), and the host asks for data, which is rendered here, on the DoDragDrop thread, only when asked.
+ * Driver side: dlls/winewayland.drv/wayland_data_device.c. Keep these definitions in sync with it.
+ */
+#define WM_WINE_DRAG_SOURCE 0x80001fff  /* WM_WINE_LAST_DRIVER_MSG */
+
+enum { HOST_DRAG_START = 1, HOST_DRAG_POLL, HOST_DRAG_DATA, HOST_DRAG_END };
+enum { HOST_STATE_NONE, HOST_STATE_STARTED, HOST_STATE_WINE, HOST_STATE_FOREIGN, HOST_STATE_DROPPED,
+       HOST_STATE_FINISHED, HOST_STATE_CANCELLED };
+#define HOST_KIND_FILES 1
+#define HOST_KIND_TEXT  2
+#define HOST_KIND_URL   4
+#define HOST_ACTION_COPY 1
+#define HOST_ACTION_MOVE 2
+#ifndef FD_ATTRIBUTES
+#define FD_ATTRIBUTES 0x0004  /* FILEDESCRIPTOR dwFlags, Windows SDK shlobj_core.h */
+#define FD_FILESIZE   0x0040
+#endif
+
+struct host_drag_params
+{
+    UINT32 size;
+    UINT32 effects;
+    UINT32 kinds;
+    UINT32 state;
+    UINT32 action;
+    UINT32 bytes;
+    UINT64 data;
+};
+
+static DWORD_PTR host_drag_call( TrackerWindowInfo *info, UINT op, struct host_drag_params *params )
+{
+    DWORD_PTR res = 0;
+
+    /* SendMessageTimeout, not SendMessage: only that path hands an internal message to the driver on this thread */
+    if (!SendMessageTimeoutW( info->hwndTracker, WM_WINE_DRAG_SOURCE, op, (LPARAM)params, SMTO_NORMAL, 5000, &res ))
+        return 0;
+    return res;
+}
+
+static BOOL host_drag_has( IDataObject *obj, CLIPFORMAT cf )
+{
+    FORMATETC fmt = { cf, NULL, DVASPECT_CONTENT, -1, TYMED_HGLOBAL };
+    return cf && IDataObject_QueryGetData( obj, &fmt ) == S_OK;
+}
+
+static HRESULT host_drag_get( IDataObject *obj, CLIPFORMAT cf, LONG index, DWORD tymed, STGMEDIUM *medium )
+{
+    FORMATETC fmt = { cf, NULL, DVASPECT_CONTENT, index, tymed };
+    HRESULT hr = IDataObject_GetData( obj, &fmt, medium );
+
+    if (SUCCEEDED(hr) && !(medium->tymed & tymed))
+    {
+        ReleaseStgMedium( medium );
+        hr = DV_E_TYMED;
+    }
+    return hr;
+}
+
+static DWORD host_drag_kinds( IDataObject *obj )
+{
+    DWORD kinds = 0;
+
+    if (host_drag_has( obj, CF_HDROP ) || host_drag_has( obj, RegisterClipboardFormatW( CFSTR_FILEDESCRIPTORW )))
+        kinds |= HOST_KIND_FILES;
+    if (host_drag_has( obj, CF_UNICODETEXT ) || host_drag_has( obj, CF_TEXT ))
+        kinds |= HOST_KIND_TEXT;
+    if (host_drag_has( obj, RegisterClipboardFormatW( CFSTR_INETURLW )) ||
+        host_drag_has( obj, RegisterClipboardFormatA( CFSTR_INETURLA )))
+        kinds |= HOST_KIND_URL;
+    return kinds;
+}
+
+/* Text from a UTF-16 or an ANSI format, null-terminated. */
+static WCHAR *host_drag_text( IDataObject *obj, CLIPFORMAT cfW, CLIPFORMAT cfA, SIZE_T *bytes )
+{
+    STGMEDIUM medium;
+    WCHAR *ret = NULL;
+    SIZE_T len = 0, max;
+
+    if (SUCCEEDED(host_drag_get( obj, cfW, -1, TYMED_HGLOBAL, &medium )))
+    {
+        const WCHAR *text = GlobalLock( medium.hGlobal );
+        max = GlobalSize( medium.hGlobal ) / sizeof(WCHAR);
+        if (text)
+        {
+            while (len < max && text[len]) len++;
+            if ((ret = malloc( (len + 1) * sizeof(WCHAR) )))
+            {
+                memcpy( ret, text, len * sizeof(WCHAR) );
+                ret[len] = 0;
+            }
+            GlobalUnlock( medium.hGlobal );
+        }
+        ReleaseStgMedium( &medium );
+    }
+    else if (cfA && SUCCEEDED(host_drag_get( obj, cfA, -1, TYMED_HGLOBAL, &medium )))
+    {
+        const char *text = GlobalLock( medium.hGlobal );
+        max = GlobalSize( medium.hGlobal );
+        if (text)
+        {
+            int wlen;
+            while (len < max && text[len]) len++;
+            wlen = MultiByteToWideChar( CP_ACP, 0, text, len, NULL, 0 );
+            if ((ret = malloc( (wlen + 1) * sizeof(WCHAR) )))
+            {
+                MultiByteToWideChar( CP_ACP, 0, text, len, ret, wlen );
+                ret[wlen] = 0;
+                len = wlen;
+            }
+            GlobalUnlock( medium.hGlobal );
+        }
+        ReleaseStgMedium( &medium );
+    }
+    *bytes = ret ? (len + 1) * sizeof(WCHAR) : 0;
+    return ret;
+}
+
+/* Append a path to a double-null-terminated list. */
+static WCHAR *host_drag_add_path( WCHAR *list, SIZE_T *len, const WCHAR *path )
+{
+    SIZE_T n = wcslen( path ) + 1;
+    WCHAR *bigger = realloc( list, (*len + n + 1) * sizeof(WCHAR) );
+
+    if (!bigger) return list;
+    memcpy( bigger + *len, path, n * sizeof(WCHAR) );
+    *len += n;
+    bigger[*len] = 0;
+    return bigger;
+}
+
+/* FileGroupDescriptorW + FileContents ("virtual" files: mail attachments, archive members): the host only takes
+ * paths, so write them into a new folder under %TEMP% and hand over its top-level entries. */
+static WCHAR *host_drag_virtual_files( IDataObject *obj, SIZE_T *len )
+{
+    CLIPFORMAT cf_contents = RegisterClipboardFormatW( CFSTR_FILECONTENTSW );
+    WCHAR dir[MAX_PATH], path[MAX_PATH * 2], *list = NULL, *p;
+    FILEGROUPDESCRIPTORW *group;
+    STGMEDIUM medium, contents;
+    UINT i, dirlen;
+
+    if (FAILED(host_drag_get( obj, RegisterClipboardFormatW( CFSTR_FILEDESCRIPTORW ), -1, TYMED_HGLOBAL, &medium )))
+        return NULL;
+    if (!(group = GlobalLock( medium.hGlobal )) ||
+        GlobalSize( medium.hGlobal ) < FIELD_OFFSET(FILEGROUPDESCRIPTORW, fgd[group->cItems]))
+        goto done;
+
+    dirlen = GetTempPathW( MAX_PATH - 24, dir );
+    if (!dirlen || dirlen >= MAX_PATH - 24) goto done;
+    swprintf( dir + dirlen, MAX_PATH - dirlen, L"WineDrag-%08lx\\", GetTickCount() ^ (GetCurrentProcessId() << 20) );
+    if (!CreateDirectoryW( dir, NULL )) goto done;
+    dirlen = wcslen( dir );
+
+    for (i = 0; i < group->cItems; i++)
+    {
+        const FILEDESCRIPTORW *fd = &group->fgd[i];
+        BOOL top = !wcschr( fd->cFileName, '\\' ) && !wcschr( fd->cFileName, '/' );
+        HANDLE file;
+        HRESULT hr;
+
+        /* names are relative to the drop folder; never let one climb out of it */
+        if (!fd->cFileName[0] || fd->cFileName[0] == '\\' || fd->cFileName[0] == '/' ||
+            wcschr( fd->cFileName, ':' ) || wcsstr( fd->cFileName, L".." ))
+            continue;
+        if (dirlen + wcslen( fd->cFileName ) >= ARRAY_SIZE(path)) continue;
+        wcscpy( path, dir );
+        wcscat( path, fd->cFileName );
+        for (p = path + dirlen; *p; p++)
+        {
+            if (*p != '\\' && *p != '/') continue;
+            *p = 0;
+            CreateDirectoryW( path, NULL );
+            *p = '\\';
+        }
+        if ((fd->dwFlags & FD_ATTRIBUTES) && (fd->dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY))
+        {
+            CreateDirectoryW( path, NULL );
+            if (top) list = host_drag_add_path( list, len, path );
+            continue;
+        }
+
+        hr = host_drag_get( obj, cf_contents, i, TYMED_HGLOBAL | TYMED_ISTREAM, &contents );
+        if (FAILED(hr))
+        {
+            WARN( "no contents for %s: %#lx\n", debugstr_w(fd->cFileName), hr );
+            continue;
+        }
+        file = CreateFileW( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+        if (file != INVALID_HANDLE_VALUE)
+        {
+            DWORD written;
+
+            if (contents.tymed == TYMED_HGLOBAL)
+            {
+                SIZE_T size = GlobalSize( contents.hGlobal );
+                void *bits = GlobalLock( contents.hGlobal );
+
+                if ((fd->dwFlags & FD_FILESIZE) && !fd->nFileSizeHigh && fd->nFileSizeLow < size)
+                    size = fd->nFileSizeLow;
+                if (bits) WriteFile( file, bits, size, &written, NULL );
+                GlobalUnlock( contents.hGlobal );
+            }
+            else
+            {
+                char buffer[65536];
+                ULONG got;
+
+                while (SUCCEEDED(IStream_Read( contents.pstm, buffer, sizeof(buffer), &got )) && got)
+                    WriteFile( file, buffer, got, &written, NULL );
+            }
+            CloseHandle( file );
+            if (top) list = host_drag_add_path( list, len, path );
+        }
+        ReleaseStgMedium( &contents );
+    }
+
+done:
+    GlobalUnlock( medium.hGlobal );
+    ReleaseStgMedium( &medium );
+    return list;
+}
+
+/* Files as a double-null-terminated list of DOS paths. */
+static WCHAR *host_drag_files( IDataObject *obj, SIZE_T *bytes )
+{
+    STGMEDIUM medium;
+    WCHAR *list = NULL;
+    SIZE_T len = 0;
+
+    if (SUCCEEDED(host_drag_get( obj, CF_HDROP, -1, TYMED_HGLOBAL, &medium )))
+    {
+        const DROPFILES *files = GlobalLock( medium.hGlobal );
+        SIZE_T size = GlobalSize( medium.hGlobal );
+
+        if (files && size > sizeof(*files) && files->pFiles < size)
+        {
+            if (files->fWide)
+            {
+                const WCHAR *p = (const WCHAR *)((const char *)files + files->pFiles);
+                SIZE_T max = (size - files->pFiles) / sizeof(WCHAR), n;
+
+                while (len < max && p[len])
+                {
+                    for (n = len; n < max && p[n]; n++) ;
+                    if (n == max) break;
+                    list = host_drag_add_path( list, &len, p + len ) ;
+                    if (len != n + 1) break;
+                }
+            }
+            else
+            {
+                const char *p = (const char *)files + files->pFiles;
+                SIZE_T max = size - files->pFiles, pos = 0, n;
+                WCHAR path[MAX_PATH];
+
+                while (pos < max && p[pos])
+                {
+                    for (n = pos; n < max && p[n]; n++) ;
+                    if (n == max) break;
+                    if (MultiByteToWideChar( CP_ACP, 0, p + pos, -1, path, MAX_PATH ))
+                        list = host_drag_add_path( list, &len, path );
+                    pos = n + 1;
+                }
+            }
+        }
+        GlobalUnlock( medium.hGlobal );
+        ReleaseStgMedium( &medium );
+    }
+    if (!list) list = host_drag_virtual_files( obj, &len );
+    *bytes = list ? (len + 1) * sizeof(WCHAR) : 0;
+    return list;
+}
+
+/* Render the kinds the host asked for, once each. */
+static void host_drag_render( TrackerWindowInfo *info, DWORD kinds )
+{
+    static const DWORD all[] = { HOST_KIND_FILES, HOST_KIND_TEXT, HOST_KIND_URL };
+    struct host_drag_params params = { sizeof(params) };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(all); i++)
+    {
+        SIZE_T bytes = 0;
+        WCHAR *data = NULL;
+
+        if (!(kinds & all[i] & info->hostKinds) || (info->hostRendered & all[i])) continue;
+        info->hostRendered |= all[i];
+        if (all[i] == HOST_KIND_FILES) data = host_drag_files( info->dataObject, &bytes );
+        else if (all[i] == HOST_KIND_TEXT)
+            data = host_drag_text( info->dataObject, CF_UNICODETEXT, CF_TEXT, &bytes );
+        else
+            data = host_drag_text( info->dataObject, RegisterClipboardFormatW( CFSTR_INETURLW ),
+                                   RegisterClipboardFormatA( CFSTR_INETURLA ), &bytes );
+        TRACE( "kind %#lx: %Iu bytes\n", all[i], bytes );
+        params.kinds = all[i];
+        params.data = (UINT_PTR)data;
+        params.bytes = bytes;
+        host_drag_call( info, HOST_DRAG_DATA, &params );
+        free( data );
+    }
+}
+
+static void host_drag_poll( TrackerWindowInfo *info )
+{
+    struct host_drag_params params = { sizeof(params) };
+
+    if (!info->hostDrag || !host_drag_call( info, HOST_DRAG_POLL, &params )) return;
+    info->hostState = params.state;
+    info->hostAction = params.action;
+    if (params.kinds) host_drag_render( info, params.kinds );
+}
+
+/* The pointer is over a host application, not over a Wine window. */
+static BOOL host_drag_external( const TrackerWindowInfo *info )
+{
+    return info->hostDrag && info->hostState >= HOST_STATE_FOREIGN;
+}
+
+/* The effect of the host target's action: what it accepts while hovering, what it did when finished. */
+static DWORD host_drag_effect( const TrackerWindowInfo *info )
+{
+    DWORD effect = DROPEFFECT_NONE;
+
+    if (info->hostState == HOST_STATE_CANCELLED) return DROPEFFECT_NONE;
+    if (info->hostAction & HOST_ACTION_MOVE) effect = DROPEFFECT_MOVE;
+    else if (info->hostAction & HOST_ACTION_COPY)
+        effect = (info->dwOKEffect & DROPEFFECT_COPY) ? DROPEFFECT_COPY : DROPEFFECT_LINK;
+    return effect & info->dwOKEffect;
+}
+
+static void host_drag_start( TrackerWindowInfo *info )
+{
+    struct host_drag_params params = { sizeof(params) };
+
+    if (!(info->hostKinds = host_drag_kinds( info->dataObject ))) return;
+    params.effects = info->dwOKEffect;
+    params.kinds = info->hostKinds;
+    info->hostDrag = host_drag_call( info, HOST_DRAG_START, &params ) == 1;
+    info->hostState = info->hostDrag ? HOST_STATE_STARTED : HOST_STATE_NONE;
+    TRACE( "kinds %#lx, effects %#lx: host drag %d\n", info->hostKinds, info->dwOKEffect, info->hostDrag );
+    /* Hand over now what is already in the data object (paths, text, a link): Linux clients ask for it while the
+     * pointer hovers them and give up after about a second, and this thread is the application's UI thread, which
+     * may be busy in its own drop target or feedback right then. Virtual files are only written when asked for. */
+    if (info->hostDrag)
+        host_drag_render( info, (info->hostKinds & ~HOST_KIND_FILES) |
+                                (host_drag_has( info->dataObject, CF_HDROP ) ? HOST_KIND_FILES : 0) );
+}
+
+/* Dropped on a host application: it asks for the data and then finishes with an action, or the drag is cancelled.
+ * DoDragDrop on Windows also returns only after the target's Drop. Bounded, so a target that never finishes cannot
+ * hang the application. Messages are dispatched meanwhile, keyboard input stays queued. */
+static DWORD host_drag_wait( TrackerWindowInfo *info )
+{
+    DWORD start = GetTickCount();
+    MSG msg;
+
+    while (info->hostState == HOST_STATE_DROPPED && GetTickCount() - start < 15000)
+    {
+        MsgWaitForMultipleObjects( 0, NULL, FALSE, 50, QS_ALLINPUT );
+        while (PeekMessageW( &msg, 0, 0, WM_KEYFIRST - 1, PM_REMOVE ) ||
+               PeekMessageW( &msg, 0, WM_KEYLAST + 1, ~0u, PM_REMOVE ))
+        {
+            if (msg.message == WM_QUIT)
+            {
+                PostQuitMessage( msg.wParam );
+                return host_drag_effect( info );
+            }
+            DispatchMessageW( &msg );
+        }
+        host_drag_poll( info );
+    }
+    TRACE( "state %lu action %#lx\n", info->hostState, info->hostAction );
+    return info->hostState == HOST_STATE_FINISHED ? host_drag_effect( info ) : DROPEFFECT_NONE;
+}
+
+static void host_drag_end( TrackerWindowInfo *info )
+{
+    if (!info->hostDrag) return;
+    host_drag_poll( info );
+    /* the host still takes the drop: render what it may ask for before the data object goes away */
+    if (info->hostState == HOST_STATE_DROPPED) host_drag_render( info, info->hostKinds );
+    host_drag_call( info, HOST_DRAG_END, NULL );
+}
+
 /***********************************************************************
  * DoDragDrop [OLE32.@]
  */
@@ -749,6 +1150,8 @@
