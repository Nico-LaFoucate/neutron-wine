+/* NEUTRON drag-out: where a drag the application starts now comes from: the window whose surface holds the
+ * pointer's implicit grab and the serial of the press, which wl_data_device.start_drag needs. FALSE when no button
+ * is held on one of our surfaces (the compositor would refuse the drag). */
+BOOL wayland_pointer_drag_origin(HWND *hwnd, uint32_t *serial)
+{
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+    BOOL ret;
+
+    pthread_mutex_lock(&pointer->mutex);
+    *hwnd = pointer->focused_hwnd;
+    *serial = pointer->button_serial;
+    ret = *hwnd && *serial && pointer->buttons_down;
+    pthread_mutex_unlock(&pointer->mutex);
+    return ret;
+}
+
+/* NEUTRON drag-out: the end of a drag the compositor ran. The compositor consumes the button release that ends
+ * it (it becomes the drop), so no wl_pointer.button reaches us and wineserver would keep the button down. On
+ * Windows the release is a hardware event that goes to the capture window: the drag source's OLE loop, which reads
+ * it as the drop. Send it for every button wineserver still has down (the async state is shared, so a drop
+ * on another Wine process's window is ended once, by whichever process saw it), and drop a late real release
+ * of a button released here (released_early, see pointer_release_pending). */
+void wayland_pointer_release_drag_buttons(HWND hwnd, const char *where)
+{
+    static const struct { INT vk; DWORD flags; DWORD data; uint32_t button; } buttons[] =
+    {
+        { VK_LBUTTON, MOUSEEVENTF_LEFTUP, 0, BTN_LEFT },
+        { VK_RBUTTON, MOUSEEVENTF_RIGHTUP, 0, BTN_RIGHT },
+        { VK_MBUTTON, MOUSEEVENTF_MIDDLEUP, 0, BTN_MIDDLE },
+        { VK_XBUTTON1, MOUSEEVENTF_XUP, XBUTTON1, BTN_SIDE },
+        { VK_XBUTTON2, MOUSEEVENTF_XUP, XBUTTON2, BTN_EXTRA },
+    };
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+    INPUT input = {0};
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(buttons); i++)
+    {
+        uint32_t bit = pointer_button_bit(buttons[i].button);
+
+        pthread_mutex_lock(&pointer->mutex);
+        if (pointer->buttons_down & bit)
+        {
+            pointer->buttons_down &= ~bit;
+            pointer->released_early |= bit;
+        }
+        pthread_mutex_unlock(&pointer->mutex);
+        if (!(NtUserGetAsyncKeyState(buttons[i].vk) & 0x8000)) continue;
+
+        ERR("neutron-dragout: %s: sending the release of vk %#x\n", where, buttons[i].vk);
+        input.type = INPUT_MOUSE;
+        input.mi.dwFlags = buttons[i].flags;
+        input.mi.mouseData = buttons[i].data;
+        NtUserSendHardwareInput(hwnd, 0, &input, 0);
+    }
+}
 
