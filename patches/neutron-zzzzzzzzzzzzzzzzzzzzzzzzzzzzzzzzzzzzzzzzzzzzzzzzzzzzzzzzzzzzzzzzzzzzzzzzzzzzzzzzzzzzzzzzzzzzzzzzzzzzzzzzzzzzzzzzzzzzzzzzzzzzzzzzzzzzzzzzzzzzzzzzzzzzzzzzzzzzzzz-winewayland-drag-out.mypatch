+/* NEUTRON drag-out: a drag the compositor runs (wl_data_device.start_drag) moves over one of our surfaces. The
+ * compositor reports the position as data_device motion instead of wl_pointer motion; turn it into the same
+ * hardware mouse move, so wineserver's cursor follows and the move reaches the drag source's OLE loop through its
+ * capture window, as the mouse does on Windows. Called on the wayland event thread. */
+void wayland_pointer_dnd_motion(HWND hwnd, wl_fixed_t sx, wl_fixed_t sy)
+{
+    pointer_motion_to_hwnd(hwnd, sx, sy, FALSE);
+}
