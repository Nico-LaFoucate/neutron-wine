--- a/dlls/winewayland.drv/wayland_data_device.c
+++ b/dlls/winewayland.drv/wayland_data_device.c
@@ -1148,6 +1148,597 @@
 };
 
 /**********************************************************************
+ *          NEUTRON drag-out: OLE DoDragDrop as a wl_data_device drag source
+ *
+ * Dragging a file, text or a link OUT of a Windows application onto a Linux application (file manager, editor,
+ * browser) did nothing: this driver received drops (data_device_* below) but never started a drag. Windows
+ * applications drag with OLE DoDragDrop(IDataObject, IDropSource, effects); ole32's loop finds the target with
+ * WindowFromPoint, which knows only Wine's windows, and nothing told the compositor a drag was running.
+ * (winex11 has no drag source either: its XDND code is the receiving side only.)
+ *
+ * Now ole32 asks the driver at the start of every DoDragDrop (WM_WINE_DRAG_SOURCE, sent to its tracker window),
+ * and the drag runs on the compositor, as a Wayland toolkit's does, from the press that holds the pointer's
+ * implicit grab:
+ *  - a wl_data_source offers what the IDataObject has: files (CF_HDROP, or FileGroupDescriptorW + FileContents,
+ *    which ole32 writes to a temporary folder) as text/uri-list; text as text/plain;charset=utf-8 and text/plain;
+ *    a link (UniformResourceLocatorW) as text/uri-list and text. The allowed DROPEFFECTs become copy/move actions.
+ *    ole32 renders data on the DoDragDrop thread only when a target asks for it (wl_data_source.send), as a
+ *    Windows target calls GetData when it needs it.
+ *  - one more, private type (offered last: toolkits that accept "the first type" must pick a real one) names the
+ *    tracker window and a cookie (a window property). A Wine window of the same wineserver under the pointer (this
+ *    process or another) recognizes it, marks itself on the tracker (window property WineDragTarget, read by the
+ *    source synchronously, also at the drop), accepts only that type and turns the drag's motion and drop into the
+ *    hardware mouse move and button release they are on Windows. They reach the source's OLE loop through its
+ *    capture window, which does what it always did: WindowFromPoint, then the target's IDropTarget with the
+ *    application's own IDataObject, across processes too. Drags inside and between Wine windows keep every private
+ *    format.
+ *  - no Wine window under the pointer: ole32 has no Wine target, the host target's action is the effect.
+ *    dnd_drop_performed / dnd_finished(action) / cancelled end the drag: the button release the compositor consumed
+ *    is sent, and DoDragDrop returns DRAGDROP_S_DROP with the effect of the action the target finished with, or no
+ *    effect when the compositor cancelled.
+ * Kill switch NEUTRON_DRAG_OUT=0: ole32 then runs every drag on Wine's windows only, as before.
+ */
+
+#define WINE_DRAG_TAG_PREFIX "application/x-wine-ole-drag;"
+
+static const WCHAR drag_cookie_propW[] =
+    {'W','i','n','e','D','r','a','g','S','o','u','r','c','e','C','o','o','k','i','e',0};
+static const WCHAR drag_target_propW[] =
+    {'W','i','n','e','D','r','a','g','T','a','r','g','e','t',0};
+
+/* Keep in sync with dlls/ole32/ole2.c. */
+enum { DRAG_SOURCE_START = 1, DRAG_SOURCE_POLL, DRAG_SOURCE_DATA, DRAG_SOURCE_END };
+enum { DRAG_STATE_NONE, DRAG_STATE_STARTED, DRAG_STATE_WINE, DRAG_STATE_FOREIGN, DRAG_STATE_DROPPED,
+       DRAG_STATE_FINISHED, DRAG_STATE_CANCELLED };
+#define DRAG_KIND_FILES 1
+#define DRAG_KIND_TEXT  2
+#define DRAG_KIND_URL   4
+#define DRAG_KIND_ALL   7
+
+struct wine_drag_source_params
+{
+    UINT32 size;      /* sizeof(struct wine_drag_source_params) */
+    UINT32 effects;   /* START: the DROPEFFECT_* the source allows */
+    UINT32 kinds;     /* START: DRAG_KIND_* offered; POLL: kinds a target asked for, not rendered yet; DATA: the kind */
+    UINT32 state;     /* POLL: DRAG_STATE_* */
+    UINT32 action;    /* POLL: the compositor's dnd action (WL_DATA_DEVICE_MANAGER_DND_ACTION_*) */
+    UINT32 bytes;     /* DATA: size of data */
+    UINT64 data;      /* DATA: files: double-null-terminated DOS paths; text, url: UTF-16 */
+};
+
+static const struct { const char *mime; UINT32 kind; } drag_mimes[] =
+{
+    { "text/uri-list", DRAG_KIND_FILES },
+    { "text/uri-list", DRAG_KIND_URL },
+    { "text/plain;charset=utf-8", DRAG_KIND_TEXT },
+    { "text/plain", DRAG_KIND_TEXT },
+    { "text/plain;charset=utf-8", DRAG_KIND_URL },
+    { "text/plain", DRAG_KIND_URL },
+};
+
+#define DRAG_MAX_PENDING 16
+
+static struct
+{
+    struct wl_data_source *source;   /* NULL when there is no drag */
+    HWND tracker;                    /* ole32's tracker window; 0 once DoDragDrop is done */
+    HWND origin;                     /* the window the drag started on */
+    UINT32 kinds, state, action, requested;
+    BOOL confirmed;                  /* the compositor runs the drag (it sent a source event) */
+    char tag[96];
+    char *data[3];                   /* rendered, UTF-8 (files: a text/uri-list), by drag_kind_index */
+    size_t size[3];
+    BOOL rendered[3];
+    struct { int fd; UINT32 kind; BOOL uri_list; } pending[DRAG_MAX_PENDING];
+    int npending;
+} drag_src;
+static pthread_mutex_t drag_src_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static BOOL neutron_drag_out_on(void)
+{
+    static int on = -1;
+    if (on < 0) on = neutron_gate("NEUTRON_DRAG_OUT", TRUE);
+    return on;
+}
+
+BOOL wayland_drag_out_enabled(void)
+{
+    return neutron_drag_out_on();
+}
+
+static int drag_kind_index(UINT32 kind)
+{
+    return kind == DRAG_KIND_FILES ? 0 : kind == DRAG_KIND_TEXT ? 1 : 2;
+}
+
+/* The kind a requested mime type is served from: the first entry of drag_mimes the drag offers. */
+static UINT32 drag_kind_for_mime(const char *mime, UINT32 kinds)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(drag_mimes); i++)
+        if ((kinds & drag_mimes[i].kind) && !strcmp(mime, drag_mimes[i].mime)) return drag_mimes[i].kind;
+    return 0;
+}
+
+/* Write one transfer and close it, bounded like read_all: a reader that stalls must not hang this thread. */
+static void drag_write(int fd, UINT32 kind, BOOL uri_list, const char *buf, size_t size)
+{
+    char *copy = NULL;
+    size_t done = 0;
+    int waited = 0;
+
+    /* a link as text/uri-list is one line */
+    if (kind == DRAG_KIND_URL && uri_list && size && (copy = malloc(size + 2)))
+    {
+        memcpy(copy, buf, size);
+        copy[size++] = '\r';
+        copy[size++] = '\n';
+        buf = copy;
+    }
+    while (done < size && waited < NEUTRON_DND_READ_TIMEOUT_MS)
+    {
+        struct pollfd pfd = { .fd = fd, .events = POLLOUT };
+        ssize_t ret;
+        int pr = poll(&pfd, 1, 50);
+
+        if (pr == 0) { waited += 50; continue; }
+        if (pr < 0) { if (errno == EINTR) continue; break; }
+        ret = write(fd, buf + done, size - done);
+        if (ret > 0) done += ret;
+        else if (ret < 0 && errno != EINTR && errno != EAGAIN) break;
+    }
+    if (done < size) ERR("neutron-dragout: wrote %zu of %zu bytes\n", done, size);
+    free(copy);
+    close(fd);
+}
+
+/* With drag_src_mutex held. */
+static void drag_source_free_locked(void)
+{
+    int i;
+
+    if (drag_src.source) wl_data_source_destroy(drag_src.source);
+    for (i = 0; i < drag_src.npending; i++) close(drag_src.pending[i].fd);
+    for (i = 0; i < 3; i++) free(drag_src.data[i]);
+    memset(&drag_src, 0, sizeof(drag_src));
+    wl_display_flush(process_wayland.wl_display);
+}
+
+/* With drag_src_mutex held: have the OLE loop look at the drag now rather than at its next 50 ms tick. */
+static void drag_source_wake_locked(void)
+{
+    if (drag_src.tracker) NtUserPostMessage(drag_src.tracker, WM_TIMER, 1, 0);
+}
+
+/* A Wine window of this wineserver is under the pointer (dnd_wine_drag_enter marked it on the tracker). */
+static BOOL drag_source_over_wine(HWND tracker)
+{
+    return tracker && NtUserGetProp(tracker, drag_target_propW);
+}
+
+/* With drag_src_mutex held: where the pointer is, while the drag is still running. */
+static void drag_source_update_locked(void)
+{
+    if (drag_src.state != DRAG_STATE_STARTED && drag_src.state != DRAG_STATE_WINE &&
+        drag_src.state != DRAG_STATE_FOREIGN)
+        return;
+    if (drag_source_over_wine(drag_src.tracker)) drag_src.state = DRAG_STATE_WINE;
+    else if (drag_src.confirmed) drag_src.state = DRAG_STATE_FOREIGN;
+}
+
+static void drag_source_target(void *data, struct wl_data_source *source, const char *mime_type)
+{
+    pthread_mutex_lock(&drag_src_mutex);
+    if (source == drag_src.source)
+    {
+        drag_src.confirmed = TRUE;
+        drag_source_update_locked();
+        TRACE("target %s -> state %u\n", debugstr_a(mime_type), drag_src.state);
+        drag_source_wake_locked();
+    }
+    pthread_mutex_unlock(&drag_src_mutex);
+}
+
+static void drag_source_send(void *data, struct wl_data_source *source, const char *mime_type, int32_t fd)
+{
+    const char *what = "not offered";
+    char *copy = NULL;
+    size_t size = 0;
+    BOOL uri_list = FALSE, now = FALSE;
+    UINT32 kind = 0;
+    int idx;
+
+    pthread_mutex_lock(&drag_src_mutex);
+    if (source == drag_src.source && mime_type && (kind = drag_kind_for_mime(mime_type, drag_src.kinds)))
+    {
+        idx = drag_kind_index(kind);
+        uri_list = !strcmp(mime_type, "text/uri-list");
+        if (drag_src.rendered[idx])
+        {
+            if ((size = drag_src.size[idx]) && (copy = malloc(size))) memcpy(copy, drag_src.data[idx], size);
+            else size = 0;
+            now = TRUE;
+            what = "rendered";
+        }
+        else if (drag_src.tracker && drag_src.npending < DRAG_MAX_PENDING)
+        {
+            drag_src.pending[drag_src.npending].fd = fd;
+            drag_src.pending[drag_src.npending].kind = kind;
+            drag_src.pending[drag_src.npending].uri_list = uri_list;
+            drag_src.npending++;
+            drag_src.requested |= kind;
+            drag_source_wake_locked();
+            fd = -1;
+            what = "asking the application";
+        }
+    }
+    pthread_mutex_unlock(&drag_src_mutex);
+
+    ERR("neutron-dragout: a target asked for %s: %s\n", debugstr_a(mime_type), what);
+    if (now) drag_write(fd, kind, uri_list, copy, size);
+    else if (fd != -1) close(fd);
+    free(copy);
+}
+
+static void drag_source_cancelled(void *data, struct wl_data_source *source)
+{
+    HWND origin = 0;
+
+    pthread_mutex_lock(&drag_src_mutex);
+    if (source == drag_src.source)
+    {
+        ERR("neutron-dragout: the compositor cancelled the drag (state %u)\n", drag_src.state);
+        drag_src.state = DRAG_STATE_CANCELLED;
+        origin = drag_src.origin;
+        if (!drag_src.tracker) drag_source_free_locked();
+        else drag_source_wake_locked();
+    }
+    pthread_mutex_unlock(&drag_src_mutex);
+    if (origin) wayland_pointer_release_drag_buttons(origin, "drag cancelled");
+}
+
+static void drag_source_dnd_drop_performed(void *data, struct wl_data_source *source)
+{
+    HWND origin = 0;
+
+    pthread_mutex_lock(&drag_src_mutex);
+    /* A drop on a Wine window is ended by that window's process (data_device_drop). */
+    if (source == drag_src.source && !drag_source_over_wine(drag_src.tracker))
+    {
+        ERR("neutron-dragout: dropped on a Linux client (action %#x)\n", drag_src.action);
+        drag_src.state = DRAG_STATE_DROPPED;
+        origin = drag_src.origin;
+        drag_source_wake_locked();
+    }
+    pthread_mutex_unlock(&drag_src_mutex);
+    if (origin) wayland_pointer_release_drag_buttons(origin, "drop on a Linux client");
+}
+
+static void drag_source_dnd_finished(void *data, struct wl_data_source *source)
+{
+    pthread_mutex_lock(&drag_src_mutex);
+    if (source == drag_src.source)
+    {
+        ERR("neutron-dragout: the target finished (state %u, action %#x)\n", drag_src.state, drag_src.action);
+        if (drag_src.state == DRAG_STATE_DROPPED) drag_src.state = DRAG_STATE_FINISHED;
+        if (!drag_src.tracker) drag_source_free_locked();
+        else drag_source_wake_locked();
+    }
+    pthread_mutex_unlock(&drag_src_mutex);
+}
+
+static void drag_source_action(void *data, struct wl_data_source *source, uint32_t dnd_action)
+{
+    pthread_mutex_lock(&drag_src_mutex);
+    if (source == drag_src.source)
+    {
+        drag_src.action = dnd_action;
+        drag_src.confirmed = TRUE;
+        drag_source_wake_locked();
+    }
+    pthread_mutex_unlock(&drag_src_mutex);
+}
+
+static const struct wl_data_source_listener drag_source_listener =
+{
+    drag_source_target,
+    drag_source_send,
+    drag_source_cancelled,
+    drag_source_dnd_drop_performed,
+    drag_source_dnd_finished,
+    drag_source_action,
+};
+
+/* DOS paths -> text/uri-list (as winex11's export_hdrop does for the clipboard, escaping only what RFC 3986 needs). */
+static char *drag_uri_list(const WCHAR *paths, size_t count, size_t *ret_size)
+{
+    static const char hex[] = "0123456789ABCDEF";
+    size_t pos = 0, cap = 256, i = 0;
+    char *out = malloc(cap), *bigger;
+
+    while (out && i < count && paths[i])
+    {
+        const WCHAR *path = paths + i;
+        char *unix_name = NULL, *real;
+        const unsigned char *c;
+        size_t need;
+
+        while (i < count && paths[i]) i++;
+        i++;
+        if (ntdll_get_unix_file_name(path, &unix_name, FILE_OPEN))
+        {
+            ERR("neutron-dragout: no unix path for %s\n", debugstr_w(path));
+            continue;
+        }
+        /* C: is the prefix's dosdevices/c: link; hand over the real path, as a Linux application would */
+        if ((real = realpath(unix_name, NULL)))
+        {
+            free(unix_name);
+            unix_name = real;
+        }
+        need = pos + 7 + 3 * strlen(unix_name) + 3;
+        if (need > cap)
+        {
+            cap = max(cap * 2, need);
+            if (!(bigger = realloc(out, cap))) { free(out); out = NULL; free(unix_name); break; }
+            out = bigger;
+        }
+        memcpy(out + pos, "file://", 7);
+        pos += 7;
+        for (c = (const unsigned char *)unix_name; *c; c++)
+        {
+            if ((*c >= 'a' && *c <= 'z') || (*c >= 'A' && *c <= 'Z') || (*c >= '0' && *c <= '9') ||
+                *c == '/' || *c == '-' || *c == '.' || *c == '_' || *c == '~')
+                out[pos++] = *c;
+            else
+            {
+                out[pos++] = '%';
+                out[pos++] = hex[*c >> 4];
+                out[pos++] = hex[*c & 15];
+            }
+        }
+        out[pos++] = '\r';
+        out[pos++] = '\n';
+        free(unix_name);
+    }
+    *ret_size = out ? pos : 0;
+    return out;
+}
+
+static char *drag_utf8(const WCHAR *text, size_t count, size_t *ret_size)
+{
+    DWORD size = 0;
+    size_t len = 0;
+    char *out;
+
+    while (len < count && text[len]) len++;
+    RtlUnicodeToUTF8N(NULL, 0, &size, text, len * sizeof(WCHAR));
+    if (!(out = malloc(size + 1))) return NULL;
+    RtlUnicodeToUTF8N(out, size, &size, text, len * sizeof(WCHAR));
+    *ret_size = size;
+    return out;
+}
+
+static UINT32 drag_actions_from_effects(UINT32 effects)
+{
+    UINT32 actions = 0;
+
+    if (effects & (DROPEFFECT_COPY | DROPEFFECT_LINK)) actions |= WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY;
+    if (effects & DROPEFFECT_MOVE) actions |= WL_DATA_DEVICE_MANAGER_DND_ACTION_MOVE;
+    return actions;
+}
+
+static LRESULT drag_source_start(HWND tracker, struct wine_drag_source_params *params)
+{
+    struct wayland_data_device *data_device = &process_wayland.data_device;
+    struct wayland_win_data *win_data;
+    struct wl_data_source *source;
+    uint32_t serial, actions;
+    unsigned int i, j, cookie;
+    LARGE_INTEGER now;
+    BOOL started = FALSE;
+    HWND origin;
+
+    if (!neutron_drag_out_on()) return 0;
+    if (!(actions = drag_actions_from_effects(params->effects)) || !(params->kinds & DRAG_KIND_ALL)) return 0;
+    if (!process_wayland.wl_data_device_manager ||
+        wl_data_device_manager_get_version(process_wayland.wl_data_device_manager) <
+            WL_DATA_SOURCE_SET_ACTIONS_SINCE_VERSION)
+        return 0;
+    if (!wayland_pointer_drag_origin(&origin, &serial))
+    {
+        ERR("neutron-dragout: no button held on one of our surfaces; the drag stays on Wine's windows\n");
+        return 0;
+    }
+    if (!(source = wl_data_device_manager_create_data_source(process_wayland.wl_data_device_manager)))
+        return 0;
+
+    pthread_mutex_lock(&drag_src_mutex);
+    /* an earlier drop still delivering to a Linux client: the new drag wins */
+    if (drag_src.source) drag_source_free_locked();
+    NtQuerySystemTime(&now);
+    cookie = ((unsigned int)now.QuadPart ^ (unsigned int)(now.QuadPart >> 32) ^ (GetCurrentProcessId() << 16)) | 1;
+    snprintf(drag_src.tag, sizeof(drag_src.tag), WINE_DRAG_TAG_PREFIX "hwnd=%lx;cookie=%x",
+             (unsigned long)HandleToUlong(tracker), cookie);
+    NtUserSetProp(tracker, drag_cookie_propW, UlongToHandle(cookie));
+    NtUserRemoveProp(tracker, drag_target_propW);
+    for (i = 0; i < ARRAY_SIZE(drag_mimes); i++)
+    {
+        if (!(params->kinds & drag_mimes[i].kind)) continue;
+        for (j = 0; j < i; j++)
+            if ((params->kinds & drag_mimes[j].kind) && !strcmp(drag_mimes[j].mime, drag_mimes[i].mime)) break;
+        if (j == i) wl_data_source_offer(source, drag_mimes[i].mime);
+    }
+    wl_data_source_offer(source, drag_src.tag);
+    wl_data_source_set_actions(source, actions);
+    wl_data_source_add_listener(source, &drag_source_listener, NULL);
+    drag_src.source = source;
+    drag_src.tracker = tracker;
+    drag_src.origin = origin;
+    drag_src.kinds = params->kinds & DRAG_KIND_ALL;
+    drag_src.state = DRAG_STATE_STARTED;
+
+    pthread_mutex_lock(&data_device->mutex);
+    if (data_device->wl_data_device && (win_data = wayland_win_data_get(origin)))
+    {
+        if (win_data->wayland_surface && win_data->wayland_surface->wl_surface)
+        {
+            wl_data_device_start_drag(data_device->wl_data_device, source,
+                                      win_data->wayland_surface->wl_surface, NULL, serial);
+            started = TRUE;
+        }
+        wayland_win_data_release(win_data);
+    }
+    pthread_mutex_unlock(&data_device->mutex);
+    if (!started) drag_source_free_locked();
+    pthread_mutex_unlock(&drag_src_mutex);
+    wl_display_flush(process_wayland.wl_display);
+
+    if (!started)
+    {
+        NtUserRemoveProp(tracker, drag_cookie_propW);
+        return 0;
+    }
+    ERR("neutron-dragout: drag started from hwnd %p (serial %u, effects %#x -> actions %#x, kinds %#x)\n",
+        origin, serial, params->effects, actions, params->kinds);
+    return 1;
+}
+
+static LRESULT drag_source_data(HWND tracker, struct wine_drag_source_params *params)
+{
+    const WCHAR *src = (const WCHAR *)(ULONG_PTR)params->data;
+    struct { int fd; UINT32 kind; BOOL uri_list; } out[DRAG_MAX_PENDING];
+    UINT32 kind = params->kinds;
+    size_t size = 0;
+    char *bytes = NULL;
+    int i, n = 0, idx;
+
+    if (kind != DRAG_KIND_FILES && kind != DRAG_KIND_TEXT && kind != DRAG_KIND_URL) return 0;
+    idx = drag_kind_index(kind);
+    if (src && params->bytes >= sizeof(WCHAR))
+    {
+        if (kind == DRAG_KIND_FILES) bytes = drag_uri_list(src, params->bytes / sizeof(WCHAR), &size);
+        else bytes = drag_utf8(src, params->bytes / sizeof(WCHAR), &size);
+    }
+
+    pthread_mutex_lock(&drag_src_mutex);
+    if (drag_src.tracker != tracker || drag_src.rendered[idx])
+    {
+        pthread_mutex_unlock(&drag_src_mutex);
+        free(bytes);
+        return 0;
+    }
+    drag_src.data[idx] = bytes;
+    drag_src.size[idx] = size;
+    drag_src.rendered[idx] = TRUE;
+    drag_src.requested &= ~kind;
+    for (i = 0; i < drag_src.npending; i++)
+    {
+        if (drag_src.pending[i].kind == kind)
+        {
+            out[n].fd = drag_src.pending[i].fd;
+            out[n].kind = kind;
+            out[n++].uri_list = drag_src.pending[i].uri_list;
+            drag_src.pending[i--] = drag_src.pending[--drag_src.npending];
+        }
+    }
+    /* drag_write runs unlocked; a new drag would free these bytes, so write from a copy */
+    bytes = NULL;
+    if (n && size && (bytes = malloc(size))) memcpy(bytes, drag_src.data[idx], size);
+    pthread_mutex_unlock(&drag_src_mutex);
+
+    ERR("neutron-dragout: rendered kind %#x, %zu bytes, for %d waiting transfer(s)\n", kind, size, n);
+    for (i = 0; i < n; i++) drag_write(out[i].fd, out[i].kind, out[i].uri_list, bytes, bytes ? size : 0);
+    free(bytes);
+    return 1;
+}
+
+static LRESULT drag_source_end(HWND tracker)
+{
+    HWND origin = 0;
+    int i;
+
+    pthread_mutex_lock(&drag_src_mutex);
+    if (drag_src.tracker == tracker)
+    {
+        if (drag_src.state != DRAG_STATE_STARTED) origin = drag_src.origin;
+        ERR("neutron-dragout: DoDragDrop is done (state %u)\n", drag_src.state);
+        drag_src.tracker = 0;
+        /* A Linux client still taking the drop keeps the source until it finishes; what it has not asked for
+         * yet was rendered by ole32 before this. */
+        if (drag_src.state != DRAG_STATE_DROPPED) drag_source_free_locked();
+        else
+        {
+            for (i = 0; i < drag_src.npending; i++) close(drag_src.pending[i].fd);
+            drag_src.npending = 0;
+        }
+    }
+    pthread_mutex_unlock(&drag_src_mutex);
+    NtUserRemoveProp(tracker, drag_cookie_propW);
+    NtUserRemoveProp(tracker, drag_target_propW);
+    if (origin) wayland_pointer_release_drag_buttons(origin, "drag ended");
+    return 1;
+}
+
+/**********************************************************************
+ *          wayland_drag_source_message
+ *
+ * WM_WINE_DRAG_SOURCE from ole32's DoDragDrop, on its tracker window's thread.
+ */
+LRESULT wayland_drag_source_message(HWND hwnd, WPARAM op, LPARAM lparam)
+{
+    struct wine_drag_source_params *params = (struct wine_drag_source_params *)lparam;
+
+    if (op == DRAG_SOURCE_END) return drag_source_end(hwnd);
+    if (!params || params->size != sizeof(*params)) return 0;
+    switch (op)
+    {
+    case DRAG_SOURCE_START:
+        return drag_source_start(hwnd, params);
+    case DRAG_SOURCE_POLL:
+        pthread_mutex_lock(&drag_src_mutex);
+        if (drag_src.tracker == hwnd) drag_source_update_locked();
+        params->state = drag_src.tracker == hwnd ? drag_src.state : DRAG_STATE_NONE;
+        params->action = drag_src.action;
+        params->kinds = drag_src.tracker == hwnd ? drag_src.requested : 0;
+        pthread_mutex_unlock(&drag_src_mutex);
+        return 1;
+    case DRAG_SOURCE_DATA:
+        return drag_source_data(hwnd, params);
+    }
+    return 0;
+}
+
+/* The tag of a drag a Wine process of this wineserver runs (see above), or NULL; *tracker is its tracker window. */
+static const char *dnd_wine_drag_tag(struct wayland_data_offer *offer, HWND *tracker)
+{
+    const size_t len = sizeof(WINE_DRAG_TAG_PREFIX) - 1;
+    unsigned long hwnd;
+    unsigned int cookie;
+    char **p;
+
+    wl_array_for_each(p, &offer->types)
+    {
+        if (strncmp(*p, WINE_DRAG_TAG_PREFIX, len)) continue;
+        if (sscanf(*p + len, "hwnd=%lx;cookie=%x", &hwnd, &cookie) != 2 || !cookie) continue;
+        if (HandleToUlong(NtUserGetProp(UlongToHandle(hwnd), drag_cookie_propW)) != cookie) continue;
+        *tracker = UlongToHandle(hwnd);
+        return *p;
+    }
+    return NULL;
+}
+
+/* Mark (hwnd) or unmark (0) the Wine window under a Wine drag on its tracker, and have its OLE loop look now. */
+static void dnd_wine_drag_mark(HWND tracker, HWND hwnd)
+{
+    if (!tracker) return;
+    if (hwnd) NtUserSetProp(tracker, drag_target_propW, hwnd);
+    else NtUserRemoveProp(tracker, drag_target_propW);
+    NtUserPostMessage(tracker, WM_TIMER, 1, 0);
+}
+
