 }
 
+/* NEUTRON window-info-shm (2026-10-15): publish what GetWindowLong, GetParent and IsWindowVisible read.
+ *
+ * On Windows, user32 reads a window's styles, id, instance, user data and extra bytes from the desktop heap mapped
+ * into every process: no kernel call. Here each of those was a system call into win32u. Lightroom Classic makes
+ * ~150,000 of them a second while its Masking panel changes size, so a panel that grows stays unpainted for
+ * ~200 ms. The server refreshes the copies below whenever it changes a window, so they always match what
+ * get_window_info would reply (the extra bytes are written in set_window_info); user32 reads them. */
+C_ASSERT( sizeof(window_shm_t) == offsetof(window_shm_t, extra[0]) );
+
+static mem_size_t window_shm_size( int extra_bytes )
+{
+    return (offsetof(window_shm_t, extra[extra_bytes]) + 7) & ~(mem_size_t)7;
+}
+
+static void update_window_info( struct window *win )
+{
+    const window_shm_t *shm = win->shared;
+
+    if (!shm) return;
+    if (shm->style == win->style && shm->ex_style == win->ex_style && shm->id == win->id &&
+        shm->instance == win->instance && shm->user_data == win->user_data)
+        return;
+
+    SHARED_WRITE_BEGIN( win->shared, window_shm_t )
+    {
+        shared->style     = win->style;
+        shared->ex_style  = win->ex_style;
+        shared->id        = win->id;
+        shared->instance  = win->instance;
+        shared->user_data = win->user_data;
+    }
+    SHARED_WRITE_END;
+}
+
 /* set the PAINT_PIXEL_FORMAT_CHILD flag on all the parents */
 /* note: we never reset the flag, it's just a heuristic */
 static void update_window_links( struct window *win );
@@ -462,6 +496,7 @@
 
     win->is_linked = 1;
     update_children_links( win->parent );  /* NEUTRON window-tree-shm */
+    update_window_info( win );  /* NEUTRON window-info-shm: WS_EX_TOPMOST */
     return old_prev != win->entry.prev;
 }
 
