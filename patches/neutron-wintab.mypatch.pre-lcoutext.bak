+    uint64_t serial;
+    uint32_t type;                /* ZWP_TABLET_TOOL_V2_TYPE_* (pen vs eraser) */
+    struct wl_surface *surface;   /* surface the tool is currently over (proximity) */
+    void *wintab_data;            /* struct wayland_wintab_tool_data * (private to wintab.c) */
+    /* NEUTRON: pending synthetic-mouse action, injected in wayland_wintab_frame AFTER the
+     * WinTab packet is published — so PS sees the pen-down packet before the mouse LEFTDOWN
+     * it arms the stroke on (Windows/winex11 ordering). down/up/motion only RECORD here. */
+    UINT  pending_buttons;        /* MOUSEEVENTF_LEFTDOWN / LEFTUP, 0 = none */
+    POINT pending_pos;            /* latest clamped absolute screen coords */
+    BOOL  pending_move;
+};
+
+struct wayland_tablet_pad
+{
+    struct list entry;
+    struct zwp_tablet_pad_v2 *zwp_tablet_pad_v2;
+};
+
+struct wayland_tablet
+{
+    struct zwp_tablet_manager_v2 *zwp_tablet_manager_v2;
+    struct zwp_tablet_seat_v2 *zwp_tablet_seat_v2;
+    struct list devices;
+    struct list tools;
+    struct list pads;
+    void *wintab_data;            /* struct wayland_wintab_data * (private to wintab.c) */
+    pthread_mutex_t mutex;
+};
+
 struct wayland_data_device
 {
     union
@@ -186,6 +236,7 @@ struct wayland
     struct wp_cursor_shape_manager_v1 *wp_cursor_shape_manager_v1;
     struct wp_pointer_warp_v1 *wp_pointer_warp_v1;
