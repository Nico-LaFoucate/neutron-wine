+void wayland_wintab_tilt(struct wayland_tablet_tool *tool, wl_fixed_t tilt_x, wl_fixed_t tilt_y);
+void wayland_wintab_rotation(struct wayland_tablet_tool *tool, wl_fixed_t degrees);
+void wayland_wintab_slider(struct wayland_tablet_tool *tool, int32_t position);
+void wayland_wintab_wheel(struct wayland_tablet_tool *tool, wl_fixed_t degrees, int32_t clicks);
