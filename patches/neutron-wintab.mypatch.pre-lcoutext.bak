 {
diff --git a/dlls/winewayland.drv/wayland_tablet.c b/dlls/winewayland.drv/wayland_tablet.c
new file mode 100755
index 00000000000..f2224e4c5cd
--- /dev/null
+++ b/dlls/winewayland.drv/wayland_tablet.c
@@ -0,0 +1,478 @@
+/*
+ * Wayland graphics tablets
+ *
+ * Copyright 2024 John Chadwick
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <assert.h>
+#include <stdlib.h>
+#include <unistd.h>
+
+#include "waylanddrv.h"
+#include "wine/debug.h"
+#include "wine/server.h"
+
+
+WINE_DEFAULT_DEBUG_CHANNEL(wintab32);
+
+/**********************************************************************
+ *          zwp_tablet_v2 handlers
+ */
+
+static void wayland_tablet_device_name(void *data, struct zwp_tablet_v2 *zwp_tablet_v2, const char *name)
+{
+    struct wayland_tablet_device *device = (struct wayland_tablet_device *)data;
+    device->name = strdup(name);
+}
+
+static void wayland_tablet_device_id(void *data, struct zwp_tablet_v2 *zwp_tablet_v2, uint32_t vid, uint32_t pid)
+{
+    struct wayland_tablet_device *device = (struct wayland_tablet_device *)data;
+    device->vid = vid;
+    device->pid = pid;
+}
+
+static void wayland_tablet_device_path(void *data, struct zwp_tablet_v2 *zwp_tablet_v2, const char *path)
+{
+    struct wayland_tablet_device *device = (struct wayland_tablet_device *)data;
+    device->path = strdup(path);
+}
+
+static void wayland_tablet_device_done(void *data, struct zwp_tablet_v2 *zwp_tablet_v2)
+{
+    struct wayland_tablet *tablet = &process_wayland.tablet;
+    struct wayland_tablet_device *device = (struct wayland_tablet_device *)data;
+
+    pthread_mutex_lock(&tablet->mutex);
+    list_add_tail(&tablet->devices, &device->entry);
+    pthread_mutex_unlock(&tablet->mutex);
+
+    TRACE("tablet device added: %s (vid=%d, pid=%d)\n",
+          device->name, device->vid, device->pid);
+}
+
+static void wayland_tablet_device_removed(void *data, struct zwp_tablet_v2 *zwp_tablet_v2)
+{
+    struct wayland_tablet *tablet = &process_wayland.tablet;
+    struct wayland_tablet_device *device = (struct wayland_tablet_device *)data;
+
+    if (device->entry.next) {
+        pthread_mutex_lock(&tablet->mutex);
+        list_remove(&device->entry);
+        pthread_mutex_unlock(&tablet->mutex);
+    }
+
+    TRACE("tablet device removed: %s (vid=%d, pid=%d)\n",
+          device->name, device->vid, device->pid);
+
+    zwp_tablet_v2_destroy(zwp_tablet_v2);
+    if (device->name)
+        free(device->name);
+    if (device->path)
+        free(device->path);
+    free(device);
+}
+
+static const struct zwp_tablet_v2_listener zwp_tablet_v2_listener =
+{
+    wayland_tablet_device_name,
+    wayland_tablet_device_id,
+    wayland_tablet_device_path,
+    wayland_tablet_device_done,
+    wayland_tablet_device_removed,
+};
+
+/**********************************************************************
+ *          zwp_tablet_tool_v2 handlers
+ */
+
+static void wayland_tablet_tool_type(void *data, struct zwp_tablet_tool_v2 *zwp_tablet_tool_v2,
+                                     uint32_t tool_type)
+{
+    struct wayland_tablet_tool *tool = (struct wayland_tablet_tool *)data;
+    tool->type = tool_type;   /* pen vs eraser — arrives before .done, so set before any packet */
+    TRACE("tablet tool %p type %#x\n", tool, tool_type);
+}
+
+static void wayland_tablet_tool_hardware_serial(void *data,
+                                                struct zwp_tablet_tool_v2 *zwp_tablet_tool_v2,
+                                                uint32_t hardware_serial_hi,
+                                                uint32_t hardware_serial_lo)
+{
+    struct wayland_tablet_tool *tool = (struct wayland_tablet_tool *)data;
+
+    tool->serial = ((uint64_t)hardware_serial_hi << 32) | (uint64_t) hardware_serial_lo;
+}
+
+static void wayland_tablet_tool_hardware_id_wacom(void *data,
+                                                  struct zwp_tablet_tool_v2 *zwp_tablet_tool_v2,
+                                                  uint32_t hardware_id_hi,
+                                                  uint32_t hardware_id_lo)
+{
+}
+
+static void wayland_tablet_tool_capability(void *data,
+                                           struct zwp_tablet_tool_v2 *zwp_tablet_tool_v2,
+                                           uint32_t capability)
+{
+}
+
+static void wayland_tablet_tool_done(void *data,
+                                     struct zwp_tablet_tool_v2 *zwp_tablet_tool_v2)
+{
+    struct wayland_tablet *tablet = &process_wayland.tablet;
+    struct wayland_tablet_tool *tool = (struct wayland_tablet_tool *)data;
+
+    pthread_mutex_lock(&tablet->mutex);
+    list_add_tail(&tablet->tools, &tool->entry);
+    pthread_mutex_unlock(&tablet->mutex);
+
+    TRACE("tablet tool added: serial=%llx\n", tool->serial);
+}
+
+static void wayland_tablet_tool_removed(void *data,
+                                        struct zwp_tablet_tool_v2 *zwp_tablet_tool_v2)
+{
+    struct wayland_tablet *tablet = &process_wayland.tablet;
+    struct wayland_tablet_tool *tool = (struct wayland_tablet_tool *)data;
+
+    if (tool->entry.next) {
+        pthread_mutex_lock(&tablet->mutex);
+        list_remove(&tool->entry);
+        pthread_mutex_unlock(&tablet->mutex);
+    }
+
+    TRACE("tablet tool removed: serial=%llx\n", tool->serial);
+
+    zwp_tablet_tool_v2_destroy(zwp_tablet_tool_v2);
+    free(tool);
+}
+
+static void wayland_tablet_tool_proximity_in(void *data,
+                                             struct zwp_tablet_tool_v2 *zwp_tablet_tool_v2,
+                                             uint32_t serial,
+                                             struct zwp_tablet_v2 *tablet,
+                                             struct wl_surface *surface)
+{
+    struct wayland_tablet_tool *tool = (struct wayland_tablet_tool *)data;
+    tool->surface = surface;
+    wayland_wintab_proximity_in(tool, serial, tablet, surface);
+}
+
+static void wayland_tablet_tool_proximity_out(void *data,
+                                              struct zwp_tablet_tool_v2 *zwp_tablet_tool_v2)
+{
+    struct wayland_tablet_tool *tool = (struct wayland_tablet_tool *)data;
+    wayland_wintab_proximity_out(tool);
+    tool->surface = NULL;
+}
+
+static void wayland_tablet_tool_down(void *data,
+                                     struct zwp_tablet_tool_v2 *zwp_tablet_tool_v2,
+                                     uint32_t serial)
+{
+    struct wayland_tablet_tool *tool = (struct wayland_tablet_tool *)data;
+    /* NEUTRON: record; the LEFTDOWN is injected in wayland_wintab_frame after the
+     * pen-down packet is published (see the pending_* fields). */
+    tool->pending_buttons = MOUSEEVENTF_LEFTDOWN;
+    wayland_wintab_down(tool, serial);
+}
+
+static void wayland_tablet_tool_up(void *data,
+                                   struct zwp_tablet_tool_v2 *zwp_tablet_tool_v2)
+{
+    struct wayland_tablet_tool *tool = (struct wayland_tablet_tool *)data;
+    /* NEUTRON: record; LEFTUP injected in wayland_wintab_frame after the packet. */
+    tool->pending_buttons = MOUSEEVENTF_LEFTUP;
+    wayland_wintab_up(tool);
+}
+
+static void wayland_tablet_tool_motion(void *data,
+                                       struct zwp_tablet_tool_v2 *zwp_tablet_tool_v2,
+                                       wl_fixed_t x,
+                                       wl_fixed_t y)
+{
+    struct wayland_tablet_tool *tool = (struct wayland_tablet_tool *)data;
+    if (tool->surface) {
+        // TODO: Copied directly from wayland_pointer.
+        RECT *window_rect;
+        HWND hwnd = wl_surface_get_user_data(tool->surface);
+        POINT screen;
+        struct wayland_surface *surface;
+        struct wayland_win_data *window_data;
+        if (!(window_data = wayland_win_data_get(hwnd))) return;
+        if (!(surface = window_data->wayland_surface))
+        {
+            wayland_win_data_release(window_data);
+            return;
+        }
+        window_rect = &surface->window.rect;
+        wayland_surface_coords_to_window(surface, wl_fixed_to_double(x), wl_fixed_to_double(y), (int *)&screen.x, (int *)&screen.y);
+        screen.x += window_rect->left;
+        screen.y += window_rect->top;
+        if (screen.x >= window_rect->right) screen.x = window_rect->right - 1;
+        else if (screen.x < window_rect->left) screen.x = window_rect->left;
+        if (screen.y >= window_rect->bottom) screen.y = window_rect->bottom - 1;
+        else if (screen.y < window_rect->top) screen.y = window_rect->top;
+        wayland_win_data_release(window_data);
+        /* NEUTRON: record; the mouse MOVE is injected in wayland_wintab_frame after
+         * the packet, so per-sample mouse+packet stay paired and ordered. */
+        tool->pending_pos = screen;
+        tool->pending_move = TRUE;
+    }
+    wayland_wintab_motion(tool, x, y);
+}
+
+static void wayland_tablet_tool_pressure(void *data,
+                                         struct zwp_tablet_tool_v2 *zwp_tablet_tool_v2,
+                                         uint32_t pressure)
+{
+    struct wayland_tablet_tool *tool = (struct wayland_tablet_tool *)data;
+    wayland_wintab_pressure(tool, pressure);
+}
+
+static void wayland_tablet_tool_distance(void *data,
+                                         struct zwp_tablet_tool_v2 *zwp_tablet_tool_v2,
+                                         uint32_t distance)
+{
+    struct wayland_tablet_tool *tool = (struct wayland_tablet_tool *)data;
+    wayland_wintab_distance(tool, distance);
+}
+
+static void wayland_tablet_tool_tilt(void *data,
+                                     struct zwp_tablet_tool_v2 *zwp_tablet_tool_v2,
+                                     wl_fixed_t tilt_x,
+                                     wl_fixed_t tilt_y)
+{
+    struct wayland_tablet_tool *tool = (struct wayland_tablet_tool *)data;
+    wayland_wintab_tilt(tool, tilt_x, tilt_y);
+}
+
+static void wayland_tablet_tool_rotation(void *data,
+                                         struct zwp_tablet_tool_v2 *zwp_tablet_tool_v2,
+                                         wl_fixed_t degrees)
+{
+    struct wayland_tablet_tool *tool = (struct wayland_tablet_tool *)data;
+    wayland_wintab_rotation(tool, degrees);
+}
+
+static void wayland_tablet_tool_slider(void *data,
+                                       struct zwp_tablet_tool_v2 *zwp_tablet_tool_v2,
+                                       int32_t position)
+{
+    struct wayland_tablet_tool *tool = (struct wayland_tablet_tool *)data;
+    wayland_wintab_slider(tool, position);
+}
+
+static void wayland_tablet_tool_wheel(void *data,
+                                      struct zwp_tablet_tool_v2 *zwp_tablet_tool_v2,
+                                      wl_fixed_t degrees,
+                                      int32_t clicks)
+{
+    struct wayland_tablet_tool *tool = (struct wayland_tablet_tool *)data;
+    wayland_wintab_wheel(tool, degrees, clicks);
+}
+
+static void wayland_tablet_tool_button(void *data,
+                                       struct zwp_tablet_tool_v2 *zwp_tablet_tool_v2,
+                                       uint32_t serial,
+                                       uint32_t button,
+                                       uint32_t state)
+{
+    struct wayland_tablet_tool *tool = (struct wayland_tablet_tool *)data;
+    wayland_wintab_button(tool, serial, button, state);
+}
+
+static void wayland_tablet_tool_frame(void *data,
+                                      struct zwp_tablet_tool_v2 *zwp_tablet_tool_v2,
+                                      uint32_t time)
+{
+    struct wayland_tablet_tool *tool = (struct wayland_tablet_tool *)data;
+    wayland_wintab_frame(tool, time);
+}
+
+static const struct zwp_tablet_tool_v2_listener zwp_tablet_tool_v2_listener =
+{
+    wayland_tablet_tool_type,
+    wayland_tablet_tool_hardware_serial,
+    wayland_tablet_tool_hardware_id_wacom,
+    wayland_tablet_tool_capability,
+    wayland_tablet_tool_done,
+    wayland_tablet_tool_removed,
+    wayland_tablet_tool_proximity_in,
+    wayland_tablet_tool_proximity_out,
+    wayland_tablet_tool_down,
+    wayland_tablet_tool_up,
+    wayland_tablet_tool_motion,
+    wayland_tablet_tool_pressure,
+    wayland_tablet_tool_distance,
+    wayland_tablet_tool_tilt,
+    wayland_tablet_tool_rotation,
+    wayland_tablet_tool_slider,
+    wayland_tablet_tool_wheel,
+    wayland_tablet_tool_button,
+    wayland_tablet_tool_frame
+};
+
+/**********************************************************************
+ *          zwp_tablet_pad_v2 handlers
+ */
+
+void wayland_tablet_pad_group(void *data, struct zwp_tablet_pad_v2 *zwp_tablet_pad_v2,
+                              struct zwp_tablet_pad_group_v2 *pad_group)
+{
+}
+
+void wayland_tablet_pad_path(void *data, struct zwp_tablet_pad_v2 *zwp_tablet_pad_v2,
+                             const char *path)
+{
+}
+
+void wayland_tablet_pad_buttons(void *data, struct zwp_tablet_pad_v2 *zwp_tablet_pad_v2,
+                                uint32_t buttons)
+{
+}
+
+void wayland_tablet_pad_done(void *data, struct zwp_tablet_pad_v2 *zwp_tablet_pad_v2)
+{
+    struct wayland_tablet *tablet = &process_wayland.tablet;
+    struct wayland_tablet_pad *pad = (struct wayland_tablet_pad *)data;
+
+    pthread_mutex_lock(&tablet->mutex);
+    list_add_tail(&tablet->pads, &pad->entry);
+    pthread_mutex_unlock(&tablet->mutex);
+
+    TRACE("tablet pad added: %p\n", pad->zwp_tablet_pad_v2);
+}
+
+void wayland_tablet_pad_button(void *data, struct zwp_tablet_pad_v2 *zwp_tablet_pad_v2,
+                               uint32_t time, uint32_t button, uint32_t state)
+{
+}
+
+void wayland_tablet_pad_enter(void *data, struct zwp_tablet_pad_v2 *zwp_tablet_pad_v2,
+                              uint32_t serial, struct zwp_tablet_v2 *tablet,
+                              struct wl_surface *surface)
+{
+}
+
+void wayland_tablet_pad_leave(void *data, struct zwp_tablet_pad_v2 *zwp_tablet_pad_v2,
+                              uint32_t serial, struct wl_surface *surface)
+{
+}
+
+void wayland_tablet_pad_removed(void *data, struct zwp_tablet_pad_v2 *zwp_tablet_pad_v2)
+{
+    struct wayland_tablet *tablet = &process_wayland.tablet;
+    struct wayland_tablet_pad *pad = (struct wayland_tablet_pad *)data;
+
+    if (pad->entry.next) {
+        pthread_mutex_lock(&tablet->mutex);
+        list_remove(&pad->entry);
+        pthread_mutex_unlock(&tablet->mutex);
+    }
+
+    TRACE("tablet pad removed: %p\n", pad->zwp_tablet_pad_v2);
+
+    zwp_tablet_pad_v2_destroy(zwp_tablet_pad_v2);
+    free(pad);
+}
+
+static const struct zwp_tablet_pad_v2_listener zwp_tablet_pad_v2_listener =
+{
+    wayland_tablet_pad_group,
+    wayland_tablet_pad_path,
+    wayland_tablet_pad_buttons,
+    wayland_tablet_pad_done,
+    wayland_tablet_pad_button,
+    wayland_tablet_pad_enter,
+    wayland_tablet_pad_leave,
+    wayland_tablet_pad_removed,
+};
+
+/**********************************************************************
+ *          zwp_tablet_seat_v2 handlers
+ */
+
+static void wayland_tablet_seat_device_added(void *data,
+                                             struct zwp_tablet_seat_v2 *zwp_tablet_seat_v2,
+                                             struct zwp_tablet_v2 *id)
+{
+    struct wayland_tablet_device *device;
+    device = calloc(1, sizeof(struct wayland_tablet_device));
+    device->zwp_tablet_v2 = id;
+    zwp_tablet_v2_add_listener(id, &zwp_tablet_v2_listener, device);
+}
+
+static void wayland_tablet_seat_tool_added(void *data,
+                                           struct zwp_tablet_seat_v2 *zwp_tablet_seat_v2,
+                                           struct zwp_tablet_tool_v2 *id)
+{
+    struct wayland_tablet_tool *tool;
+    tool = calloc(1, sizeof(struct wayland_tablet_tool));
+    tool->zwp_tablet_tool_v2 = id;
+    zwp_tablet_tool_v2_add_listener(id, &zwp_tablet_tool_v2_listener, tool);
+}
+
+static void wayland_tablet_seat_pad_added(void *data, struct zwp_tablet_seat_v2 *zwp_tablet_seat_v2,
+                                          struct zwp_tablet_pad_v2 *id)
+{
+    struct wayland_tablet_pad *pad;
+    pad = calloc(1, sizeof(struct wayland_tablet_pad));
+    pad->zwp_tablet_pad_v2 = id;
+    zwp_tablet_pad_v2_add_listener(id, &zwp_tablet_pad_v2_listener, pad);
+}
+
+static const struct zwp_tablet_seat_v2_listener zwp_tablet_seat_v2_listener =
+{
+    wayland_tablet_seat_device_added,
+    wayland_tablet_seat_tool_added,
+    wayland_tablet_seat_pad_added,
+};
+
+void wayland_tablet_init()
+{
+    struct wayland_seat *seat = &process_wayland.seat;
+    struct wayland_tablet *tablet = &process_wayland.tablet;
+    struct zwp_tablet_seat_v2 *zwp_tablet_seat_v2;
+
+    if (!tablet->zwp_tablet_manager_v2 || !seat->wl_seat)
+        return;
+
+    if (tablet->zwp_tablet_seat_v2)
+        return;
+
+    zwp_tablet_seat_v2 =
+        zwp_tablet_manager_v2_get_tablet_seat(tablet->zwp_tablet_manager_v2, seat->wl_seat);
+
+    pthread_mutex_lock(&tablet->mutex);
+    tablet->zwp_tablet_seat_v2 = zwp_tablet_seat_v2;
+    list_init(&tablet->devices);
+    list_init(&tablet->tools);
+    list_init(&tablet->pads);
+    pthread_mutex_unlock(&tablet->mutex);
+
+    zwp_tablet_seat_v2_add_listener(tablet->zwp_tablet_seat_v2,
+                                    &zwp_tablet_seat_v2_listener,
+                                    NULL);
+}
