+static const char *output_info_primary_name;
+
+static BOOL output_info_is_primary(const struct output_info *info)
+{
+    if (output_info_primary_name)
+        return info->output->name && !strcmp(info->output->name, output_info_primary_name);
+    return info->x == 0 && info->y == 0;
+}
