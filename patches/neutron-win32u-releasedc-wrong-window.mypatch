# neutron-win32u-releasedc-wrong-window
#
# Don't tear down an in-flight cache DC on a wrong-window ReleaseDC.
#
# release_dc() disabled any DCX_CACHE DC on ReleaseDC, keyed only on the hdc->DCE lookup, ignoring
# whether the caller actually owns the DC. Windows returns success for a ReleaseDC issued with the
# "wrong" window but leaves the DC intact — the true owner frees it via its own ReleaseDC/EndPaint.
# Because Wine disabled it, dc_attr->disabled=1 -> get_dc_attr() returns NULL -> every subsequent
# client-side GDI op into that DC silently no-ops.
#
# Repro (Adobe Lightroom Classic "Copy Settings" dialog, MFC/Wichita UI): each checkbox paints via
# BeginPaint (a cache DC). Its comctl32 CB_ThemedPaint calls DrawThemeParentBackground, which sends
# WM_ERASEBKGND to the parent groupbox; the app's MFC subclass of that groupbox ReleaseDC()s the DC
# it was handed — the child checkbox's still-live BeginPaint DC. Wine disabled it mid-paint, so the
# checkbox box AND label (all drawing after DrawThemeParentBackground) vanished -> the whole list of
# 265 checkboxes rendered blank. Proven by staged instrumentation: DC alive at CB_ThemedPaint entry,
# dead immediately after DrawThemeParentBackground, via a release with caller_hwnd != dce->hwnd.
#
# Fix: a non-EndPaint ReleaseDC of a cache DC by a window that is not the DCE's current owner returns
# TRUE (as Windows does) but does NOT reset the count or set DCHF_DISABLEDC. Owner-matching releases,
# EndPaint (end_paint=TRUE), non-cache DCs, and hwnd==NULL desktop-DC releases are all unaffected.
# Conformance-safe: dlls/user32/tests/dce.c:208 ("ReleaseDC with wrong window should succeed") asserts
# only the TRUE return, not that the DC was freed.
# Touches: dlls/win32u/dce.c.
diff --git a/dlls/win32u/dce.c b/dlls/win32u/dce.c
index cf641c4ec2b..36ea1c3bba6 100644
--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -1234,6 +1234,23 @@ static INT release_dc( HWND hwnd, HDC hdc, BOOL end_paint )
     dce = get_dc_dce( hdc );
     if (dce && dce->count && dce->hwnd)
     {
+        /* NEUTRON: a plain ReleaseDC (not EndPaint) from a window that does NOT own this cache DC
+         * must succeed but must NOT tear the DC down — the owning window may still be painting into
+         * it. Windows returns success for such a wrong-window ReleaseDC yet leaves the DC intact (the
+         * true owner frees it via its own ReleaseDC/EndPaint); Wine used to disable it here, silently
+         * dropping every subsequent GDI op into that DC. Repro: Lightroom's Copy Settings dialog — a
+         * checkbox paints via BeginPaint (cache DC), its CB_ThemedPaint calls DrawThemeParentBackground
+         * which sends WM_ERASEBKGND to the parent groupbox, whose MFC subclass ReleaseDC()s the child's
+         * in-flight DC -> the box + label (all subsequent drawing) vanished. Matches user32 dce tests
+         * (dce.c:208 "ReleaseDC with wrong window should succeed" asserts only the TRUE return, not that
+         * the DC was freed). Owner-matching releases, EndPaint, and hwnd==NULL desktop releases are
+         * unaffected. */
+        if (!end_paint && (dce->flags & DCX_CACHE) && hwnd && hwnd != dce->hwnd)
+        {
+            user_unlock();
+            release_opengl_drawables( &drawables );
+            return TRUE;
+        }
         if (!(dce->flags & DCX_NORESETATTRS)) set_dce_flags( dce->hdc, DCHF_RESETDC );
         if (end_paint || (dce->flags & DCX_CACHE)) delete_clip_rgn( dce );
         if (dce->flags & DCX_CACHE)
