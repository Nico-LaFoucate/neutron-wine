+        static int neutron_dock_owned = -1;
+        if (neutron_dock_owned < 0)
+        {
+            const char *e = getenv( "NEUTRON_DOCK_OWNED" );
+            neutron_dock_owned = (e && e[0] == '1') ? 1 : 0;
+        }
+        if (neutron_dock_owned && managed && !owner && toplevel == hwnd)
+        {
+            HWND gwowner = NtUserGetWindowRelative( hwnd, GW_OWNER );
+            DWORD st = NtUserGetWindowLongW( hwnd, GWL_STYLE );
+            if (gwowner && gwowner != hwnd && (st & WS_CAPTION) && NtUserIsWindowVisible( gwowner ))
+            {
