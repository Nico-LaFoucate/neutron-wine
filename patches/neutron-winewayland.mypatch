+/* NEUTRON: cross-process cursor-shape channel. A CEF panel host is owned by the CEF process, so when
+ * the pointer is over it, CEF's SetCursor runs in CEF's process where its cursor BITMAP lives -- Premiere
+ * (which owns the wl_pointer) can't read that bitmap (get_icon_info fails cross-process), so it can't
+ * render the exact cursor. But the process that OWNS the cursor CAN resolve it to a cursor-shape enum
+ * locally. So every process publishes the shape of the cursor it just set into a tiny shared-memory slot,
+ * and the focused process reads it when over a cross-process child and applies it via the shape protocol
+ * (no bitmap needed). Keyed by wayland display so prefixes/sessions don't collide. */
+static volatile LONG *neutron_cursor_shm(void)
+{
+    static volatile LONG *ptr;
+    static int tried;
+    if (ptr || tried) return ptr;
+    tried = 1;
+    {
+        const char *dir = getenv("XDG_RUNTIME_DIR");
+        const char *disp = getenv("WAYLAND_DISPLAY");
+        char path[512];
+        int fd;
+        if (!dir) dir = "/tmp";
+        if (!disp) disp = "wl";
+        snprintf(path, sizeof(path), "%s/neutron_cursor_shape_%s", dir, disp);
+        if ((fd = open(path, O_RDWR | O_CREAT, 0600)) >= 0)
+        {
+            void *m = MAP_FAILED;
+            if (ftruncate(fd, sizeof(LONG)) == 0)
+                m = mmap(NULL, sizeof(LONG), PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+            ptr = (m == MAP_FAILED) ? NULL : m;
+            close(fd);
+        }
+    }
+    return ptr;
+}
+
+/* Resolve hcursor -> cursor-shape enum (works in the process that owns the cursor) and publish it. */
+static void neutron_publish_cursor_shape(HCURSOR hcursor)
+{
+    volatile LONG *shm = neutron_cursor_shm();
+    ICONINFOEXW info = {0};
+    enum wp_cursor_shape_device_v1_shape shape = 0;
+    uint32_t proto_version = 1;
+
+    if (!shm || !hcursor) return;
+    if (process_wayland.wp_cursor_shape_manager_v1)
+        proto_version = wp_cursor_shape_manager_v1_get_version(process_wayland.wp_cursor_shape_manager_v1);
+    if (get_icon_info(hcursor, &info))
+    {
+        shape = cursor_shape_from_info(&info, proto_version);
+        if (info.hbmColor) NtGdiDeleteObjectApp(info.hbmColor);
+        if (info.hbmMask) NtGdiDeleteObjectApp(info.hbmMask);
+    }
+    /* Only standard cursors resolve to a shape enum; Chromium's custom hand/text bitmaps give shape 0
+     * (TODO roadmap: transport the cursor bitmap cross-process for pixel-exact custom cursors). Publish
+     * a non-zero shape; leave the last value for shape 0 so we don't downgrade a good shape to arrow. */
+    if (shape) *shm = (LONG)shape;
+}
