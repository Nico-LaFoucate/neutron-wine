# neutron-winewayland
#
# Combined winewayland.drv patch: fractional-scale (1:1 buffer mapping on fractional-scaled
# outputs), xdg_popup menu rendering (Premiere dropdowns), and client-side window decorations
# (CSD: Wine draws its own dark title bar, themed via the prefix Control Panel colors). These
# three features were previously separate patches but overlap heavily in the same winewayland.drv
# files and are interdependent (decoration builds on xdg-popup builds on fractional-scale), so they
# are maintained together here to apply cleanly on the staging base. Touches:
# dlls/winewayland.drv/{Makefile.in,fractional-scale-v1.xml,xdg-decoration-unstable-v1.xml,
# wayland.c,wayland_surface.c,waylanddrv.h,waylanddrv_main.c,window.c}.

diff --git a/dlls/winewayland.drv/Makefile.in b/dlls/winewayland.drv/Makefile.in
index cbc49823cd6..aaa0e97fb4b 100644
--- a/dlls/winewayland.drv/Makefile.in
+++ b/dlls/winewayland.drv/Makefile.in
@@ -10,6 +10,7 @@ SOURCES = \
 	cursor-shape-v1.xml \
 	display.c \
 	dllmain.c \
+	fractional-scale-v1.xml \
 	opengl.c \
 	pointer-constraints-unstable-v1.xml \
 	pointer-warp-v1.xml \
@@ -28,6 +29,7 @@ SOURCES = \
 	window.c \
 	window_surface.c \
 	wlr-data-control-unstable-v1.xml \
+	xdg-decoration-unstable-v1.xml \
 	xdg-output-unstable-v1.xml \
 	xdg-shell.xml \
 	xdg-toplevel-icon-v1.xml
diff --git a/dlls/winewayland.drv/display.c b/dlls/winewayland.drv/display.c
index b0b3d116147..104aee30202 100644
--- a/dlls/winewayland.drv/display.c
+++ b/dlls/winewayland.drv/display.c
@@ -198,9 +198,18 @@ static void wayland_add_device_gpu(const struct gdi_device_manager *device_manag
 static void wayland_add_device_source(const struct gdi_device_manager *device_manager,
                                        void *param, UINT state_flags, struct output_info *output_info)
 {
+    /* NEUTRON per-monitor DPI (step ①): report each output's REAL dpi (96 * physical/logical px)
+     * instead of the single system dpi, so win32u's (already complete) per-monitor-DPI engine drives
+     * correct layout per monitor — e.g. a 4K@1.7x output => 163, a 1080p@1.0x => 96, rather than 163
+     * everywhere (which makes a per-monitor-aware app render 1.7x too large on the 1080p). Falls back
+     * to the system dpi until the compositor has advertised the output's logical size. */
     UINT dpi = NtUserGetSystemDpiForProcess( NULL );
-    TRACE("name=%s state_flags=0x%x\n",
-          output_info->output->name, state_flags);
+    int mode_w = output_info->output->current_mode ? output_info->output->current_mode->width : 0;
+    int logical_w = output_info->output->logical_w;
+    if (mode_w > 0 && logical_w > 0)
+        dpi = (UINT)((96.0 * mode_w) / logical_w + 0.5);
+    TRACE("name=%s state_flags=0x%x dpi=%u\n",
+          output_info->output->name, state_flags, dpi);
     device_manager->add_source(output_info->output->name, state_flags, dpi, param);
 }
 
@@ -213,11 +222,31 @@ static void wayland_add_device_monitor(const struct gdi_device_manager *device_m
             output_info->x + output_info->output->current_mode->width,
             output_info->y + output_info->output->current_mode->height);
 
-    /* We don't have a direct way to get the work area in Wayland. */
+    /* We don't have a direct way to get the work area in Wayland. But under
+     * server-side decorations the compositor reserves a titlebar at the top of
+     * each toplevel, so a maximized window's content is shorter than the monitor
+     * by that titlebar. Win32 maximize sizes to rc_work, so if rc_work == the full
+     * monitor the maximized client overhangs the (compositor-constrained) window
+     * by the titlebar height and the bottom of the window is clipped. Reserve an
+     * estimated titlebar (~32 logical px, scaled to device) at the top of the work
+     * area so the maximized client matches what the compositor actually gives.
+     * NEUTRON test: static estimate; productionize with the real inset measured
+     * from the first maximized xdg configure. */
     monitor.rc_work = monitor.rc_monitor;
+    {
+        int mode_h = output_info->output->current_mode ?
+                     output_info->output->current_mode->height : 0;
+        int logical_h = output_info->output->logical_h;
+        int inset = 32; /* logical px; KWin/Breeze titlebar ~= this */
+        if (logical_h > 0 && mode_h > 0)
+            inset = (int)((32.0 * mode_h) / logical_h + 0.5); /* -> device px */
+        if (inset > 0 && inset < (monitor.rc_work.bottom - monitor.rc_work.top))
+            monitor.rc_work.top += inset;
+    }
 
-    TRACE("name=%s rc_monitor=rc_work=%s\n",
-          output_info->output->name, wine_dbgstr_rect(&monitor.rc_monitor));
+    TRACE("name=%s rc_monitor=%s rc_work=%s\n",
+          output_info->output->name, wine_dbgstr_rect(&monitor.rc_monitor),
+          wine_dbgstr_rect(&monitor.rc_work));
 
     device_manager->add_monitor(&monitor, param);
 }
diff --git a/dlls/winewayland.drv/dllmain.c b/dlls/winewayland.drv/dllmain.c
index 8055d883ee0..b5bd6f45218 100644
--- a/dlls/winewayland.drv/dllmain.c
+++ b/dlls/winewayland.drv/dllmain.c
@@ -93,6 +93,141 @@ static DWORD WINAPI clipboard_thread(void *arg)
     return 0;
 }
 
+/* NEUTRON: cross-process CEP panel present consumer.
+ * dcomp (in the CEF process) writes a panel's swapchain pixels into a named shared section keyed by
+ * the Adobe-app-owned host hwnd, and registers that hwnd in a shared registry. Wine's window_surface
+ * is per-process, so the pixels MUST be blitted in the owner process. This thread runs in every
+ * process; for each registered host hwnd that THIS process owns, it blits the shared pixels
+ * same-process (GetDC hits the real surface) and asks win32u to flush (win=OWN -> the subsurface
+ * commits). Registry-driven (not EnumWindows) and scoped to registered panels, to avoid racing the
+ * GUI thread's surface lifecycle during the startup window-creation storm. */
+#define NEUTRON_PX_MAXW 4096
+#define NEUTRON_PX_MAXH 2304
+struct neutron_px_shbuf { LONG seq, width, height, reserved; BYTE pixels[1]; };
+#define NEUTRON_PX_BYTES (sizeof(struct neutron_px_shbuf) + (SIZE_T)NEUTRON_PX_MAXW * NEUTRON_PX_MAXH * 4)
+#define NEUTRON_REG_MAX 64
+struct neutron_registry { LONG count; DWORD hwnds[NEUTRON_REG_MAX]; };
+
+struct neutron_consumer_slot { HWND hwnd; HANDLE map; struct neutron_px_shbuf *view; LONG last_seq; unsigned since_blit; };
+static struct neutron_consumer_slot neutron_slots[NEUTRON_REG_MAX];
+/* Force a refresh blit at least this often (ticks of ~16ms) even when the content seq is unchanged, to
+ * restore any repaint that clobbered the child region in the toplevel surface. ~30 ticks ~= 0.5s. */
+#define NEUTRON_REFRESH_TICKS 30
+
+static struct neutron_px_shbuf *neutron_consumer_open(HWND hwnd)
+{
+    static const WCHAR fmt[] = L"__neutron_dcomp_px_%08x";
+    WCHAR name[64];
+    int i, free_i = -1;
+    for (i = 0; i < NEUTRON_REG_MAX; i++)
+    {
+        if (neutron_slots[i].hwnd == hwnd && neutron_slots[i].view) return neutron_slots[i].view;
+        if (!neutron_slots[i].hwnd && free_i < 0) free_i = i;
+    }
+    if (free_i < 0) return NULL;
+    wsprintfW(name, fmt, (DWORD)(ULONG_PTR)hwnd);
+    neutron_slots[free_i].map = OpenFileMappingW(FILE_MAP_READ, FALSE, name);
+    if (!neutron_slots[free_i].map) return NULL;
+    neutron_slots[free_i].view = MapViewOfFile(neutron_slots[free_i].map, FILE_MAP_READ, 0, 0, NEUTRON_PX_BYTES);
+    if (!neutron_slots[free_i].view) { CloseHandle(neutron_slots[free_i].map); neutron_slots[free_i].map = NULL; return NULL; }
+    neutron_slots[free_i].hwnd = hwnd;
+    neutron_slots[free_i].last_seq = 0;
+    return neutron_slots[free_i].view;
+}
+
+static void neutron_consumer_present(HWND hwnd)
+{
+    struct neutron_px_shbuf *sh = neutron_consumer_open(hwnd);
+    LONG seq, w, h;
+    int i;
+    BITMAPINFO bmi;
+    HDC hdc;
+    RECT rc;
+    if (!sh) return;
+    seq = sh->seq;
+    for (i = 0; i < NEUTRON_REG_MAX; i++) if (neutron_slots[i].hwnd == hwnd) break;
+    /* Blit when CEF presented a new frame (seq changed); otherwise only refresh occasionally to
+     * restore any repaint that clobbered the child region -- not a full 7.6MB blit every 16ms. */
+    if (i < NEUTRON_REG_MAX && neutron_slots[i].last_seq == seq)
+    {
+        if (neutron_slots[i].since_blit < NEUTRON_REFRESH_TICKS) { neutron_slots[i].since_blit++; return; }
+    }
+    w = sh->width; h = sh->height;
+    if (w <= 0 || h <= 0 || w > NEUTRON_PX_MAXW || h > NEUTRON_PX_MAXH) return;
+
+    memset(&bmi, 0, sizeof(bmi));
+    bmi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+    bmi.bmiHeader.biWidth = w;
+    bmi.bmiHeader.biHeight = -h; /* top-down */
+    bmi.bmiHeader.biPlanes = 1;
+    bmi.bmiHeader.biBitCount = 32;
+    bmi.bmiHeader.biCompression = BI_RGB;
+
+    if ((hdc = GetDC(hwnd)))
+    {
+        static int (WINAPI *p_SetStretchBltMode)(HDC, int);
+        static int (WINAPI *p_StretchDIBits)(HDC, int, int, int, int, int, int, int, int,
+                                             const void *, const BITMAPINFO *, UINT, DWORD);
+        if (!p_StretchDIBits)
+        {
+            HMODULE g = LoadLibraryW(L"gdi32.dll");
+            if (g)
+            {
+                p_SetStretchBltMode = (void *)GetProcAddress(g, "SetStretchBltMode");
+                p_StretchDIBits = (void *)GetProcAddress(g, "StretchDIBits");
+            }
+        }
+        GetClientRect(hwnd, &rc);
+        if (p_SetStretchBltMode) p_SetStretchBltMode(hdc, COLORONCOLOR);
+        if (p_StretchDIBits)
+            p_StretchDIBits(hdc, 0, 0, rc.right - rc.left, rc.bottom - rc.top,
+                            0, 0, w, h, sh->pixels, &bmi, DIB_RGB_COLORS, SRCCOPY);
+        ReleaseDC(hwnd, hdc);
+        /* GetDC(host) drew into the TOPLEVEL window_surface (clipped to the child); flush it to commit
+         * (the GUI thread does not reliably flush a region dirtied by our cross-thread GDI blit -- without
+         * this the panel stays white). NOTE: cross-thread flush; the resize freeze is a SEPARATE
+         * cross-process-window-resize issue, not this. */
+        NtUserCallHwnd(GetAncestor(hwnd, GA_ROOT), NtUserCallHwnd_NeutronFlushSurface);
+        if (i < NEUTRON_REG_MAX) { neutron_slots[i].last_seq = seq; neutron_slots[i].since_blit = 0; }
+    }
+}
+
+static DWORD WINAPI neutron_present_consumer_thread(void *arg)
+{
+    static const WCHAR reg_nameW[] = L"__neutron_dcomp_registry";
+    DWORD self = GetCurrentProcessId();
+    HANDLE rh = NULL;
+    struct neutron_registry *reg = NULL;
+    for (;;)
+    {
+        /* Open + map the shared registry once, then read it live each tick (it's shared memory).
+         * Retry the open until CEF creates it; a process with no CEF panels just never maps it. */
+        if (!reg)
+        {
+            if (!rh) rh = OpenFileMappingW(FILE_MAP_READ, FALSE, reg_nameW);
+            if (rh) reg = MapViewOfFile(rh, FILE_MAP_READ, 0, 0, sizeof(*reg));
+        }
+        if (reg)
+        {
+            LONG n = reg->count, i;
+            if (n > NEUTRON_REG_MAX) n = NEUTRON_REG_MAX;
+            for (i = 0; i < n; i++)
+            {
+                HWND hwnd = (HWND)(ULONG_PTR)reg->hwnds[i];
+                DWORD pid = 0;
+                if (!hwnd) continue;
+                GetWindowThreadProcessId(hwnd, &pid);
+                /* Gate on IsWindowVisible: Premiere keeps multiple CEP hosts registered (e.g. a
+                 * tabbed-away/hidden panel that still renders); only present the on-screen one. */
+                if (pid == self && IsWindow(hwnd) && IsWindowVisible(hwnd))
+                    neutron_consumer_present(hwnd);
+            }
+        }
+        Sleep(16);
+    }
+    return 0;
+}
+
 BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
 {
     DWORD tid;
@@ -110,6 +245,8 @@ BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
     /* Handle clipboard events in a dedicated thread, if needed. */
     if (!WAYLANDDRV_UNIX_CALL(init_clipboard, NULL))
         CloseHandle(CreateThread(NULL, 0, clipboard_thread, NULL, 0, &tid));
+    /* NEUTRON: owner-side consumer for cross-process dcomp CEP panels (shared-memory pixel transport). */
+    CloseHandle(CreateThread(NULL, 0, neutron_present_consumer_thread, NULL, 0, &tid));
 
     return TRUE;
 }
diff --git a/dlls/winewayland.drv/fractional-scale-v1.xml b/dlls/winewayland.drv/fractional-scale-v1.xml
new file mode 100644
index 00000000000..350bfc01eaf
--- /dev/null
+++ b/dlls/winewayland.drv/fractional-scale-v1.xml
@@ -0,0 +1,102 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<protocol name="fractional_scale_v1">
+  <copyright>
+    Copyright © 2022 Kenny Levinsen
+
+    Permission is hereby granted, free of charge, to any person obtaining a
+    copy of this software and associated documentation files (the "Software"),
+    to deal in the Software without restriction, including without limitation
+    the rights to use, copy, modify, merge, publish, distribute, sublicense,
+    and/or sell copies of the Software, and to permit persons to whom the
+    Software is furnished to do so, subject to the following conditions:
+
+    The above copyright notice and this permission notice (including the next
+    paragraph) shall be included in all copies or substantial portions of the
+    Software.
+
+    THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
+    IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
+    FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT.  IN NO EVENT SHALL
+    THE AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
+    LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING
+    FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER
+    DEALINGS IN THE SOFTWARE.
+  </copyright>
+
+  <description summary="Protocol for requesting fractional surface scales">
+    This protocol allows a compositor to suggest for surfaces to render at
+    fractional scales.
+
+    A client can submit scaled content by utilizing wp_viewport. This is done by
+    creating a wp_viewport object for the surface and setting the destination
+    rectangle to the surface size before the scale factor is applied.
+
+    The buffer size is calculated by multiplying the surface size by the
+    intended scale.
+
+    The wl_surface buffer scale should remain set to 1.
+
+    If a surface has a surface-local size of 100 px by 50 px and wishes to
+    submit buffers with a scale of 1.5, then a buffer of 150px by 75 px should
+    be used and the wp_viewport destination rectangle should be 100 px by 50 px.
+
+    For toplevel surfaces, the size is rounded halfway away from zero. The
+    rounding algorithm for subsurface position and size is not defined.
+  </description>
+
+  <interface name="wp_fractional_scale_manager_v1" version="1">
+    <description summary="fractional surface scale information">
+      A global interface for requesting surfaces to use fractional scales.
+    </description>
+
+    <request name="destroy" type="destructor">
+      <description summary="unbind the fractional surface scale interface">
+        Informs the server that the client will not be using this protocol
+        object anymore. This does not affect any other objects,
+        wp_fractional_scale_v1 objects included.
+      </description>
+    </request>
+
+    <enum name="error">
+      <entry name="fractional_scale_exists" value="0"
+        summary="the surface already has a fractional_scale object associated"/>
+    </enum>
+
+    <request name="get_fractional_scale">
+      <description summary="extend surface interface for scale information">
+        Create an add-on object for the the wl_surface to let the compositor
+        request fractional scales. If the given wl_surface already has a
+        wp_fractional_scale_v1 object associated, the fractional_scale_exists
+        protocol error is raised.
+      </description>
+      <arg name="id" type="new_id" interface="wp_fractional_scale_v1"
+           summary="the new surface scale info interface id"/>
+      <arg name="surface" type="object" interface="wl_surface"
+           summary="the surface"/>
+    </request>
+  </interface>
+
+  <interface name="wp_fractional_scale_v1" version="1">
+    <description summary="fractional scale interface to a wl_surface">
+      An additional interface to a wl_surface object which allows the compositor
+      to inform the client of the preferred scale.
+    </description>
+
+    <request name="destroy" type="destructor">
+      <description summary="remove surface scale information for surface">
+        Destroy the fractional scale object. When this object is destroyed,
+        preferred_scale events will no longer be sent.
+      </description>
+    </request>
+
+    <event name="preferred_scale">
+      <description summary="notify of new preferred scale">
+        Notification of a new preferred scale for this surface that the
+        compositor suggests that the client should use.
+
+        The sent scale is the numerator of a fraction with a denominator of 120.
+      </description>
+      <arg name="scale" type="uint" summary="the new preferred scale"/>
+    </event>
+  </interface>
+</protocol>
diff --git a/dlls/winewayland.drv/wayland.c b/dlls/winewayland.drv/wayland.c
index b3d6b3c89e7..43c4d1345b4 100644
--- a/dlls/winewayland.drv/wayland.c
+++ b/dlls/winewayland.drv/wayland.c
@@ -86,6 +86,25 @@ static const struct wl_seat_listener seat_listener =
     wl_seat_handle_name
 };
 
+/* Server-side (compositor-drawn) decorations are OPT-IN. Neutron defaults to
+ * client-side decorations — Wine draws its own non-client frame — which is
+ * self-contained in the prefix, never overflows the monitor, and doesn't inherit
+ * the compositor's global window-decoration theme. Set WAYLANDDRV_SSD=1 to opt
+ * into compositor-drawn (xdg-decoration) frames instead. */
+static int wayland_disable_ssd(void)
+{
+    static int disabled = -1;
+    const char *env;
+
+    if (disabled == -1)
+    {
+        env = getenv("WAYLANDDRV_SSD");
+        disabled = !(env && !strcmp(env, "1"));
+    }
+
+    return disabled;
+}
+
 /**********************************************************************
  *          Registry handling
  */
@@ -120,11 +139,16 @@ static void registry_handle_global(void *data, struct wl_registry *registry,
     }
     else if (strcmp(interface, "xdg_wm_base") == 0)
     {
-        /* Bind version 2 so that compositors (e.g., sway) can properly send tiled
-         * states, instead of falling back to (ab)using the maximized state. */
+        /* Bind version 3: it enables the tiled states (>= v2) plus the
+         * xdg_positioner offset and xdg_popup::reposition requests (v3) we use
+         * for menu popups. We deliberately cap at 3 rather than going higher,
+         * because v4 (configure_bounds) and v5 (wm_capabilities) add xdg_toplevel
+         * events our listener doesn't handle, which would abort libwayland. */
+        if (version < 3)
+            WARN("xdg_wm_base version %u < 3; menu popups may not position correctly\n", version);
         process_wayland.xdg_wm_base =
             wl_registry_bind(registry, id, &xdg_wm_base_interface,
-                             version < 2 ? version : 2);
+                             version < 3 ? version : 3);
         xdg_wm_base_add_listener(process_wayland.xdg_wm_base, &xdg_wm_base_listener, NULL);
     }
     else if (strcmp(interface, "wl_shm") == 0)
@@ -158,6 +182,28 @@ static void registry_handle_global(void *data, struct wl_registry *registry,
         process_wayland.wp_viewporter =
             wl_registry_bind(registry, id, &wp_viewporter_interface, 1);
     }
+    else if (strcmp(interface, "wp_fractional_scale_manager_v1") == 0)
+    {
+        process_wayland.wp_fractional_scale_manager_v1 =
+            wl_registry_bind(registry, id, &wp_fractional_scale_manager_v1_interface, 1);
+    }
+    else if (strcmp(interface, "zxdg_decoration_manager_v1") == 0)
+    {
+        /* Server-side decorations: let the compositor draw the title bar with
+         * the desktop theme. Gated to compositors known to honor it well (KDE),
+         * unless the protocol is new enough (v2) to be trusted broadly. */
+        if (wayland_disable_ssd()) return;
+        if (version >= 2)
+        {
+            process_wayland.zxdg_decoration_manager_v1 =
+                wl_registry_bind(registry, id, &zxdg_decoration_manager_v1_interface, 2);
+        }
+        else if (WAYLAND_HasWindowManager("KDE"))
+        {
+            process_wayland.zxdg_decoration_manager_v1 =
+                wl_registry_bind(registry, id, &zxdg_decoration_manager_v1_interface, 1);
+        }
+    }
     else if (strcmp(interface, "wl_subcompositor") == 0)
     {
         process_wayland.wl_subcompositor =
@@ -318,6 +364,9 @@ BOOL wayland_process_init(void)
     }
 
     /* Check for optional globals. */
+    if (!process_wayland.zxdg_decoration_manager_v1)
+        WARN("Wayland compositor doesn't support optional zxdg_decoration_manager_v1 (server-side decorations won't work)\n");
+
     if (!process_wayland.zwp_pointer_constraints_v1)
         ERR("Wayland compositor doesn't support optional zwp_pointer_constraints_v1 (pointer locking/confining won't work)\n");
 
diff --git a/dlls/winewayland.drv/wayland_pointer.c b/dlls/winewayland.drv/wayland_pointer.c
index 109dd2dd0eb..921d6372e9b 100644
--- a/dlls/winewayland.drv/wayland_pointer.c
+++ b/dlls/winewayland.drv/wayland_pointer.c
@@ -28,6 +28,10 @@
 #undef SW_MAX /* Also defined in winuser.rh */
 #include <math.h>
 #include <stdlib.h>
+#include <stdio.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <sys/mman.h>
 
 #define OEMRESOURCE
 
@@ -121,6 +125,10 @@ static HWND wayland_pointer_get_focused_hwnd(void)
     return hwnd;
 }
 
+static void wayland_set_cursor(HWND hwnd, HCURSOR hcursor, BOOL use_hcursor);
+static BOOL wayland_pointer_show_shape(enum wp_cursor_shape_device_v1_shape shape);
+static volatile LONG *neutron_cursor_shm(void);
+
 static void pointer_handle_motion_internal(wl_fixed_t sx, wl_fixed_t sy)
 {
     INPUT input = {0};
@@ -165,6 +173,34 @@ static void pointer_handle_motion_internal(wl_fixed_t sx, wl_fixed_t sy)
           screen.x, screen.y);
 
     NtUserSendHardwareInput(hwnd, 0, &input, 0);
+
+    /* NEUTRON: cross-process cursor sync. When the pointer is over a window owned by ANOTHER process
+     * (a CEF panel host composited into our display subsurface), that process's SetCursor runs in its
+     * own wayland client and cannot drive our wl_pointer, so the cursor would vanish. The wineserver
+     * still tracks the global displayed cursor, so reflect it here. Scoped to cross-process windows to
+     * avoid perturbing the normal same-process cursor path. */
+    {
+        HWND under = NtUserWindowFromPoint(screen.x, screen.y);
+        DWORD under_pid = 0;
+        CURSORINFO ci = {0};
+        ci.cbSize = sizeof(ci);
+        NtUserGetCursorInfo(&ci);
+        if (under) NtUserGetWindowThread(under, &under_pid);
+        if (under && under_pid && under_pid != GetCurrentProcessId())
+        {
+            /* The cursor bitmap lives in the other process (get_icon_info fails cross-process). Apply
+             * the exact shape that process published to shared memory (arrow/text/hand/...); fall back
+             * to a visible default arrow. Honor an explicit hide. */
+            if (!(ci.flags & CURSOR_SHOWING))
+                wayland_set_cursor(hwnd, NULL, TRUE);
+            else
+            {
+                volatile LONG *shm = neutron_cursor_shm();
+                LONG s = shm ? *shm : 0;
