+/* NEUTRON M2: TRUE if a commit for this window would currently succeed. Lets the SHM flush
+ * skip the (tens-of-MB at 4K) buffer copies it would otherwise do and then discard, during the
+ * maximize/un-maximize transition when the xdg config isn't compatible yet. Read-only. */
+BOOL wayland_window_can_commit(HWND hwnd)
+{
+    struct wayland_surface *surface;
+    struct wayland_win_data *data;
+    BOOL can = TRUE;
+
+    if (!(data = wayland_win_data_get(hwnd))) return TRUE;
+    if ((surface = data->wayland_surface))
+        can = wayland_surface_can_reconfigure(surface);
+    wayland_win_data_release(data);
+
+    return can;
+}
