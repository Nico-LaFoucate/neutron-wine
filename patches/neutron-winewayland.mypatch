+static void xdg_popup_handle_done(void *private, struct xdg_popup *xdg_popup)
+{
+    HWND hwnd = private;
+
+    TRACE("hwnd=%p popup dismissed by compositor\n", hwnd);
+
+    NtUserPostMessage(hwnd, WM_SYSCOMMAND, SC_CLOSE, 0);
+}
