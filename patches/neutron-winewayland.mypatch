+/**********************************************************************
+ *          wayland_surface_can_reconfigure
+ *
+ * NEUTRON M2: read-only predicate mirroring what wayland_surface_reconfigure()
+ * (via wayland_surface_reconfigure_xdg) would return, WITHOUT side effects.
+ * Lets a flush bail before copying tens of MB it would only have to discard when
+ * the current xdg config isn't yet compatible (the maximize/un-maximize window).
+ */
+BOOL wayland_surface_can_reconfigure(struct wayland_surface *surface)
+{
+    struct wayland_window_config *window = &surface->window;
+    int win_width, win_height, width, height;
+
+    win_width = surface->window.rect.right - surface->window.rect.left;
+    win_height = surface->window.rect.bottom - surface->window.rect.top;
+    wayland_surface_coords_from_window(surface, win_width, win_height, &width, &height);
+
+    switch (surface->role)
+    {
+    case WAYLAND_SURFACE_ROLE_TOPLEVEL:
+    case WAYLAND_SURFACE_ROLE_POPUP:
+        if (!surface->xdg_surface) return TRUE; /* role cleared -> reconfigure breaks -> commits */
+        if (surface->processing.serial && surface->processing.processed &&
+            wayland_surface_config_is_compatible(&surface->processing, width, height, window->state))
+            return TRUE;
+        if (!surface->current.serial && surface->requested.serial &&
+            wayland_surface_config_is_compatible(&surface->requested, width, height, window->state))
+            return TRUE;
+        if (!surface->current.serial ||
+            !wayland_surface_config_is_compatible(&surface->current, width, height, window->state))
+            return FALSE;
+        return TRUE;
+    default:
+        return TRUE; /* NONE / SUBSURFACE: reconfigure never gates the commit */
+    }
+}
