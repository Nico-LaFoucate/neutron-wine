+/* NEUTRON: show a cursor by SHAPE via the cursor-shape protocol, no bitmap needed. Used when the
+ * pointer is over a cross-process child (a CEF panel host): that process's cursor bitmap can't be read
+ * here (get_icon_info fails cross-process), but the owning process publishes the shape enum to shared
+ * memory (see neutron_publish_cursor_shape), so we apply that. Falls back to a visible default arrow. */
+static BOOL wayland_pointer_show_shape(enum wp_cursor_shape_device_v1_shape shape)
+{
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+    BOOL ok = FALSE;
+
+    if (!process_wayland.wp_cursor_shape_manager_v1) return FALSE;
+    if (!shape) shape = WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_DEFAULT;
+
+    pthread_mutex_lock(&pointer->mutex);
+    if (pointer->wl_pointer && pointer->focused_hwnd)
+    {
+        if (!pointer->wp_cursor_shape_device_v1)
+            pointer->wp_cursor_shape_device_v1 =
+                wp_cursor_shape_manager_v1_get_pointer(
+                    process_wayland.wp_cursor_shape_manager_v1, pointer->wl_pointer);
+        if (pointer->wp_cursor_shape_device_v1)
+        {
+            wayland_pointer_clear_cursor_surface();
+            wp_cursor_shape_device_v1_set_shape(pointer->wp_cursor_shape_device_v1,
+                                                pointer->enter_serial, shape);
+            ok = TRUE;
+        }
+    }
+    pthread_mutex_unlock(&pointer->mutex);
+    if (ok) wl_display_flush(process_wayland.wl_display);
+    return ok;
+}
