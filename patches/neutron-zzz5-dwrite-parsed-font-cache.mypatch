+/* NEUTRON: FreeType has no internal locking, and neither the FT_Library nor an
+ * FT_Face may be used from two threads at once. Stock wine got away with it by
+ * giving every dwrite_fontface its own face and serialising glyph work on that
+ * fontface's own critical section -- but parsed fonts are now shared between
+ * fontfaces (see factory_cache_font_object), so one face can be reached from two
+ * of them at the same time. A single lock over the backend restores the
+ * guarantee, and also covers the FT_Library, which was always shared. It is
+ * uncontended in the common case, and the PE-side glyph cache means most glyph
+ * lookups never reach this code at all. */
+static pthread_mutex_t freetype_lock = PTHREAD_MUTEX_INITIALIZER;
+
 static NTSTATUS create_font_object(void *args)
 {
+    pthread_mutex_lock(&freetype_lock);
     struct create_font_object_params *params = args;
     FT_Face face = NULL;
     FT_Error fterror;
@@ -188,29 +202,31 @@
