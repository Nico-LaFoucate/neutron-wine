+/* ---- NEUTRON PARSED-FONT CACHE ----------------------------------------
+ * Keyed by the font file's reference key plus the face index. The entry owns the
+ * backend object AND the stream fragment it was built from: FT_New_Memory_Face
+ * does NOT copy the font data, so the mapping has to outlive the face. Bounded,
+ * least-recently-used first out, so a client that walks a font menu cannot grow
+ * it without limit. */
+#define DWRITE_FONT_OBJECT_CACHE_MAX 48
+
+struct cached_font_object
+{
+    struct list entry;
+    UINT64 object;
+    IDWriteFontFileStream *stream;
+    void *data_context;
+    UINT32 index;
+    UINT32 key_size;
+    void *key;
+};
+
+static void release_cached_font_object(struct cached_font_object *cached)
+{
+    struct release_font_object_params params = { cached->object };
+
+    UNIX_CALL(release_font_object, &params);
+    if (cached->stream)
+    {
+        IDWriteFontFileStream_ReleaseFileFragment(cached->stream, cached->data_context);
+        IDWriteFontFileStream_Release(cached->stream);
+    }
+    free(cached->key);
+    free(cached);
+}
+
+void factory_release_font_objects(IDWriteFactory7 *iface)
+{
+    struct dwritefactory *factory = impl_from_IDWriteFactory7(iface);
+    struct cached_font_object *cached, *cached2;
+
+    LIST_FOR_EACH_ENTRY_SAFE(cached, cached2, &factory->font_objects, struct cached_font_object, entry)
+    {
+        list_remove(&cached->entry);
+        release_cached_font_object(cached);
+    }
+    factory->font_object_count = 0;
+}
+
+UINT64 factory_get_cached_font_object(IDWriteFactory7 *iface, const void *key, UINT32 key_size, UINT32 index)
+{
+    struct dwritefactory *factory = impl_from_IDWriteFactory7(iface);
+    struct cached_font_object *cached;
+    UINT64 object = 0;
+
+    EnterCriticalSection(&factory->cs);
+    LIST_FOR_EACH_ENTRY(cached, &factory->font_objects, struct cached_font_object, entry)
+    {
+        if (cached->index == index && cached->key_size == key_size && !memcmp(cached->key, key, key_size))
+        {
+            /* most recently used to the front */
+            list_remove(&cached->entry);
+            list_add_head(&factory->font_objects, &cached->entry);
+            object = cached->object;
+            break;
+        }
+    }
+    LeaveCriticalSection(&factory->cs);
+
+    return object;
+}
+
+/* Takes ownership of the stream fragment on success. Returns FALSE if an equal
+ * entry raced in, in which case the caller keeps ownership and drops its copy. */
+BOOL factory_cache_font_object(IDWriteFactory7 *iface, const void *key, UINT32 key_size, UINT32 index,
+        UINT64 object, IDWriteFontFileStream *stream, void *data_context)
+{
+    struct dwritefactory *factory = impl_from_IDWriteFactory7(iface);
+    struct cached_font_object *cached, *evict = NULL;
+
+    if (!(cached = calloc(1, sizeof(*cached))))
+        return FALSE;
+    if (!(cached->key = malloc(key_size)))
+    {
+        free(cached);
+        return FALSE;
+    }
+    memcpy(cached->key, key, key_size);
+    cached->key_size = key_size;
+    cached->index = index;
+    cached->object = object;
+    cached->stream = stream;
+    cached->data_context = data_context;
+    IDWriteFontFileStream_AddRef(stream);
+
+    EnterCriticalSection(&factory->cs);
+    list_add_head(&factory->font_objects, &cached->entry);
+    if (++factory->font_object_count > DWRITE_FONT_OBJECT_CACHE_MAX)
+    {
+        evict = LIST_ENTRY(list_tail(&factory->font_objects), struct cached_font_object, entry);
+        list_remove(&evict->entry);
+        --factory->font_object_count;
+    }
+    LeaveCriticalSection(&factory->cs);
+
+    if (evict)
+        release_cached_font_object(evict);
+
+    return TRUE;
+}
+
