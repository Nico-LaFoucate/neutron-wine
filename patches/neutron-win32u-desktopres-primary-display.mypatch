--- a/dlls/win32u/driver.c
+++ b/dlls/win32u/driver.c
@@ -249,18 +249,34 @@
             return devmode.dmDisplayFrequency;
         return 1;
     }
+    /* DESKTOP{HORZ,VERT}RES is the PHYSICAL resolution of the display this DC is on --
+     * NOT the union of every monitor. Returning the virtual-screen rect made a two-monitor
+     * desktop report DESKTOPHORZRES=5760 against HORZRES=3840, while a Windows 11 reference
+     * machine reports the two as EQUAL for a DPI-aware process. The old value was also
+     * internally inconsistent here: the horizontal figure spanned both monitors while the
+     * vertical one did not. win32u consumes this itself to size a screen DC's vis_rect
+     * (dc.c), so the error was not confined to applications. Mirrors the HORZRES/VERTRES
+     * lookup above: this DC's display, else the primary monitor. */
     case DESKTOPHORZRES:
         if (NtGdiGetDeviceCaps( dev->hdc, TECHNOLOGY ) == DT_RASDISPLAY)
         {
-            RECT rect = get_virtual_screen_rect( 0, MDT_DEFAULT );
-            return rect.right - rect.left;
+            DC *dc = get_nulldrv_dc( dev );
+            RECT rect = {0};
+
+            if (dc->display[0]) rect = get_display_rect( dc->display );
+            if (IsRectEmpty( &rect )) rect = get_primary_monitor_rect( 0 );
+            if (!IsRectEmpty( &rect )) return rect.right - rect.left;
         }
         return NtGdiGetDeviceCaps( dev->hdc, HORZRES );
     case DESKTOPVERTRES:
         if (NtGdiGetDeviceCaps( dev->hdc, TECHNOLOGY ) == DT_RASDISPLAY)
         {
-            RECT rect = get_virtual_screen_rect( 0, MDT_DEFAULT );
-            return rect.bottom - rect.top;
+            DC *dc = get_nulldrv_dc( dev );
+            RECT rect = {0};
+
+            if (dc->display[0]) rect = get_display_rect( dc->display );
+            if (IsRectEmpty( &rect )) rect = get_primary_monitor_rect( 0 );
+            if (!IsRectEmpty( &rect )) return rect.bottom - rect.top;
         }
         return NtGdiGetDeviceCaps( dev->hdc, VERTRES );
     case BLTALIGNMENT:    return 0;
--- a/dlls/win32u/dc.c
+++ b/dlls/win32u/dc.c
@@ -773,10 +773,22 @@
 
     }
 
-    dc->attr->vis_rect.left   = 0;
-    dc->attr->vis_rect.top    = 0;
-    dc->attr->vis_rect.right  = NtGdiGetDeviceCaps( hdc, DESKTOPHORZRES );
-    dc->attr->vis_rect.bottom = NtGdiGetDeviceCaps( hdc, DESKTOPVERTRES );
+    /* NEUTRON: a DC's visible rect must span the WHOLE virtual desktop so drawing can
+     * cross monitors. It used to be taken from DESKTOP{HORZ,VERT}RES, but that cap is
+     * specified to report the PRIMARY display (gdi32 test dc.c:468 expects
+     * DESKTOPHORZRES == SM_CXSCREEN, with a todo_wine_if for the multihead case Wine
+     * gets wrong). Fixing the cap therefore silently narrowed this rect to the primary
+     * monitor and clipped all GDI drawing on any secondary display. Ask for the virtual
+     * screen directly instead, which is what this actually wants and preserves the
+     * behaviour the cap used to provide. */
+    {
+        RECT virt = get_virtual_screen_rect( 0, MDT_DEFAULT );
+
+        dc->attr->vis_rect.left   = 0;
+        dc->attr->vis_rect.top    = 0;
+        dc->attr->vis_rect.right  = virt.right - virt.left;
+        dc->attr->vis_rect.bottom = virt.bottom - virt.top;
+    }
     dc->is_display            = !!is_display;
 
     DC_InitDC( dc );
--- a/dlls/win32u/clipping.c
+++ b/dlls/win32u/clipping.c
@@ -185,10 +185,15 @@
 
     if (!get_dc_device_rect( dc, &rect ))
     {
+        /* NEUTRON: virtual screen, not DESKTOP{HORZ,VERT}RES -- see the matching comment
+         * in dc.c. That cap reports the primary display, so using it here clipped the
+         * default region to one monitor on a multihead desktop. */
+        RECT virt = get_virtual_screen_rect( 0, MDT_DEFAULT );
+
         rect.left = 0;
         rect.top = 0;
-        rect.right = NtGdiGetDeviceCaps( dc->hSelf, DESKTOPHORZRES );
-        rect.bottom = NtGdiGetDeviceCaps( dc->hSelf, DESKTOPVERTRES );
+        rect.right = virt.right - virt.left;
+        rect.bottom = virt.bottom - virt.top;
     }
     dc->hClipRgn = NtGdiCreateRectRgn( rect.left, rect.top, rect.right, rect.bottom );
 }
