+/* NEUTRON shape-hittest: kill switch NEUTRON_SHAPE_HITTEST=0 (the whole surface takes input again). */
+static BOOL neutron_shape_hittest(void)
+{
+    static int on = -1;
+    if (on < 0) on = neutron_gate("NEUTRON_SHAPE_HITTEST", TRUE);
+    return on;
+}
+
+/* More rects than this, and the surface keeps taking input everywhere (a shape that fragmented is
+ * not worth thousands of wl_region requests a change). */
+#define NEUTRON_INPUT_SHAPE_MAX_RECTS 4096
+
+/**********************************************************************
+ *          wayland_input_shape_update
+ *
+ * NEUTRON shape-hittest: the set pixels of win32u's 1bpp surface shape as rects, one per run of a
+ * row, rows with the same runs merged into one band. No shape bits: no shape.
+ */
+static void wayland_input_shape_update(struct wayland_input_shape *shape, const BITMAPINFO *shape_info,
+                                       const void *shape_bits)
+{
+    static LONG serial;
+    int width, height, stride, x, y, n, prev_n = 0, *runs, *prev, *swap;
+    UINT count = 0, capacity = 0, band = 0, i;
+    RECT *rects = NULL, *grown;
+
+    free(shape->rects);
+    shape->rects = NULL;
+    shape->count = 0;
+    shape->shaped = FALSE;
+    if (!(shape->serial = InterlockedIncrement(&serial))) shape->serial = InterlockedIncrement(&serial);
+    if (!shape_bits) return;
+
+    width = shape_info->bmiHeader.biWidth;
+    height = abs(shape_info->bmiHeader.biHeight);
+    if (width <= 0 || !height) return;
+    stride = shape_info->bmiHeader.biSizeImage / height;
+
+    runs = malloc((width + 2) * sizeof(*runs));
+    prev = malloc((width + 2) * sizeof(*prev));
+    if (!runs || !prev) goto done;
+
+    for (y = 0; y < height; y++)
+    {
+        const BYTE *row = (const BYTE *)shape_bits + y * stride;
+
+        for (n = 0, x = 0; x < width;)
+        {
+            int start;
+
+            while (x < width && !(x & 7) && !row[x / 8]) x += 8;
+            while (x < width && !(row[x / 8] & (0x80 >> (x & 7)))) x++;
+            if (x >= width) break;
+            start = x;
+            while (x < width && !(x & 7) && row[x / 8] == 0xff) x += 8;
+            while (x < width && (row[x / 8] & (0x80 >> (x & 7)))) x++;
+            runs[n++] = start;
+            runs[n++] = min(x, width);
+        }
+
+        if (n && n == prev_n && !memcmp(runs, prev, n * sizeof(*runs)))
+        {
+            for (i = band; i < count; i++) rects[i].bottom = y + 1;
+            continue;
+        }
+
+        band = count;
+        if (count + n / 2 > NEUTRON_INPUT_SHAPE_MAX_RECTS)
+        {
+            static LONG once;
+            if (!InterlockedExchange(&once, 1))
+                ERR("neutron-shape-hittest: shape of %dx%d needs over %u rects, whole surface takes input\n",
+                    width, height, NEUTRON_INPUT_SHAPE_MAX_RECTS);
+            free(rects);
+            rects = NULL;
+            count = 0;
+            goto done;
+        }
+        if (count + n / 2 > capacity)
+        {
+            capacity = max(capacity * 2, count + n / 2 + 64);
+            if (!(grown = realloc(rects, capacity * sizeof(*rects)))) { free(rects); rects = NULL; count = 0; goto done; }
+            rects = grown;
+        }
+        for (i = 0; i < n; i += 2) SetRect(&rects[count++], runs[i], y, runs[i + 1], y + 1);
+        swap = prev; prev = runs; runs = swap;
+        prev_n = n;
+    }
+    shape->shaped = TRUE;
+    shape->count = count;
+    shape->rects = rects;
+
+done:
+    free(runs);
+    free(prev);
+}
+
