+/* NEUTRON shape-hittest (NEUTRON_SHAPE_HITTEST=0 disables, window_surface.c): Windows hit-tests a window
+ * by its shape. Clicks pass through the parts outside its window region, its color-keyed pixels and the
+ * fully transparent pixels of a per-pixel-alpha layered window ("Layered Windows", Microsoft Learn), to
+ * whatever is below. The input region was the whole surface, so the transparent parts of a layered
+ * window took every click. Filmora 16's first-run walkthrough is a full-window layered popup, transparent
+ * but for its tip card, and nothing under it could be clicked. The region is now win32u's shape, in
+ * surface-local coordinates (rounded outward), empty for a click-through window as before. */
+static void wayland_surface_apply_input_region(struct wayland_surface *surface)
+{
+    struct wl_region *input_region = NULL;
+    int origin_x, origin_y;
+    UINT i;
+
+    wayland_surface_content_origin(surface, &origin_x, &origin_y);
+    surface->input_scale = surface->window.scale;
+    surface->input_x = origin_x;
+    surface->input_y = origin_y;
+
+    if (surface->input_transparent || surface->input_shape.shaped)
+        input_region = wl_compositor_create_region(process_wayland.wl_compositor);
+    if (input_region && !surface->input_transparent)
+    {
+        double scale = surface->window.scale > 0 ? surface->window.scale : 1.0;
+
+        for (i = 0; i < surface->input_shape.count; i++)
+        {
+            const RECT *rect = &surface->input_shape.rects[i];
+            int left = floor((rect->left - origin_x) / scale);
+            int top = floor((rect->top - origin_y) / scale);
+            int right = ceil((rect->right - origin_x) / scale);
+            int bottom = ceil((rect->bottom - origin_y) / scale);
+            wl_region_add(input_region, left, top, right - left, bottom - top);
+        }
+    }
+    wl_surface_set_input_region(surface->wl_surface, input_region);
+    if (input_region) wl_region_destroy(input_region);
+}
+
 /* Pass through mouse events for layered, transparent windows, to match
  * Windows behavior. */
 static void wayland_surface_update_input_region(struct wayland_surface *surface, DWORD exstyle)
 {
-    struct wl_region *input_region;
+    surface->input_transparent = (exstyle & WS_EX_TRANSPARENT) && (exstyle & WS_EX_LAYERED);
+    wayland_surface_apply_input_region(surface);
+}
 
-    input_region = ((exstyle & WS_EX_TRANSPARENT) && (exstyle & WS_EX_LAYERED)) ?
-                   wl_compositor_create_region(process_wayland.wl_compositor) :
-                   NULL;
-    wl_surface_set_input_region(surface->wl_surface, input_region);
-    if (input_region) wl_region_destroy(input_region);
+/* NEUTRON shape-hittest: take the window surface's shape for this commit; re-apply the region when the
+ * shape, the scale or the content origin changed since it was last applied. */
+static void wayland_surface_set_input_shape(struct wayland_surface *surface,
+                                            const struct wayland_input_shape *shape)
+{
+    int origin_x, origin_y;
+
+    if (shape->serial != surface->input_shape.serial)
+    {
+        RECT *rects = NULL;
+
+        if (shape->count && !(rects = malloc(shape->count * sizeof(*rects)))) return;
+        if (shape->count) memcpy(rects, shape->rects, shape->count * sizeof(*rects));
+        free(surface->input_shape.rects);
+        surface->input_shape = *shape;
+        surface->input_shape.rects = rects;
+    }
+    else
+    {
+        wayland_surface_content_origin(surface, &origin_x, &origin_y);
+        if (!surface->input_shape.shaped || surface->input_transparent ||
+            (surface->input_scale == surface->window.scale &&
+             surface->input_x == origin_x && surface->input_y == origin_y))
+            return;
+    }
+    wayland_surface_apply_input_region(surface);
 }
 
