+/* NEUTRON shape-hittest: set the pixels a layered window is hit-tested by */
+DECL_HANDLER(set_window_hit_region)
+{
+    struct region *region = NULL;
+    struct window *win = get_window( req->window );
+
+    if (!win) return;
+    if (!req->clear && !(region = create_region_from_req_data( get_req_data(), get_req_data_size() )))
+        return;
+    if (win->hit_region) free_region( win->hit_region );
+    win->hit_region = region;
+}
+
+
