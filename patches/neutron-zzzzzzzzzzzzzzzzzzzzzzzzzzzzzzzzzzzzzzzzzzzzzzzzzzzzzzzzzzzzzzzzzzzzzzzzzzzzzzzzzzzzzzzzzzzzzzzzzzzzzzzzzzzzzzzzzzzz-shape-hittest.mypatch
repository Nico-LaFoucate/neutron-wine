+/* NEUTRON shape-hittest: kill switch NEUTRON_SHAPE_HITTEST=0 (also read by winewayland). */
+static BOOL neutron_shape_hittest(void)
+{
+    static int v = -1;
+    if (v < 0) { const char *e = getenv( "NEUTRON_SHAPE_HITTEST" ); v = !(e && e[0] == '0'); }
+    return v;
+}
+
+/* More rects than this, and the window is hit-tested whole, as before. */
+#define NEUTRON_HIT_SHAPE_MAX_RECTS 4096
+
+/* NEUTRON shape-hittest: the set pixels of a 1bpp surface shape as region rects (one per run of a row,
+ * rows with the same runs merged into one band, so they are y-x banded), offset by origin. */
+static RECT *hit_shape_rects( const BITMAPINFO *shape_info, const void *shape_bits, POINT origin, UINT *ret_count )
+{
+    int width = shape_info->bmiHeader.biWidth, height = abs( shape_info->bmiHeader.biHeight );
+    int stride, x, y, n, prev_n = 0, *runs, *prev, *swap;
+    UINT count = 0, capacity = 0, band = 0, i;
+    RECT *rects = NULL, *grown;
+
+    *ret_count = 0;
+    if (width <= 0 || !height) return NULL;
+    stride = shape_info->bmiHeader.biSizeImage / height;
+    runs = malloc( (width + 2) * sizeof(*runs) );
+    prev = malloc( (width + 2) * sizeof(*prev) );
+    if (!runs || !prev) goto failed;
+
+    for (y = 0; y < height; y++)
+    {
+        const BYTE *row = (const BYTE *)shape_bits + y * stride;
+
+        for (n = 0, x = 0; x < width;)
+        {
+            int start;
+
+            while (x < width && !(x & 7) && !row[x / 8]) x += 8;
+            while (x < width && !(row[x / 8] & (0x80 >> (x & 7)))) x++;
+            if (x >= width) break;
+            start = x;
+            while (x < width && !(x & 7) && row[x / 8] == 0xff) x += 8;
+            while (x < width && (row[x / 8] & (0x80 >> (x & 7)))) x++;
+            runs[n++] = start;
+            runs[n++] = min( x, width );
+        }
+
+        if (n && n == prev_n && !memcmp( runs, prev, n * sizeof(*runs) ))
+        {
+            for (i = band; i < count; i++) rects[i].bottom = origin.y + y + 1;
+            continue;
+        }
+
+        band = count;
+        if (count + n / 2 > NEUTRON_HIT_SHAPE_MAX_RECTS) goto failed;
+        if (count + n / 2 > capacity)
+        {
+            capacity = max( capacity * 2, count + n / 2 + 64 );
+            if (!(grown = realloc( rects, capacity * sizeof(*rects) ))) goto failed;
+            rects = grown;
+        }
+        for (i = 0; i < n; i += 2)
+            SetRect( &rects[count++], origin.x + runs[i], origin.y + y, origin.x + runs[i + 1], origin.y + y + 1 );
+        swap = prev; prev = runs; runs = swap;
+        prev_n = n;
+    }
+    free( runs );
+    free( prev );
+    *ret_count = count;
+    return rects ? rects : malloc( sizeof(*rects) );
+
+failed:
+    free( runs );
+    free( prev );
+    free( rects );
+    return NULL;
+}
+
+/* NEUTRON shape-hittest: tell the server which pixels of a layered window take mouse input, so
+ * WindowFromPoint (and OLE drag and drop, which finds its drop target with it) passes over the
+ * color-keyed and fully transparent ones, as Windows does. The winewayland driver gives the
+ * compositor the same shape as the surface's input region. Rects are visible-rect relative, in
+ * the window's dpi: this surface's pixels offset by its rect. */
+static void report_hit_shape( struct window_surface *surface, const BITMAPINFO *shape_info, const void *shape_bits )
+{
+    POINT origin = {surface->rect.left, surface->rect.top};
+    RECT *rects = NULL;
+    UINT count = 0;
+
+    if (!surface->hwnd || !neutron_shape_hittest()) return;
+    if (shape_bits && (surface->alpha_mask || surface->color_key != CLR_INVALID))
+        rects = hit_shape_rects( shape_info, shape_bits, origin, &count );
+
+    SERVER_START_REQ( set_window_hit_region )
+    {
+        req->window = wine_server_user_handle( surface->hwnd );
+        req->clear = !rects;
+        if (count) wine_server_add_data( req, rects, count * sizeof(RECT) );
+        wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    free( rects );
+}
+
 void window_surface_flush( struct window_surface *surface )
 {
+    flush_surface( surface, TRUE );
+}
+
+static void flush_surface( struct window_surface *surface, BOOL report_hit_shape_changes )
+{
     char color_buf[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
     char shape_buf[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
     BITMAPINFO *color_info = (BITMAPINFO *)color_buf;
@@ -813,6 +923,8 @@
         BOOL shape_changed = update_surface_shape( surface, &surface->rect, &dirty, color_info, color_bits );
         void *shape_bits = window_surface_get_shape( surface, shape_info );
 
+        if (shape_changed && report_hit_shape_changes) report_hit_shape( surface, shape_info, shape_bits );
+
         TRACE( "Flushing hwnd %p, surface %p %s, bounds %s, dirty %s\n", surface->hwnd, surface,
                wine_dbgstr_rect( &surface->rect ), wine_dbgstr_rect( &surface->bounds ), wine_dbgstr_rect( &dirty ) );
 
