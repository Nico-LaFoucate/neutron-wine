 }
 
 static void unregister_presentations_for_hwnd(HWND hwnd)
@@ -1567,6 +1681,7 @@
 
     InitOnceExecuteOnce(&presentations_once, presentations_init, NULL, NULL);
 
+    EnterCriticalSection(&blit_cs);
     EnterCriticalSection(&presentations_cs);
     LIST_FOR_EACH_ENTRY_SAFE(p, next, &presentations, struct presentation, entry)
     {
@@ -1581,6 +1696,7 @@
         }
     }
