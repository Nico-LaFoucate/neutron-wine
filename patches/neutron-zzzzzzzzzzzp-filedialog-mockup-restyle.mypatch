+/* NEUTRON: the browser's own surface is the dialog ground with two rounded panels on it */
+static LRESULT main_on_wm_erasebkgnd(ExplorerBrowserImpl *This, HDC hdc)
+{
+    HBRUSH brush = CreateSolidBrush(NEUTRON_DLG_GROUND);
+    RECT rc;
+
+    GetClientRect(This->hwnd_main, &rc);
+    FillRect(hdc, &rc, brush);
+    DeleteObject(brush);
+    return 1;
+}
+
+static HFONT neutron_section_font(ExplorerBrowserImpl *This)
+{
+    HFONT base;
+    LOGFONTW lf;
+
+    if(This->hfont_section) return This->hfont_section;
+
+    base = (HFONT)SendMessageW(GetParent(This->hwnd_main), WM_GETFONT, 0, 0);
+    if(!base) base = GetStockObject(DEFAULT_GUI_FONT);
+    if(!GetObjectW(base, sizeof(lf), &lf)) return NULL;
+
+    /* the mockup's .tsec is smaller caps, but the dialog font's embedded bitmap sizes turn a
+     * shrunk Tahoma into "PL ACES"; the full-size face with 1px tracking reads as the header
+     * does */
+    lf.lfWeight = FW_MEDIUM;
+    This->hfont_section = CreateFontIndirectW(&lf);
+    return This->hfont_section;
+}
+
+static LRESULT main_on_wm_paint(ExplorerBrowserImpl *This)
+{
+    PAINTSTRUCT ps;
+    HDC hdc = BeginPaint(This->hwnd_main, &ps);
+    int radius = neutron_scale(NEUTRON_PANEL_RADIUS, This->dpix);
+
+    if(!IsRectEmpty(&This->navpane.rc))
+    {
+        WCHAR label[64];
+        HFONT font, old_font = NULL;
+        RECT rc = This->navpane.rc;
+
+        neutron_round_rect(hdc, &rc, NEUTRON_PANEL_FILL, NEUTRON_PANEL_BORDER, radius);
+
+        if(LoadStringW(shell32_hInstance, IDS_NEUTRON_PLACES, label, ARRAY_SIZE(label)) &&
+           (font = neutron_section_font(This)))
+        {
+            int pad = neutron_scale(NEUTRON_PANE_INSET + 6, This->dpix);
+            rc.left += pad;
+            rc.right -= pad;
+            rc.top += neutron_scale(NEUTRON_PANE_INSET, This->dpix);
+            rc.bottom = This->navpane.rc.top + neutron_scale(NEUTRON_SECTION_H, This->dpix);
+            old_font = SelectObject(hdc, font);
+            SetTextColor(hdc, NEUTRON_SECTION_TEXT);
+            neutron_draw_caps(hdc, label, &rc, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_NOPREFIX,
+                              1 /* one device px: scaled tracking reads as word gaps */);
+            SelectObject(hdc, old_font);
+        }
+    }
+
+    if(!IsRectEmpty(&This->sv_rc))
+        neutron_round_rect(hdc, &This->sv_rc, NEUTRON_PANEL_FILL, NEUTRON_PANEL_BORDER, radius);
+
+    EndPaint(This->hwnd_main, &ps);
+    return 0;
+}
+
