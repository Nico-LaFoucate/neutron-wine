 /**************************************************************************
  * Helper functions
  */
+/*
+ * NEUTRON: the two panes are drawn as rounded panels (fill #1e1e1e, 1px #303030 border,
+ * radius 4) separated by a gap, with the child windows inset so the rounded corners show.
+ * navpane.rc and sv_rc are the PANEL rectangles; panel_inner() gives the child's.
+ */
+#define NEUTRON_PANE_GAP    7   /* logical px between the two panels */
+#define NEUTRON_PANE_INSET  4   /* child inset from the panel edge; >= the corner radius */
+#define NEUTRON_SECTION_H   22  /* room for the section label above the tree */
+
+static void panel_inner(const ExplorerBrowserImpl *This, const RECT *panel, RECT *inner, BOOL section)
+{
+    int inset = neutron_scale(NEUTRON_PANE_INSET, This->dpix);
+    *inner = *panel;
+    InflateRect(inner, -inset, -inset);
+    if (section) inner->top += neutron_scale(NEUTRON_SECTION_H, This->dpix) - inset;
+    if (inner->right < inner->left) inner->right = inner->left;
+    if (inner->bottom < inner->top) inner->bottom = inner->top;
+}
