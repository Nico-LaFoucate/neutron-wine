# neutron-zzzzzzzzzzzp-filedialog-mockup-restyle
#
# Make Wine's Common Item Dialog (dlls/comdlg32/itemdlg.c -- the popup Premiere raises on
# Import, and every IFileOpenDialog/IFileSaveDialog) LOOK LIKE THE APPROVED MOCKUP
# (~/.cache/neutron-mock/itemdlg.html, ROADMAP.md item 1), not one more increment on it.
#
# Three rounds of small, individually-correct comctl32 changes had shipped and the operator's
# verdict on 11.10-84 was "It literally hardly looks any different." This patch works the whole
# gap list at once -- the frame, the breadcrumb, the panels, the fields, the accent button --
# and was iterated against the mockup by sampling pixels, not by eye.
#
# WHAT IT DRAWS (values are the mockup's, verbatim, in include/wine/neutronui.h):
#   frame     #232323 ground; nav band with round #333 hover fills and a 1px #313131 rule;
#             breadcrumb "Z: > Footage > A-Roll" (#9aa0a6 / current #dcdcdc), built from the
#             folder's filesystem ancestors on OnNavigationComplete; 7px margins all round
#   panels    tree and list each a #1e1e1e rounded (r4) panel with a 1px #303030 border,
#             separated by a 7px gap; "PLACES" caps label above the tree; children inset so
#             the corners show; the splitter lives in the gap
#   tree      stroked chevrons (#8a8a8a / open #c8c8c8) in a fixed slot; grey #2f2f2f rounded
#             selection with white text; #cfcfcf text; the empty Favorites root is not listed
#   header    uppercase, 1px-tracked #7f7f7f labels on the panel fill, one #2c2c2c rule, no
#             dividers, no bevel; columns Name / Size / Type / Modified (Attributes is no
#             longer on by default -- it is not in Explorer's default Details view either);
#             the name column takes the slack so there is no dead column past the last one
#   list      rounded (r3) full-row selection #3096fa inset 4px from the panel edge, white text
#             with #d8e9fd detail columns; unselected detail columns #a3a3a3; hover #292929;
#             icons drawn masked so the rounded fill shows through
#   fields    filename edit and filter combo as #171717 rounded (r4) boxes with a 1px #3a3a3a
#             border (lighter when focused); "Files of type:" label shown; the combo is
#             CBS_OWNERDRAWFIXED and draws its own text and chevron glyph
#   buttons   #323232 fill / #3f3f3f border / r4; Open is the accent #3096fa with white
#             medium-weight text; bottom right, Open then Cancel; no mnemonic underline
#
# HOW, AND WHY THIS WAY:
#   * A fixed palette in our own code (neutronui.h), not GetSysColor and not the visual style.
#     Two theming systems live in every prefix (the classic palette, which the Neutron theme
#     drives, and the Aero .msstyles wine.inf turns on, which comctl32 v6 controls paint from);
#     deriving these surfaces from either made the look depend on prefix state, and darkening
#     the global button palette breaks the Adobe apps' own labels (Lightroom's About box).
#   * The push buttons become BS_OWNERDRAW so comctl32's DIRECT paint path (paint_button() on
#     press/focus/enable, which never goes through WM_PAINT) lands in our WM_DRAWITEM too --
#     a paint-only subclass would flash the classic bevel on every press. A small subclass
#     answers WM_GETDLGCODE / BM_SETSTYLE exactly as a push button would, because
#     DEFDLG_SetDefButton rewrites the default button's style on every focus move and would
#     otherwise clobber BS_OWNERDRAW. Verified: WM_GETDLGCODE on Open = DLGC_BUTTON |
#     DLGC_DEFPUSHBUTTON; Enter in the filename box still drives the default button.
#   * The filter combo's arrow and text field are also repainted directly (CBRepaintButton,
#     CBPaintText); the subclass overdraws immediately after the messages that trigger them.
#   * comctl32's listview / treeview / header changes are OPT-IN through private style bits
#     (LVS_EX_NEUTRON_SHELL, TVS_EX_NEUTRON_SHELL, HDS_NEUTRON_SHELL) that shell32 and
#     explorerframe set on the file view's controls; no other application's controls change.
#     Wine's treeview never stored extended styles at all -- TVM_SETEXTENDEDSTYLE now does.
#   * Layout is real layout (update_layout rewritten), not padding tricks: the mockup's
#     label column, full-width fields and bottom-right buttons.
#
# THE HARD CONSTRAINT -- nothing may change what the dialog RETURNS -- was tested, not assumed:
# a driver posted Enter with a folder name (navigated: breadcrumb gained the segment), switched
# the filter through CBN_SELCHANGE, typed a file name and pressed Enter; the harness printed
#   RESULT path=[Z:\usr\share\licenses\7zip\License.txt] filetypeindex=3
# i.e. the exact file typed and the exact filter chosen.
#
# Measured on the throwaway prefix (Neutron theme, ThemeActive=0, 96 dpi, KDE 1.7x capture):
#   ground #232323, panels #1e1e1e / border #2f, header text #7f7f7f, selection #3096fa,
#   detail text #a3a3a3, fields #171717, Cancel #323232, Open #3096fa, crumbs #9aa0a6/#dcdcdc.
#
# Companion (NOT in this patch): bin/neutron's DEFAULT_THEME_COLORS gains "Scrollbar"="30 30 30"
# so the classic scrollbar track in the list is dark; Wine's scrollbar is drawn by win32u from
# that palette key and it had never been set.
#
# Files: include/wine/neutronui.h (new), dlls/comdlg32/{itemdlg.c,comdlg32.rc},
#        dlls/comctl32/{listview.c,treeview.c,header.c} (also built as comctl32_v6),
#        dlls/shell32/{ebrowser.c,shlview.c,shfldr_fs.c,shfldr_desktop.c,shfldr_mycomp.c,
#        shell32.rc,shresdef.h}, dlls/explorerframe/nstc.c

--- a/dlls/comctl32/header.c
+++ b/dlls/comctl32/header.c
@@ -39,6 +39,7 @@
 #include "commctrl.h"
 #include "comctl32.h"
 #include "wine/debug.h"
+#include "wine/neutronui.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(header);
 
@@ -303,8 +304,12 @@
 #endif
 
     /* NEUTRON: hovering a column tints it with the shared row-hover colour instead of doing
-     * nothing, so the header responds the way the list below it does. */
-    hbr = CreateSolidBrush(hottrack ? COMCTL32_HoverColor() : GetBkColor(hdc));
+     * nothing, so the header responds the way the list below it does. The shell look keeps
+     * the panel fill and shows hover through the label colour instead. */
+    if (infoPtr->dwStyle & HDS_NEUTRON_SHELL)
+        hbr = CreateSolidBrush(NEUTRON_PANEL_FILL);
+    else
+        hbr = CreateSolidBrush(hottrack ? COMCTL32_HoverColor() : GetBkColor(hdc));
     FillRect(hdc, r, hbr);
     DeleteObject(hbr);
 }
@@ -327,6 +332,14 @@
      *
      * bDown deliberately no longer changes the frame; the pressed state stays visible as the
      * existing 1px text offset in HEADER_DrawItem. */
+    /* NEUTRON shell look: one rule under the header in the mockup's colour, no dividers */
+    if (infoPtr->dwStyle & HDS_NEUTRON_SHELL)
+    {
+        neutron_hrule(hdc, r->left, r->right, r->bottom - 1, NEUTRON_HEADER_RULE);
+        r->bottom -= 1;
+        return;
+    }
+
     hbr = CreateSolidBrush(comctl32_color.clr3dShadow);
 
     edge = *r;
@@ -401,6 +414,18 @@
     }
 #endif
 
+    /* NEUTRON: the shell look measures the same caps, letter-spaced label it draws */
+    if (GetWindowLongW(hwnd, GWL_STYLE) & HDS_NEUTRON_SHELL)
+    {
+        WCHAR buf[MAX_HEADER_TEXT_LEN];
+        int old_extra = SetTextCharacterExtra(hdc, 1);   /* one device px, see ebrowser.c */
+        lstrcpynW(buf, item->pszText, ARRAY_SIZE(buf));
+        CharUpperBuffW(buf, lstrlenW(buf));
+        DrawTextW(hdc, buf, -1, rect, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_CALCRECT);
+        SetTextCharacterExtra(hdc, old_extra);
+        return;
+    }
+
     DrawTextW(hdc, item->pszText, -1, rect, DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_CALCRECT);
 }
 
@@ -418,6 +443,13 @@
     }
 #endif
 
+    if (GetWindowLongW(hwnd, GWL_STYLE) & HDS_NEUTRON_SHELL)
+    {
+        neutron_draw_caps(hdc, item->pszText, rect, DT_LEFT | DT_END_ELLIPSIS | DT_VCENTER | DT_SINGLELINE,
+                          1);
+        return;
+    }
+
     DrawTextW(hdc, item->pszText, -1, rect, DT_LEFT | DT_END_ELLIPSIS | DT_VCENTER | DT_SINGLELINE);
 }
 
@@ -440,7 +472,13 @@
      * 65% toward the face so it sits back from the file names below it; hovering brings it to
      * full strength. Previously the hot state turned the text COLOR_HIGHLIGHT, which is the
      * Win95 "web view" look and fights the selection colour. */
-    if (COMCTL32_IsThemed(infoPtr->hwndSelf))
+    if (infoPtr->dwStyle & HDS_NEUTRON_SHELL)
+    {
+        /* the shell look: fixed palette, hover brightens the label */
+        SetTextColor(hdc, bHotTrack ? NEUTRON_HEADER_HOT : NEUTRON_HEADER_TEXT);
+        SetBkColor(hdc, NEUTRON_PANEL_FILL);
+    }
+    else if (COMCTL32_IsThemed(infoPtr->hwndSelf))
         SetTextColor(hdc, comctl32_color.clrBtnText);
     else if (bHotTrack)
         SetTextColor(hdc, comctl32_color.clrBtnText);
@@ -451,7 +489,8 @@
                               (GetGValue(fg) * 65 + GetGValue(bg) * 35) / 100,
                               (GetBValue(fg) * 65 + GetBValue(bg) * 35) / 100));
     }
-    SetBkColor(hdc, comctl32_color.clr3dFace);
+    if (!(infoPtr->dwStyle & HDS_NEUTRON_SHELL))
+        SetBkColor(hdc, comctl32_color.clr3dFace);
 
     if (lCDFlags & CDRF_NOTIFYITEMDRAW && !(phdi->fmt & HDF_OWNERDRAW))
     {
@@ -686,6 +725,15 @@
         RECT edge = *rect;
         HBRUSH hbr;
 
+        if (infoPtr->dwStyle & HDS_NEUTRON_SHELL)
+        {
+            hbr = CreateSolidBrush(NEUTRON_PANEL_FILL);
+            FillRect(hdc, rect, hbr);
+            DeleteObject(hbr);
+            neutron_hrule(hdc, rect->left, rect->right, rect->bottom - 1, NEUTRON_HEADER_RULE);
+            return;
+        }
+
         FillRect(hdc, rect, GetSysColorBrush(COLOR_3DFACE));
         hbr = CreateSolidBrush(comctl32_color.clr3dShadow);
         edge.top = edge.bottom - 1;
@@ -719,8 +767,17 @@
 
     /* draw Background */
     if (infoPtr->uNumItem == 0 && !COMCTL32_IsThemed(infoPtr->hwndSelf)) {
-        hbrBk = GetSysColorBrush(COLOR_3DFACE);
-        FillRect(hdc, &rect, hbrBk);
+        if (infoPtr->dwStyle & HDS_NEUTRON_SHELL)
+        {
+            hbrBk = CreateSolidBrush(NEUTRON_PANEL_FILL);
+            FillRect(hdc, &rect, hbrBk);
+            DeleteObject(hbrBk);
+        }
+        else
+        {
+            hbrBk = GetSysColorBrush(COLOR_3DFACE);
+            FillRect(hdc, &rect, hbrBk);
+        }
     }
 
     x = rect.left;
--- a/dlls/comctl32/listview.c
+++ b/dlls/comctl32/listview.c
@@ -141,6 +141,7 @@
 #include "shlwapi.h"
 
 #include "wine/debug.h"
+#include "wine/neutronui.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(listview);
 
@@ -1101,25 +1102,28 @@
     /* apparently, for selected items, we have to override the returned values */
     if (!SubItem)
     {
+        BOOL neutron = (infoPtr->dwLvExStyle & LVS_EX_NEUTRON_SHELL) != 0;
+
         if (cd->nmcd.uItemState & CDIS_SELECTED)
         {
             if (infoPtr->bFocus)
             {
-                backcolor = comctl32_color.clrHighlight;
-                textcolor = comctl32_color.clrHighlightText;
+                backcolor = neutron ? NEUTRON_LIST_SELECTED : comctl32_color.clrHighlight;
+                textcolor = neutron ? NEUTRON_LIST_SELTEXT : comctl32_color.clrHighlightText;
             }
             else if (infoPtr->dwStyle & LVS_SHOWSELALWAYS)
             {
-                backcolor = comctl32_color.clr3dFace;
-                textcolor = comctl32_color.clrBtnText;
+                backcolor = neutron ? NEUTRON_TREE_SELECTED : comctl32_color.clr3dFace;
+                textcolor = neutron ? NEUTRON_LIST_TEXT : comctl32_color.clrBtnText;
             }
         }
         /* NEUTRON: hovered-but-unselected rows get the shared tint. customdraw_fill already sets
          * CDIS_HOT from nHotItem; nothing consumed it for painting before. Under
          * LVS_EX_FULLROWSELECT the subitems inherit the DC colours set for item 0, so the tint
-         * spans the row; without it, it covers the label, which is still correct. */
+         * spans the row; without it, it covers the label, which is still correct. The shell
+         * look uses its fixed hover colour, which is tuned for the panel fill. */
         else if (cd->nmcd.uItemState & CDIS_HOT)
-            backcolor = COMCTL32_HoverColor();
+            backcolor = neutron ? NEUTRON_LIST_HOVER : COMCTL32_HoverColor();
     }
 
     if (backcolor == CLR_DEFAULT)
@@ -1780,6 +1784,14 @@
         return;
 
     LISTVIEW_GetItemBox(infoPtr, nItem, &rcBox);
+    if (infoPtr->dwLvExStyle & LVS_EX_NEUTRON_SHELL)
+    {
+        /* NEUTRON: the rounded row fill spans the client width, not just the columns */
+        RECT client;
+        GetClientRect(infoPtr->hwndSelf, &client);
+        rcBox.left = min(rcBox.left, client.left);
+        rcBox.right = max(rcBox.right, client.right);
+    }
     LISTVIEW_InvalidateRect(infoPtr, &rcBox);
 }
 
@@ -4724,7 +4736,30 @@
     else
         background = &rcSelect;
 
-    if (nmlvcd->clrTextBk != CLR_NONE)
+    /* NEUTRON shell look (details + full-row select): a selected or hovered row is one
+     * rounded fill inset from the list's edges, painted once with the first subitem; the
+     * per-cell opaque fills are skipped so the corners stay rounded, and the text is drawn
+     * transparent below. Rows that are neither keep the background the erase gave them. */
+    if ((infoPtr->dwLvExStyle & LVS_EX_NEUTRON_SHELL) && infoPtr->uView == LV_VIEW_DETAILS &&
+        (infoPtr->dwLvExStyle & LVS_EX_FULLROWSELECT))
+    {
+        if (item->iSubItem == 0 &&
+            ((item->state & LVIS_SELECTED) || (nmlvcd->nmcd.uItemState & CDIS_HOT)))
+        {
+            RECT row;
+            int dpi = neutron_window_dpi(infoPtr->hwndSelf);
+            int inset = neutron_scale(NEUTRON_ROW_INSET, dpi);
+
+            GetClientRect(infoPtr->hwndSelf, &row);
+            row.left += inset;
+            row.right -= inset;
+            row.top = rcBox.top;
+            row.bottom = rcBox.bottom;
+            neutron_round_rect(nmlvcd->nmcd.hdc, &row, GetBkColor(nmlvcd->nmcd.hdc), CLR_NONE,
+                               neutron_scale(NEUTRON_ROW_RADIUS, dpi));
+        }
+    }
+    else if (nmlvcd->clrTextBk != CLR_NONE)
         ExtTextOutW(nmlvcd->nmcd.hdc, background->left, background->top, ETO_OPAQUE, background, NULL, 0, NULL);
 
     if (item->state & LVIS_FOCUSED)
@@ -4782,7 +4817,9 @@
             style = ILD_NORMAL;
 
         ImageList_DrawEx(himl, item->iImage, nmlvcd->nmcd.hdc, rcIcon.left, rcIcon.top,
-                         rcIcon.right - rcIcon.left, rcIcon.bottom - rcIcon.top, infoPtr->clrBk,
+                         rcIcon.right - rcIcon.left, rcIcon.bottom - rcIcon.top,
+                         /* NEUTRON: masked over the rounded row fill, not on a square of clrBk */
+                         (infoPtr->dwLvExStyle & LVS_EX_NEUTRON_SHELL) ? CLR_NONE : infoPtr->clrBk,
                          item->state & LVIS_CUT ? RGB(255, 255, 255) : CLR_DEFAULT,
                          style | (item->state & LVIS_OVERLAYMASK));
     }
@@ -4814,6 +4851,20 @@
     if (infoPtr->uView == LV_VIEW_DETAILS && infoPtr->dwLvExStyle & LVS_EX_GRIDLINES)
         rcLabel.bottom--;
 
+    if (infoPtr->dwLvExStyle & LVS_EX_NEUTRON_SHELL)
+    {
+        /* NEUTRON: transparent text over the row fill; the detail columns sit back from the
+         * name, and take the selection's lighter tint when the row is selected */
+        int old_mode = SetBkMode(nmlvcd->nmcd.hdc, TRANSPARENT);
+        if (item->iSubItem && infoPtr->uView == LV_VIEW_DETAILS)
+            SetTextColor(nmlvcd->nmcd.hdc,
+                         (item->state & LVIS_SELECTED) && infoPtr->bFocus ? NEUTRON_LIST_SELDIM
+                                                                            : NEUTRON_LIST_DIM);
+        DrawTextW(nmlvcd->nmcd.hdc, item->pszText, -1, &rcLabel, format);
+        SetBkMode(nmlvcd->nmcd.hdc, old_mode);
+        return;
+    }
+
     DrawTextW(nmlvcd->nmcd.hdc, item->pszText, -1, &rcLabel, format);
 }
 
--- a/dlls/comctl32/treeview.c
+++ b/dlls/comctl32/treeview.c
@@ -55,6 +55,7 @@
 #include "commctrl.h"
 #include "comctl32.h"
 #include "wine/debug.h"
+#include "wine/neutronui.h"
 #include "wine/exception.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(treeview);
@@ -65,6 +66,7 @@
   HWND          hwnd;
   HWND          hwndNotify;     /* Owner window to send notifications to */
   DWORD         dwStyle;
+  DWORD         dwExStyle;      /* NEUTRON: TVM_SETEXTENDEDSTYLE, kept for TVS_EX_NEUTRON_SHELL */
   HTREEITEM     root;
   UINT          uInternalStatus;
   INT           Timer;
@@ -2403,6 +2405,17 @@
     width = item->stateOffset - item->linesOffset;
     rectsize = min(height, width) / 4;
 
+    /* NEUTRON shell look: a stroked chevron in a fixed slot -- "›" collapsed, "⌄" open --
+     * in the mockup's glyph colours, brighter when open. */
+    if (infoPtr->dwExStyle & TVS_EX_NEUTRON_SHELL)
+    {
+        int dpi = neutron_window_dpi(infoPtr->hwnd);
+        BOOL open = (item->state & TVIS_EXPANDED) && !(item->state & TVIS_EXPANDPARTIAL);
+        neutron_chevron(hdc, centerx, centery, max(rectsize * 2 / 3, 3), neutron_scale(1, dpi),
+                        open, open ? NEUTRON_CHEVRON_OPEN : NEUTRON_CHEVRON);
+        return;
+    }
+
     /* NEUTRON: a filled triangle instead of the Win95 boxed +/-.
      *
      * ⭐ WHY THIS PATH IS EVEN REACHED. Above, comctl32 v6 asks GetWindowTheme() and, when a
@@ -2538,6 +2551,7 @@
     COLORREF oldTextColor, oldTextBkColor;
     int centery;
     BOOL inFocus = (GetFocus() == infoPtr->hwnd);
+    BOOL neutron = (infoPtr->dwExStyle & TVS_EX_NEUTRON_SHELL) != 0;
     NMTVCUSTOMDRAW nmcdhdr;
 
     TREEVIEW_UpdateDispInfo(infoPtr, item, CALLBACK_MASK_ALL);
@@ -2552,7 +2566,13 @@
 	((item->state & TVIS_SELECTED) && (!infoPtr->focusedItem || item == infoPtr->focusedItem) &&
 	 (inFocus || (infoPtr->dwStyle & TVS_SHOWSELALWAYS))))
     {
-	if ((item->state & TVIS_DROPHILITED) || inFocus)
+	if (neutron)
+	{
+	    /* the shell look: one quiet grey selection whether or not the tree has focus */
+	    nmcdhdr.clrTextBk = NEUTRON_TREE_SELECTED;
+	    nmcdhdr.clrText   = NEUTRON_TREE_SELTEXT;
+	}
+	else if ((item->state & TVIS_DROPHILITED) || inFocus)
 	{
 	    nmcdhdr.clrTextBk = comctl32_color.clrHighlight;
 	    nmcdhdr.clrText   = comctl32_color.clrHighlightText;
@@ -2569,7 +2589,7 @@
 	 * (which explorerframe now asks for) the FillRect below covers the whole row, and the icon
 	 * backdrop and ETO_OPAQUE text both take clrTextBk, so the tint is continuous. */
 	if ((infoPtr->dwStyle & TVS_TRACKSELECT) && (item == infoPtr->hotItem))
-	    nmcdhdr.clrTextBk = COMCTL32_HoverColor();
+	    nmcdhdr.clrTextBk = neutron ? NEUTRON_TREE_HOVER : COMCTL32_HoverColor();
 	else
 	    nmcdhdr.clrTextBk = GETBKCOLOR(infoPtr->clrBk);
 	nmcdhdr.clrText = GETTXTCOLOR(infoPtr->clrText);
@@ -2605,9 +2625,22 @@
 
     if (TREEVIEW_IsFullRowSelect(infoPtr))
     {
-        HBRUSH brush = CreateSolidBrush(nmcdhdr.clrTextBk);
-        FillRect(hdc, &item->rect, brush);
-        DeleteObject(brush);
+        if (neutron && nmcdhdr.clrTextBk != GETBKCOLOR(infoPtr->clrBk))
+        {
+            /* NEUTRON shell look: the row fill is a rounded rectangle inset from the edges */
+            int dpi = neutron_window_dpi(infoPtr->hwnd);
+            RECT row = item->rect;
+            row.left += neutron_scale(NEUTRON_ROW_INSET, dpi);
+            row.right -= neutron_scale(NEUTRON_ROW_INSET, dpi);
+            neutron_round_rect(hdc, &row, nmcdhdr.clrTextBk, CLR_NONE,
+                               neutron_scale(NEUTRON_ROW_RADIUS, dpi));
+        }
+        else
+        {
+            HBRUSH brush = CreateSolidBrush(nmcdhdr.clrTextBk);
+            FillRect(hdc, &item->rect, brush);
+            DeleteObject(brush);
+        }
     }
 
     TREEVIEW_DrawItemLines(infoPtr, hdc, item);
@@ -2690,6 +2723,13 @@
 	    rcText.bottom = item->rect.bottom;
 	    rcText.left = item->textOffset;
 	    rcText.right = rcText.left + item->textWidth + 4;
+	    if (neutron)
+	    {
+	        /* NEUTRON: keep the opaque text box inside the rounded row fill */
+	        int dpi = neutron_window_dpi(infoPtr->hwnd);
+	        rcText.right = min(rcText.right, item->rect.right -
+	                           neutron_scale(NEUTRON_ROW_INSET + NEUTRON_ROW_RADIUS, dpi));
+	    }
 
             TRACE("drawing text %s at (%s)\n",
                   debugstr_w(item->pszText), wine_dbgstr_rect(&rcText));
@@ -5822,6 +5862,16 @@
     case TVM_SETINDENT:
 	return TREEVIEW_SetIndent(infoPtr, (UINT)wParam);
 
+    case TVM_SETEXTENDEDSTYLE:
+        /* NEUTRON: Wine never stored these. wParam is the mask, lParam the styles. Only
+         * TVS_EX_NEUTRON_SHELL is acted on; the rest is kept so TVM_GETEXTENDEDSTYLE answers. */
+        infoPtr->dwExStyle = (infoPtr->dwExStyle & ~(DWORD)wParam) | ((DWORD)lParam & (DWORD)wParam);
+        TREEVIEW_Invalidate(infoPtr, NULL);
+        return 0;
+
+    case TVM_GETEXTENDEDSTYLE:
+        return infoPtr->dwExStyle;
+
     case TVM_SETINSERTMARK:
 	return TREEVIEW_SetInsertMark(infoPtr, (BOOL)wParam, (HTREEITEM)lParam);
 
--- a/dlls/comdlg32/comdlg32.rc
+++ b/dlls/comdlg32/comdlg32.rc
@@ -517,8 +517,10 @@
     EDITTEXT        IDC_FILENAME, 226, 240, 100, 12,  WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_CLIPSIBLINGS | ES_AUTOHSCROLL
 
     LTEXT           "Files of type:", IDC_FILETYPESTATIC, 160, 256, 60, 9, SS_RIGHT | WS_CLIPSIBLINGS
+    /* NEUTRON: CBS_OWNERDRAWFIXED so itemdlg.c paints the field and its items (see
