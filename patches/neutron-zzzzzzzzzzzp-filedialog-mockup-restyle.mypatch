     COMBOBOX        IDC_FILETYPE, 226, 256, 100, 60,  WS_CHILD | WS_VISIBLE | WS_TABSTOP | WS_VSCROLL |
-                    WS_CLIPSIBLINGS | CBS_HASSTRINGS | CBS_DROPDOWNLIST
+                    WS_CLIPSIBLINGS | CBS_HASSTRINGS | CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED
 
     DEFPUSHBUTTON   "&Open",  IDOK,     350, 240, 32, 14, WS_GROUP | WS_CLIPSIBLINGS
 
--- a/dlls/comdlg32/itemdlg.c
+++ b/dlls/comdlg32/itemdlg.c
@@ -34,6 +34,7 @@
 
 #include "wine/debug.h"
 #include "wine/list.h"
+#include "wine/neutronui.h"
 
 #define IDC_NAV_TOOLBAR      200
 #define IDC_NAVBACK          201
@@ -147,6 +148,15 @@
     GUID client_guid;
 
     HANDLE user_actctx;
+
+    /* NEUTRON restyle state -- paint and layout only, see neutron_init_frame() */
+    HBRUSH hbr_ground, hbr_field;
+    HFONT hfont_accent;         /* heavier label for the default (accent) button */
+    RECT rc_navband;            /* toolbar + breadcrumb band, dialog client coords */
+    RECT rc_crumbs;             /* where the breadcrumb is painted */
+    RECT rc_filename_frame;     /* the painted field around the borderless filename edit */
+    LPWSTR *crumbs;             /* breadcrumb segments, root first */
+    UINT crumb_count;
 } FileDialogImpl;
 
 /**************************************************************************
@@ -1754,17 +1764,579 @@
     return show;
 }
 
+
+/**************************************************************************
+ * NEUTRON restyle of the dialog frame.
+ *
+ * The approved mockup (docs: ROADMAP.md item 1) is a flat dark dialog: a #232323 ground, a
+ * nav band with round hover fills and a breadcrumb, rounded panels for the browser, fields
+ * drawn as rounded #171717 boxes, and an accent-blue Open button. Wine's template gives us
+ * user32/comctl32 v6 controls with 3D bevels that follow whichever of the prefix's TWO theming
+ * systems happens to win (classic palette vs. the Aero visual style wine.inf turns on), so
+ * the frame paints itself from the fixed palette in include/wine/neutronui.h instead.
+ *
+ * THE ONE HARD CONSTRAINT: nothing here may change what the dialog RETURNS. Every control
+ * keeps its identity, window text, message semantics and notification codes; the changes
+ * are owner-draw, custom-draw, WM_CTLCOLOR* and geometry. The push buttons become
+ * BS_OWNERDRAW (so comctl32's direct paint_button() path also lands in our WM_DRAWITEM
+ * instead of flashing a classic bevel), and a subclass answers WM_GETDLGCODE/BM_SETSTYLE the
+ * way a push button would so the dialog manager's default-button logic (Enter, focus moves)
+ * is byte-for-byte what it was.
+ */
+
+static int neutron_text_height(FileDialogImpl *This)
+{
+    HFONT font = (HFONT)SendMessageW(This->dlg_hwnd, WM_GETFONT, 0, 0);
+    TEXTMETRICW tm = { 0 };
+    HDC hdc = GetDC(This->dlg_hwnd);
+    HFONT old = font ? SelectObject(hdc, font) : NULL;
+
+    GetTextMetricsW(hdc, &tm);
+    if (old) SelectObject(hdc, old);
+    ReleaseDC(This->dlg_hwnd, hdc);
+    return tm.tmHeight ? tm.tmHeight : neutron_scale(13, This->dpi_y);
+}
+
+/* width of a push button for its current text: text + padding, never narrower than 60 */
+static int neutron_button_width(FileDialogImpl *This, HWND button, HFONT font)
+{
+    WCHAR text[256];
+    SIZE sz = { 0 };
+    HDC hdc;
+    HFONT old;
+
+    if (!button) return 0;
+    if (!font) font = (HFONT)SendMessageW(button, WM_GETFONT, 0, 0);
+    GetWindowTextW(button, text, ARRAY_SIZE(text));
+    hdc = GetDC(button);
+    old = font ? SelectObject(hdc, font) : NULL;
+    GetTextExtentPoint32W(hdc, text, lstrlenW(text), &sz);
+    if (old) SelectObject(hdc, old);
+    ReleaseDC(button, hdc);
+    return max(sz.cx + 2 * neutron_scale(12, This->dpi_x), neutron_scale(60, This->dpi_x));
+}
+
+/* width of a label's text in the dialog font, plus a little air */
+static int neutron_label_width(FileDialogImpl *This, int id)
+{
+    HWND hwnd = GetDlgItem(This->dlg_hwnd, id);
+    HFONT font = (HFONT)SendMessageW(This->dlg_hwnd, WM_GETFONT, 0, 0), old = NULL;
+    WCHAR text[256];
+    SIZE sz = { 0 };
+    HDC hdc;
+
+    if (!hwnd) return 0;
+    GetWindowTextW(hwnd, text, ARRAY_SIZE(text));
+    hdc = GetDC(This->dlg_hwnd);
+    if (font) old = SelectObject(hdc, font);
+    GetTextExtentPoint32W(hdc, text, lstrlenW(text), &sz);
+    if (old) SelectObject(hdc, old);
+    ReleaseDC(This->dlg_hwnd, hdc);
+    return sz.cx + neutron_scale(4, This->dpi_x);
+}
+
+static void neutron_free_crumbs(FileDialogImpl *This)
+{
+    UINT i;
+    for (i = 0; i < This->crumb_count; i++) CoTaskMemFree(This->crumbs[i]);
+    free(This->crumbs);
+    This->crumbs = NULL;
+    This->crumb_count = 0;
+}
+
+/* Rebuild the breadcrumb from psi_folder: the folder and its filesystem ancestors, stopping
+ * at the first virtual parent (My Computer, the namespace root), so a path reads
+ * "Z: > Footage > A-Roll" rather than "Desktop > My Computer > Z: > Footage > A-Roll". */
+static void neutron_update_crumbs(FileDialogImpl *This)
+{
+    IShellItem *item, *parent, *grandparent;
+    LPWSTR names[64];
+    UINT count = 0, i;
+
+    neutron_free_crumbs(This);
+    if (!This->psi_folder) return;
+
+    item = This->psi_folder;
+    IShellItem_AddRef(item);
+    while (item && count < ARRAY_SIZE(names))
+    {
+        SFGAOF attrs = 0;
+        LPWSTR name = NULL;
+
+        if (FAILED(IShellItem_GetDisplayName(item, SIGDN_NORMALDISPLAY, &name)) || !name)
+            break;
+        /* a drive with no label is named "(Z:)"; the breadcrumb shows it as "Z:" */
+        {
+            int len = lstrlenW(name);
+            if (len >= 4 && name[len - 1] == ')' && name[len - 2] == ':' && name[len - 4] == '(')
+            {
+                name[len - 1] = 0;
+                memmove(name, name + len - 3, 3 * sizeof(WCHAR));
+            }
+        }
+        names[count++] = name;
+
+        if (FAILED(IShellItem_GetParent(item, &parent))) parent = NULL;
+        IShellItem_Release(item);
+        item = parent;
+        if (!item) break;
+
+        /* stop at a virtual parent, and do not list the namespace root itself */
+        if (FAILED(IShellItem_GetAttributes(item, SFGAO_FILESYSTEM, &attrs)) ||
+            !(attrs & SFGAO_FILESYSTEM) ||
+            FAILED(IShellItem_GetParent(item, &grandparent)))
+        {
+            IShellItem_Release(item);
+            item = NULL;
+            break;
+        }
+        IShellItem_Release(grandparent);
+    }
+    if (item) IShellItem_Release(item);
+
+    if (!count) return;
+    if (!(This->crumbs = malloc(count * sizeof(*This->crumbs))))
+    {
+        for (i = 0; i < count; i++) CoTaskMemFree(names[i]);
+        return;
+    }
+    for (i = 0; i < count; i++) This->crumbs[i] = names[count - 1 - i];
+    This->crumb_count = count;
+    TRACE("neutron: %u crumbs, current %s\n", count, debugstr_w(This->crumbs[count - 1]));
+}
+
+static void neutron_paint_crumbs(FileDialogImpl *This, HDC hdc)
+{
+    static const WCHAR sepW[] = L" \x203a ";      /* " > " */
+    static const WCHAR ellW[] = L"\x2026";        /* "..." */
+    HFONT font = (HFONT)SendMessageW(This->dlg_hwnd, WM_GETFONT, 0, 0), old_font = NULL;
+    int widths[64], total = 0, avail, x, y, old_mode;
+    SIZE sz, sep_sz, ell_sz;
+    UINT i, first = 0, last;
+
+    TRACE("neutron: painting %u crumbs in %s\n", This->crumb_count, wine_dbgstr_rect(&This->rc_crumbs));
+    if (!This->crumb_count) return;
+    last = This->crumb_count - 1;
+
+    if (font) old_font = SelectObject(hdc, font);
+    old_mode = SetBkMode(hdc, TRANSPARENT);
+    GetTextExtentPoint32W(hdc, sepW, 3, &sep_sz);
+    GetTextExtentPoint32W(hdc, ellW, 1, &ell_sz);
+
+    for (i = 0; i <= last; i++)
+    {
+        GetTextExtentPoint32W(hdc, This->crumbs[i], lstrlenW(This->crumbs[i]), &sz);
+        widths[i] = sz.cx;
+        total += sz.cx + (i ? sep_sz.cx : 0);
+    }
+
+    /* too long: drop leading segments behind an ellipsis, keep the current folder */
+    avail = This->rc_crumbs.right - This->rc_crumbs.left;
+    while (first < last && total + ell_sz.cx + sep_sz.cx > avail)
+    {
+        total -= widths[first] + sep_sz.cx;
+        first++;
+    }
+
+    x = This->rc_crumbs.left;
+    y = (This->rc_crumbs.top + This->rc_crumbs.bottom - sep_sz.cy) / 2;
+    SetTextColor(hdc, NEUTRON_CRUMB_DIM);
+    if (first)
+    {
+        TextOutW(hdc, x, y, ellW, 1);
+        x += ell_sz.cx;
+        TextOutW(hdc, x, y, sepW, 3);
+        x += sep_sz.cx;
+    }
+    for (i = first; i <= last; i++)
+    {
+        SetTextColor(hdc, i == last ? NEUTRON_CRUMB_CURRENT : NEUTRON_CRUMB_DIM);
+        TextOutW(hdc, x, y, This->crumbs[i], lstrlenW(This->crumbs[i]));
+        x += widths[i];
+        if (i < last)
+        {
+            SetTextColor(hdc, NEUTRON_CRUMB_DIM);
+            TextOutW(hdc, x, y, sepW, 3);
+            x += sep_sz.cx;
+        }
+    }
+
+    SetBkMode(hdc, old_mode);
+    if (old_font) SelectObject(hdc, old_font);
+}
+
+static void neutron_draw_button(FileDialogImpl *This, const DRAWITEMSTRUCT *dis)
+{
+    BOOL accent = dis->CtlID == IDOK;
+    BOOL hot = GetPropW(dis->hwndItem, L"neutron_hot") != NULL;
+    BOOL pressed = (dis->itemState & ODS_SELECTED) != 0;
+    COLORREF fill, border, text;
+    WCHAR label[256];
+    RECT rc = dis->rcItem;
+    UINT flags = DT_CENTER | DT_VCENTER | DT_SINGLELINE;
+    HFONT old_font = NULL;
+
+    if (accent)
+    {
+        fill = pressed ? NEUTRON_ACCENT_PRESSED : hot ? NEUTRON_ACCENT_HOT : NEUTRON_ACCENT;
+        border = (dis->itemState & ODS_FOCUS) ? RGB(0x9c, 0xcc, 0xff) : fill;
+        text = NEUTRON_ACCENT_TEXT;
+    }
+    else
+    {
+        fill = pressed ? NEUTRON_BTN_PRESSED : hot ? NEUTRON_BTN_HOT : NEUTRON_BTN_FILL;
+        border = (dis->itemState & ODS_FOCUS) ? NEUTRON_FIELD_FOCUS : NEUTRON_BTN_BORDER;
+        text = NEUTRON_BTN_TEXT;
+    }
+    if (dis->itemState & ODS_DISABLED) text = NEUTRON_SECTION_TEXT;
+
+    /* the button erased itself with WM_CTLCOLORBTN (our ground brush), so the pixels outside
+     * the rounded corners are already the dialog ground */
+    neutron_round_rect(dis->hDC, &rc, fill, border, neutron_scale(NEUTRON_BTN_RADIUS, This->dpi_x));
+
+    if (accent && This->hfont_accent) old_font = SelectObject(dis->hDC, This->hfont_accent);
+    /* no mnemonic underline (the mockup shows none; Alt+letter still works): drop the '&'
+     * from the local copy rather than trusting DT_HIDEPREFIX */
+    {
+        WCHAR raw[256];
+        unsigned int i, j = 0;
+        GetWindowTextW(dis->hwndItem, raw, ARRAY_SIZE(raw));
+        for (i = 0; raw[i] && j < ARRAY_SIZE(label) - 1; i++)
+        {
+            if (raw[i] == '&' && raw[i + 1] != '&') continue;
+            if (raw[i] == '&') i++;
+            label[j++] = raw[i];
+        }
+        label[j] = 0;
+    }
+    SetBkMode(dis->hDC, TRANSPARENT);
+    SetTextColor(dis->hDC, text);
+    DrawTextW(dis->hDC, label, -1, &rc, flags);
+    if (old_font) SelectObject(dis->hDC, old_font);
+}
+
+/* text of the filter combo's current selection, for both paint paths */
+static void neutron_combo_text(HWND combo, int index, WCHAR *buf, int len)
+{
+    buf[0] = 0;
+    if (index == CB_ERR) return;
+    if (SendMessageW(combo, CB_GETLBTEXTLEN, index, 0) >= len) return;
+    SendMessageW(combo, CB_GETLBTEXT, index, (LPARAM)buf);
+}
+
+/* the field portion and the dropdown items of the (CBS_OWNERDRAWFIXED) filter combo */
+static void neutron_draw_combo_item(FileDialogImpl *This, const DRAWITEMSTRUCT *dis)
+{
+    BOOL field = (dis->itemState & ODS_COMBOBOXEDIT) != 0;
+    RECT rc = dis->rcItem;
+    WCHAR text[256];
+    HBRUSH brush;
+
+    brush = CreateSolidBrush(!field && (dis->itemState & ODS_SELECTED) ? NEUTRON_BTN_HOT
+                                                                      : NEUTRON_FIELD_FILL);
+    FillRect(dis->hDC, &rc, brush);
+    DeleteObject(brush);
+
+    neutron_combo_text(dis->hwndItem, dis->itemID == (UINT)-1 ? CB_ERR : (int)dis->itemID,
+                       text, ARRAY_SIZE(text));
+    if (field)
+    {
+        /* same geometry as the subclass's WM_PAINT so the two never disagree by a pixel */
+        GetClientRect(dis->hwndItem, &rc);
+        rc.right -= neutron_scale(28, This->dpi_x);
+    }
+    rc.left += neutron_scale(8, This->dpi_x);
+    SetBkMode(dis->hDC, TRANSPARENT);
+    SetTextColor(dis->hDC, field ? NEUTRON_FIELD_DIMTEXT : NEUTRON_FIELD_TEXT);
+    DrawTextW(dis->hDC, text, -1, &rc,
+              DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS | DT_NOPREFIX);
+}
+
+/* Push buttons are BS_OWNERDRAW so every paint path (WM_PAINT and comctl32's direct
+ * paint_button() on state changes) reaches WM_DRAWITEM. This subclass keeps the dialog
+ * manager's view of them identical to a push button's. */
+static LRESULT CALLBACK neutron_button_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    WNDPROC oldproc = (WNDPROC)GetPropW(hwnd, L"neutron_oldproc");
+
+    switch (msg)
+    {
+    case WM_GETDLGCODE:
+        return DLGC_BUTTON | (GetPropW(hwnd, L"neutron_def") ? DLGC_DEFPUSHBUTTON
+                                                              : DLGC_UNDEFPUSHBUTTON);
+    case BM_SETSTYLE:
+        /* DEFDLG_SetDefButton marks the default button by rewriting its style. Remember the
+         * request and stay owner-drawn, or the classic bevel comes back on the next focus
+         * move. */
+        if ((wparam & BS_TYPEMASK) == BS_DEFPUSHBUTTON || (wparam & BS_TYPEMASK) == BS_PUSHBUTTON)
+        {
+            SetPropW(hwnd, L"neutron_def",
+                     (HANDLE)(ULONG_PTR)((wparam & BS_TYPEMASK) == BS_DEFPUSHBUTTON));
+            if (LOWORD(lparam)) InvalidateRect(hwnd, NULL, FALSE);
+            return 0;
+        }
+        break;
+    case WM_LBUTTONDBLCLK:
+        /* an owner-drawn button reports BN_DOUBLECLICKED; a push button presses again */
+        return CallWindowProcW(oldproc, hwnd, WM_LBUTTONDOWN, wparam, lparam);
+    case WM_MOUSEMOVE:
+        if (!GetPropW(hwnd, L"neutron_hot"))
+        {
+            TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, hwnd, 0 };
+            SetPropW(hwnd, L"neutron_hot", (HANDLE)1);
+            TrackMouseEvent(&tme);
+            InvalidateRect(hwnd, NULL, FALSE);
+        }
+        break;
+    case WM_MOUSELEAVE:
+        RemovePropW(hwnd, L"neutron_hot");
+        InvalidateRect(hwnd, NULL, FALSE);
+        break;
+    case WM_NCDESTROY:
+        SetWindowLongPtrW(hwnd, GWLP_WNDPROC, (LONG_PTR)oldproc);
+        RemovePropW(hwnd, L"neutron_oldproc");
+        RemovePropW(hwnd, L"neutron_def");
+        RemovePropW(hwnd, L"neutron_hot");
+        RemovePropW(hwnd, L"itemdlg_This");
+        break;
+    }
+    return CallWindowProcW(oldproc, hwnd, msg, wparam, lparam);
+}
+
+/* The filter combo: frame, text and glyph are ours. comctl32's combo also repaints its
+ * arrow button and text field directly (CBRepaintButton / CBPaintText), so the messages that
+ * trigger those are followed by an immediate overdraw. */
+static LRESULT CALLBACK neutron_combo_proc(HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam)
+{
+    WNDPROC oldproc = (WNDPROC)GetPropW(hwnd, L"neutron_oldproc");
+    FileDialogImpl *This = GetPropW(hwnd, L"itemdlg_This");
+    LRESULT ret;
+
+    switch (msg)
+    {
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        HDC hdc = BeginPaint(hwnd, &ps);
+        HFONT font = (HFONT)SendMessageW(hwnd, WM_GETFONT, 0, 0), old_font = NULL;
+        WCHAR text[256];
+        RECT rc, rc_text;
+        int dpi = This ? This->dpi_x : neutron_window_dpi(hwnd);
+
+        GetClientRect(hwnd, &rc);
+        neutron_round_rect(hdc, &rc, NEUTRON_FIELD_FILL,
+                           GetFocus() == hwnd ? NEUTRON_FIELD_FOCUS : NEUTRON_FIELD_BORDER,
+                           neutron_scale(NEUTRON_FIELD_RADIUS, dpi));
+
+        neutron_combo_text(hwnd, SendMessageW(hwnd, CB_GETCURSEL, 0, 0), text, ARRAY_SIZE(text));
+        rc_text = rc;
+        rc_text.left += neutron_scale(8, dpi);
+        rc_text.right -= neutron_scale(28, dpi);
+        if (font) old_font = SelectObject(hdc, font);
+        SetBkMode(hdc, TRANSPARENT);
+        SetTextColor(hdc, NEUTRON_FIELD_DIMTEXT);
+        DrawTextW(hdc, text, -1, &rc_text,
+                  DT_LEFT | DT_VCENTER | DT_SINGLELINE | DT_END_ELLIPSIS | DT_NOPREFIX);
+        if (old_font) SelectObject(hdc, old_font);
+
+        neutron_chevron(hdc, rc.right - neutron_scale(14, dpi), (rc.top + rc.bottom) / 2,
+                        neutron_scale(3, dpi), neutron_scale(1, dpi), TRUE, NEUTRON_FIELD_GLYPH);
+        EndPaint(hwnd, &ps);
+        return 0;
+    }
+    case WM_ERASEBKGND:
+        return 1;
+    case WM_NCDESTROY:
+        SetWindowLongPtrW(hwnd, GWLP_WNDPROC, (LONG_PTR)oldproc);
+        RemovePropW(hwnd, L"neutron_oldproc");
+        RemovePropW(hwnd, L"itemdlg_This");
+        break;
+    case WM_LBUTTONDOWN:
+    case WM_LBUTTONUP:
+    case WM_LBUTTONDBLCLK:
+    case WM_KEYDOWN:
+    case WM_SYSKEYDOWN:
+    case WM_CHAR:
+    case WM_MOUSEWHEEL:
+    case WM_SETFOCUS:
+    case WM_KILLFOCUS:
+    case WM_CAPTURECHANGED:
+    case WM_COMMAND:
+    case CB_SETCURSEL:
+    case CB_SHOWDROPDOWN:
+        ret = CallWindowProcW(oldproc, hwnd, msg, wparam, lparam);
+        if (IsWindow(hwnd))
+            RedrawWindow(hwnd, NULL, NULL, RDW_INVALIDATE | RDW_UPDATENOW | RDW_NOERASE);
+        return ret;
+    }
+    return CallWindowProcW(oldproc, hwnd, msg, wparam, lparam);
+}
+
+static void neutron_ownerdraw_button(FileDialogImpl *This, int id, BOOL is_default)
+{
+    HWND hwnd = GetDlgItem(This->dlg_hwnd, id);
+    LONG style;
+
+    if (!hwnd) return;
+    style = GetWindowLongW(hwnd, GWL_STYLE);
+    SetWindowLongW(hwnd, GWL_STYLE, (style & ~BS_TYPEMASK) | BS_OWNERDRAW);
+    SetPropW(hwnd, L"neutron_def", (HANDLE)(ULONG_PTR)is_default);
+    SetPropW(hwnd, L"itemdlg_This", This);
+    SetPropW(hwnd, L"neutron_oldproc",
+             (HANDLE)SetWindowLongPtrW(hwnd, GWLP_WNDPROC, (LONG_PTR)neutron_button_proc));
+}
+
+/* called once from WM_INITDIALOG, after the template's controls exist */
+static void neutron_init_frame(FileDialogImpl *This)
+{
+    HWND hwnd;
+    HFONT font;
+    LOGFONTW lf;
+    int text_h = neutron_text_height(This);
+
+    This->hbr_ground = CreateSolidBrush(NEUTRON_DLG_GROUND);
+    This->hbr_field = CreateSolidBrush(NEUTRON_FIELD_FILL);
+
+    font = (HFONT)SendMessageW(This->dlg_hwnd, WM_GETFONT, 0, 0);
+    if (font && GetObjectW(font, sizeof(lf), &lf))
+    {
+        lf.lfWeight = FW_MEDIUM;   /* the mockup's 500; a synthesized bold reads as a smudge */
+        This->hfont_accent = CreateFontIndirectW(&lf);
+    }
+
+    /* the filename edit loses its sunken frame; the dialog paints a rounded field around it */
+    if ((hwnd = GetDlgItem(This->dlg_hwnd, IDC_FILENAME)))
+    {
+        SetWindowLongW(hwnd, GWL_STYLE, GetWindowLongW(hwnd, GWL_STYLE) & ~WS_BORDER);
+        SetWindowLongW(hwnd, GWL_EXSTYLE,
+                       GetWindowLongW(hwnd, GWL_EXSTYLE) & ~(WS_EX_CLIENTEDGE | WS_EX_STATICEDGE));
+        SetWindowPos(hwnd, NULL, 0, 0, 0, 0,
+                     SWP_NOMOVE | SWP_NOSIZE | SWP_NOZORDER | SWP_NOACTIVATE | SWP_FRAMECHANGED);
+    }
+
+    neutron_ownerdraw_button(This, IDOK, TRUE);
+    neutron_ownerdraw_button(This, IDCANCEL, FALSE);
+
+    if ((hwnd = GetDlgItem(This->dlg_hwnd, IDC_FILETYPE)))
+    {
+        /* CBS_OWNERDRAWFIXED (template): the field height is ours to set */
+        SendMessageW(hwnd, CB_SETITEMHEIGHT, (WPARAM)-1, text_h + 2 * neutron_scale(3, This->dpi_y));
+        SendMessageW(hwnd, CB_SETITEMHEIGHT, 0, text_h + 2 * neutron_scale(4, This->dpi_y));
+        SetPropW(hwnd, L"itemdlg_This", This);
+        SetPropW(hwnd, L"neutron_oldproc",
+                 (HANDLE)SetWindowLongPtrW(hwnd, GWLP_WNDPROC, (LONG_PTR)neutron_combo_proc));
+    }
+}
+
+static void neutron_destroy_frame(FileDialogImpl *This)
+{
+    neutron_free_crumbs(This);
+    if (This->hbr_ground) DeleteObject(This->hbr_ground);
+    if (This->hbr_field) DeleteObject(This->hbr_field);
+    if (This->hfont_accent) DeleteObject(This->hfont_accent);
+    This->hbr_ground = This->hbr_field = NULL;
+    This->hfont_accent = NULL;
+}
+
+static LRESULT on_wm_erasebkgnd(FileDialogImpl *This, HDC hdc)
+{
+    RECT rc;
+
+    /* also reached from the (TBSTYLE_TRANSPARENT) toolbar with a shifted origin, so fill
+     * the clip box rather than our client rect */
+    GetClipBox(hdc, &rc);
+    FillRect(hdc, &rc, This->hbr_ground);
+    SetWindowLongPtrW(This->dlg_hwnd, DWLP_MSGRESULT, 1);
+    return TRUE;
+}
+
+static LRESULT on_wm_paint(FileDialogImpl *This)
+{
+    PAINTSTRUCT ps;
+    HDC hdc = BeginPaint(This->dlg_hwnd, &ps);
+    RECT rc;
+
+    GetClientRect(This->dlg_hwnd, &rc);
+    neutron_hrule(hdc, 0, rc.right, This->rc_navband.bottom - 1, NEUTRON_NAV_RULE);
+    neutron_paint_crumbs(This, hdc);
+
+    if (!IsRectEmpty(&This->rc_filename_frame))
+    {
+        HWND edit = GetDlgItem(This->dlg_hwnd, IDC_FILENAME);
+        neutron_round_rect(hdc, &This->rc_filename_frame, NEUTRON_FIELD_FILL,
+                           (edit && GetFocus() == edit) ? NEUTRON_FIELD_FOCUS : NEUTRON_FIELD_BORDER,
+                           neutron_scale(NEUTRON_FIELD_RADIUS, This->dpi_x));
+    }
+
+    EndPaint(This->dlg_hwnd, &ps);
+    return TRUE;
+}
+
+static LRESULT on_wm_drawitem(FileDialogImpl *This, const DRAWITEMSTRUCT *dis)
+{
+    if (dis->CtlType == ODT_BUTTON && (dis->CtlID == IDOK || dis->CtlID == IDCANCEL))
+        neutron_draw_button(This, dis);
+    else if (dis->CtlType == ODT_COMBOBOX && dis->CtlID == IDC_FILETYPE)
+        neutron_draw_combo_item(This, dis);
+    else
+        return FALSE;
+
+    SetWindowLongPtrW(This->dlg_hwnd, DWLP_MSGRESULT, TRUE);
+    return TRUE;
+}
+
+/* nav toolbar: round hover/pressed fill, no edges, no offset */
+static LRESULT on_wm_notify(FileDialogImpl *This, LPARAM lparam)
+{
+    const NMHDR *hdr = (const NMHDR *)lparam;
+    NMTBCUSTOMDRAW *cd = (NMTBCUSTOMDRAW *)lparam;
+    LRESULT ret = CDRF_DODEFAULT;
+
+    if (hdr->idFrom != IDC_NAV_TOOLBAR || hdr->code != NM_CUSTOMDRAW)
+        return FALSE;
+
+    switch (cd->nmcd.dwDrawStage)
+    {
+    case CDDS_PREPAINT:
+        ret = CDRF_NOTIFYITEMDRAW;
+        break;
+    case CDDS_ITEMPREPAINT:
+        if (cd->nmcd.uItemState & (CDIS_HOT | CDIS_SELECTED | CDIS_CHECKED))
+        {
+            RECT rc = cd->nmcd.rc;
+            neutron_round_rect(cd->nmcd.hdc, &rc,
+                               (cd->nmcd.uItemState & CDIS_SELECTED) ? NEUTRON_NAV_PRESSED
+                                                                     : NEUTRON_NAV_HOT,
+                               CLR_NONE, neutron_scale(4, This->dpi_x));
+        }
+        ret = CDRF_DODEFAULT | TBCDRF_NOEDGES | TBCDRF_NOBACKGROUND | TBCDRF_NOOFFSET |
+              TBCDRF_NOMARK | TBCDRF_NOETCHEDEFFECT;
+        break;
+    }
+    SetWindowLongPtrW(This->dlg_hwnd, DWLP_MSGRESULT, ret);
+    return TRUE;
+}
