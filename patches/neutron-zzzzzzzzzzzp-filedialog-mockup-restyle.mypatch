 /**********************************************************
+* ShellView_FitNameColumn()
+*
+* NEUTRON: in details view the name column takes whatever width the other columns leave, so
+* the list has no dead area past the last column and no horizontal scrollbar for the
+* default set. Width only; nothing about the items changes.
+*/
+static int GetDeviceCaps_dpi(HWND hwnd)
+{
+    return neutron_window_dpi(hwnd);
+}
+
+static void ShellView_FitNameColumn(IShellViewImpl *This)
+{
+    RECT rc;
+    int i, used = 0, width, min_width;
+
+    if (!This->hWndList || This->columns < 2) return;
+    if ((GetWindowLongW(This->hWndList, GWL_STYLE) & LVS_TYPEMASK) != LVS_REPORT) return;
+
+    GetClientRect(This->hWndList, &rc);
+    for (i = 1; i < This->columns; i++)
+        used += (int)SendMessageW(This->hWndList, LVM_GETCOLUMNWIDTH, i, 0);
+    min_width = MulDiv(120, GetDeviceCaps_dpi(This->hWndList), USER_DEFAULT_SCREEN_DPI);
+    width = max(rc.right - rc.left - used, min_width);
+    if (width != (int)SendMessageW(This->hWndList, LVM_GETCOLUMNWIDTH, 0, 0))
+        SendMessageW(This->hWndList, LVM_SETCOLUMNWIDTH, 0, width);
+}
+
+/**********************************************************
 * ShellView_InitList()
 *
 * - adds all needed columns to the shellview
@@ -469,6 +511,8 @@
 
