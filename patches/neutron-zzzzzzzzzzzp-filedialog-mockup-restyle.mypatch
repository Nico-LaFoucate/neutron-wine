 #define IDS_RECYCLEBIN_FOLDER_NAME   8964
 
+/* NEUTRON: section label above the folder tree in the ExplorerBrowser pane */
+#define IDS_NEUTRON_PLACES           4200
+
 /* Properties dialog */
 #define IDD_FILE_PROPERTIES        8
 #define IDD_FOLDER_PROPERTIES      9
--- a/include/wine/neutronui.h
+++ b/include/wine/neutronui.h
@@ -0,0 +1,196 @@
+/*
+ * NEUTRON: the fixed palette and shared drawing helpers for the surfaces Neutron restyles
+ * (the Common Item Dialog frame in comdlg32, the ExplorerBrowser panels in shell32, the
+ * namespace tree in explorerframe, and the opt-in "shell" looks in comctl32's listview,
+ * treeview and header).
+ *
+ * WHY A FIXED PALETTE AND NOT GetSysColor. Two independent theming systems exist in every
+ * prefix: the classic Control Panel\Colors palette (which the Neutron theme drives) and the
+ * visual style (which upstream wine.inf turns on and which paints comctl32 v6 controls from
+ * Aero's own light colour table). Deriving these surfaces from either one made the dialog's
+ * look depend on prefix state, and a restyle that darkens the global button palette makes the
+ * Adobe apps' own labels unreadable (Lightroom's About box went black on black -- see
+ * neutron-zzzzzzzzzq-frame-border-palette). So these surfaces paint from THIS table, in our
+ * own code, and look the same straight after `neutron prefix provision` regardless of theme.
+ *
+ * The values are the approved mockup's (itemdlg.html, .dlg CSS block), verbatim. Keep them
+ * in one place: the hover colour drifting between three controls is exactly the failure
+ * COMCTL32_HoverColor() was written to stop.
+ *
+ * Everything here is header-only so comdlg32, shell32, explorerframe and comctl32 (both
+ * versions) share it without a new import.
+ */
+
+#ifndef __WINE_NEUTRONUI_H
+#define __WINE_NEUTRONUI_H
+
+#include "windef.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "commctrl.h"   /* CLR_NONE */
+
+/* dialog frame */
+#define NEUTRON_DLG_GROUND      RGB(0x23, 0x23, 0x23)   /* dialog client background        */
+#define NEUTRON_NAV_RULE        RGB(0x31, 0x31, 0x31)   /* 1px rule under the nav band     */
+#define NEUTRON_NAV_HOT         RGB(0x33, 0x33, 0x33)   /* nav button hover/pressed fill   */
+#define NEUTRON_NAV_PRESSED     RGB(0x3b, 0x3b, 0x3b)
+#define NEUTRON_CRUMB_DIM       RGB(0x9a, 0xa0, 0xa6)   /* breadcrumb ancestors + separators */
+#define NEUTRON_CRUMB_CURRENT   RGB(0xdc, 0xdc, 0xdc)   /* breadcrumb current folder       */
+#define NEUTRON_LABEL_TEXT      RGB(0xb4, 0xb4, 0xb4)   /* "File name:" style labels       */
+
+/* panels (tree and list) */
+#define NEUTRON_PANEL_FILL      RGB(0x1e, 0x1e, 0x1e)
+#define NEUTRON_PANEL_BORDER    RGB(0x30, 0x30, 0x30)
+#define NEUTRON_PANEL_RADIUS    4                       /* logical px                       */
+#define NEUTRON_SECTION_TEXT    RGB(0x7b, 0x7b, 0x7b)   /* "PLACES" style section labels   */
+
+/* tree rows */
+#define NEUTRON_TREE_TEXT       RGB(0xcf, 0xcf, 0xcf)
+#define NEUTRON_TREE_SELECTED   RGB(0x2f, 0x2f, 0x2f)
+#define NEUTRON_TREE_SELTEXT    RGB(0xff, 0xff, 0xff)
+#define NEUTRON_TREE_HOVER      RGB(0x27, 0x27, 0x27)
+#define NEUTRON_CHEVRON         RGB(0x8a, 0x8a, 0x8a)
+#define NEUTRON_CHEVRON_OPEN    RGB(0xc8, 0xc8, 0xc8)
+
+/* column header */
+#define NEUTRON_HEADER_TEXT     RGB(0x7f, 0x7f, 0x7f)
+#define NEUTRON_HEADER_HOT      RGB(0xa8, 0xa8, 0xa8)
+#define NEUTRON_HEADER_RULE     RGB(0x2c, 0x2c, 0x2c)
+
+/* list rows */
+#define NEUTRON_LIST_TEXT       RGB(0xdc, 0xdc, 0xdc)
+#define NEUTRON_LIST_DIM        RGB(0xa3, 0xa3, 0xa3)   /* Size / Type / Modified columns  */
+#define NEUTRON_LIST_SELECTED   RGB(0x30, 0x96, 0xfa)
+#define NEUTRON_LIST_SELTEXT    RGB(0xff, 0xff, 0xff)
+#define NEUTRON_LIST_SELDIM     RGB(0xd8, 0xe9, 0xfd)
+#define NEUTRON_LIST_HOVER      RGB(0x29, 0x29, 0x29)
+#define NEUTRON_ROW_RADIUS      3                       /* logical px                       */
+#define NEUTRON_ROW_INSET       4                       /* logical px, from the panel edge  */
+
+/* fields (filename edit, filter combo) */
+#define NEUTRON_FIELD_FILL      RGB(0x17, 0x17, 0x17)
+#define NEUTRON_FIELD_BORDER    RGB(0x3a, 0x3a, 0x3a)
+#define NEUTRON_FIELD_FOCUS     RGB(0x5a, 0x5a, 0x5a)
+#define NEUTRON_FIELD_TEXT      RGB(0xe6, 0xe6, 0xe6)
+#define NEUTRON_FIELD_DIMTEXT   RGB(0xcf, 0xcf, 0xcf)
+#define NEUTRON_FIELD_GLYPH     RGB(0xb9, 0xbe, 0xc4)
+#define NEUTRON_FIELD_RADIUS    4
+
+/* buttons */
+#define NEUTRON_BTN_FILL        RGB(0x32, 0x32, 0x32)
+#define NEUTRON_BTN_HOT         RGB(0x3a, 0x3a, 0x3a)
+#define NEUTRON_BTN_PRESSED     RGB(0x2a, 0x2a, 0x2a)
+#define NEUTRON_BTN_BORDER      RGB(0x3f, 0x3f, 0x3f)
+#define NEUTRON_BTN_TEXT        RGB(0xe4, 0xe4, 0xe4)
+#define NEUTRON_ACCENT          RGB(0x30, 0x96, 0xfa)
+#define NEUTRON_ACCENT_HOT      RGB(0x4a, 0xa4, 0xfb)
+#define NEUTRON_ACCENT_PRESSED  RGB(0x25, 0x82, 0xe0)
+#define NEUTRON_ACCENT_TEXT     RGB(0xff, 0xff, 0xff)
+#define NEUTRON_BTN_RADIUS      4
+
+/* scale a 96-dpi logical size to the given dpi */
+static inline int neutron_scale(int px, int dpi)
+{
+    return MulDiv(px, dpi ? dpi : USER_DEFAULT_SCREEN_DPI, USER_DEFAULT_SCREEN_DPI);
+}
+
+/* DPI of the device a window is on, as the dialog code computes it */
+static inline int neutron_window_dpi(HWND hwnd)
+{
+    HDC hdc = GetDC(hwnd);
+    int dpi = hdc ? GetDeviceCaps(hdc, LOGPIXELSX) : USER_DEFAULT_SCREEN_DPI;
+    if (hdc) ReleaseDC(hwnd, hdc);
+    return dpi ? dpi : USER_DEFAULT_SCREEN_DPI;
+}
+
+/*
+ * Fill a rounded rectangle, optionally with a 1px border. `radius` and the border are in
+ * DEVICE pixels -- callers scale with neutron_scale() first. GDI's RoundRect draws the pen
+ * inside the rectangle and excludes the right/bottom edge, exactly like FillRect.
+ */
+static inline void neutron_round_rect(HDC hdc, const RECT *rc, COLORREF fill, COLORREF border,
+                                      int radius)
+{
+    HBRUSH brush = CreateSolidBrush(fill), old_brush;
+    HPEN pen = CreatePen(PS_SOLID, 1, border == CLR_NONE ? fill : border), old_pen;
+
+    old_brush = SelectObject(hdc, brush);
+    old_pen = SelectObject(hdc, pen);
+    if (radius > 0)
+        RoundRect(hdc, rc->left, rc->top, rc->right, rc->bottom, radius * 2, radius * 2);
+    else
+        Rectangle(hdc, rc->left, rc->top, rc->right, rc->bottom);
+    SelectObject(hdc, old_pen);
+    SelectObject(hdc, old_brush);
+    DeleteObject(pen);
+    DeleteObject(brush);
+}
+
+/* a 1px horizontal rule across [left, right) at row y */
+static inline void neutron_hrule(HDC hdc, int left, int right, int y, COLORREF color)
+{
+    RECT rc = { left, y, right, y + 1 };
+    HBRUSH brush = CreateSolidBrush(color);
+    FillRect(hdc, &rc, brush);
+    DeleteObject(brush);
+}
+
+/*
+ * A stroked chevron: `open` points down, otherwise right. `size` is the half-extent in
+ * device pixels, `width` the stroke width.
+ */
+static inline void neutron_chevron(HDC hdc, int cx, int cy, int size, int width, BOOL open,
+                                   COLORREF color)
+{
+    HPEN pen = CreatePen(PS_SOLID, width, color), old_pen = SelectObject(hdc, pen);
+    POINT pt[3];
+
+    if (open)
+    {
+        pt[0].x = cx - size; pt[0].y = cy - size / 2;
+        pt[1].x = cx;        pt[1].y = cy + size / 2;
+        pt[2].x = cx + size; pt[2].y = cy - size / 2;
+    }
+    else
+    {
+        pt[0].x = cx - size / 2; pt[0].y = cy - size;
+        pt[1].x = cx + size / 2; pt[1].y = cy;
+        pt[2].x = cx - size / 2; pt[2].y = cy + size;
+    }
+    Polyline(hdc, pt, 3);
+    SelectObject(hdc, old_pen);
+    DeleteObject(pen);
+}
+
+/*
+ * Uppercase, letter-spaced label -- the "PLACES" / "NAME" treatment. Draws with the DC's
+ * current font and text colour, transparent background. `spacing` is the extra tracking in
+ * device pixels. The text is uppercased into a local copy; the source is never modified.
+ */
+static inline void neutron_draw_caps(HDC hdc, const WCHAR *text, RECT *rc, UINT dt_flags,
+                                     int spacing)
+{
+    WCHAR buf[128];
+    int old_extra, old_mode;
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(buf) - 1 && text[i]; i++) buf[i] = text[i];
+    buf[i] = 0;
+    CharUpperBuffW(buf, i);
+
+    old_extra = SetTextCharacterExtra(hdc, spacing);
+    old_mode = SetBkMode(hdc, TRANSPARENT);
+    DrawTextW(hdc, buf, -1, rc, dt_flags);
+    SetBkMode(hdc, old_mode);
+    SetTextCharacterExtra(hdc, old_extra);
+}
+
+/*
+ * Private style bits by which shell32/explorerframe opt a control into the Neutron shell
+ * look. Chosen from ranges Windows leaves undefined so nothing else can set them by accident.
+ */
+#define LVS_EX_NEUTRON_SHELL    0x20000000  /* listview: rounded inset rows, dim subitems */
+#define TVS_EX_NEUTRON_SHELL    0x00001000  /* treeview: chevrons, grey selection, rounded rows */
+#define HDS_NEUTRON_SHELL       0x00008000  /* header: caps label, palette colours, no dividers */
+
+#endif /* __WINE_NEUTRONUI_H */
