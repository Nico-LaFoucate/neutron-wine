+         * index -- the subitem texts are fetched by column index -- but gets no width, so
+         * it neither takes space nor leaves a dead header past the last real column. */
+        if (This->pSF2Parent &&
+            SUCCEEDED(IShellFolder2_GetDefaultColumnState(This->pSF2Parent, This->columns, &state)) &&
+            !(state & SHCOLSTATE_ONBYDEFAULT))
+            lvColumn.cx = 0;
         StrRetToBufW(&sd.str, NULL, nameW, ARRAY_SIZE(nameW));
         SendMessageW(This->hWndList, LVM_INSERTCOLUMNW, This->columns, (LPARAM)&lvColumn);
     }
 
     if (details) IShellDetails_Release(details);
+
+    /* NEUTRON: the column header draws as quiet caps labels on the panel fill */
