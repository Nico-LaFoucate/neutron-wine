+/* NEUTRON workarea-edges: the desktop process (win32u starts it as "explorer.exe /desktop") reads each output's real
+ * work area from KWin; this thread takes KWin's later answers (wayland_workarea.c) */
+static DWORD WINAPI workarea_thread(void *arg)
+{
+    WAYLANDDRV_UNIX_CALL(workarea_run, NULL);
+    return 0;
+}
+
+static BOOL is_desktop_process(void)
+{
+    return is_explorer_process() && wcsstr(GetCommandLineW(), L" /desktop");
+}
