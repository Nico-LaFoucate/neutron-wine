+/* Neutron: kill switch NEUTRON_MFENGINE_HWND=0 restores the old behavior (rendering mode fails topology creation). */
+static BOOL neutron_mfengine_hwnd_enabled(void)
+{
+    static LONG cached = -1;
+    char buf[8];
+    DWORD len;
+    LONG value = cached;
+
+    if (value < 0)
+    {
+        len = GetEnvironmentVariableA("NEUTRON_MFENGINE_HWND", buf, sizeof(buf));
+        value = !(len && len < sizeof(buf) && buf[0] == '0');
+        if (InterlockedCompareExchange(&cached, value, -1) == -1)
+            ERR("neutron-gateresolved: NEUTRON_MFENGINE_HWND = %ld\n", value);
+    }
+    return value;
+}
+
+struct render_params
+{
+    SIZE size;
+    BOOL has_src, has_dst, has_border;
+    MFVideoNormalizedRect src;
+    RECT dst;
+    MFARGB border;
+};
+
+/* Paints one RGB32 frame into the playback window: the source rectangle is scaled into the destination
+ * rectangle (default: the whole client area) keeping its aspect ratio; with a border color the rest of
+ * the destination rectangle is filled with it. */
+static void media_engine_render_paint(HWND hwnd, IMFSample *sample, const struct render_params *params)
+{
+    LONG pitch = 0, width = params->size.cx, height = params->size.cy, rows;
+    RECT client, dst, src, image;
+    IMFMediaBuffer *buffer;
+    IMF2DBuffer *buffer2d = NULL;
+    DWORD max_length, length = 0;
+    BYTE *data = NULL, *bits;
+    BITMAPINFO bmi;
+    double scale_x, scale_y, scale;
+    LONG src_w, src_h, img_w, img_h;
+    HDC dc;
+
+    if (width <= 0 || height <= 0)
+        return;
+    if (FAILED(IMFSample_ConvertToContiguousBuffer(sample, &buffer)))
+        return;
+
+    if (SUCCEEDED(IMFMediaBuffer_QueryInterface(buffer, &IID_IMF2DBuffer, (void **)&buffer2d)))
+    {
+        if (FAILED(IMF2DBuffer_Lock2D(buffer2d, &data, &pitch)))
+        {
+            IMF2DBuffer_Release(buffer2d);
+            buffer2d = NULL;
+            data = NULL;
+        }
+    }
+    if (!buffer2d)
+    {
+        if (FAILED(IMFMediaBuffer_Lock(buffer, &data, &max_length, &length)))
+        {
+            IMFMediaBuffer_Release(buffer);
+            return;
+        }
+        pitch = width * 4;
+        if (length < (DWORD)(width * height * 4))
+        {
+            WARN("Unexpected buffer length %lu for %ldx%ld.\n", length, width, height);
+            goto done;
+        }
+    }
+    if (!pitch || (pitch > 0 ? pitch : -pitch) < width * 4)
+        goto done;
+
+    src.left = 0;
+    src.top = 0;
+    src.right = width;
+    src.bottom = height;
+    if (params->has_src)
+    {
+        src.left = max(0, min(width, (LONG)(params->src.left * width + 0.5f)));
+        src.top = max(0, min(height, (LONG)(params->src.top * height + 0.5f)));
+        src.right = max(src.left, min(width, (LONG)(params->src.right * width + 0.5f)));
+        src.bottom = max(src.top, min(height, (LONG)(params->src.bottom * height + 0.5f)));
+    }
+    src_w = src.right - src.left;
+    src_h = src.bottom - src.top;
+    rows = src_h;
+
+    if (!GetClientRect(hwnd, &client))
+        goto done;
+    dst = params->has_dst ? params->dst : client;
+    if (dst.right <= dst.left || dst.bottom <= dst.top || !src_w || !src_h)
+        goto done;
+
+    /* Letterbox: fit the source into the destination, keeping the frame's aspect ratio. */
+    scale_x = (double)(dst.right - dst.left) / src_w;
+    scale_y = (double)(dst.bottom - dst.top) / src_h;
+    scale = min(scale_x, scale_y);
+    img_w = max(1, (LONG)(src_w * scale + 0.5));
+    img_h = max(1, (LONG)(src_h * scale + 0.5));
+    image.left = dst.left + (dst.right - dst.left - img_w) / 2;
+    image.top = dst.top + (dst.bottom - dst.top - img_h) / 2;
+    image.right = image.left + img_w;
+    image.bottom = image.top + img_h;
+
+    /* Rows run top-down for a positive pitch; Lock2D returns scanline 0 with a negative pitch for bottom-up. */
+    memset(&bmi, 0, sizeof(bmi));
+    bmi.bmiHeader.biSize = sizeof(bmi.bmiHeader);
+    bmi.bmiHeader.biPlanes = 1;
+    bmi.bmiHeader.biBitCount = 32;
+    bmi.bmiHeader.biCompression = BI_RGB;
+    if (pitch > 0)
+    {
+        bits = data + src.top * pitch;
+        bmi.bmiHeader.biWidth = pitch / 4;
+        bmi.bmiHeader.biHeight = -rows;
+    }
+    else
+    {
+        bits = data + (src.top + rows - 1) * pitch;
+        bmi.bmiHeader.biWidth = -pitch / 4;
+        bmi.bmiHeader.biHeight = rows;
+    }
+
+    if (!(dc = GetDC(hwnd)))
+        goto done;
+    if (params->has_border)
+    {
+        HBRUSH brush = CreateSolidBrush(RGB(params->border.rgbRed, params->border.rgbGreen, params->border.rgbBlue));
+        HRGN rgn = CreateRectRgnIndirect(&dst), img_rgn = CreateRectRgnIndirect(&image);
+
+        CombineRgn(rgn, rgn, img_rgn, RGN_DIFF);
+        FillRgn(dc, rgn, brush);
+        DeleteObject(img_rgn);
+        DeleteObject(rgn);
+        DeleteObject(brush);
+    }
+    SetStretchBltMode(dc, HALFTONE);
+    SetBrushOrgEx(dc, 0, 0, NULL);
+    StretchDIBits(dc, image.left, image.top, img_w, img_h, src.left, 0, src_w, rows,
+            bits, &bmi, DIB_RGB_COLORS, SRCCOPY);
+    ReleaseDC(hwnd, dc);
+
+done:
+    if (buffer2d)
+    {
+        IMF2DBuffer_Unlock2D(buffer2d);
+        IMF2DBuffer_Release(buffer2d);
+    }
+    else
+        IMFMediaBuffer_Unlock(buffer);
+    IMFMediaBuffer_Release(buffer);
+}
+
+/* Rendering mode presenter: shows each frame when the presentation clock reaches its time, and the current
+ * frame again on UpdateVideoStream(). */
+static DWORD CALLBACK media_engine_render_thread(void *arg)
+{
+    struct media_engine *engine = arg;
+    struct render_params params;
+    IMFSample *sample;
+    MFTIME clocktime;
+    LONGLONG pts;
+    BOOL playing;
+    HWND hwnd;
+
+    SetThreadDescription(GetCurrentThread(), L"wine_mfmediaengine_render");
+
+    for (;;)
+    {
+        EnterCriticalSection(&engine->cs);
+        playing = !(engine->flags & (FLAGS_ENGINE_PAUSED | FLAGS_ENGINE_SHUT_DOWN));
+        LeaveCriticalSection(&engine->cs);
+
+        WaitForSingleObject(engine->render.wake, playing ? 5 : 100);
+
+        sample = NULL;
+        EnterCriticalSection(&engine->cs);
+        if (engine->render.stop)
+        {
+            LeaveCriticalSection(&engine->cs);
+            break;
+        }
+        if (!(engine->flags & FLAGS_ENGINE_SHUT_DOWN) && (engine->flags & FLAGS_ENGINE_HAS_VIDEO)
+                && engine->presentation.frame_sink)
+        {
+            BOOL present = engine->render.repaint;
+
+            if (SUCCEEDED(IMFPresentationClock_GetTime(engine->clock, &clocktime))
+                    && video_frame_sink_get_pts(engine->presentation.frame_sink, clocktime, &pts) == S_OK
+                    && pts != engine->render.last_pts)
+            {
+                engine->render.last_pts = pts;
+                present = TRUE;
+            }
+            if (present && video_frame_sink_get_sample(engine->presentation.frame_sink, &sample))
+            {
+                engine->render.repaint = FALSE;
+                params.size = engine->video_frame.size;
+                params.has_src = engine->render.has_src;
+                params.has_dst = engine->render.has_dst;
+                params.has_border = engine->render.has_border;
+                params.src = engine->render.src;
+                params.dst = engine->render.dst;
+                params.border = engine->render.border;
+            }
+        }
+        hwnd = engine->render.hwnd;
+        LeaveCriticalSection(&engine->cs);
+
+        if (sample)
+        {
+            media_engine_render_paint(hwnd, sample, &params);
+            IMFSample_Release(sample);
+        }
+    }
+
+    return 0;
+}
+
+static void media_engine_render_stop(struct media_engine *engine)
+{
+    HANDLE thread;
+
+    EnterCriticalSection(&engine->cs);
+    thread = engine->render.thread;
+    engine->render.thread = NULL;
+    engine->render.stop = TRUE;
+    if (engine->render.wake)
+        SetEvent(engine->render.wake);
+    LeaveCriticalSection(&engine->cs);
+
+    if (thread)
+    {
+        if (WaitForSingleObject(thread, 5000))
+            ERR("neutron-mfengine-hwnd: presenter thread did not stop.\n");
+        CloseHandle(thread);
+    }
+}
+
 static HRESULT init_media_engine(DWORD flags, IMFAttributes *attributes, struct media_engine *engine)
 {
     UINT32 output_format;
@@ -3663,7 +3975,22 @@
     IMFAttributes_GetUINT64(attributes, &MF_MEDIA_ENGINE_PLAYBACK_HWND, &playback_hwnd);
     hr = IMFAttributes_GetUINT32(attributes, &MF_MEDIA_ENGINE_VIDEO_OUTPUT_FORMAT, &output_format);
     if (playback_hwnd) /* FIXME: handle MF_MEDIA_ENGINE_PLAYBACK_VISUAL */
+    {
         engine->mode = MEDIA_ENGINE_RENDERING_MODE;
+        if (neutron_mfengine_hwnd_enabled() && IsWindow((HWND)(ULONG_PTR)playback_hwnd))
