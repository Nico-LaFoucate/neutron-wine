                                          const char *bits, RECT *rect,
-                                         HRGN region, UINT alpha_bits, BOOL sanitize)
+                                         HRGN region, UINT alpha_bits, BOOL sanitize, int const_alpha)
 {
     RECT buffer_rect = {0, 0, buffer->width, buffer->height};
     TRACE("buffer=%p bits=%p rect=%s\n", buffer, bits, wine_dbgstr_rect(rect));
-    copy_pixel_region(bits, rect, buffer->map_data, &buffer_rect, region, alpha_bits, sanitize);
+    copy_pixel_region(bits, rect, buffer->map_data, &buffer_rect, region, alpha_bits, sanitize, const_alpha);
 }
 
