                               char *dst_pixels, RECT *dst_rect,
-                              HRGN region, UINT alpha_bits, BOOL sanitize)
+                              HRGN region, UINT alpha_bits, BOOL sanitize, int const_alpha)
 {
     BOOL force_opaque = alpha_bits != 0;
     static const int bpp = WINEWAYLAND_BYTES_PER_PIXEL;
@@ -317,6 +325,18 @@
         width = rc.right - rc.left;
         height = rc.bottom - rc.top;
 
+        if (const_alpha >= 0)
+        {
+            for (y = 0; y < height; y++)
+            {
+                for (x = 0; x < width; ++x)
+                    ((UINT32 *)dst)[x] = neutron_premul_const(((const UINT32 *)src)[x], const_alpha);
+                src += src_stride;
+                dst += dst_stride;
+            }
+            continue;
+        }
+
         /* Fast path for full width rectangles. */
         if (width * bpp == src_stride && src_stride == dst_stride)
         {
@@ -381,11 +401,11 @@
  */
