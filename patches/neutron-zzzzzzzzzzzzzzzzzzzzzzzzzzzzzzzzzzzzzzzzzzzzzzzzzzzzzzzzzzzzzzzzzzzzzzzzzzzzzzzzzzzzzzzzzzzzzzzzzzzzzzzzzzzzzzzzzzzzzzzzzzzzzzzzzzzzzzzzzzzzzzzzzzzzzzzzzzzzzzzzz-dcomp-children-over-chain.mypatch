+                                below ? "children over it: copied through the window's DC" : "no children over it: direct");
+                    }
+                }
                 if (p->no_blit)
                 {
                     /* NEUTRON round-35 NATIVE mode: window presents its own Vulkan
@@ -1294,7 +1328,7 @@
