+/* NEUTRON children-over-chain: kill switch NEUTRON_DCOMP_CHILDREN_COPY=0 (see neutron_children_over_chain) */
+static BOOL neutron_children_copy_on(void)
+{
+    static int on = -1;
+    if (on < 0) on = neutron_gate("NEUTRON_DCOMP_CHILDREN_COPY", TRUE);
+    return on;
+}
+
