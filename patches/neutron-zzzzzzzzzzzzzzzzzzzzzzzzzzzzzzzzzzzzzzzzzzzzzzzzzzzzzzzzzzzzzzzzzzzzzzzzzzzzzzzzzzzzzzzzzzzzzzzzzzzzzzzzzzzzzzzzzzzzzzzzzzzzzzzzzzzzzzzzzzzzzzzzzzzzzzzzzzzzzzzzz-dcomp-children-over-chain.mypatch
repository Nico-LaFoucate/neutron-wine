 }
 
+/* NEUTRON children-over-chain (2026-11-07): whether visible child windows of `hwnd` sit over its client area.
+ * On Windows a window's child windows are composed above the window's own swap chain: a WS_CLIPCHILDREN window's
+ * presents never cover its children. Lightroom 9.6 presents one D3D11 swap chain per content container and draws
+ * every panel, the grid and the empty-library prompt as child windows inside it (GDI and ID2D1DCRenderTarget),
+ * which Wine draws into the top-level's window surface. The client surface (DXVK's Vulkan present) is a subsurface
+ * above that window surface, so it hid all of them: the whole area below the toolbar showed the chain's clear
+ * color. Upstream winex11 renders such a window offscreen and copies each present through the window's DC
+ * (needs_offscreen_rendering: "window has children, needs compositing"); for DXGI swap chains the dcomp bridge is
+ * that copy. Only WS_CLIPCHILDREN windows qualify: without it a copy through the DC would paint over the children.
+ * Called before win_data_mutex is taken (user-lock calls). */
+static BOOL neutron_children_over_chain(HWND hwnd)
+{
+    UINT dpi = NtUserGetDpiForWindow(hwnd);
+    HWND child;
+    RECT client, rc;
+
+    if (!neutron_children_copy_on()) return FALSE;
+    if (!(NtUserGetWindowLongW(hwnd, GWL_STYLE) & WS_CLIPCHILDREN)) return FALSE;
+    if (!(child = NtUserGetWindowRelative(hwnd, GW_CHILD))) return FALSE;
+    if (!NtUserGetClientRect(hwnd, &client, dpi) || IsRectEmpty(&client)) return FALSE;
+    for (; child; child = NtUserGetWindowRelative(child, GW_HWNDNEXT))
+    {
+        if (!(NtUserGetWindowLongW(child, GWL_STYLE) & WS_VISIBLE)) continue;
+        if (NtUserGetWindowLongW(child, GWL_EXSTYLE) & WS_EX_TRANSPARENT) continue; /* the server does not clip these */
+        if (!NtUserGetWindowRect(child, &rc, dpi)) continue;
+        NtUserMapWindowPoints(0, hwnd, (POINT *)&rc, 2, dpi);
+        if (intersect_rect(&rc, &rc, &client)) return TRUE;
+    }
+    return FALSE;
+}
+
 static void wayland_client_surface_update(struct client_surface *client)
 {
     struct wayland_client_surface *surface = impl_from_client_surface(client);
@@ -4346,7 +4389,29 @@
             surface->place_below = !!NtUserGetProp(hwnd, dcomp_present_prop);
         }
         else
-            surface->place_below = (suppress && (marked || sticky));
+        {
+            /* NEUTRON children-over-chain: a bridge-registered swap chain (marked: the dcomp bridge can copy its
+             * frames) whose window has visible children over it goes below the window surface, and the bridge
+             * copies its frames into that surface through the window's DC, around the children (see
+             * neutron_children_over_chain). __wine_dcomp_below tells the bridge, which otherwise leaves such a
+             * chain to this client surface (patch 150). Kill switch NEUTRON_DCOMP_CHILDREN_COPY=0. */
+            static const WCHAR dcomp_below_prop[] =
+                {'_','_','w','i','n','e','_','d','c','o','m','p','_','b','e','l','o','w',0};
+            BOOL below = (marked || sticky) && visible && neutron_children_over_chain(hwnd);
+            BOOL was_below = !!NtUserGetProp(hwnd, dcomp_below_prop);
+
+            if (below != was_below)
+            {
+                static unsigned int nlog;
+
+                if (below) NtUserSetProp(hwnd, dcomp_below_prop, (HANDLE)(ULONG_PTR)1);
+                else NtUserRemoveProp(hwnd, dcomp_below_prop);
+                if (nlog++ < 64)
+                    ERR("neutron-children-copy: hwnd=%p children over its swap chain %d -> client surface %s\n",
+                        hwnd, below, below ? "below, the bridge copies it" : "above");
+            }
+            surface->place_below = (suppress && (marked || sticky)) || below;
+        }
     }
 
