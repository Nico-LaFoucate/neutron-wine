+/* NEUTRON children-over-chain (2026-11-07): winewayland marks a window __wine_dcomp_below while visible child
+ * windows sit over its swap chain. On Windows those children are composed above the chain; here they are GDI
+ * content of the top-level's window surface, so winewayland puts the chain's client surface below that surface
+ * and the chain reaches the screen only through this bridge's copy into the window's DC, which clips the
+ * children (WS_CLIPCHILDREN). Lightroom 9.6's panels, grid and prompts are such children. Kill switch
+ * NEUTRON_DCOMP_CHILDREN_COPY=0 (read by winewayland, which then never sets the mark). */
+static BOOL neutron_chain_below(HWND hwnd)
+{
+    return GetPropW(hwnd, L"__wine_dcomp_below") != NULL;
+}
+
