+        /* NEUTRON children-over-chain: honor the update's place_below here too, as the loop over the surfaces
+         * phase A missed already does; otherwise this mirror (on by default with NEUTRON_OWNED_ZORDER) lifted
+         * such a surface straight back above the window surface it was just put under. */
+        if (cs->place_below && neutron_children_copy_on()) below[n] = TRUE;
         /* NEUTRON round-36 TEMPORAL rule ("latest painter wins"): if this chain
          * is IDLE and newer GDI damage (CEP shared-mem blits, GDI-hybrid paints)
