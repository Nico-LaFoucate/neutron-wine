+         * monitor (whose rc_monitor origin is exactly this x,y). output_info->output aliases
+         * &output->current, and we hold output_mutex. */
+        output_info->output->x = output_info->x;
+        output_info->output->y = output_info->y;
         wayland_add_device_source(device_manager, param, state_flags, output_info);
         wayland_add_device_monitor(device_manager, param, output_info);
