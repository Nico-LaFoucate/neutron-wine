+/**********************************************************************
+ *           wayland_window_output_change
+ *
+ * NEUTRON: the compositor's preferred fractional scale for this toplevel surface changed to `raw_dpi`
+ * (posted from fractional_scale_handle_preferred). On Wayland the win32 window position is fictional
+ * (the compositor owns toplevel placement), so instead of moving the window we stamp the surface's REAL
+ * monitor (resolved from that dpi) as the window's authoritative monitor in win32u (NtUserSetWinMonitor).
+ * win32u's MonitorFromWindow / GetDpiForWindow / maximize-target then follow the surface, and
+ * per-monitor DPI applies stably regardless of where the (fictional) rect lands. Driving this from the
+ * compositor's debounced preferred_scale (one value on settle) — not wl_surface.enter (per-overlapping-
+ * output) — is what makes the override stable instead of flip-flopping across a monitor straddle.
+ */
+static void wayland_window_output_change(HWND hwnd, UINT raw_dpi)
+{
+    struct wayland_win_data *data;
+    BOOL is_toplevel;
+
+    if (!neutron_dpi_follow()) return;
+    if (!raw_dpi) return;
+
+    if (!(data = wayland_win_data_get(hwnd))) return;
+    is_toplevel = data->wayland_surface &&
+                  wayland_surface_is_toplevel(data->wayland_surface);
+    wayland_win_data_release(data);
+    if (!is_toplevel) return;
+
+    ERR("neutron-outchg: hwnd=%p want_dpi=%u\n", hwnd, raw_dpi);
+    NtUserSetWinMonitor(hwnd, raw_dpi);
+}
+
 /**********************************************************************
  *           WAYLAND_WindowMessage
  */
