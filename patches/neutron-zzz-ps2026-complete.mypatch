+                        window_surface->alpha_bits, window_surface->alpha_mask,
+                        (unsigned)window_surface->color_key, alpha_bits, sanitize, !!shape_bits,
+                        n_zero, n_invalid, n_opaque, n_semi);
+                }
+            }
+        }
         wayland_shm_buffer_copy_data(shm_buffer, color_bits, &surface_rect, copy_from_window_region,
                                      alpha_bits, sanitize);
     }
