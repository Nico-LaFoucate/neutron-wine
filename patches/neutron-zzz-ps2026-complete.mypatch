+/* NEUTRON: a window's driver-authoritative monitor override (0 if none / cross-process). */
+HMONITOR get_window_monitor_override( HWND hwnd )
+{
+    HMONITOR mon = 0;
+    WND *win = get_win_ptr( hwnd );
+    if (win && win != WND_DESKTOP && win != WND_OTHER_PROCESS)
+    {
+        mon = win->monitor_override;
+        release_win_ptr( win );
+    }
+    return mon;
+}
+
+/* NEUTRON: monitor dpi for a resolved HMONITOR (mirrors monitor_dpi_from_rect). display_lock taken. */
+UINT monitor_dpi_from_handle( HMONITOR handle, UINT *raw_dpi )
+{
+    struct monitor *monitor;
+    UINT ret = system_dpi, x, y;
+
+    if (!lock_display_devices( FALSE )) return 0;
+    if ((monitor = get_monitor_from_handle( handle )))
+    {
+        *raw_dpi = monitor_get_dpi( monitor, MDT_RAW_DPI, &x, &y );
+        ret = monitor_get_dpi( monitor, MDT_DEFAULT, &x, &y );
+    }
+    unlock_display_devices();
+
+    return ret;
+}
