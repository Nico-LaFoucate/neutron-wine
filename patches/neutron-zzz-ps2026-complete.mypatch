+    struct dwrite_textlayout *layout = impl_from_IDWriteTextLayout4(iface);
+    struct layout_effective_run *run, *hit = NULL;
+    struct layout_line *line = NULL;
+    float line_top = 0.0f, line_bottom = 0.0f, best_dist = 0.0f;
+    BOOL y_inside = FALSE, x_inside = FALSE;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("%p, %.8e, %.8e, %p, %p, %p.\n", iface, pointX, pointY, is_trailinghit, is_inside, metrics);
+
+    *is_trailinghit = FALSE;
+    *is_inside = FALSE;
+    memset(metrics, 0, sizeof(*metrics));
+
+    if (FAILED(hr = layout_compute_effective_runs(layout)))
+        return hr;
+
+    /* Pass 1: pick the target line by vertical position, preferring the line that
+       actually contains pointY, otherwise the vertically closest one. */
+    LIST_FOR_EACH_ENTRY(run, &layout->effective_runs, struct layout_effective_run, entry)
+    {
+        float top = run->origin.y - run->line->baseline;
+        float bottom = top + run->line->height;
+        float dist = pointY < top ? top - pointY : (pointY >= bottom ? pointY - bottom : 0.0f);
+
+        if (!line || dist < best_dist)
+        {
+            line = run->line;
+            line_top = top;
+            line_bottom = bottom;
+            best_dist = dist;
+            y_inside = dist == 0.0f;
+        }
+    }
+
+    if (!line)
+    {
+        /* Empty layout - report a zero-length box at the origin. */
+        metrics->height = layout->metrics.height;
+        return S_OK;
+    }
+
+    /* Pass 2: within the target line, find the run under pointX, or the closest one. */
+    LIST_FOR_EACH_ENTRY(run, &layout->effective_runs, struct layout_effective_run, entry)
+    {
+        float left, right;
+
+        if (run->line != line)
+            continue;
+
+        left = run->left + run->align_dx;
+        right = left + run->width;
+
+        if (!hit)
+            hit = run;
+
+        if (pointX >= left && pointX < right)
+        {
+            hit = run;
+            x_inside = TRUE;
+            break;
+        }
+
+        /* Otherwise keep the right-most run that starts at or before pointX. */
+        if (pointX >= left)
+            hit = run;
+    }
+
+    if (!hit)
+    {
+        metrics->top = line_top;
+        metrics->height = line_bottom - line_top;
+        return S_OK;
+    }
+
+    {
+        float left = hit->left + hit->align_dx;
+        BOOL rtl = !!(hit->bidi_level & 1);
+
+        if (hit->object)
+        {
+            /* Inline object - a single indivisible box. */
+            metrics->textPosition = hit->start_position;
+            metrics->length = hit->length;
+            metrics->left = left;
+            metrics->top = line_top;
+            metrics->width = hit->width;
+            metrics->height = hit->line->height;
+            metrics->bidiLevel = hit->bidi_level;
+            metrics->isText = FALSE;
+            metrics->isTrimmed = hit->trimming;
+
+            *is_trailinghit = pointX >= left + hit->width / 2.0f;
+        }
+        else
+        {
+            UINT32 cluster = hit->first_cluster, cursor = hit->start_position;
+            UINT32 last = hit->start_position + hit->length;
+            float cluster_left = left, cluster_width = 0.0f;
+
+            /* Walk clusters of this run in visual order to find the one under pointX. */
+            while (cursor < last && cluster < layout->cluster_count)
+            {
+                float w = layout->clustermetrics[cluster].width;
+                float off = rtl ?
+                        hit->width - get_cluster_range_width(layout, hit->first_cluster, cluster) - w :
+                        get_cluster_range_width(layout, hit->first_cluster, cluster);
+
+                cluster_left = left + off;
+                cluster_width = w;
+                if (pointX < cluster_left + w)
+                    break;
+
+                cursor += layout->clustermetrics[cluster].length;
+                cluster++;
+            }
+
+            /* Clamp to the last cluster of the run if pointX is past its end. */
+            if ((cluster >= layout->cluster_count || cursor >= last) && cluster > hit->first_cluster)
+            {
+                cluster--;
+                cursor -= layout->clustermetrics[cluster].length;
+                cluster_width = layout->clustermetrics[cluster].width;
+                cluster_left = left + (rtl ?
+                        hit->width - get_cluster_range_width(layout, hit->first_cluster, cluster) - cluster_width :
+                        get_cluster_range_width(layout, hit->first_cluster, cluster));
+            }
+
+            metrics->textPosition = cursor;
+            metrics->length = cluster < layout->cluster_count ? layout->clustermetrics[cluster].length : 0;
+            metrics->left = cluster_left;
+            metrics->top = line_top;
+            metrics->width = cluster_width;
+            metrics->height = hit->line->height;
+            metrics->bidiLevel = hit->bidi_level;
+            metrics->isText = TRUE;
+            metrics->isTrimmed = hit->trimming;
+
+            /* Trailing hit when the point is past the visual middle of the cluster. */
+            if (cluster_width > 0.0f)
+                *is_trailinghit = rtl ? pointX < cluster_left + cluster_width / 2.0f :
+                        pointX >= cluster_left + cluster_width / 2.0f;
+        }
+
+        *is_inside = x_inside && y_inside;
+    }
+
+    return S_OK;
 }
 
