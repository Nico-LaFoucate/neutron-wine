+/* NEUTRON: graphics-driver call to set a window's authoritative monitor by that monitor's RAW dpi
+ * (the surface's real output), overriding win32's position-based monitor/DPI inference. win32u resolves
+ * the dpi to a monitor handle (positions can be stale in an app process). Pass 0 to clear. */
+static inline UINT NtUserSetWinMonitor( HWND hwnd, UINT raw_dpi )
+{
+    return NtUserCallHwndParam( hwnd, raw_dpi, NtUserCallHwndParam_SetWinMonitor );
+}
