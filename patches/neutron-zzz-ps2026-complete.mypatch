     }
 
     if (alertable) alert_fd = get_inproc_alert_fd();
+#ifdef NTSYNC_IOC_EVENT_READ
+    if (count == 1 && syncs[0]->type == INPROC_SYNC_INTERNAL &&
+        (!timeout || timeout->QuadPart == TIMEOUT_INFINITE))
+    {
+        /* NEUTRON diag: poll a would-be-infinite internal(queue) wait with 2s timeouts and read the
+         * event state each timeout. Distinguishes stale-object (signaled stays 0) from edge-miss
+         * (event becomes signaled=1 and a fresh wait recovers). Logs only when a wait actually stalls. */
+        static FILE *neutron_i;
+        unsigned int tid = (unsigned)(ULONG_PTR)NtCurrentTeb()->ClientId.UniqueThread;
+        LARGE_INTEGER to;
+        int iter = 0;
+        if (!neutron_i) neutron_i = fopen( "~/neutron-cli.log", "a" );
+        for (;;)
+        {
+            to.QuadPart = -20000000;  /* 2s relative */
+            ret = linux_wait_objs( inproc_device_fd, 1, objs, type, alert_fd, &to );
+            if (ret != STATUS_TIMEOUT) break;
+            {
+                struct ntsync_event_args ea = {0};
+                int sg = ioctl( objs[0], NTSYNC_IOC_EVENT_READ, &ea ) == 0 ? (int)ea.signaled : -1;
+                if (neutron_i && iter < 12)
+                    { fprintf( neutron_i, "IPW-POLL tid %04x fd=%d timedout signaled=%d manual=%d iter=%d\n",
+                               tid, objs[0], sg, (int)ea.manual, iter ); fflush( neutron_i ); }
+                iter++;
+            }
+        }
+        if (neutron_i && iter > 0)
+            { fprintf( neutron_i, "IPW-POLL tid %04x fd=%d RECOVERED after %d timeouts ret=%08x\n",
+                       tid, objs[0], iter, (unsigned)ret ); fflush( neutron_i ); }
+        release_inproc_sync( syncs[0] );
+        return ret;
+    }
+#endif
