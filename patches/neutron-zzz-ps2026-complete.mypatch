+/* NEUTRON: resolve the active monitor whose RAW dpi matches want_raw. Used to map a Wayland output to
+ * an HMONITOR without relying on monitor POSITIONS, which can be stale in an app process (the display
+ * model may be built before the compositor advertised geometry). Also logs the monitor list. */
+HMONITOR monitor_handle_from_raw_dpi( UINT want_raw )
+{
+    struct monitor *monitor;
+    HMONITOR match = 0;
+    UINT best_delta = ~0u;
+    UINT x, y;
+
+    if (!lock_display_devices( FALSE )) return 0;
+    LIST_FOR_EACH_ENTRY( monitor, &monitors, struct monitor, entry )
+    {
+        UINT raw, eff, delta;
+        if (!is_monitor_active( monitor )) continue;
+        eff = monitor_get_dpi( monitor, MDT_DEFAULT, &x, &y );
+        raw = monitor_get_dpi( monitor, MDT_RAW_DPI, &x, &y );
+        ERR( "neutron-monlist: handle=%p raw_dpi=%u eff_dpi=%u primary=%d\n",
+             monitor->handle, raw, eff, is_monitor_primary( monitor ) );
+        /* Nearest match, not exact: want_raw comes from the compositor's fractional scale
+         * (scale*96, e.g. 1.7*96=163.2->163) which can round a couple dpi off a monitor's raw dpi. */
+        delta = raw > want_raw ? raw - want_raw : want_raw - raw;
+        if (delta < best_delta) { best_delta = delta; match = monitor->handle; }
+    }
+    unlock_display_devices();
+    return match;
+}
+
