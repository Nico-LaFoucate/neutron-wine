+/* NEUTRON: WM_DPICHANGED is only defined in winuser.rh, not the C headers win32u includes. */
+#ifndef WM_DPICHANGED
+#define WM_DPICHANGED 0x02e0
+#endif
+
+/* NEUTRON: gate for the experimental cross-monitor WM_DPICHANGED sender (the ③+④ approach). OFF by
+ * default — on Wayland the win32 window position is fictional so this fights the restore logic; the
+ * shipping default relies on the winewayland driver-side scale fix. Set NEUTRON_DPI_34=1 to enable. */
+static BOOL neutron_dpi_34(void)
+{
+    static int v = -1;
+    if (v < 0) { const char *e = getenv( "NEUTRON_DPI_34" ); v = (e && e[0] == '1') ? 1 : 0; }
+    return v;
+}
+
+/* NEUTRON: set (monitor!=0) or clear a window's driver-authoritative monitor. If this changes the
+ * window's effective raw dpi and it is per-monitor-DPI aware, notify it with WM_DPICHANGED so it
+ * re-renders at the new dpi. Called by the graphics driver when the surface enters a new output. */
+static UINT set_win_monitor_override( HWND hwnd, UINT want_raw )
+{
+    UINT old_raw = 0, new_raw = 0;
+    HMONITOR monitor, old;
+    WND *win;
+
+    /* Resolve by dpi, not position (app-process monitor positions can be stale). want_raw==0 clears. */
+    monitor = want_raw ? monitor_handle_from_raw_dpi( want_raw ) : 0;
+    get_win_monitor_dpi( hwnd, &old_raw );   /* honors the CURRENT override */
+    if (!(win = get_win_ptr( hwnd )) || win == WND_DESKTOP || win == WND_OTHER_PROCESS) return FALSE;
+    old = win->monitor_override;
+    win->monitor_override = monitor;
+    release_win_ptr( win );
+    if (old == monitor) return TRUE;
+
+    get_win_monitor_dpi( hwnd, &new_raw );   /* honors the NEW override */
+    if (new_raw && old_raw && new_raw != old_raw &&
+        NTUSER_DPI_CONTEXT_IS_MONITOR_AWARE( get_window_dpi_awareness_context( hwnd ) ))
+    {
+        UINT dpi = get_thread_dpi();
+        RECT r;
+        if (get_window_rect( hwnd, &r, dpi ))
+        {
+            int w = r.right - r.left, h = r.bottom - r.top;
+            RECT s = r;
+            s.right  = s.left + muldiv( w, new_raw, old_raw );
+            s.bottom = s.top  + muldiv( h, new_raw, old_raw );
+            /* NEUTRON experiment: do NOT send WM_DPICHANGED. Sending it to just this one toplevel (while
+             * PS's ~40 other surfaces still resolve dpi by their fictional position) destabilized PS's
+             * layout and regressed floating. Keep the override purely so monitor_from_window /
+             * get_maximized_rect target the surface's REAL monitor (fixes the maximize-too-big case);
+             * leave sizing to #1's compositor-scale path. Log the transition we would have announced. */
+            ERR( "neutron-dpichg: hwnd=%p override dpi %u->%u suggest=(%ld,%ld,%ld,%ld) [WM_DPICHANGED suppressed]\n",
+                 hwnd, old_raw, new_raw, (long)s.left, (long)s.top, (long)s.right, (long)s.bottom );
+        }
+    }
+    return TRUE;
+}
