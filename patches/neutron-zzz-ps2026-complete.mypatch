+/* === NEUTRON Path B: native force-show of the deferred OWL workspace docks. ===================
+   On File>New the OWL document + its dock hierarchy (Dock->TabPane->TabGroup->Document + panels)
+   are built and reparented under the "Photoshop" frame, but under winewayland PS leaves their
+   WS_VISIBLE clear (deferred to ~make-8) so the canvas never renders. We reveal them ONCE, in
+   show_window's safe context, top-down (ancestors first so children can map). This is exactly the
+   force-show half of the app-side neutron_psdock.c helper, ported into win32u WITHOUT its
+   frame-jitter/2px-nudge and WITHOUT its decaying 10s repaint timer -> no canvas perturbation. */
+static void neutron_class_ascii( HWND hwnd, char *out /* [64] */ )
+{
+    WCHAR bufW[64];
+    UNICODE_STRING name;
+    int len, i;
+    name.Buffer = bufW; name.MaximumLength = sizeof(bufW); name.Length = 0;
+    len = NtUserGetClassName( hwnd, FALSE, &name );
+    if (len < 0 || len >= 64) len = 0;
+    for (i = 0; i < len; i++) out[i] = (char)bufW[i];
+    out[len] = 0;
+}
+static BOOL neutron_ascii_has( const char *hay, const char *needle )
+{
+    int i, j;
+    for (i = 0; hay[i]; i++)
+    {
+        for (j = 0; needle[j] && hay[i + j] == needle[j]; j++) {}
+        if (!needle[j]) return TRUE;
+    }
+    return FALSE;
+}
+/* The workspace dock classes to reveal (mirrors neutron_psdock.c want_show()). */
+static BOOL neutron_want_show( const char *c )
+{
+    return neutron_ascii_has( c, "OWL.Dock" )    || neutron_ascii_has( c, "OWL.TabPane" )
+        || neutron_ascii_has( c, "OWL.TabGroup" )|| neutron_ascii_has( c, "OWL.Palette" )
+        || neutron_ascii_has( c, "OWL.Document" )|| neutron_ascii_has( c, "OWL.WindowGroup" )
+        || neutron_ascii_has( c, "OWL.ResizeGripper" ) || neutron_ascii_has( c, "PSViewC" );
+}
+/* Home screen + floating popups are hidden on purpose: never show them, never descend into them. */
+static BOOL neutron_skip_subtree( const char *c )
+{
+    return neutron_ascii_has( c, "WelcomeScreen" ) || neutron_ascii_has( c, "PSFloat" );
+}
+static int neutron_force_show_docks( HWND parent, int depth )
+{
+    HWND *list;
+    char cb[64];
+    int i, n = 0;
+    if (depth > 14) return 0;
+    if (!(list = list_window_children( parent ))) return 0;
+    for (i = 0; list[i]; i++)
+    {
+        neutron_class_ascii( list[i], cb );
+        if (neutron_skip_subtree( cb )) continue;                 /* leave home/float as PS put it */
+        if (neutron_want_show( cb ) && !(get_window_long( list[i], GWL_STYLE ) & WS_VISIBLE))
+        {
+            RECT rc = {0, 0, 0, 0};
+            get_client_rect( list[i], &rc, get_thread_dpi() );
+            if (rc.right - rc.left > 1 && rc.bottom - rc.top > 1)  /* real geometry, not a placeholder */
+            {
+                NtUserShowWindow( list[i], SW_SHOWNA );
+                NtUserRedrawWindow( list[i], NULL, 0, RDW_INVALIDATE | RDW_ERASE | RDW_UPDATENOW );
+                n++;
+            }
+        }
+        n += neutron_force_show_docks( list[i], depth + 1 );
+    }
+    free( list );
+    return n;
+}
+
+/* === NEUTRON avenue-3: capture the OWL relayout's geometry INPUT (rect reads) and OUTPUT (resize
+   issues) for the canvas ancestor chain during the doc-create window, to localize the query that
+   returns a placeholder (484x484 / 100x500-style) rect vs the real document area. */
+static LONG neutron_relayout_trace;    /* 1 while tracing the doc-create relayout */
+static LONG neutron_relayout_budget;   /* remaining log lines (hard cap on volume) */
+static BOOL neutron_is_relayout_win( HWND hwnd, const char *c )
+{
+    if (neutron_ascii_has( c, "OWL.Dock" ) || neutron_ascii_has( c, "OWL.TabPane" )
+        || neutron_ascii_has( c, "OWL.TabGroup" ) || neutron_ascii_has( c, "OWL.Document" )
+        || neutron_ascii_has( c, "OWL.WindowGroup" ) || neutron_ascii_has( c, "PSViewC" )
+        || neutron_ascii_has( c, "PSFloatC" )) return TRUE;
+    if (!strcmp( c, "Photoshop" )) return TRUE;                 /* the app frame (available area source) */
+    if (!strcmp( c, "Static" ))                                /* the GPU swapchain host = Static child of PSViewC */
+    {
+        char pc[64]; HWND p = NtUserGetAncestor( hwnd, GA_PARENT );
+        if (p) { neutron_class_ascii( p, pc ); if (neutron_ascii_has( pc, "PSViewC" )) return TRUE; }
+    }
+    return FALSE;
+}
+static void neutron_geom_log( const char *tag, HWND hwnd, const RECT *win, const RECT *client )
+{
+    char c[64];
+    if (!neutron_relayout_trace) return;
+    neutron_class_ascii( hwnd, c );
+    if (!neutron_is_relayout_win( hwnd, c )) return;
+    if (InterlockedDecrement( &neutron_relayout_budget ) < 0) { neutron_relayout_trace = 0; return; }
+    ERR( "neutron-geom: %s hwnd=%p class=%s win=(%ld,%ld %ldx%ld) client=%ldx%ld\n",
+         tag, hwnd, c,
+         win ? (long)win->left : 0, win ? (long)win->top : 0,
+         win ? (long)(win->right - win->left) : 0, win ? (long)(win->bottom - win->top) : 0,
+         client ? (long)(client->right - client->left) : -1, client ? (long)(client->bottom - client->top) : -1 );
+}
+
+/* === NEUTRON mask-storm trace (env-gated NEUTRON_MASK_TRACE=1): during the LrC 2nd-mask
+   relayout non-convergence, log every apply_window_pos with class + hwnd + old->new geometry.
+   Real size/pos changes are always logged; pure no-op moves are throttled 1/256 to gauge
+   volume without flooding. Bounded hard budget so a runaway storm can't fill the disk. The
+   goal is to see, in ONE run, whether a window oscillates between two sizes (a genuine size
+   fight) or is re-issued at a STABLE size forever (the app's convergence check failing on a
+   value that is actually stable -> the fought readback is elsewhere, e.g. scale/DPI). */
+static int neutron_mask_trace_on( void )
+{
+    static int v = -1;
+    if (v < 0) { const char *e = getenv( "NEUTRON_MASK_TRACE" ); v = (e && e[0] == '1') ? 1 : 0; }
+    return v;
+}
+static LONG neutron_mask_budget = 60000;
+static LONG neutron_mask_nop_n;
+static void neutron_mask_trace( HWND hwnd, UINT swp_flags, const RECT *oldw, const RECT *neww )
+{
+    char c[64];
+    int ow, oh, nw, nh;
+    BOOL sized, moved;
+    if (!neutron_mask_trace_on()) return;
+    ow = oldw->right - oldw->left; oh = oldw->bottom - oldw->top;
+    nw = neww->right - neww->left; nh = neww->bottom - neww->top;
+    sized = (ow != nw) || (oh != nh);
+    moved = (oldw->left != neww->left) || (oldw->top != neww->top);
+    if (!sized && !moved) { if (((neutron_mask_nop_n++) & 0xFF) != 0) return; }  /* throttle no-ops 1/256 */
+    if (InterlockedDecrement( &neutron_mask_budget ) < 0) return;
+    neutron_class_ascii( hwnd, c );
+    ERR( "neutron-mask: %s%s hwnd=%p class=%s swp=%08x old=(%ld,%ld %dx%d) new=(%ld,%ld %dx%d)\n",
+         sized ? "SZ" : (moved ? "MV" : "NOP"), "",
+         hwnd, c, swp_flags,
+         (long)oldw->left, (long)oldw->top, ow, oh,
+         (long)neww->left, (long)neww->top, nw, nh );
+}
