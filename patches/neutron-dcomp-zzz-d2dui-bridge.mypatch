+     * may execute under a swallowed-SEH guard. The round-32 freeze root (core-
+     * proven): a page fault inside CopyResource/Map was caught by the old
+     * whole-block __EXCEPT_PAGE_FAULT here; the SEH unwind skipped DXVK's C++
+     * RAII unlock, permanently leaking the shared D3D10 device lock
+     * (owner=blit-thread, counter=1) -> every thread touching the immediate
+     * context deadlocked (main UI thread frozen in RecursiveSpinlock::lock).
+     * Object lifetime needs no SEH: our caller holds presentations_cs, which
+     * also serializes register/unregister's p->swapchain / p->staging updates,
+     * and GetBuffer/GetDevice/GetImmediateContext return COM refs that keep the
+     * DXVK objects alive across a concurrent app-side ResizeBuffers. So:
+     *  - Enter / CopyResource / Map / Unmap / Leave all run OUTSIDE any __TRY,
+     *    HRESULT-checked, with Leave guaranteed on every path below;
+     *  - __TRY guards ONLY the raw pixel memcpy from the mapped staging (the
+     *    sole legitimately-faultable region; no lock is held *inside* wine code
+     *    there beyond mt, and the guard skips no unlock -- Unmap and Leave run
+     *    after __ENDTRY on both the normal and the fault path). */
+    {
+        /* NEUTRON M4: RELIABLE present gate for ALL windows via the pending_blit flag set
+         * by the per-Present register hook. (GetLastPresentCount was cross_proc-only and is
+         * unreliable for the DISCARD/bitblt-model d2d1 HwndRenderTarget swapchains -> it
+         * never skipped -> the same-proc D2D-UI windows were read back+blitted every 16ms
+         * = the lag.) Skip the readback for any window that did NOT Present since our last
+         * blit. InterlockedExchange reads AND consumes the flag. */
+        BOOL do_blit = InterlockedExchange(&p->pending_blit, FALSE);
+        /* stats: total/skip/blit, logged ~every 2s so we SEE the gate engage */
+        {
+            static LONG g_calls, g_skips, g_blits; static ULONGLONG g_t;
+            ULONGLONG now; LONG c;
+            InterlockedIncrement(&g_calls);
+            if (!do_blit) InterlockedIncrement(&g_skips); else InterlockedIncrement(&g_blits);
+            c = g_calls; now = GetTickCount64();
+            if (g_t == 0) g_t = now;
+            if (now - g_t >= 2000)
+            {
+                g_t = now;
+                ERR("neutron-gate: 2s window calls=%ld blits=%ld skips=%ld (gate %s)\n",
+                    c, g_blits, g_skips, g_skips > 0 ? "ENGAGED" : "not-skipping");
+                InterlockedExchange(&g_calls, 0); InterlockedExchange(&g_blits, 0); InterlockedExchange(&g_skips, 0);
+            }
+        }
