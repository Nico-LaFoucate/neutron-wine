+/* NEUTRON round-34 ztree diag: forward decls (definitions after this function) */
+static int neutron_ztree_diag(void);
+static void ztree_dump(void);
+
 static DWORD WINAPI presentations_proc(void *arg)
 {
     for (;;)
     {
         struct presentation *p;
+        int nlive = 0;
+        static ULONGLONG regt;
+        ULONGLONG now;
 
         EnterCriticalSection(&presentations_cs);
         LIST_FOR_EACH_ENTRY(p, &presentations, struct presentation, entry)
         {
+            nlive++;
             if (p->swapchain && p->present_hwnd && IsWindow(p->present_hwnd))
             {
                 /* NEUTRON R3 (resize glitch): pause blits while the target is mid-resize.
@@ -549,19 +784,160 @@
                  * once it settles (a frame drop here is already accepted behaviour). */
                 RECT rc = {0};
                 LONG cw = 0, ch = 0;
-                if (GetClientRect(p->present_hwnd, &rc)) { cw = rc.right - rc.left; ch = rc.bottom - rc.top; }
-                if (cw == p->last_client_w && ch == p->last_client_h)
+                LONG dw, dh;
+                BOOL gcr = GetClientRect(p->present_hwnd, &rc);
+                if (gcr) { cw = rc.right - rc.left; ch = rc.bottom - rc.top; }
+                dw = cw - p->last_client_w; if (dw < 0) dw = -dw;
+                dh = ch - p->last_client_h; if (dh < 0) dh = -dh;
+                /* NEUTRON R3b: the original guard blitted only when cw==last_client
+                 * for two consecutive ticks, to avoid stretching a stale readback
+                 * during a resize. But under winewayland fractional scale the client
+                 * rect JITTERS ~10px every tick (e.g. 3840x2031<->3830x2021), which
+                 * never satisfies strict equality -> the whole GPU UI was starved and
+                 * stayed black. Blit whenever the size is non-zero and changed by only
+                 * a small amount since last tick (jitter / slow drag); still pause on a
+                 * genuine large resize step (maximize/restore = hundreds of px). */
+                if (p->no_blit)
+                {
+                    /* NEUTRON round-35 NATIVE mode: window presents its own Vulkan
+                     * subsurface; the bridge performs no readback and no blit for it
+                     * (registration kept only for ztree diag / A-B revert). */
+                }
+                else if (p->cross_proc && neutron_cef_max_fps() > 0 &&
+                         GetTickCount64() - p->last_blit_ms < (ULONGLONG)(1000 / neutron_cef_max_fps()))
+                {
+                    /* NEUTRON round-38: CEF fps cap -- skip this tick; pending_blit
+                     * stays set so the NEXT eligible tick blits the fresh frame. */
+                }
+                else if (cw > 0 && ch > 0 && dw <= NEUTRON_RESIZE_TOL && dh <= NEUTRON_RESIZE_TOL)
+                {
                     blit_swapchain_to_hwnd(p);
+                    p->last_blit_ms = GetTickCount64();
+                }
+                else if (neutron_d2dui_diag())
+                {
+                    /* Log first time we SKIP a given hwnd for size-instability (and again
+                     * only if it keeps changing) — is the resize guard starving the UI? */
+                    static struct { HWND h; LONG w, hh; int n; } sk[64]; static int nsk;
+                    int i, slot = -1;
+                    for (i = 0; i < nsk; i++) if (sk[i].h == p->present_hwnd) { slot = i; break; }
+                    if (slot < 0 && nsk < 64) { slot = nsk++; sk[slot].h = p->present_hwnd; sk[slot].n = 0; }
+                    if (slot >= 0 && sk[slot].n < 4)
+                    {
+                        sk[slot].n++;
+                        ERR("neutron-d2dui: SKIP-RESIZE hwnd=%p cross_proc=%d gcr=%d cur=%ldx%ld last=%ldx%ld\n",
+                            p->present_hwnd, p->cross_proc, gcr, cw, ch, p->last_client_w, p->last_client_h);
+                    }
+                }
                 p->last_client_w = cw;
                 p->last_client_h = ch;
             }
+            else if (neutron_d2dui_diag())
+            {
+                static struct { HWND h; } sg[64]; static int nsg;
+                HWND h = p->present_hwnd; int i; BOOL s = FALSE;
+                for (i = 0; i < nsg; i++) if (sg[i].h == h) { s = TRUE; break; }
+                if (!s && nsg < 64)
+                {
+                    sg[nsg++].h = h;
+                    ERR("neutron-d2dui: SKIP-GUARD hwnd=%p cross_proc=%d swapchain=%p present_hwnd=%p iswin=%d\n",
+                        p->hwnd, p->cross_proc, p->swapchain, p->present_hwnd,
+                        p->present_hwnd ? IsWindow(p->present_hwnd) : 0);
+                }
+            }
         }
         LeaveCriticalSection(&presentations_cs);
+        /* NEUTRON M4: confirm the registration list stays BOUNDED (dedup working). Should
+         * plateau at the true live-window count (~15-25), never climb into the thousands. */
+        now = GetTickCount64();
+        if (regt == 0) regt = now;
+        if (now - regt >= 2000) { regt = now; ERR("neutron-reg: %d live registrations\n", nlive); }
+        /* NEUTRON round-34 ztree diag: dump the real win32 z-order every ~5s */
+        if (neutron_ztree_diag())
+        {
+            static ULONGLONG zt;
+            if (now - zt >= 5000)
+            {
+                zt = now;
+                EnterCriticalSection(&presentations_cs);
+                ztree_dump();
+                LeaveCriticalSection(&presentations_cs);
+            }
+        }
         Sleep(16);
     }
     return 0;
 }
 
+/* NEUTRON round-34 ZTREE DIAG (env NEUTRON_ZTREE_DIAG=1, read-only): dump the real
+ * win32 z-order tree of every toplevel that hosts registered (swapchain) windows,
+ * top-of-z first (GW_CHILD walks topmost->bottom via GW_HWNDNEXT). Per window:
+ * class, rect, style, visibility, whether it has a registered swapchain, and the
+ * latest readback classification (BLACK vs HAS-CONTENT). This is the R1 de-risk
+ * data for the native pivot: prove that mirroring win32 z-order puts content
+ * windows above black containers. Called from the blit thread every ~5s while
+ * holding presentations_cs (all queries are read-only user32 calls). */
+static int neutron_ztree_diag(void)
+{
+    static int v = -1;
+    if (v < 0) { char b[8]; v = (GetEnvironmentVariableA("NEUTRON_ZTREE_DIAG", b, sizeof(b)) && b[0]=='1') ? 1 : 0; }
+    return v;
+}
+
+static struct presentation *ztree_find(HWND hwnd)
+{
+    struct presentation *p;
+    LIST_FOR_EACH_ENTRY(p, &presentations, struct presentation, entry)
+        if (p->present_hwnd == hwnd || p->hwnd == hwnd) return p;
+    return NULL;
+}
+
+static void ztree_dump_window(HWND hwnd, int depth, int *budget)
+{
+    WCHAR clsw[64]; char cls[64]; int j = 0;
+    RECT rc = {0};
+    HWND c;
+    struct presentation *p = ztree_find(hwnd);
+    LONG style = GetWindowLongW(hwnd, GWL_STYLE);
+    const char *content = "-";
+
+    if ((*budget)-- <= 0) return;
+    if (GetClassNameW(hwnd, clsw, 64) <= 0) clsw[0] = 0;
+    while (clsw[j] && j < 40) { cls[j] = (char)clsw[j]; j++; } cls[j] = 0;
+    GetWindowRect(hwnd, &rc);
+    if (p) content = (p->last_black < 0) ? "sc:unknown" : (p->last_black ? "sc:BLACK" : "sc:CONTENT");
+
+    ERR("neutron-ztree: %*s[%d] hwnd=%p cls=%s rect=%ld,%ld-%ldx%ld style=%08lx vis=%d %s\n",
+        depth * 2, "", depth, hwnd, cls, rc.left, rc.top,
+        rc.right - rc.left, rc.bottom - rc.top, style,
+        (style & WS_VISIBLE) ? 1 : 0, content);
+
+    /* GW_CHILD = TOPMOST child; GW_HWNDNEXT walks DOWN the z-order */
+    for (c = GetWindow(hwnd, GW_CHILD); c && depth < 6; c = GetWindow(c, GW_HWNDNEXT))
+        ztree_dump_window(c, depth + 1, budget);
+}
+
+static void ztree_dump(void)
+{
+    HWND roots[8]; int nroots = 0, i;
+    struct presentation *p;
+    LIST_FOR_EACH_ENTRY(p, &presentations, struct presentation, entry)
+    {
+        HWND root = GetAncestor(p->present_hwnd, GA_ROOT);
+        BOOL seen = FALSE;
+        if (!root) continue;
+        for (i = 0; i < nroots; i++) if (roots[i] == root) { seen = TRUE; break; }
+        if (!seen && nroots < 8) roots[nroots++] = root;
+    }
+    for (i = 0; i < nroots; i++)
+    {
+        int budget = 120;
+        HWND owner = GetWindow(roots[i], GW_OWNER);
+        ERR("neutron-ztree: ==== ROOT %p (owner=%p) top-of-z first ====\n", roots[i], owner);
+        ztree_dump_window(roots[i], 0, &budget);
+    }
+}
