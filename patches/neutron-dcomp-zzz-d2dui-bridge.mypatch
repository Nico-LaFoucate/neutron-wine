     else if (packed)
     {
         /* same-process target (e.g. the program-monitor canvas): the classic GDI blit works. */
+        BOOL blit_ok = FALSE;
+        int content_dd;
+
+        hdc = NULL;
+        /* NEUTRON M4 BUG-2 FIX: measure whole-frame variation of the readback. The blit
+         * OVERWRITES the window_surface via StretchDIBits, so blitting a UNIFORM/BLACK
+         * readback would CLOBBER the window's real GDI-painted content (e.g. the timeline
+         * paints via GDI into the shared surface but only Presents its swapchain on
+         * interaction -> its swapchain readback is stale/black -> our blit painted black
+         * over it -> "invisible until you hover"). So: skip the blit when the readback is
+         * uniform (black/empty) -> never clobber good GDI content with black. Non-uniform
+         * (real D2D content) always blits. Also helps the ~14 BLACK-readback windows. */
+        BOOL uniform_black;
+        {
