+            UINT W = desc.Width, H = desc.Height, gx, gy;
+            DWORD ref = px[(SIZE_T)(H/2)*W + W/2];
+            content_dd = 0;
+            for (gy = 0; gy < 40; gy++) for (gx = 0; gx < 40; gx++)
+                if (px[(SIZE_T)(H*gy/40)*W + (W*gx/40)] != ref) content_dd++;
