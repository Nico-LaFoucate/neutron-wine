# neutron-dcomp-zzz-d2dui-bridge
#
# The D2D-UI / CEF delivery bridge for Premiere's GPU-accelerated UI mode.
# Touches: dlls/dcomp/device.c.
#
# ORDERING: named zzz-* deliberately. It applies on top of ALL the other neutron-dcomp-*
# patches (bridge, crossproc, resize-fixes, swapchain-reaper) and edits code they introduce.
# wine-tkg applies *.mypatch alphabetically, and "zzz" sorts after bridge/crossproc/
# resize-fixes/swapchain-reaper under both C and locale collation. Do not rename it to
# something that sorts earlier.
#
# What it adds:
#   * NEUTRON_DCOMP_NATIVE  - gate for the native D2D-UI delivery path.
#   * NEUTRON_CEF_MAX_FPS   - caps CEF panel blit rate (Premiere's CEP panels otherwise
#                             blit as fast as they present, burning CPU on the UI thread).
#   * NEUTRON_DCOMP_SKIP_CEF, NEUTRON_RESIZE_TOL - companion gates/tunables.
#   * NeutronBoundedAcquire - bounded stamp acquire, replacing an unbounded wait.
#
# SUPERSEDES, deliberately: the IDXGISwapChain::GetLastPresentCount skip gate added by the
# earlier dcomp patches is replaced by a `pending_blit` counter set on every Present via the
# register hook. GetLastPresentCount is unreliable for the DISCARD d2d1 swapchains Premiere
# uses, so the old gate both skipped real frames and let stale ones through. A diff of this
# patch therefore shows those lines being REMOVED -- that is intended, not a regression.
#
# The __TRY/__EXCEPT_PAGE_FAULT guard around the swapchain read (added by resize-fixes to
# survive a concurrent resize tearing down the backbuffer) is PRESERVED and extended.
#
# ⚠️ Still carries diagnostics: NEUTRON_ZTREE_DIAG (z-order tree dump) and
# NEUTRON_BLIT_FAULT_INJECT (fault-injection test hook). Both are env-gated and inert when
# unset, but they are DEBUG PROBES, not fixes -- strip or move them to patches/diagnostic/
# before this ships anywhere user-facing.
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -39,6 +39,11 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
 
+/* NEUTRON R3b: max per-tick client-size delta (px) still treated as "not resizing"
+ * so steady-state / fractional-scale-jitter windows keep blitting. A genuine
+ * maximize/restore jumps far more and is still paused. */
+#define NEUTRON_RESIZE_TOL 24
+
 struct composition_device
 {
     IDCompositionDesktopDevice IDCompositionDesktopDevice_iface;
@@ -104,6 +109,17 @@
     BOOL   cross_proc; /* present_hwnd owned by another process (CEF panel) -> use shared px path */
     UINT   last_present_count; /* NEUTRON perf: skip the staging copy when the swapchain hasn't presented */
     BOOL   have_present_count;
+    LONG   pending_blit; /* NEUTRON M4: set on every Present (register hook), cleared after a blit;
+                          * the RELIABLE present-count gate for DISCARD d2d1 swapchains where
+                          * IDXGISwapChain::GetLastPresentCount is unreliable. */
+    IUnknown *content_id; /* NEUTRON M4: raw identity of the presented content (NOT ref-held) for
+                           * the per-Present fast-path dedup — avoids QI + find_cef_panel_host per Present. */
+    LONG   last_black; /* NEUTRON round-34 ztree diag: latest readback classification
+                        * (-1 unknown, 0 has-content, 1 black/uniform). Diag-only. */
+    ULONGLONG last_blit_ms; /* NEUTRON round-38: CEF blit fps cap bookkeeping */
+    BOOL   no_blit; /* NEUTRON round-35 NATIVE mode: same-proc window presents its own
+                     * Vulkan subsurface natively; keep the registration (ztree diag /
+                     * A-B revert) but perform NO readback and NO GDI blit for it. */
     BOOL   t_first_present; /* NEUTRON cold-start timing: first present observed */
     BOOL   t_first_deliver; /* NEUTRON cold-start timing: first frame delivered to shared mem */
     ID3D11Texture2D *staging; /* NEUTRON perf: cached staging texture, recreated only on size change */
@@ -259,8 +275,96 @@
     if (swapchain) IDXGISwapChain_Release(swapchain);
 }
 
+/* NEUTRON GPU-D2D-UI DIAG (env NEUTRON_D2DUI_DIAG=1): trace the register->blit
+ * dispatch so we can see why the same-process D2D-UI windows are never blitted.
+ * Inert unless the env var is set. */
+static int neutron_d2dui_diag(void)
+{
+    static int v = -1;
+    if (v < 0) { char b[8]; v = (GetEnvironmentVariableA("NEUTRON_D2DUI_DIAG", b, sizeof(b)) && b[0]=='1') ? 1 : 0; }
+    return v;
+}
+
+/* NEUTRON round-35 NATIVE mode (env NEUTRON_DCOMP_NATIVE=1): same-process D2D-UI
+ * windows present their own Vulkan client subsurfaces natively (winewayland
+ * NEUTRON_NATIVE_STACK orders them per win32 z). The same-proc bridge becomes
+ * DORMANT: register only (ztree diag + easy A/B revert), NO __wine_dcomp_blit
+ * mark, NO bounded-acquire stamp, NO readback, NO GDI blit. The cross-process
+ * CEF/CEP shared-mem path is unchanged (those genuinely need the bridge). */
+static int neutron_dcomp_native(void)
+{
+    static int v = -1;
+    if (v < 0) { char b[8]; v = (GetEnvironmentVariableA("NEUTRON_DCOMP_NATIVE", b, sizeof(b)) && b[0]=='1') ? 1 : 0; }
+    return v;
+}
+
+/* NEUTRON round-38 (separable perf piece): cap the cross-proc CEF/CEP readback+
+ * blit rate. The Captioneer/home CEF panel render-loops at 60fps, forcing full-
+ * panel GPU readback + shm copy + GDI blit + surface flush each frame (~1.3-6
+ * GB/s of memory/bus traffic, the round-37 trace's dominant measured cost).
+ * Env NEUTRON_CEF_MAX_FPS=N (0/unset = uncapped). */
+static int neutron_cef_max_fps(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        char b[16];
+        v = (GetEnvironmentVariableA("NEUTRON_CEF_MAX_FPS", b, sizeof(b))) ? atoi(b) : 0;
+        if (v < 0) v = 0;
+    }
+    return v;
+}
+
+/* NEUTRON bounded-acquire handshake (round 32). Private DXVK interface --
+ * must match INeutronBoundedAcquire in dxvk's dxgi_interfaces.h. We stamp
+ * every swapchain we readback-blit so DXVK bounds its otherwise-infinite WSI
+ * waits (image acquire / present fences / present-wait) for exactly those
+ * chains. Window-property marking cannot scope them: composition swapchains
+ * carry a DXVK-internal DUMMY hwnd, not the bridge-marked host, so DXVK's
+ * GetPropW(__wine_dcomp_blit) test never fires for them (round-31 finding).
+ * A COM stamp on the swapchain object itself is handle-independent. */
+DEFINE_GUID(IID_INeutronBoundedAcquire, 0xb5d0f6a1, 0x7c4e, 0x4d2a, 0x9b, 0x8e, 0x3f, 0x5a, 0x2c, 0x1d, 0x0e, 0x9f);
+
+typedef struct INeutronBoundedAcquire INeutronBoundedAcquire;
+struct INeutronBoundedAcquireVtbl
+{
+    HRESULT (STDMETHODCALLTYPE *QueryInterface)(INeutronBoundedAcquire *iface, REFIID riid, void **out);
+    ULONG   (STDMETHODCALLTYPE *AddRef)(INeutronBoundedAcquire *iface);
+    ULONG   (STDMETHODCALLTYPE *Release)(INeutronBoundedAcquire *iface);
+    HRESULT (STDMETHODCALLTYPE *SetBoundedAcquire)(INeutronBoundedAcquire *iface);
+};
+struct INeutronBoundedAcquire { const struct INeutronBoundedAcquireVtbl *lpVtbl; };
+
+/* Stamp a swapchain as bridge-managed. Returns 1 if DXVK acknowledged. */
+static int neutron_stamp_bounded_acquire(IDXGISwapChain *swapchain)
+{
+    INeutronBoundedAcquire *ba = NULL;
+    if (SUCCEEDED(IDXGISwapChain_QueryInterface(swapchain, &IID_INeutronBoundedAcquire, (void **)&ba)) && ba)
+    {
+        ba->lpVtbl->SetBoundedAcquire(ba);
+        ba->lpVtbl->Release(ba);
+        return 1;
+    }
+    return 0;
+}
+
 static void blit_swapchain_to_hwnd(struct presentation *p)
 {
+    /* NEUTRON DIAG: log entry once per (hwnd,cross_proc) — proves whether blit is
+     * even called for the same-process D2D-UI windows. */
+    if (neutron_d2dui_diag())
+    {
+        static struct { HWND h; BOOL xp; } seen[64]; static int n;
+        HWND h = p->present_hwnd; int i; BOOL s = FALSE;
+        for (i = 0; i < n; i++) if (seen[i].h == h && seen[i].xp == p->cross_proc) { s = TRUE; break; }
+        if (!s && n < 64)
+        {
+            seen[n].h = h; seen[n++].xp = p->cross_proc;
+            ERR("neutron-d2dui: BLIT-ENTER hwnd=%p cross_proc=%d swapchain=%p\n", h, p->cross_proc, p->swapchain);
+        }
