+        /* NEUTRON workarea#2: fall back to the PERSISTED measurement before the estimate.
+         * The in-memory value is 0 in a freshly started desktop process -- nothing has been
+         * maximized yet -- so on a cold wineserver rc_work was still built from the 32px guess
+         * and the first launch came up wrong even with workarea#1 in place. */
         int mode_h = output_info->output->current_mode ?
                      output_info->output->current_mode->height : 0;
