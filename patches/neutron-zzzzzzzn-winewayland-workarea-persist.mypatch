          *
          * `measured` is the logical height the compositor last granted a maximized toplevel
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -1136,7 +1136,14 @@
          * Record it here, in the desktop process, because that is the only process that builds the
          * monitor list and therefore the only one whose copy of this value display.c will read.
          * Must be stored BEFORE the rebuild below, or the rebuild uses the stale estimate. */
-        if (wp) InterlockedExchange(&neutron_maximized_logical_h, (LONG)wp);
+        if (wp)
+        {
+            /* NEUTRON workarea#2: also persist it, so the NEXT desktop process starts with the
+             * real inset instead of the 32px estimate. Without this the first launch in a fresh
+             * wineserver is always built from the guess. */
+            if (InterlockedExchange(&neutron_maximized_logical_h, (LONG)wp) != (LONG)wp)
+                neutron_workarea_save_measured((int)wp);
+        }
         NtUserCallNoParam(NtUserCallNoParam_DisplayModeChanged);
         return 0;
     case WM_WAYLAND_CONFIGURE:
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -962,6 +962,20 @@
     if ((conf->state & WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED) &&
         (width < conf->width || height < conf->height))
     {
+        /* NEUTRON workarea#2: SAY SO. A maximized window even one surface pixel short of the
+         * compositor's configure can never satisfy this test, so nothing ever commits and the
+         * window is a permanently blank, unresizable rectangle -- with no error on any channel.
+         * That cost eleven rounds with a build tester in 2026-08 to diagnose, across ten dead
+         * log signatures, because this rejection was silent. The usual cause is the work-area
+         * inset in display.c disagreeing with what the compositor reserves. Rate-limited: the
+         * first one, then every 240th. */
+        static LONG rejects;
+        LONG n = InterlockedIncrement(&rejects);
+        if (n == 1 || !(n % 240))
+            ERR("neutron-workarea: REJECTED maximized config (n=%ld) -- window %dx%d is SMALLER "
+                "than the compositor's configure %dx%d (surface px), so this surface will not "
+                "commit and its window will stay blank. Suspect the work-area inset.\n",
+                (long)n, width, height, conf->width, conf->height);
         return FALSE;
     }
 
