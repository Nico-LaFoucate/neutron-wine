--- a/dlls/winewayland.drv/display.c
+++ b/dlls/winewayland.drv/display.c
@@ -248,6 +248,64 @@
     device_manager->add_source(output_info->output->name, state_flags, dpi, param);
 }
 
+/* NEUTRON workarea#2: persist the measured maximized inset across desktop-process restarts.
+ *
+ * workarea#1 carries the measurement from the app process to the desktop process, but only once
+ * something has actually been maximized. In a freshly started wineserver the desktop process
+ * builds the monitor list FIRST, with nothing maximized yet, so rc_work still came from the 32px
+ * estimate and the first launch was sized wrong -- the window that supplies the measurement has
+ * already been created by the time it arrives. Verified on the build tester's machine 2026-08-11:
+ * first launch not usable, second launch fine.
+ *
+ * A tiny file in the prefix fixes that for every launch after the first ever on a given machine.
+ * Deliberately not the registry: this code is unix-side and the driver has no registry access.
+ * Failure at any step is silent and simply leaves the estimate in place -- a diagnostic-grade
+ * store must never be able to break display enumeration. */
+#define NEUTRON_WORKAREA_PATH_MAX 1024
+
+static void neutron_workarea_path(char *buf, size_t len)
+{
+    const char *prefix = getenv("WINEPREFIX");
+    const char *home = getenv("HOME");
+
+    buf[0] = 0;
+    if (prefix && *prefix) snprintf(buf, len, "%s/.neutron-maximized-inset", prefix);
+    else if (home && *home) snprintf(buf, len, "%s/.wine/.neutron-maximized-inset", home);
+}
+
+int neutron_workarea_load_measured(void)
+{
+    static int cached = -1;   /* -1 = not read yet, 0 = absent/unusable */
+    char path[NEUTRON_WORKAREA_PATH_MAX];
+    FILE *f;
+    int v = 0;
+
+    if (cached >= 0) return cached;
+    cached = 0;
+    neutron_workarea_path(path, sizeof(path));
+    if (!path[0]) return 0;
+    if (!(f = fopen(path, "r"))) return 0;
+    if (fscanf(f, "%d", &v) != 1 || v <= 0 || v > 100000) v = 0;
+    fclose(f);
+    cached = v;
+    if (v) TRACE("neutron-workarea: loaded persisted measured=%d from %s\n", v, path);
+    return cached;
+}
+
+void neutron_workarea_save_measured(int logical_h)
+{
+    char path[NEUTRON_WORKAREA_PATH_MAX];
+    FILE *f;
+
+    if (logical_h <= 0) return;
+    neutron_workarea_path(path, sizeof(path));
+    if (!path[0]) return;
+    if (!(f = fopen(path, "w"))) return;
+    fprintf(f, "%d\n", logical_h);
+    fclose(f);
+    TRACE("neutron-workarea: persisted measured=%d to %s\n", logical_h, path);
+}
+
 static void wayland_add_device_monitor(const struct gdi_device_manager *device_manager,
                                        void *param, struct output_info *output_info)
 {
@@ -269,6 +327,10 @@
