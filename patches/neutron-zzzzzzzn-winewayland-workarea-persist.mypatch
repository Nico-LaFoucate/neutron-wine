+/* NEUTRON workarea#2: persist the measured inset across desktop-process restarts.
+ * Without this the FIRST launch in a fresh wineserver always builds rc_work from the 32px
+ * estimate, because nothing has been maximized yet -- the window that takes the measurement
+ * has already been sized wrong by the time it arrives. Confirmed on a build tester's machine
+ * 2026-08-11: first launch unusable, second launch fine. Load returns 0 when unknown. */
+int neutron_workarea_load_measured(void);
+void neutron_workarea_save_measured(int logical_h);
 BOOL wayland_surface_config_is_compatible(struct wayland_surface_config *conf,
