# neutron-dcomp-zzzz-direct-publish  (env NEUTRON_DCOMP_DIRECT=1 -- OFF BY DEFAULT)
#
# ORDERING: "zzzz" -- applies AFTER neutron-dcomp-zzz-d2dui-bridge, whose code it edits.
#
# ⛔ THIS WAS NAMED "zzz2" AND THAT WAS WRONG. It cost a build. "zzz2" sorts after "zzz-"
# in ASCII/C collation ('-'=0x2d < '2'=0x32) but wine-tkg enumerates userpatches under the
# SYSTEM LOCALE, which ignores punctuation at the primary level -- so it compared "zzz2..."
# against "zzzd2dui..." and '2' sorts before 'd'. This patch therefore applied BEFORE the
# bridge whose code it edits.
#
# What made it dangerous rather than merely broken: only hunk 3 FAILED. Hunks 1,2,4,5,6,7
# "succeeded" with fuzz 1-2 at offsets of -89 to -163 lines against the wrong base. A
# slightly luckier misapply would have produced a silently corrupted build.
#
# "zzzz" sorts last under BOTH collations. Verify any rename with
# preserved-fixes/harnesses/check-patch-order.py, which fails on exactly this class.
#
# WHAT IT FIXES
#   The cross-process CEP panel path copied every frame TWICE: the strided GPU staging was
#   repacked into a malloc'd `packed` buffer, and `packed` was then copied whole into the
#   shared buffer the owner process blits from. `packed` was a pure intermediate -- the
#   same shape as the WIC intermediate removed by neutron-zzz7-wic-readthrough.
#
#   Measured with the ucrtbase memmove probe over one Premiere zoom session:
#     blit_swapchain_to_hwnd+0xf92    863,511 calls   4.37 GB   (the repack, 5.3 KB rows)
#     blit_swapchain_to_hwnd+0x15c8       700 calls   4.37 GB   (the whole-buffer copy)
#   8.7 GB -- 9% of ALL copying in the process -- from ONE window. 1360x1233 x 4 bytes
#   x 700 frames matches the logged blit_swapchain_to_hwnd dimensions exactly, so the
#   attribution is confirmed rather than inferred.
#
# WHAT IT DOES
#   Copies straight from the mapped staging into the shared buffer. Two consequences:
#     * the whole-buffer copy disappears;
#     * so does the repack FOR REJECTED FRAMES -- the blank-rotation filter must decide
#       before overwriting the last good frame, and it now samples the mapped texture
#       directly, so a rejected frame costs a few scattered reads instead of a full 6.5 MB
#       repack. The old code always paid the repack even when it then threw the frame away.
#
#   The same-process path still builds `packed`: StretchDIBits needs tightly-packed rows
#   and the GPU staging pitch is padded, so that repack is genuinely required.
#
# WHY IT IS SAFE
#   * The work done UNDER THE D3D DEVICE LOCK is unchanged in size -- one full-frame copy
#     either way. What disappears is the copy that ran outside the lock. This matters: the
#     round-32 freeze was a leaked shared D3D10 device lock, and the surrounding code has
#     hard rules about what may run under it. The file-mapping creation is hoisted OUT of
#     the readback so it never happens under the lock.
#   * The raw copy from mapped memory stays inside the existing __EXCEPT_PAGE_FAULT guard,
#     and the guard still skips no unlock (Unmap and Leave run after __ENDTRY on both
#     paths).
#
# ⚠️ ONE DELIBERATE BEHAVIOUR CHANGE. Today a fault mid-readback leaves the shared buffer
# holding the previous good frame; writing directly means a fault can leave it torn until
# the next good frame (~1/6 s at the capped CEF rate). Faults are rare and already logged
# as "dropping frame". This is NOT a new race: the producer already overwrote the shared
# buffer while the consumer could be blitting from it. Gated off by default so it can be
# A/B'd against exactly this.
#
# ⚠️ A BUG THIS ALMOST SHIPPED WITH: the "already delivered, skip the rest" test was first
# keyed on the shared buffer merely EXISTING. A frame larger than that buffer skips the
# direct path and must still be published by the packed path -- keying on existence
# silently dropped those frames. It is keyed on `direct_used` instead.
#
# ⚠️ FOLLOW-UP: THE SHARED BUFFER IS NOW DOUBLE-BUFFERED (same day).
# Measured win first: dcomp's share of process copy traffic fell 22.7% -> 9.7%, normalised
# for session length.
#
# A "Captioneer panel flicker" was reported after the first run with this on, and the
# first guess was tearing -- the consumer blits straight out of the shared buffer, and this
# patch stretched the write from one ~1 ms 6.5 MB memcpy to ~1.6 ms of strided row copies,
# so a half-written frame could be blitted more often.
#
# ⛔ THAT GUESS IS NOT SUPPORTED BY WHAT WAS ACTUALLY SEEN, and the write-up here originally
# claimed it was. The reported symptom is NOT whole-panel tearing: it is an animated caution
# symbol flickering and a broken UI animation when clicking Activate -- specific widgets
# misbehaving, which is what CEF animation delivery looks like, not what a torn blit looks
# like (that would be bands across the whole panel). The symptom has NOT been attributed,
# has NOT been shown to be caused by this patch, and may well be pre-existing like the
# Project-tab thumbnail flicker was. It is parked, not fixed.
#
# The double buffer is kept anyway, on its own merits: the producer really did overwrite
# the shared buffer while the consumer could be blitting from it, both before and after
# this patch. Two slots removes that race outright instead of narrowing it. That is a
# correctness improvement -- it is NOT a fix for the reported flicker, and must not be
# described as one.
#
# ⛔ THE CONSUMER MUST BE STAGED TOO -- neutron-zzz8-winewayland-pxdouble.mypatch. The
# layout is duplicated in dlls/winewayland.drv/dllmain.c and both sides must agree. A new
# producer with an old consumer is not corrupt (the consumer just always reads slot 0, so
# the panel updates at half rate), but it is wrong. Every staging script now carries the
# pair together.
--- a/dlls/dcomp/device.c
+++ b/dlls/dcomp/device.c
@@ -136,15 +136,29 @@
  * so the subsurface actually commits. */
 #define NEUTRON_PX_MAXW 4096
 #define NEUTRON_PX_MAXH 2304
+/* NEUTRON DOUBLE BUFFER. The consumer blits straight out of this mapping, so a frame
+ * written in place can be blitted half-updated -- the producer writes ~6.5 MB while the
+ * consumer may be mid-StretchDIBits. That was always possible; publishing directly from
+ * the mapped staging (neutron-dcomp-zzz2-direct-publish) widened the write from one ~1 ms
+ * memcpy to ~1.6 ms of strided row copies and made it VISIBLE as panel flicker.
+ *
+ * So: two slots. The producer fills the one the consumer is NOT reading and then publishes
+ * the index atomically, which removes the tear entirely rather than narrowing it -- better
+ * than the behaviour that predated the direct publish.
+ *
+ * `active` reuses the old `reserved` field, so the header layout is unchanged; only the
+ * pixel area doubles. Producer and consumer MUST be staged together (the mapping size and
+ * the meaning of that field both change). */
 struct neutron_px_shbuf
 {
     LONG  seq;      /* bumped after each fully-written frame */
     LONG  width;
     LONG  height;
-    LONG  reserved;
-    BYTE  pixels[1]; /* width*height*4, BGRA top-down */
+    LONG  active;   /* slot the consumer should read: 0 or 1 (was `reserved`) */
+    BYTE  pixels[1]; /* two slots of NEUTRON_PX_SLOT, BGRA top-down */
 };
-#define NEUTRON_PX_BYTES (sizeof(struct neutron_px_shbuf) + (SIZE_T)NEUTRON_PX_MAXW * NEUTRON_PX_MAXH * 4)
+#define NEUTRON_PX_SLOT  ((SIZE_T)NEUTRON_PX_MAXW * NEUTRON_PX_MAXH * 4)
+#define NEUTRON_PX_BYTES (sizeof(struct neutron_px_shbuf) + 2 * NEUTRON_PX_SLOT)
 
 #define NEUTRON_REG_MAX 64
 struct neutron_registry
@@ -348,6 +362,75 @@
     return 0;
 }
 
+/* ---- NEUTRON DCOMP DIRECT PUBLISH (env NEUTRON_DCOMP_DIRECT=1) --------------
+ * The cross-process path copied every frame TWICE: the strided GPU staging was repacked
+ * into a malloc'd `packed` buffer, and `packed` was then copied whole into the shared
+ * buffer the owner process blits from. `packed` is a pure intermediate.
+ *
+ * Measured (ucrtbase memmove probe, one Premiere zoom session): 4.37 GB in the repack
+ * (863,511 row copies) plus 4.37 GB in the whole-buffer copy (700 x 6.5 MB) -- 8.7 GB, 9%
+ * of all the copying in the process, from ONE window.
+ *
+ * Copying straight from the mapped staging into the shared buffer removes the second copy.
+ * It also removes the FIRST one for rejected frames: the blank-rotation filter has to
+ * decide before overwriting the last good frame, and it can sample the mapped texture
+ * directly, so a frame that gets rejected now costs a few scattered reads instead of a
+ * full repack.
+ *
+ * The lock hold does not grow: the copy that runs under the D3D device lock is the same
+ * size as before, and the out-of-lock copy is what disappears.
+ *
+ * ⚠️ ONE BEHAVIOUR CHANGE, DELIBERATE. Today a page fault mid-readback leaves the shared
+ * buffer holding the previous good frame. Writing directly means a fault can leave it
+ * torn until the next good frame (~1/6 s at the capped CEF rate). Faults here are rare
+ * and already logged as "dropping frame". Note this is not a NEW race: the producer
+ * already overwrote the shared buffer while the consumer might be blitting from it.
+ * Gated off by default so it can be A/B'd against exactly this. */
+static int neutron_dcomp_direct(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        char b[8];
+        v = (GetEnvironmentVariableA("NEUTRON_DCOMP_DIRECT", b, sizeof(b)) && b[0] == '1') ? 1 : 0;
+    }
+    return v;
+}
+
+/* Create the shared pixel buffer if it does not exist yet. Hoisted out of the readback so
+ * it can run BEFORE the D3D device lock is taken -- file-mapping creation has no business
+ * happening under that lock. */
+static struct neutron_px_shbuf *neutron_px_ensure(struct presentation *p, HWND hwnd)
+{
+    if (!p->px_view)
+    {
+        WCHAR name[64];
+        neutron_px_name(hwnd, name);
+        p->px_map = CreateFileMappingW(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE,
+                                       (DWORD)(NEUTRON_PX_BYTES >> 32), (DWORD)NEUTRON_PX_BYTES, name);
+        if (p->px_map)
+            p->px_view = MapViewOfFile(p->px_map, FILE_MAP_WRITE, 0, 0, NEUTRON_PX_BYTES);
+        if (p->px_view) neutron_registry_add(hwnd);
+    }
+    return p->px_view;
+}
+
+/* Whole-frame variation of the MAPPED texture, same 40x40 dense grid as the packed-buffer
+ * filter it replaces -- the sparse dark main UI is wrongly rejected by a central-only
+ * grid, which once stuck the panel on the busier Welcome frame. */
+static int neutron_px_variation(const void *pixels, UINT pitch, UINT w, UINT h)
+{
+    const BYTE *base = pixels;
+    DWORD ref = *(const DWORD *)base;
+    int gx, gy, dd = 0;
+
+    for (gy = 0; gy < 40; gy++)
+        for (gx = 0; gx < 40; gx++)
+            if (*(const DWORD *)(base + (SIZE_T)(h * gy / 40) * pitch + (SIZE_T)(w * gx / 40) * 4) != ref)
+                dd++;
+    return dd;
+}
+
 static void blit_swapchain_to_hwnd(struct presentation *p)
 {
     /* NEUTRON DIAG: log entry once per (hwnd,cross_proc) — proves whether blit is
@@ -383,6 +466,11 @@
     LONG n;
     BOOL diag;
     BOOL mt_entered = FALSE, have_pixels = FALSE;
+    /* direct_used, NOT (direct_sh != NULL): the direct branch is also skipped for a frame
+     * larger than the shared buffer, and that frame must still be published by the packed
+     * path below. Keying the skip on direct_sh alone silently dropped those frames. */
+    BOOL direct_used = FALSE;
+    struct neutron_px_shbuf *direct_sh = NULL;
 
     n = InterlockedIncrement(&diag_n);
     diag = (n % 120 == 1);
@@ -443,6 +531,10 @@
                 }
             }
 
+            /* Before any D3D work, and therefore before the device lock. */
+            if (neutron_dcomp_direct() && p->cross_proc)
+                direct_sh = neutron_px_ensure(p, hwnd);
+
             if (FAILED(hr = IDXGISwapChain_GetBuffer(swapchain, 0, &IID_ID3D11Texture2D, (void **)&backbuffer)))
             {
                 if (diag) ERR("diag: GetBuffer failed hr %#lx\n", hr);
@@ -492,7 +584,58 @@
                         }
                         else
                         {
-                            if ((packed = malloc((SIZE_T)desc.Width * 4 * desc.Height)))
+                            if (direct_sh && desc.Width <= NEUTRON_PX_MAXW
+                                    && desc.Height <= NEUTRON_PX_MAXH)
+                            {
+                                direct_used = TRUE;
+                                /* Sample the mapped texture, and only copy if the frame is
+                                 * real -- a blank flip-rotation must leave the last good
+                                 * frame alone, and now costs nothing but the sampling. */
+                                volatile BOOL copy_ok = TRUE;
+                                volatile int dd = 0;
+                                __TRY
+                                {
+                                    dd = neutron_px_variation(map.pData, map.RowPitch,
+                                                              desc.Width, desc.Height);
+                                    if (dd >= 2)
+                                    {
+                                        BYTE *slot = (BYTE *)direct_sh->pixels
+                                                + (direct_sh->active ? 0 : NEUTRON_PX_SLOT);
+                                        UINT yy;
+                                        for (yy = 0; yy < desc.Height; yy++)
+                                            memcpy(slot + (SIZE_T)yy * desc.Width * 4,
+                                                   (BYTE *)map.pData + (SIZE_T)yy * map.RowPitch,
+                                                   (SIZE_T)desc.Width * 4);
+                                    }
+                                }
+                                __EXCEPT_PAGE_FAULT
+                                {
+                                    static LONG raced_d;
+                                    LONG rn = InterlockedIncrement(&raced_d);
+                                    if (rn == 1 || !(rn % 240))
+                                        ERR("neutron dcomp: direct readback faulted (n=%ld), not publishing\n", rn);
+                                    copy_ok = FALSE;
+                                }
+                                __ENDTRY
+                                if (copy_ok && dd >= 2)
+                                {
+                                    direct_sh->width = desc.Width;
+                                    direct_sh->height = desc.Height;
+                                    /* Publish the slot BEFORE the seq bump: the consumer
+                                     * keys "is there a new frame" off seq, so it must never
+                                     * see a new seq pointing at the slot still being written. */
+                                    InterlockedExchange(&direct_sh->active, direct_sh->active ? 0 : 1);
+                                    InterlockedIncrement(&direct_sh->seq);
+                                    if (!p->t_first_deliver)
+                                    {
+                                        p->t_first_deliver = TRUE;
+                                        ERR("neutron-time: sc=%p host=%p FIRST-DELIVER(direct) tick=%llu dd=%d\n",
+                                            swapchain, hwnd, GetTickCount64(), dd);
+                                    }
+                                }
+                                have_pixels = copy_ok;
+                            }
+                            else if ((packed = malloc((SIZE_T)desc.Width * 4 * desc.Height)))
                             {
                                 /* volatile: its post-__TRY value must survive a fault */
                                 volatile BOOL copy_ok = TRUE;
@@ -560,7 +703,12 @@
         goto done;
     }
 
-    if (packed && p->cross_proc)
+    if (direct_used)
+    {
+        /* Already delivered (or deliberately withheld as a blank rotation) straight from
+         * the mapped staging -- nothing further to copy. */
+    }
+    else if (packed && p->cross_proc)
     {
         /* NEUTRON cross-process CEP panel: hand the pixels to the owner process via shared memory;
          * winewayland's consumer thread (owner-side) blits + flushes them. See struct neutron_px_shbuf. */
@@ -647,7 +795,9 @@
                 {
                     sh->width = desc.Width;
                     sh->height = desc.Height;
-                    memcpy(sh->pixels, packed, (SIZE_T)desc.Width * 4 * desc.Height);
+                    memcpy((BYTE *)sh->pixels + (sh->active ? 0 : NEUTRON_PX_SLOT),
+                           packed, (SIZE_T)desc.Width * 4 * desc.Height);
+                    InterlockedExchange(&sh->active, sh->active ? 0 : 1);
                     InterlockedIncrement(&sh->seq);
                     if (!p->t_first_deliver)
                     {
