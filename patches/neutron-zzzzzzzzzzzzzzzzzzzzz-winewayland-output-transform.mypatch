-        int mode_h = output_info->output->current_mode ?
-                     output_info->output->current_mode->height : 0;
+        int mode_h = output_info->output->current_mode ? output_info_height(output_info) : 0;
         int logical_h = output_info->output->logical_h;
         int logical_inset = 32; /* fallback: KWin/Breeze titlebar ~= this */
         int inset;
@@ -427,15 +440,35 @@
     device_manager->add_monitor(&monitor, param);
 }
 
-static void populate_devmode(struct wayland_output_mode *output_mode, DEVMODEW *mode)
+/* NEUTRON (Neutron#20): Wayland transforms, like RandR rotations, are counter-clockwise; winex11 maps
+ * RR_Rotate_90 to DMDO_90, so do the same. Windows has no mirrored orientations: a flipped transform
+ * reports its rotation. */
+static DWORD wayland_output_orientation(int transform)
+{
+    switch (transform)
+    {
+    case WL_OUTPUT_TRANSFORM_90:
+    case WL_OUTPUT_TRANSFORM_FLIPPED_90: return DMDO_90;
+    case WL_OUTPUT_TRANSFORM_180:
+    case WL_OUTPUT_TRANSFORM_FLIPPED_180: return DMDO_180;
+    case WL_OUTPUT_TRANSFORM_270:
+    case WL_OUTPUT_TRANSFORM_FLIPPED_270: return DMDO_270;
+    default: return DMDO_DEFAULT;
+    }
+}
+
+/* NEUTRON (Neutron#20): every mode is reported in the output's current orientation (a Wayland client
+ * cannot rotate an output, so there are no other orientations to list). */
+static void populate_devmode(const struct wayland_output_state *output, struct wayland_output_mode *output_mode,
+                             DEVMODEW *mode)
 {
     mode->dmFields = DM_DISPLAYORIENTATION | DM_BITSPERPEL | DM_PELSWIDTH | DM_PELSHEIGHT |
                      DM_DISPLAYFLAGS | DM_DISPLAYFREQUENCY;
-    mode->dmDisplayOrientation = DMDO_DEFAULT;
+    mode->dmDisplayOrientation = wayland_output_orientation(output->transform);
     mode->dmDisplayFlags = 0;
     mode->dmBitsPerPel = 32;
-    mode->dmPelsWidth = output_mode->width;
-    mode->dmPelsHeight = output_mode->height;
+    mode->dmPelsWidth = wayland_output_mode_width(output, output_mode);
+    mode->dmPelsHeight = wayland_output_mode_height(output, output_mode);
     /* Round the refresh rate to calculate the win32 display frequency. */
     mode->dmDisplayFrequency = (output_mode->refresh + 500) / 1000;
 }
@@ -450,7 +483,7 @@
     if (!(modes = malloc(output_info->output->modes_count * sizeof(*modes))))
         return;
 
-    populate_devmode(output_info->output->current_mode, &current);
+    populate_devmode(output_info->output, output_info->output->current_mode, &current);
     current.dmFields |= DM_POSITION;
     current.dmPosition.x = output_info->x;
     current.dmPosition.y = output_info->y;
@@ -459,7 +492,7 @@
                       struct wayland_output_mode, entry)
     {
         DEVMODEW mode = {.dmSize = sizeof(mode)};
-        populate_devmode(output_mode, &mode);
+        populate_devmode(output_info->output, output_mode, &mode);
         modes[modes_count++] = mode;
     }
 
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -286,6 +286,9 @@
     char *name;
     int logical_x, logical_y;
     int logical_w, logical_h;
+    /* NEUTRON (Neutron#20): wl_output.geometry transform (WL_OUTPUT_TRANSFORM_*). Mode sizes are in the
+     * output's hardware orientation; see wayland_output_mode_width(). */
+    int transform;
     /* NEUTRON: the output's arranged position in the Win32 physical-pixel desktop space
      * (device px, matching win32u's monitor rc_monitor origin). Filled by the display-device
      * update after overlap resolution; used to reposition a window onto this output's monitor
@@ -463,6 +466,30 @@
  *          Wayland output
  */
 
+/* NEUTRON (Neutron#20): wl_output.mode sizes are in the output's hardware orientation, BEFORE its transform:
+ * a 2560x1440 monitor turned to portrait still reports a 2560x1440 mode, with a 1440x2560 logical size.
+ * Windows describes a rotated display in the desktop's orientation (dmPelsWidth/Height swapped,
+ * dmDisplayOrientation DMDO_90/DMDO_270), as winex11 does for RandR rotations. Every mode size that
+ * reaches win32u -- monitor rects, the arrangement, the per-monitor dpi, the mode list -- goes
+ * through these. */
+static inline BOOL wayland_output_transform_swaps_wh(int transform)
+{
+    return transform == WL_OUTPUT_TRANSFORM_90 || transform == WL_OUTPUT_TRANSFORM_270 ||
+           transform == WL_OUTPUT_TRANSFORM_FLIPPED_90 || transform == WL_OUTPUT_TRANSFORM_FLIPPED_270;
+}
+
+static inline int wayland_output_mode_width(const struct wayland_output_state *state,
+                                            const struct wayland_output_mode *mode)
+{
+    return wayland_output_transform_swaps_wh(state->transform) ? mode->height : mode->width;
+}
+
+static inline int wayland_output_mode_height(const struct wayland_output_state *state,
+                                             const struct wayland_output_mode *mode)
+{
+    return wayland_output_transform_swaps_wh(state->transform) ? mode->width : mode->height;
+}
+
 BOOL wayland_output_create(uint32_t id, uint32_t version);
 void wayland_output_destroy(struct wayland_output *output);
 void wayland_output_use_xdg_extension(struct wayland_output *output);
