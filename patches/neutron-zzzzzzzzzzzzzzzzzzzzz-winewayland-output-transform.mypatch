winewayland: report rotated (portrait) monitors in the desktop's orientation (GitHub Neutron#20)

A monitor turned to portrait was reported landscape. wl_output.mode gives the size in the panel's hardware
orientation, before the output transform, and the driver never read the transform: a 1080x1920 portrait screen
became a 1920x1080 monitor at 96 * 1920/1080 = 171 dpi, overlapped its neighbor and pushed it sideways. Illustrator
2026 on the landscape screen beside it then drew its menus at 96/171 of their size inside an oversized white pop-up
(at Wine 150% the pop-up also opened away from the menu bar), and Wine's own windows were scaled wrong.

The transform from wl_output.geometry is now kept per output, and every mode size that reaches win32u goes through
wayland_output_mode_width/height(): the arrangement, the monitor rect, the per-monitor dpi, the work-area inset and
the mode list. Modes carry dmDisplayOrientation (DMDO_90/180/270, counter-clockwise like RandR, as winex11 maps
them; flipped transforms report their rotation). Unrotated outputs are unchanged.

ORDERING: applies AFTER neutron-zzzzzzzzzzzzzy-winewayland-primary-monitor-origin and
neutron-zzzzzzzzzzi-winewayland-geom-trace, which edit the same display.c code.
Kill switch NEUTRON_OUTPUT_TRANSFORM=0. Harness: preserved-fixes/harnesses/monitors.c (dpi column) under
preserved-fixes/harnesses/kwin-nested/start.sh (two virtual outputs, one rotated).

--- a/dlls/winewayland.drv/display.c
+++ b/dlls/winewayland.drv/display.c
@@ -57,12 +57,25 @@
     return strcmp(a->output->name, b->output->name);
 }
 
+/* NEUTRON (Neutron#20): an output's size in the desktop's orientation (its mode size after the output
+ * transform). A portrait monitor's raw mode is landscape; used raw, it overlapped its neighbor, pushed it
+ * sideways, and came out at 96 * 2560/1440 = 171 dpi. */
+static inline int output_info_width(const struct output_info *info)
+{
+    return wayland_output_mode_width(info->output, info->output->current_mode);
+}
+
+static inline int output_info_height(const struct output_info *info)
+{
+    return wayland_output_mode_height(info->output, info->output->current_mode);
+}
+
 static inline BOOL output_info_overlap(struct output_info *a, struct output_info *b)
 {
-    return b->x < a->x + a->output->current_mode->width &&
-           b->x + b->output->current_mode->width > a->x &&
-           b->y < a->y + a->output->current_mode->height &&
-           b->y + b->output->current_mode->height > a->y;
+    return b->x < a->x + output_info_width(a) &&
+           b->x + output_info_width(b) > a->x &&
+           b->y < a->y + output_info_height(a) &&
+           b->y + output_info_height(b) > a->y;
 }
 
 /* Map a point to one of the four quadrants of our 2d coordinate space:
@@ -144,16 +157,16 @@
             rel_x = (move->output->logical_x - anchor->output->logical_x +
                      (x_use_end ? move->output->logical_w : 0)) /
                     (double)anchor->output->logical_w;
-            move->x = anchor->x + anchor->output->current_mode->width * rel_x -
-                      (x_use_end ? move->output->current_mode->width : 0);
+            move->x = anchor->x + output_info_width(anchor) * rel_x -
+                      (x_use_end ? output_info_width(move) : 0);
 
             /* Similarly for the Y axis. */
             y_use_end = move->output->logical_y < anchor->output->logical_y;
             rel_y = (move->output->logical_y - anchor->output->logical_y +
                      (y_use_end ? move->output->logical_h : 0)) /
                     (double)anchor->output->logical_h;
-            move->y = anchor->y + anchor->output->current_mode->height * rel_y -
-                      (y_use_end ? move->output->current_mode->height : 0);
+            move->y = anchor->y + output_info_height(anchor) * rel_y -
+                      (y_use_end ? output_info_height(move) : 0);
         }
     }
 
@@ -265,7 +278,7 @@
      * everywhere (which makes a per-monitor-aware app render 1.7x too large on the 1080p). Falls back
      * to the system dpi until the compositor has advertised the output's logical size. */
     UINT dpi = NtUserGetSystemDpiForProcess( NULL );
-    int mode_w = output_info->output->current_mode ? output_info->output->current_mode->width : 0;
+    int mode_w = output_info->output->current_mode ? output_info_width(output_info) : 0;
     int logical_w = output_info->output->logical_w;
     if (mode_w > 0 && logical_w > 0)
         dpi = (UINT)((96.0 * mode_w) / logical_w + 0.5);
@@ -338,8 +351,8 @@
