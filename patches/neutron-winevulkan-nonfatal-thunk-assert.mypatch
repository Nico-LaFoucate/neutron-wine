# neutron-winevulkan-nonfatal-thunk-assert
#
# winevulkan's generated loader thunks (dlls/winevulkan/loader_thunks.c, emitted by make_vulkan) end
# each non-perf-critical thunk with  assert(!status && "<fn>")  on the UNIX-DISPATCH NTSTATUS -- NOT
# the VkResult. Release (NDEBUG) builds no-op assert(); this TkG/staging build keeps asserts LIVE, so a
# transient non-zero dispatch status -- seen on vkQueueSubmit2 from vkd3d-proton while the Photoshop
# canvas renders -- aborts the ENTIRE host app ("MS Visual C++ Runtime / Assertion failed ...
# !status && \"vkQueueSubmit2\""). Make those thunk asserts non-fatal-but-logged (release-equivalent):
# report via the vulkan debug channel and continue (caller vkd3d-proton handles the VkResult) instead
# of crashing. Anchored on the stable WINE_DEFAULT_DEBUG_CHANNEL(vulkan) line so it re-applies across
# Wine rebases; independent of any Adobe app version. Pure Neutron-Wine source.
diff --git a/dlls/winevulkan/loader_thunks.c b/dlls/winevulkan/loader_thunks.c
index 2438a7ef2e9..828c2a4da2a 100644
--- a/dlls/winevulkan/loader_thunks.c
+++ b/dlls/winevulkan/loader_thunks.c
@@ -19,6 +19,12 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(vulkan);
 
+/* Neutron: never abort the host app on a non-zero unix-dispatch status in the generated thunks.
+ * Release (NDEBUG) builds no-op these asserts; preserve that so a transient vkQueueSubmit2 (or any
+ * thunk) dispatch error is logged and handled by the caller instead of crashing the app. */
+#undef assert
+#define assert(expr) do { if (!(expr)) WARN("winevulkan thunk: %s\n", #expr); } while (0)
+
 VkResult WINAPI vkAcquireNextImage2KHR(VkDevice device, const VkAcquireNextImageInfoKHR *pAcquireInfo, uint32_t *pImageIndex)
 {
     struct vkAcquireNextImage2KHR_params params;
