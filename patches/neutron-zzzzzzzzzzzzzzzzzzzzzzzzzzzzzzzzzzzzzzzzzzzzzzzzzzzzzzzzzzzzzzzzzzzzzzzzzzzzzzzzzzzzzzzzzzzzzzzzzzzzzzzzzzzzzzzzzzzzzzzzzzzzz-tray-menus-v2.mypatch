 }
 
 /* the explorer thread that services every connection (started from dllmain.c in explorer only) */
+/* NEUTRON tray-menus-v2: the ContextMenu probe ends (no Win32 menu came: the application shows its own), and an icon
+ * whose application showed a Win32 menu is announced again with the dbusmenu, under a new name so the tray reads its
+ * Menu again; called without sni_mutex */
+static BOOL context_timeouts(void)
+{
+    struct { HWND owner; UINT request; } expired[16];
+    struct { UINT handle; DBusConnection *old; char name[64]; BOOL visible; } moved[16];
+    unsigned int i, expired_count = 0, moved_count = 0;
+    struct sni_icon *icon;
+    ULONGLONG now = sni_ticks();
+    BOOL active = FALSE;
+
+    pthread_mutex_lock( &sni_mutex );
+    LIST_FOR_EACH_ENTRY( icon, &sni_icons, struct sni_icon, entry )
+    {
+        if (icon->context_request)
+        {
+            active = TRUE;
+            if (now >= icon->context_deadline && expired_count < ARRAY_SIZE(expired))
+            {
+                expired[expired_count].owner = icon->owner;
+                expired[expired_count++].request = icon->context_request;
+                icon->context_request = 0;
+            }
+        }
+        if (icon->switch_pending && moved_count < ARRAY_SIZE(moved))
+        {
+            icon->switch_pending = FALSE;
+            icon->use_dbusmenu = TRUE;
+            icon->generation++;
+            snprintf( icon->name, sizeof(icon->name), "org.kde.StatusNotifierItem-%u-%u-%u",
+                      (UINT)getpid(), icon->handle, icon->generation );
+            moved[moved_count].handle = icon->handle;
+            moved[moved_count].old = icon->conn;
+            moved[moved_count].visible = !icon->hidden;
+            strcpy( moved[moved_count].name, icon->name );
+            icon->conn = NULL;
+            moved_count++;
+        }
+    }
+    pthread_mutex_unlock( &sni_mutex );
+
+    for (i = 0; i < expired_count; i++)
+        if (HandleToUlong( NtUserGetProp( expired[i].owner, menu_propW )) == expired[i].request)
+            NtUserRemoveProp( expired[i].owner, menu_propW );
+
+    for (i = 0; i < moved_count; i++)
+    {
+        DBusConnection *conn = NULL;
+
+        close_connection( moved[i].old );
+        if (moved[i].visible) conn = register_item( moved[i].handle, moved[i].name );
+        pthread_mutex_lock( &sni_mutex );
+        if (conn && (icon = find_icon_by_handle( moved[i].handle )) && !icon->hidden && !icon->conn)
+        {
+            icon->conn = conn;
+            icon->menu.registered_at = sni_ticks();
+            conn = NULL;
+        }
+        pthread_mutex_unlock( &sni_mutex );
+        close_connection( conn );
+        TRACE( "item %u announced again as %s with the dbusmenu\n", moved[i].handle, moved[i].name );
+    }
+    return active;
+}
+
