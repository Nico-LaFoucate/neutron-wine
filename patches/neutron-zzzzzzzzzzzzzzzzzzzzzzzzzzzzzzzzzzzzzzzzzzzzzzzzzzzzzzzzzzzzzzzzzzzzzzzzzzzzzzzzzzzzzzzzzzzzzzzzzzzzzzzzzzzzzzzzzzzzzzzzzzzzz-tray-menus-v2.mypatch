+/* NEUTRON tray-menus-v2: on Plasma a tray menu that is not a Win32 menu (Qt's QMenu, a popup window of the
+ * application's own) cannot be drawn by the tray, and the dbusmenu request carries no click point, so such a menu
+ * opened at a stale cursor and left Plasma an empty menu that ate the next click. Plasma calls ContextMenu(x, y) for an
+ * item whose Menu is "/NO_DBUSMENU": the application then gets the click point, as on Windows, and puts its menu there
+ * (a layer surface, window.c). So on Plasma an icon starts that way, and moves to the dbusmenu (Plasma draws the menu at
+ * the icon) once its application has shown a Win32 menu. Other trays (GNOME's extension, XFCE, waybar) only offer the
+ * dbusmenu: unchanged. Needs the layer placement (NEUTRON_TRAY_POPUP_LAYER) and the dbusmenu (NEUTRON_SNI_DBUSMENU). */
+static BOOL sni_kde_context(void)
+{
+    static int kde = -1;
+    if (kde < 0) { const char *d = getenv( "XDG_CURRENT_DESKTOP" ); kde = d && strstr( d, "KDE" ); }
+    return kde && sni_dbusmenu_enabled() && wayland_tray_popup_layer_enabled();
+}
