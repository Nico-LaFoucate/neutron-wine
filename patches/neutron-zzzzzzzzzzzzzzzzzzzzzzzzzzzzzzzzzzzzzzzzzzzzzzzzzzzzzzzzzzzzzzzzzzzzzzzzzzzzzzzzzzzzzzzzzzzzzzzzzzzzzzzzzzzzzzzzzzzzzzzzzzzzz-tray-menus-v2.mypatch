+/* NEUTRON tray-menus-v2: record on the desktop window that this click goes to the owner's process now; the menu that
+ * process shows for it becomes a layer surface at its own position (window.c wayland_tray_popup_wanted) */
+static void mark_tray_click( HWND owner )
+{
+    static const WCHAR pid_propW[] = NEUTRON_TRAY_POPUP_PID_PROP_INIT;
+    static const WCHAR time_propW[] = NEUTRON_TRAY_POPUP_TIME_PROP_INIT;
+    HWND desktop = NtUserGetDesktopWindow();
+    DWORD pid = 0;
+
+    if (!wayland_tray_popup_layer_enabled() || !NtUserGetWindowThread( owner, &pid ) || !pid) return;
+    NtUserSetProp( desktop, time_propW, ULongToHandle( max( 1u, NtGetTickCount() )));
+    NtUserSetProp( desktop, pid_propW, ULongToHandle( pid ));
+}
+
