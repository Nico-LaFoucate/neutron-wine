--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -945,6 +945,192 @@
     ERR("Failed to assign popup role to wayland surface\n");
 }
 
+static struct wayland_output *neutron_output_at(int x, int y, BOOL logical);
+
+/**********************************************************************
+ *          NEUTRON tray-popup-layer
+ *
+ * On Windows an application opens its tray menu at the cursor: explorer puts the cursor on the icon before the tray
+ * callback, and the application (a Qt QMenu, a Win32 menu, a popup window of its own) places its window there. A
+ * Wayland client cannot place its windows: as an xdg_toplevel KWin centered such a menu, listed it in the taskbar,
+ * and sway/Hyprland tiled it (11-04, Filmora 16's Qt tray menu, a traytest Win32 menu).
+ *
+ * The first topmost captionless popup an application shows right after a tray click (wayland_tray_popup_wanted,
+ * window.c) is mapped as a zwlr_layer_shell_v1 surface where the compositor offers one (KWin, sway, Hyprland; not
+ * GNOME): on the overlay layer of its output, anchored top-left at the window's own Win32 position, keyboard focus
+ * on demand (protocol version 4) so Escape and the arrows reach it while a click elsewhere takes the focus away and
+ * the application closes its menu as it does on Windows when it loses the foreground. Never an exclusive keyboard
+ * grab and never a surface over the rest of the screen: a hung application must not hold the desktop. Kill switch
+ * NEUTRON_TRAY_POPUP_LAYER=0. */
+/* tray menus mapped as layers in this process: their submenus are tray menus too (window.c) */
+static LONG neutron_tray_layers;
+LONG wayland_tray_layer_count(void) { return ReadNoFence(&neutron_tray_layers); }
+
+struct neutron_layer_geometry
+{
+    struct wl_output *wl_output;
+    int margin_x, margin_y, width, height;
+};
+
+/* where a window rect (Win32 desktop, device pixels) lands on its output, in that output's logical coordinates */
+static BOOL neutron_layer_geometry(const RECT *rect, struct neutron_layer_geometry *g)
+{
+    struct wayland_output *output;
+    int raw_x = 0, raw_y = 0, raw_w = 0, raw_h = 0, logical_w = 0, logical_h = 0;
+
+    pthread_mutex_lock(&process_wayland.output_mutex);
+    if ((output = neutron_output_at(rect->left, rect->top, FALSE)) && output->current.current_mode)
+    {
+        const struct wayland_output_state *state = &output->current;
+        g->wl_output = output->wl_output;
+        raw_x = state->x;
+        raw_y = state->y;
+        raw_w = wayland_output_mode_width(state, state->current_mode);
+        raw_h = wayland_output_mode_height(state, state->current_mode);
+        logical_w = state->logical_w;
+        logical_h = state->logical_h;
+    }
+    pthread_mutex_unlock(&process_wayland.output_mutex);
+    if (raw_w <= 0 || raw_h <= 0 || logical_w <= 0 || logical_h <= 0) return FALSE;
+
+    g->margin_x = max(0, lround((double)(rect->left - raw_x) * logical_w / raw_w));
+    g->margin_y = max(0, lround((double)(rect->top - raw_y) * logical_h / raw_h));
+    g->width = max(1, lround((double)(rect->right - rect->left) * logical_w / raw_w));
+    g->height = max(1, lround((double)(rect->bottom - rect->top) * logical_h / raw_h));
+    return TRUE;
+}
+
+static void layer_surface_handle_configure(void *private, struct zwlr_layer_surface_v1 *layer_surface,
+                                           uint32_t serial, uint32_t width, uint32_t height)
+{
+    struct wayland_surface *surface;
+    struct wayland_win_data *data;
+    BOOL initial_configure;
+    HWND hwnd = private;
+
+    TRACE("hwnd=%p serial=%u %ux%u\n", hwnd, serial, width, height);
+
+    if (!(data = wayland_win_data_get(hwnd))) return;
+    if (!(surface = data->wayland_surface) || surface->layer_surface != layer_surface)
+    {
+        wayland_win_data_release(data);
+        return;
+    }
+    /* as a popup's: the size is the window's own; acked by the next reconfigure */
+    initial_configure = surface->current.serial == 0;
+    surface->processing.serial = serial;
+    surface->processing.width = width;
+    surface->processing.height = height;
+    surface->processing.processed = TRUE;
+    wayland_win_data_release(data);
+
+    if (initial_configure) NtUserExposeWindowSurface(hwnd, 0, NULL, 0);
+}
+
+static void layer_surface_handle_closed(void *private, struct zwlr_layer_surface_v1 *layer_surface)
+{
+    HWND hwnd = private;
+
+    /* the compositor took it away (its output went): end the menu as a lost capture would */
+    TRACE("hwnd=%p\n", hwnd);
+    NtUserPostMessage(hwnd, WM_CANCELMODE, 0, 0);
+}
+
+static const struct zwlr_layer_surface_v1_listener layer_surface_listener =
+{
+    layer_surface_handle_configure,
+    layer_surface_handle_closed,
+};
+
+/**********************************************************************
+ *          wayland_surface_make_layer
+ *
+ * NEUTRON tray-popup-layer: gives a tray menu the layer role at the window's own position; called again on a move
+ * of the window, it follows it (wayland_surface_reconfigure_layer follows size changes).
+ */
+void wayland_surface_make_layer(struct wayland_surface *surface, const RECT *rect)
+{
+    struct neutron_layer_geometry g;
+
+    if (surface->role == WAYLAND_SURFACE_ROLE_LAYER && surface->layer_surface)
+    {
+        if (surface->current.serial && neutron_layer_geometry(rect, &g) && g.wl_output == surface->layer_output &&
+            (g.margin_x != surface->layer_margin_x || g.margin_y != surface->layer_margin_y))
+        {
+            zwlr_layer_surface_v1_set_margin(surface->layer_surface, g.margin_y, 0, 0, g.margin_x);
+            surface->layer_margin_x = g.margin_x;
+            surface->layer_margin_y = g.margin_y;
+            wl_surface_commit(surface->wl_surface);
+            wl_display_flush(process_wayland.wl_display);
+        }
+        return;
+    }
+
+    wayland_surface_clear_role(surface);
+    surface->role = WAYLAND_SURFACE_ROLE_LAYER;
+
+    if (!process_wayland.zwlr_layer_shell_v1 || !neutron_layer_geometry(rect, &g)) goto err;
+
+    if (!(surface->layer_surface = zwlr_layer_shell_v1_get_layer_surface(process_wayland.zwlr_layer_shell_v1,
+                                                                         surface->wl_surface, g.wl_output,
+                                                                         ZWLR_LAYER_SHELL_V1_LAYER_OVERLAY,
+                                                                         "wine-tray-menu")))
+        goto err;
+    zwlr_layer_surface_v1_add_listener(surface->layer_surface, &layer_surface_listener, surface->hwnd);
+    zwlr_layer_surface_v1_set_anchor(surface->layer_surface,
+                                     ZWLR_LAYER_SURFACE_V1_ANCHOR_TOP | ZWLR_LAYER_SURFACE_V1_ANCHOR_LEFT);
+    /* placed from the output's edge, panels or not, as Windows places it from the screen's */
+    zwlr_layer_surface_v1_set_exclusive_zone(surface->layer_surface, -1);
+    zwlr_layer_surface_v1_set_margin(surface->layer_surface, g.margin_y, 0, 0, g.margin_x);
+    zwlr_layer_surface_v1_set_size(surface->layer_surface, g.width, g.height);
+    zwlr_layer_surface_v1_set_keyboard_interactivity(surface->layer_surface,
+        process_wayland.zwlr_layer_shell_v1_version >= 4 ? ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_ON_DEMAND
+                                                         : ZWLR_LAYER_SURFACE_V1_KEYBOARD_INTERACTIVITY_NONE);
+    surface->layer_output = g.wl_output;
+    surface->layer_margin_x = g.margin_x;
+    surface->layer_margin_y = g.margin_y;
+    surface->layer_width = g.width;
+    surface->layer_height = g.height;
+    InterlockedIncrement(&neutron_tray_layers);
+
+    TRACE("hwnd=%p rect=%s -> margins %d,%d size %dx%d\n", surface->hwnd, wine_dbgstr_rect(rect),
+          g.margin_x, g.margin_y, g.width, g.height);
+    wl_surface_commit(surface->wl_surface);
+    wl_display_flush(process_wayland.wl_display);
+    return;
+
+err:
+    wayland_surface_clear_role(surface);
+    ERR("Failed to assign the layer role to the tray menu %p\n", surface->hwnd);
+}
+
+/* NEUTRON tray-popup-layer: ack the configure and follow the window's moves and size; FALSE until configured */
+static BOOL wayland_surface_reconfigure_layer(struct wayland_surface *surface)
+{
+    struct neutron_layer_geometry g;
+
+    if (surface->processing.serial && surface->processing.processed)
+    {
+        surface->current = surface->processing;
+        memset(&surface->processing, 0, sizeof(surface->processing));
+        zwlr_layer_surface_v1_ack_configure(surface->layer_surface, surface->current.serial);
+    }
+    if (!surface->current.serial) return FALSE;
+
+    if (neutron_layer_geometry(&surface->window.rect, &g) && g.wl_output == surface->layer_output &&
+        (g.margin_x != surface->layer_margin_x || g.margin_y != surface->layer_margin_y ||
+         g.width != surface->layer_width || g.height != surface->layer_height))
+    {
+        zwlr_layer_surface_v1_set_margin(surface->layer_surface, g.margin_y, 0, 0, g.margin_x);
+        zwlr_layer_surface_v1_set_size(surface->layer_surface, g.width, g.height);
+        surface->layer_margin_x = g.margin_x;
+        surface->layer_margin_y = g.margin_y;
+        surface->layer_width = g.width;
+        surface->layer_height = g.height;
+    }
+    return TRUE;
+}
+
