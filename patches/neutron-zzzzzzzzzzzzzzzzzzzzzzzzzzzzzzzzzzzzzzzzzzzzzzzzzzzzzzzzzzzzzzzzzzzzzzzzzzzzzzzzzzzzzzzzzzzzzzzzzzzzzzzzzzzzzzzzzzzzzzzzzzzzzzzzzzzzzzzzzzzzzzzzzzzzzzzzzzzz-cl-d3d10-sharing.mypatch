opencl: implement cl_khr_d3d10_sharing on 135's cl_khr_d3d11_sharing machinery, so Affinity's raster engine uses the GPU

What was seen / why (app list, batch 1): Affinity 3.3.3 (Canva)
lists the GPU's OpenCL device and then "(Skipping unsupported device)"; Settings > Performance shows "Enable OpenCL
compute acceleration" switched off with no device, Help > Benchmark has no GPU scores: all raster work runs on the CPU.

Mechanism (SOLID, libraster.dll disassembly 0x1804fc8dc.. and 0x1804f9ad0..): libraster delay-loads OpenCL.dll and uses
a device only when its version is >= 1.2, its CL_DEVICE_EXTENSIONS list cl_khr_d3d10_sharing, and
clGetDeviceIDsFromD3D10KHR(platform, CL_D3D10_DXGI_ADAPTER_KHR, <its DXGI adapter>, CL_PREFERRED_DEVICES_FOR_D3D10_KHR)
returns it ("Could not get OpenCL devices for DXGI adapter!" otherwise). It never creates D3D10-shared objects: its
OpenCL work is plain buffers. Wine filtered the extension out and had no such entry point; 135 added only the D3D11 one.

Windows: NVIDIA's, AMD's and Intel's Windows OpenCL drivers list cl_khr_d3d10_sharing on GPU devices.

Fix (dlls/opencl/pe_d3d11.c, pe_wrappers.c, opencl_private.h), the same design as 135 because DXVK's Direct3D 10 device
and resources are views of its Direct3D 11 ones (QueryInterface goes both ways):
- cl_khr_d3d10_sharing is listed next to cl_khr_d3d11_sharing for GPU devices and platforms that have one;
  clGetExtensionFunctionAddress(ForPlatform) return clGetDeviceIDsFromD3D10KHR, clCreateFromD3D10Buffer/Texture2D/
  Texture3DKHR, clEnqueueAcquire/ReleaseD3D10ObjectsKHR.
- clGetDeviceIDsFromD3D10KHR: CL_D3D10_DEVICE_KHR (its IDXGIDevice's adapter) or CL_D3D10_DXGI_ADAPTER_KHR, then 135's
  adapter matching (PCI location via DXVK's interop adapter, UUID, vendor).
- CL_CONTEXT_D3D10_DEVICE_KHR: the D3D11 device behind the D3D10 one is kept with the context (CL_INVALID_D3D10_DEVICE_KHR
  for anything else; D3D10 + D3D11 devices together: CL_INVALID_OPERATION). Shared objects, acquire/release copies and
  lifetime are 135's; D3D10 objects need a D3D10 context and vice versa; CL_MEM_D3D10_RESOURCE_KHR /
  CL_IMAGE_D3D10_SUBRESOURCE_KHR answered; D3D10 error codes (-1002..-1005).
Kill switch: NEUTRON_DISABLE_CL_D3D10_SHARING=1 (only the D3D10 part; NEUTRON_DISABLE_CL_D3D11_SHARING keeps its meaning).

Not covered: everything 135 lists (copies, not zero copy; markers for events; ...); CL_CONTEXT_D3D10_PREFER_SHARED_
RESOURCES_KHR; cl_nv_d3d10_sharing names; clSVMAlloc/clSVMFree are still not exported (libraster delay-imports them:
a call would end in c06d007f; not seen on any lab path); 32-bit built, untested (no 32-bit host OpenCL here).

Lab evidence (11-06, desk z, NVIDIA RTX 5070 / driver 615.78 / OpenCL 3.0 CUDA 13.4.96; lab runtime 11.10-183c =
183rc + this opencl.dll + the mscms change; prefix PgI-acA; logs in team/affcolor/logs, seq2.txt, docab.txt):
- Conformance (test/cl-d3d10-11-conformance.c = clcore's 82 D3D11 checks + 27 D3D10 checks: both extension strings, the
  six entry points, device match by DXGI adapter (Affinity's call) and by D3D10 device, wrong set/device/both-API errors,
  D3D10 interop context, buffer D3D10 -> acquire -> CL -> kernel -> release -> D3D10, Texture2D RGBA8 67x33 both ways,
  D3D10 queries, -1004/-1005, cross-API refusals, device reference dropped): this build 109/109 n=2; kill switch 82 pass,
  D3D10 part absent (= 183rc, 82 pass, absent).
- Affinity: Log.txt "(Skipping unsupported device)" 0/0/0 on this build (o1-o3) vs 4/4 kill switch (ok1, ok2) and 4 on
  183rc; Settings > Performance "Enable OpenCL compute acceleration / NVIDIA GeForce RTX 5070" ON 3/3 vs OFF without a
  device 2/2 kill + 1/1 183rc; Help > Benchmark Raster (Single GPU) 28531 / 21916 / 28348, Combined (Single GPU)
  7987 / 7479 / 7850 vs N/A 2/2 kill. No crash, no c06d007f (0/5). New document view: this build vs kill switch
  pixel-identical 2/2 (docab).
- After Effects (claex's run.sh, lab spoof: runtime 11.10-183cs = 183c + this opencl.dll + clcore's NEUTRON_LAB spoof,
  fresh reflink AeX-acz of claex's AeX1): run 1 calder_ok 1 / CALDER-SUPPORTED (Advanced 3D offered), but a modal "After
  Effects warning: Direct2D Drawbot error. HRESULT: -2003238911" (0x88990001) sat over a black viewer, "ready" only after
  541 s (claex 12 s) and the render step never ran. Kill-switch arm: stuck behind "Crash Repair Options" from run 1's
  teardown (rig) -> NO A/B. AE is NOT verified for this patch (see report).

--- a/dlls/opencl/opencl_private.h
+++ b/dlls/opencl/opencl_private.h
@@ -32,6 +32,10 @@
 
 BOOL extension_is_supported( const char *name, size_t len );
 
+/* NEUTRON: the D3D sharing extensions pe_d3d11.c implements (bit mask) */
+#define D3D_SHARING_D3D11 1
+#define D3D_SHARING_D3D10 2
+
 #define OPENCL_CALL( func, params ) WINE_UNIX_CALL( unix_ ## func, params )
 
 #endif
--- a/dlls/opencl/pe_d3d11.c
+++ b/dlls/opencl/pe_d3d11.c
@@ -31,7 +31,13 @@
  * - OpenCL devices are matched to DXGI adapters by PCI location (Vulkan, through DXVK's interop interface, against
  *   cl_khr_pci_bus_info or the vendor's own device queries), then by device UUID, then by vendor.
  *
- * NEUTRON_DISABLE_CL_D3D11_SHARING=1 turns all of it off: the extension is not advertised again. */
+ * NEUTRON_DISABLE_CL_D3D11_SHARING=1 turns all of it off: the extension is not advertised again.
+ *
+ * cl_khr_d3d10_sharing is the same machinery for Direct3D 10 (Affinity's raster engine only uses an OpenCL device it
+ * can map to its DXGI adapter through clGetDeviceIDsFromD3D10KHR). DXVK's Direct3D 10 device and resources are views
+ * of its Direct3D 11 ones (QueryInterface goes both ways), so a D3D10 interop context keeps the D3D11 device behind the
+ * D3D10 one and its objects run through the D3D11 paths; only the entry points, the property, the queries and the
+ * error codes are the D3D10 ones. NEUTRON_DISABLE_CL_D3D10_SHARING=1 turns that part off. */
 
 #include <stdarg.h>
 #include <string.h>
@@ -61,6 +67,18 @@
 #define CL_MEM_D3D11_RESOURCE_KHR               0x401E
 #define CL_IMAGE_D3D11_SUBRESOURCE_KHR          0x401F
 
+#define CL_INVALID_D3D10_DEVICE_KHR             -1002
+#define CL_INVALID_D3D10_RESOURCE_KHR           -1003
+#define CL_D3D10_RESOURCE_ALREADY_ACQUIRED_KHR  -1004
+#define CL_D3D10_RESOURCE_NOT_ACQUIRED_KHR      -1005
+#define CL_D3D10_DEVICE_KHR                     0x4010
+#define CL_D3D10_DXGI_ADAPTER_KHR               0x4011
+#define CL_PREFERRED_DEVICES_FOR_D3D10_KHR      0x4012
+#define CL_ALL_DEVICES_FOR_D3D10_KHR            0x4013
+#define CL_CONTEXT_D3D10_DEVICE_KHR             0x4014
+#define CL_MEM_D3D10_RESOURCE_KHR               0x4015
+#define CL_IMAGE_D3D10_SUBRESOURCE_KHR          0x4016
+
 #define CL_DEVICE_UUID_KHR                      0x106A
 #define CL_DEVICE_PCI_BUS_INFO_KHR              0x410F
 #define CL_DEVICE_TOPOLOGY_AMD                  0x4037
@@ -94,7 +112,8 @@
 {
     struct list entry;
     cl_context context;           /* holds one host reference of ours */
-    ID3D11Device *device;
+    ID3D11Device *device;         /* for a D3D10 context, the D3D11 device behind the application's D3D10 one */
+    BOOL d3d10;                   /* created with CL_CONTEXT_D3D10_DEVICE_KHR */
     ID3D11DeviceContext *immediate;
     ID3D11Multithread *multithread;
     LONG mems;                    /* shared memory objects still alive */
@@ -190,6 +209,19 @@
     return enabled;
 }
 
+BOOL d3d10_sharing_enabled(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+    {
+        const char *env = getenv( "NEUTRON_DISABLE_CL_D3D10_SHARING" );
+        enabled = !(env && *env == '1');
+        if (!enabled) WARN( "cl_khr_d3d10_sharing disabled by NEUTRON_DISABLE_CL_D3D10_SHARING\n" );
+    }
+    return enabled;
+}
+
 static cl_int host_device_info( cl_device_id device, cl_device_info name, size_t size, void *value )
 {
     struct clGetDeviceInfo_params params = { device, name, size, value, NULL };
@@ -385,15 +417,54 @@
     return adapter;
 }
 
+static cl_int get_adapter_devices( cl_platform_id platform, IDXGIAdapter *adapter, cl_uint num_entries,
+                                   cl_device_id *devices, cl_uint *num_devices );
+
+static IDXGIAdapter *get_d3d10_device_adapter( ID3D10Device *device )
+{
+    IDXGIAdapter *adapter = NULL;
+    IDXGIDevice *dxgi_device;
+
+    if (SUCCEEDED(ID3D10Device_QueryInterface( device, &IID_IDXGIDevice, (void **)&dxgi_device )))
+    {
+        if (FAILED(IDXGIDevice_GetAdapter( dxgi_device, &adapter ))) adapter = NULL;
+        IDXGIDevice_Release( dxgi_device );
+    }
+    return adapter;
+}
+
+static cl_int WINAPI clGetDeviceIDsFromD3D10KHR( cl_platform_id platform, cl_uint source, void *object, cl_uint set,
+                                                 cl_uint num_entries, cl_device_id *devices, cl_uint *num_devices )
+{
+    IDXGIAdapter *adapter = NULL;
+    ID3D10Device *device;
+
+    TRACE( "(%p, %#x, %p, %#x, %u, %p, %p)\n", platform, source, object, set, num_entries, devices, num_devices );
+
+    if (set != CL_PREFERRED_DEVICES_FOR_D3D10_KHR && set != CL_ALL_DEVICES_FOR_D3D10_KHR) return CL_INVALID_VALUE;
+    if ((!num_entries && devices) || (!devices && !num_devices) || !object) return CL_INVALID_VALUE;
+
+    if (source == CL_D3D10_DEVICE_KHR)
+    {
+        if (FAILED(IUnknown_QueryInterface( (IUnknown *)object, &IID_ID3D10Device, (void **)&device )))
+            return CL_INVALID_VALUE;
+        adapter = get_d3d10_device_adapter( device );
+        ID3D10Device_Release( device );
+    }
+    else if (source == CL_D3D10_DXGI_ADAPTER_KHR)
+    {
+        if (FAILED(IUnknown_QueryInterface( (IUnknown *)object, &IID_IDXGIAdapter, (void **)&adapter )))
+            adapter = NULL;
+    }
+    if (!adapter) return CL_INVALID_VALUE;
+    return get_adapter_devices( platform, adapter, num_entries, devices, num_devices );
+}
+
 static cl_int WINAPI clGetDeviceIDsFromD3D11KHR( cl_platform_id platform, cl_uint source, void *object, cl_uint set,
                                                  cl_uint num_entries, cl_device_id *devices, cl_uint *num_devices )
 {
     IDXGIAdapter *adapter = NULL;
-    cl_device_id *all;
     ID3D11Device *device;
-    struct gpu_id id;
-    cl_uint count, i, found = 0;
-    cl_int ret;
 
     TRACE( "(%p, %#x, %p, %#x, %u, %p, %p)\n", platform, source, object, set, num_entries, devices, num_devices );
 
@@ -413,6 +484,18 @@
             adapter = NULL;
     }
     if (!adapter) return CL_INVALID_VALUE;
+    return get_adapter_devices( platform, adapter, num_entries, devices, num_devices );
+}
+
+/* the host devices of PLATFORM on ADAPTER (consumes the reference) */
+static cl_int get_adapter_devices( cl_platform_id platform, IDXGIAdapter *adapter, cl_uint num_entries,
+                                   cl_device_id *devices, cl_uint *num_devices )
+{
+    cl_device_id *all;
+    struct gpu_id id;
+    cl_uint count, i, found = 0;
