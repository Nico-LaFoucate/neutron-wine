         if (msg == WM_LBUTTONDOWN)
         {
            descr->lphc->droppedIndex = descr->nb_items ? descr->selected_item : -1;
+           if (LISTBOX_ComboDropPress( descr ))
+           {
+               /* the combo's hand-over of the press that dropped the list: the list
+                * takes the capture, the caret follows, this press picks nothing */
+               descr->captured = TRUE;
+               SetCapture( descr->self );
+               LISTBOX_ComboDropPressTrack( descr, x, y );
+               return 0;
+           }
            return LISTBOX_HandleLButtonDown( descr, keys, x, y);
         }
         else if (descr->style & LBS_NOTIFY)
@@ -3026,6 +3061,13 @@
