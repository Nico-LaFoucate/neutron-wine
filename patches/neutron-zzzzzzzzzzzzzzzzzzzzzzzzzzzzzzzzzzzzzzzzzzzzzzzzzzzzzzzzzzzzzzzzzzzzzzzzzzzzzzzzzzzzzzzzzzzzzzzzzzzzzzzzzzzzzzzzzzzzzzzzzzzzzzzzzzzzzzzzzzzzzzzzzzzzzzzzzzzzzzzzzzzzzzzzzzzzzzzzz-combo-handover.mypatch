+             * after a release on the combo itself, see COMBO_LButtonUp) */
+            lphc->wState &= ~CBF_OPENPRESS;
+            descr->captured = FALSE;
+            if (GetCapture() != descr->self) SetCapture( descr->self );
+            return 0;
+        }
 	if (lphc)
 	{
             POINT mousePos;
