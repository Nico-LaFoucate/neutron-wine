+            {
+                LISTBOX_ComboDropPressTrack( descr, mousePos.x, mousePos.y );
+                return 0;
+            }
+
             /*
              * If we are in a dropdown combobox, we simulate that
              * the mouse is captured to show the tracking of the item.
@@ -3044,6 +3086,16 @@
