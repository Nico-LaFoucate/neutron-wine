+++ b/dlls/comctl32/comctl32.h
@@ -152,6 +152,8 @@
     CBF_NOLBSELECT   = 0x2000, /* do not change current selection */
     CBF_BEENFOCUSED  = 0x4000, /* has it ever had focus           */
     CBF_EUI          = 0x8000,
+    CBF_INROLLUP     = 0x20000, /* Neutron: inside CBRollUp's CBN_SELENDOK/CANCEL notification */
+    CBF_OPENPRESS    = 0x10000, /* Neutron: the press that dropped the list is still down; its release picks nothing */
 };
 
