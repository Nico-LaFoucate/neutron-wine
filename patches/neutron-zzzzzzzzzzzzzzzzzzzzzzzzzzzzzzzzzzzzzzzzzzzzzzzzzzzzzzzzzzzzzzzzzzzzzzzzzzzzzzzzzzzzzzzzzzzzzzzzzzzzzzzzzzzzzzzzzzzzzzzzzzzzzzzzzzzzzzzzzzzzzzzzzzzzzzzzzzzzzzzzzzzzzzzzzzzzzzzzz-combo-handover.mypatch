 /***********************************************************************
+ *           COMBO_HandoverParity  (Neutron)
+ *
+ * The press on a combo box that drops its list never picks an item on Windows,
+ * wherever the list drops (below, above, or over the pressed point) and
+ * wherever the press is released: the combo hands tracking over to the list
+ * once the pointer is in it (it sends it the button-down at the true point, in
+ * list coordinates), the list takes the capture and only its caret follows the
+ * pointer while the button stays down (the selection stays), and the release
+ * leaves the list open with the selection unchanged and the capture on the
+ * list; the next click picks.  Wine's list took the hand-over as a click on the
+ * item under the pointer and the release selected it and rolled up (with the
+ * combo's coordinates, so a list above the combo closed unpicked).
+ * NEUTRON_COMBO_HANDOVER=0 restores Wine's old behavior.
+ */
+BOOL COMBO_HandoverParity(void)
+{
+    static int on = -1;
+    if (on < 0)
+    {
+        char buf[8];
+        DWORD len = GetEnvironmentVariableA( "NEUTRON_COMBO_HANDOVER", buf, sizeof(buf) );
+        on = !(len && len < sizeof(buf) && buf[0] == '0');
+        if (!on) ERR( "neutron-combo-handover: NEUTRON_COMBO_HANDOVER = 0 (environment)\n" );
+    }
+    return on;
+}
+
+/***********************************************************************
+ *           COMBO_EscapeParity  (Neutron)
+ *
+ * Escape on a dropped list closes it and restores the selection the list had
+ * when it dropped, with no CBN_SELCHANGE, as on Windows (hovering moves the
+ * list's selection; Wine kept the hovered item).  NEUTRON_COMBO_ESCAPE_RESTORE=0
+ * restores Wine's old behavior.
+ */
+BOOL COMBO_EscapeParity(void)
+{
+    static int on = -1;
+    if (on < 0)
+    {
+        char buf[8];
+        DWORD len = GetEnvironmentVariableA( "NEUTRON_COMBO_ESCAPE_RESTORE", buf, sizeof(buf) );
+        on = !(len && len < sizeof(buf) && buf[0] == '0');
+        if (!on) ERR( "neutron-combo-escape: NEUTRON_COMBO_ESCAPE_RESTORE = 0 (environment)\n" );
+    }
+    return on;
+}
+
+/***********************************************************************
  *           COMBO_LButtonDown
  */
 static void COMBO_LButtonDown( LPHEADCOMBO lphc, LPARAM lParam )
@@ -1552,8 +1604,12 @@
 	   /* drop down the listbox and start tracking */
 
            lphc->wState |= CBF_CAPTURE;
+           lphc->wState &= ~CBF_OPENPRESS;
            SetCapture( hWnd );
            CBDropDown( lphc );
+           /* the press that dropped the list picks nothing, wherever it is released */
+           if (COMBO_HandoverParity() && (lphc->wState & CBF_DROPPED))
+               lphc->wState |= CBF_OPENPRESS;
        }
        if( bButton ) CBRepaintButton( lphc );
    }
@@ -1566,6 +1622,7 @@
  */
 static void COMBO_LButtonUp( LPHEADCOMBO lphc )
 {
+   lphc->wState &= ~CBF_OPENPRESS;
    if( lphc->wState & CBF_CAPTURE )
    {
        lphc->wState &= ~CBF_CAPTURE;
@@ -1626,8 +1683,9 @@
        ReleaseCapture();
        if( CB_GETTYPE(lphc) == CBS_DROPDOWN ) CBUpdateLBox( lphc, TRUE );
 
-       /* hand over pointer tracking */
-       SendMessageW(lphc->hWndLBox, WM_LBUTTONDOWN, wParam, lParam);
+       /* hand over pointer tracking; Windows sends the point in the list's coordinates */
+       SendMessageW(lphc->hWndLBox, WM_LBUTTONDOWN, wParam,
+                    COMBO_HandoverParity() ? MAKELPARAM(pt.x, pt.y) : lParam);
    }
 }
 
@@ -1843,6 +1901,9 @@
         if ((wParam == VK_RETURN || wParam == VK_ESCAPE) &&
                 (lphc->wState & CBF_DROPPED))
         {
+            /* Escape: back to the selection the list had when it dropped (no notification) */
+            if (wParam == VK_ESCAPE && COMBO_EscapeParity())
+                SendMessageW( lphc->hWndLBox, LB_SETCURSEL, lphc->droppedIndex, 0 );
             CBRollUp( lphc, wParam == VK_RETURN, FALSE );
             return TRUE;
         }
@@ -2033,7 +2094,12 @@
                     CBDropDown( lphc );
             }
             else if (lphc->wState & CBF_DROPPED)
+            {
+                /* closing without a pick: back to the selection the list had when it dropped (Windows) */
+                if (COMBO_EscapeParity() && !(lphc->wState & CBF_INROLLUP))
+                    SendMessageW( lphc->hWndLBox, LB_SETCURSEL, lphc->droppedIndex, 0 );
                 CBRollUp( lphc, FALSE, TRUE );
+            }
         }
         return  TRUE;
 
--- a/dlls/comctl32_v6/listbox.c
+++ b/dlls/comctl32_v6/listbox.c
@@ -2178,6 +2178,32 @@
 }
 
 
+/***********************************************************************
+ *           LISTBOX_ComboDropPress  (Neutron, see COMBO_HandoverParity)
+ *
+ * TRUE from the moment a press on the combo dropped this list until the
+ * release of that press: the press that opened the list picks nothing.
+ */
+static BOOL LISTBOX_ComboDropPress( LB_DESCR *descr )
+{
+    return descr->lphc && (descr->lphc->wState & CBF_OPENPRESS);
+}
+
+/* during that press only the caret follows the pointer, the selection stays (Windows) */
+static void LISTBOX_ComboDropPressTrack( LB_DESCR *descr, INT x, INT y )
+{
+    RECT rect;
+    POINT pt;
+    INT index;
+
+    pt.x = x;
+    pt.y = y;
+    GetClientRect( descr->self, &rect );
+    if (!PtInRect( &rect, pt )) return;
+    index = LISTBOX_GetItemFromPoint( descr, x, y );
+    if (index != -1) LISTBOX_SetCaretIndex( descr, index, FALSE );
+}
+
 /*************************************************************************
  * LISTBOX_HandleLButtonDownCombo [Internal]
  *
