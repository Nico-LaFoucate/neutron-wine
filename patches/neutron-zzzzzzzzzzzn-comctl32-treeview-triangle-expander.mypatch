# neutron-zzzzzzzzzzzn-comctl32-treeview-triangle-expander
#
# Draw the tree expander as a filled triangle instead of the Win95 boxed +/-.
#
# ⭐ WHY THIS CODE PATH IS REACHED AT ALL -- it is a cost we chose, not a bug we found.
# comctl32 v6 asks GetWindowTheme() first and, when a visual style is live, draws TVP_GLYPH: a
# proper triangle. We deliberately switch the visual style OFF in every prefix
# (ThemeManager\ThemeActive=0, written by `neutron theme apply` and by `prefix provision`) because
# comctl32 v6 controls otherwise paint from Wine's bundled Aero and ignore the Neutron palette
# entirely -- which is what left Open/Cancel and the column headers rendering LIGHT on an
# otherwise fully dark file dialog. Turning it off fixed the palette and landed the tree on the
# CLASSIC drawing, which is boxed +/-. This pays that cost off instead of reverting the theme.
#
# MEASURED FIRST. Before writing this I captured the real dialog on 11.10-83 and sampled pixels
# rather than judging the render: every bevel in it is ALREADY dark (the filename edit's sunken
# edge bottoms out at 17,17,17 on a 43,43,43 ground, and the rule under the column headers is
# 32-36). There are no white borders to flatten -- what reads as light outlining is antialiased
# text. So "flatten the bevels" would have been almost invisible work; the boxed expanders are
# the genuinely Win95 element that remained.
#
# Right when collapsed, down when expanded, which is what every current file manager does. Filled
# rather than stroked: at the ~4px this resolves to on a 16px row, an outlined glyph loses its
# interior and reads as a smudge.
#
# The old +/- drawing is DELETED rather than left behind a `return` -- dead code after a return
# warns, and a reader should not have to work out which half runs. `plussize` and the pen locals
# go with it; `clrBk` stays in the signature because the caller's prototype is upstream's.
#
# Compiles clean for BOTH comctl32 and comctl32_v6.

--- a/dlls/comctl32/treeview.c
+++ b/dlls/comctl32/treeview.c
@@ -2374,8 +2374,7 @@
                                        const TREEVIEW_ITEM *item, LONG centerx, LONG centery,
                                        COLORREF clrBk)
 {
-    LONG height, width, rectsize, plussize;
-    HPEN new_pen, old_pen;
+    LONG height, width, rectsize;
 
 #if __WINE_COMCTL32_VERSION == 6
     HTHEME theme = GetWindowTheme(infoPtr->hwnd);
@@ -2395,47 +2394,46 @@
     height = item->rect.bottom - item->rect.top;
     width = item->stateOffset - item->linesOffset;
     rectsize = min(height, width) / 4;
-    /* plussize = ceil(rectsize * 3/4) */
-    plussize = (rectsize + 1) * 3 / 4;
 
-    new_pen = CreatePen(PS_SOLID, 0, GETLINECOLOR(infoPtr->clrLine));
-    old_pen = SelectObject(hdc, new_pen);
-
-    Rectangle(hdc, centerx - rectsize - 1, centery - rectsize - 1, centerx + rectsize + 2,
-              centery + rectsize + 2);
-
-    SelectObject(hdc, old_pen);
-    DeleteObject(new_pen);
-
-    /* draw +/- signs with current text color */
-    new_pen = CreatePen(PS_SOLID, 0, GETTXTCOLOR(infoPtr->clrText));
-    old_pen = SelectObject(hdc, new_pen);
-
-    if (height < 18 || width < 18)
+    /* NEUTRON: a filled triangle instead of the Win95 boxed +/-.
+     *
+     * ⭐ WHY THIS PATH IS EVEN REACHED. Above, comctl32 v6 asks GetWindowTheme() and, when a
+     * visual style is live, draws TVP_GLYPH — a proper triangle. We deliberately turn the visual
+     * style OFF in every prefix (ThemeManager\ThemeActive=0, written by `neutron theme apply`),
+     * because comctl32 v6 controls otherwise paint from Wine's bundled Aero and ignore the
+     * Neutron palette entirely — that is what left Open/Cancel and the column headers rendering
+     * light on an otherwise dark dialog. The cost of that trade was landing HERE, on the classic
+     * drawing, and getting boxed +/- signs back. This pays the cost off rather than reverting.
+     *
+     * Right when collapsed, down when expanded — the convention every current file manager uses.
+     * Filled, not stroked: at the ~4px this resolves to on a 16px row, an outlined glyph loses its
+     * interior and reads as a smudge.
+     */
     {
-        MoveToEx(hdc, centerx - plussize + 1, centery, NULL);
-        LineTo(hdc, centerx + plussize, centery);
+        LONG s = max(rectsize, 2);
+        POINT tri[3];
+        HBRUSH br = CreateSolidBrush(GETTXTCOLOR(infoPtr->clrText));
+        HBRUSH old_br = SelectObject(hdc, br);
+        HPEN np = CreatePen(PS_SOLID, 0, GETTXTCOLOR(infoPtr->clrText));
+        HPEN op = SelectObject(hdc, np);
 
-        if (!(item->state & TVIS_EXPANDED) || (item->state & TVIS_EXPANDPARTIAL))
+        if (item->state & TVIS_EXPANDED && !(item->state & TVIS_EXPANDPARTIAL))
         {
-            MoveToEx(hdc, centerx, centery - plussize + 1, NULL);
-            LineTo(hdc, centerx, centery + plussize);
+            tri[0].x = centerx - s;     tri[0].y = centery - s / 2;
+            tri[1].x = centerx + s;     tri[1].y = centery - s / 2;
+            tri[2].x = centerx;         tri[2].y = centery + s;
         }
-    }
-    else
-    {
-        Rectangle(hdc, centerx - plussize + 1, centery - 1, centerx + plussize, centery + 2);
-
-        if (!(item->state & TVIS_EXPANDED) || (item->state & TVIS_EXPANDPARTIAL))
+        else
         {
-            Rectangle(hdc, centerx - 1, centery - plussize + 1, centerx + 2, centery + plussize);
-            SetPixel(hdc, centerx - 1, centery, clrBk);
-            SetPixel(hdc, centerx + 1, centery, clrBk);
+            tri[0].x = centerx - s / 2; tri[0].y = centery - s;
+            tri[1].x = centerx + s;     tri[1].y = centery;
+            tri[2].x = centerx - s / 2; tri[2].y = centery + s;
         }
-    }
+        Polygon(hdc, tri, 3);
 
-    SelectObject(hdc, old_pen);
-    DeleteObject(new_pen);
+        SelectObject(hdc, op);   DeleteObject(np);
+        SelectObject(hdc, old_br); DeleteObject(br);
+    }
 }
 
 /* Painting *************************************************************/
