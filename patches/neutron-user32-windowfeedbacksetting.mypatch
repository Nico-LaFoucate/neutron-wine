     return FALSE;
 }
 
+/**********************************************************************
+ * SetWindowFeedbackSetting (USER32.@)
+ *
+ * No-op touch/pen feedback configuration. Photoshop calls this during
+ * document-window creation; without a real export the wine import stub
+ * raises an unimplemented-function exception and crashes the app.
+ */
+BOOL WINAPI SetWindowFeedbackSetting( HWND hwnd, FEEDBACK_TYPE feedback, DWORD flags,
+                                      UINT32 size, const void *configuration )
+{
+    FIXME( "hwnd %p, feedback %d, flags %#lx, size %u, configuration %p stub!\n",
+           hwnd, feedback, flags, size, configuration );
+    return TRUE;
+}
+
+/**********************************************************************
+ * GetWindowFeedbackSetting (USER32.@)
+ */
+BOOL WINAPI GetWindowFeedbackSetting( HWND hwnd, FEEDBACK_TYPE feedback, DWORD flags,
+                                      UINT32 *size, void *configuration )
+{
+    FIXME( "hwnd %p, feedback %d, flags %#lx, size %p, configuration %p stub!\n",
+           hwnd, feedback, flags, size, configuration );
+    if (size) *size = 0;
+    return FALSE;
+}
+
 BOOL WINAPI GetPointerDeviceProperties( HANDLE device, UINT32 *count,
                                         POINTER_DEVICE_PROPERTY *properties)
 {
