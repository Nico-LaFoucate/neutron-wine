@@ -233,6 +233,7 @@
             screen.x += window_rect->left + ox;
             screen.y += window_rect->top + oy;
         }
+        wayland_surface_mixed_scale_point(surface, wl_fixed_to_double(x), wl_fixed_to_double(y), &screen);
