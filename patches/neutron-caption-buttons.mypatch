@@ -2370,6 +2322,28 @@ static LRESULT handle_nc_mouse_move( HWND hwnd, WPARAM wparam, LPARAM lparam )
 
     TRACE( "hwnd=%p wparam=%#lx lparam=%#lx\n", hwnd, (long)wparam, lparam );
 
+    /* Neutron: track hover over the caption buttons for the flat hover highlight. */
+    if (wparam == HTCLOSE || wparam == HTMINBUTTON || wparam == HTMAXBUTTON)
+    {
+        TRACKMOUSEEVENT tme = { sizeof(tme), TME_QUERY };
+
+        set_nc_hot_button( hwnd, wparam );
+
+        /* arm NC mouse-leave so the highlight clears when the pointer leaves the frame */
+        NtUserTrackMouseEvent( &tme );
+        if (((tme.dwFlags & (TME_NONCLIENT | TME_LEAVE)) != (TME_NONCLIENT | TME_LEAVE)) ||
+            tme.hwndTrack != hwnd)
+        {
+            tme.cbSize = sizeof(tme);
+            tme.dwFlags = TME_NONCLIENT | TME_LEAVE;
+            tme.hwndTrack = hwnd;
+            tme.dwHoverTime = 0;
+            NtUserTrackMouseEvent( &tme );
+        }
+    }
+    else if (nc_hot_button_hwnd == hwnd)
+        set_nc_hot_button( hwnd, 0 );
+
     if (wparam != HTHSCROLL && wparam != HTVSCROLL)
         return 0;
 
