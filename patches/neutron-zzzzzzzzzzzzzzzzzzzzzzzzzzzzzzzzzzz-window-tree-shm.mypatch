 /*****************************************************************************
  *           NtUserBuildHwndList (win32u.@)
  */
+/* NEUTRON window-tree-shm: the siblings of hwnd from hwnd on, or its children recursively (pre-order), as the
+ * server's get_window_list builds them, walked from the shared links. Lightroom's UI framework calls GetDlgItem
+ * (user32: one NtUserBuildHwndList of the siblings) ~30,000 times a second while it builds a panel; on Windows
+ * that walk never leaves user mode. FALSE = ask the server (no links, the desktop window, or a window that
+ * vanished mid-walk). */
+static BOOL build_hwnd_list_shared( HWND hwnd, BOOL children, ULONG count, HWND *buffer, ULONG *size,
+                                    NTSTATUS *status )
+{
+    user_handle_t links[6];
+    HWND cur, root = hwnd;
+    ULONG n = 0, steps = 0;
+
+    if (!neutron_tree_shm() || !get_shared_window_links( hwnd, links ) || !links[0]) return FALSE;
+
+    if (!children)
+    {
+        for (cur = hwnd; cur; cur = wine_server_ptr_handle( links[2] ))
+        {
+            if (++steps > MAX_USER_HANDLES) return FALSE;
+            if (cur != hwnd && !get_shared_window_links( cur, links )) return FALSE;
+            if (n + 1 < count) buffer[n] = cur;
+            n++;
+        }
+    }
+    else
+    {
+        cur = wine_server_ptr_handle( links[4] );
+        while (cur)
+        {
+            if (++steps > MAX_USER_HANDLES || !get_shared_window_links( cur, links )) return FALSE;
+            if (n + 1 < count) buffer[n] = cur;
+            n++;
+            if (links[4]) { cur = wine_server_ptr_handle( links[4] ); continue; }
+            /* no children: next sibling, else climb until an ancestor below root has one */
+            for (;;)
+            {
+                if (links[2]) { cur = wine_server_ptr_handle( links[2] ); break; }
+                cur = wine_server_ptr_handle( links[0] );
+                if (!cur || cur == root) { cur = 0; break; }
+                if (++steps > MAX_USER_HANDLES || !get_shared_window_links( cur, links )) return FALSE;
+            }
+        }
+    }
+
+    *size = n + 1;
+    if (n + 1 > count) { *status = STATUS_BUFFER_TOO_SMALL; return TRUE; }
+    buffer[n] = HWND_BOTTOM;
+    *status = STATUS_SUCCESS;
+    return TRUE;
+}
+
+static NTSTATUS build_hwnd_list_server( HDESK desktop, HWND hwnd, BOOL children, ULONG thread_id, ULONG count,
+                                        HWND *buffer, ULONG *size );
+
 NTSTATUS WINAPI NtUserBuildHwndList( HDESK desktop, HWND hwnd, BOOL children, BOOL non_immersive,
                                      ULONG thread_id, ULONG count, HWND *buffer, ULONG *size )
 {
+    NTSTATUS status;
+
+    if (!desktop && hwnd && !thread_id && count &&
+        build_hwnd_list_shared( hwnd, children, count, buffer, size, &status ))
+    {
+        if (neutron_tree_verify() && !status)
+        {
+            static LONG checked, mismatches;
+            HWND *check = malloc( count * sizeof(HWND) );
+            ULONG check_size = 0;
+            NTSTATUS check_status = check ? build_hwnd_list_server( desktop, hwnd, children, thread_id, count,
+                                                                    check, &check_size ) : STATUS_NO_MEMORY;
+            InterlockedIncrement( &checked );
+            if (check && (check_status || check_size != *size || memcmp( check, buffer, *size * sizeof(HWND) )))
+                ERR( "neutron-treeverify: MISMATCH list hwnd=%p children=%d size %u vs server %u status %x (#%ld of %ld)\n",
+                     hwnd, children, (UINT)*size, (UINT)check_size, (UINT)check_status,
+                     (long)InterlockedIncrement( &mismatches ), (long)checked );
+            free( check );
+        }
+        return status;
+    }
+    return build_hwnd_list_server( desktop, hwnd, children, thread_id, count, buffer, size );
+}
+
+static NTSTATUS build_hwnd_list_server( HDESK desktop, HWND hwnd, BOOL children, ULONG thread_id, ULONG count,
+                                        HWND *buffer, ULONG *size )
+{
     user_handle_t *list = (user_handle_t *)buffer;
     int i;
     NTSTATUS status;
