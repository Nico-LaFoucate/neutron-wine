+/* NEUTRON window-tree-shm (2026-10-15): publish a window's links in its shared object.
+ *
+ * On Windows, GetWindow() reads the window tree from the desktop heap mapped into every process: no kernel call.
+ * Here every GW_CHILD/GW_HWNDNEXT/... was a get_window_tree request. Lightroom Classic walks its window tree
+ * while building a panel: ~135,000 GetWindow calls a second from the app during its first Masking open
+ * (diagnostic count), 75% of all requests the wineserver handled, and the reason that open took seconds where
+ * Windows takes a fraction of one. The links are refreshed from the lists below whenever they change, so the
+ * shared copy always matches what get_window_tree would reply; win32u reads it (get_window_relative). */
+static void update_window_links( struct window *win )
+{
+    user_handle_t parent = win->parent ? win->parent->handle : 0, next = 0, prev = 0, first = 0, last = 0;
+    unsigned int has_region = !!win->win_region;
+    unsigned int pixel_format = !!(win->paint_flags & (PAINT_HAS_PIXEL_FORMAT | PAINT_PIXEL_FORMAT_CHILD));
+    const window_shm_t *shm = win->shared;
+    struct window *ptr;
+
+    if (!shm) return;
+    if (win->parent && win->is_linked)
+    {
+        if ((ptr = get_next_window( win ))) next = ptr->handle;
+        if ((ptr = get_prev_window( win ))) prev = ptr->handle;
+    }
+    if ((ptr = get_first_child( win ))) first = ptr->handle;
+    if ((ptr = get_last_child( win ))) last = ptr->handle;
+
+    if (shm->tree_valid && shm->parent == parent && shm->owner == win->owner && shm->next_sibling == next &&
+        shm->prev_sibling == prev && shm->first_child == first && shm->last_child == last &&
+        shm->has_region == has_region && shm->pixel_format == pixel_format)
+        return;
+
+    SHARED_WRITE_BEGIN( win->shared, window_shm_t )
+    {
+        shared->parent       = parent;
+        shared->owner        = win->owner;
+        shared->next_sibling = next;
+        shared->prev_sibling = prev;
+        shared->first_child  = first;
+        shared->last_child   = last;
+        shared->has_region   = has_region;
+        shared->pixel_format = pixel_format;
+        shared->tree_valid   = 1;
+    }
+    SHARED_WRITE_END;
+}
+
+/* a parent's z-order list changed: refresh its first/last child and every child's siblings */
+static void update_children_links( struct window *parent )
+{
+    struct window *ptr;
+
+    if (!parent) return;
+    update_window_links( parent );
+    LIST_FOR_EACH_ENTRY( ptr, &parent->children, struct window, entry )
+        update_window_links( ptr );
+}
+
 /* set the PAINT_PIXEL_FORMAT_CHILD flag on all the parents */
 /* note: we never reset the flag, it's just a heuristic */
+static void update_window_links( struct window *win );
+
 static inline void update_pixel_format_flags( struct window *win )
 {
     for (win = win->parent; win && win->parent; win = win->parent)
+    {
         win->paint_flags |= PAINT_PIXEL_FORMAT_CHILD;
+        update_window_links( win );  /* NEUTRON window-tree-shm: pixel_format */
+    }
 }
 
