server, win32u: publish the window tree in shared memory; answer GetWindow, the child/sibling lists and the
no-region case without a server round trip

Lightroom Classic's first Masking open took seconds where Windows takes a fraction of one. With the stacking
fixes in, wineserver request counts during the open (diagnostic counter in call_req_handler) showed why: ~220,000
requests a second from Lightroom's UI thread, 165,000 of them get_window_tree. A counter in get_window_relative
put ~90,000 GW_CHILD + ~45,000 GW_HWNDNEXT a second on the app side: its UI framework walks the window tree
constantly. On Windows GetWindow reads the tree from the desktop heap mapped into the process; here each call
was a round trip (~15 us), i.e. ~2 s per second of building.

- protocol.def window_shm_t gains the links get_window_tree replies with (parent, owner, next/prev sibling,
  first/last child) plus has_region and pixel_format. The server refreshes them, compare-before-write, wherever
  the lists change: link_window, set_parent_window (old parent too), update_window_zorder, set_window_owner,
  create_window, window_destroy, set_window_region, the pixel-format flags.
- win32u get_window_relative answers GW_HWNDNEXT/PREV/CHILD/HWNDFIRST/HWNDLAST from the shared object
  (seqlock read, as for the DPI context); NtUserBuildHwndList builds the "siblings from hwnd" and "children,
  recursively" lists from it (GetDlgItem = one such list: ~30,000 a second); get_window_region returns "no
  region" locally; update_surface_region builds the clip of a top-level window with no region and no custom
  pixel format itself (the server's get_surface_region is then its visible rect). Anything the shared copy cannot
  answer (no links, the desktop window, a desktop/thread filter, a window vanishing mid-walk) asks the server.
- apply_window_pos computed the driver's owner hint for child windows too, with a WindowFromPoint request on
  every child SetWindowPos; a child gets no driver surface and the driver never reads its hint.

Measured (clean-room LrC 15.6, nested KWin, fresh launch each): first Masking open 0.9 s / 0.8 s;
NEUTRON_TREE_SHM=0 on the same binaries 2.5 s (13.5 s before any of today's fixes). Requests during the open
~220,000/s -> ~60,000/s; get_window_tree and get_window_list gone from the top.
NEUTRON_TREE_VERIFY=1 (test switch) asks the server as well for every shared answer and logs
"neutron-treeverify: MISMATCH": 0 across Masking open, Select Subject, photo and module switching.

Protocol version bumped (make_requests): every component must come from the same build.
Kill switch NEUTRON_TREE_SHM=0 (client side; the server always publishes).

--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -821,8 +821,114 @@
 }
 
 /* see GetWindow */
+/* NEUTRON window-tree-shm: hwnd's links (parent, owner, next, prev, first child, last child) from session shared
+ * memory, as the server publishes them (server/window.c update_window_links). FALSE when not available, and the
+ * caller asks the server. */
+static BOOL get_shared_window_links( HWND hwnd, user_handle_t links[6] )
+{
+    struct object_lock lock = OBJECT_LOCK_INIT;
+    const window_shm_t *window_shm = NULL;
+    unsigned int valid = 0;
+    NTSTATUS status;
+
+    while ((status = get_shared_window( hwnd, &lock, &window_shm )) == STATUS_PENDING)
+    {
+        valid    = window_shm->tree_valid;
+        links[0] = window_shm->parent;
+        links[1] = window_shm->owner;
+        links[2] = window_shm->next_sibling;
+        links[3] = window_shm->prev_sibling;
+        links[4] = window_shm->first_child;
+        links[5] = window_shm->last_child;
+    }
+    return !status && valid;
+}
+
+/* NEUTRON window-tree-shm: whether hwnd has a window region / a custom pixel format in it or a child, as the server
+ * publishes them. FALSE when not available. */
+static BOOL get_shared_window_shape( HWND hwnd, BOOL *has_region, BOOL *pixel_format )
+{
+    struct object_lock lock = OBJECT_LOCK_INIT;
+    const window_shm_t *window_shm = NULL;
+    unsigned int valid = 0;
+    NTSTATUS status;
+
+    while ((status = get_shared_window( hwnd, &lock, &window_shm )) == STATUS_PENDING)
+    {
+        valid         = window_shm->tree_valid;
+        *has_region   = window_shm->has_region;
+        *pixel_format = window_shm->pixel_format;
+    }
+    return !status && valid;
+}
+
+static BOOL neutron_tree_shm(void)
+{
+    static int on = -1;
+    if (on < 0)
+    {
+        const char *e = getenv( "NEUTRON_TREE_SHM" );
+        on = !e || e[0] != '0';
+        ERR( "neutron-gateresolved: NEUTRON_TREE_SHM = %d (%s)\n", on, e ? "environment" : "default" );
+    }
+    return on;
+}
+
+/* NEUTRON window-tree-shm: answer a GetWindow relation from shared memory; FALSE = ask the server */
+static BOOL get_window_relative_shared( HWND hwnd, UINT rel, HWND *ret )
+{
+    user_handle_t links[6], parent_links[6];
+
+    if (!neutron_tree_shm() || !get_shared_window_links( hwnd, links )) return FALSE;
+    switch (rel)
+    {
+    case GW_HWNDNEXT: *ret = wine_server_ptr_handle( links[2] ); return TRUE;
+    case GW_HWNDPREV: *ret = wine_server_ptr_handle( links[3] ); return TRUE;
+    case GW_CHILD:    *ret = wine_server_ptr_handle( links[4] ); return TRUE;
+    case GW_HWNDFIRST:
+    case GW_HWNDLAST:
+        if (!links[0]) { *ret = 0; return TRUE; }
+        if (!get_shared_window_links( wine_server_ptr_handle( links[0] ), parent_links )) return FALSE;
+        *ret = wine_server_ptr_handle( rel == GW_HWNDFIRST ? parent_links[4] : parent_links[5] );
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/* NEUTRON window-tree-shm: NEUTRON_TREE_VERIFY=1 also asks the server and logs any difference (test switch) */
+static BOOL neutron_tree_verify(void)
+{
+    static int on = -1;
+    if (on < 0) { const char *e = getenv( "NEUTRON_TREE_VERIFY" ); on = e && e[0] == '1'; }
+    return on;
+}
+
+static HWND get_window_relative_server( HWND hwnd, UINT rel );
+
 HWND get_window_relative( HWND hwnd, UINT rel )
 {
+    HWND shared;
+
+    /* GW_OWNER of this process's windows is answered locally below already */
+    if ((rel == GW_HWNDNEXT || rel == GW_HWNDPREV || rel == GW_CHILD || rel == GW_HWNDFIRST || rel == GW_HWNDLAST) &&
+        get_window_relative_shared( hwnd, rel, &shared ))
+    {
+        if (neutron_tree_verify())
+        {
+            static LONG checked, mismatches;
+            HWND server = get_window_relative_server( hwnd, rel );
+            InterlockedIncrement( &checked );
+            if (server != shared)
+                ERR( "neutron-treeverify: MISMATCH hwnd=%p rel=%u shared=%p server=%p (#%ld of %ld)\n", hwnd, rel,
+                     shared, server, (long)InterlockedIncrement( &mismatches ), (long)checked );
+        }
+        return shared;
+    }
+    return get_window_relative_server( hwnd, rel );
+}
+
+static HWND get_window_relative_server( HWND hwnd, UINT rel )
+{
     HWND retval = 0;
 
     if (rel == GW_ENABLEDPOPUP)
@@ -2197,8 +2303,37 @@
     return TRUE;
 }
 
+static NTSTATUS get_window_region_server( HWND hwnd, BOOL surface, HRGN *region, RECT *visible );
+
+/* NEUTRON window-tree-shm: a window without a region (nearly all of them) has nothing to fetch. Every SetWindowPos
+ * asked the server for the region of the window being moved (get_window_surface's shape test) and again in
+ * update_surface_region; ~23,000 get_window_region requests a second while Lightroom built a panel. */
 static NTSTATUS get_window_region( HWND hwnd, BOOL surface, HRGN *region, RECT *visible )
 {
+    BOOL has_region, pixel_format;
+
+    if (!surface && neutron_tree_shm() && get_shared_window_shape( hwnd, &has_region, &pixel_format ) && !has_region)
+    {
+        *region = 0;
+        if (neutron_tree_verify())
+        {
+            HRGN check = 0;
+            RECT dummy;
+            static LONG mismatches;
+            if (!get_window_region_server( hwnd, FALSE, &check, &dummy ) && check)
+            {
+                ERR( "neutron-treeverify: MISMATCH region hwnd=%p: server has one (#%ld)\n", hwnd,
+                     (long)InterlockedIncrement( &mismatches ) );
+                NtGdiDeleteObjectApp( check );
+            }
+        }
+        return STATUS_SUCCESS;
+    }
+    return get_window_region_server( hwnd, surface, region, visible );
+}
+
