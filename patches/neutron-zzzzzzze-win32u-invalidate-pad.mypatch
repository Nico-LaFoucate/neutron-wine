--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -2197,6 +2197,23 @@
 /***********************************************************************
  *           NtUserRedrawWindow (win32u.@)
  */
+/* NEUTRON: how many pixels to widen an invalidation by; 0 (default) = unchanged.
+ * See the long comment at the use site in NtUserRedrawWindow. Parsed once. */
+static int neutron_invalidate_pad(void)
+{
+    static int pad = -1;
+
+    if (pad < 0)
+    {
+        const char *e = getenv( "NEUTRON_INVALIDATE_PAD" );
+        int v = 0;
+
+        if (e) while (*e >= '0' && *e <= '9') v = v * 10 + (*e++ - '0');
+        pad = (v < 0) ? 0 : (v > 256) ? 256 : v;   /* sanity clamp */
+    }
+    return pad;
+}
+
 BOOL WINAPI NtUserRedrawWindow( HWND hwnd, const RECT *rect, HRGN hrgn, UINT flags )
 {
     static const RECT empty;
@@ -2239,9 +2256,35 @@
     if (rect && !hrgn)
     {
         RECT ordered = *rect;
+        int pad;
 
         order_rect( &ordered );
         if (IsRectEmpty( &ordered )) ordered = empty;
+        /* NEUTRON INVALIDATE PAD (NEUTRON_INVALIDATE_PAD=<pixels>, default 0 = off).
+         *
+         * Adobe Animate paints its canvas from an off-screen bitmap that it draws
+         * SLIGHTLY LARGER than 1:1, then asks us to repaint a rectangle it computed
+         * WITHOUT that enlargement. The stretch grows away from the top-left, so
+         * content near the left repaints cleanly while content further right ends up
+         * a few pixels outside the repainted area and is stranded there for good --
+         * the playback "fragment". Confirmed by the user: the left-hand shape leaves
+         * nothing behind even when it overhangs the canvas edge, while the right-hand
+         * shape, fully inside the canvas, always strands a sliver on its right.
+         *
+         * The enlargement comes from Animate truncating its own scale factor to two
+         * decimals (1.697917 -> 1.69). It is exact only at display scales of 150/175/
+         * 200%, which is why this is not seen on typical Windows setups. We cannot
+         * correct Adobe's arithmetic and will not ship a modified Adobe binary, so the
+         * remedy is to repaint slightly more than asked. Costs a little extra painting;
+         * strictly a workaround for an application defect, NOT a Wine correctness fix,
+         * which is why it is off unless a profile turns it on. */
+        else if ((flags & RDW_INVALIDATE) && (pad = neutron_invalidate_pad()) != 0)
+        {
+            ordered.left   -= pad;
+            ordered.top    -= pad;
+            ordered.right  += pad;
+            ordered.bottom += pad;
+        }
         ret = redraw_window_rects( hwnd, flags, &ordered, 1 );
     }
     else if (!hrgn)
