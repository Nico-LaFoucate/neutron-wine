-    HWND hwnd;
+    HWND hwnd;         /* the window dcomp was asked to present into (a Chromium-internal child) */
+    HWND present_hwnd; /* where we actually blit: the WC_PLUGPLUG_HTMLEXTENSION panel host if this is
+                        * a CEF/CEP panel, else == hwnd. Only panel hosts are given a subsurface. */
     IDXGISwapChain *swapchain;
+    HANDLE px_map;     /* NEUTRON: shared px section for cross-process panels (see below) */
+    void  *px_view;
+    BOOL   cross_proc; /* present_hwnd owned by another process (CEF panel) -> use shared px path */
+    UINT   last_present_count; /* NEUTRON perf: skip the staging copy when the swapchain hasn't presented */
+    BOOL   have_present_count;
+    BOOL   t_first_present; /* NEUTRON cold-start timing: first present observed */
+    BOOL   t_first_deliver; /* NEUTRON cold-start timing: first frame delivered to shared mem */
+};
+
+/* NEUTRON: cross-process CEP panel present path.
+ * The panel host window is owned by the Adobe app process, but dcomp/the swapchain live in the CEF
+ * (CEPHtmlEngine) process. Wine's window_surface is per-process, so a cross-process GetDC+StretchDIBits
+ * writes into a detached DC (verified: GetPixel readback = CLR_INVALID) and never reaches the owner's
+ * surface. Instead we hand the pixels to the owner via a named shared section keyed by the host hwnd;
+ * winewayland's consumer thread (running in the owner process) blits them same-process and flushes,
+ * so the subsurface actually commits. */
+#define NEUTRON_PX_MAXW 4096
+#define NEUTRON_PX_MAXH 2304
+struct neutron_px_shbuf
+{
+    LONG  seq;      /* bumped after each fully-written frame */
+    LONG  width;
+    LONG  height;
+    LONG  reserved;
+    BYTE  pixels[1]; /* width*height*4, BGRA top-down */
+};
+#define NEUTRON_PX_BYTES (sizeof(struct neutron_px_shbuf) + (SIZE_T)NEUTRON_PX_MAXW * NEUTRON_PX_MAXH * 4)
+
+#define NEUTRON_REG_MAX 64
+struct neutron_registry
+{
+    LONG  count;
+    DWORD hwnds[NEUTRON_REG_MAX]; /* host hwnds (as DWORD) with a live px section */
 };
+static const WCHAR neutron_registry_nameW[] =
+    L"__neutron_dcomp_registry";
+
+static void neutron_px_name(HWND hwnd, WCHAR out[64])
+{
+    static const WCHAR fmt[] = L"__neutron_dcomp_px_%08x";
+    wsprintfW(out, fmt, (DWORD)(ULONG_PTR)hwnd);
+}
+
+static void neutron_registry_add(HWND hwnd)
+{
+    HANDLE h = CreateFileMappingW(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE, 0,
+                                  sizeof(struct neutron_registry), neutron_registry_nameW);
+    struct neutron_registry *reg;
+    LONG i;
+    if (!h) return;
+    if ((reg = MapViewOfFile(h, FILE_MAP_WRITE, 0, 0, sizeof(*reg))))
+    {
+        for (i = 0; i < reg->count && i < NEUTRON_REG_MAX; i++)
+            if (reg->hwnds[i] == (DWORD)(ULONG_PTR)hwnd) break;
+        if (i == reg->count && reg->count < NEUTRON_REG_MAX)
+        {
+            reg->hwnds[reg->count] = (DWORD)(ULONG_PTR)hwnd;
+            InterlockedIncrement(&reg->count);
+        }
+        UnmapViewOfFile(reg);
+    }
+    /* keep the mapping alive for the process lifetime so the section persists */
+}
+
+/* NEUTRON: walk up from a dcomp present target to the CEP panel host window
+ * (class WC_PLUGPLUG_HTMLEXTENSION_CLASS_NAME). Returns NULL for non-CEF dcomp targets such as the
+ * program-monitor canvas, so we never touch those. */
+static HWND find_cef_panel_host(HWND hwnd)
+{
+    WCHAR cls[128];
+    HWND a;
+    int depth;
+
+    for (a = hwnd, depth = 0; a && depth < 16; a = GetAncestor(a, GA_PARENT), depth++)
+    {
+        if (GetClassNameW(a, cls, 128) > 0 && wcsstr(cls, L"HTMLEXTENSION"))
+            return a;
+    }
+    return NULL;
+}
 
