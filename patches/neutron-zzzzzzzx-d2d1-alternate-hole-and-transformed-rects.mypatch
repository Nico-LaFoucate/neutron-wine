+/* NEUTRON: resolve a geometry to an axis-aligned rectangle, seeing through
+ * ID2D1TransformedGeometry.
+ *
+ * Premiere's CLIP-CHILDREN exclusion masks arrive as transformed rectangles, not bare
+ * ID2D1RectangleGeometry, so the plain QueryInterface below reported them as "non-rectangle" and
+ * the whole mask fell back to its bounding box. Measured 2026-08-14: members with exactly
+ * axis-aligned integer bounds -- e.g. (0,0)-(1786,1232) with a hole at (79,67)-(325,93), which is
+ * the EXACT rect of a visible child window in the same log -- rejected purely for being wrapped.
+ *
+ * Only axis-aligned transforms qualify. Under rotation or skew a rectangle's image is not a
+ * rectangle and its bounds are strictly larger than the shape, which is the very trap the
+ * "bounds are not the shape" rule below exists to avoid. */
+static BOOL d2d_geometry_as_axis_aligned_rect(ID2D1Geometry *geometry, D2D1_RECT_F *out)
+{
+    ID2D1TransformedGeometry *tg;
+    ID2D1RectangleGeometry *rg;
+    BOOL ret = FALSE;
+
+    if (SUCCEEDED(ID2D1Geometry_QueryInterface(geometry, &IID_ID2D1RectangleGeometry, (void **)&rg)))
+    {
+        ID2D1RectangleGeometry_GetRect(rg, out);
+        ID2D1RectangleGeometry_Release(rg);
+        return TRUE;
+    }
+
+    if (SUCCEEDED(ID2D1Geometry_QueryInterface(geometry, &IID_ID2D1TransformedGeometry, (void **)&tg)))
+    {
+        D2D1_MATRIX_3X2_F m;
+        ID2D1Geometry *src = NULL;
+        D2D1_RECT_F unused;
+
+        ID2D1TransformedGeometry_GetTransform(tg, &m);
+        ID2D1TransformedGeometry_GetSourceGeometry(tg, &src);
+        ID2D1TransformedGeometry_Release(tg);
+
+        if (src)
+        {
+            /* Recurse: the source must itself be a rectangle, and the transform must keep it one.
+             * With that established, the geometry's own bounds ARE its shape. */
+            if (d2d_geometry_as_axis_aligned_rect(src, &unused) && m._12 == 0.0f && m._21 == 0.0f
+                    && SUCCEEDED(ID2D1Geometry_GetBounds(geometry, NULL, out)))
+                ret = TRUE;
+            ID2D1Geometry_Release(src);
+        }
+    }
+
+    return ret;
+}
+
+/* NEUTRON: ALTERNATE fill over two nested rectangles is a HOLE -- "everything in the outer rect
+ * except the inner one". That is how a clip-children exclusion reaches us. Rewrite it as the four
+ * disjoint rectangles of the frame, which the scissor path can express exactly.
+ *
+ * Getting this wrong is what makes controls disappear: the bounding-box fallback INCLUDES the hole,
+ * so the app's background fill paints straight over the child window living in it, and the child
+ * only comes back when something forces it to repaint (hovering it). Returns the new count, or 0 if
+ * the pair is not a shape we can represent. */
+static unsigned d2d_mask_rects_from_alternate_pair(const D2D1_RECT_F *a, const D2D1_RECT_F *b,
+        D2D1_RECT_F *out)
+{
+    const D2D1_RECT_F *outer, *hole;
+    unsigned count = 0;
+
+    if (a->left <= b->left && a->top <= b->top && a->right >= b->right && a->bottom >= b->bottom)
+    {
+        outer = a; hole = b;
+    }
+    else if (b->left <= a->left && b->top <= a->top && b->right >= a->right && b->bottom >= a->bottom)
+    {
+        outer = b; hole = a;
+    }
+    else
+    {
+        /* Disjoint: even-odd and winding agree, so both pieces stand. Anything else (a partial
+         * overlap) is a symmetric difference we are not going to guess at -- bail to the bbox. */
+        if (a->right <= b->left || b->right <= a->left || a->bottom <= b->top || b->bottom <= a->top)
+        {
+            out[0] = *a;
+            out[1] = *b;
+            return 2;
+        }
+        return 0;
+    }
+
+#define NEUTRON_EMIT(l, t, r, bt) \
+    do { if ((r) > (l) && (bt) > (t)) { d2d_rect_set(&out[count], (l), (t), (r), (bt)); ++count; } } while (0)
+    NEUTRON_EMIT(outer->left, outer->top,    outer->right, hole->top);      /* above  */
+    NEUTRON_EMIT(outer->left, hole->bottom,  outer->right, outer->bottom);  /* below  */
+    NEUTRON_EMIT(outer->left, hole->top,     hole->left,   hole->bottom);   /* left   */
+    NEUTRON_EMIT(hole->right, hole->top,     outer->right, hole->bottom);   /* right  */
+#undef NEUTRON_EMIT
+
+    return count;
+}
+
