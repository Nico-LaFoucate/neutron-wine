+                ERR("neutron-dr: MASKFALLBACK ALTERNATE pair not a hole (count=%u) -- bounding box in force\n",
+                        count);
+            return FALSE;
+        }
+        if (neutron_optrace())
+            ERR("neutron-dr: MASKALTERNATE hole resolved into %u scissor rect(s) -- "
+                "child content inside the hole is now protected\n", fc);
+        memcpy(rects, frame, fc * sizeof(*frame));
+        count = fc;
+    }
+
     /* Disjoint check: overlapping pieces would draw translucent content twice. */
     for (i = 0; i < count; ++i)
     {
