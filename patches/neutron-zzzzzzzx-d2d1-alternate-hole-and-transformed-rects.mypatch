+    /* NEUTRON: turn the even-odd pair into the frame around its hole before anything downstream
+     * sees it. From here on the list is ordinary disjoint rectangles again. */
+    if (alternate_pair)
+    {
+        D2D1_RECT_F frame[4];
+        unsigned fc;
+
+        if (count != 2 || !(fc = d2d_mask_rects_from_alternate_pair(&rects[0], &rects[1], frame)))
+        {
