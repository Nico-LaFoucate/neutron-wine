# neutron-srw-wake-fastpath
#
# Suite-wide sync-primitive speedup (helps Chromium/CEF's base::Lock=SRWLOCK + MSVC std::mutex/
# condition_variable-heavy Adobe apps; found while profiling the Premiere tab-switch stall). Wine's
# RtlReleaseSRWLockShared/Exclusive + RtlWakeAddressSingle/All took a GLOBAL 256-bucket futex
# spinlock on EVERY release/wake even with zero waiters -- and all page-aligned locks hash to bucket
# 0, so a 339-thread app bounces that one cacheline across all cores. Fix: no-waiter wake fast path
# = lock-free empty-bucket check in RtlWakeAddress*, skip the wake in RtlReleaseSRWLockShared unless
# exclusive_waiters is set, and register the waiter BEFORE comparing the value in RtlWaitOnAddress
# with a full barrier between (store-buffer pairing) -- lost-wakeup-safe, SB-litmus reasoned.
# Microbench (8 threads, worst-case same bucket): uncontended SRW excl 22x / shared 38x, no-waiter
# WakeConditionVariable ~90x; contended handoff ~5-8% slower (extra barriers). Touches: dlls/ntdll/sync.c.
diff --git a/dlls/ntdll/sync.c b/dlls/ntdll/sync.c
index e118cbee86a..b700fde903b 100644
--- a/dlls/ntdll/sync.c
+++ b/dlls/ntdll/sync.c
@@ -629,7 +629,14 @@ void WINAPI RtlReleaseSRWLockShared( RTL_SRWLOCK *lock )
         --new.s.owners;
     } while (InterlockedCompareExchange( u.l, new.l, old.l ) != old.l);
 
-    if (!new.s.owners)
+    /* The only threads which wait on &owners are exclusive acquirers, and
+     * they always register themselves in exclusive_waiters (with a full
+     * memory barrier) before waiting. The CAS above read the whole lock word
+     * atomically: if it shows no exclusive waiters, none can be sleeping on
+     * &owners at that point, and any acquirer arriving later will observe
+     * owners == 0 and take the lock without waiting, so it is safe to skip
+     * the wake entirely. */
+    if (!new.s.owners && new.s.exclusive_waiters)
         RtlWakeAddressSingle( &u.s->owners );
 }
 
@@ -894,16 +901,25 @@ NTSTATUS WINAPI RtlWaitOnAddress( const void *addr, const void *cmp, SIZE_T size
 
     /* Do the comparison inside of the spinlock, to reduce spurious wakeups. */
 
+    if (!queue->queue.next)
+        list_init( &queue->queue );
+    list_add_tail( &queue->queue, &entry.entry );
+
+    /* Register the entry before comparing the value, with a full barrier in
+     * between, so that a waker which stores a new value and then finds the
+     * queue empty (in the lock-free fast path of RtlWakeAddress*()) cannot
+     * miss us: if the waker saw an empty queue, our comparison below is
+     * guaranteed to see the value it stored, and we won't sleep.
+     * This pairs with the barrier in RtlWakeAddressSingle()/All(). */
+    MemoryBarrier();
+
     if (!compare_addr( addr, cmp, size ))
     {
+        list_remove( &entry.entry );
         spin_unlock( &queue->lock );
         return STATUS_SUCCESS;
     }
 
-    if (!queue->queue.next)
-        list_init( &queue->queue );
-    list_add_tail( &queue->queue, &entry.entry );
-
     spin_unlock( &queue->lock );
 
     ret = NtWaitForAlertByThreadId( NULL, timeout );
@@ -937,6 +953,16 @@ void WINAPI RtlWakeAddressAll( const void *addr )
 
     if (!addr) return;
 
+    /* Lock-free fast path: if the queue has no waiters at all, there is
+     * nothing to wake and we can skip taking the spinlock. The full barrier
+     * orders the caller's store of the value before our read of the queue
+     * head; it pairs with the barrier in RtlWaitOnAddress(), which registers
+     * its entry before comparing the value. Between the two, either we see
+     * the waiter's entry here, or the waiter sees the new value and does not
+     * sleep, so no wakeup can be lost. */
+    MemoryBarrier();
+    if (!queue->queue.next || list_empty( &queue->queue )) return;
+
     spin_lock( &queue->lock );
 
     if (!queue->queue.next)
@@ -977,6 +1003,10 @@ void WINAPI RtlWakeAddressSingle( const void *addr )
 
     if (!addr) return;
 
+    /* Lock-free fast path; see the comment in RtlWakeAddressAll(). */
+    MemoryBarrier();
+    if (!queue->queue.next || list_empty( &queue->queue )) return;
+
     spin_lock( &queue->lock );
 
     if (!queue->queue.next)
