 }
 
-int neutron_workarea_load_measured(void)
+/* NEUTRON workarea#3 (2026-10-14): one measurement PER OUTPUT.
+ *
+ * workarea#1/#2 kept ONE maximized logical height, from whichever output a window was last maximized on, and
+ * applied it to every output whose height it plausibly fit. On a desktop whose outputs differ (a 4K with a top
+ * panel beside a panel-less portrait screen) that value was wrong for the other output: a window maximized there
+ * came out 32 logical px short of the compositor's configure (823x1431 against 823x1463), the compositor rejected
+ * every commit, and Illustrator snapped back to the short work area each time (240+ rejections, the menu bar
+ * above the screen). An unmeasured output got the borrowed value even when it was a whole panel off.
+ *
+ * Now each measurement carries the output it was taken on (wayland_report_output_maximized_h) and is kept, and
+ * persisted, by output name. An output without one gets the 32px estimate; the single value is only used while no
+ * output has its own (a file written by an older runtime, or none yet). File: the single value on the first line
+ * (what older runtimes read), then "<output-name> <height>" lines. Kill switch NEUTRON_WORKAREA_PER_OUTPUT=0. */
+#define NEUTRON_WORKAREA_OUTPUTS 16
+static pthread_mutex_t neutron_workarea_mutex = PTHREAD_MUTEX_INITIALIZER;
+static BOOL neutron_workarea_loaded;
+static int neutron_workarea_legacy;
+static struct { char name[64]; int h; } neutron_workarea_outputs[NEUTRON_WORKAREA_OUTPUTS];
+static int neutron_workarea_output_count;
+
+BOOL neutron_workarea_per_output(void)
 {
-    static int cached = -1;   /* -1 = not read yet, 0 = absent/unusable */
-    char path[NEUTRON_WORKAREA_PATH_MAX];
+    static int on = -1;
+    if (on < 0) on = neutron_gate("NEUTRON_WORKAREA_PER_OUTPUT", TRUE);
+    return on;
+}
+
+/* neutron_workarea_mutex held */
+static void neutron_workarea_load_locked(void)
+{
+    char path[NEUTRON_WORKAREA_PATH_MAX], line[256], name[64];
     FILE *f;
-    int v = 0;
+    int v;
 
-    if (cached >= 0) return cached;
-    cached = 0;
+    if (neutron_workarea_loaded) return;
+    neutron_workarea_loaded = TRUE;
     neutron_workarea_path(path, sizeof(path));
-    if (!path[0]) return 0;
-    if (!(f = fopen(path, "r"))) return 0;
-    if (fscanf(f, "%d", &v) != 1 || v <= 0 || v > 100000) v = 0;
+    if (!path[0] || !(f = fopen(path, "r"))) return;
+    while (fgets(line, sizeof(line), f))
+    {
+        if (sscanf(line, "%63s %d", name, &v) == 2)
+        {
+            if (v > 0 && v <= 100000 && neutron_workarea_output_count < NEUTRON_WORKAREA_OUTPUTS)
+            {
+                snprintf(neutron_workarea_outputs[neutron_workarea_output_count].name, 64, "%s", name);
+                neutron_workarea_outputs[neutron_workarea_output_count++].h = v;
+            }
+        }
+        else if (sscanf(line, "%d", &v) == 1 && v > 0 && v <= 100000 && !neutron_workarea_legacy)
+            neutron_workarea_legacy = v;
+    }
     fclose(f);
-    cached = v;
-    if (v) TRACE("neutron-workarea: loaded persisted measured=%d from %s\n", v, path);
-    return cached;
+    TRACE("neutron-workarea: loaded legacy=%d, %d output(s) from %s\n", neutron_workarea_legacy,
+          neutron_workarea_output_count, path);
 }
 
-void neutron_workarea_save_measured(int logical_h)
+/* neutron_workarea_mutex held */
+static void neutron_workarea_write_locked(void)
 {
     char path[NEUTRON_WORKAREA_PATH_MAX];
     FILE *f;
+    int i;
 
-    if (logical_h <= 0) return;
     neutron_workarea_path(path, sizeof(path));
-    if (!path[0]) return;
-    if (!(f = fopen(path, "w"))) return;
-    fprintf(f, "%d\n", logical_h);
+    if (!path[0] || !(f = fopen(path, "w"))) return;
+    if (neutron_workarea_legacy) fprintf(f, "%d\n", neutron_workarea_legacy);
+    for (i = 0; i < neutron_workarea_output_count; i++)
+        fprintf(f, "%s %d\n", neutron_workarea_outputs[i].name, neutron_workarea_outputs[i].h);
     fclose(f);
-    TRACE("neutron-workarea: persisted measured=%d to %s\n", logical_h, path);
+}
+
+int neutron_workarea_load_measured(void)
+{
+    int v;
+
+    pthread_mutex_lock(&neutron_workarea_mutex);
+    neutron_workarea_load_locked();
+    v = neutron_workarea_legacy;
+    pthread_mutex_unlock(&neutron_workarea_mutex);
+    return v;
+}
+
+void neutron_workarea_save_measured(int logical_h)
+{
+    if (logical_h <= 0) return;
+    pthread_mutex_lock(&neutron_workarea_mutex);
+    neutron_workarea_load_locked();
+    if (neutron_workarea_legacy != logical_h)
+    {
+        neutron_workarea_legacy = logical_h;
+        neutron_workarea_write_locked();
+        TRACE("neutron-workarea: persisted measured=%d\n", logical_h);
+    }
+    pthread_mutex_unlock(&neutron_workarea_mutex);
+}
+
+/* NEUTRON workarea#3: this output's measured maximized logical height, 0 if none */
+static int neutron_workarea_output_measured(const char *name)
+{
+    int i, v = 0;
+
+    if (!name || !neutron_workarea_per_output()) return 0;
+    pthread_mutex_lock(&neutron_workarea_mutex);
+    neutron_workarea_load_locked();
+    for (i = 0; i < neutron_workarea_output_count; i++)
+        if (!strcmp(neutron_workarea_outputs[i].name, name)) v = neutron_workarea_outputs[i].h;
+    pthread_mutex_unlock(&neutron_workarea_mutex);
+    return v;
+}
+
+static BOOL neutron_workarea_any_output(void)
+{
+    int n;
+
+    if (!neutron_workarea_per_output()) return FALSE;
+    pthread_mutex_lock(&neutron_workarea_mutex);
+    neutron_workarea_load_locked();
+    n = neutron_workarea_output_count;
+    pthread_mutex_unlock(&neutron_workarea_mutex);
+    return n > 0;
+}
+
+/* NEUTRON workarea#3: record (and persist) a measurement for an output; TRUE if it changed */
+BOOL neutron_workarea_save_output(const char *name, int logical_h)
+{
+    BOOL changed = FALSE;
+    int i;
+
+    if (!name || !*name || logical_h <= 0 || !neutron_workarea_per_output()) return FALSE;
+    pthread_mutex_lock(&neutron_workarea_mutex);
+    neutron_workarea_load_locked();
+    for (i = 0; i < neutron_workarea_output_count; i++)
+        if (!strcmp(neutron_workarea_outputs[i].name, name)) break;
+    if (i == neutron_workarea_output_count && i < NEUTRON_WORKAREA_OUTPUTS)
+    {
+        snprintf(neutron_workarea_outputs[i].name, 64, "%s", name);
+        neutron_workarea_outputs[i].h = 0;
+        neutron_workarea_output_count++;
+    }
+    if (i < neutron_workarea_output_count && neutron_workarea_outputs[i].h != logical_h)
+    {
+        neutron_workarea_outputs[i].h = logical_h;
+        neutron_workarea_write_locked();
+        changed = TRUE;
+    }
+    pthread_mutex_unlock(&neutron_workarea_mutex);
+    if (changed) TRACE("neutron-workarea: %s measured maximized height %d\n", name, logical_h);
+    return changed;
 }
 
