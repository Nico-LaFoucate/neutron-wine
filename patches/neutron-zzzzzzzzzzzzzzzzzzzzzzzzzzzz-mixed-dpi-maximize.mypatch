+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -550,6 +550,10 @@
  * 2026-08-11: first launch unusable, second launch fine. Load returns 0 when unknown. */
 int neutron_workarea_load_measured(void);
 void neutron_workarea_save_measured(int logical_h);
+/* NEUTRON workarea#3: per-output maximized heights (display.c), reported from app processes (wayland_output.c) */
+BOOL neutron_workarea_per_output(void);
+BOOL neutron_workarea_save_output(const char *name, int logical_h);
+void wayland_report_output_maximized_h(uint32_t output_id, int logical_h);
 BOOL wayland_surface_config_is_compatible(struct wayland_surface_config *conf,
                                           int width, int height,
                                           enum wayland_surface_config_state state);
--- a/dlls/winewayland.drv/wayland_output.c
+++ b/dlls/winewayland.drv/wayland_output.c
@@ -138,6 +138,35 @@
  * So carry the value in wparam of the message the desktop process already handles. Caught in
  * review by the build tester before this was ever built; it could not have been caught on the
  * dev box, where measured and estimated insets are numerically identical. */
+/* NEUTRON workarea#3: the same, for the output the maximized toplevel is on (wl_registry global names are the same
+ * in every process). Sent once per (output, height) change from this process; the desktop process stores it under
+ * the output's name and rebuilds the monitor list only when it changed (display.c, window.c). */
+void wayland_report_output_maximized_h(uint32_t output_id, int logical_h)
+{
+    static uint32_t last_id[8];
+    static int last_h[8];
+    HWND desktop_hwnd;
+    int i, free_slot = -1;
+
+    if (!process_wayland.initialized || !output_id || logical_h <= 0 || !neutron_workarea_per_output()) return;
+    for (i = 0; i < ARRAY_SIZE(last_id); i++)
+    {
+        if (last_id[i] == output_id) break;
+        if (!last_id[i] && free_slot < 0) free_slot = i;
+    }
+    if (i < ARRAY_SIZE(last_id))
+    {
+        if (last_h[i] == logical_h) return;
+    }
+    else if (free_slot >= 0) i = free_slot;
+    else i = 0;
+    last_id[i] = output_id;
+    last_h[i] = logical_h;
+
+    if (!(desktop_hwnd = NtUserGetDesktopWindow())) return;
+    NtUserPostMessage(desktop_hwnd, WM_WAYLAND_INIT_DISPLAY_DEVICES, (WPARAM)logical_h, (LPARAM)output_id);
+}
+
 void wayland_report_maximized_logical_h(int logical_h)
 {
     HWND desktop_hwnd;
