--- a/dlls/win32u/region.c
+++ b/dlls/win32u/region.c
@@ -105,6 +105,56 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(region);
 
+/* NEUTRON PM-TRAILS ROUND-8 READ-TRACE helpers (see ntgdi_private.h).
+ * Inert unless NEUTRON_READ_TRACE=1. */
+__thread int neutron_diag_busy = 0;
+int neutron_read_trace(void)
+{
+    static int v = -1;
+    if (v < 0) { const char *e = getenv("NEUTRON_READ_TRACE"); v = (e && e[0]=='1') ? 1 : 0; }
+    return v;
+}
+static int neutron_read_bands( RECT *out )
+{
+    static RECT bands[4];
+    static int n = -1;
+    if (n < 0)
+    {
+        const char *e = getenv("NEUTRON_READ_BAND");
+        n = 0;
+        while (e && n < 4)
+        {
+            int l, t, r, b;
+            if (sscanf( e, "%d:%d:%d:%d", &l, &t, &r, &b ) == 4)
+            {
+                bands[n].left = l; bands[n].top = t; bands[n].right = r; bands[n].bottom = b;
+                n++;
+            }
+            e = strchr( e, ',' );
+            if (e) e++;
+        }
+    }
+    memcpy( out, bands, sizeof(bands) );
+    return n;
+}
+BOOL neutron_read_band_hit( const RECT *r )
+{
+    RECT b[4];
+    int n, i;
+    if (!neutron_read_trace() || neutron_diag_busy) return FALSE;
+    if (r->bottom <= r->top || r->right <= r->left) return FALSE;
+    if (r->bottom - r->top > 600) return FALSE;   /* skip full-window/huge regions */
+    n = neutron_read_bands( b );
+    for (i = 0; i < n; i++)
+        if (r->left < b[i].right && b[i].left < r->right &&
+            r->top < b[i].bottom && b[i].top < r->bottom) return TRUE;
+    return FALSE;
+}
+BOOL neutron_read_pt_hit( int x, int y )
+{
+    RECT r = { x, y, x + 1, y + 1 };
+    return neutron_read_band_hit( &r );
+}
 
 static BOOL REGION_DeleteObject( HGDIOBJ handle );
 
