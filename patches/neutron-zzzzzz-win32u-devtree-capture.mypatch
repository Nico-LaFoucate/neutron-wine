+            }
+            if (pp && color_info->bmiHeader.biBitCount == 32 &&
+                color_info->bmiHeader.biWidth > 2000 &&
+                dirty.bottom > band[1] && dirty.top < band[3])
+            {
+                int width = color_info->bmiHeader.biWidth;
+                int height = abs( color_info->bmiHeader.biHeight );
+                int bottom_up = color_info->bmiHeader.biHeight > 0;
+                int rows[2] = { band[1] + (band[3] - band[1]) / 3, band[1] + 2 * (band[3] - band[1]) / 3 };
+                int r;
+                for (r = 0; r < 2; r++)
+                {
+                    int y = rows[r], x, l = band[0], rt = min( band[2], width );
+                    const UINT *px;
+                    UINT bg;
+                    char buf[360]; int n = 0, nseg = 0, sx = -1;
+                    UINT scol = 0;
+                    if (y < 0 || y >= height || l < 0 || l >= rt) continue;
+                    px = (const UINT *)color_bits + (bottom_up ? (height - 1 - y) : y) * (SIZE_T)width;
+                    bg = px[l] & 0xffffff;
+                    buf[0] = 0;
+                    /* runs of identical color != bg, min width 4 (skips antialias dust);
+                     * splits on any color change so a marker blob inside a progress
+                     * fill still shows as its own run */
+                    for (x = l; x <= rt; x++)
