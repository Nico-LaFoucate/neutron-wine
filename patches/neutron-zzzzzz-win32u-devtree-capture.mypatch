     TRACE( "hdc = %p box = (%s), fErase = %d\n", hdc, wine_dbgstr_rect(&rect), erase );
 
+    /* NEUTRON PM-TRAILS DIAG (NEUTRON_PAINT_TRACE=1): dump the FULL update region the
+     * app receives at BeginPaint, plus the window's screen rect. Pairs with the
+     * RedrawWindow logging below: lets us check whether, during a scrub, the old
+     * playhead-marker column is ever delivered to the app as part of an update
+     * region. If the invalidation covered it but BeginPaint's region does not, the
+     * region is being lost between invalidate and paint (win32u/server bug); if the
+     * app never invalidates the old position at all, the erase strategy is different. */
+    {
+        static int npt = -1;
+        if (npt < 0) { const char *e = getenv("NEUTRON_PAINT_TRACE"); npt = (e && e[0]=='1') ? 1 : 0; }
+        if (npt)
+        {
+            struct window_rects wr = {0};
+            DWORD sz; RGNDATA *rd = NULL; char buf[900]; int n = 0; unsigned cnt = 0;
+            buf[0] = 0;
+            neutron_diag_busy = 1;   /* don't confound the round-8 read-trace */
+            get_window_rects( hwnd, COORDS_SCREEN, &wr, get_thread_dpi() );
+            if (hrgn && (sz = NtGdiGetRegionData( hrgn, 0, NULL )) && (rd = malloc( sz )))
+            {
+                RECT *rr;
+                NtGdiGetRegionData( hrgn, sz, rd );
+                cnt = rd->rdh.nCount;
+                rr = (RECT *)rd->Buffer;
+                /* NOTE: cap raised from 5 — the old 5-rect cap silently hid the 6th
+                 * (old-marker) rect and produced a false "old rect not delivered" read */
+                for (unsigned i = 0; i < cnt && i < 20 && n < (int)sizeof(buf) - 48; i++)
+                    n += snprintf( buf + n, sizeof(buf) - n, "(%d,%d,%d,%d)",
+                                   (int)rr[i].left, (int)rr[i].top, (int)rr[i].right, (int)rr[i].bottom );
+                free( rd );
+            }
+            neutron_diag_busy = 0;
+            ERR( "neutron-paint: BeginPaint hwnd=%p win=%s fErase=%d clip=%s update[n=%u %s]\n",
+                 hwnd, wine_dbgstr_rect(&wr.window), erase, wine_dbgstr_rect(&rect), cnt, buf );
+        }
+    }
+
+    /* NEUTRON round-44 GDIPATH (env NEUTRON_GDIPATH=1): per-hwnd GDI-paint
+     * population + cost. Counts BeginPaint per hwnd + summed paint AREA + a 5s
+     * rate summary. This is the GDI-render population (which UI paints via GDI,
+     * how much area, how often) and lag component (a) = Premiere's own repaint
+     * cost. Pairs with the swapchain-content population (rootdump RAW) and the
+     * flush/present rates. Read-only. */
+    {
+        static int gp = -1;
+        if (gp < 0) { const char *e = getenv("NEUTRON_GDIPATH"); gp = (e && e[0]=='1') ? 1 : 0; }
+        if (gp)
+        {
+            static struct { HWND h; unsigned n; ULONG64 area; } tab[128];
+            static unsigned ntab; static ULONGLONG t0; ULONGLONG now;
+            ULONG64 a = (ULONG64)(rect.right - rect.left) * (rect.bottom - rect.top);
+            unsigned i;
+            for (i = 0; i < ntab; i++) if (tab[i].h == hwnd) break;
+            if (i == ntab && ntab < 128) { tab[ntab].h = hwnd; tab[ntab].n = 0; tab[ntab].area = 0; ntab++; }
+            if (i < 128) { tab[i].n++; tab[i].area += a; }
+            now = NtGetTickCount(); if (!t0) t0 = now;
+            if (now - t0 >= 5000)
+            {
+                unsigned j;
+                for (j = 0; j < ntab; j++) if (tab[j].n)
+                    ERR("neutron-gdipath: BeginPaint hwnd=%p paints=%u totalAreaMPx=%llu (GDI-render window)\n",
+                        tab[j].h, tab[j].n, (unsigned long long)(tab[j].area / 1000000));
+                for (j = 0; j < ntab; j++) { tab[j].n = 0; tab[j].area = 0; }
+                t0 = now;
+            }
+        }
+    }
