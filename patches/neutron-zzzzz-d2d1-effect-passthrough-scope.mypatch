+    /* NEUTRON: this effect is one of OUR registration stubs (Unpremultiply/Premultiply), which
+     * have no implementation at all -- so DrawImage() on their output must fall back to drawing
+     * the source input. NEVER set for a real effect: doing so silently draws an effect's INPUT
+     * instead of its OUTPUT, bypassing the effect. See d2d_effect_image_get_source(). */
+    BOOL neutron_passthrough;
 };
 
 ID2D1Image *d2d_effect_image_get_source(ID2D1Image *iface);
@@ -1524,6 +1587,9 @@
 void d2d_command_list_push_layer(struct d2d_command_list *command_list, const struct d2d_device_context *context,
         const D2D1_LAYER_PARAMETERS1 *params);
 void d2d_command_list_pop_layer(struct d2d_command_list *command_list);
+/* NEUTRON: replay a closed command list into a device context (DrawImage). */
+HRESULT d2d_command_list_playback(struct d2d_command_list *command_list, ID2D1DeviceContext *context,
+        const D2D1_POINT_2F *target_offset, const D2D1_RECT_F *image_rect);
 
 static inline BOOL d2d_array_reserve(void **elements, size_t *capacity, size_t count, size_t size)
 {
