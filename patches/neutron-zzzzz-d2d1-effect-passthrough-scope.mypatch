--- a/dlls/d2d1/effect.c
+++ b/dlls/d2d1/effect.c
@@ -3130,6 +3130,21 @@
     if (!effect->input_count)
         return NULL;
 
+    /* ⚠️ NEUTRON 2026-08-03 -- REGRESSION FIX. This used to return inputs[0] for ANY effect with
+     * an input. DrawImage() follows this chain, so every app calling DrawImage() on a REAL,
+     * working effect got the effect's INPUT drawn instead of its OUTPUT -- the effect silently
+     * did nothing. It shipped because it was only ever tested against After Effects, whose
+     * Unpremultiply IS a stub, where the fallback is correct and invisible.
+     *
+     * What it cost: Premiere's Program Monitor draws video through D2D effects, so it rendered
+     * black and left trails on resize (nothing was compositing the real output). It read exactly
+     * like a present-path bug and sent the investigation to dcomp, DXVK and winewayland first.
+     *
+     * Only OUR stubs may pass through. A stub has no implementation, so DrawImage() on its output
+     * would otherwise draw nothing at all -- that, and only that, is what this is for. */
+    if (!effect->neutron_passthrough)
+        return NULL;
+
     return effect->inputs[0];
 }
 
@@ -3627,6 +3642,12 @@
     object->ID2D1Image_iface.lpVtbl = &d2d_effect_image_vtbl;
     object->refcount = 1;
     object->effect_context = effect_context;
+    /* NEUTRON: mark ONLY our two registration stubs as passthrough. Whitelisting the exact
+     * CLSIDs, rather than inferring "is a stub" from having no properties, keeps every real
+     * effect on its normal path -- an inference here is what regressed Premiere's Program
+     * Monitor. If another stub is ever added, add it here deliberately. */
+    object->neutron_passthrough = IsEqualGUID(effect_id, &CLSID_D2D1UnPremultiply)
+            || IsEqualGUID(effect_id, &CLSID_D2D1Premultiply);
 
     /* Create properties */
     d2d_effect_duplicate_properties(object, &object->properties, reg->properties);
--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -353,6 +353,50 @@
 /* NEUTRON LAZY GROUP PATH: force a group's combined path before reading ->outline. */
 HRESULT d2d_geometry_require_outline(struct d2d_geometry *geometry);
 
+/* NEUTRON: skip the DC-direct blit-back for a frame in which D2D drew NOTHING
+ * (env NEUTRON_D2D_SKIPEMPTY=1).
+ *
+ * WHY. DC-direct reads the window's current pixels into the D2D bitmap at BeginDraw, lets D2D
+ * draw over them, then blits the drawn union back. If D2D issued no operations at all, that
+ * blit writes back exactly what it read -- a no-op AT BEST. It is actively harmful if anything
+ * else painted the window between our read and our write-back, because we then restore the
+ * stale pixels over that content.
+ *
+ * After Effects' composition viewer (2734x1174) does precisely this: measured over 91 frames it
+ * reports ops=0 clears=0 every time, with a FULL-PANEL union, while issuing no GPU present of
+ * any kind (0 DXVK presents, 0 OpenGL). So its content -- if it arrives by GDI, which is the one
+ * path none of our tracing covers -- would be erased by a full-panel blit-back of pixels
+ * captured before it was drawn.
+ *
+ * Skipping is correct regardless of whether that is the cause: a frame that drew nothing has
+ * nothing to composite. */
+static inline BOOL neutron_skipempty(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        char buf[8];
+        v = (GetEnvironmentVariableA("NEUTRON_D2D_SKIPEMPTY", buf, sizeof(buf)) && buf[0] == '1') ? 1 : 0;
+    }
+    return v;
+}
+
+/* NEUTRON op-trace level 2 (NEUTRON_D2D_OPTRACE=2): drop the timeline-shaped size filter and
+ * trace EVERY DC-direct container. The level-1 filter (>=3000 wide, <=700 tall) was written for
+ * Premiere's timeline rows and silently excludes After Effects' composition viewer (2734x1174),
+ * which is exactly the window whose content never appears. Level 2 is noisy by design -- use it
+ * for one targeted run, not a soak. */
+static inline BOOL neutron_optrace_all(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        char buf[8];
+        v = (GetEnvironmentVariableA("NEUTRON_D2D_OPTRACE", buf, sizeof(buf)) && buf[0] == '2') ? 1 : 0;
+    }
+    return v;
+}
+
 /* NEUTRON op-trace (env NEUTRON_D2D_OPTRACE=1): per-frame op/clear log for the timeline
  * rows -- does the app WIPE its own panel and then draw almost nothing? */
 static inline BOOL neutron_optrace(void)
@@ -361,7 +405,10 @@
     if (v < 0)
     {
         char buf[8];
-        v = (GetEnvironmentVariableA("NEUTRON_D2D_OPTRACE", buf, sizeof(buf)) && buf[0] == '1') ? 1 : 0;
+        /* NEUTRON: level 2 must IMPLY level 1. Testing only for '1' meant NEUTRON_D2D_OPTRACE=2
+         * disabled every trace it was supposed to widen, and the run logged nothing at all. */
+        v = (GetEnvironmentVariableA("NEUTRON_D2D_OPTRACE", buf, sizeof(buf))
+                && (buf[0] == '1' || buf[0] == '2')) ? 1 : 0;
     }
     return v;
 }
@@ -738,6 +785,7 @@
     int excl_count;
     DWORD excl_tick;               /* GetTickCount of last scan (0 = never) */
     int excl_logged;               /* one-time per-hwnd diagnostic emitted */
+    int skipempty_logged;          /* one-time SKIPEMPTY diagnostic emitted */
     /* NEUTRON D2D DC-DIRECT: present-rate probe -- is this window SPINNING (present ->
      * InvalidateRect -> WM_PAINT -> present ...)? Logged every 1000 presents. */
     unsigned int pres_n;
@@ -1310,15 +1358,25 @@
     return v;
 }
 
-/* NEUTRON WIC READ-THROUGH: off by default. It changes who owns rendered pixels and when
- * they are copied, which is worth soaking behind a switch before it becomes the default
- * -- the same rollout the large-block heap cache got. */
+/* NEUTRON WIC READ-THROUGH: ON BY DEFAULT since 11.10-19. Set NEUTRON_WIC_READTHROUGH=0
+ * to disable.
+ *
+ * It shipped OFF in 11.10-18 and was soaked for hours of real Premiere use with the gate on:
+ * every hard counter stayed zero (no stale frames, no faults, no cap hits, no declined
+ * reads, no access violations), 3,432 reads served, peak working set 1 MB against a 192 MB
+ * budget. Correctness is separately covered by preserved-fixes/harnesses/wicrt.c -- 227
+ * pixel-value checks that pass with the gate both off and on, including the interleave case
+ * (draw A, draw B, then read A) that a naive deferred download fails.
+ *
+ * The escape hatch stays because this changes who owns rendered pixels: if a wrong-image
+ * bug ever appears, NEUTRON_WIC_READTHROUGH=0 is the one-step bisect. */
 static inline BOOL neutron_wic_readthrough(void)
 {
     static int v = -1;
     if (v < 0)
     {
         char buf[8];
+        /* absent -> ON; "0" -> OFF */
         v = (GetEnvironmentVariableA("NEUTRON_WIC_READTHROUGH", buf, sizeof(buf)) && buf[0] == '0') ? 0 : 1;
     }
     return v;
@@ -1427,6 +1485,11 @@
     ID2D1Image **inputs;
     size_t inputs_size;
