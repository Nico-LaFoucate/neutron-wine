                                 struct wayland_shm_buffer *shm_buffer,
                                 HRGN surface_damage_region)
 {
     RGNDATA *surface_damage;
     int win_width, win_height;
+    int old_content_x, old_content_y;
     RECT spill;
 
     TRACE("surface=%p shm_buffer=%p (%dx%d)\n",
@@ -1310,6 +1313,8 @@
      * the geometry as client-side shadow); cropping the wp_viewport source does.
      * win_width/win_height are left at the full window size so content_width/height
      * below stays a change-detection cookie against the full window rect. */
+    old_content_x = surface->content_x;
+    old_content_y = surface->content_y;
     if (wayland_surface_get_frame_spill_rect(surface, &spill))
     {
         int sx = spill.left, sy = spill.top;
@@ -1380,6 +1385,9 @@
     surface->content_width = win_width;
     surface->content_height = win_height;
     surface->ever_had_content = TRUE;
+
+    if (surface->content_x != old_content_x || surface->content_y != old_content_y)
+        neutron_resync_crop_origin(surface, old_content_x, old_content_y);
 }
 
 /***********************************************************************
@@ -2125,7 +2133,7 @@
  */
 static void wayland_surface_reconfigure_client(struct wayland_surface *surface,
                                                struct wayland_client_surface *client,
-                                               const RECT *client_rect, const RECT *clip)
+                                               const RECT *client_rect, const RECT *clip, BOOL resync)
 {
     struct wayland_window_config *window = &surface->window;
     int client_x, client_y, x, y;
@@ -2133,6 +2141,13 @@
 
     int origin_x, origin_y;
 
+    if (!resync)
+    {
+        client->neutron_rect = *client_rect;
+        client->neutron_rect_set = TRUE;
+        if ((client->neutron_clip_set = !!clip)) client->neutron_clip = *clip;
+    }
+
     /* The offset of the client area origin relatively to the window origin -- or, while the frame-spill crop
      * is on, to the window position of surface-local (0,0) (NEUTRON, see wayland_surface_content_origin). */
     wayland_surface_content_origin(surface, &origin_x, &origin_y);
@@ -2339,7 +2354,11 @@
          * that disconnects the client -> "Failed to read events -> terminating process"
          * = the project-load crash). Placing above the confirmed parent is always
          * valid; if it doesn't match, skip (attach will recreate it correctly). */
-        if (client->toplevel_wl_surface == surface->wl_surface)
+        if (resync)
+        {
+            /* NEUTRON crop-origin resync: position only, see neutron_resync_crop_origin */
+        }
+        else if (client->toplevel_wl_surface == surface->wl_surface)
         {
             /* NEUTRON round-35 NATIVE mode: subsurface ordering belongs EXCLUSIVELY to
              * neutron_restack_apply (win32-z-order mirror). Re-placing here on every
@@ -2505,15 +2524,21 @@
  * Reconfigures the subsurface as needed to match the latest requested
  * state.
  */
-static void wayland_surface_reconfigure_subsurface(struct wayland_surface *surface, const RECT *content)
+static BOOL neutron_owned_zorder(void);
+
+static BOOL neutron_reconf_keepz(void)
 {
-    struct wayland_win_data *toplevel_data;
-    struct wayland_surface *toplevel_surface;
-    int local_x, local_y, x, y;
+    static int on = -1;
+    if (on < 0) on = neutron_gate("NEUTRON_OWNED_RECONF_KEEPZ", TRUE);
+    return on;
+}
 
-    if (surface->processing.serial && surface->processing.processed &&
-        (toplevel_data = wayland_win_data_get_nolock(surface->toplevel_hwnd)) &&
-        (toplevel_surface = toplevel_data->wayland_surface))
+/* NEUTRON: where an owned subsurface goes in its toplevel's surface-local coordinates (also used by
+ * neutron_resync_crop_origin). `content` is this window's own crop (see below), or NULL. */
+static void neutron_subsurface_position(struct wayland_surface *surface, struct wayland_surface *toplevel_surface,
+                                        const RECT *content, int *out_x, int *out_y)
+{
+    int local_x, local_y, x, y;
     {
         int origin_x, origin_y;
 
@@ -2557,10 +2582,40 @@
                 surface->mixed_y = parent_y + y;
             }
         }
+    }
+    *out_x = x;
+    *out_y = y;
+}
+
+static void wayland_surface_reconfigure_subsurface(struct wayland_surface *surface, const RECT *content)
+{
+    struct wayland_win_data *toplevel_data;
+    struct wayland_surface *toplevel_surface;
+    int x, y;
+
+    if (surface->processing.serial && surface->processing.processed &&
+        (toplevel_data = wayland_win_data_get_nolock(surface->toplevel_hwnd)) &&
+        (toplevel_surface = toplevel_data->wayland_surface))
+    {
+        neutron_subsurface_position(surface, toplevel_surface, content, &x, &y);
 
         TRACE("hwnd=%p pos=%d,%d\n", surface->hwnd, x, y);
 
         wl_subsurface_set_position(surface->wl_subsurface, x, y);
+        /* NEUTRON owned-reconf-keepz: with the Win32 z-order mirror on, the order of a toplevel's owned
+         * subsurfaces belongs to neutron_restack_apply alone, as it does for client surfaces in native
+         * mode (wayland_client_surface_update). Re-placing this one just above the toplevel (or its
+         * client surface) on every move/resize dropped it beneath every sibling owned window, and the
+         * stacker's order cache then saw an unchanged Win32 order and never repaired it. Affinity 3.3:
+         * the modal "Log in or sign up" dialog opened from the Welcome panel sat BEHIND that panel
+         * (Win32 z-order and the restack both had the dialog on top), so the sign-in looked dead.
+         * Position only here; a new wl_subsurface starts on top and the stacker orders it on show.
+         * Kill switch NEUTRON_OWNED_RECONF_KEEPZ=0. */
+        if (neutron_owned_zorder() && neutron_reconf_keepz())
+        {
+            /* ordering: neutron_restack_apply */
+        }
+        else
         /* NEUTRON: place above the toplevel's client (Vulkan) surface ONLY when that
          * client surface is genuinely a SIBLING — i.e. currently attached to THIS
          * toplevel's wl_surface. During a reparent (a D2D-UI child hidden+reparented
@@ -2581,6 +2636,85 @@
 }
 
 /**********************************************************************
+ *          neutron_resync_crop_origin
+ *
+ * NEUTRON crop-origin resync. While the frame-spill crop is on (a maximized window whose frame hangs off its monitor)
+ * surface-local (0,0) is window (content_x, content_y), and every subsurface of the window -- the client (GPU)
+ * surfaces of its child windows and its owned windows -- is positioned relative to that point. The crop origin
+ * changes only here, when the first buffer of the new state is attached, but those positions were set earlier, when
+ * Win32 moved the windows, still against the OLD origin, and nothing set them again until the next present or move.
+ * Photoshop 2026 restored from maximized by a caption double-click: its canvas (a child window's Vulkan surface) stayed
+ * 6 device px (3 logical) up and left of where it belongs until the next input. On Windows a restored window's
+ * contents land at the restored position at once. So when the origin changes, place them again now, before the
+ * commit that applies the new crop: a subsurface position is parent state and lands in that same commit. A client
+ * surface whose viewport changed too (its edges round differently against the new origin, 1 px) is committed in sync
+ * mode and the parent committed here, as wayland_client_surface_attach_rect does, so its size lands in the same frame
+ * instead of at its next present; runs last in attach_shm, when all of the parent's state for this frame is set, and
+ * the caller's own commit right after is then an empty one. Position and size only; their order stays as
+ * neutron_restack_apply left it. Caller holds win_data_mutex (no user-lock calls here).
+ * Kill switch NEUTRON_CROP_ORIGIN_RESYNC=0.
+ */
+static void neutron_resync_crop_origin(struct wayland_surface *surface, int old_x, int old_y)
+{
+    static int on = -1;
+    HWND hwnds[256];
+    struct wayland_client_surface *synced[64];
+    UINT i, n, nc, no = 0, ns = 0;
+
+    if (on < 0) on = neutron_gate("NEUTRON_CROP_ORIGIN_RESYNC", TRUE);
+    if (!on || !surface->wl_surface) return;
+
+    nc = n = wayland_client_subsurfaces_of(surface->wl_surface, hwnds, ARRAY_SIZE(hwnds));
+    for (i = 0; i < n; i++)
+    {
+        struct wayland_win_data *d = wayland_win_data_get_nolock(hwnds[i]);
+        struct wayland_client_surface *client = d ? d->client_surface : NULL;
+
+        if (!client || !client->neutron_rect_set || !client->wl_subsurface ||
+            client->toplevel_wl_surface != surface->wl_surface) continue;
+        wayland_surface_reconfigure_client(surface, client, &client->neutron_rect,
+                                           client->neutron_clip_set ? &client->neutron_clip : NULL, TRUE);
+        if (client->vp_dirty && client->client.buffer_width && ns < ARRAY_SIZE(synced) &&
+            !InterlockedCompareExchange(&client->client.present_busy, 1, 0))
+        {
+            wl_subsurface_set_sync(client->wl_subsurface);
+            wl_surface_commit(client->wl_surface);
+            InterlockedExchange(&client->vp_dirty, 0);
+            synced[ns++] = client;
+        }
+    }
+
+    n = wayland_owned_subsurfaces_of(surface->hwnd, hwnds, ARRAY_SIZE(hwnds));
+    for (i = 0; i < n; i++)
+    {
+        struct wayland_win_data *d = wayland_win_data_get_nolock(hwnds[i]);
+        struct wayland_surface *owned = d ? d->wayland_surface : NULL;
+        RECT own_crop;
+        int x, y;
+
+        if (!owned || owned->role != WAYLAND_SURFACE_ROLE_SUBSURFACE || !owned->wl_subsurface ||
+            owned->subsurface_parent != surface->wl_surface) continue;
+        SetRect(&own_crop, owned->content_x, owned->content_y, owned->content_x, owned->content_y);
+        neutron_subsurface_position(owned, surface, (owned->content_x || owned->content_y) ? &own_crop : NULL, &x, &y);
+        wl_subsurface_set_position(owned->wl_subsurface, x, y);
+        no++;
+    }
+
+    if (ns)
+    {
+        wl_surface_commit(surface->wl_surface);
+        for (i = 0; i < ns; i++)
+        {
+            wl_subsurface_set_desync(synced[i]->wl_subsurface);
+            InterlockedExchange(&synced[i]->client.present_busy, 0);
+        }
+    }
+
+    ERR("neutron-crop-resync: hwnd=%p crop origin %d,%d -> %d,%d: re-placed %u client (%u resized) and %u owned"
+        " subsurfaces\n", surface->hwnd, old_x, old_y, surface->content_x, surface->content_y, nc, ns, no);
+}
+
+/**********************************************************************
  *          wayland_surface_reconfigure
  *
  * Reconfigures the wayland surface as needed to match the latest requested
@@ -4451,7 +4585,7 @@
             clip = &clip_rect;
     }
 
-    wayland_surface_reconfigure_client(surface, client, &client_rect, clip);
+    wayland_surface_reconfigure_client(surface, client, &client_rect, clip, FALSE);
 
     /* NEUTRON: a viewport change (crop/size) is CLIENT-surface state and shows only when that surface commits; the
      * position is parent state and shows with the commit below. Left to the app's next present, a container
