@@ -1100,6 +1105,7 @@
 11,wbem,mofcomp.exe
 11,wbem,wbemdisp.dll
 11,wbem,wbemprox.dll
+11,wbem,unsecapp.exe
 11,wbem,wmic.exe
 11,wbem,wmiutils.dll
 11,WindowsPowerShell\v1.0,powershell.exe
