--- a/dlls/wbemprox/main.c
+++ b/dlls/wbemprox/main.c
@@ -125,6 +125,8 @@
     return TRUE;
 }
 
+extern HRESULT WINAPI wbemprox_DllGetClassObject( REFCLSID, REFIID, void ** );
+
 HRESULT WINAPI DllGetClassObject( REFCLSID rclsid, REFIID iid, LPVOID *ppv )
 {
     IClassFactory *cf = NULL;
@@ -140,6 +142,6 @@
     {
        cf = &wbem_context_cf.IClassFactory_iface;
     }
-    if (!cf) return CLASS_E_CLASSNOTAVAILABLE;
+    if (!cf) return wbemprox_DllGetClassObject( rclsid, iid, ppv );
     return IClassFactory_QueryInterface( cf, iid, ppv );
 }
--- a/dlls/wbemprox/tests/services.c
+++ b/dlls/wbemprox/tests/services.c
@@ -285,6 +285,124 @@
     IWbemLocator_Release( locator );
 }
 
+struct test_sink
+{
+    IWbemObjectSink IWbemObjectSink_iface;
+    LONG refs;
+    LONG status_calls;
+    HRESULT status_hr;
+};
+
+static inline struct test_sink *impl_from_IWbemObjectSink( IWbemObjectSink *iface )
+{
+    return CONTAINING_RECORD( iface, struct test_sink, IWbemObjectSink_iface );
+}
+
+static HRESULT WINAPI test_sink_QueryInterface( IWbemObjectSink *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &IID_IWbemObjectSink ))
+    {
+        *obj = iface;
+        IWbemObjectSink_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI test_sink_AddRef( IWbemObjectSink *iface )
+{
+    return InterlockedIncrement( &impl_from_IWbemObjectSink( iface )->refs );
+}
+
+static ULONG WINAPI test_sink_Release( IWbemObjectSink *iface )
+{
+    return InterlockedDecrement( &impl_from_IWbemObjectSink( iface )->refs );
+}
+
+static HRESULT WINAPI test_sink_Indicate( IWbemObjectSink *iface, LONG count, IWbemClassObject **objects )
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI test_sink_SetStatus( IWbemObjectSink *iface, LONG flags, HRESULT hr, BSTR param,
+                                           IWbemClassObject *object )
+{
+    struct test_sink *sink = impl_from_IWbemObjectSink( iface );
+    sink->status_hr = hr;
+    InterlockedIncrement( &sink->status_calls );
+    return S_OK;
+}
+
+static const IWbemObjectSinkVtbl test_sink_vtbl =
+{
+    test_sink_QueryInterface,
+    test_sink_AddRef,
+    test_sink_Release,
+    test_sink_Indicate,
+    test_sink_SetStatus,
+};
+
+static void wait_status_calls( struct test_sink *sink, LONG count )
+{
+    DWORD start = GetTickCount();
+    MSG msg;
+
+    while (sink->status_calls < count && GetTickCount() - start < 5000)
+    {
+        while (PeekMessageW( &msg, NULL, 0, 0, PM_REMOVE )) DispatchMessageW( &msg );
+        Sleep( 10 );
+    }
+}
+
+static void test_UnsecuredApartment(void)
+{
+    struct test_sink sink = { { &test_sink_vtbl }, 1 };
+    IWbemUnsecuredApartment *wbem_apartment;
+    IUnsecuredApartment *apartment;
+    IWbemObjectSink *stub;
+    IUnknown *unk;
+    HRESULT hr;
+
+    hr = CoCreateInstance( &CLSID_UnsecuredApartment, NULL, CLSCTX_LOCAL_SERVER, &IID_IUnsecuredApartment,
+                           (void **)&apartment );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (hr != S_OK) return;
+
+    hr = IUnsecuredApartment_CreateObjectStub( apartment, (IUnknown *)&sink.IWbemObjectSink_iface, &unk );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IUnknown_QueryInterface( unk, &IID_IWbemObjectSink, (void **)&stub );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    IUnknown_Release( unk );
+
+    hr = IWbemObjectSink_SetStatus( stub, WBEM_STATUS_COMPLETE, WBEM_E_FAILED, NULL, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    wait_status_calls( &sink, 1 );
+    ok( sink.status_calls == 1, "got %ld calls\n", sink.status_calls );
+    ok( sink.status_hr == WBEM_E_FAILED, "got %#lx\n", sink.status_hr );
+    IWbemObjectSink_Release( stub );
+
+    hr = IUnsecuredApartment_QueryInterface( apartment, &IID_IWbemUnsecuredApartment, (void **)&wbem_apartment );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (hr == S_OK)
+    {
+        hr = IWbemUnsecuredApartment_CreateSinkStub( wbem_apartment, &sink.IWbemObjectSink_iface,
+                                                     WBEM_FLAG_UNSECAPP_DEFAULT_CHECK_ACCESS, NULL, &stub );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        if (hr == S_OK)
+        {
+            hr = IWbemObjectSink_SetStatus( stub, WBEM_STATUS_COMPLETE, S_OK, NULL, NULL );
+            ok( hr == S_OK, "got %#lx\n", hr );
+            wait_status_calls( &sink, 2 );
+            ok( sink.status_calls == 2, "got %ld calls\n", sink.status_calls );
+            ok( sink.status_hr == S_OK, "got %#lx\n", sink.status_hr );
+            IWbemObjectSink_Release( stub );
+        }
+        IWbemUnsecuredApartment_Release( wbem_apartment );
+    }
+    IUnsecuredApartment_Release( apartment );
+}
+
 START_TEST(services)
 {
     CoInitialize( NULL );
@@ -292,5 +410,6 @@
     test_IWbemLocator();
     test_IWbemContext();
     test_namespaces();
+    test_UnsecuredApartment();
     CoUninitialize();
 }
--- /dev/null
+++ b/dlls/wbemprox/wbemprox_wbemcli.idl
@@ -0,0 +1,28 @@
+/*
+ * Proxy/stub code for the WMI interfaces that cross process boundaries
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#pragma makedep proxy
+#pragma makedep register
+
+#include "wbemcli.idl"
+
+[
+    threading(both),
+    uuid(7c857801-7381-11cf-884d-00aa004b2e24)  /* IWbemObjectSink */
+]
+coclass PSFactoryBuffer { interface IPSFactoryBuffer; }
--- /dev/null
+++ b/programs/unsecapp/Makefile.in
@@ -0,0 +1,7 @@
+MODULE    = unsecapp.exe
+IMPORTS   = uuid ole32 ntdll
+
+EXTRADLLFLAGS = -mwindows -municode
+
+SOURCES = \
+	main.c
--- /dev/null
+++ b/programs/unsecapp/main.c
@@ -0,0 +1,359 @@
+/*
+ * Unsecured Apartment (unsecapp.exe), the WMI out-of-process sink host
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Clients that receive asynchronous WMI results create CLSID_UnsecuredApartment as a local
+ * server and wrap their IWbemObjectSink with IUnsecuredApartment::CreateObjectStub or
+ * IWbemUnsecuredApartment::CreateSinkStub.  The returned forwarder lives in this process;
+ * WMI calls Indicate/SetStatus on it and it passes each call on to the client's sink.
+ *
+ * Like Wine's other background servers, the process marks itself as a Wine system process, so it
+ * never keeps a prefix's session alive on its own: it exits when its last object is released or
+ * when the session ends, whichever comes first.
+ *
+ * Kill switch: NEUTRON_UNSECAPP=0 in the client's environment makes the server exit without
+ * registering its class object (the activation then fails as it did before this server existed).
+ * Windows services get a fresh environment block, so for a service client (Adobe's AGMService)
+ * the variable has to be in the prefix's registry environment (HKCU\Environment).
+ */
+
+#define COBJMACROS
+#include <stdarg.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "objbase.h"
+#include "initguid.h"
+#include "wbemcli.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(unsecapp);
+
+static HANDLE exit_event;
+
+static void server_addref(void)
+{
+    CoAddRefServerProcess();
+}
+
+static void server_release(void)
+{
+    if (!CoReleaseServerProcess()) SetEvent( exit_event );
+}
+
+/* the forwarder handed back to the client */
+struct sink_stub
+{
+    IWbemObjectSink IWbemObjectSink_iface;
+    LONG refs;
+    IWbemObjectSink *sink;
+};
+
+static inline struct sink_stub *impl_from_IWbemObjectSink( IWbemObjectSink *iface )
+{
+    return CONTAINING_RECORD( iface, struct sink_stub, IWbemObjectSink_iface );
+}
+
+static HRESULT WINAPI sink_stub_QueryInterface( IWbemObjectSink *iface, REFIID riid, void **obj )
+{
+    struct sink_stub *stub = impl_from_IWbemObjectSink( iface );
+
+    TRACE( "%p, %s, %p\n", stub, debugstr_guid(riid), obj );
+
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &IID_IWbemObjectSink ))
+    {
+        *obj = iface;
+        IWbemObjectSink_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI sink_stub_AddRef( IWbemObjectSink *iface )
+{
+    struct sink_stub *stub = impl_from_IWbemObjectSink( iface );
+    ULONG refs = InterlockedIncrement( &stub->refs );
+    TRACE( "%p, refs %lu\n", stub, refs );
+    return refs;
+}
+
+static ULONG WINAPI sink_stub_Release( IWbemObjectSink *iface )
+{
+    struct sink_stub *stub = impl_from_IWbemObjectSink( iface );
+    ULONG refs = InterlockedDecrement( &stub->refs );
+
+    TRACE( "%p, refs %lu\n", stub, refs );
+    if (!refs)
+    {
+        IWbemObjectSink_Release( stub->sink );
+        free( stub );
+        server_release();
+    }
+    return refs;
+}
+
+static HRESULT WINAPI sink_stub_Indicate( IWbemObjectSink *iface, LONG count, IWbemClassObject **objects )
+{
+    struct sink_stub *stub = impl_from_IWbemObjectSink( iface );
+
+    TRACE( "%p, %ld, %p\n", stub, count, objects );
+    return IWbemObjectSink_Indicate( stub->sink, count, objects );
+}
+
+static HRESULT WINAPI sink_stub_SetStatus( IWbemObjectSink *iface, LONG flags, HRESULT hr, BSTR param,
+                                           IWbemClassObject *object )
+{
+    struct sink_stub *stub = impl_from_IWbemObjectSink( iface );
+
+    TRACE( "%p, %#lx, %#lx, %s, %p\n", stub, flags, hr, debugstr_w(param), object );
+    return IWbemObjectSink_SetStatus( stub->sink, flags, hr, param, object );
+}
+
+static const IWbemObjectSinkVtbl sink_stub_vtbl =
+{
+    sink_stub_QueryInterface,
+    sink_stub_AddRef,
+    sink_stub_Release,
+    sink_stub_Indicate,
+    sink_stub_SetStatus,
+};
+
+static HRESULT create_sink_stub( IUnknown *object, IWbemObjectSink **ret )
+{
+    struct sink_stub *stub;
+    IWbemObjectSink *sink;
+    HRESULT hr;
+
+    if (FAILED(hr = IUnknown_QueryInterface( object, &IID_IWbemObjectSink, (void **)&sink ))) return hr;
+    if (!(stub = calloc( 1, sizeof(*stub) )))
+    {
+        IWbemObjectSink_Release( sink );
+        return E_OUTOFMEMORY;
+    }
+    stub->IWbemObjectSink_iface.lpVtbl = &sink_stub_vtbl;
+    stub->refs = 1;
+    stub->sink = sink;
+    server_addref();
+
+    TRACE( "forwarder %p for sink %p\n", stub, sink );
+    *ret = &stub->IWbemObjectSink_iface;
+    return S_OK;
+}
+
+/* the UnsecuredApartment object */
+struct apartment
+{
+    IWbemUnsecuredApartment IWbemUnsecuredApartment_iface;
+    LONG refs;
+};
+
+static inline struct apartment *impl_from_IWbemUnsecuredApartment( IWbemUnsecuredApartment *iface )
+{
+    return CONTAINING_RECORD( iface, struct apartment, IWbemUnsecuredApartment_iface );
+}
+
+static HRESULT WINAPI apartment_QueryInterface( IWbemUnsecuredApartment *iface, REFIID riid, void **obj )
+{
+    struct apartment *apartment = impl_from_IWbemUnsecuredApartment( iface );
+
+    TRACE( "%p, %s, %p\n", apartment, debugstr_guid(riid), obj );
+
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &IID_IUnsecuredApartment ) ||
+        IsEqualGUID( riid, &IID_IWbemUnsecuredApartment ))
+    {
+        *obj = iface;
+        IWbemUnsecuredApartment_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI apartment_AddRef( IWbemUnsecuredApartment *iface )
+{
+    struct apartment *apartment = impl_from_IWbemUnsecuredApartment( iface );
+    return InterlockedIncrement( &apartment->refs );
+}
+
+static ULONG WINAPI apartment_Release( IWbemUnsecuredApartment *iface )
+{
+    struct apartment *apartment = impl_from_IWbemUnsecuredApartment( iface );
+    ULONG refs = InterlockedDecrement( &apartment->refs );
+
+    if (!refs)
+    {
+        TRACE( "destroying %p\n", apartment );
+        free( apartment );
+        server_release();
+    }
+    return refs;
+}
+
+static HRESULT WINAPI apartment_CreateObjectStub( IWbemUnsecuredApartment *iface, IUnknown *object,
+                                                  IUnknown **stub )
+{
+    TRACE( "%p, %p, %p\n", iface, object, stub );
+
+    if (!stub) return E_POINTER;
+    *stub = NULL;
+    if (!object) return E_INVALIDARG;
+    return create_sink_stub( object, (IWbemObjectSink **)stub );
+}
+
+static HRESULT WINAPI apartment_CreateSinkStub( IWbemUnsecuredApartment *iface, IWbemObjectSink *sink,
+                                                DWORD flags, const WCHAR *reserved, IWbemObjectSink **stub )
+{
+    TRACE( "%p, %p, %#lx, %s, %p\n", iface, sink, flags, debugstr_w(reserved), stub );
+
+    if (!stub) return E_POINTER;
+    *stub = NULL;
+    if (!sink || flags > WBEM_FLAG_UNSECAPP_DONT_CHECK_ACCESS) return WBEM_E_INVALID_PARAMETER;
+    return create_sink_stub( (IUnknown *)sink, stub );
+}
+
+static const IWbemUnsecuredApartmentVtbl apartment_vtbl =
+{
+    apartment_QueryInterface,
+    apartment_AddRef,
+    apartment_Release,
+    apartment_CreateObjectStub,
+    apartment_CreateSinkStub,
+};
+
+static HRESULT WINAPI factory_QueryInterface( IClassFactory *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_IUnknown ) || IsEqualGUID( riid, &IID_IClassFactory ))
+    {
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef( IClassFactory *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI factory_Release( IClassFactory *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI factory_CreateInstance( IClassFactory *iface, IUnknown *outer, REFIID riid, void **obj )
+{
+    struct apartment *apartment;
+    HRESULT hr;
+
+    TRACE( "%p, %s, %p\n", outer, debugstr_guid(riid), obj );
+
+    *obj = NULL;
+    if (outer) return CLASS_E_NOAGGREGATION;
+    if (!(apartment = calloc( 1, sizeof(*apartment) ))) return E_OUTOFMEMORY;
+    apartment->IWbemUnsecuredApartment_iface.lpVtbl = &apartment_vtbl;
+    apartment->refs = 1;
+    server_addref();
+
+    hr = IWbemUnsecuredApartment_QueryInterface( &apartment->IWbemUnsecuredApartment_iface, riid, obj );
+    IWbemUnsecuredApartment_Release( &apartment->IWbemUnsecuredApartment_iface );
+    return hr;
+}
+
+static HRESULT WINAPI factory_LockServer( IClassFactory *iface, BOOL lock )
+{
+    TRACE( "%d\n", lock );
+
+    if (lock) server_addref();
+    else server_release();
+    return S_OK;
+}
+
+static const IClassFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    factory_CreateInstance,
+    factory_LockServer,
+};
+
+static IClassFactory factory = { &factory_vtbl };
+
+static BOOL server_enabled(void)
+{
+    WCHAR value[8];
+    DWORD len = GetEnvironmentVariableW( L"NEUTRON_UNSECAPP", value, ARRAY_SIZE(value) );
+    BOOL enabled = !(len && len < ARRAY_SIZE(value) && value[0] == '0' && !value[1]);
+
+    ERR( "neutron-unsecapp: gate NEUTRON_UNSECAPP resolved to %d\n", enabled );
+    return enabled;
+}
+
+int __cdecl wmain( int argc, WCHAR *argv[] )
+{
+    BOOL embedding = FALSE;
+    HANDLE handles[2];
+    DWORD cookie;
+    HRESULT hr;
+    int i;
+
+    for (i = 1; i < argc; i++)
+        if (!wcsicmp( argv[i], L"-Embedding" ) || !wcsicmp( argv[i], L"/Embedding" )) embedding = TRUE;
+
+    if (!embedding)
+    {
+        TRACE( "not started by COM, nothing to do\n" );
+        return 0;
+    }
+    if (!server_enabled()) return 0;
+
+    if (!(exit_event = CreateEventW( NULL, TRUE, FALSE, NULL ))) return 1;
+    if (FAILED(hr = CoInitializeEx( NULL, COINIT_MULTITHREADED )))
+    {
+        ERR( "CoInitializeEx failed, hr %#lx\n", hr );
+        return 1;
+    }
+    hr = CoRegisterClassObject( &CLSID_UnsecuredApartment, (IUnknown *)&factory, CLSCTX_LOCAL_SERVER,
+                                REGCLS_MULTIPLEUSE, &cookie );
+    if (FAILED(hr))
+    {
+        ERR( "CoRegisterClassObject failed, hr %#lx\n", hr );
+        CoUninitialize();
+        return 1;
+    }
+
+    handles[0] = exit_event;
+    handles[1] = NULL;
+    NtSetInformationProcess( GetCurrentProcess(), ProcessWineMakeProcessSystem, &handles[1], sizeof(HANDLE *) );
+
+    TRACE( "serving\n" );
+    if (handles[1]) i = WaitForMultipleObjects( 2, handles, FALSE, INFINITE );
+    else i = WaitForSingleObject( exit_event, INFINITE );
+    TRACE( "%s, exiting\n", i == WAIT_OBJECT_0 ? "last object released" : "session ending" );
+
+    CoRevokeClassObject( cookie );
+    CoUninitialize();
+    CloseHandle( exit_event );
+    return 0;
+}
