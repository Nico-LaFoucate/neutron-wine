@@ -1,5 +1,5 @@
 MODULE    = wbemprox.dll
-IMPORTS   = winspool version iphlpapi setupapi oleaut32 ole32 advapi32 user32 gdi32 ws2_32
+IMPORTS   = uuid winspool version iphlpapi setupapi oleaut32 ole32 rpcrt4 advapi32 user32 gdi32 ws2_32
 
 SOURCES = \
 	builtin.c \
@@ -16,4 +16,7 @@
 	table.c \
 	wbemlocator.c \
 	wbemprox.idl \
