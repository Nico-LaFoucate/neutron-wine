+/* NEUTRON tablet cursor (Neutron#56: "When pen tablet are used the cursor suddenly changed to cross
+ * shaped made it hard to use for drawing purposes. While using mouse on the other hand the cursor
+ * follow brush shape as it should be.")
+ *
+ * On Windows the pen drives the one system cursor: the tablet driver injects mouse input, the window
+ * under it answers WM_SETCURSOR, and the pen shows exactly what the mouse would (Photoshop's brush
+ * outline). The Win32 half already works the same here -- wintab.c injects the pen's mouse input
+ * through NtUserSendHardwareInput, so the window gets WM_SETCURSOR and win32u hands the resulting
+ * HCURSOR to WAYLAND_SetCursor -- but the driver only ever gave that cursor to wl_pointer. On Wayland
+ * every tablet tool has its OWN cursor (zwp_tablet_tool_v2.set_cursor, or cursor-shape-v1's
+ * get_tablet_tool_v2) and we never set one, so KWin showed its fallback crosshair for the pen over
+ * every Wine window (KDE bug 477570, the same for Qt before 6.8).
+ *
+ * Fix: each tool in proximity over one of our windows shows that window's current Win32 cursor,
+ * resolved by the same code as the pointer (cursor-shape for system cursors, else the bitmap with its
+ * hotspot at the window's scale, the retained last cursor for an unresolvable handle, NULL = hidden):
+ * at every proximity_in (the tool's cursor is undefined there, as the pointer's is at enter), at every
+ * WAYLAND_SetCursor for that window, and over another process's child window as the pointer does.
+ * Each tool (pen, eraser) has its own surface and shape device: a wl_surface may only ever be the
+ * cursor of one tool. Requests carry the tool's latest proximity_in serial.
+ * Kill switch NEUTRON_TABLET_CURSOR=0 (no tool cursor requests at all = 214's behavior);
+ * NEUTRON_TABLET_CURSOR_DIAG=1 prints one neutron-tabletcursor line per tool cursor update.
+ * Everything below runs with pointer->mutex held unless it says otherwise. */
+static BOOL neutron_tablet_cursor_enabled(void)
+{
+    static int v = -1;
+    if (v < 0) v = neutron_gate("NEUTRON_TABLET_CURSOR", TRUE);
+    return v;
+}
+
+static BOOL neutron_tablet_cursor_diag(void)
+{
+    static int v = -1;
+    if (v < 0) { const char *e = getenv("NEUTRON_TABLET_CURSOR_DIAG"); v = (e && e[0] == '1') ? 1 : 0; }
+    return v;
+}
+
+static enum wp_cursor_shape_device_v1_shape neutron_cursor_shape_of(HCURSOR hcursor)
+{
+    ICONINFOEXW info = {0};
+    enum wp_cursor_shape_device_v1_shape shape;
+
+    if (!process_wayland.wp_cursor_shape_manager_v1 || !hcursor) return 0;
+    if (!get_icon_info(hcursor, &info)) return 0;
+    shape = cursor_shape_from_info(&info, wp_cursor_shape_manager_v1_get_version(
+                                              process_wayland.wp_cursor_shape_manager_v1));
+    if (info.hbmColor) NtGdiDeleteObjectApp(info.hbmColor);
+    if (info.hbmMask) NtGdiDeleteObjectApp(info.hbmMask);
+    return shape;
+}
+
+static BOOL tablet_tool_set_shape(struct wayland_tablet_tool *tool, enum wp_cursor_shape_device_v1_shape shape)
+{
+    if (!process_wayland.wp_cursor_shape_manager_v1) return FALSE;
+    if (!tool->wp_cursor_shape_device_v1)
+        tool->wp_cursor_shape_device_v1 =
+            wp_cursor_shape_manager_v1_get_tablet_tool_v2(process_wayland.wp_cursor_shape_manager_v1,
+                                                          tool->zwp_tablet_tool_v2);
+    if (!tool->wp_cursor_shape_device_v1) return FALSE;
+    wp_cursor_shape_device_v1_set_shape(tool->wp_cursor_shape_device_v1, tool->proximity_serial, shape);
+    wayland_cursor_clear_surface(&tool->cursor);
+    return TRUE;
+}
+
+static void tablet_tool_apply_cursor(struct wayland_tablet_tool *tool, HCURSOR hcursor, double scale,
+                                     const char *why)
+{
+    struct wayland_cursor *cursor = &tool->cursor;
+    enum wp_cursor_shape_device_v1_shape shape;
+    const char *what;
+    BOOL resolved;
+
+    tool->cursor_xproc_shape = ~0u;   /* over another process's panel, the next motion shows its shape again */
+    if ((shape = neutron_cursor_shape_of(hcursor)) && tablet_tool_set_shape(tool, shape))
+    {
+        neutron_cursor_remember_shape(hcursor, shape);
+        what = "shape";
+        goto done;
+    }
+
+    resolved = wayland_cursor_update_buffer(cursor, hcursor, scale);
+    what = cursor->shm_buffer ? "bitmap" : "hidden";
+    /* an unresolvable handle shows the last resolved cursor, as on the pointer (NEUTRON_CURSOR_KEEP) */
+    if (!resolved && hcursor && neutron_cursor_keep_enabled())
+    {
+        if (neutron_cursor_last.shape || !neutron_cursor_last.shm_buffer)
+        {
+            shape = neutron_cursor_last.shape ? neutron_cursor_last.shape : WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_DEFAULT;
+            if (tablet_tool_set_shape(tool, shape))
+            {
+                what = "kept shape";
+                goto done;
+            }
+        }
+        else
+        {
+            if (cursor->shm_buffer) wayland_shm_buffer_unref(cursor->shm_buffer);
+            wayland_shm_buffer_ref(neutron_cursor_last.shm_buffer);
+            cursor->shm_buffer = neutron_cursor_last.shm_buffer;
+            cursor->hotspot_x = round(neutron_cursor_last.hotspot_x / scale);
+            cursor->hotspot_y = round(neutron_cursor_last.hotspot_y / scale);
+            what = "kept bitmap";
+        }
+    }
+
+    wayland_cursor_update_surface(cursor, scale);
+    zwp_tablet_tool_v2_set_cursor(tool->zwp_tablet_tool_v2, tool->proximity_serial,
+                                  cursor->wl_surface, cursor->hotspot_x, cursor->hotspot_y);
+    if (tool->wp_cursor_shape_device_v1)
+    {
+        wp_cursor_shape_device_v1_destroy(tool->wp_cursor_shape_device_v1);
+        tool->wp_cursor_shape_device_v1 = NULL;
+    }
+    if (!cursor->wl_surface) what = "hidden";
+
+done:
+    if (neutron_tablet_cursor_diag())
+        ERR("neutron-tabletcursor: %s tool=%p type=%#x hwnd=%p hcursor=%p -> %s shape=%u size=%dx%d "
+            "hotspot=%d,%d scale=%.3f serial=%u\n",
+            why, tool, tool->type, tool->cursor_hwnd, hcursor, what, (unsigned)shape,
+            cursor->shm_buffer ? cursor->shm_buffer->width : 0,
+            cursor->shm_buffer ? cursor->shm_buffer->height : 0,
+            cursor->hotspot_x, cursor->hotspot_y, scale, tool->proximity_serial);
+}
+
+/* WAYLAND_SetCursor for hwnd: every tool in proximity over it shows the same cursor. */
+static BOOL tablet_tools_set_cursor(HWND hwnd, HCURSOR hcursor, double scale)
+{
+    struct wayland_tablet *tablet = &process_wayland.tablet;
+    struct wayland_tablet_tool *tool;
+    BOOL any = FALSE;
+
+    if (!neutron_tablet_cursor_enabled()) return FALSE;
+    pthread_mutex_lock(&tablet->mutex);
+    if (tablet->zwp_tablet_seat_v2)   /* the tool list exists only once the seat does */
+    {
+        LIST_FOR_EACH_ENTRY(tool, &tablet->tools, struct wayland_tablet_tool, entry)
+        {
+            if (!tool->cursor_hwnd || tool->cursor_hwnd != hwnd) continue;
+            tablet_tool_apply_cursor(tool, hcursor, scale, "setcursor");
+            any = TRUE;
+        }
+    }
+    pthread_mutex_unlock(&tablet->mutex);
+    return any;
+}
+
+/* The window's current cursor, as wayland_set_cursor resolves it for the pointer. FALSE: not ours. */
+static BOOL tablet_window_cursor(HWND hwnd, HCURSOR *hcursor, double *scale)
+{
+    struct wayland_win_data *data;
+    BOOL ret = FALSE;
+
+    if (!(data = wayland_win_data_get(hwnd))) return FALSE;
+    if (data->wayland_surface)
+    {
+        *hcursor = data->wayland_surface->hcursor;
+        *scale = data->wayland_surface->window.scale;
+        ret = TRUE;
+    }
+    wayland_win_data_release(data);
+    return ret;
+}
+
+/* Event thread, proximity_in: the tool's cursor is undefined at every proximity_in (KWin shows its
+ * fallback crosshair), so set it again with the latest information we have, as pointer_handle_enter
+ * does for the pointer. */
+void wayland_tablet_tool_cursor_enter(struct wayland_tablet_tool *tool, uint32_t serial, HWND hwnd)
+{
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+    HCURSOR hcursor = NULL;
+    double scale = 1.0;
+    BOOL ours;
+
+    if (!neutron_tablet_cursor_enabled()) return;
+    ours = hwnd && tablet_window_cursor(hwnd, &hcursor, &scale);
+
+    pthread_mutex_lock(&pointer->mutex);
+    tool->cursor_hwnd = hwnd;
+    tool->proximity_serial = serial;
+    tool->cursor_xproc = FALSE;
+    if (ours) tablet_tool_apply_cursor(tool, hcursor, scale, "proximity_in");
+    else if (neutron_tablet_cursor_diag())
+        ERR("neutron-tabletcursor: proximity_in tool=%p hwnd=%p has no surface, cursor left to the compositor\n",
+            tool, hwnd);
+    pthread_mutex_unlock(&pointer->mutex);
+    wl_display_flush(process_wayland.wl_display);
+}
+
+/* Event thread, proximity_out: the compositor drops the tool's cursor; keep the objects for the next
+ * proximity_in (the surface may only ever serve this tool). */
+void wayland_tablet_tool_cursor_leave(struct wayland_tablet_tool *tool)
+{
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+
+    pthread_mutex_lock(&pointer->mutex);
+    tool->cursor_hwnd = NULL;
+    tool->cursor_xproc = FALSE;
+    pthread_mutex_unlock(&pointer->mutex);
+}
+
+/* Event thread, tool motion at screen (the pen's injected mouse position): over a child window of
+ * another process (a CEF panel host) that process's SetCursor cannot reach us, so mirror what
+ * pointer_motion_to_hwnd does for the mouse -- the published shape, or hidden. Leaving such a
+ * window, show our own window's cursor again. */
+void wayland_tablet_tool_cursor_motion(struct wayland_tablet_tool *tool, HWND hwnd, POINT screen)
+{
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+    HWND under;
+    DWORD under_pid = 0;
+    CURSORINFO ci = {0};
+    HCURSOR hcursor = NULL;
+    double scale = 1.0;
+    BOOL xproc;
+
+    if (!neutron_tablet_cursor_enabled() || !hwnd) return;
+    under = NtUserWindowFromPoint(screen.x, screen.y);
+    if (under) NtUserGetWindowThread(under, &under_pid);
+    xproc = under && under_pid && under_pid != GetCurrentProcessId();
+    if (!xproc && !tool->cursor_xproc) return;   /* the common case: our own window, SetCursor drives it */
+
+    ci.cbSize = sizeof(ci);
+    if (xproc) NtUserGetCursorInfo(&ci);
+    else if (!tablet_window_cursor(hwnd, &hcursor, &scale)) return;
+
+    pthread_mutex_lock(&pointer->mutex);
+    if (tool->cursor_hwnd == hwnd)
+    {
+        if (!xproc) tablet_tool_apply_cursor(tool, hcursor, scale, "left other process");
+        else if (!(ci.flags & CURSOR_SHOWING))
+        {
+            if (!tool->cursor_xproc || tool->cursor_xproc_shape)
+                tablet_tool_apply_cursor(tool, NULL, scale, "other process hidden");
+            tool->cursor_xproc_shape = 0;
+        }
+        else
+        {
+            volatile LONG *shm = neutron_cursor_shm();
+            LONG s = shm ? *shm : 0;
+            enum wp_cursor_shape_device_v1_shape shape = s > 0 ? (enum wp_cursor_shape_device_v1_shape)s
+                                                               : WP_CURSOR_SHAPE_DEVICE_V1_SHAPE_DEFAULT;
+            /* one request per change, not one per pen sample */
+            if ((!tool->cursor_xproc || shape != tool->cursor_xproc_shape) && tablet_tool_set_shape(tool, shape))
+            {
+                tool->cursor_xproc_shape = shape;
+                if (neutron_tablet_cursor_diag())
+                    ERR("neutron-tabletcursor: other process tool=%p hwnd=%p under=%p -> shape=%d serial=%u\n",
+                        tool, hwnd, under, (int)s, tool->proximity_serial);
+            }
+        }
+        tool->cursor_xproc = xproc;
+    }
+    pthread_mutex_unlock(&pointer->mutex);
+    wl_display_flush(process_wayland.wl_display);
+}
+
+/* Event thread, tool removed: before the tool is freed. */
+void wayland_tablet_tool_cursor_destroy(struct wayland_tablet_tool *tool)
+{
+    struct wayland_pointer *pointer = &process_wayland.pointer;
+
+    pthread_mutex_lock(&pointer->mutex);
+    tool->cursor_hwnd = NULL;
+    if (tool->wp_cursor_shape_device_v1)
+    {
+        wp_cursor_shape_device_v1_destroy(tool->wp_cursor_shape_device_v1);
+        tool->wp_cursor_shape_device_v1 = NULL;
+    }
+    wayland_cursor_clear_surface(&tool->cursor);
+    pthread_mutex_unlock(&pointer->mutex);
+}
+
 static void wayland_set_cursor(HWND hwnd, HCURSOR hcursor, BOOL use_hcursor)
 {
     struct wayland_pointer *pointer = &process_wayland.pointer;
@@ -1403,6 +1686,9 @@
         wl_display_flush(process_wayland.wl_display);
         reapply_clip = TRUE;
     }
+    /* NEUTRON tablet cursor: the pen in proximity over this window shows the same cursor. */
+    if (use_hcursor && tablet_tools_set_cursor(hwnd, hcursor, scale))
+        wl_display_flush(process_wayland.wl_display);
     pthread_mutex_unlock(&pointer->mutex);
 
     /* Reapply cursor clip since cursor visibility affects pointer constraint
--- a/dlls/winewayland.drv/wayland_tablet.c
+++ b/dlls/winewayland.drv/wayland_tablet.c
@@ -164,6 +164,7 @@
 
     TRACE("tablet tool removed: serial=%llx\n", tool->serial);
 
+    wayland_tablet_tool_cursor_destroy(tool);   /* NEUTRON tablet cursor: its surface + shape device */
     zwp_tablet_tool_v2_destroy(zwp_tablet_tool_v2);
     free(tool);
 }
@@ -177,6 +178,8 @@
     struct wayland_tablet_tool *tool = (struct wayland_tablet_tool *)data;
     tool->surface = surface;
     wayland_wintab_proximity_in(tool, serial, tablet, surface);
+    /* NEUTRON tablet cursor: show the window's Win32 cursor, not the compositor's fallback */
+    if (surface) wayland_tablet_tool_cursor_enter(tool, serial, wl_surface_get_user_data(surface));
 }
 
 static void wayland_tablet_tool_proximity_out(void *data,
@@ -184,6 +187,7 @@
 {
     struct wayland_tablet_tool *tool = (struct wayland_tablet_tool *)data;
     wayland_wintab_proximity_out(tool);
+    wayland_tablet_tool_cursor_leave(tool);   /* NEUTRON tablet cursor */
     tool->surface = NULL;
 }
 
@@ -276,6 +280,8 @@
          * the packet, so per-sample mouse+packet stay paired and ordered. */
         tool->pending_pos = screen;
         tool->pending_move = TRUE;
+        /* NEUTRON tablet cursor: over another process's child window, as the pointer does */
+        wayland_tablet_tool_cursor_motion(tool, hwnd, screen);
     }
     wayland_wintab_motion(tool, x, y);
 }
