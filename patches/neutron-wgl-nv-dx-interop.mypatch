+/***********************************************************************
+ *              wglSwapBuffers (OPENGL32.@)
+ */
+/* NEUTRON round-47 WHOLE-FRAME GL TRACE (NEUTRON_GL_FBOTRACE=1) -- closes the gap in round-42.
+ *
+ * ⚠️ WHY THIS EXISTS: round-42 sampled GL_DRAW_FRAMEBUFFER_BINDING *only at swap time*. An app
+ * that binds an FBO, renders into it, unbinds, and then swaps reads back drawFBO=0 on every
+ * single frame. So round-42's "drawFBO=0" NEVER established that AE avoids FBOs -- it could not
+ * have seen one. A whole-frame instrument is the only way to tell those two worlds apart, and
+ * they need completely different fixes:
+ *
+ *   draws > 0 and they land in a non-zero FBO, with no blit back to framebuffer 0
+ *       -> AE renders the composition offscreen and expects to bridge that texture out to D3D
+ *          (WGL_NV_DX_interop) rather than present it through GL. Wine then swaps a default
+ *          framebuffer nobody ever drew into. The bug is the missing bridge.
+ *   draws == 0 and clears == 0
+ *       -> AE issues NO GL rendering for this window at all. The GL surface is vestigial; the
+ *          ~350 swaps/session are AE ticking an output path it never fills, and the composition
+ *          is being produced somewhere else entirely (DirectX, per Adobe's own docs). Every
+ *          further minute spent on the GL path would be wasted.
+ *
+ * Counting has to happen inside the calls themselves, so the 12 functions below are moved out of
+ * the generated thunks into hand-written ones (make_opengl %manual_win_thunks). Each keeps its
+ * generated body verbatim and adds a counter bump -- no behaviour change when the env var is off,
+ * and the enabled path costs one TEB read plus an increment.
+ *
+ * Per-thread frame counters (reset at each swap) answer "what did THIS frame draw"; the global
+ * interlocked totals answer "did anything anywhere ever draw", which matters because a thread
+ * that renders but never swaps would otherwise be invisible.
+ */
+struct neutron_glcounters
+{
+    DWORD  tid;
+    /* reset every swap -- one frame's worth of work */
+    LONG   draws, clears, binds, blits, fbtex;
+    LONG   draws_to_fbo, draws_to_default;
+    /* never reset -- this thread's session totals */
+    LONG   t_draws, t_clears, t_binds, t_blits, t_fbtex;
+    LONG   t_draws_to_fbo, t_draws_to_default, t_blits_to_default;
+    GLuint cur_draw_fbo, max_fbo;
+};
+
+static struct neutron_glcounters neutron_glc[32];
+static LONG neutron_gl_all_draws, neutron_gl_all_clears, neutron_gl_all_binds, neutron_gl_all_blits;
+/* round-50: how many times a shader program has been made current, anywhere. A drawbot that
+ * never binds one has nothing to draw with. Reported alongside the draw counts at each swap. */
+static LONG neutron_gl_useprogram;
+
+static BOOL neutron_gltrace_on(void)
+{
+    static int enabled = -1;
+
+    if (enabled < 0)
+    {
+        const char *e = getenv( "NEUTRON_GL_FBOTRACE" );
+        enabled = (e && e[0] == '1') ? 1 : 0;
+    }
+    return enabled == 1;
+}
+
+/* Per-thread slot, found without a lock: a thread only ever writes its own slot, and the single
+ * race (two threads claiming the same free slot) is settled by the compare-exchange. Uses the TEB
+ * client id rather than GetCurrentThreadId so this pulls in no extra import. */
+static struct neutron_glcounters *neutron_glc_slot(void)
+{
+    DWORD tid;
+    unsigned int i;
+
+    if (!neutron_gltrace_on()) return NULL;
+
+    tid = (DWORD)(ULONG_PTR)NtCurrentTeb()->ClientId.UniqueThread;
+    for (i = 0; i < ARRAY_SIZE(neutron_glc); i++)
+    {
+        if (neutron_glc[i].tid == tid) return &neutron_glc[i];
+        if (!neutron_glc[i].tid &&
+            !InterlockedCompareExchange( (LONG *)&neutron_glc[i].tid, tid, 0 ))
+            return &neutron_glc[i];
+    }
+    return NULL;
+}
+
+static void neutron_glc_draw( struct neutron_glcounters *c )
+{
+    static LONG announced;
+
+    c->draws++; c->t_draws++;
+    if (c->cur_draw_fbo) { c->draws_to_fbo++; c->t_draws_to_fbo++; }
+    else { c->draws_to_default++; c->t_draws_to_default++; }
+    InterlockedIncrement( &neutron_gl_all_draws );
+
+    /* One-shot: the very first draw call of the session, with the window it landed on. If this
+     * line never appears, After Effects renders nothing through OpenGL, full stop. */
+    if (!InterlockedCompareExchange( &announced, 1, 0 ))
+        ERR( "NT-GLD first draw call: hwnd=%p drawFBO=%u\n",
+             NtUserWindowFromDC( wglGetCurrentDC() ), c->cur_draw_fbo );
+}
+
+/* round-51: called from every generated draw thunk (make_opengl inserts the call), so that
+ * "After Effects issues no drawing" is a statement about ALL of OpenGL's ~70 draw commands and
+ * not just the five that happened to be hand-written. */
+void neutron_count_draw(void)
+{
+    struct neutron_glcounters *c = neutron_glc_slot();
+    if (c) neutron_glc_draw( c );
+}
+
+static void neutron_glc_bind( struct neutron_glcounters *c, GLenum target, GLuint fb )
+{
+    static LONG announced;
+
+    c->binds++; c->t_binds++;
+    InterlockedIncrement( &neutron_gl_all_binds );
+    if (fb > c->max_fbo) c->max_fbo = fb;
+    /* GL_FRAMEBUFFER (0x8D40) sets both bindings; GL_DRAW_FRAMEBUFFER (0x8CA9) only the draw one.
+     * GL_READ_FRAMEBUFFER (0x8CA8) does not affect where drawing lands, so it is not tracked. */
+    if (target == 0x8D40 || target == 0x8CA9) c->cur_draw_fbo = fb;
+
+    if (fb && !InterlockedCompareExchange( &announced, 1, 0 ))
+        ERR( "NT-GLD first non-zero FBO bound: target=%#x fbo=%u hwnd=%p\n",
+             target, fb, NtUserWindowFromDC( wglGetCurrentDC() ) );
+}
+
+/* NEUTRON round-42 FBO TEST (NEUTRON_GL_FBOTRACE=1).
+ *
+ * HYPOTHESIS, from the Windows reference capture (HANDOFF-LINUX-ae-followup2 update.md):
+ * a second Windows capture covering startup + composition creation + 30 s of viewer scrubbing
+ * was BYTE-FOR-BYTE identical to the startup-only one -- 2,479 calls, SwapBuffers = 0,
+ * wglMakeCurrent = 5 -- with a verified positive control. So native AE NEVER presents the comp
+ * viewer with SwapBuffers, while Wine presents it ~350x/session. Wine is presenting a surface
+ * Windows never presents, and we already proved that surface is composited-but-EMPTY.
+ *
+ * The coherent reading: AE renders the composition into a GL FBO / texture, bridges it into
+ * D3D and presents via DXGI (invisible to API Monitor, which has no gl* definitions); under
+ * Wine it ends up calling SwapBuffers on a DEFAULT FRAMEBUFFER IT NEVER DREW INTO.
+ *
+ * This measures exactly that, at the only moment that matters -- the instant of the swap:
+ *   fbo=N (N != 0)  -> an FBO is bound for drawing, i.e. AE's output went somewhere ELSE and
+ *                      the default framebuffer being presented is not its render target.
+ *   fbo=0           -> AE really is drawing to the default framebuffer, and the emptiness is a
+ *                      different bug (it drew nothing, or something erased it).
+ * plus a centre-pixel sample of the BACK buffer actually about to be presented, and a
+ * black-vs-content tally, so "empty" is measured rather than inferred.
+ *
+ * Read-only: queries state and reads pixels, restores nothing because it changes nothing.
+ * Throttled to once every 64 swaps after the first 8 -- glReadPixels stalls the pipeline. */
+static void neutron_fbotrace( HDC hdc )
+{
+    static int enabled = -1;
+    static LONG swaps, black, sampled;
+    GLint draw_fbo = 0, read_fbo = 0, vp[4] = {0};
+    UINT32 px = 0;
+    LONG n;
+
+    if (enabled < 0)
+    {
+        const char *e = getenv( "NEUTRON_GL_FBOTRACE" );
+        enabled = (e && e[0] == '1') ? 1 : 0;
+    }
+    if (!enabled) return;
+
+    n = InterlockedIncrement( &swaps );
+    if (n > 8 && (n % 64)) return;
+
+    /* GL_DRAW_FRAMEBUFFER_BINDING == GL_FRAMEBUFFER_BINDING (0x8CA6); read binding 0x8CAA. */
+    glGetIntegerv( 0x8CA6, &draw_fbo );
+    glGetIntegerv( 0x8CAA, &read_fbo );
+    glGetIntegerv( GL_VIEWPORT, vp );
+
+    /* Sample the centre of the buffer that is about to be presented. */
+    if (vp[2] > 0 && vp[3] > 0)
+    {
+        glReadBuffer( GL_BACK );
+        glReadPixels( vp[0] + vp[2] / 2, vp[1] + vp[3] / 2, 1, 1, GL_BGRA, GL_UNSIGNED_BYTE, &px );
+        InterlockedIncrement( &sampled );
+        if (!(px & 0x00f0f0f0)) InterlockedIncrement( &black );
+    }
+
+    /* NEUTRON round-42b: name the WINDOW behind this DC and its real client size. Every swap
+     * came back viewport=1x1 on a single HDC, which has two very different explanations:
+     *   client rect 1x1        -> this is a genuinely tiny helper surface and the comp viewer
+     *                             is presented some other way entirely.
+     *   client rect 2734x1174  -> this IS the comp viewer, and AE's GL VIEWPORT was never
+     *                             updated after the window grew from its 1x1 placeholder --
+     *                             so AE renders the composition into a 1x1 corner of a
+     *                             full-size drawable. That would produce exactly a blank
+     *                             panel with healthy swaps, and it would be OUR bug: the
+     *                             context/drawable is created during the 1x1 placeholder
+     *                             phase (round-38 measured createsize=1x1) and something
+     *                             must tell the app the size changed. */
+    {
+        HWND hwnd = NtUserWindowFromDC( hdc );
+        RECT cr = {0};
+        if (hwnd) NtUserGetClientRect( hwnd, &cr, NtUserGetDpiForWindow( hwnd ) );
+        ERR( "NT-FBO swap#%ld hdc=%p hwnd=%p client=%dx%d drawFBO=%d readFBO=%d "
+             "viewport=%dx%d+%d+%d centre=%06x blackSamples=%ld/%ld\n",
+             n, hdc, hwnd, (int)(cr.right - cr.left), (int)(cr.bottom - cr.top),
+             draw_fbo, read_fbo, vp[2], vp[3], vp[0], vp[1], px & 0xffffff, black, sampled );
+
+        /* NEUTRON round-47: what this thread actually DID since the previous report. The
+         * "since" counters are reset here, the "total" ones are not, and the "all" ones cover
+         * every thread including any that renders but never swaps. */
+        {
+            struct neutron_glcounters *c = neutron_glc_slot();
+            if (c)
+            {
+                ERR( "NT-FBO2 swap#%ld hwnd=%p SINCE-LAST draws=%ld (fbo=%ld default=%ld) "
+                     "clears=%ld binds=%ld blits=%ld fbtex=%ld | THREAD-TOTAL draws=%ld "
+                     "(fbo=%ld default=%ld) clears=%ld binds=%ld blits=%ld (default=%ld) "
+                     "fbtex=%ld curFBO=%u maxFBO=%u | ALL-THREADS draws=%ld clears=%ld "
+                     "binds=%ld blits=%ld useProgram=%ld\n",
+                     n, hwnd, c->draws, c->draws_to_fbo, c->draws_to_default,
+                     c->clears, c->binds, c->blits, c->fbtex,
+                     c->t_draws, c->t_draws_to_fbo, c->t_draws_to_default,
+                     c->t_clears, c->t_binds, c->t_blits, c->t_blits_to_default, c->t_fbtex,
+                     c->cur_draw_fbo, c->max_fbo,
+                     neutron_gl_all_draws, neutron_gl_all_clears,
+                     neutron_gl_all_binds, neutron_gl_all_blits, neutron_gl_useprogram );
+                c->draws = c->clears = c->binds = c->blits = c->fbtex = 0;
+                c->draws_to_fbo = c->draws_to_default = 0;
+            }
+        }
+    }
+}
+
+/* NEUTRON round-44 CAUSAL TEST (NEUTRON_GL_FIXVIEWPORT=1) -- diagnostic, not the fix.
+ *
+ * MEASURED: After Effects' composition viewer (client 2734x1174) swaps with viewport=1x1 and
+ * drawFBO=0, and a full-session glViewport trace shows AE calls glViewport exactly TWICE, both
+ * on a different tiny window -- NEVER on the comp viewer. So AE relies on GL's initial viewport,
+ * which is the drawable size when the context is first made current, and Wine hands it the 1x1
+ * PLACEHOLDER drawable (round-38: createsize=1x1) because AE sets GL up before its window has
+ * been laid out. The EGL window is later resized correctly (1x1 -> 2734x1174) but a viewport is
+ * context state and nothing updates it.
+ *
+ * This forces the viewport to the window's real client size, but ONLY for a context whose
+ * viewport the app has never set itself -- never fight an app that manages its own viewport.
+ * Applied at swap time, so it takes effect for the NEXT frame's drawing (viewport is persistent
+ * state); the current frame is already rendered and cannot be rescued.
+ *
+ *   composition appears -> mechanism PROVEN, and the real fix is to stop handing out a 1x1
+ *       drawable / to make the initial viewport reflect the window rather than the placeholder.
+ *   still blank         -> the 1x1 viewport is a real bug but not THE bug, and something else
+ *       also prevents AE drawing. Either way this is measured, not argued.
+ *
+ * ⚠️ NEVER SHIP THIS ENABLED. Silently overriding app GL state is wrong as a permanent fix; it
+ *    exists to turn an inference into an observation.
+ */
+static void neutron_fixviewport( HDC hdc )
+{
+    static int enabled = -1;
+    static LONG applied;
+    GLint vp[4] = {0};
+    HWND hwnd;
+    RECT cr = {0};
+    LONG n;
+
+    if (enabled < 0)
+    {
+        const char *e = getenv( "NEUTRON_GL_FIXVIEWPORT" );
+        enabled = (e && e[0] == '1') ? 1 : 0;
+    }
+    if (!enabled) return;
+
+    /* Respect an app that sets its own viewport -- neutron_glviewport_was_set() is true once
+     * glViewport has been called on any context, which for AE it has (twice, elsewhere), so
+     * scope the check to this window instead. */
+    if (!(hwnd = NtUserWindowFromDC( hdc ))) return;
+    NtUserGetClientRect( hwnd, &cr, NtUserGetDpiForWindow( hwnd ) );
+    if (cr.right - cr.left <= 1 || cr.bottom - cr.top <= 1) return;
+
+    glGetIntegerv( GL_VIEWPORT, vp );
+    if (vp[2] == cr.right - cr.left && vp[3] == cr.bottom - cr.top) return;  /* already correct */
+    if (vp[2] > 1 || vp[3] > 1) return;  /* app set something real -- leave it alone */
+
+    glViewport( 0, 0, cr.right - cr.left, cr.bottom - cr.top );
+    n = InterlockedIncrement( &applied );
+    if (n <= 4 || !(n % 64))
+        ERR( "NT-VPFIX hwnd=%p viewport %dx%d -> %dx%d (applies from next frame) n=%ld\n",
+             hwnd, vp[2], vp[3], (int)(cr.right - cr.left), (int)(cr.bottom - cr.top), n );
+}
+
