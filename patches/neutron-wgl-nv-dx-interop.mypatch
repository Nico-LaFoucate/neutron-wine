+/* A blit whose DRAW binding is 0 is the app copying its offscreen result to the window -- the
+ * step whose absence would explain a black panel exactly. Counted separately for that reason. */
+void WINAPI glBlitFramebuffer( GLint srcX0, GLint srcY0, GLint srcX1, GLint srcY1, GLint dstX0, GLint dstY0, GLint dstX1, GLint dstY1, GLbitfield mask, GLenum filter )
+{
+    struct glBlitFramebuffer_params args = { .teb = NtCurrentTeb(), .srcX0 = srcX0, .srcY0 = srcY0, .srcX1 = srcX1, .srcY1 = srcY1, .dstX0 = dstX0, .dstY0 = dstY0, .dstX1 = dstX1, .dstY1 = dstY1, .mask = mask, .filter = filter };
+    struct neutron_glcounters *c = neutron_glc_slot();
+    NTSTATUS status;
+    if (c)
+    {
+        c->blits++; c->t_blits++;
+        if (!c->cur_draw_fbo) c->t_blits_to_default++;
+        InterlockedIncrement( &neutron_gl_all_blits );
+    }
+    TRACE( "srcX0 %d, srcY0 %d, srcX1 %d, srcY1 %d, dstX0 %d, dstY0 %d, dstX1 %d, dstY1 %d, mask %d, filter %d\n", srcX0, srcY0, srcX1, srcY1, dstX0, dstY0, dstX1, dstY1, mask, filter );
+    if ((status = UNIX_CALL( glBlitFramebuffer, &args ))) WARN( "glBlitFramebuffer returned %#lx\n", status );
+}
+
+void WINAPI glBlitFramebufferEXT( GLint srcX0, GLint srcY0, GLint srcX1, GLint srcY1, GLint dstX0, GLint dstY0, GLint dstX1, GLint dstY1, GLbitfield mask, GLenum filter )
+{
+    struct glBlitFramebufferEXT_params args = { .teb = NtCurrentTeb(), .srcX0 = srcX0, .srcY0 = srcY0, .srcX1 = srcX1, .srcY1 = srcY1, .dstX0 = dstX0, .dstY0 = dstY0, .dstX1 = dstX1, .dstY1 = dstY1, .mask = mask, .filter = filter };
+    struct neutron_glcounters *c = neutron_glc_slot();
+    NTSTATUS status;
+    if (c)
+    {
+        c->blits++; c->t_blits++;
+        if (!c->cur_draw_fbo) c->t_blits_to_default++;
+        InterlockedIncrement( &neutron_gl_all_blits );
+    }
+    TRACE( "srcX0 %d, srcY0 %d, srcX1 %d, srcY1 %d, dstX0 %d, dstY0 %d, dstX1 %d, dstY1 %d, mask %d, filter %d\n", srcX0, srcY0, srcX1, srcY1, dstX0, dstY0, dstX1, dstY1, mask, filter );
+    if ((status = UNIX_CALL( glBlitFramebufferEXT, &args ))) WARN( "glBlitFramebufferEXT returned %#lx\n", status );
+}
+
+/* Attaching a texture to an FBO names the surface AE renders into -- the thing that would have
+ * to be handed to D3D. Logged once per (fbo,texture,size) so a per-frame caller cannot flood. */
+static void neutron_glc_fbtex( struct neutron_glcounters *c, GLenum attachment, GLuint texture )
+{
+    static struct { GLuint fbo, tex; } seen[16];
+    static int nseen;
+    int i;
+
+    c->fbtex++; c->t_fbtex++;
+    for (i = 0; i < nseen; i++)
+        if (seen[i].fbo == c->cur_draw_fbo && seen[i].tex == texture) return;
+    if (nseen < ARRAY_SIZE(seen)) { seen[nseen].fbo = c->cur_draw_fbo; seen[nseen].tex = texture; nseen++; }
+    ERR( "NT-GLD fbo attach: fbo=%u attachment=%#x texture=%u hwnd=%p\n",
+         c->cur_draw_fbo, attachment, texture, NtUserWindowFromDC( wglGetCurrentDC() ) );
+}
+
+void WINAPI glFramebufferTexture2D( GLenum target, GLenum attachment, GLenum textarget, GLuint texture, GLint level )
+{
+    struct glFramebufferTexture2D_params args = { .teb = NtCurrentTeb(), .target = target, .attachment = attachment, .textarget = textarget, .texture = texture, .level = level };
+    struct neutron_glcounters *c = neutron_glc_slot();
+    NTSTATUS status;
+    if (c) neutron_glc_fbtex( c, attachment, texture );
+    TRACE( "target %d, attachment %d, textarget %d, texture %d, level %d\n", target, attachment, textarget, texture, level );
+    if ((status = UNIX_CALL( glFramebufferTexture2D, &args ))) WARN( "glFramebufferTexture2D returned %#lx\n", status );
+}
+
+void WINAPI glFramebufferTexture2DEXT( GLenum target, GLenum attachment, GLenum textarget, GLuint texture, GLint level )
+{
+    struct glFramebufferTexture2DEXT_params args = { .teb = NtCurrentTeb(), .target = target, .attachment = attachment, .textarget = textarget, .texture = texture, .level = level };
+    struct neutron_glcounters *c = neutron_glc_slot();
+    NTSTATUS status;
+    if (c) neutron_glc_fbtex( c, attachment, texture );
+    TRACE( "target %d, attachment %d, textarget %d, texture %d, level %d\n", target, attachment, textarget, texture, level );
+    if ((status = UNIX_CALL( glFramebufferTexture2DEXT, &args ))) WARN( "glFramebufferTexture2DEXT returned %#lx\n", status );
+}
+
+/***********************************************************************
+ * NEUTRON round-48 -- WHAT DOES AFTER EFFECTS' GL SELF-TEST SEE?
+ *
+ * Round 47 measured this: across a whole session After Effects issues 44 draw calls, ALL of them
+ * at startup, ALL on a hidden helper window (client 187x0), rendering into FBO 1 at 8x8 and then
+ * 256x1 with two colour attachments. After that it never issues another GL draw -- and the
+ * composition viewer's own GL surface is swapped 128+ times having never been drawn to, cleared,
+ * or even had a framebuffer bound. So AE is not failing to *deliver* GL rendering; it decides at
+ * startup not to *do* any, and that decision is made by this little offscreen self-test.
+ *
+ * Two readings, and only one of them is our bug:
+ *   the self-test FAILED  -> AE concluded its GL renderer is unusable here and shut the path
+ *                            down. The failure is ours to find and fix, and it is happening in
+ *                            a 44-draw sequence small enough to understand completely.
+ *   the self-test PASSED  -> AE enabled the path and then expects the frames to arrive by some
+ *                            route that is not GL drawing at all.
+ *
+ * These four report exactly what the self-test is told:
+ *   glCheckFramebufferStatus  is the render target AE built even complete? (0x8CD5 = COMPLETE)
+ *   glGetError                any GL error at all, which the app polls for and we never see
+ *   glReadPixels              the values AE reads back and judges -- if these are black or
+ *                             wrong, that IS the decision being made, in the open
+ *   glTexImage2D              the formats it asks for, since an unsupported one fails silently
+ *
+ * ⚠️ Note the self-test window's client rect is 187x0 -- ZERO height. Wine clamps that drawable
+ *    to 1x1 (a latent bug already noted separately). An 8x8 or 256x1 render into an FBO does not
+ *    depend on the drawable, but a readback that lands on the default framebuffer would.
+ */
+
+/* Shared cap so a per-frame caller cannot turn a diagnostic into a gigabyte. */
+static BOOL neutron_gl_budget( LONG *counter, LONG cap )
+{
+    return InterlockedIncrement( counter ) <= cap;
+}
+
+GLenum WINAPI glCheckFramebufferStatus( GLenum target )
+{
+    struct glCheckFramebufferStatus_params args = { .teb = NtCurrentTeb(), .target = target };
+    static LONG budget;
+    NTSTATUS status;
+    if ((status = UNIX_CALL( glCheckFramebufferStatus, &args ))) WARN( "glCheckFramebufferStatus returned %#lx\n", status );
+    if (neutron_gltrace_on() && neutron_gl_budget( &budget, 24 ))
+        ERR( "NT-GLS fbstatus target=%#x -> %#x (%s) hwnd=%p\n", target, args.ret,
+             args.ret == 0x8CD5 ? "COMPLETE" : "NOT COMPLETE",
+             NtUserWindowFromDC( wglGetCurrentDC() ) );
+    return args.ret;
+}
+
+GLenum WINAPI glCheckFramebufferStatusEXT( GLenum target )
+{
+    struct glCheckFramebufferStatusEXT_params args = { .teb = NtCurrentTeb(), .target = target };
+    static LONG budget;
+    NTSTATUS status;
+    if ((status = UNIX_CALL( glCheckFramebufferStatusEXT, &args ))) WARN( "glCheckFramebufferStatusEXT returned %#lx\n", status );
+    if (neutron_gltrace_on() && neutron_gl_budget( &budget, 24 ))
+        ERR( "NT-GLS fbstatusEXT target=%#x -> %#x (%s) hwnd=%p\n", target, args.ret,
+             args.ret == 0x8CD5 ? "COMPLETE" : "NOT COMPLETE",
+             NtUserWindowFromDC( wglGetCurrentDC() ) );
+    return args.ret;
+}
+
+/* Only non-zero returns are logged. An app polls glGetError constantly and GL_NO_ERROR tells us
+ * nothing; the first real error, with the window it happened on, tells us a great deal. */
+GLenum WINAPI glGetError(void)
+{
+    struct glGetError_params args = { .teb = NtCurrentTeb() };
+    static LONG budget;
+    NTSTATUS status;
+    if ((status = UNIX_CALL( glGetError, &args ))) WARN( "glGetError returned %#lx\n", status );
+    if (args.ret && neutron_gltrace_on() && neutron_gl_budget( &budget, 32 ))
+        ERR( "NT-GLS glGetError -> %#x hwnd=%p\n", args.ret, NtUserWindowFromDC( wglGetCurrentDC() ) );
+    return args.ret;
+}
+
+/* NEUTRON round-49 CAUSAL TEST (NEUTRON_GL_FAKEREAD=<8 hex digits>) -- diagnostic, never ship.
+ *
+ * MEASURED in round 48: After Effects' entire per-frame loop on the composition viewer is
+ *     glReadPixels(1x1 at 0,0, BGRA, from the DEFAULT framebuffer)  ->  wglSwapBuffers
+ * repeated forever, with NO drawing of any kind in between, and the readback is `ff000000`
+ * (opaque black) every single time. That one-pixel probe is the only thing AE asks about this
+ * window, so if anything gates the panel it is that value.
+ *
+ * Black is also, of course, the honest answer to "what is in a buffer nobody drew into" -- so
+ * cause and symptom are indistinguishable by observation alone. This distinguishes them by
+ * changing the answer and watching what AE does, the same way NEUTRON_GL_MOVETEST turned
+ * "is the subsurface composited" into a colour we could see:
+ *
+ *   AE starts drawing / the panel comes alive -> the probe IS the gate. Then the real question
+ *       becomes what AE expects to find there, and why our window does not have it.
+ *   nothing changes -> the probe is a symptom, AE gave up earlier, and the answer is upstream.
+ *
+ * Scope is deliberately tight: only a 1x1 byte-format read from the DEFAULT framebuffer, so the
+ * startup self-test's own FBO readbacks are left completely alone.
+ */
+static BOOL neutron_fakeread( UINT32 *out )
+{
+    static int enabled = -1;
+    static UINT32 value;
+
+    if (enabled < 0)
+    {
+        const char *e = getenv( "NEUTRON_GL_FAKEREAD" );
+        value = (e && *e) ? (UINT32)strtoul( e, NULL, 16 ) : 0;
+        enabled = value ? 1 : 0;
+    }
+    *out = value;
+    return enabled == 1;
+}
+
+void WINAPI glReadPixels( GLint x, GLint y, GLsizei width, GLsizei height, GLenum format, GLenum type, void *pixels )
+{
+    struct glReadPixels_params args = { .teb = NtCurrentTeb(), .x = x, .y = y, .width = width, .height = height, .format = format, .type = type, .pixels = pixels };
+    static LONG budget;
+    NTSTATUS status;
+
+    TRACE( "x %d, y %d, width %d, height %d, format %d, type %d, pixels %p\n", x, y, width, height, format, type, pixels );
+    if ((status = UNIX_CALL( glReadPixels, &args ))) WARN( "glReadPixels returned %#lx\n", status );
+
+    if (neutron_gltrace_on() && neutron_gl_budget( &budget, 32 ))
+    {
+        GLint pack = 0, fbo = 0, readbuf = 0;
+        UINT32 sample[4] = {0}, fake = 0;
+        BOOL got = FALSE, faked = FALSE;
+
+        /* With a pixel-pack buffer bound, `pixels` is a BUFFER OFFSET, not an address --
+         * dereferencing it would fault. Ask before touching it. */
+        glGetIntegerv( 0x88ED /* GL_PIXEL_PACK_BUFFER_BINDING */, &pack );
+        glGetIntegerv( 0x8CAA /* GL_READ_FRAMEBUFFER_BINDING */, &fbo );
+        /* GL_READ_BUFFER. On an EGL *window* surface under Wayland the front buffer holds
+         * nothing readable, so a GL_FRONT read would come back black no matter what the app
+         * drew -- a gate that could never pass here. Worth knowing which one AE picked. */
+        glGetIntegerv( 0x0C02 /* GL_READ_BUFFER */, &readbuf );
+
+        if (!pack && pixels && width > 0 && height > 0 &&
+            type == GL_UNSIGNED_BYTE && (format == GL_RGBA || format == GL_BGRA))
+        {
+            unsigned int i, n = min( 4u, (unsigned int)width * (unsigned int)height );
+            for (i = 0; i < n; i++) sample[i] = ((const UINT32 *)pixels)[i];
+            got = TRUE;
+        }
+        if (got && !fbo && width == 1 && height == 1 && neutron_fakeread( &fake ))
+        {
+            *(UINT32 *)pixels = fake;
+            faked = TRUE;
+        }
+        ERR( "NT-GLS glReadPixels %dx%d+%d+%d format=%#x type=%#x readFBO=%d readBuffer=%#x "
+             "pack=%d hwnd=%p first4=%s%08x %08x %08x %08x%s\n",
+             width, height, x, y, format, type, fbo, readbuf, pack,
+             NtUserWindowFromDC( wglGetCurrentDC() ), got ? "" : "(not sampled) ",
+             sample[0], sample[1], sample[2], sample[3],
+             faked ? " [FAKED]" : "" );
+    }
+    else if (!neutron_gltrace_on())
+    {
+        /* nothing */
+    }
+    else
+    {
+        /* Past the log budget the override must still apply, or the test would only affect the
+         * first 32 frames and then quietly stop -- which would read as "it made no difference". */
+        UINT32 fake;
+        GLint pack = 0, fbo = 0;
+        if (pixels && width == 1 && height == 1 && type == GL_UNSIGNED_BYTE &&
+            (format == GL_RGBA || format == GL_BGRA) && neutron_fakeread( &fake ))
+        {
+            glGetIntegerv( 0x88ED, &pack );
+            glGetIntegerv( 0x8CAA, &fbo );
+            if (!pack && !fbo) *(UINT32 *)pixels = fake;
+        }
+    }
+}
+
+void WINAPI glReadBuffer( GLenum src )
+{
+    struct glReadBuffer_params args = { .teb = NtCurrentTeb(), .src = src };
+    static LONG budget;
+    NTSTATUS status;
+    if (neutron_gltrace_on() && neutron_gl_budget( &budget, 16 ))
+        ERR( "NT-GLS glReadBuffer(%#x) hwnd=%p\n", src, NtUserWindowFromDC( wglGetCurrentDC() ) );
+    TRACE( "src %d\n", src );
+    if ((status = UNIX_CALL( glReadBuffer, &args ))) WARN( "glReadBuffer returned %#lx\n", status );
+}
+
+void WINAPI glDrawBuffer( GLenum buf )
+{
+    struct glDrawBuffer_params args = { .teb = NtCurrentTeb(), .buf = buf };
+    static LONG budget;
+    NTSTATUS status;
+    if (neutron_gltrace_on() && neutron_gl_budget( &budget, 16 ))
+        ERR( "NT-GLS glDrawBuffer(%#x) hwnd=%p\n", buf, NtUserWindowFromDC( wglGetCurrentDC() ) );
+    TRACE( "buf %d\n", buf );
+    if ((status = UNIX_CALL( glDrawBuffer, &args ))) WARN( "glDrawBuffer returned %#lx\n", status );
+}
+
+/***********************************************************************
+ * NEUTRON round-50 -- DOES AFTER EFFECTS' GL DRAWBOT EVEN HAVE A PIPELINE?
+ *
+ * WHERE THIS CAME FROM. Round 48 found AE's whole per-frame loop on the composition viewer is
+ * "read one pixel, swap", with no drawing. Round 49 fed that probe a non-black value on every
+ * frame and AE STILL drew nothing (draws stayed 0, ALL-THREADS frozen at 44), and showed it
+ * reads GL_BACK, not GL_FRONT -- so the probe is not a gate and the front-buffer theory is dead.
+ * AE gives up somewhere earlier, while still having gone to the trouble of uploading a glyph
+ * atlas to that very window.
+ *
+ * An app that has set up its text renderer and then issues no draw calls at all is behaving
+ * exactly like one whose shader pipeline did not come up. Without a program to draw with there
+ * is nothing to submit, so every draw is skipped and the frame loop degenerates to housekeeping.
+ * The startup self-test's 44 draws do not contradict this: they are a different, simpler path.
+ *
+ * So rather than infer, this asks the driver directly. After each compile and link we query the
+ * status ourselves -- whether or not the app bothers to -- and on failure pull the driver's own
+ * info log out and print it. If Adobe's shaders do not build here, that log says why, in words.
+ *
+ * glShaderSource also records the size and opening line of each shader, which names the GLSL
+ * version AE is targeting; a version the driver refuses is one of the commoner ways this fails.
+ */
+void WINAPI glShaderSource( GLuint shader, GLsizei count, const GLchar *const*string, const GLint *length )
+{
+    struct glShaderSource_params args = { .teb = NtCurrentTeb(), .shader = shader, .count = count, .string = string, .length = length };
+    static LONG budget;
+    NTSTATUS status;
+
+    if (neutron_gltrace_on() && neutron_gl_budget( &budget, 24 ))
+    {
+        char head[121] = {0};
+        if (count > 0 && string && string[0])
+        {
+            unsigned int i;
+            for (i = 0; i < sizeof(head) - 1 && string[0][i] && string[0][i] != '\n'; i++)
+                head[i] = string[0][i];
+        }
+        ERR( "NT-GLP shaderSource shader=%u count=%d firstline=\"%s\"\n", shader, count, head );
+    }
+    TRACE( "shader %d, count %d, string %p, length %p\n", shader, count, string, length );
+    if ((status = UNIX_CALL( glShaderSource, &args ))) WARN( "glShaderSource returned %#lx\n", status );
+}
+
+void WINAPI glGetShaderiv( GLuint shader, GLenum pname, GLint *params )
+{
+    struct glGetShaderiv_params args = { .teb = NtCurrentTeb(), .shader = shader, .pname = pname, .params = params };
+    NTSTATUS status;
+    TRACE( "shader %d, pname %d, params %p\n", shader, pname, params );
+    if ((status = UNIX_CALL( glGetShaderiv, &args ))) WARN( "glGetShaderiv returned %#lx\n", status );
+}
+
+void WINAPI glGetShaderInfoLog( GLuint shader, GLsizei bufSize, GLsizei *length, GLchar *infoLog )
+{
+    struct glGetShaderInfoLog_params args = { .teb = NtCurrentTeb(), .shader = shader, .bufSize = bufSize, .length = length, .infoLog = infoLog };
+    NTSTATUS status;
+    TRACE( "shader %d, bufSize %d, length %p, infoLog %p\n", shader, bufSize, length, infoLog );
+    if ((status = UNIX_CALL( glGetShaderInfoLog, &args ))) WARN( "glGetShaderInfoLog returned %#lx\n", status );
+}
+
+void WINAPI glGetProgramiv( GLuint program, GLenum pname, GLint *params )
+{
+    struct glGetProgramiv_params args = { .teb = NtCurrentTeb(), .program = program, .pname = pname, .params = params };
+    NTSTATUS status;
+    TRACE( "program %d, pname %d, params %p\n", program, pname, params );
+    if ((status = UNIX_CALL( glGetProgramiv, &args ))) WARN( "glGetProgramiv returned %#lx\n", status );
+}
+
+void WINAPI glGetProgramInfoLog( GLuint program, GLsizei bufSize, GLsizei *length, GLchar *infoLog )
+{
+    struct glGetProgramInfoLog_params args = { .teb = NtCurrentTeb(), .program = program, .bufSize = bufSize, .length = length, .infoLog = infoLog };
+    NTSTATUS status;
+    TRACE( "program %d, bufSize %d, length %p, infoLog %p\n", program, bufSize, length, infoLog );
+    if ((status = UNIX_CALL( glGetProgramInfoLog, &args ))) WARN( "glGetProgramInfoLog returned %#lx\n", status );
+}
+
+void WINAPI glCompileShader( GLuint shader )
+{
+    struct glCompileShader_params args = { .teb = NtCurrentTeb(), .shader = shader };
+    static LONG budget, failures;
+    NTSTATUS status;
+
+    TRACE( "shader %d\n", shader );
+    if ((status = UNIX_CALL( glCompileShader, &args ))) WARN( "glCompileShader returned %#lx\n", status );
+
+    if (neutron_gltrace_on())
+    {
+        GLint ok = 1;
+        glGetShaderiv( shader, 0x8B81 /* GL_COMPILE_STATUS */, &ok );
+        if (!ok && neutron_gl_budget( &failures, 8 ))
+        {
+            char log[1024] = {0};
+            GLsizei len = 0;
+            glGetShaderInfoLog( shader, sizeof(log) - 1, &len, log );
+            ERR( "NT-GLP ⛔ SHADER %u FAILED TO COMPILE, driver says: %s\n", shader, log );
+        }
+        else if (ok && neutron_gl_budget( &budget, 8 ))
+            ERR( "NT-GLP shader %u compiled OK\n", shader );
+    }
+}
+
+void WINAPI glLinkProgram( GLuint program )
+{
+    struct glLinkProgram_params args = { .teb = NtCurrentTeb(), .program = program };
+    static LONG budget, failures;
+    NTSTATUS status;
+
+    TRACE( "program %d\n", program );
+    if ((status = UNIX_CALL( glLinkProgram, &args ))) WARN( "glLinkProgram returned %#lx\n", status );
+
+    if (neutron_gltrace_on())
+    {
+        GLint ok = 1;
+        glGetProgramiv( program, 0x8B82 /* GL_LINK_STATUS */, &ok );
+        if (!ok && neutron_gl_budget( &failures, 8 ))
+        {
+            char log[1024] = {0};
+            GLsizei len = 0;
+            glGetProgramInfoLog( program, sizeof(log) - 1, &len, log );
+            ERR( "NT-GLP ⛔ PROGRAM %u FAILED TO LINK, driver says: %s\n", program, log );
+        }
+        else if (ok && neutron_gl_budget( &budget, 8 ))
+            ERR( "NT-GLP program %u linked OK\n", program );
+    }
+}
+
+/* The old ARB-suffixed shader API is a separate set of entry points. If AE uses those instead,
+ * the core instrumentation above would report nothing and the silence would look like "no
+ * shaders at all" -- so say so plainly rather than leave a hole. */
+void WINAPI glCompileShaderARB( GLhandleARB shaderObj )
+{
+    struct glCompileShaderARB_params args = { .teb = NtCurrentTeb(), .shaderObj = shaderObj };
+    static LONG budget;
+    NTSTATUS status;
+    if (neutron_gltrace_on() && neutron_gl_budget( &budget, 4 ))
+        ERR( "NT-GLP glCompileShaderARB obj=%u -- AE USES THE ARB SHADER API; extend the trace\n", shaderObj );
+    TRACE( "shaderObj %d\n", shaderObj );
+    if ((status = UNIX_CALL( glCompileShaderARB, &args ))) WARN( "glCompileShaderARB returned %#lx\n", status );
+}
+
+void WINAPI glLinkProgramARB( GLhandleARB programObj )
+{
+    struct glLinkProgramARB_params args = { .teb = NtCurrentTeb(), .programObj = programObj };
+    static LONG budget;
+    NTSTATUS status;
+    if (neutron_gltrace_on() && neutron_gl_budget( &budget, 4 ))
+        ERR( "NT-GLP glLinkProgramARB obj=%u -- AE USES THE ARB SHADER API; extend the trace\n", programObj );
+    TRACE( "programObj %d\n", programObj );
+    if ((status = UNIX_CALL( glLinkProgramARB, &args ))) WARN( "glLinkProgramARB returned %#lx\n", status );
+}
+
+/* Counted, not logged per call: a drawbot that never binds a program has nothing to draw with,
+ * and the total is reported alongside the draw counts at each swap. */
+void WINAPI glUseProgram( GLuint program )
+{
+    struct glUseProgram_params args = { .teb = NtCurrentTeb(), .program = program };
+    NTSTATUS status;
+    if (neutron_gltrace_on()) InterlockedIncrement( &neutron_gl_useprogram );
+    TRACE( "program %d\n", program );
+    if ((status = UNIX_CALL( glUseProgram, &args ))) WARN( "glUseProgram returned %#lx\n", status );
+}
+
+void WINAPI glTexImage2D( GLenum target, GLint level, GLint internalformat, GLsizei width, GLsizei height, GLint border, GLenum format, GLenum type, const void *pixels )
+{
+    struct glTexImage2D_params args = { .teb = NtCurrentTeb(), .target = target, .level = level, .internalformat = internalformat, .width = width, .height = height, .border = border, .format = format, .type = type, .pixels = pixels };
+    static LONG budget;
+    NTSTATUS status;
+
+    if (neutron_gltrace_on() && level == 0 && neutron_gl_budget( &budget, 24 ))
+        ERR( "NT-GLS glTexImage2D target=%#x internalformat=%#x %dx%d format=%#x type=%#x hwnd=%p\n",
+             target, internalformat, width, height, format, type,
+             NtUserWindowFromDC( wglGetCurrentDC() ) );
+
+    TRACE( "target %d, level %d, internalformat %d, width %d, height %d, border %d, format %d, type %d, pixels %p\n", target, level, internalformat, width, height, border, format, type, pixels );
+    if ((status = UNIX_CALL( glTexImage2D, &args ))) WARN( "glTexImage2D returned %#lx\n", status );
+}
diff --git a/dlls/win32u/opengl.c b/dlls/win32u/opengl.c
index 3d03b41fc24..4d444a7c7ca 100644
--- a/dlls/win32u/opengl.c
+++ b/dlls/win32u/opengl.c
@@ -1946,6 +1946,44 @@ static void opengl_client_pbuffer_init( HPBUFFERARB client_pbuffer, struct pbuff
     client->unix_funcs = (UINT_PTR)funcs;
 }
 
+/* NEUTRON round-40: trace the pbuffer / render-to-texture path.
+ *
+ * After Effects' composition panel is blank while its GL surface is provably healthy and
+ * provably COMPOSITED-BUT-EMPTY (NEUTRON_GL_MOVETEST). Round 39b showed AE probes 23 wgl*
+ * entry points and NONE of them is a DX-interop function -- so it does NOT use
+ * WGL_NV_DX_interop (theory killed). What it DOES probe is the pbuffer + render-to-texture
+ * set: wglCreatePbufferARB/QueryPbufferARB/SetPbufferAttribARB and
+ * wglBindTexImageARB/wglReleaseTexImageARB (WGL_ARB_render_texture).
+ *
+ * That path is suspect on Wayland. winewayland has no real pbuffer -- wayland_pbuffer_create
+ * fakes one with a hidden wl_surface + wl_egl_window ("Wayland EGL doesn't support pixmap or
+ * pbuffer"), and wayland_pbuffer_bind returns -1, i.e. "use the default implementation".
+ * The default is win32u_wglBindTexImageARB's fallback: glReadBuffer(source) +
+ * glCopyTexImage2D. For an EGL WINDOW surface, GL_FRONT is not meaningfully readable -- the
+ * rendered content is in the BACK buffer -- so a bind of WGL_FRONT_LEFT_ARB would copy
+ * nothing and hand the app a BLACK texture. That is exactly the observed symptom.
+ *
+ * This trace records whether AE actually creates pbuffers, which buffer it binds, and
+ * whether the bind succeeds -- turning that reading of the code into evidence. */
+static void neutron_gltrace( const char *fmt, ... )
+{
+    static int enabled = -1;
+    char buf[256];
+    va_list ap;
+
+    if (enabled < 0)
+    {
+        const char *e = getenv( "NEUTRON_GL_PROCTRACE" );
+        enabled = (e && e[0] == '1') ? 1 : 0;
+    }
+    if (!enabled) return;
+
+    va_start( ap, fmt );
+    vsnprintf( buf, sizeof(buf), fmt, ap );
+    va_end( ap );
+    ERR( "%s\n", buf );
+}
+
 static BOOL win32u_pbuffer_create( HDC hdc, int format, int width, int height, const int *attribs,
                                    HPBUFFERARB client_pbuffer )
 {
@@ -1969,6 +2007,8 @@ static BOOL win32u_pbuffer_create( HDC hdc, int format, int width, int height, c
 
     if (!(pbuffer = pbuffer_create( format, width, height, attribs ))) return FALSE;
     opengl_client_pbuffer_init( client_pbuffer, pbuffer, funcs );
+    /* NEUTRON round-40 (NEUTRON_GL_PROCTRACE=1) -- see win32u_wglBindTexImageARB below. */
+    neutron_gltrace( "NT-GL pbuffer-create %dx%d format=%d", width, height, format );
     return TRUE;
 }
 
@@ -2159,7 +2199,18 @@ static BOOL win32u_wglBindTexImageARB( HPBUFFERARB client_pbuffer, int buffer )
     }
 
     if ((ret = driver_funcs->p_pbuffer_bind( pbuffer->hdc, pbuffer->drawable, source )) != -1)
+    {
+        neutron_gltrace( "NT-GL bindteximage buffer=%#x source=%#x -> driver ret=%u (%dx%d)",
+                         buffer, source, ret, pbuffer->width, pbuffer->height );
         return ret;
+    }
+
+    /* NEUTRON round-40: the generic glCopyTexImage2D fallback -- the suspect path on
+     * Wayland, where the "pbuffer" is really an EGL window surface and GL_FRONT holds
+     * nothing. source=0x404 is GL_FRONT, 0x405 GL_BACK. */
+    neutron_gltrace( "NT-GL bindteximage buffer=%#x source=%#x -> COPY fallback (%dx%d fmt=%#x target=%#x)",
+                     buffer, source, pbuffer->width, pbuffer->height,
+                     pbuffer->texture_format, pbuffer->texture_target );
 
     funcs->p_glGetIntegerv( binding_from_target( pbuffer->texture_target ), &prev_texture );
     push_internal_context( NtCurrentTeb()->glContext, pbuffer->drawable, format );
@@ -2771,6 +2822,26 @@ static void display_funcs_init(void)
     {
         display_funcs.p_glImportMemoryWin32HandleEXT = win32u_glImportMemoryWin32HandleEXT;
         display_funcs.p_glImportMemoryWin32NameEXT = win32u_glImportMemoryWin32NameEXT;
+
+        /* NEUTRON: advertise WGL_NV_DX_interop / _interop2. The 8 entry points are implemented
+         * by hand PE-side in dlls/opengl32/wgl.c (they take COM pointers, which the unix side
+         * cannot touch), so nothing is registered in display_funcs here -- but the extension
+         * BIT must be set or wglGetProcAddress refuses to hand them out and, more importantly,
+         * apps never ask: After Effects gates wgl* resolution on the advertised extension
+         * string, which is precisely why its composition viewer is blank on Wine.
+         *
+         * Gated on p_glImportMemoryFdEXT deliberately: the real implementation bridges the D3D
+         * texture into GL through import_memory() above (shared handle -> d3dkmt fd ->
+         * glImportMemoryFdEXT), so without external-memory support there is no bridge to offer
+         * and advertising would be a lie. */
+        global_extensions[WGL_NV_DX_interop] = 1;
+        global_extensions[WGL_NV_DX_interop2] = 1;
+        /* NVIDIA also exposes an experimental alias, and the Windows reference capture shows
+         * all THREE advertised there (WGL_NV_DX_interop, _interop2, WGL_NVX_DX_interop).
+         * make_opengl already knows it as an alias of the same 8 entry points, so advertising
+         * it costs nothing and removes one more difference from the native string -- worth
+         * doing because AE was already proven to gate purely on what the string names. */
+        global_extensions[WGL_NVX_DX_interop] = 1;
     }
     if (display_funcs.p_glImportSemaphoreFdEXT)
     {
