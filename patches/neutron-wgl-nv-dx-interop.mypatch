  *              wglSwapBuffers (OPENGL32.@)
  */
@@ -1300,6 +1659,9 @@ BOOL WINAPI DECLSPEC_HOTPATCH wglSwapBuffers( HDC hdc )
     struct wglSwapBuffers_params args = { .teb = NtCurrentTeb(), .hdc = hdc };
     NTSTATUS status;
 
+    neutron_fbotrace( hdc );   /* NEUTRON round-42: sample BEFORE the swap consumes the buffer */
+    neutron_fixviewport( hdc );/* NEUTRON round-44: see below */
+
     if ((status = UNIX_CALL( wglSwapBuffers, &args ))) WARN( "wglSwapBuffers returned %#lx\n", status );
     else if (TRACE_ON(fps))
     {
@@ -1358,6 +1720,85 @@ int WINAPI wglGetLayerPaletteEntries( HDC hdc, int plane, int start, int count,
     return 0;
 }
 
+/* NEUTRON round-39: report GL/WGL entry points an app requested but did not get.
+ * De-duplicated -- apps re-query the same name every frame. Env-gated, OFF by default. */
+static void neutron_proctrace_miss( const char *name )
+{
+    /* COPY the name: `name` belongs to the caller and may be a temporary, so keeping the
+     * pointer would compare against freed memory on the next call. */
+    static char seen[128][64];
+    static int nseen, enabled = -1;
+    int i;
+
+    if (enabled < 0)
+    {
+        const char *e = getenv( "NEUTRON_GL_PROCTRACE" );
+        enabled = (e && e[0] == '1') ? 1 : 0;
+    }
+    if (!enabled || !name) return;
+
+    for (i = 0; i < nseen; i++) if (!strcmp( seen[i], name )) return;
+    if (nseen < 128)
+    {
+        lstrcpynA( seen[nseen], name, sizeof(seen[0]) );
+        nseen++;
+    }
+    ERR( "NT-GL procmiss %s (app asked, Wine does not provide)\n", name );
+}
+
+/* NEUTRON round-39b: round 39 came back with 30 misses, ALL legacy ATI/APPLE GL functions
+ * (glbinding probing a fixed list) and ZERO wgl* misses -- which did NOT refute the
+ * WGL_NV_DX_interop theory, because that test had two blind spots:
+ *   (1) wglGetProcAddress returns NULL BEFORE the miss trace when no context is current;
+ *   (2) a well-behaved app queries the EXTENSION STRING first and never asks for entry
+ *       points it already knows are absent -- exactly what DisplaySurface.dll would do.
+ * So log EVERY wgl* lookup, hit or miss, plus the no-context bail. If AE never probes any
+ * wgl* name at all, it is not going down the interop road and the theory is dead; if it
+ * probes and we answer NULL, it is alive. De-duplicated. */
+static void neutron_proctrace_wgl( const char *name, const char *outcome )
+{
+    static char seen[128][80];
+    static int nseen, enabled = -1;
+    int i;
+
+    if (enabled < 0)
+    {
+        const char *e = getenv( "NEUTRON_GL_PROCTRACE" );
+        enabled = (e && e[0] == '1') ? 1 : 0;
+    }
+    if (!enabled || !name) return;
+    if (name[0] != 'w' || name[1] != 'g' || name[2] != 'l') return;
+
+    for (i = 0; i < nseen; i++) if (!strcmp( seen[i], name )) return;
+    if (nseen < 128)
+    {
+        lstrcpynA( seen[nseen], name, sizeof(seen[0]) );
+        nseen++;
+    }
+    ERR( "NT-GL wglquery %s -> %s\n", name, outcome );
+}
+
+/* NEUTRON round-41: running total of wglGetProcAddress lookups, gl* included. Logged at
+ * powers-of-two up to 512 then every 512, so the final line gives the magnitude to compare
+ * against Windows' 1,909 distinct gl* probes without flooding the log. */
+static void neutron_proctrace_count( const char *name )
+{
+    static LONG total;
+    static int enabled = -1;
+    LONG n;
+
+    if (enabled < 0)
+    {
+        const char *e = getenv( "NEUTRON_GL_PROCTRACE" );
+        enabled = (e && e[0] == '1') ? 1 : 0;
+    }
+    if (!enabled) return;
+
+    n = InterlockedIncrement( &total );
+    if (n <= 512 ? !(n & (n - 1)) : !(n % 512))
+        ERR( "NT-GL probecount total=%ld (latest %s)\n", n, name );
+}
+
 /***********************************************************************
  *		wglGetProcAddress (OPENGL32.@)
  */
@@ -1367,11 +1808,39 @@ PROC WINAPI wglGetProcAddress( LPCSTR name )
     const enum opengl_extension *ext;
     struct context *ctx;
 
-    if (!(ctx = context_from_handle( NtCurrentTeb()->glCurrentRC ))) return NULL;
+    if (!(ctx = context_from_handle( NtCurrentTeb()->glCurrentRC )))
+    {
+        /* NEUTRON round-39b: this early bail silently returned NULL without ever reaching
+         * the miss trace -- blind spot (1). An app probing before making a context current
+         * looked identical to an app that never probed at all. */
+        neutron_proctrace_wgl( name, "NULL (no current context)" );
+        neutron_proctrace_miss( name );
+        return NULL;
+    }
+
+    neutron_proctrace_wgl( name, "queried" );
+    /* NEUTRON round-41: the Windows reference says native AE blanket-enumerates 1,909 distinct
+     * gl* entry points with NO gating (only wgl* is gated on the extension string). That gives
+     * a sharp split: ~1,900 probes here means AE's GL loader ran to completion and the ONLY gap
+     * is the gated wgl* set; far fewer means AE ABORTED GL init early, and the missing
+     * extension is a symptom rather than the cause. This one number decides where the effort
+     * goes, so count every lookup -- gl* included, which the round-39 traces did not do. */
+    neutron_proctrace_count( name );
 
     if (!(func = get_function_entry( name )))
     {
         WARN( "Function %s unknown\n", name );
+        /* NEUTRON round-39 (NEUTRON_GL_PROCTRACE=1): name every GL/WGL entry point an app
+         * asks for and does NOT get. After Effects' composition panel is blank while its
+         * GL surface is provably healthy (correctly sized, positioned, composited -- and
+         * empty; see memory neutron-ae-composition-content-blank). AE's DisplaySurface.dll
+         * may rely on WGL_NV_DX_interop / WGL_NV_DX_interop2 / wglDXOpenDeviceNV /
+         * wglDXRegisterObjectNV / wglDXLockObjectsNV, and Wine implements NONE of them
+         * (0 hits across opengl32.dll/.so, winewayland.so, win32u.so, with wglCreateContext
+         * as a positive control). If AE renders the comp with D3D11 and shares it into its
+         * GL surface via that extension, the share silently yields nothing -- exactly a
+         * black panel with healthy swaps. This turns that inference into a fact. */
+        neutron_proctrace_miss( name );
         return NULL;
     }
 
@@ -1392,6 +1861,10 @@ PROC WINAPI wglGetProcAddress( LPCSTR name )
     }
 
     WARN( "Extensions required for %s not supported\n", name );
+    /* NEUTRON round-39: the OTHER way a lookup fails -- the entry point exists in the
+     * registry but the required GL/WGL extension is absent from this context. Trace it
+     * too, or a miss here looks like a success. */
+    neutron_proctrace_miss( name );
     return NULL;
 }
 
@@ -2238,3 +2711,817 @@ BOOL WINAPI DllMain( HINSTANCE hinst, DWORD reason, LPVOID reserved )
     }
     return TRUE;
 }
+
+/***********************************************************************
+ *      WGL_NV_DX_interop / WGL_NV_DX_interop2   (NEUTRON)
+ *
+ * WHY THIS EXISTS. After Effects renders its composition into a D3D texture and bridges that
+ * texture into its OpenGL display surface with this extension. Wine never implemented it AND
+ * never advertised it -- and AE gates wgl* resolution on the advertised extension string, so it
+ * never even asked. Proven by a controlled A/B: advertise the two names with no implementation
+ * and AE immediately requests all 8 entry points (23 -> 31 distinct wgl*); leave them out and it
+ * requests none. With no bridge, AE presents an empty GL surface (~350x/session), which is
+ * exactly the blank composition panel. Native AE calls SwapBuffers ZERO times -- it presents
+ * through D3D/DXGI. See ~/neutron/docs/WGL_NV_DX_interop-design.md.
+ *
+ * ⚠️ STAGE 1 -- THIS IS A PROBE, NOT AN IMPLEMENTATION. Register deliberately returns NULL.
+ *
+ * The design hinges on one thing nobody has measured: can we get a SHARED HANDLE for the D3D
+ * texture AE hands us? Wine already owns the hard half of the real fix -- win32u's
+ * import_memory() turns a D3D shared NT handle into a dma-buf fd and feeds glImportMemoryFdEXT
+ * -- so if a share handle is available, the implementation is mostly
+ * glCreateMemoryObjectsEXT + glImportMemoryWin32HandleEXT + glTextureStorageMem2DEXT.
+ * But WGL_NV_DX_interop does NOT require D3D10/11 resources to be created shared (only D3D9
+ * does, which is what wglDXSetResourceShareHandleNV is for). If AE's textures are ordinary
+ * non-shared textures, that whole approach is dead and we need DXVK interop instead
+ * (ID3D11VkInteropSurface -> exportable VkImage -> vkCmdCopyImage), which is a far bigger job.
+ *
+ * So: measure first. This reports exactly what AE passes -- interfaces it supports, whether a
+ * share handle can be obtained by either route, and the texture description -- in ~150 lines
+ * instead of ~1000 built on a guess. Sequencing chosen deliberately after a session in which
+ * reasoning ahead of the evidence cost several rounds.
+ */
+
+struct dxinterop_device
+{
+    IUnknown *device;       /* the app's D3D device, AddRef'd */
+    ID3D11Device *d3d11;    /* non-NULL if it is a D3D11 device */
+    LONG refcount;
+};
+
+static struct dxinterop_device *dxinterop_devices[8];
+static CRITICAL_SECTION dxinterop_cs;
+static CRITICAL_SECTION_DEBUG dxinterop_cs_debug =
+{
+    0, 0, &dxinterop_cs,
+    { &dxinterop_cs_debug.ProcessLocksList, &dxinterop_cs_debug.ProcessLocksList },
+    0, 0, { (DWORD_PTR)(__FILE__ ": dxinterop_cs") }
+};
+static CRITICAL_SECTION dxinterop_cs = { &dxinterop_cs_debug, -1, 0, 0, 0, 0 };
+
+static struct dxinterop_device *dxinterop_device_from_handle( HANDLE handle )
+{
+    UINT_PTR idx = (UINT_PTR)handle - 1;
+    if (idx >= ARRAY_SIZE(dxinterop_devices)) return NULL;
+    return dxinterop_devices[idx];
+}
+
+HANDLE WINAPI wglDXOpenDeviceNV( void *dxDevice )
+{
+    struct dxinterop_device *dev;
+    ID3D11Device *d3d11 = NULL;
+    IUnknown *unk = dxDevice;
+    UINT i;
+
+    TRACE( "dxDevice %p\n", dxDevice );
+
+    if (!dxDevice) { RtlSetLastWin32Error( ERROR_INVALID_PARAMETER ); return NULL; }
+
+    /* Identify the device type. D3D11 is what After Effects uses; D3D9/D3D10 are not
+     * handled yet and are rejected rather than half-supported. */
+    if (FAILED(IUnknown_QueryInterface( unk, &IID_ID3D11Device, (void **)&d3d11 )))
+    {
+        ERR( "NT-DXI OpenDevice: NOT a D3D11 device (%p) -- unsupported device type\n", dxDevice );
+        RtlSetLastWin32Error( ERROR_NOT_SUPPORTED );
+        return NULL;
+    }
+
+    if (!(dev = calloc( 1, sizeof(*dev) )))
+    {
+        ID3D11Device_Release( d3d11 );
+        RtlSetLastWin32Error( ERROR_OUTOFMEMORY );
+        return NULL;
+    }
+    dev->device = unk;
+    dev->d3d11 = d3d11;   /* keeps the reference taken by QueryInterface */
+    dev->refcount = 1;
+
+    EnterCriticalSection( &dxinterop_cs );
+    for (i = 0; i < ARRAY_SIZE(dxinterop_devices); i++) if (!dxinterop_devices[i]) break;
+    if (i == ARRAY_SIZE(dxinterop_devices))
+    {
+        LeaveCriticalSection( &dxinterop_cs );
+        ID3D11Device_Release( d3d11 );
+        free( dev );
+        ERR( "NT-DXI OpenDevice: too many interop devices\n" );
+        RtlSetLastWin32Error( ERROR_TOO_MANY_OPEN_FILES );
+        return NULL;
+    }
+    dxinterop_devices[i] = dev;
+    LeaveCriticalSection( &dxinterop_cs );
+
+    ERR( "NT-DXI OpenDevice: D3D11 device %p accepted, handle %p, feature level %#x\n",
+         dxDevice, (HANDLE)(UINT_PTR)(i + 1), ID3D11Device_GetFeatureLevel( d3d11 ) );
+    return (HANDLE)(UINT_PTR)(i + 1);
+}
+
+BOOL WINAPI wglDXCloseDeviceNV( HANDLE hDevice )
+{
+    struct dxinterop_device *dev;
+    UINT_PTR idx = (UINT_PTR)hDevice - 1;
+
+    TRACE( "hDevice %p\n", hDevice );
+
+    EnterCriticalSection( &dxinterop_cs );
+    if (!(dev = dxinterop_device_from_handle( hDevice )))
+    {
+        LeaveCriticalSection( &dxinterop_cs );
+        RtlSetLastWin32Error( ERROR_INVALID_HANDLE );
+        return FALSE;
+    }
+    dxinterop_devices[idx] = NULL;
+    LeaveCriticalSection( &dxinterop_cs );
+
+    if (dev->d3d11) ID3D11Device_Release( dev->d3d11 );
+    free( dev );
+    ERR( "NT-DXI CloseDevice: handle %p closed\n", hDevice );
+    return TRUE;
+}
+
+/* STAGE 1 PROBE: report everything about the object the app wants to share, then decline.
+ * The single question is whether a share handle is obtainable; everything else is context. */
+HANDLE WINAPI wglDXRegisterObjectNV( HANDLE hDevice, void *dxObject, GLuint name,
+                                     GLenum type, GLenum access )
+{
+    ID3D11Texture2D *tex2d = NULL;
+    IDXGIResource1 *res1 = NULL;
+    IDXGIResource *res = NULL;
+    IUnknown *unk = dxObject;
+    HANDLE shared = NULL, nt_shared = NULL;
+    D3D11_TEXTURE2D_DESC desc = {0};
+    HRESULT hr;
+
+    TRACE( "hDevice %p, dxObject %p, name %u, type %#x, access %#x\n",
+           hDevice, dxObject, name, type, access );
+
+    if (!dxinterop_device_from_handle( hDevice ) || !dxObject)
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_HANDLE );
+        return NULL;
+    }
+
+    if (SUCCEEDED(IUnknown_QueryInterface( unk, &IID_ID3D11Texture2D, (void **)&tex2d )))
+    {
+        ID3D11Texture2D_GetDesc( tex2d, &desc );
+        ERR( "NT-DXI Register: ID3D11Texture2D %ux%u mips=%u arr=%u fmt=%u samples=%u "
+             "usage=%u bind=%#x cpu=%#x misc=%#x (gl name=%u type=%#x access=%#x)\n",
+             desc.Width, desc.Height, desc.MipLevels, desc.ArraySize, desc.Format,
+             desc.SampleDesc.Count, desc.Usage, desc.BindFlags, desc.CPUAccessFlags,
+             desc.MiscFlags, name, type, access );
+    }
+    else ERR( "NT-DXI Register: object %p is NOT an ID3D11Texture2D\n", dxObject );
+
+    /* ── THE KEY QUESTION ─────────────────────────────────────────────────────────
+     * D3D11_RESOURCE_MISC_SHARED (0x2) -> IDXGIResource::GetSharedHandle works.
+     * D3D11_RESOURCE_MISC_SHARED_NTHANDLE (0x800) -> IDXGIResource1::CreateSharedHandle.
+     * Neither flag set -> no share handle, and the memory-object route is not viable. */
+    if (SUCCEEDED(IUnknown_QueryInterface( unk, &IID_IDXGIResource, (void **)&res )))
+    {
+        hr = IDXGIResource_GetSharedHandle( res, &shared );
+        ERR( "NT-DXI Register: IDXGIResource::GetSharedHandle hr=%#lx handle=%p\n", hr, shared );
+        IDXGIResource_Release( res );
+    }
+    else ERR( "NT-DXI Register: object does NOT support IDXGIResource\n" );
+
+    if (SUCCEEDED(IUnknown_QueryInterface( unk, &IID_IDXGIResource1, (void **)&res1 )))
+    {
+        hr = IDXGIResource1_CreateSharedHandle( res1, NULL, DXGI_SHARED_RESOURCE_READ, NULL, &nt_shared );
+        ERR( "NT-DXI Register: IDXGIResource1::CreateSharedHandle hr=%#lx handle=%p\n", hr, nt_shared );
+        if (SUCCEEDED(hr) && nt_shared) NtClose( nt_shared );
+        IDXGIResource1_Release( res1 );
+    }
+    else ERR( "NT-DXI Register: object does NOT support IDXGIResource1\n" );
+
+    if (tex2d) ID3D11Texture2D_Release( tex2d );
+
+    /* Stage 1 declines every registration -- see the header comment. AE has already been
+     * shown to survive these entry points failing (it did not crash when they returned NULL). */
+    ERR( "NT-DXI Register: STAGE 1 PROBE -- declining registration by design\n" );
+    RtlSetLastWin32Error( ERROR_NOT_SUPPORTED );
+    return NULL;
+}
+
+BOOL WINAPI wglDXUnregisterObjectNV( HANDLE hDevice, HANDLE hObject )
+{
+    TRACE( "hDevice %p, hObject %p\n", hDevice, hObject );
+    /* Nothing is ever registered in stage 1, so any handle here is bogus. */
+    RtlSetLastWin32Error( ERROR_INVALID_HANDLE );
+    return FALSE;
+}
+
+BOOL WINAPI wglDXObjectAccessNV( HANDLE hObject, GLenum access )
+{
+    TRACE( "hObject %p, access %#x\n", hObject, access );
+    RtlSetLastWin32Error( ERROR_INVALID_HANDLE );
+    return FALSE;
+}
+
+BOOL WINAPI wglDXLockObjectsNV( HANDLE hDevice, GLint count, HANDLE *hObjects )
+{
+    TRACE( "hDevice %p, count %d, hObjects %p\n", hDevice, count, hObjects );
+    RtlSetLastWin32Error( ERROR_INVALID_HANDLE );
+    return FALSE;
+}
+
+BOOL WINAPI wglDXUnlockObjectsNV( HANDLE hDevice, GLint count, HANDLE *hObjects )
+{
+    TRACE( "hDevice %p, count %d, hObjects %p\n", hDevice, count, hObjects );
+    RtlSetLastWin32Error( ERROR_INVALID_HANDLE );
+    return FALSE;
+}
+
+/* D3D9-era entry point: the app supplies a share handle it obtained itself. Recorded so the
+ * trace shows whether AE uses this route (it would make stage 2 much easier). */
+BOOL WINAPI wglDXSetResourceShareHandleNV( void *dxObject, HANDLE shareHandle )
+{
+    ERR( "NT-DXI SetResourceShareHandle: dxObject %p shareHandle %p -- APP SUPPLIED A HANDLE\n",
+         dxObject, shareHandle );
+    return TRUE;
+}
+
+/***********************************************************************
+ *              glViewport (OPENGL32.@)
+ *
+ * NEUTRON round-43. Hand-written purely so it can be observed.
+ *
+ * MEASURED: After Effects' composition viewer (hwnd 0x10244, client 2734x1174) swaps its GL
+ * surface with the viewport stuck at 1x1+0+0 and drawFBO=0 -- i.e. AE renders the composition
+ * into ONE PIXEL of a full-size drawable and presents that. Blank panel, healthy swaps. Every
+ * present-path negative we collected was therefore correct: the surface, geometry, stacking and
+ * lifetime were all fine, and AE was faithfully drawing a single pixel.
+ *
+ * The GL drawable for that window is created during AE's 1x1 placeholder phase (round-38
+ * measured createsize=1x1), and GL's initial viewport is the drawable size at context creation.
+ * This trace distinguishes the three candidate mechanisms, which need different fixes:
+ *   no calls at all              -> AE inherited the 1x1 creation-time default and never
+ *                                   re-issues a viewport. Our bug is handing it a 1x1 drawable.
+ *   called with 1x1              -> AE believes the window is tiny; find what told it that.
+ *   called with the real size    -> something RESETS it afterwards; a Wine state bug.
+ * Logs first occurrence per (hwnd,size) plus a call count, so a per-frame caller cannot flood.
+ */
+void WINAPI glViewport( GLint x, GLint y, GLsizei width, GLsizei height )
+{
+    struct glViewport_params args = { .teb = NtCurrentTeb(), .x = x, .y = y, .width = width, .height = height };
+    NTSTATUS status;
+
+    {
+        static int enabled = -1;
+        static struct { HWND hwnd; int w, h; } seen[32];
+        static int nseen;
+        static LONG calls;
+        LONG n;
+
+        if (enabled < 0)
+        {
+            const char *e = getenv( "NEUTRON_GL_FBOTRACE" );
+            enabled = (e && e[0] == '1') ? 1 : 0;
+        }
+        if (enabled)
+        {
+            HWND hwnd = NtUserWindowFromDC( wglGetCurrentDC() );
+            int i; BOOL known = FALSE;
+
+            n = InterlockedIncrement( &calls );
+            for (i = 0; i < nseen; i++)
+                if (seen[i].hwnd == hwnd && seen[i].w == width && seen[i].h == height) { known = TRUE; break; }
+            if (!known)
+            {
+                RECT cr = {0};
+                if (nseen < 32) { seen[nseen].hwnd = hwnd; seen[nseen].w = width; seen[nseen].h = height; nseen++; }
+                if (hwnd) NtUserGetClientRect( hwnd, &cr, NtUserGetDpiForWindow( hwnd ) );
+                ERR( "NT-VP glViewport(%d,%d,%d,%d) hwnd=%p client=%dx%d call#%ld\n",
+                     x, y, width, height, hwnd,
+                     (int)(cr.right - cr.left), (int)(cr.bottom - cr.top), n );
+            }
+        }
+    }
+
+    TRACE( "x %d, y %d, width %d, height %d\n", x, y, width, height );
+    if ((status = UNIX_CALL( glViewport, &args ))) WARN( "glViewport returned %#lx\n", status );
+}
+
+/***********************************************************************
+ * NEUTRON round-47 -- counted GL entry points.
+ *
+ * These twelve are byte-for-byte the bodies make_opengl would generate, plus one counter bump
+ * each. They live here rather than in thunks.c only because a generated thunk has nowhere to
+ * hang instrumentation. See neutron_glcounters above for what the counts are for.
+ */
+
+void WINAPI glClear( GLbitfield mask )
+{
+    struct glClear_params args = { .teb = NtCurrentTeb(), .mask = mask };
+    struct neutron_glcounters *c = neutron_glc_slot();
+    NTSTATUS status;
+    if (c) { c->clears++; c->t_clears++; InterlockedIncrement( &neutron_gl_all_clears ); }
+    TRACE( "mask %d\n", mask );
+    if ((status = UNIX_CALL( glClear, &args ))) WARN( "glClear returned %#lx\n", status );
+}
