diff --git a/dlls/opengl32/make_opengl b/dlls/opengl32/make_opengl
index 3dec39cc0f0..0bb3c91f0d7 100755
--- a/dlls/opengl32/make_opengl
+++ b/dlls/opengl32/make_opengl
@@ -99,6 +99,12 @@ my %arg_types =
      "GLDEBUGPROCAMD" =>       [ "ptr",    "%p" ],
      "GLDEBUGPROCKHR" =>       [ "ptr",    "%p" ],
      "GLVULKANPROCNV" =>       [ "ptr",    "%p" ],
+     # NEUTRON: WGL_NV_DX_interop passes plain HANDLEs (the interop device and each
+     # registered object). Same shape as the other opaque WGL handles above -- a
+     # pointer-sized value marshalled as "long" and printed with %p. Without this the
+     # generator emits "Unknown type HANDLE in wglDXOpenDeviceNV" and silently skips
+     # every parameter, producing thunks with the wrong signature.
+     "HANDLE" =>               [ "long",   "%p" ],
      "HDC" =>                  [ "long",   "%p" ],
      "HGLRC" =>                [ "long",   "%p" ],
      "HPBUFFERARB" =>          [ "long",   "%p" ],
@@ -131,6 +137,22 @@ my %khronos_types =
 my %manual_win_functions =
     (
      "glDebugEntry" => 1,
+     # NEUTRON: WGL_NV_DX_interop is implemented BY HAND on the PE side (dlls/opengl32/wgl.c).
+     # It has to be: wglDXOpenDeviceNV/wglDXRegisterObjectNV receive PE-side COM pointers
+     # (ID3D11Device, ID3D11Texture2D) and must QueryInterface them for IDXGIResource and read
+     # D3D11_TEXTURE2D_DESC. win32u is the UNIX side and cannot call COM, so the generated
+     # marshalling thunk would hand it a pointer it can do nothing with. Keeping all 8 together
+     # PE-side also keeps the device/object registry in one place, and lets the GL work go
+     # through the existing GL_EXT_memory_object_win32 entry points that Wine already
+     # implements (win32u's import_memory(): D3D shared handle -> d3dkmt fd -> glImportMemoryFdEXT).
+     "wglDXCloseDeviceNV" => 1,
+     "wglDXLockObjectsNV" => 1,
+     "wglDXObjectAccessNV" => 1,
+     "wglDXOpenDeviceNV" => 1,
+     "wglDXRegisterObjectNV" => 1,
+     "wglDXSetResourceShareHandleNV" => 1,
+     "wglDXUnlockObjectsNV" => 1,
+     "wglDXUnregisterObjectNV" => 1,
      "wglChoosePixelFormat" => 1,
      "wglCreateContext" => 1,
      "wglCreateLayerContext" => 1,
@@ -155,6 +177,56 @@ my %manual_win_functions =
     );
 my %manual_win_thunks =
     (
+     # NEUTRON round-43: hand-written so it can log. The composition viewer's GL viewport is
+     # stuck at 1x1 while its client area is 2734x1174 -- AE renders the comp into a single
+     # pixel. We need to know whether AE ever CALLS glViewport, and with what: never called
+     # means it inherited the creation-time default (we hand it a 1x1 drawable during the
+     # placeholder phase); called with 1x1 means AE believes the window is tiny; called with
+     # the real size means something resets it afterwards. Three different bugs.
+     "glViewport" => 1,
+     # NEUTRON round-47: hand-written so each can be counted. Round-42 only sampled the
+     # framebuffer binding at swap time, which an app that binds-draws-unbinds-swaps always
+     # reads back as 0 -- so it never actually established whether After Effects renders into
+     # an FBO. These twelve make the whole frame visible: did anything draw, where did it land,
+     # and was it ever blitted back to the default framebuffer. See wgl.c neutron_glcounters.
+     "glClear" => 1,
+     "glDrawArrays" => 1,
+     "glDrawElements" => 1,
+     "glDrawArraysInstanced" => 1,
+     "glDrawElementsInstanced" => 1,
+     "glDrawRangeElements" => 1,
+     "glBindFramebuffer" => 1,
+     "glBindFramebufferEXT" => 1,
+     "glBlitFramebuffer" => 1,
+     "glBlitFramebufferEXT" => 1,
+     "glFramebufferTexture2D" => 1,
+     "glFramebufferTexture2DEXT" => 1,
+     # NEUTRON round-48: report what After Effects' startup GL self-test is actually told.
+     # Round 47 showed all 44 of its draw calls happen there and none anywhere else, so this
+     # small sequence is where the decision to abandon the GL display path is made.
+     "glCheckFramebufferStatus" => 1,
+     "glCheckFramebufferStatusEXT" => 1,
+     "glGetError" => 1,
+     "glReadPixels" => 1,
+     "glTexImage2D" => 1,
+     # NEUTRON round-49: which buffer is that one-pixel probe reading? A GL_FRONT read on an
+     # EGL window surface can never return anything under Wayland.
+     "glReadBuffer" => 1,
+     "glDrawBuffer" => 1,
+     # NEUTRON round-50: an app that sets up a glyph atlas and then issues no draw calls looks
+     # exactly like one whose shader pipeline never came up. Query compile/link status ourselves
+     # and print the driver's own info log on failure. The four getters are listed only so they
+     # stop being static and can be called from wgl.c.
+     "glShaderSource" => 1,
+     "glCompileShader" => 1,
+     "glLinkProgram" => 1,
+     "glUseProgram" => 1,
+     "glGetShaderiv" => 1,
+     "glGetShaderInfoLog" => 1,
+     "glGetProgramiv" => 1,
+     "glGetProgramInfoLog" => 1,
+     "glCompileShaderARB" => 1,
+     "glLinkProgramARB" => 1,
      "glCreateSyncFromCLeventARB" => 1,
      "glDeleteSync" => 1,
      "glFenceSync" => 1,
@@ -710,6 +782,25 @@ sub generate_win_thunk($$)
     $ret .= ";\n";
     $ret .= "    NTSTATUS status;\n";
     $ret .= "    int integer;\n" if $get_integer;
+    # NEUTRON round-51: count EVERY draw command, not just the handful worth hand-writing.
+    # Round 47 counted five draw entry points and concluded After Effects issues no drawing at
+    # all -- but modern GLSL 150 code can just as well use glDrawElementsBaseVertex or a
+    # MultiDraw, and those would have gone unseen. That is the same shape of mistake round 42
+    # made (measuring only what the instrument happened to cover), so close it generically:
+    # anything that submits geometry gets counted here, automatically, forever.
+    # Excluded: glDrawBuffer(s)/glDrawBufferRegion, which select a target and draw nothing.
+    #
+    # round-52 CORRECTION: the rule above still missed IMMEDIATE MODE. After Effects'
+    # DisplaySurface.dll uses OpenGL entry points that are nearly all OpenGL 1.x --
+    # glBegin, glEnd, glVertex2f/3f, glTexCoord2f, glMatrixMode, glLoadIdentity, glOrtho,
+    # glTexEnvf, glAlphaFunc, glShadeModel. Geometry submitted between glBegin and glEnd goes
+    # through NONE of the glDraw* commands, so a legacy renderer would have counted as zero
+    # draws no matter how much it drew. glBegin is the batch, so count that; display lists can
+    # replay drawing too, so count those as well.
+    $ret .= "    neutron_count_draw();\n"
+        if ($name =~ /^gl(Draw|MultiDraw|Rect)/ && $name !~ /^glDrawBuffer/)
+        || $name =~ /^glBegin$/
+        || $name =~ /^glCallLists?$/;
     $ret .= "    " . get_func_trace( $name, $func, 1 );
     $ret .= $checks;
     $ret .= $get_integer ? "    $get_integer\n    else " : "    ";
@@ -902,8 +993,21 @@ my %unsupported_extensions =
     "WGL_EXT_pixel_format" => 1,
     "WGL_NV_copy_image" => 1,
     "WGL_NV_delay_before_swap" => 1,
-    "WGL_NV_DX_interop" => 1,
-    "WGL_NV_DX_interop2" => 1,
+    # NEUTRON: WGL_NV_DX_interop / _interop2 enabled 2026-07-31. These were on the
+    # unsupported list, so make_opengl emitted no entry points and opengl32 never
+    # advertised the extension -- and After Effects gates wgl* resolution on the
+    # ADVERTISED EXTENSION STRING, so it never even asked for them. Proven by a
+    # controlled A/B: advertise the two names with NO implementation and AE
+    # immediately requests all 8 wglDX* functions; leave them out and it requests
+    # none (23 vs 31 distinct wgl*). That is why AE's composition viewer is blank --
+    # it renders the comp into a D3D texture and bridges it into its GL display
+    # surface via this extension, and on Wine the bridge does not exist, so it
+    # presents an empty GL surface (~350x/session; native AE calls SwapBuffers ZERO
+    # times -- it presents through D3D/DXGI instead).
+    # See memory neutron-ae-composition-content-blank + ~/Downloads/HANDOFF-LINUX-ae-comp-viewer.md.
+    # NOTE the other two entries above account for the rest of the measured 10-function
+    # gap vs Windows (wglCopyImageSubDataNV, wglDelayBeforeSwapNV); they are NOT needed
+    # for the composition viewer and stay unsupported for now.
     "WGL_NV_gpu_affinity" => 1,
     "WGL_NV_present_video" => 1,
     "WGL_NV_swap_group" => 1,
diff --git a/dlls/opengl32/private.h b/dlls/opengl32/private.h
index aa14924d1a8..af87f182782 100644
--- a/dlls/opengl32/private.h
+++ b/dlls/opengl32/private.h
@@ -29,6 +29,10 @@
 #include "wine/opengl_driver.h"
 #include "thunks.h"
 
+/* NEUTRON round-51: implemented in wgl.c, called from every generated draw thunk so that no
+ * draw command can go uncounted. No-op unless NEUTRON_GL_FBOTRACE=1. */
+extern void neutron_count_draw(void);
+
 struct registry_entry
 {
     const char *name;      /* name of the extension */
diff --git a/dlls/opengl32/thunks.c b/dlls/opengl32/thunks.c
index c62a6fdaa9f..8155a7d2f66 100644
--- a/dlls/opengl32/thunks.c
+++ b/dlls/opengl32/thunks.c
@@ -84,6 +84,7 @@ void WINAPI glBegin( GLenum mode )
 {
     struct glBegin_params args = { .teb = NtCurrentTeb(), .mode = mode };
     NTSTATUS status;
+    neutron_count_draw();
     TRACE( "mode %d\n", mode );
     if ((status = UNIX_CALL( glBegin, &args ))) WARN( "glBegin returned %#lx\n", status );
 }
@@ -116,6 +117,7 @@ void WINAPI glCallList( GLuint list )
 {
     struct glCallList_params args = { .teb = NtCurrentTeb(), .list = list };
     NTSTATUS status;
+    neutron_count_draw();
     TRACE( "list %d\n", list );
     if ((status = UNIX_CALL( glCallList, &args ))) WARN( "glCallList returned %#lx\n", status );
 }
@@ -124,18 +126,11 @@ void WINAPI glCallLists( GLsizei n, GLenum type, const void *lists )
 {
     struct glCallLists_params args = { .teb = NtCurrentTeb(), .n = n, .type = type, .lists = lists };
     NTSTATUS status;
+    neutron_count_draw();
     TRACE( "n %d, type %d, lists %p\n", n, type, lists );
     if ((status = UNIX_CALL( glCallLists, &args ))) WARN( "glCallLists returned %#lx\n", status );
 }
 
