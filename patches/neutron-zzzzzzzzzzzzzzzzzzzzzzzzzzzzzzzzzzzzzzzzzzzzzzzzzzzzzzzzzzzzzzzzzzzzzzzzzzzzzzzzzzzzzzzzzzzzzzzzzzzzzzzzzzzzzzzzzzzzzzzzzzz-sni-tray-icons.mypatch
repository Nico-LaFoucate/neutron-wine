+{
+    return STATUS_NOT_SUPPORTED;
+}
+
+LRESULT WAYLAND_NotifyIcon( HWND hwnd, UINT msg, NOTIFYICONDATAW *nid )
+{
+    return -1;
+}
+
+void WAYLAND_CleanupIcons( HWND hwnd )
+{
+}
