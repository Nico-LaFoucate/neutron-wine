-    else if (toplevel_surface && !toplevel_surface->xdg_surface && neutron_orphan_toplevel() &&
+    else if (toplevel_surface && !toplevel_surface->xdg_surface &&
+             (neutron_orphan_toplevel() || neutron_orphan_menu(data->hwnd)) &&
              neutron_owner_is_root(data->hwnd))
     {
         /* the prospective parent has no xdg_surface, so a subsurface of it can never be shown --
@@ -1127,6 +1148,7 @@
