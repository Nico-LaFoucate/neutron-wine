+/* NEUTRON (2026-11-04): the keys still down when the focused surface is destroyed.
+ *
+ * A leave releases every pressed key (keyboard_handle_leave), as the protocol asks. When this process destroys the
+ * focused surface itself, libwayland hands the leave over with a NULL surface and the handler returns before
+ * releasing, and the key's real release goes to whatever has the focus next. If that is not one of our surfaces,
+ * the key-up never reaches Wine and wineserver auto-repeats the key without end. Measured with a tray menu closed by
+ * Escape (lab, traytest on 179s): the menu is destroyed on the key-down, nothing of ours has the focus afterwards, and
+ * VK_ESCAPE repeated to the application until it exited, closing every menu it opened at once.
+ * wayland_surface_destroy() records the window; this releases the keys, called where no driver lock is held.
+ * Kill switch NEUTRON_RELEASE_DESTROYED_FOCUS=0. */
+void wayland_keyboard_release_destroyed_focus(void)
+{
+    struct wayland_keyboard *keyboard = &process_wayland.keyboard;
+    static int on = -1;
+    HWND hwnd;
+
+    pthread_mutex_lock(&keyboard->mutex);
+    hwnd = keyboard->release_hwnd;
+    keyboard->release_hwnd = NULL;
+    pthread_mutex_unlock(&keyboard->mutex);
+    if (on < 0) { const char *e = getenv("NEUTRON_RELEASE_DESTROYED_FOCUS"); on = !(e && e[0] == '0'); }
+    if (!hwnd || !on) return;
+    TRACE("focused window %p destroyed, releasing keys\n", hwnd);
+    release_all_keys(0);
+}
+
 /**********************************************************************
  *          Keyboard handling
  */
--- a/dlls/winewayland.drv/wayland_sni.c
+++ b/dlls/winewayland.drv/wayland_sni.c
@@ -0,0 +1,1288 @@
+/*
+ * Wayland driver: system tray icons as StatusNotifierItems
+ *
+ * Copyright 2026 the Neutron project
+ * Icon conversion based on the SNI driver by Sergei Chernyadyev (Wine MR 2808).
+ *
