+/* NEUTRON sni-tray: the tray lives in explorer; its D-Bus connections are serviced by this thread (wayland_sni.c) */
+static DWORD WINAPI sni_thread(void *arg)
+{
+    WAYLANDDRV_UNIX_CALL(sni_run, NULL);
+    return 0;
+}
+
+static BOOL is_explorer_process(void)
+{
+    WCHAR path[MAX_PATH];
+    DWORD len = GetModuleFileNameW(NULL, path, ARRAY_SIZE(path));
+    static const WCHAR name[] = L"\\explorer.exe";
+    return len >= ARRAY_SIZE(name) - 1 && !wcsicmp(path + len - (ARRAY_SIZE(name) - 1), name);
+}
