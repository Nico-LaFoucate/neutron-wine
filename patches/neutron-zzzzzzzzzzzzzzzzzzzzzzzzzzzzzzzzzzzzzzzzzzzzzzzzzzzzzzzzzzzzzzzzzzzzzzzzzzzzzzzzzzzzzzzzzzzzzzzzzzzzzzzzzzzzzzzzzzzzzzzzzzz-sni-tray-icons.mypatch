+
+/* NEUTRON sni-tray (2026-11-04): a popup menu whose owner is an unmapped root gets its own toplevel, without the
+ * opt-in above. A tray icon's menu is exactly that: applications open it with TrackPopupMenu from a hidden window when
+ * the tray reports a right click. As a subsurface of the hidden owner it was never seen (lab, traytest on 179: the
+ * #32768 window visible to Win32, no surface on screen). A menu is shown and gone again within one TrackPopupMenu, so
+ * the ghost-window case that keeps the general promotion opt-in cannot arise. Where it appears is the compositor's
+ * placement; it closes when the application loses the focus (NEUTRON_DEACT_ENDMENU), as on Windows.
+ * Kill switch NEUTRON_ORPHAN_MENU=0. */
+static BOOL neutron_orphan_menu(HWND hwnd)
+{
+    static const WCHAR menu_class[] = {'#','3','2','7','6','8'};
+    static int on = -1;
+    WCHAR buf[16];
+    UNICODE_STRING name = { 0, sizeof(buf), buf };
+
+    if (on < 0) { const char *e = getenv("NEUTRON_ORPHAN_MENU"); on = !(e && e[0] == '0'); }
+    if (!on) return FALSE;
+    return NtUserGetClassName(hwnd, FALSE, &name) == ARRAY_SIZE(menu_class) &&
+           !memcmp(buf, menu_class, sizeof(menu_class));
+}
 static struct rb_tree win_data_rb = { wayland_win_data_cmp_rb };
 
