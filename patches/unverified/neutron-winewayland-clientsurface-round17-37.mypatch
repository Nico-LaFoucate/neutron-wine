+/* ===================== NEUTRON round-35: NATIVE WIN32-Z-ORDER STACKING =====================
+ * The native-present pivot: every D2D-UI window's Vulkan client subsurface SHOWS its own
+ * content; the only fix needed is ordering. Mirror the win32 hierarchy in the wl_subsurface
+ * stack: toplevel's own client surface at the bottom (or below the GDI surface when it is a
+ * black container / CEF host), children above their parents, siblings in win32 z-order
+ * (z-order data round-34: every BLACK container has a CONTENT child stacked above it).
+ * LOCK ORDER RULE (round-34 ABBA): phase A (win32 queries) runs BEFORE win_data_mutex;
+ * phase B (wl ops) runs under it and makes NO user-lock calls.
+ * Env-gated: NEUTRON_NATIVE_STACK=1. */
+
+#define NEUTRON_ZMAX 64
+
+static int neutron_trace(void); /* round-37 broad trace (defined below) */
+
+struct neutron_zlist
+{
+    HWND toplevel;
+    HWND hwnd[NEUTRON_ZMAX];
+    BOOL cef_host[NEUTRON_ZMAX]; /* __wine_dcomp_present: cross-proc CEF/CEP panel host */
+    RECT rect[NEUTRON_ZMAX];     /* window rect in toplevel window-rect space (for damage tests) */
+    UINT count;
+};
+
+/* ---- NEUTRON round-36 TEMPORAL SUPPRESSION (issues: CEF/CEP blank + invisible-
+ * until-hover). Windows composes bitblt presents and GDI paints TEMPORALLY into
+ * one surface: the latest painter wins per pixel. Native subsurfaces break that:
+ * an idle black swapchain subsurface eternally covers newer GDI content beneath
+ * it (CEP shared-mem blits, GDI-hybrid panels). Approximate the temporal rule:
+ * a window's client subsurface is placed BELOW the GDI surface while its chain
+ * is IDLE (no present for NEUTRON_IDLE_MS) AND newer GDI damage intersects its
+ * rect; the next present automatically restores it above. ---- */
+#define NEUTRON_IDLE_MS 500
+#define NEUTRON_DMG_RING 32
+
+static pthread_mutex_t neutron_dmg_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct { HWND toplevel; RECT rect; ULONGLONG ms; } neutron_dmg_ring[NEUTRON_DMG_RING];
+static unsigned neutron_dmg_head;
+
+void neutron_gdi_damage_record(HWND toplevel, const RECT *rect)
+{
+    if (neutron_trace())
+        ERR("NT-EV gdi-damage toplevel=%p rect=%ld,%ld-%ld,%ld t=%u\n",
+            toplevel, rect->left, rect->top, rect->right, rect->bottom,
+            (unsigned)NtGetTickCount());
+    pthread_mutex_lock(&neutron_dmg_mutex);
+    neutron_dmg_ring[neutron_dmg_head].toplevel = toplevel;
+    neutron_dmg_ring[neutron_dmg_head].rect = *rect;
+    neutron_dmg_ring[neutron_dmg_head].ms = NtGetTickCount();
+    neutron_dmg_head = (neutron_dmg_head + 1) % NEUTRON_DMG_RING;
+    pthread_mutex_unlock(&neutron_dmg_mutex);
+}
+
+/* was there GDI damage on this toplevel, intersecting rect, newer than since_ms? */
+static BOOL neutron_gdi_damage_since(HWND toplevel, ULONGLONG since_ms, const RECT *rect)
+{
+    unsigned i;
+    BOOL hit = FALSE;
+    pthread_mutex_lock(&neutron_dmg_mutex);
+    for (i = 0; i < NEUTRON_DMG_RING; i++)
+    {
+        const RECT *d = &neutron_dmg_ring[i].rect;
+        if (neutron_dmg_ring[i].toplevel != toplevel) continue;
+        if (neutron_dmg_ring[i].ms <= since_ms) continue;
+        if (d->left < rect->right && d->right > rect->left &&
+            d->top < rect->bottom && d->bottom > rect->top) { hit = TRUE; break; }
+    }
+    pthread_mutex_unlock(&neutron_dmg_mutex);
+    return hit;
+}
+
+/* ===================== NEUTRON round-43: RETAINED PANEL COMPOSITION (RPC) =====================
+ * Gives the single shared toplevel GDI surface MEMORY + correct ASSEMBLY. Each GDI-present chain
+ * window's last-presented pixels are retained in a CPU shadow (filled on the app's present thread
+ * via the rpc_fill unix call -- NO off-thread D3D). On every toplevel-surface flush, chain-owned
+ * regions intersecting the dirty rect are repaired from the shadows (pure memcpy into color_bits)
+ * BEFORE the wl copy, so a relayout-cascade wipe (Premiere's own GDI paint, container black,
+ * NC/erase) can never leave a hole -- content survives until the panel's own next present.
+ *
+ * FREEZE INVARIANTS (rounds 25-33 class stays dead):
+ *  - the leaf mutex (rpc_mutex) is LOCK-TERMINAL: holders do ONLY memcpy / field reads-writes,
+ *    NEVER any other lock and NEVER any NtUser call. A TLS in-leaf flag asserts this.
+ *  - fill runs on the app present thread (which holds the D3D10 device lock); it takes ONLY
+ *    rpc_mutex. repair runs in the flush path; it takes ONLY rpc_mutex. No cross-lock, no cycle.
+ *  - geometry (win_x/y/w/h, zkey) is computed on the PE side and cached here; repair never queries
+ *    the window tree.
+ * CRUX (mixing with Premiere's OWN GDI paint): geometry OWNERSHIP + sticky OURS/APP demotion.
+ * A window is demoted (repair stops for it, forever) if the live surface holds real content in its
+ * owned region that its shadow does NOT (== the app draws that window via GDI, not our present:
+ * hybrids / GDI-drawn timelines). Repair only ever restores a window's OWN retained pixels over a
+ * WIPE (surface black where shadow is real); it never overwrites fresh app content. */
+
+#define NEUTRON_RPC_MAX 96
+
+/* unix-side rect helpers (user32 IntersectRect/SetRect are unavailable here;
+ * the driver provides intersect_rect() inline in waylanddrv.h) */
+#define RPC_SETRECT(r,l,t,rr,b) do{(r).left=(l);(r).top=(t);(r).right=(rr);(r).bottom=(b);}while(0)
+#define RPC_ISEMPTY(r) ((r).left>=(r).right || (r).top>=(r).bottom)
+#define RPC_SETEMPTY(r) do{(r).left=(r).top=(r).right=(r).bottom=0;}while(0)
+
+struct rpc_shadow
+{
+    HWND      hwnd;
+    HWND      toplevel;
+    int       wx, wy, ww, wh;   /* window client rect in toplevel client coords */
+    unsigned  zkey;             /* ancestor depth: higher paints later (on top) */
+    UINT32   *pixels;           /* ww*wh BGRA, malloc'd (dumb duplicate; NOT DXVK staging) */
+    size_t    pixels_cap;       /* allocated element count */
+    RECT      valid;            /* bbox of ever-filled bands, window client coords (0-rect = none) */
+    unsigned  seq;
+    BOOL      demoted;          /* sticky */
+    BOOL      in_use;
+};
+
+static struct rpc_shadow rpc_shadows[NEUTRON_RPC_MAX];
+static pthread_mutex_t rpc_mutex = PTHREAD_MUTEX_INITIALIZER;
+static __thread int rpc_in_leaf;   /* freeze assert: no NtUser / no other lock while set */
+static RECT rpc_video_rect;        /* video canary: a known non-chain child rect (0 = unset) */
+static LONG rpc_stat_repairs, rpc_stat_repair_px, rpc_stat_demotions, rpc_stat_canary;
+static ULONGLONG rpc_stat_t0, rpc_stat_fill_bytes;
+static unsigned rpc_stat_repair_max_us;
+
+static int neutron_rpc_enabled(void)
+{
+    static int v = -1;
+    if (v < 0) { const char *e = getenv("NEUTRON_RPC"); v = (e && e[0] == '1') ? 1 : 0; }
+    return v;
+}
+
+static struct rpc_shadow *rpc_find(HWND hwnd)
+{
+    unsigned i;
+    for (i = 0; i < NEUTRON_RPC_MAX; i++)
+        if (rpc_shadows[i].in_use && rpc_shadows[i].hwnd == hwnd) return &rpc_shadows[i];
+    return NULL;
+}
+
+/* geometry of a chain window in TOPLEVEL client coords + ancestor depth.
+ * Called at FILL time (flush path, NtUser allowed here — same as the surfpix
+ * code above). NEVER called from the repair inner loop (which is lock-terminal). */
+static BOOL rpc_geometry(HWND hwnd, HWND toplevel, int *wx, int *wy, int *ww, int *wh, unsigned *zkey)
+{
+    RECT cr = {0}; POINT o = {0,0}; HWND a; unsigned d = 0;
+    if (!NtUserGetClientRect(hwnd, &cr, NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI))) return FALSE;
+    *ww = cr.right - cr.left; *wh = cr.bottom - cr.top;
+    if (*ww <= 0 || *wh <= 0 || *ww > 8192 || *wh > 8192) return FALSE;
+    NtUserMapWindowPoints(hwnd, toplevel, &o, 1, NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI));
+    *wx = o.x; *wy = o.y;
+    for (a = hwnd; a && a != toplevel && d < 32; a = NtUserGetAncestor(a, GA_PARENT)) d++;
+    *zkey = d;
+    return TRUE;
+}
+
+/* Fill a chain window's shadow FROM the toplevel surface (color_bits), where
+ * DXVK's StretchDIBits just wrote the fresh band. Called from the flush path
+ * when the epoch marks this flush as a chain present of `hwnd`. rpc_mutex +
+ * NtUser (geometry) — NtUser is BEFORE the mutex, mutex holds only memcpy. */
+void neutron_rpc_fill_from_surface(HWND hwnd, HWND toplevel, const void *surf_bits,
+                                   int stride_px, int surf_w, int surf_h, RECT dirty)
+{
+    int wx, wy, ww, wh; unsigned zkey;
+    struct rpc_shadow *s; size_t need;
+    RECT wr, hit; int y;
+    const UINT32 *surf = surf_bits;
+
+    if (!neutron_rpc_enabled() || !hwnd || !surf) return;
+    /* geometry FIRST (NtUser, RAW/physical dpi), before the leaf mutex (r34
+     * phase-A rule). The surface is PHYSICAL; window rects from rpc_geometry are
+     * physical too. DXVK's `dirty` band is in LOGICAL coords (different DPI), so
+     * we IGNORE it and fill the full physical window rect from the surface --
+     * the surface already holds this window's freshly-presented (StretchDIBits
+     * DPI-mapped) pixels. */
+    (void)dirty;
+    if (!rpc_geometry(hwnd, toplevel, &wx, &wy, &ww, &wh, &zkey)) return;
+    RPC_SETRECT(hit, wx, wy, wx + ww, wy + wh);
+    hit.left = max(hit.left, 0); hit.top = max(hit.top, 0);
+    hit.right = min(hit.right, surf_w); hit.bottom = min(hit.bottom, surf_h);
+    if (hit.right <= hit.left || hit.bottom <= hit.top) return;
+
+    pthread_mutex_lock(&rpc_mutex);
+    rpc_in_leaf = 1;
+
+    s = rpc_find(hwnd);
+    if (!s)
+    {
+        unsigned i;
+        for (i = 0; i < NEUTRON_RPC_MAX; i++) if (!rpc_shadows[i].in_use) { s = &rpc_shadows[i]; break; }
+        if (!s) goto out;
+        memset(s, 0, sizeof(*s));
+        s->in_use = TRUE; s->hwnd = hwnd;
+    }
+    /* geometry refresh + resize reset (correction #4: reset valid+realloc on size change) */
+    need = (size_t)ww * wh;
+    if (!s->pixels || s->ww != ww || s->wh != wh || s->pixels_cap < need)
+    {
+        UINT32 *np = realloc(s->pixels, need * 4);
+        if (!np) goto out;
+        s->pixels = np; s->pixels_cap = need; RPC_SETEMPTY(s->valid);
+    }
+    s->toplevel = toplevel; s->wx = wx; s->wy = wy; s->ww = ww; s->wh = wh; s->zkey = zkey;
+
+    /* copy the fresh band OUT of the surface into the shadow (window coords) */
+    for (y = hit.top; y < hit.bottom; y++)
+    {
+        const UINT32 *srow = surf + (size_t)y * stride_px + hit.left;
+        UINT32 *drow = s->pixels + (size_t)(y - wy) * ww + (hit.left - wx);
+        memcpy(drow, srow, (size_t)(hit.right - hit.left) * 4);
+    }
+    /* extend valid-region (window coords) */
+    { RECT vb = { hit.left - wx, hit.top - wy, hit.right - wx, hit.bottom - wy };
+      if (RPC_ISEMPTY(s->valid)) s->valid = vb;
+      else { s->valid.left = min(s->valid.left, vb.left); s->valid.top = min(s->valid.top, vb.top);
+             s->valid.right = max(s->valid.right, vb.right); s->valid.bottom = max(s->valid.bottom, vb.bottom); } }
+    rpc_stat_fill_bytes += (size_t)(hit.right - hit.left) * (hit.bottom - hit.top) * 4;
+out:
+    rpc_in_leaf = 0;
+    pthread_mutex_unlock(&rpc_mutex);
+}
+
+/* sample: is the surface region near-uniform-black? (wipe test) */
+static BOOL rpc_region_black(const UINT32 *surf, int stride_px, RECT r)
+{
+    int x, y, n = 0, black = 0;
+    for (y = r.top; y < r.bottom; y += max(1, (r.bottom - r.top) / 6))
+        for (x = r.left; x < r.right; x += max(1, (r.right - r.left) / 8))
+        { UINT32 v = surf[(size_t)y * stride_px + x] & 0xf0f0f0; n++; if (!v) black++; }
+    return n && black * 100 / n >= 88;
+}
+static BOOL rpc_shadow_black(const struct rpc_shadow *s, RECT r /* window coords */)
+{
+    int x, y, n = 0, black = 0;
+    for (y = r.top; y < r.bottom; y += max(1, (r.bottom - r.top) / 6))
+        for (x = r.left; x < r.right; x += max(1, (r.right - r.left) / 8))
+        { UINT32 v = s->pixels[(size_t)y * s->ww + x] & 0xf0f0f0; n++; if (!v) black++; }
+    return n && black * 100 / n >= 88;
+}
+
+/* Repair: called from the flush path on the toplevel surface bits.
+ * surf/stride_px describe color_bits (BGRA); dirty is in surface coords (==toplevel client
+ * coords, the same space PE mapped win_x/win_y into). rpc_mutex ONLY, no NtUser. */
+void neutron_rpc_repair(HWND toplevel, void *surf_bits, int stride_px, int surf_w, int surf_h, RECT dirty)
+{
+    /* paint order: collect owned windows, sort by zkey ascending (bottom-to-top) */
+    struct rpc_shadow *order[NEUTRON_RPC_MAX]; unsigned n = 0, i, j;
+    UINT32 *surf = surf_bits;
+    LARGE_INTEGER t0, t1, freq;
+    ULONGLONG px = 0;
+
+    if (!neutron_rpc_enabled() || !surf) return;
+
+    NtQueryPerformanceCounter(&t0, &freq);
+    pthread_mutex_lock(&rpc_mutex);
+    rpc_in_leaf = 1;
+
+    for (i = 0; i < NEUTRON_RPC_MAX; i++)
+    {
+        struct rpc_shadow *s = &rpc_shadows[i];
+        RECT wr, hit;
+        if (!s->in_use || s->toplevel != toplevel || s->demoted || !s->pixels) continue;
+        if (RPC_ISEMPTY(s->valid)) continue;
+        /* owned rect in surface coords = window rect ∩ valid-region, offset by win origin */
+        RPC_SETRECT(wr, s->wx + s->valid.left, s->wy + s->valid.top, s->wx + s->valid.right, s->wy + s->valid.bottom);
+        if (!intersect_rect(&hit, &wr, &dirty)) continue;
+        order[n++] = s;
+    }
+    /* insertion sort by zkey ascending */
+    for (i = 1; i < n; i++) { struct rpc_shadow *k = order[i]; for (j = i; j && order[j-1]->zkey > k->zkey; j--) order[j] = order[j-1]; order[j] = k; }
+
+    for (i = 0; i < n; i++)
+    {
+        struct rpc_shadow *s = order[i];
+        RECT wr, hit, sr, wshadow;
+        int y;
+        RPC_SETRECT(wr, s->wx + s->valid.left, s->wy + s->valid.top, s->wx + s->valid.right, s->wy + s->valid.bottom);
+        intersect_rect(&hit, &wr, &dirty);
+        /* clamp to the actual surface */
+        hit.left = max(hit.left, 0); hit.top = max(hit.top, 0);
+        hit.right = min(hit.right, surf_w); hit.bottom = min(hit.bottom, surf_h);
+        if (hit.right <= hit.left || hit.bottom <= hit.top) continue;
+        /* window-space region */
+        RPC_SETRECT(wshadow, hit.left - s->wx, hit.top - s->wy, hit.right - s->wx, hit.bottom - s->wy);
+        wshadow.left = max(0, wshadow.left); wshadow.top = max(0, wshadow.top);
+        wshadow.right = min(s->ww, wshadow.right); wshadow.bottom = min(s->wh, wshadow.bottom);
+        if (wshadow.right <= wshadow.left || wshadow.bottom <= wshadow.top) continue;
+
+        /* video canary */
+        if (!RPC_ISEMPTY(rpc_video_rect))
+        { RECT vv; if (intersect_rect(&vv, &hit, &rpc_video_rect)) rpc_stat_canary++; }
+
+        /* CRUX / demotion: if the surface holds REAL content where our shadow is BLACK,
+         * the app draws this window via GDI (hybrid) -> demote sticky, never stamp black. */
+        if (rpc_shadow_black(s, wshadow) && !rpc_region_black(surf, stride_px, hit))
+        { s->demoted = TRUE; rpc_stat_demotions++; continue; }
+        /* Only repair a WIPE: surface black where shadow is real. Otherwise leave the
+         * surface alone (idempotent for our own fresh present; respects app content). */
+        if (!rpc_region_black(surf, stride_px, hit)) continue;
+
+        RPC_SETRECT(sr, hit.left, hit.top, hit.right, hit.bottom);
+        for (y = 0; y < wshadow.bottom - wshadow.top; y++)
+        {
+            const UINT32 *srow = s->pixels + (size_t)(wshadow.top + y) * s->ww + wshadow.left;
+            UINT32 *drow = surf + (size_t)(sr.top + y) * stride_px + sr.left;
+            memcpy(drow, srow, (size_t)(wshadow.right - wshadow.left) * 4);
+        }
+        px += (ULONGLONG)(wshadow.right - wshadow.left) * (wshadow.bottom - wshadow.top);
+        rpc_stat_repairs++;
+    }
+    rpc_stat_repair_px += (LONG)px;
+
+    rpc_in_leaf = 0;
+    pthread_mutex_unlock(&rpc_mutex);
+
+    NtQueryPerformanceCounter(&t1, &freq);
+    if (px)
+    {
+        unsigned us = (unsigned)((t1.QuadPart - t0.QuadPart) * 1000000 / freq.QuadPart);
+        if (us > rpc_stat_repair_max_us) rpc_stat_repair_max_us = us;
+    }
+    /* stats ~every 5s */
+    {
+        ULONGLONG now = NtGetTickCount();
+        if (!rpc_stat_t0) rpc_stat_t0 = now;
+        if (now - rpc_stat_t0 >= 5000)
+        {
+            ERR("neutron-rpc-stats: repairs=%ld repairMpx=%ld demotions=%ld canaryHits=%ld fillMBps=%llu repairMaxUs=%u\n",
+                rpc_stat_repairs, rpc_stat_repair_px / 1000000, rpc_stat_demotions, rpc_stat_canary,
+                (unsigned long long)(rpc_stat_fill_bytes / 1000000 / 5), rpc_stat_repair_max_us);
+            rpc_stat_t0 = now; rpc_stat_fill_bytes = 0; rpc_stat_repair_max_us = 0;
+        }
+    }
+}
+
+/* PE -> unix: register the video (non-chain) rect for the canary (surface coords). */
+void neutron_rpc_set_video_rect(const RECT *r) { if (r) rpc_video_rect = *r; }
+
+/* PE -> unix: the mapped __neutron_rpc_epoch shared control block (same VA). */
+static struct neutron_rpc_epoch *rpc_epoch;
+static LONG rpc_epoch_last_seq;
+void neutron_rpc_set_epoch(void *ptr) { rpc_epoch = ptr; }
+
+/* Called from the toplevel-surface flush (window_surface.c). Reads the epoch to
+ * learn if THIS flush is a chain present (-> fill the presenter's shadow FROM
+ * the surface) then repairs all chain-owned regions. `bits` is color_bits
+ * (writable DIB backing); `dirty` is in surface coords. */
+void neutron_rpc_flush(HWND toplevel, void *bits, int stride_px, int surf_w, int surf_h, RECT dirty)
+{
+    if (!neutron_rpc_enabled() || !bits) return;
+
+    /* Drain ALL chain presents since the last flush (a single flush may coalesce
+     * many presents; a single-slot epoch would lose all but the last). Each
+     * entry's band in the surface holds that window's fresh pixels -> fill its
+     * shadow FROM the surface. */
+    if (rpc_epoch)
+    {
+        LONG head = rpc_epoch->head;
+        if (rpc_epoch->video_r > rpc_epoch->video_l)
+        { RECT v = { rpc_epoch->video_l, rpc_epoch->video_t, rpc_epoch->video_r, rpc_epoch->video_b };
+          neutron_rpc_set_video_rect(&v); }
+        if (head - rpc_epoch_last_seq > NEUTRON_RPC_RING) rpc_epoch_last_seq = head - NEUTRON_RPC_RING;
+        while (rpc_epoch_last_seq != head)
+        {
+            const struct neutron_rpc_entry *e = &rpc_epoch->ring[rpc_epoch_last_seq & (NEUTRON_RPC_RING - 1)];
+            HWND h = (HWND)(UINT_PTR)(ULONG)e->hwnd;
+            RECT band = { e->bl, e->bt, e->br, e->bb };
+            rpc_epoch_last_seq++;
+            if (h && band.right > band.left)
+                neutron_rpc_fill_from_surface(h, toplevel, bits, stride_px, surf_w, surf_h, band);
+        }
+    }
+    neutron_rpc_repair(toplevel, bits, stride_px, surf_w, surf_h, dirty);
+}
+
+static int neutron_native_stack(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        const char *e = getenv("NEUTRON_NATIVE_STACK");
+        v = (e && e[0] == '1') ? 1 : 0;
+    }
+    return v;
+}
+
+/* NEUTRON round-37: BROAD TRACE mode (env NEUTRON_TRACE=1) -- per-window
+ * timestamped event lines (NT-EV ...) to reconstruct the live pipeline. */
+static int neutron_trace(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        const char *e = getenv("NEUTRON_TRACE");
+        v = (e && e[0] == '1') ? 1 : 0;
+    }
+    return v;
+}
+
+/* NEUTRON round-37: the round-36 temporal-suppression rule is now OPT-IN
+ * (env NEUTRON_TEMPORAL=1) -- it regressed CEF/tabs live (z-order thrash);
+ * default OFF restores the round-35 milestone behavior. */
+static int neutron_temporal(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        const char *e = getenv("NEUTRON_TEMPORAL");
+        v = (e && e[0] == '1') ? 1 : 0;
+    }
+    return v;
+}
+
+/* phase A: build the bottom-to-top win32 order of a toplevel's tree.
+ * USER-LOCK calls only -- must be called WITHOUT win_data_mutex held. */
+static void neutron_zorder_collect_rec(HWND hwnd, struct neutron_zlist *zl, const POINT *origin)
+{
+    static const WCHAR dcomp_present_prop[] =
+        {'_','_','w','i','n','e','_','d','c','o','m','p','_','p','r','e','s','e','n','t',0};
+    HWND kids[NEUTRON_ZMAX];
+    UINT nk = 0, i;
+    RECT wr = {0};
+    HWND c;
+
+    if (zl->count >= NEUTRON_ZMAX) return;
+    zl->cef_host[zl->count] = !!NtUserGetProp(hwnd, dcomp_present_prop);
+    /* window rect in toplevel window-rect space (for temporal damage tests) */
+    NtUserGetWindowRect(hwnd, &wr, NtUserGetWinMonitorDpi(hwnd, MDT_RAW_DPI));
+    OffsetRect(&wr, -origin->x, -origin->y);
+    zl->rect[zl->count] = wr;
+    zl->hwnd[zl->count++] = hwnd;
+    /* GW_CHILD = topmost sibling; GW_HWNDNEXT walks DOWN the z-order */
+    for (c = NtUserGetWindowRelative(hwnd, GW_CHILD); c && nk < NEUTRON_ZMAX;
+         c = NtUserGetWindowRelative(c, GW_HWNDNEXT))
+        kids[nk++] = c;
+    /* recurse bottom-of-z first so the array ends up bottom-to-top */
+    for (i = nk; i > 0; i--)
+        neutron_zorder_collect_rec(kids[i - 1], zl, origin);
+}
+
+static void neutron_zorder_collect(HWND toplevel, struct neutron_zlist *zl)
+{
+    RECT tr = {0};
+    POINT origin;
+    zl->toplevel = toplevel;
+    zl->count = 0;
+    NtUserGetWindowRect(toplevel, &tr, NtUserGetWinMonitorDpi(toplevel, MDT_RAW_DPI));
+    origin.x = tr.left; origin.y = tr.top;
+    neutron_zorder_collect_rec(toplevel, zl, &origin);
+}
+
+/* order cache: skip wl traffic when the applied order is unchanged.
+ * Guarded by win_data_mutex (restack_apply is always called under it). */
+struct neutron_zcache
+{
+    HWND toplevel;
+    struct wl_surface *parent;      /* the toplevel wl_surface the order was applied to */
+    HWND applied[NEUTRON_ZMAX];     /* hwnds whose subsurfaces were ordered */
+    BOOL below[NEUTRON_ZMAX];
+    UINT count;
+};
+static struct neutron_zcache neutron_zcaches[8];
+static LONG neutron_stack_applies;
+
+/* invalidate on subsurface (re)creation: a fresh wl_subsurface defaults to
+ * top-of-stack, so an unchanged-looking order must still be reapplied */
+static void neutron_zcache_invalidate(HWND toplevel)
+{
+    unsigned i;
+    for (i = 0; i < 8; i++)
+        if (neutron_zcaches[i].toplevel == toplevel)
+            memset(&neutron_zcaches[i], 0, sizeof(neutron_zcaches[i]));
+}
+
+static struct neutron_zcache *neutron_zcache_for(HWND toplevel)
+{
+    unsigned i;
+    for (i = 0; i < 8; i++) if (neutron_zcaches[i].toplevel == toplevel) return &neutron_zcaches[i];
+    for (i = 0; i < 8; i++) if (!neutron_zcaches[i].toplevel) { neutron_zcaches[i].toplevel = toplevel; return &neutron_zcaches[i]; }
+    /* evict slot 0 (toplevels are few; churn here is harmless) */
+    memset(&neutron_zcaches[0], 0, sizeof(neutron_zcaches[0]));
+    neutron_zcaches[0].toplevel = toplevel;
+    return &neutron_zcaches[0];
+}
+
+/* phase B: apply the collected order to the wl_subsurface stack.
+ * MUST be called with win_data_mutex held; makes NO user-lock calls. */
+static void neutron_restack_apply(HWND toplevel, const struct neutron_zlist *zl)
+{
+    struct wayland_win_data *tdata = wayland_win_data_get_nolock(toplevel);
+    struct wayland_surface *tsurf = tdata ? tdata->wayland_surface : NULL;
+    struct wayland_client_surface *cs_of[NEUTRON_ZMAX];
+    BOOL below[NEUTRON_ZMAX];
+    HWND applied[NEUTRON_ZMAX];
+    struct wl_surface *prev;
+    struct neutron_zcache *zc;
+    UINT i, n = 0, child_clients = 0;
+    int top_idx = -1;
+    BOOL changed;
+
+    if (!tsurf || !tsurf->wl_surface) return;
+
+    /* NEUTRON perf counters: real restack call/apply frequency (~5s cadence) */
+    {
+        static ULONGLONG t0; static LONG calls, applies_snapshot;
+        ULONGLONG now = NtGetTickCount();
+        calls++;
+        if (!t0) t0 = now;
+        if (now - t0 >= 5000)
+        {
+            ERR("neutron-stack-stats: 5s calls=%ld applies=%ld\n", calls, neutron_stack_applies - applies_snapshot);
+            t0 = now; calls = 0; applies_snapshot = neutron_stack_applies;
+        }
+    }
+
+    /* gather the client surfaces that are valid siblings of this toplevel
+     * (round-21 sibling-validity guard: only touch subsurfaces actually
+     * attached to THIS toplevel's current wl_surface) */
+    for (i = 0; i < zl->count && n < NEUTRON_ZMAX; i++)
+    {
+        struct wayland_win_data *d = (zl->hwnd[i] == toplevel) ? tdata : wayland_win_data_get_nolock(zl->hwnd[i]);
+        struct wayland_client_surface *cs = d ? d->client_surface : NULL;
+        if (!cs || !cs->wl_subsurface || !cs->wl_surface) continue;
+        if (cs->toplevel_wl_surface != tsurf->wl_surface) continue; /* not our sibling */
+        cs_of[n] = cs;
+        applied[n] = zl->hwnd[i];
+        /* suppress rule (round-17-proven minimal set): CEF/CEP host containers... */
+        below[n] = zl->cef_host[i];
+        /* NEUTRON round-36 TEMPORAL rule ("latest painter wins"): if this chain
+         * is IDLE and newer GDI damage (CEP shared-mem blits, GDI-hybrid paints)
+         * intersects its rect, its stale/black frame must not cover that GDI
+         * content -> place below. Its next present automatically restores it.
+         * round-37: OPT-IN only (regressed CEF/tab z-order live). */
+        if (neutron_temporal() && !below[n] && cs->last_present_ms &&
+            NtGetTickCount() - cs->last_present_ms > NEUTRON_IDLE_MS &&
+            neutron_gdi_damage_since(toplevel, cs->last_present_ms, &zl->rect[i]))
+            below[n] = TRUE;
+        if (zl->hwnd[i] == toplevel) top_idx = (int)n; else child_clients++;
+        n++;
+    }
+    /* ...plus (a) the toplevel's OWN client surface when it hosts >=1 child client
+     * subsurface (black container signature; belt-and-braces -- z-order alone
+     * already puts content children above it). */
+    if (top_idx >= 0 && child_clients > 0) below[top_idx] = TRUE;
+
+    if (!n) return;
+
+    /* order-cache: skip if identical (per-present calls must not storm wl) */
+    zc = neutron_zcache_for(toplevel);
+    changed = (zc->parent != tsurf->wl_surface) || (zc->count != n);
+    if (!changed)
+        for (i = 0; i < n; i++)
+            if (zc->applied[i] != applied[i] || zc->below[i] != below[i]) { changed = TRUE; break; }
+    if (!changed) return;
+
+    prev = tsurf->wl_surface;
+    for (i = 0; i < n; i++)
+    {
+        if (below[i])
+        {
+            /* below the GDI/main surface: can never occlude content */
+            wl_subsurface_place_below(cs_of[i]->wl_subsurface, tsurf->wl_surface);
+            continue;
+        }
+        /* place_above(parent-or-sibling) is always protocol-valid here */
+        wl_subsurface_place_above(cs_of[i]->wl_subsurface, prev);
+        prev = cs_of[i]->wl_surface;
+    }
+    /* subsurface z-order applies on parent commit */
+    wl_surface_commit(tsurf->wl_surface);
+    neutron_stack_applies++;
+
+    zc->parent = tsurf->wl_surface;
+    zc->count = n;
+    memcpy(zc->applied, applied, n * sizeof(*applied));
+    memcpy(zc->below, below, n * sizeof(*below));
+
+    {
+        static unsigned logn;
+        if (neutron_trace() || logn < 40)
+        {
+            char buf[512]; int off = 0;
+            logn++;
+            for (i = 0; i < n && off < (int)sizeof(buf) - 24; i++)
+                off += snprintf(buf + off, sizeof(buf) - off, "%p%s ", applied[i], below[i] ? "(below)" : "");
+            ERR("NT-EV restack toplevel=%p t=%u order-bottom-to-top: %s\n",
+                toplevel, (unsigned)NtGetTickCount(), buf);
+        }
+    }
+}
+/* =================== end NEUTRON native stacking =================== */
+
+/* NEUTRON: do NOT destroy a client subsurface for a TRANSIENTLY invisible window
+ * (env NEUTRON_WL_KEEPCLIENT=1).
+ *
+ * MEASURED (After Effects 2025 composition viewer, 2026-07-31): that window presents 630 times
+ * in a session and its OWN WS_VISIBLE bit toggles constantly --
+ *      371 presents  vis=0 selfvis=0 parentvis=1     <- itself hidden, parent visible
+ *      259 presents  vis=1 selfvis=1 parentvis=1
+ * Every vis=0 present took the `else` branch below, i.e. attach_rect(NULL, NULL), which per the
+ * STEP 1 comment DESTROYS the subsurface and ORPHANS the wl_surface -- it is never mapped again,
+ * so the swapchain keeps presenting into a surface that can never be shown. One toggle is
+ * therefore permanent: the 259 later visible presents are all delivered into a dead surface.
+ * That is why AE's composition panel stays black while AE renders it perfectly.
+ *
+ * The discriminator is in the data: a TRANSIENTLY hidden child has a VISIBLE parent, whereas a
+ * genuinely hidden window (AE's inactive Layer/Footage viewers) has parentvis=0 as well. So keep
+ * the surface for the former and keep destroying it for the latter -- genuinely hidden windows
+ * must still stop compositing. */
+static int neutron_keepclient(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        const char *e = getenv("NEUTRON_WL_KEEPCLIENT");
+        v = (e && e[0] == '1') ? 1 : 0;
+    }
+    return v;
+}
