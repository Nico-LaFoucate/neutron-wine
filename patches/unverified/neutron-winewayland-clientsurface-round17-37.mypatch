+
+/**********************************************************************
+ *          wayland_surface_get_frame_spill_rect
+ *
+ * NEUTRON overhang fix. Some apps (e.g. Adobe Premiere) "maximize" themselves
+ * WITHOUT setting WS_MAXIMIZE: they size a normal WS_THICKFRAME toplevel so its
+ * CLIENT area fills the monitor, which spills the ~5px non-client frame off every
+ * edge. On X11/Windows the WM clips the off-screen frame; winewayland commits the
+ * whole window as one surface and KWin cannot honor the negative toplevel offset,
+ * so the spilled frame shows as a right/bottom overhang.
+ *
+ * For a NORMAL-state (non-maximized, non-fullscreen) toplevel whose window rect
+ * genuinely EXCEEDS its monitor, returns TRUE and fills *rect with the in-monitor
+ * subregion in window-local (buffer-pixel) coordinates, so callers can crop the
+ * wp_viewport source (and shrink the destination/geometry) to just the visible
+ * content. Returns FALSE (leave untouched) for popups/subsurfaces, ordinary
+ * sub-monitor windows (and windows merely dragged partly off-screen), and real
+ * maximize/fullscreen (which already clip via wayland_surface_reconfigure_geometry).
+ */
+static BOOL wayland_surface_get_frame_spill_rect(struct wayland_surface *surface,
+                                                 RECT *rect)
+{
+    HMONITOR hmonitor;
+    MONITORINFO mi;
+    int win_w, win_h, mon_w, mon_h;
+
+    if (surface->role != WAYLAND_SURFACE_ROLE_TOPLEVEL) return FALSE;
+    if (surface->current.state & (WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED |
+                                  WAYLAND_SURFACE_CONFIG_STATE_FULLSCREEN))
+        return FALSE;
+
+    mi.cbSize = sizeof(mi);
+    if (!(hmonitor = NtUserMonitorFromRect(&surface->window.rect, 0)) ||
+        !NtUserGetMonitorInfo(hmonitor, (MONITORINFO *)&mi))
+        return FALSE;
+
+    win_w = surface->window.rect.right - surface->window.rect.left;
+    win_h = surface->window.rect.bottom - surface->window.rect.top;
+    mon_w = mi.rcMonitor.right - mi.rcMonitor.left;
+    mon_h = mi.rcMonitor.bottom - mi.rcMonitor.top;
+
+    /* Only clip a window that genuinely exceeds its monitor in width or height.
+     * Ordinary sub-monitor floating windows/dialogs are left completely untouched. */
+    if (win_w <= mon_w && win_h <= mon_h) return FALSE;
+
+    intersect_rect(rect, &mi.rcMonitor, &surface->window.rect);
+    if (IsRectEmpty(rect)) return FALSE;
+    OffsetRect(rect, -surface->window.rect.left, -surface->window.rect.top);
+    return TRUE;
+}
+
