 /**********************************************************************
+ *           wayland_window_scale_refresh
+ *
+ * NEUTRON scalefix: the compositor delivered a new precise fractional scale for this window's
+ * surface but the derived integer dpi did not change, so no win32u-driven reconfig will fire
+ * (wayland_window_output_change no-ops at equal dpi, and an idle maximized window gets no
+ * further WindowPosChanged to re-run wayland_win_data_get_config). Re-derive conf->scale via
+ * wayland_win_data_get_config (the single source of scale policy) and, only if the scale
+ * actually changed, re-run wayland_surface_reconfigure + commit so the wp_viewport destination
+ * is recomputed at the exact scale (1.7000 instead of the dpi fallback 163/96=1.6979 that made
+ * the maximized window ~0.12% too big). Purely wayland-side: no window rects, styles, monitor
+ * or dpi state in win32u are modified, so this can NOT trigger WM_DPICHANGED, relayout, or feed
+ * back into another preferred-scale event. Always-on (not gated by NEUTRON_DPI_34): it is part
+ * of the always-on sizing correctness path in wayland_win_data_get_config.
+ */
+static void wayland_window_scale_refresh(HWND hwnd)
+{
+    struct wayland_win_data *data;
+    struct wayland_surface *surface;
+    double old_scale, scale_delta;
+
+    if (!(data = wayland_win_data_get(hwnd))) return;
+
+    if ((surface = data->wayland_surface) && surface->wl_surface &&
+        wayland_surface_is_toplevel(surface))
+    {
+        old_scale = surface->window.scale;
+        wayland_win_data_get_config(data, &surface->window);
+        scale_delta = surface->window.scale - old_scale;
+        if (scale_delta < 0.0) scale_delta = -scale_delta;
+        if (scale_delta > 0.001 && wayland_surface_reconfigure(surface))
+        {
+            wl_surface_commit(surface->wl_surface);
+            wl_display_flush(process_wayland.wl_display);
+            if (neutron_wl_diag())
+                ERR("neutron-scalefix: hwnd=%p viewport recommitted at scale %.4f (was %.4f)\n",
+                    hwnd, surface->window.scale, old_scale);
+        }
+    }
+
+    wayland_win_data_release(data);
+}
