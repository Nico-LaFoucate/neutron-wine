@@ -984,10 +1103,47 @@
 
     TRACE("hwnd=%p subsurface=%d,%d+%dx%d\n", surface->hwnd, x, y, width, height);
 
+    /* NEUTRON round-37 broad trace: computed subsurface geometry per present --
+     * catches mis-positioned / 0x0->1x1 / offscreen subsurfaces that only
+     * become visible once a later WindowPosChanged corrects them (hover-to-see). */
+    if (neutron_trace())
+        ERR("NT-EV reconfig hwnd=%p pos=%d,%d size=%dx%d place=%s t=%u\n",
+            surface->hwnd, x, y, width, height,
+            client->place_below ? "below" : "above", (unsigned)NtGetTickCount());
+
     if (client->wl_subsurface)
     {
         wl_subsurface_set_position(client->wl_subsurface, x, y);
-        wl_subsurface_place_above(client->wl_subsurface, surface->wl_surface);
+        /* NEUTRON: only place_above the surface we are actually parented to. If the
+         * window was reparented (toplevel changed) the subsurface's real parent is
+         * client->toplevel_wl_surface; passing a non-parent/non-sibling here makes the
+         * compositor raise wl_subsurface "incorrect sibling" (a FATAL protocol error
+         * that disconnects the client -> "Failed to read events -> terminating process"
+         * = the project-load crash). Placing above the confirmed parent is always
+         * valid; if it doesn't match, skip (attach will recreate it correctly). */
+        if (client->toplevel_wl_surface == surface->wl_surface)
+        {
+            /* NEUTRON round-35 NATIVE mode: subsurface ordering belongs EXCLUSIVELY to
+             * neutron_restack_apply (win32-z-order mirror). Re-placing here on every
+             * present would scramble the stack (each presenting surface drops to
+             * just-above-main, so the least-recently-presenting surface -- the idle
+             * BLACK container -- floats to the top) while the order cache then
+             * suppresses the repair. Skip all place_* here in native mode. */
+            if (neutron_native_stack())
+            {
+                /* position/viewport only; ordering handled by the stacker */
+            }
+            /* NEUTRON: dcomp-bridge-managed (suppressed) surfaces go BELOW the toplevel
+             * GDI content surface so their black swapchain can't occlude/flicker, while
+             * staying MAPPED so present-wait stays healthy. Everything else stays above. */
+            else if (client->place_below)
+                wl_subsurface_place_below(client->wl_subsurface, surface->wl_surface);
+            else
+                wl_subsurface_place_above(client->wl_subsurface, surface->wl_surface);
+        }
+        else
+            ERR("neutron-wl: SKIP place_above(client) hwnd=%p parent-mismatch cur=%p attached=%p\n",
