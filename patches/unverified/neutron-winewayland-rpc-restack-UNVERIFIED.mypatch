# neutron-winewayland-rpc-restack  ⛔ UNVERIFIED — NOT APPLIED BY build.sh ⛔
#
# ⛔ THIS DIRECTORY IS NOT BUILT. `build.sh` copies patches/*.mypatch and (with
# INCLUDE_DIAGNOSTIC=1) patches/diagnostic/*.mypatch. patches/unverified/ is neither, on
# purpose. Nothing here reaches a runtime until someone deliberately promotes it.
#
# WHAT THIS IS
#   ~912 added lines of winewayland.drv work that existed ONLY in the dev tree
#   (~/wine-tkg-git/.../src/wine-git) and in NO released runtime. Found 2026-07-30 while
#   regenerating an unrelated patch. Preserved here so it cannot be lost to a tree reset,
#   WITHOUT shipping code nobody has reviewed.
#
#   It spans four files and at least six env-gated mechanisms:
#     NEUTRON_RPC                   "round-43" CEP panel repair (see below)
#     NEUTRON_NATIVE_STACK          native z-order restack (neutron_restack_apply, zcaches)
#     NEUTRON_TEMPORAL              ?
#     NEUTRON_DCOMP_SUPPRESS_CLIENT ?
#     NEUTRON_TRACE, NEUTRON_WL_DIAG  diagnostics
#
# THE RPC MECHANISM, as its own comments describe it
#   winewayland.drv exports nothing and is a USER driver, so DXVK cannot call its unixlib.
#   Instead DXVK's PresentImageGdi already StretchDIBits the panel band INTO the toplevel
#   window surface (color_bits), and winewayland fills each shadow FROM color_bits at flush
#   time. DXVK signals WHICH flush is a chain present through a small shared control section
#   (`__neutron_rpc_epoch`), mapped R/W by DXVK and R/O by winewayland, Interlocked-only.
#
# ⚠️ WHY IT MATTERS THAT THIS WAS LEAKY — the halves are ASYMMETRIC.
#   The DXVK WRITER half IS captured (`neutron/patches/production/dxvk-neutron-present.patch`)
#   and is present in the staged `neutron-dxvk-d3d11-rootdump.dll`. The winewayland READER
#   half was in no patch at all. So the mechanism could never function from a released
#   runtime, no matter what DXVK did — the writer shipped and the reader did not.
#
# ⚠️ ONE PART IS NOT GATED. `dllmain.c` creates/maps the `__neutron_rpc_epoch` section
#   unconditionally at DLL_PROCESS_ATTACH (~10 KB shared section + a handle per process).
#   Every CONSUMER is gated (`neutron_rpc_enabled()` requires NEUTRON_RPC=1), so behaviour
#   is inert by default -- but the allocation is not. Gate it before promoting.
#
# ⛔ WHAT HAS NOT BEEN DONE
#   * Not reviewed for correctness. Not written by the assistant capturing it.
#   * Not tested. It compiles in the dev tree; that is all that is known.
#   * Some of it may be abandoned experiment rather than working code -- this project's
#     notes record several winewayland theories that were later refuted.
#   * Applies to the 11.10-18 patch-built tree; verified only by round-trip
#     (apply -> byte-identical to the dev tree).
#
# TO PROMOTE: gate the dllmain allocation, review each mechanism, split the diagnostics into
# patches/diagnostic/, then move the functional remainder into patches/ with a name whose
# ordering holds under BOTH collations (see check-patch-order.py).
--- a/dlls/winewayland.drv/unixlib.h
+++ b/dlls/winewayland.drv/unixlib.h
@@ -28,7 +28,28 @@
     waylanddrv_unix_func_init,
     waylanddrv_unix_func_read_events,
     waylanddrv_unix_func_init_clipboard,
+    /* NEUTRON round-43: PE hands the mapped __neutron_rpc_epoch VA to unix
+     * (same address space); unix flush reads it Interlocked. arg = &(void*). */
+    waylanddrv_unix_func_rpc_epoch,
     waylanddrv_unix_func_count,
 };
 
+/* NEUTRON round-43 RPC transport (verified cross-module, in-tree precedent =
+ * the CEF __neutron_dcomp_px section): winewayland.drv exports nothing and is a
+ * USER driver (GDI ExtEscape does not reach it), so DXVK cannot call its unixlib
+ * directly. Instead DXVK's PresentImageGdi already StretchDIBits the panel band
+ * INTO the toplevel window surface (color_bits); winewayland fills each shadow
+ * FROM color_bits at flush time. DXVK only signals WHICH flush is a chain
+ * present via this tiny shared control section (named __neutron_rpc_epoch),
+ * mapped R/W by DXVK and R/O by winewayland. Interlocked-only; no lock crosses. */
+#define NEUTRON_RPC_EPOCH_NAME L"__neutron_rpc_epoch"
+#define NEUTRON_RPC_RING 512
+struct neutron_rpc_entry { LONG hwnd, bl, bt, br, bb; }; /* band in TOPLEVEL client coords */
+struct neutron_rpc_epoch
+{
+    volatile LONG head;       /* DXVK appends here (monotonic); winewayland drains */
+    volatile LONG video_l, video_t, video_r, video_b; /* canary: non-chain video rect */
+    struct neutron_rpc_entry ring[NEUTRON_RPC_RING];
+};
+
 #endif /* __WINE_WAYLANDDRV_UNIXLIB_H */
--- a/dlls/winewayland.drv/dllmain.c
+++ b/dlls/winewayland.drv/dllmain.c
@@ -19,6 +19,7 @@
  */
 
 #include "waylanddrv_dll.h"
+#include "unixlib.h"
 
 #include "ntuser.h"
 #include "winuser.h"
@@ -259,5 +260,20 @@
     /* NEUTRON: owner-side consumer for cross-process dcomp CEP panels (shared-memory pixel transport). */
     CloseHandle(CreateThread(NULL, 0, neutron_present_consumer_thread, NULL, 0, &tid));
 
+    /* NEUTRON round-43 RPC: create/open the epoch control section (DXVK writes it
+     * on each GDI present) and hand its mapped VA to the unix side (same address
+     * space) so the flush repair can read it Interlocked. */
+    {
+        static const WCHAR name[] = L"__neutron_rpc_epoch";
+        HANDLE h = CreateFileMappingW(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE, 0,
+                                      sizeof(struct neutron_rpc_epoch), name);
+        if (h)
+        {
+            void *view = MapViewOfFile(h, FILE_MAP_READ | FILE_MAP_WRITE, 0, 0,
+                                       sizeof(struct neutron_rpc_epoch));
+            if (view) WAYLANDDRV_UNIX_CALL(rpc_epoch, &view);
+        }
+    }
+
     return TRUE;
 }
--- a/dlls/winewayland.drv/waylanddrv_main.c
+++ b/dlls/winewayland.drv/waylanddrv_main.c
@@ -114,6 +114,14 @@
