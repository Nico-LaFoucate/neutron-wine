 }
 
+/* NEUTRON round-43: receive the mapped __neutron_rpc_epoch VA from the PE side. */
+void neutron_rpc_set_epoch(void *ptr);
+static NTSTATUS waylanddrv_unix_rpc_epoch(void *arg)
+{
+    neutron_rpc_set_epoch(arg ? *(void **)arg : NULL);
+    return STATUS_SUCCESS;
+}
