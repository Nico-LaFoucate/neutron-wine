diff --git a/dlls/d2d1/geometry.c b/dlls/d2d1/geometry.c
index 93816390284..bd7ca946716 100644
--- a/dlls/d2d1/geometry.c
+++ b/dlls/d2d1/geometry.c
@@ -2446,6 +2446,13 @@ static int __cdecl d2d_geometry_intersections_compare(const void *a, const void
     return 0;
 }
 
+/* NEUTRON: segment-pair bounds rejection, toggled per Close so ONE run measures both
+ * variants on identical work -- comparing separate runs is meaningless here because the cost
+ * depends entirely on how far the user zoomed (how many waveform segments are on screen). */
+int neutron_seg_reject = 1;
+static LONGLONG neutron_close_ticks[5][2];
+static unsigned neutron_close_calls[5][2];
+
 static BOOL d2d_geometry_intersect_line_line(struct d2d_geometry *geometry,
         struct d2d_geometry_intersections *intersections, const struct d2d_segment_idx *idx_p,
         const struct d2d_segment_idx *idx_q)
@@ -2470,6 +2477,12 @@ static BOOL d2d_geometry_intersect_line_line(struct d2d_geometry *geometry,
         next = 0;
     q[1] = &figure->vertices[next];
 
+    /* NEUTRON note (2026-07-27): a bounding-box rejection was tried here and MEASURED SLOWER
+     * at every path size (19-20% on 1k-4k vertex paths, controlled A/B alternating per call on
+     * identical work). The segments in Adobe's paths do overlap in bounds, so the test never
+     * paid for itself. Do not re-add it without measuring. The real cost is that
+     * d2d_geometry_intersect_self() is O(n^2); see the lazy-tessellation note in
+     * d2d_geometry_sink_Close. */
     d2d_point_subtract(&v_p, p[1], p[0]);
     d2d_point_subtract(&v_q, q[1], q[0]);
     d2d_point_subtract(&v_qp, p[0], q[0]);
@@ -3277,6 +3290,7 @@ static inline struct d2d_geometry *impl_from_ID2D1GeometrySink(ID2D1GeometrySink
 
