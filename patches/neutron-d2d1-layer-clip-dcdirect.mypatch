+/* NEUTRON DIRTYRECTS de-risk: emit the accumulated per-frame drawn-bounds union
+ * (nb_*, clip-intersected fill/draw region = the region a manufactured-Present1
+ * fix would emit) and the pushed-clip superset (nc_*) for an hwnd render target,
+ * then reset. rt is the device context's ID2D1RenderTarget iface (same object as
+ * ID2D1DeviceContext6_iface). Called from the hwnd present, which owns the hwnd,
+ * so the union can be lined up against that hwnd's GDI rcPaint. Read-only. */
+void neutron_dr_emit(ID2D1RenderTarget *rt, HWND hwnd)
+{
+    struct d2d_device_context *context = impl_from_ID2D1DeviceContext((ID2D1DeviceContext6 *)rt);
+
+    if (!neutron_dirtyrects())
+        return;
+
+    context->nb_present_seq++;
+    if (context->nb_valid || context->nc_valid)
+        ERR("neutron-dr: PRESENT hwnd=%p seq=%u ops=%u drawUnion=(%d,%d,%d,%d) clipUnion=(%d,%d,%d,%d) rtpx=%ux%u\n",
+                hwnd, context->nb_present_seq, context->nb_ops,
+                (int)context->nb_l, (int)context->nb_t, (int)context->nb_r, (int)context->nb_b,
+                (int)context->nc_l, (int)context->nc_t, (int)context->nc_r, (int)context->nc_b,
+                context->pixel_size.width, context->pixel_size.height);
+    else
+        ERR("neutron-dr: PRESENT hwnd=%p seq=%u ops=0 (no draw/clip ops seen -- draws bypass device context, or empty frame)\n",
+                hwnd, context->nb_present_seq);
+
+    context->nb_valid = 0;
+    context->nc_valid = 0;
+    context->nb_ops = 0;
+}
+
+/* NEUTRON D2D DC-DIRECT: read the current frame's drawn-bounds union (tight nb_ U
+ * conservative nc_) as a device-pixel RECT, WITHOUT resetting (reset happens at
+ * BeginDraw). Used by the DC-direct present to blit back only the region D2D drew. */
+/* NEUTRON op-trace: format this frame's histogram (non-zero entries only). */
+void neutron_dr_format_hist(ID2D1RenderTarget *rt, char *buf, unsigned len)
+{
+    static const char *const names[] = {"DrawLine","DrawRectangle","FillRectangle","DrawRoundedRectangle","FillRoundedRectangle","DrawEllipse","FillEllipse","DrawGeometry","FillGeometry","FillOpacityMask","DrawBitmap","DrawText","DrawTextLayout","DrawGlyphRun","DrawImage","PushLayer","FillMesh","DrawMesh"};
+    struct d2d_device_context *context = impl_from_ID2D1DeviceContext((ID2D1DeviceContext6 *)rt);
+    unsigned i, n = 0;
+
+    buf[0] = 0;
+    for (i = 0; i < NEUTRON_OP_COUNT && i < ARRAY_SIZE(names); ++i)
+    {
+        if (!context->nb_hist[i])
+            continue;
+        n += snprintf(buf + n, n < len ? len - n : 0, "%s%s=%u", n ? " " : "", names[i], context->nb_hist[i]);
+        if (n >= len)
+            break;
+    }
+}
+
+/* NEUTRON op-trace: this frame's op count, clear count and the clear's bounds. */
+void neutron_dr_get_frame_stats(ID2D1RenderTarget *rt, unsigned *ops, unsigned *clears, RECT *clear_rect)
+{
+    struct d2d_device_context *context = impl_from_ID2D1DeviceContext((ID2D1DeviceContext6 *)rt);
+
+    *ops = context->nb_ops;
+    *clears = context->nb_clears;
+    SetRect(clear_rect, (int)context->clr_l, (int)context->clr_t,
+            (int)(context->clr_r + 0.5f), (int)(context->clr_b + 0.5f));
+}
+
+/* NEUTRON pixel forensics: the grid point coordinates and the last op that covered each. */
+void neutron_dr_get_point(ID2D1RenderTarget *rt, unsigned i, int *x, int *y, const char **op,
+        unsigned *prev, int *have_prev)
+{
+    static const char *const names[] = {"DrawLine","DrawRectangle","FillRectangle",
+            "DrawRoundedRectangle","FillRoundedRectangle","DrawEllipse","FillEllipse",
+            "DrawGeometry","FillGeometry","FillOpacityMask","DrawBitmap","DrawText",
+            "DrawTextLayout","DrawGlyphRun","DrawImage","PushLayer","FillMesh","DrawMesh"};
+    struct d2d_device_context *context = impl_from_ID2D1DeviceContext((ID2D1DeviceContext6 *)rt);
+
+    *x = context->pixel_size.width * ((i % 4) * 2 + 1) / 8;
+    *y = context->pixel_size.height * ((i / 4) * 2 + 1) / 8;
+    *op = context->pt_lastop[i] < ARRAY_SIZE(names) ? names[context->pt_lastop[i]] : "none";
+    *prev = context->pt_prev[i];
+    *have_prev = context->pt_valid;
+}
+
+void neutron_dr_set_point_colour(ID2D1RenderTarget *rt, unsigned i, unsigned colour)
+{
+    struct d2d_device_context *context = impl_from_ID2D1DeviceContext((ID2D1DeviceContext6 *)rt);
+
+    context->pt_prev[i] = colour;
+    if (i == 15)
+        context->pt_valid = 1;
+}
+
+
+/* NEUTRON REGION READBACK.
+ *
+ * The DC-direct present needs the pixels D2D just drew, on the CPU, to blit them into the
+ * window surface. It used IDXGISurface1::GetDC, which copies the ENTIRE surface GPU->CPU and
+ * creates a DIB section every single call. Measured on Premiere 2026-07-27: 1728us average
+ * (5971us worst) for the 3648x604 timeline and 462us for an 83x626 tool panel -- 79-85% of
+ * all present time, even though a frame typically redraws a 3268x99 strip.
+ *
+ * This copies only the drawn rectangle into a persistent staging texture and blits from the
+ * mapped bytes, so the cost tracks the region actually drawn rather than the panel size, and
+ * no DIB is allocated per frame. Falls back (returns FALSE) whenever anything is unavailable,
+ * so the caller can use the old path; NEUTRON_D2D_FULLREADBACK=1 forces the old path. */
+BOOL neutron_dc_readback_blit(ID2D1RenderTarget *rt, HDC hdc, const RECT *rect)
+{
+    struct d2d_device_context *context = impl_from_ID2D1DeviceContext((ID2D1DeviceContext6 *)rt);
+    D3D11_MAPPED_SUBRESOURCE map;
+    ID3D11DeviceContext *d3d_ctx;
+    ID3D11Resource *src;
+    unsigned w, h;
+    D3D11_BOX box;
+    BOOL ret = FALSE;
+
+    if (neutron_fullreadback() || context->target.type != D2D_TARGET_BITMAP || !context->target.bitmap)
+        return FALSE;
+    if (!(src = context->target.bitmap->resource))
+        return FALSE;
+    w = rect->right - rect->left;
+    h = rect->bottom - rect->top;
+    if (!w || !h)
+        return FALSE;
+
+    if (context->cs)
+        EnterCriticalSection(context->cs);
+    ID3D11Device1_GetImmediateContext(context->d3d_device, &d3d_ctx);
+
+    /* One staging texture per context, sized to the whole target and reused. */
+    if (!context->rb_staging || context->rb_w < context->pixel_size.width
+            || context->rb_h < context->pixel_size.height)
+    {
+        D3D11_TEXTURE2D_DESC desc;
+
+        if (context->rb_staging)
+        {
+            ID3D11Texture2D_Release(context->rb_staging);
+            context->rb_staging = NULL;
+        }
+        memset(&desc, 0, sizeof(desc));
+        desc.Width = context->pixel_size.width;
+        desc.Height = context->pixel_size.height;
+        desc.MipLevels = 1;
+        desc.ArraySize = 1;
+        desc.Format = context->desc.pixelFormat.format;
+        desc.SampleDesc.Count = 1;
+        desc.Usage = D3D11_USAGE_STAGING;
+        desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        if (SUCCEEDED(ID3D11Device1_CreateTexture2D(context->d3d_device, &desc, NULL, &context->rb_staging)))
+        {
+            context->rb_w = desc.Width;
+            context->rb_h = desc.Height;
+        }
+    }
+    if (!context->rb_staging)
+        goto done;
+
+    box.left = rect->left;
+    box.top = rect->top;
+    box.front = 0;
+    box.right = rect->right;
+    box.bottom = rect->bottom;
+    box.back = 1;
+    ID3D11DeviceContext_CopySubresourceRegion(d3d_ctx, (ID3D11Resource *)context->rb_staging, 0,
+            rect->left, rect->top, 0, src, 0, &box);
+
+    if (SUCCEEDED(ID3D11DeviceContext_Map(d3d_ctx, (ID3D11Resource *)context->rb_staging, 0,
+            D3D11_MAP_READ, 0, &map)))
+    {
+        BITMAPINFO bmi;
+        const BYTE *bits;
+
+        memset(&bmi, 0, sizeof(bmi));
+        bmi.bmiHeader.biSize = sizeof(bmi.bmiHeader);
+        bmi.bmiHeader.biWidth = map.RowPitch / 4;
+        bmi.bmiHeader.biHeight = -(LONG)h;    /* top-down */
+        bmi.bmiHeader.biPlanes = 1;
+        bmi.bmiHeader.biBitCount = 32;
+        bmi.bmiHeader.biCompression = BI_RGB;
+        bits = (const BYTE *)map.pData + (size_t)rect->top * map.RowPitch + (size_t)rect->left * 4;
+        ret = SetDIBitsToDevice(hdc, rect->left, rect->top, w, h, 0, 0, 0, h,
+                bits, &bmi, DIB_RGB_COLORS) != 0;
+        ID3D11DeviceContext_Unmap(d3d_ctx, (ID3D11Resource *)context->rb_staging, 0);
+    }
+
+done:
+    ID3D11DeviceContext_Release(d3d_ctx);
+    if (context->cs)
+        LeaveCriticalSection(context->cs);
+    return ret;
+}
+
+void neutron_dc_readback_release(ID2D1RenderTarget *rt)
+{
+    struct d2d_device_context *context = impl_from_ID2D1DeviceContext((ID2D1DeviceContext6 *)rt);
+
+    if (context->rb_staging)
+    {
+        ID3D11Texture2D_Release(context->rb_staging);
+        context->rb_staging = NULL;
+        context->rb_w = context->rb_h = 0;
+    }
+}
+
+/* NEUTRON PERF: app-side drawing stats for this frame (and reset them). */
+/* NEUTRON: start a fresh per-frame tally. */
+void neutron_api_frame_reset(void)
+{
+    unsigned i;
+
+    for (i = 0; i < ARRAY_SIZE(neutron_api_slots) && neutron_api_slots[i].name; ++i)
+    {
+        neutron_api_slots[i].frame_ticks = 0;
+        neutron_api_slots[i].frame_calls = 0;
+    }
+}
+
+/* NEUTRON: name what happened inside ONE slow frame. */
+void neutron_api_dump_slow_frame(HWND hwnd, unsigned w, unsigned h, LONGLONG frame_us)
+{
+    LARGE_INTEGER f;
+    LONGLONG us;
+    unsigned i, j;
+
+    QueryPerformanceFrequency(&f);
+    if (!(us = f.QuadPart / 1000000))
+        us = 1;
+
+    ERR("neutron-spike: hwnd=%p %ux%u FRAME TOOK %lldus -- what ran inside it:\n", hwnd, w, h, frame_us);
+    for (j = 0; j < 8; ++j)
+    {
+        LONGLONG bt = 0;
+        unsigned best = 0;
+
+        for (i = 0; i < ARRAY_SIZE(neutron_api_slots) && neutron_api_slots[i].name; ++i)
+        {
+            if (neutron_api_slots[i].frame_ticks > bt)
+            {
+                bt = neutron_api_slots[i].frame_ticks;
+                best = i;
+            }
+        }
+        if (bt < us * 200)   /* below 200us is noise for a >100ms frame */
+            break;
+        ERR("neutron-spike:    %-50s %8lldus in %u calls\n",
+                neutron_api_slots[best].name, bt / us, neutron_api_slots[best].frame_calls);
+        neutron_api_slots[best].frame_ticks = 0;
+    }
+}
+
+void neutron_dr_get_draw_stats(ID2D1RenderTarget *rt, unsigned *prims, unsigned *draws,
+        LONGLONG *in_d2d, LONGLONG *worst_prim)
+{
+    struct d2d_device_context *context = impl_from_ID2D1DeviceContext((ID2D1DeviceContext6 *)rt);
+
+    *prims = context->perf_prims;
+    *draws = context->perf_extra_draws;
+    *in_d2d = context->perf_in_d2d;
+    *worst_prim = context->perf_worst_prim;
+    context->perf_prims = context->perf_extra_draws = 0;
+    context->perf_in_d2d = context->perf_worst_prim = 0;
+}
+
+void neutron_dr_get_union(ID2D1RenderTarget *rt, RECT *out, BOOL *valid)
+{
+    struct d2d_device_context *context = impl_from_ID2D1DeviceContext((ID2D1DeviceContext6 *)rt);
+    float l = 0, t = 0, r = 0, b = 0;
+    int have = 0;
+
+    if (context->nb_valid)
+    {
+        l = context->nb_l; t = context->nb_t; r = context->nb_r; b = context->nb_b; have = 1;
+    }
+    if (context->nc_valid)
+    {
+        if (!have) { l = context->nc_l; t = context->nc_t; r = context->nc_r; b = context->nc_b; have = 1; }
+        else
+        {
+            if (context->nc_l < l) l = context->nc_l;
+            if (context->nc_t < t) t = context->nc_t;
+            if (context->nc_r > r) r = context->nc_r;
+            if (context->nc_b > b) b = context->nc_b;
+        }
+    }
+    if (have)
+    {
+        out->left = (LONG)l; out->top = (LONG)t;
+        out->right = (LONG)(r + 0.999f); out->bottom = (LONG)(b + 0.999f);
+        *valid = TRUE;
+    }
+    else *valid = FALSE;
+}
