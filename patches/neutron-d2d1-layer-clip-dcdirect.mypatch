+    if (render_target->dc_direct)   /* NEUTRON D2D DC-DIRECT: recreate the GDI-compatible bitmap */
+    {
+        /* A resize creates a FRESH bitmap -- everything previously drawn into it is gone.
+         * If a panel is resized often, that alone would make its content vanish. */
+        if (neutron_optrace())
+            ERR("neutron-dr: DC-DIRECT hwnd=%p RESIZE %dx%d -> %ux%u (target bitmap recreated, contents lost)\n",
+                render_target->hwnd, (int)(render_target->dst_rect.right - render_target->dst_rect.left),
+                (int)(render_target->dst_rect.bottom - render_target->dst_rect.top),
