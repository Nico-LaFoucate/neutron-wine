+                        && (render_target->dst_rect.right - render_target->dst_rect.left) >= 3000
+                        && (render_target->dst_rect.bottom - render_target->dst_rect.top) <= 700)
+                {
+                    unsigned i;
+
+                    for (i = 0; i < 16; ++i)
+                    {
+                        const char *opname = "none";
+                        unsigned prev = 0, cur;
+                        int x = 0, y = 0, have = 0;
+
+                        neutron_dr_get_point(render_target->dxgi_target, i, &x, &y, &opname, &prev, &have);
+                        cur = (unsigned)GetPixel(shdc, x, y) & 0xffffff;
+                        if (have && cur != prev)
