+ * can never paint over a child window that draws itself (timeline, panels, CEF/CEP
+ * bridge views). Matches what a WS_CLIPCHILDREN container does on Windows. */
+static inline BOOL neutron_clipchildren(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        char buf[8];
+        v = (GetEnvironmentVariableA("NEUTRON_D2D_CLIPCHILDREN", buf, sizeof(buf)) && buf[0] == '0') ? 0 : 1;
+    }
+    return v;
+}
