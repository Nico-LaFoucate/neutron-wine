diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
index b3560f09c12..6385236b065 100644
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -16,11 +16,43 @@
  * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
  */
 
+#include <float.h>
 #include "d2d1_private.h"
 #include <d3dcompiler.h>
 
 WINE_DEFAULT_DEBUG_CHANNEL(d2d);
 
+/* NEUTRON: per-phase timing of render-target creation. Creating one takes ~60ms (measured
+ * 2026-07-27) and Premiere creates hundreds while scrubbing -- 95% of the frame. */
+#define NP_PHASE(name) do { if (neutron_perf()) { LARGE_INTEGER q, f; QueryPerformanceCounter(&q); \
+        QueryPerformanceFrequency(&f); \
+        ERR("neutron-rtinit:   %-34s %6lldus\\n", (name), (q.QuadPart - np_p) / (f.QuadPart / 1000000)); \
+        np_p = q.QuadPart; } } while (0)
+
+int neutron_lazytess_on = 1;
+__thread LONGLONG neutron_api_ticks;
+__thread int neutron_api_depth;
+struct neutron_api_slot neutron_api_slots[512];
+
+void neutron_api_record(const char *name, LONGLONG ticks)
+{
+    unsigned i;
+
+    for (i = 0; i < ARRAY_SIZE(neutron_api_slots); ++i)
+    {
+        if (!neutron_api_slots[i].name)
+            neutron_api_slots[i].name = name;
+        if (neutron_api_slots[i].name == name)
+        {
+            neutron_api_slots[i].ticks += ticks;
+            neutron_api_slots[i].calls++;
+            neutron_api_slots[i].frame_ticks += ticks;
+            neutron_api_slots[i].frame_calls++;
+            return;
+        }
+    }
+}
+
 #define INITIAL_CLIP_STACK_SIZE 4
 
 static const D2D1_MATRIX_3X2_F identity =
@@ -78,6 +110,155 @@ static void d2d_size_set(D2D1_SIZE_U *dst, float width, float height)
     dst->height = height;
 }
 
+/* NEUTRON DIRTYRECTS de-risk: fold a device-pixel rect into the TIGHT drawn union
+ * nb_* (min/max; first rect seeds it). */
+/* NEUTRON op-trace: count one primitive by type for this frame. */
+static void neutron_op(struct d2d_device_context *context, enum neutron_op_id id)
+{
+    if (neutron_optrace() && id < NEUTRON_OP_COUNT)
+    {
+        context->nb_hist[id]++;
+        context->last_op = id;
+    }
+}
+
+static void neutron_dr_union_nb(struct d2d_device_context *context, const D2D1_RECT_F *tr)
+{
+    if (tr->right <= tr->left || tr->bottom <= tr->top)
+        return;
+    if (!context->nb_valid)
+    {
+        context->nb_l = tr->left; context->nb_t = tr->top;
+        context->nb_r = tr->right; context->nb_b = tr->bottom;
+        context->nb_valid = 1;
+    }
+    else
+    {
+        if (tr->left < context->nb_l) context->nb_l = tr->left;
+        if (tr->top < context->nb_t) context->nb_t = tr->top;
+        if (tr->right > context->nb_r) context->nb_r = tr->right;
+        if (tr->bottom > context->nb_b) context->nb_b = tr->bottom;
+    }
+    context->nb_ops++;
+}
+
+/* NEUTRON DIRTYRECTS de-risk: fold one EXACT op rect (DIPs) into the TIGHT drawn
+ * union nb_* -- transformed to device pixels via the current transform + DPI, then
+ * intersected with the current clip. This is the region a manufactured-Present1
+ * dirty-rects fix would emit; comparing it to the GDI rcPaint answers whether the
+ * two writers are DISJOINT. Used for rectangle/rounded-rect/ellipse/bitmap ops
+ * (which carry an exact rect). Read-only: touches only the diag union fields. */
+static void neutron_dr_add(struct d2d_device_context *context, const D2D1_RECT_F *r_dips)
+{
+    D2D1_RECT_F tr;
+    D2D1_POINT_2F p;
+    float xs, ys;
+
+    if ((!neutron_dirtyrects() && !neutron_dcdirect()) || !r_dips)
+        return;
+
+    xs = context->desc.dpiX / 96.0f;
+    ys = context->desc.dpiY / 96.0f;
+    d2d_point_transform(&p, &context->drawing_state.transform, r_dips->left * xs, r_dips->top * ys);
+    d2d_rect_set(&tr, p.x, p.y, p.x, p.y);
+    d2d_point_transform(&p, &context->drawing_state.transform, r_dips->left * xs, r_dips->bottom * ys);
+    d2d_rect_expand(&tr, &p);
+    d2d_point_transform(&p, &context->drawing_state.transform, r_dips->right * xs, r_dips->top * ys);
+    d2d_rect_expand(&tr, &p);
+    d2d_point_transform(&p, &context->drawing_state.transform, r_dips->right * xs, r_dips->bottom * ys);
+    d2d_rect_expand(&tr, &p);
+    if (context->clip_stack.count)
+    {
+        const D2D1_RECT_F *c = &context->clip_stack.stack[context->clip_stack.count - 1];
+        if (tr.left < c->left) tr.left = c->left;
+        if (tr.top < c->top) tr.top = c->top;
+        if (tr.right > c->right) tr.right = c->right;
+        if (tr.bottom > c->bottom) tr.bottom = c->bottom;
+    }
+    /* NEUTRON: which call is still wiping the panel? Log any op whose CLIPPED extent
+     * covers most of a timeline-row target, with the clip and layer depth in force. */
+    if (neutron_optrace() && context->pixel_size.width >= 3000 && context->pixel_size.height <= 700)
+    {
+        float area = (tr.right - tr.left) * (tr.bottom - tr.top);
+        float full = (float)context->pixel_size.width * context->pixel_size.height;
+
+        if (full > 0.0f && area >= full * 0.35f)
+        {
+            static const char *const names[] = {"DrawLine","DrawRectangle","FillRectangle",
+                    "DrawRoundedRectangle","FillRoundedRectangle","DrawEllipse","FillEllipse",
+                    "DrawGeometry","FillGeometry","FillOpacityMask","DrawBitmap","DrawText",
+                    "DrawTextLayout","DrawGlyphRun","DrawImage","PushLayer","FillMesh","DrawMesh"};
+            const char *nm = context->last_op < ARRAY_SIZE(names) ? names[context->last_op] : "?";
+
+            if (context->clip_stack.count)
+            {
+                const D2D1_RECT_F *c = &context->clip_stack.stack[context->clip_stack.count - 1];
+                ERR("neutron-dr: BIGFILL %s rect=(%d,%d,%d,%d) %d%% of target, layers=%u, clip=(%d,%d,%d,%d)\n",
+                        nm, (int)tr.left, (int)tr.top, (int)tr.right, (int)tr.bottom,
+                        (int)(area * 100.0f / full), context->layer_depth,
+                        (int)c->left, (int)c->top, (int)c->right, (int)c->bottom);
+            }
+            else
+            {
+                ERR("neutron-dr: BIGFILL %s rect=(%d,%d,%d,%d) %d%% of target, layers=%u, NO CLIP\n",
+                        nm, (int)tr.left, (int)tr.top, (int)tr.right, (int)tr.bottom,
+                        (int)(area * 100.0f / full), context->layer_depth);
+            }
+        }
+    }
+
+    /* NEUTRON pixel forensics: remember the last op to cover each sample point. */
+    if (neutron_optrace() && context->pixel_size.width && context->pixel_size.height)
+    {
+        unsigned i;
+
+        for (i = 0; i < 16; ++i)
+        {
+            float px = context->pixel_size.width * ((i % 4) * 2 + 1) / 8.0f;
+            float py = context->pixel_size.height * ((i / 4) * 2 + 1) / 8.0f;
+
+            if (px >= tr.left && px < tr.right && py >= tr.top && py < tr.bottom)
+                context->pt_lastop[i] = context->last_op;
+        }
+    }
+
+    neutron_dr_union_nb(context, &tr);
+}
+
+/* NEUTRON DIRTYRECTS de-risk: fold the CURRENT clip (device-pixel; or the full
+ * render target if none) into the CONSERVATIVE union nc_* -- used for ops whose
+ * exact extent is hard to obtain (glyph runs, vector geometries, Clear, bitmaps
+ * with a NULL dst). nc_* is a superset: if it is disjoint from the GDI rcPaint,
+ * the writers are certainly disjoint. Read-only. */
+static void neutron_dr_add_clip(struct d2d_device_context *context)
+{
+    D2D1_RECT_F tr;
+
+    if (!neutron_dirtyrects() && !neutron_dcdirect())
+        return;
+
+    if (context->clip_stack.count)
+        tr = context->clip_stack.stack[context->clip_stack.count - 1];
+    else
+        d2d_rect_set(&tr, 0.0f, 0.0f, (float)context->pixel_size.width, (float)context->pixel_size.height);
+
+    if (tr.right <= tr.left || tr.bottom <= tr.top)
+        return;
+    if (!context->nc_valid)
+    {
+        context->nc_l = tr.left; context->nc_t = tr.top;
+        context->nc_r = tr.right; context->nc_b = tr.bottom;
+        context->nc_valid = 1;
+    }
+    else
+    {
+        if (tr.left < context->nc_l) context->nc_l = tr.left;
+        if (tr.top < context->nc_t) context->nc_t = tr.top;
+        if (tr.right > context->nc_r) context->nc_r = tr.right;
+        if (tr.bottom > context->nc_b) context->nc_b = tr.bottom;
+    }
+}
+
 static BOOL d2d_clip_stack_init(struct d2d_clip_stack *stack)
 {
     if (!(stack->stack = malloc(INITIAL_CLIP_STACK_SIZE * sizeof(*stack->stack))))
@@ -116,6 +297,292 @@ static void d2d_clip_stack_pop(struct d2d_clip_stack *stack)
     --stack->count;
 }
 
+
+
+/* NEUTRON LAYER-MASK RECTS: if a layer's geometric mask is a WINDING geometry group of
+ * disjoint rectangles -- a dirty region -- record the pieces in device pixels so each draw
+ * inside the layer can be scissored to them individually. Clipping to the bounding box
+ * instead (all Wine could do while PushLayer was a stub) lets a background fill inside the
+ * layer wipe everything between the pieces; that is what erased Premiere's timeline clips.
+ * Returns TRUE if a list was installed. Conservative: any non-rectangle member, a non-WINDING
+ * fill mode, more pieces than we hold, or ANY overlap between pieces (which would blend a
+ * translucent draw twice) leaves the list empty and the bounding-box clip in force. */
+static BOOL d2d_device_context_install_mask_rects(struct d2d_device_context *context,
+        ID2D1Geometry *mask, const D2D1_MATRIX_3X2_F *mask_transform)
+{
+    ID2D1Geometry *srcs[ARRAY_SIZE(context->mask_rects)];
+    D2D1_RECT_F rects[ARRAY_SIZE(context->mask_rects)];
+    ID2D1GeometryGroup *group;
+    unsigned i, j, n, count = 0;
+    float x_scale, y_scale;
+    BOOL ok = TRUE;
+
+    if (!neutron_maskrects() || context->mask_owner)
+        return FALSE;
+    if (FAILED(ID2D1Geometry_QueryInterface(mask, &IID_ID2D1GeometryGroup, (void **)&group)))
+        return FALSE;
+
+    n = ID2D1GeometryGroup_GetSourceGeometryCount(group);
+    if (n > ARRAY_SIZE(srcs) || ID2D1GeometryGroup_GetFillMode(group) != D2D1_FILL_MODE_WINDING)
+    {
+        if (neutron_optrace())
+            ERR("neutron-dr: MASKFALLBACK n=%u (limit %u) fillmode=%u -- bounding box in force\n",
+                    n, (unsigned)ARRAY_SIZE(srcs), ID2D1GeometryGroup_GetFillMode(group));
+        ID2D1GeometryGroup_Release(group);
+        return FALSE;
+    }
+    memset(srcs, 0, sizeof(srcs));
+    ID2D1GeometryGroup_GetSourceGeometries(group, srcs, n);
+    ID2D1GeometryGroup_Release(group);
+
+    x_scale = context->desc.dpiX / 96.0f;
+    y_scale = context->desc.dpiY / 96.0f;
+    for (i = 0; i < n; ++i)
+    {
+        ID2D1RectangleGeometry *rg;
+        D2D1_RECT_F r, t;
+        D2D1_POINT_2F p;
+
+        if (!srcs[i])
+        {
+            ok = FALSE;
+            continue;
+        }
+        /* Only plain rectangles: for anything else the bounds are not the shape. */
+        if (FAILED(ID2D1Geometry_QueryInterface(srcs[i], &IID_ID2D1RectangleGeometry, (void **)&rg)))
+        {
+            ok = FALSE;
+        }
+        else
+        {
+            ID2D1RectangleGeometry_GetRect(rg, &r);
+            ID2D1RectangleGeometry_Release(rg);
+            if (mask_transform)
+            {
+                D2D1_RECT_F mb;
+
+                if (SUCCEEDED(ID2D1Geometry_GetBounds(srcs[i], mask_transform, &mb)))
+                    r = mb;
+            }
+            d2d_point_transform(&p, &context->drawing_state.transform, r.left * x_scale, r.top * y_scale);
+            d2d_rect_set(&t, p.x, p.y, p.x, p.y);
+            d2d_point_transform(&p, &context->drawing_state.transform, r.left * x_scale, r.bottom * y_scale);
+            d2d_rect_expand(&t, &p);
+            d2d_point_transform(&p, &context->drawing_state.transform, r.right * x_scale, r.top * y_scale);
+            d2d_rect_expand(&t, &p);
+            d2d_point_transform(&p, &context->drawing_state.transform, r.right * x_scale, r.bottom * y_scale);
+            d2d_rect_expand(&t, &p);
+            if (t.right > t.left && t.bottom > t.top)
+                rects[count++] = t;
+        }
+        ID2D1Geometry_Release(srcs[i]);
+    }
+    if (!ok || !count)
+    {
+        if (neutron_optrace())
+            ERR("neutron-dr: MASKFALLBACK non-rectangle member (n=%u) -- bounding box in force\n", n);
+        return FALSE;
+    }
+
+    /* Disjoint check: overlapping pieces would draw translucent content twice. */
+    for (i = 0; i < count; ++i)
+    {
+        for (j = i + 1; j < count; ++j)
+        {
+            if (rects[i].left < rects[j].right && rects[j].left < rects[i].right
+                    && rects[i].top < rects[j].bottom && rects[j].top < rects[i].bottom)
+            {
+                if (neutron_optrace())
+                    ERR("neutron-dr: MASKFALLBACK overlapping pieces (n=%u) -- bounding box in force\n", count);
+                return FALSE;
+            }
+        }
+    }
+
+    memcpy(context->mask_rects, rects, count * sizeof(*rects));
+    context->mask_rect_count = count;
+    context->mask_owner = context->layer_depth + 1;
+    return TRUE;
+}
+
+/* NEUTRON LAYER-CLIP: apply a layer's bounds as a clip.
+ *
+ * Wine's PushLayer is a stub: the layer parameters were dropped on the floor, so anything
+ * drawn "inside" the layer was drawn against the full target with no bound at all. Apps use
+ * a layer to SCOPE a repaint -- push layer, fill the background, draw the new content, pop --
+ * and rely on the layer bounds to stop the fill. Unbounded, that background fill erases
+ * everything else in the target. Measured in Premiere Pro 2025 (2026-07-27): every frame
+ * carrying a PushLayer wiped the timeline's clips, which reappeared only until the next such
+ * frame.
+ *
+ * A full layer implementation renders to an offscreen surface and composites it with the
+ * opacity/mask; that is a much larger change. Clipping to the layer's bounds is the part that
+ * matters for correctness of everything OUTSIDE the layer, and it is strictly better than
+ * ignoring the parameters: content outside the layer is now left alone.
+ *
+ * bounds = contentBounds, intersected with the geometric mask's bounds when one is given
+ * (the mask can only shrink what the layer covers). An infinite/absent bound contributes
+ * nothing, exactly as before. */
+static void d2d_device_context_push_layer_clip(struct d2d_device_context *context,
+        const D2D1_RECT_F *content_bounds, ID2D1Geometry *mask, const D2D1_MATRIX_3X2_F *mask_transform)
+{
+    D2D1_RECT_F bounds, transformed;
+    float x_scale, y_scale;
+    D2D1_POINT_2F point;
+    BOOL have = FALSE;
+
+    if (context->layer_depth >= ARRAY_SIZE(context->layer_clipped))
+        return;
+    context->layer_clipped[context->layer_depth] = 0;
+
+    d2d_rect_set(&bounds, -FLT_MAX, -FLT_MAX, FLT_MAX, FLT_MAX);
+    if (content_bounds && content_bounds->left > -FLT_MAX && content_bounds->top > -FLT_MAX
+            && content_bounds->right < FLT_MAX && content_bounds->bottom < FLT_MAX)
+    {
+        bounds = *content_bounds;
+        have = TRUE;
+    }
+    if (mask)
+    {
+        D2D1_RECT_F mb;
+
+        if (SUCCEEDED(ID2D1Geometry_GetBounds(mask, mask_transform, &mb))
+                && mb.left <= mb.right && mb.top <= mb.bottom
+                && mb.left > -FLT_MAX && mb.right < FLT_MAX)
+        {
+            if (have)
+                d2d_rect_intersect(&bounds, &mb);
+            else
+                bounds = mb;
+            have = TRUE;
+        }
+    }
+    /* NEUTRON: what SHAPE is the mask? If it is a handful of rectangles (a dirty region),
+     * clipping to its bounding box is far too coarse -- that is what lets a background fill
+     * wipe content between those rectangles. */
+    if (mask && neutron_optrace() && context->pixel_size.width >= 3000 && context->pixel_size.height <= 700)
+    {
+        ID2D1TransformedGeometry *tg;
+        ID2D1RoundedRectangleGeometry *rr;
+        ID2D1RectangleGeometry *rect_geom;
+        ID2D1GeometryGroup *group;
+        ID2D1PathGeometry *path;
+        ID2D1Geometry *inner = mask;
+        const char *kind = "other";
+        unsigned detail = 0, detail2 = 0;
+
+        if (SUCCEEDED(ID2D1Geometry_QueryInterface(inner, &IID_ID2D1TransformedGeometry, (void **)&tg)))
+        {
+            ID2D1Geometry *src = NULL;
+            ID2D1TransformedGeometry_GetSourceGeometry(tg, &src);
+            ID2D1TransformedGeometry_Release(tg);
+            if (src)
+                inner = src;   /* leaked deliberately? no -- released below */
+            kind = "transformed";
+        }
+        if (SUCCEEDED(ID2D1Geometry_QueryInterface(inner, &IID_ID2D1GeometryGroup, (void **)&group)))
+        {
+            ID2D1Geometry *srcs[8];
+            char members[400];
+            unsigned i, n;
+
+            detail = ID2D1GeometryGroup_GetSourceGeometryCount(group);
+            detail2 = ID2D1GeometryGroup_GetFillMode(group);
+            n = detail < ARRAY_SIZE(srcs) ? detail : ARRAY_SIZE(srcs);
+            members[0] = 0;
+            ID2D1GeometryGroup_GetSourceGeometries(group, srcs, n);
+            for (i = 0; i < n; ++i)
+            {
+                D2D1_RECT_F mb;
+                ID2D1RectangleGeometry *rg;
+                const char *mk = "geom";
+                char one[80];
+
+                if (!srcs[i])
+                    continue;
+                if (SUCCEEDED(ID2D1Geometry_QueryInterface(srcs[i], &IID_ID2D1RectangleGeometry, (void **)&rg)))
+                {
+                    mk = "rect";
+                    ID2D1RectangleGeometry_Release(rg);
+                }
+                if (SUCCEEDED(ID2D1Geometry_GetBounds(srcs[i], NULL, &mb)))
+                {
+                    sprintf(one, " [%s %d,%d,%d,%d]", mk, (int)mb.left, (int)mb.top, (int)mb.right, (int)mb.bottom);
+                    if (strlen(members) + strlen(one) < sizeof(members) - 1)
+                        strcat(members, one);
+                }
+                ID2D1Geometry_Release(srcs[i]);
+            }
+            ID2D1GeometryGroup_Release(group);
+            ERR("neutron-dr: MASKMEMBERS n=%u fillmode=%s:%s\n", detail,
+                    detail2 == D2D1_FILL_MODE_ALTERNATE ? "ALTERNATE" : "WINDING", members);
+            kind = "GEOMETRY GROUP";
+        }
+        else if (SUCCEEDED(ID2D1Geometry_QueryInterface(inner, &IID_ID2D1PathGeometry, (void **)&path)))
+        {
+            ID2D1PathGeometry_GetFigureCount(path, &detail);
+            ID2D1PathGeometry_GetSegmentCount(path, &detail2);
+            ID2D1PathGeometry_Release(path);
+            kind = "PATH";
+        }
+        else if (SUCCEEDED(ID2D1Geometry_QueryInterface(inner, &IID_ID2D1RectangleGeometry, (void **)&rect_geom)))
+        {
+            ID2D1RectangleGeometry_Release(rect_geom);
+            kind = "rectangle";
+        }
+        else if (SUCCEEDED(ID2D1Geometry_QueryInterface(inner, &IID_ID2D1RoundedRectangleGeometry, (void **)&rr)))
+        {
+            ID2D1RoundedRectangleGeometry_Release(rr);
+            kind = "rounded-rect";
+        }
+        if (inner != mask)
+            ID2D1Geometry_Release(inner);
+        ERR("neutron-dr: MASKSHAPE kind=%s figures/sources=%u segments=%u bounds=(%d,%d,%d,%d)\n",
+                kind, detail, detail2, (int)bounds.left, (int)bounds.top, (int)bounds.right, (int)bounds.bottom);
+    }
+    if (neutron_optrace() && context->pixel_size.width >= 3000 && context->pixel_size.height <= 700)
+        ERR("neutron-dr: PUSHLAYER bounds=%s(%d,%d,%d,%d) mask=%s depth=%u -> %s\n",
+                have ? "" : "INFINITE", (int)bounds.left, (int)bounds.top, (int)bounds.right,
+                (int)bounds.bottom, mask ? "yes" : "no", context->layer_depth,
+                have ? "CLIPPED" : "UNBOUNDED (nothing stops a fill inside this layer)");
+    if (!have)
+        return;
+
+    /* Same DIP -> device-pixel path PushAxisAlignedClip uses. */
+    x_scale = context->desc.dpiX / 96.0f;
+    y_scale = context->desc.dpiY / 96.0f;
+    d2d_point_transform(&point, &context->drawing_state.transform, bounds.left * x_scale, bounds.top * y_scale);
+    d2d_rect_set(&transformed, point.x, point.y, point.x, point.y);
+    d2d_point_transform(&point, &context->drawing_state.transform, bounds.left * x_scale, bounds.bottom * y_scale);
+    d2d_rect_expand(&transformed, &point);
+    d2d_point_transform(&point, &context->drawing_state.transform, bounds.right * x_scale, bounds.top * y_scale);
+    d2d_rect_expand(&transformed, &point);
+    d2d_point_transform(&point, &context->drawing_state.transform, bounds.right * x_scale, bounds.bottom * y_scale);
+    d2d_rect_expand(&transformed, &point);
+
+    if (d2d_clip_stack_push(&context->clip_stack, &transformed))
+        context->layer_clipped[context->layer_depth] = 1;
+    else
+        WARN("Failed to push layer clip rect.\n");
+
+    /* Refine the box to the mask's actual rectangles where we can. */
+    if (mask)
+        d2d_device_context_install_mask_rects(context, mask, mask_transform);
+}
+
+static void d2d_device_context_pop_layer_clip(struct d2d_device_context *context)
+{
+    if (!context->layer_depth || context->layer_depth > ARRAY_SIZE(context->layer_clipped))
+        return;
+    if (context->mask_owner == context->layer_depth)
+    {
+        context->mask_owner = 0;
+        context->mask_rect_count = 0;
+    }
+    if (context->layer_clipped[context->layer_depth - 1])
+        d2d_clip_stack_pop(&context->clip_stack);
+}
