+    }
+
+    neutron_d2dui_present_probe(render_target);
+
+    /* NEUTRON DIRTYRECTS de-risk: emit this frame's drawn/clip bounds union (the
+     * region a manufactured-Present1 fix would emit) tagged with the hwnd, right
+     * before the PLAIN present (sync,0 -> no Present1 dirty rects today). Ordered
+     * in the log against the hwnd's GDI BeginPaint (NEUTRON_PAINT_TRACE) so we can
+     * see the d2d1-present vs GDI-paint interleaving and whether the regions are
+     * disjoint. Read-only. */
+    neutron_dr_emit(render_target->dxgi_target, render_target->hwnd);
+
