     struct d2d_geometry *geometry = impl_from_ID2D1GeometrySink(iface);
 
     TRACE("iface %p, beziers %p, count %u.\n", iface, beziers, count);
@@ -3428,6 +3449,7 @@ static void STDMETHODCALLTYPE d2d_geometry_sink_AddBeziers(ID2D1GeometrySink *if
 
 static void STDMETHODCALLTYPE d2d_geometry_sink_EndFigure(ID2D1GeometrySink *iface, D2D1_FIGURE_END figure_end)
 {
+    NEUTRON_API_TIME();
     struct d2d_geometry *geometry = impl_from_ID2D1GeometrySink(iface);
     struct d2d_figure *figure;
 
@@ -3716,9 +3738,92 @@ static HRESULT d2d_geometry_resolve_beziers(struct d2d_geometry *geometry)
     return S_OK;
 }
 
+static const struct ID2D1GeometryGroupVtbl d2d_geometry_group_vtbl;
+
+/* NEUTRON LAZY TESSELLATION: run the work Close used to do, once, on first fill.
+ *
+ * Claiming is per geometry via an interlocked compare-exchange rather than a shared lock, so
+ * two threads tessellating two different geometries never wait on each other. A thread that
+ * finds another already working on the SAME geometry waits for it, which is rare (a geometry
+ * is normally used from one thread) and is bounded by that single tessellation. An earlier
+ * version used one process-wide critical section, which would serialise every thread that
+ * triggers a deferred tessellation -- and Premiere runs 404 threads with a five-thread render
+ * pool, so unrelated work such as a CEP panel loading would queue behind it. */
+static HRESULT d2d_geometry_tessellate_now(struct d2d_geometry *geometry)
+{
+    HRESULT hr;
+
+    if (!d2d_geometry_intersect_self(geometry))
+        hr = E_FAIL;
+    else if (SUCCEEDED(hr = d2d_geometry_resolve_beziers(geometry)))
+        hr = d2d_path_geometry_triangulate(geometry);
+
+    if (FAILED(hr))
+    {
+        free(geometry->fill.bezier_vertices);
+        geometry->fill.bezier_vertices = NULL;
+        geometry->fill.bezier_vertex_count = 0;
+        d2d_path_geometry_free_figures(geometry);
+        d2d_geometry_set_error(geometry, hr);
+    }
+    return hr;
+}
+
+static void d2d_geometry_wait_for_tessellation(struct d2d_geometry *geometry)
+{
+    unsigned int spin = 0;
+
+    while (InterlockedCompareExchange(&geometry->tess_pending, 0, 0) == 2)
+    {
+        if (++spin < 64)
+            YieldProcessor();
+        else
+            Sleep(0);
+    }
+}
+
+HRESULT d2d_geometry_require_tessellation(struct d2d_geometry *geometry)
+{
+    LONG prev;
+
+    if (!InterlockedCompareExchange(&geometry->tess_pending, 0, 0))
+        return geometry->tess_hr;
+
+    /* Claim it: 1 (pending) -> 2 (in progress). */
+    if ((prev = InterlockedCompareExchange(&geometry->tess_pending, 2, 1)) != 1)
+    {
+        if (prev == 2)
+            d2d_geometry_wait_for_tessellation(geometry);
+        return geometry->tess_hr;
+    }
+
+    if (geometry->ID2D1Geometry_iface.lpVtbl == (const ID2D1GeometryVtbl *)&d2d_geometry_group_vtbl)
+    {
+        /* A group holds a by-value copy of its inner path's tessellation: resolve the inner
+         * path, then take the copy. (Copying it while empty and never resolving it is what
+         * made every group-drawn UI element disappear in an earlier build.) */
+        struct d2d_geometry *path_impl;
+
+        path_impl = unsafe_impl_from_ID2D1Geometry((ID2D1Geometry *)geometry->u.group.path);
+        if (SUCCEEDED(geometry->tess_hr = d2d_geometry_require_tessellation(path_impl)))
+            geometry->fill = path_impl->fill;
+    }
+    else
+    {
+        geometry->tess_hr = d2d_geometry_tessellate_now(geometry);
+    }
+
+    InterlockedExchange(&geometry->tess_pending, 0);   /* publishes the result to waiters */
+    return geometry->tess_hr;
+}
+
 static HRESULT STDMETHODCALLTYPE d2d_geometry_sink_Close(ID2D1GeometrySink *iface)
 {
+    NEUTRON_API_TIME();
     struct d2d_geometry *geometry = impl_from_ID2D1GeometrySink(iface);
+    static unsigned np_close_seq;
+    LONGLONG np_close_start = 0;
+    unsigned np_verts = 0, np_i;
     HRESULT hr = E_FAIL;
 
     TRACE("iface %p.\n", iface);
@@ -3726,6 +3831,18 @@ static HRESULT STDMETHODCALLTYPE d2d_geometry_sink_Close(ID2D1GeometrySink *ifac
     if (geometry->u.path.state == D2D_GEOMETRY_STATE_CLOSED)
         return D2DERR_WRONG_STATE;
 
+    if (neutron_perf())
+    {
+        LARGE_INTEGER q;
+
+        /* alternate the rejection so both variants see the same mix of paths */
+        neutron_seg_reject = !neutron_seg_reject;
+        QueryPerformanceCounter(&q);
+        np_close_start = q.QuadPart;
+        for (np_i = 0; np_i < geometry->u.path.figure_count; ++np_i)
+            np_verts += geometry->u.path.figures[np_i].vertex_count;
+    }
+
     if (geometry->u.path.state != D2D_GEOMETRY_STATE_OPEN)
         d2d_geometry_set_error(geometry, D2DERR_WRONG_STATE);
 
@@ -3734,6 +3851,14 @@ static HRESULT STDMETHODCALLTYPE d2d_geometry_sink_Close(ID2D1GeometrySink *ifac
 
     geometry->u.path.state = D2D_GEOMETRY_STATE_CLOSED;
 
+    if (neutron_lazytess())
+    {
+        /* Defer to first fill -- see neutron_lazytess(). */
+        InterlockedExchange(&geometry->tess_pending, 1);
+        hr = S_OK;
+        goto done;
+    }
+
     if (!d2d_geometry_intersect_self(geometry))
         goto done;
     if (FAILED(hr = d2d_geometry_resolve_beziers(geometry)))
@@ -3741,6 +3866,39 @@ static HRESULT STDMETHODCALLTYPE d2d_geometry_sink_Close(ID2D1GeometrySink *ifac
     if (FAILED(hr = d2d_path_geometry_triangulate(geometry)))
         goto done;
 
+    if (np_close_start)
+    {
+        static const unsigned limits[5] = {64, 256, 1024, 4096, ~0u};
+        LARGE_INTEGER q, f;
+        unsigned b;
+
+        QueryPerformanceCounter(&q);
+        QueryPerformanceFrequency(&f);
+        for (b = 0; b < 4 && np_verts >= limits[b]; ++b)
+            ;
+        neutron_close_ticks[b][neutron_seg_reject] += q.QuadPart - np_close_start;
+        neutron_close_calls[b][neutron_seg_reject]++;
+        if (!(++np_close_seq % 400))
+        {
+            LONGLONG us = f.QuadPart / 1000000;
+
+            if (us < 1)
+                us = 1;
+            ERR("neutron-geom: path Close cost by size -- WITH bounds rejection vs WITHOUT:\n");
+            for (b = 0; b < 5; ++b)
+            {
+                if (!neutron_close_calls[b][0] && !neutron_close_calls[b][1])
+                    continue;
+                ERR("neutron-geom:   <%-6u verts | ON  %6lldus avg over %5u | OFF %6lldus avg over %5u\n",
+                        limits[b],
+                        neutron_close_calls[b][1] ? neutron_close_ticks[b][1] / neutron_close_calls[b][1] / us : 0,
+                        neutron_close_calls[b][1],
+                        neutron_close_calls[b][0] ? neutron_close_ticks[b][0] / neutron_close_calls[b][0] / us : 0,
+                        neutron_close_calls[b][0]);
+            }
+        }
+    }
+
 done:
     if (FAILED(hr))
     {
@@ -3755,6 +3913,7 @@ done:
 
 static void STDMETHODCALLTYPE d2d_geometry_sink_AddLine(ID2D1GeometrySink *iface, D2D1_POINT_2F point)
 {
+    NEUTRON_API_TIME();
     TRACE("iface %p, point %s.\n", iface, debug_d2d_point_2f(&point));
 
     d2d_geometry_sink_AddLines(iface, &point, 1);
@@ -3762,6 +3921,7 @@ static void STDMETHODCALLTYPE d2d_geometry_sink_AddLine(ID2D1GeometrySink *iface
 
 static void STDMETHODCALLTYPE d2d_geometry_sink_AddBezier(ID2D1GeometrySink *iface, const D2D1_BEZIER_SEGMENT *bezier)
 {
+    NEUTRON_API_TIME();
     TRACE("iface %p, bezier %p.\n", iface, bezier);
 
     d2d_geometry_sink_AddBeziers(iface, bezier, 1);
@@ -3770,6 +3930,7 @@ static void STDMETHODCALLTYPE d2d_geometry_sink_AddBezier(ID2D1GeometrySink *ifa
 static void STDMETHODCALLTYPE d2d_geometry_sink_AddQuadraticBezier(ID2D1GeometrySink *iface,
         const D2D1_QUADRATIC_BEZIER_SEGMENT *bezier)
