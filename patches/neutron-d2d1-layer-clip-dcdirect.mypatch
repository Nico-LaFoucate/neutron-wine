 #include "dwrite_2.h"
 
+/* NEUTRON PM-TRAILS ROUND-11 (env NEUTRON_D2D_TRACE=1): log D2D factory /
+ * render-target creation + DC binding so we can tell whether Adobe's dvaui
+ * D2D drawbot supplier is actually composing the scrubber strip under Wine.
+ * Inert unless the env var is set. */
+static inline BOOL neutron_d2d_trace(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        char buf[8];
+        v = (GetEnvironmentVariableA("NEUTRON_D2D_TRACE", buf, sizeof(buf)) && buf[0] == '1') ? 1 : 0;
+    }
+    return v;
+}
+
+/* NEUTRON DIRTYRECTS DE-RISK (env NEUTRON_DIRTYRECTS=1): read-only capture that
+ * determines whether the region wine d2d1 actually DRAWS into a hwnd render
+ * target (the region a manufactured-Present1-dirty-rects fix would emit) is
+ * DISJOINT from the GDI BeginPaint (rcPaint) region on the same hwnd, or SHARES
+ * pixels (e.g. a playhead column). Inert unless the env var is set. */
+static inline BOOL neutron_dirtyrects(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        char buf[8];
+        v = (GetEnvironmentVariableA("NEUTRON_DIRTYRECTS", buf, sizeof(buf)) && buf[0] == '1') ? 1 : 0;
+    }
+    return v;
+}
+
+/* NEUTRON DIRTYRECTS: emit the accumulated per-frame drawn/clip bounds union for
+ * an hwnd render target's device context, then reset it. Called from the hwnd
+ * render target present path (which owns the hwnd). Defined in device.c. */
+void neutron_dr_emit(ID2D1RenderTarget *rt, HWND hwnd);
+
+/* NEUTRON D2D DC-DIRECT FIX (env NEUTRON_D2D_DCDIRECT=1): render Premiere's D2D UI
+ * HwndRenderTargets into the window's GDI paint surface (DC-direct, like Windows /
+ * ID2D1DCRenderTarget) instead of a DXGI swapchain + Present. This makes the D2D
+ * chrome and the window's GDI content compose in ONE surface (color_bits) -- fixing
+ * the swapchain-stomp invisibility + the readback/present lag -- while keeping GPU
+ * D2D rendering (the caret-trail fix) and leaving video/CEF untouched. */
+static inline BOOL neutron_dcdirect(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        char buf[8];
+        v = (GetEnvironmentVariableA("NEUTRON_D2D_DCDIRECT", buf, sizeof(buf)) && buf[0] == '1') ? 1 : 0;
+    }
+    return v;
+}
+
+/* NEUTRON D2D DC-DIRECT: read (without resetting) the current frame's drawn-bounds
+ * union (device pixels) as a RECT, for clipping the DC-direct blit-back. Defined in
+ * device.c. */
+void neutron_dr_get_union(ID2D1RenderTarget *rt, RECT *out, BOOL *valid);
+
+/* NEUTRON op-trace: per-frame op/clear stats for the DC-direct present diagnostic. */
+void neutron_dr_get_frame_stats(ID2D1RenderTarget *rt, unsigned *ops, unsigned *clears, RECT *clear_rect);
+
+/* NEUTRON op-trace: format this frame's op histogram into buf ("FillRect=12 DrawGeom=3 ..."). */
+void neutron_dr_format_hist(ID2D1RenderTarget *rt, char *buf, unsigned len);
+void neutron_dr_get_point(ID2D1RenderTarget *rt, unsigned i, int *x, int *y, const char **op,
+        unsigned *prev, int *have_prev);
+void neutron_dr_set_point_colour(ID2D1RenderTarget *rt, unsigned i, unsigned colour);
+
+/* NEUTRON REGION READBACK: copy just *rect of the render target back to the CPU and blit it
+ * into hdc at the same position. Returns FALSE if unavailable (caller falls back to GetDC). */
+BOOL neutron_dc_readback_blit(ID2D1RenderTarget *rt, HDC hdc, const RECT *rect);
+void neutron_dc_readback_release(ID2D1RenderTarget *rt);
+void neutron_dr_get_draw_stats(ID2D1RenderTarget *rt, unsigned *prims, unsigned *draws,
+        LONGLONG *in_d2d, LONGLONG *worst_prim);
+
+/* NEUTRON REGION READBACK gate (env NEUTRON_D2D_FULLREADBACK=1 restores the old whole-surface
+ * GetDC path for A/B). */
+static inline BOOL neutron_fullreadback(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        char buf[8];
+        v = (GetEnvironmentVariableA("NEUTRON_D2D_FULLREADBACK", buf, sizeof(buf)) && buf[0] == '1') ? 1 : 0;
+    }
+    return v;
+}
+enum neutron_op_id {
+    NEUTRON_OP_DRAWLINE,
+    NEUTRON_OP_DRAWRECTANGLE,
+    NEUTRON_OP_FILLRECTANGLE,
+    NEUTRON_OP_DRAWROUNDEDRECTANGLE,
+    NEUTRON_OP_FILLROUNDEDRECTANGLE,
+    NEUTRON_OP_DRAWELLIPSE,
+    NEUTRON_OP_FILLELLIPSE,
+    NEUTRON_OP_DRAWGEOMETRY,
+    NEUTRON_OP_FILLGEOMETRY,
+    NEUTRON_OP_FILLOPACITYMASK,
+    NEUTRON_OP_DRAWBITMAP,
+    NEUTRON_OP_DRAWTEXT,
+    NEUTRON_OP_DRAWTEXTLAYOUT,
+    NEUTRON_OP_DRAWGLYPHRUN,
+    NEUTRON_OP_DRAWIMAGE,
+    NEUTRON_OP_PUSHLAYER,
+    NEUTRON_OP_FILLMESH,
+    NEUTRON_OP_DRAWMESH,
+    NEUTRON_OP_COUNT
+};
+
+/* NEUTRON D2D-COALESCE (env NEUTRON_D2D_COALESCE=1): when set, the DC-direct present
+ * SKIPS its per-present InvalidateRect (which inflated the flush rate) and relies on
+ * the app's own EndPaint flush during active paint + the winewayland idle flush (proven
+ * to commit with 0 WM_PAINT). Pairs with the winewayland flush->shm coalescing gate. */
+static inline BOOL neutron_dccoalesce(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        char buf[8];
+        v = (GetEnvironmentVariableA("NEUTRON_D2D_COALESCE", buf, sizeof(buf)) && buf[0] == '1') ? 1 : 0;
+    }
+    return v;
+}
+
+/* NEUTRON D2D DC-DIRECT CEF-EXCLUDE gate (env NEUTRON_D2D_CEFEXCL=1): when the DC-direct
+ * container blits back, exclude cross-process / CEF-class descendant rects so a bridge-
+ * delivered child (Captioneer, home screen UXP view) is not painted over. Default OFF --
+ * subsumed by neutron_clipchildren(), which clips ALL children at zero per-present cost.
+ * Kept as an A/B knob. */
+static inline BOOL neutron_cefexcl(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        char buf[8];
+        v = (GetEnvironmentVariableA("NEUTRON_D2D_CEFEXCL", buf, sizeof(buf)) && buf[0] == '1') ? 1 : 0;
+    }
+    return v;
+}
+
+/* NEUTRON D2D DC-DIRECT: DO NOT InvalidateRect after the blit-back (env
+ * NEUTRON_D2D_INVALIDATE=1 restores the old behaviour for A/B).
+ *
+ * ROOT CAUSE, measured: the present happens INSIDE the app's WM_PAINT handler (BeginPaint
+ * validated the region, app draws with D2D, EndDraw -> our present). InvalidateRect there
+ * re-dirties the window the app is in the middle of painting -> another WM_PAINT -> paint
+ * -> present -> invalidate ... a guaranteed livelock. The run of 2026-07-27 caught it on
+ * 15 of 18 DC-direct containers: each hit the win32u circuit breaker at >=2000 unvalidated
+ * WM_PAINTs, one container at a time over ~200s -- exactly the "panels load in one by one
+ * over several minutes, everything laggy" symptom. The BitBlt into the window DC already
+ * dirties the window surface, so the app's own EndPaint (and the win32u idle flush) commits
+ * it; the extra invalidate was never needed for delivery, only ever a "commit promptly" hedge. */
+static inline BOOL neutron_dcinvalidate(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        char buf[8];
+        v = (GetEnvironmentVariableA("NEUTRON_D2D_INVALIDATE", buf, sizeof(buf)) && buf[0] == '1') ? 1 : 0;
+    }
+    return v;
+}
+
+/* NEUTRON D2D DC-DIRECT: compose-read of the window into the target bitmap before drawing
+ * (env NEUTRON_D2D_COMPOSEREAD=1 to re-enable; default OFF).
+ *
+ * It existed so D2D could compose over GDI content, but it copies the ENTIRE client area
+ * every frame -- for the 3840x1991 container that is ~30 MB per frame, ~900 MB/s at 30fps,
+ * and it ran 2000x per container during the paint storms above. The target bitmap is
+ * persistent and RETAIN_CONTENTS already gives D2D its own retained content, so the read is
+ * redundant for D2D's semantics; we only ever blit back the region D2D actually drew. */
+static inline BOOL neutron_dccomposeread(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        char buf[8];
+        v = (GetEnvironmentVariableA("NEUTRON_D2D_COMPOSEREAD", buf, sizeof(buf)) && buf[0] == '1') ? 1 : 0;
+    }
+    return v;
+}
+
+/* NEUTRON LAYER-MASK RECTS (env NEUTRON_D2D_MASKRECTS, default ON, 0 to disable): scissor
+ * draws inside a layer to the mask's individual rectangles rather than their bounding box. */
+static inline BOOL neutron_maskrects(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        char buf[8];
+        v = (GetEnvironmentVariableA("NEUTRON_D2D_MASKRECTS", buf, sizeof(buf)) && buf[0] == '0') ? 0 : 1;
+    }
+    return v;
+}
+
+/* NEUTRON PERF (env NEUTRON_D2D_PERF=1): time the stages of a DC-direct present. The UI
+ * takes a long road under Wine that it does not take on Windows: D2D draws on the GPU, we
+ * read the result BACK to the CPU (IDXGISurface1::GetDC), blit it into the window surface,
+ * winewayland copies that into shared memory, and the compositor uploads it to the GPU
+ * again. The readback is the suspect -- not for bandwidth but because it makes the CPU wait
+ * for the GPU every frame. Measure before optimising. */
+static inline BOOL neutron_perf(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        char buf[8];
+        v = (GetEnvironmentVariableA("NEUTRON_D2D_PERF", buf, sizeof(buf)) && buf[0] == '1') ? 1 : 0;
+    }
+    return v;
+}
+
+/* NEUTRON API TIMING: total wall time this thread spends INSIDE d2d1, across every public
+ * entry point -- not just the draw path. The timeline paint takes 174ms/frame of which only
+ * ~1ms is in the draw path and ~1ms is the present, so 172ms is either the application's own
+ * code or d2d1 calls nobody timed (geometry creation/tessellation, bitmap uploads, text).
+ * The user's A/B is decisive that this is ours: the SAME project on the SAME machine is
+ * responsive with Premiere's software drawing path and 8fps with the GPU/D2D one.
+ *
+ * Depth-guarded so nested calls are not double counted; uses the cleanup attribute so every
+ * return path is covered. */
+extern int neutron_seg_reject;
+extern int neutron_lazytess_on;      /* alternated per frame for a controlled A/B */
+extern __thread LONGLONG neutron_api_ticks;
+extern __thread int neutron_api_depth;
+
+struct neutron_api_timer { LONGLONG t0; const char *name; };
+
+/* Per-entry-point totals so the report can NAME the call that eats the frame. */
+struct neutron_api_slot
+{
+    const char *name;
+    LONGLONG ticks;
+    unsigned calls;
+    /* Per-FRAME counters, reset at BeginDraw. Averages hide spikes: zooming the timeline
+     * produces occasional 130-175ms frames among 10-18ms ones, and only a dump of the slow
+     * frame itself can say what happened in it. */
+    LONGLONG frame_ticks;
+    unsigned frame_calls;
+};
+extern struct neutron_api_slot neutron_api_slots[512];
+void neutron_api_record(const char *name, LONGLONG ticks);
+void neutron_api_frame_reset(void);
+void neutron_api_dump_slow_frame(HWND hwnd, unsigned w, unsigned h, LONGLONG frame_us);
+
+static inline struct neutron_api_timer neutron_api_begin(const char *name)
+{
+    struct neutron_api_timer t = {0, NULL};
+    LARGE_INTEGER q;
+
+    /* Check the (cached) env flag FIRST so the disabled path touches no thread-local
+     * storage: this macro sits on every one of d2d1's ~773 entry points, and a busy frame
+     * makes six figures of calls. */
+    if (!neutron_perf())
+        return t;
+    t.name = name;
+    if (!neutron_api_depth++)
+    {
+        QueryPerformanceCounter(&q);
+        t.t0 = q.QuadPart;
+    }
+    return t;
+}
+
+static inline void neutron_api_end(struct neutron_api_timer *t)
+{
+    LARGE_INTEGER q;
+
+    if (!t->name)
+        return;
+    if (!--neutron_api_depth && t->t0)
+    {
+        QueryPerformanceCounter(&q);
+        neutron_api_ticks += q.QuadPart - t->t0;
+        neutron_api_record(t->name, q.QuadPart - t->t0);
+    }
+}
+
+#define NEUTRON_API_TIME() \
+    struct neutron_api_timer __neutron_t __attribute__((cleanup(neutron_api_end))) = neutron_api_begin(__func__)
+
+
+/* NEUTRON LAZY TESSELLATION (env NEUTRON_D2D_LAZYTESS, default ON, 0 to disable):
+ * ID2D1GeometrySink::Close resolved self-intersections and triangulated the path immediately,
+ * work that is only ever consumed when the geometry is FILLED. Measured 2026-07-27 while
+ * zooming Premiere's timeline: 386 Close calls on 1k-4k vertex paths cost ~3.9ms EACH (~1.5s
+ * total), plus 76,000 small ones -- 40-65% of every stutter frame, together with
+ * CreateGeometryGroup, which builds a path and closes it internally.
+ *
+ * Much of that is thrown away: a geometry used only as a layer mask, or only stroked, never
+ * needs the tessellation. So do it on first fill instead of at Close.
+ *
+ * Behavioural note: Close no longer returns a tessellation failure; the error surfaces when
+ * the geometry is filled. Nothing in d2d1 reads the tessellation except the fill path
+ * (verified: only d2d_device_context_fill_geometry; FillContainsPoint/ComputeArea/Stroke*
+ * all work from the figures). */
+static inline BOOL neutron_lazytess(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        char buf[8];
+        v = !GetEnvironmentVariableA("NEUTRON_D2D_LAZYTESS", buf, sizeof(buf)) ? 1
+                : buf[0] == '0' ? 0 : buf[0] == '2' ? 2 : 1;
+    }
+    /* NEUTRON_D2D_LAZYTESS=2 -> alternate per frame so one session measures both variants on
+     * the same work. Comparing separate sessions is useless here: the cost depends entirely on
+     * how far the timeline happens to be zoomed. */
+    if (v == 2)
+        return neutron_lazytess_on;
+    return v;
+}
+
+struct d2d_geometry;
+HRESULT d2d_geometry_require_tessellation(struct d2d_geometry *geometry);
+
+/* NEUTRON op-trace (env NEUTRON_D2D_OPTRACE=1): per-frame op/clear log for the timeline
+ * rows -- does the app WIPE its own panel and then draw almost nothing? */
+static inline BOOL neutron_optrace(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        char buf[8];
+        v = (GetEnvironmentVariableA("NEUTRON_D2D_OPTRACE", buf, sizeof(buf)) && buf[0] == '1') ? 1 : 0;
+    }
+    return v;
+}
+
+/* NEUTRON D2D DC-DIRECT: DECISIVE TEST (env NEUTRON_D2D_SKIPBLIT=1). Do everything except
+ * the final blit-back, for the TIMELINE-ROW containers only (wide and short: >=3000 x <=700 --
+ * 3648x604 / 3658x654 in every capture). If the timeline's clips then become VISIBLE, our
+ * blit-back is erasing content some other painter put in that window. If they stay invisible,
+ * we are NOT the eraser and the content is never drawn in the first place (which is what the
+ * earlier RAW backbuffer dump of the timeline row suggested: gray background + scrollbar,
+ * NO clips). Scoped so the rest of the UI keeps working during the test. */
+static inline BOOL neutron_skipblit(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        char buf[8];
+        v = (GetEnvironmentVariableA("NEUTRON_D2D_SKIPBLIT", buf, sizeof(buf)) && buf[0] == '1') ? 1 : 0;
+    }
+    return v;
+}
+
+/* NEUTRON D2D DC-DIRECT CLIP-CHILDREN (env NEUTRON_D2D_CLIPCHILDREN, default ON, 0 to
