 HRESULT d2d_hwnd_render_target_init(struct d2d_hwnd_render_target *render_target, ID2D1Factory1 *factory,
@@ -874,6 +1536,86 @@ HRESULT d2d_hwnd_render_target_init(struct d2d_hwnd_render_target *render_target
     if (render_target->desc.type == D2D1_RENDER_TARGET_TYPE_DEFAULT)
         render_target->desc.type = D2D1_RENDER_TARGET_TYPE_HARDWARE;
 
+    /* NEUTRON D2D DC-DIRECT scope guard (decided ONCE, statically at creation): env
+     * on AND the window is a child/owned UI panel AND RETAIN_CONTENTS. If so, back
+     * this HwndRT with a GDI-compatible bitmap blitted to the window DC (DC-direct,
+     * like Windows) instead of a DXGI swapchain -- so D2D chrome composes with the
+     * window's GDI content in ONE surface. Video (DisplaySurface Present1) and CEF
+     * (cross-proc) are not HwndRTs, so they never reach this guard. On any failure,
+     * fall through to the normal swapchain path (dxgi_factory stays held). */
+    if (neutron_dcdirect()
+            && ((GetWindowLongW(hwnd_rt_desc->hwnd, GWL_STYLE) & WS_CHILD)
+                || GetWindow(hwnd_rt_desc->hwnd, GW_OWNER))
+            && (hwnd_rt_desc->presentOptions & D2D1_PRESENT_OPTIONS_RETAIN_CONTENTS))
+    {
+        IDXGIDevice *dcd_dxgi = NULL;
+        ID2D1Device *dcd_device = NULL;
+        HRESULT dchr;
+
+        dchr = ID3D10Device1_QueryInterface(d3d_device, &IID_IDXGIDevice, (void **)&dcd_dxgi);
+        if (SUCCEEDED(dchr))
+        {
+            dchr = d2d_factory_create_device(factory, dcd_dxgi, false, &IID_ID2D1Device, (void **)&dcd_device);
+            IDXGIDevice_Release(dcd_dxgi);
+        }
+        if (SUCCEEDED(dchr))
+        {
+            dchr = d2d_d3d_create_render_target(unsafe_impl_from_ID2D1Device((ID2D1Device1 *)dcd_device), NULL,
+                    (IUnknown *)&render_target->ID2D1HwndRenderTarget_iface, &d2d_hwnd_render_target_ops,
+                    &dxgi_rt_desc, (void **)&render_target->dxgi_inner);
+            ID2D1Device_Release(dcd_device);
+        }
+        if (SUCCEEDED(dchr))
+            dchr = IUnknown_QueryInterface(render_target->dxgi_inner, &IID_ID2D1RenderTarget,
+                    (void **)&render_target->dxgi_target);
+        if (SUCCEEDED(dchr))
+            dchr = neutron_dcdirect_set_bitmap(render_target,
+                    hwnd_rt_desc->pixelSize.width, hwnd_rt_desc->pixelSize.height);
+        if (SUCCEEDED(dchr))
+        {
+            render_target->d3d_device = d3d_device;
+            ID3D10Device1_AddRef(d3d_device);
+            render_target->dc_direct = 1;
+            IDXGIFactory_Release(dxgi_factory);
+            if (neutron_optrace())
+                ERR("neutron-dr: HwndRT-CREATE hwnd=%p size=%ux%u presentOptions=%#x DC-DIRECT (no swapchain)\n",
+                        render_target->hwnd, hwnd_rt_desc->pixelSize.width, hwnd_rt_desc->pixelSize.height,
+                        hwnd_rt_desc->presentOptions);
+            /* NEUTRON diagnostic (once per container): its clip-relevant style + visible
+             * children. A DC-direct container WITHOUT WS_CLIPCHILDREN blits over every
+             * child listed here -- the prime suspect for the black timeline. */
+            if (neutron_optrace())
+            {
+                HWND hwnd = render_target->hwnd, child;
+                DWORD self = GetCurrentProcessId();
+                int n = 0;
+
+                ERR("neutron-dr: DC-DIRECT hwnd=%p style=%#lx exstyle=%#lx CLIPCHILDREN=%d parent=%p\n",
+                        hwnd, GetWindowLongW(hwnd, GWL_STYLE), GetWindowLongW(hwnd, GWL_EXSTYLE),
+                        !!(GetWindowLongW(hwnd, GWL_STYLE) & WS_CLIPCHILDREN), GetAncestor(hwnd, GA_PARENT));
+                for (child = GetWindow(hwnd, GW_CHILD); child && n < 24; child = GetWindow(child, GW_HWNDNEXT), ++n)
+                {
+                    char cls[64] = {0};
+                    DWORD pid = 0;
+                    RECT wr = {0};
+
+                    GetClassNameA(child, cls, sizeof(cls));
+                    GetWindowThreadProcessId(child, &pid);
+                    if (GetWindowRect(child, &wr))
+                        MapWindowPoints(NULL, hwnd, (POINT *)&wr, 2);
+                    ERR("neutron-dr:   child=%p cls=\"%s\" pid=%lu%s vis=%d rect=(%ld,%ld,%ld,%ld)\n",
+                            child, cls, pid, (pid && pid != self) ? " CROSS-PROC" : "",
+                            IsWindowVisible(child), wr.left, wr.top, wr.right, wr.bottom);
+                }
+            }
+            return S_OK;
+        }
+        WARN("neutron dc-direct setup failed, hr %#lx; falling back to swapchain.\n", dchr);
+        if (render_target->dxgi_target) { ID2D1RenderTarget_Release(render_target->dxgi_target); render_target->dxgi_target = NULL; }
+        if (render_target->dxgi_inner) { IUnknown_Release(render_target->dxgi_inner); render_target->dxgi_inner = NULL; }
+        if (render_target->dxgi_surface) { IDXGISurface1_Release(render_target->dxgi_surface); render_target->dxgi_surface = NULL; }
+    }
+
     swapchain_desc.BufferDesc.Width = hwnd_rt_desc->pixelSize.width;
     swapchain_desc.BufferDesc.Height = hwnd_rt_desc->pixelSize.height;
     swapchain_desc.BufferDesc.RefreshRate.Numerator = 60;
@@ -949,5 +1691,15 @@ HRESULT d2d_hwnd_render_target_init(struct d2d_hwnd_render_target *render_target
         return hr;
     }
 
+    /* NEUTRON DIRTYRECTS de-risk (a): log HwndRT creation with the app-supplied
+     * present options + resolved swap effect. Confirms the ~30 UI chains are
+     * RETAIN_CONTENTS -> SEQUENTIAL BufferCount=1 (partial-redraw intent that wine
