+                                    render_target->hwnd, render_target->pres_n, i, x, y, prev, cur, opname);
+                        neutron_dr_set_point_colour(render_target->dxgi_target, i, cur);
+                    }
+                }
+
+                BitBlt(render_target->frame_hdc, u.left, u.top, u.right - u.left, u.bottom - u.top,
+                        shdc, u.left, u.top, SRCCOPY);   /* drawUnion-clipped, minus bridge child rects */
+                SetRectEmpty(&empty);
+                IDXGISurface1_ReleaseDC(render_target->dxgi_surface, &empty);
+                if (neutron_perf())
+                {
+                    LONGLONG rb;
+
+                    QueryPerformanceCounter(&t2);
+                    rb = t1.QuadPart - t0.QuadPart;
+                    render_target->perf_readback += rb;
+                    render_target->perf_blit += t2.QuadPart - t1.QuadPart;
+                    render_target->perf_total += t2.QuadPart - t0.QuadPart;
+                    if (rb > render_target->perf_worst_readback)
+                        render_target->perf_worst_readback = rb;
+                    if (t2.QuadPart - t0.QuadPart > render_target->perf_worst_total)
