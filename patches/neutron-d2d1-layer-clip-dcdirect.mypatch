-HRESULT d2d_device_init(struct d2d_device *device, ID2D1Factory1 *factory, IDXGIDevice *dxgi_device,
-    bool allow_get_dxgi_device)
+/* NEUTRON SHADER CACHE.
+ *
+ * d2d_device_init ran the HLSL compiler (D3DCompile) over the shape vertex shaders and the
+ * pixel shader EVERY time an ID2D1Device was created. Those shaders are compile-time
+ * constants -- the same four strings, independent of the device -- so the result is always
+ * identical, yet it was recompiled from source for every device.
+ *
+ * That is not academic: ID2D1Factory::CreateWicBitmapRenderTarget creates a fresh device on
+ * every call, and Premiere Pro creates hundreds of WIC bitmap render targets per second while
+ * scrubbing the timeline. Measured 2026-07-27: CreateWicBitmapRenderTarget cost ~60ms per
+ * call (18.0s across 293 calls) and accounted for 95% of the UI's frame time, holding the
+ * timeline at 3-8 fps. The same project is fully responsive with Premiere's software drawing
+ * path, which never touches D2D.
+ *
+ * Compile once per process and hand out references. The blobs are immutable buffers, so
+ * sharing them is safe; each device still releases its own reference. */
+static ID3D10Blob *d2d_cached_shape_vs[ARRAY_SIZE(shape_info)];
+static ID3D10Blob *d2d_cached_shape_ps;
+
+static CRITICAL_SECTION d2d_shader_cache_cs;
+static CRITICAL_SECTION_DEBUG d2d_shader_cache_cs_debug =
+{
+    0, 0, &d2d_shader_cache_cs,
+    {&d2d_shader_cache_cs_debug.ProcessLocksList, &d2d_shader_cache_cs_debug.ProcessLocksList},
+    0, 0, {(DWORD_PTR)(__FILE__ ": d2d_shader_cache_cs")}
+};
+static CRITICAL_SECTION d2d_shader_cache_cs = {&d2d_shader_cache_cs_debug, -1, 0, 0, 0, 0};
+
+static HRESULT d2d_compile_shape_shaders(void)
 {
-    HRESULT hr;
     ID3D10Blob *compiled;
+    unsigned int i;
+    HRESULT hr = S_OK;
 
-    device->ID2D1Device6_iface.lpVtbl = &d2d_device_vtbl;
-    device->refcount = 1;
-    device->factory = factory;
-    ID2D1Factory1_AddRef(device->factory);
-    device->dxgi_device = dxgi_device;
-    IDXGIDevice_AddRef(device->dxgi_device);
-    device->allow_get_dxgi_device = allow_get_dxgi_device;
+    EnterCriticalSection(&d2d_shader_cache_cs);
+    if (d2d_cached_shape_ps)
+        goto done;
 
-    for (unsigned int i = 0; i < ARRAY_SIZE(shape_info); ++i)
+    for (i = 0; i < ARRAY_SIZE(shape_info); ++i)
     {
         const struct shape_info *si = &shape_info[i];
 
+        if (d2d_cached_shape_vs[i])
+            continue;
         if (FAILED(hr = D3DCompile(si->vs_code, si->vs_code_size, si->name, NULL, NULL,
                 "main", "vs_4_0", 0, 0, &compiled, NULL)))
         {
             WARN("Failed to compile shader for shape type %#x, hr %#lx.\n", si->shape_type, hr);
-            return hr;
+            goto done;
         }
-        device->precompiled_shape_vs[i] = compiled;
+        d2d_cached_shape_vs[i] = compiled;
     }
 
     if (FAILED(hr = D3DCompile(shape_ps_code, sizeof(shape_ps_code) - 1, "ps", NULL, NULL,
             "main", "ps_4_0", 0, 0, &compiled, NULL)))
     {
         WARN("Failed to compile the pixel shader, hr %#lx.\n", hr);
+        goto done;
+    }
+    d2d_cached_shape_ps = compiled;
+
+done:
+    LeaveCriticalSection(&d2d_shader_cache_cs);
+    return hr;
+}
+
+HRESULT d2d_device_init(struct d2d_device *device, ID2D1Factory1 *factory, IDXGIDevice *dxgi_device,
+    bool allow_get_dxgi_device)
+{
+    unsigned int i;
+    HRESULT hr;
+
+    device->ID2D1Device6_iface.lpVtbl = &d2d_device_vtbl;
+    device->refcount = 1;
+    device->factory = factory;
+    ID2D1Factory1_AddRef(device->factory);
+    device->dxgi_device = dxgi_device;
+    IDXGIDevice_AddRef(device->dxgi_device);
+    device->allow_get_dxgi_device = allow_get_dxgi_device;
+
+    if (FAILED(hr = d2d_compile_shape_shaders()))
         return hr;
+
+    for (i = 0; i < ARRAY_SIZE(shape_info); ++i)
+    {
+        device->precompiled_shape_vs[i] = d2d_cached_shape_vs[i];
+        ID3D10Blob_AddRef(device->precompiled_shape_vs[i]);
     }
-    device->precompiled_shape_ps = compiled;
+    device->precompiled_shape_ps = d2d_cached_shape_ps;
+    ID3D10Blob_AddRef(device->precompiled_shape_ps);
 
     return S_OK;
 }
