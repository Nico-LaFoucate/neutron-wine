+/* NEUTRON GPU-D2D-UI DIAG (env NEUTRON_D2DUI_DIAG=1): sample the backbuffer the
+ * app just rendered, RIGHT BEFORE Present — this is D2D's true output. Compare to
+ * what the dcomp async timer reads: if present-time HAS-CONTENT but the timer reads
+ * BLACK, the black UI is a read-after-present/DISCARD race, not a D2D render gap.
+ * Inert unless the env var is set. */
+static void neutron_d2dui_present_probe(struct d2d_hwnd_render_target *rt)
+{
+    static int on = -1;
+    ID3D11Texture2D *bb = NULL, *stg = NULL;
+    ID3D11Device *dev = NULL;
+    ID3D11DeviceContext *ctx = NULL;
+    D3D11_TEXTURE2D_DESC desc;
+    D3D11_MAPPED_SUBRESOURCE map;
+    HRESULT hr;
+
+    if (on < 0) { char b[8]; on = (GetEnvironmentVariableA("NEUTRON_D2DUI_DIAG", b, sizeof(b)) && b[0]=='1') ? 1 : 0; }
+    if (!on) return;
+    {
+        static struct { HWND h; int best; } seen[64]; static int n;
+        HWND h = rt->hwnd; int i, slot = -1;
+        for (i = 0; i < n; i++) if (seen[i].h == h) { slot = i; break; }
+        if (slot < 0 && n < 64) { slot = n++; seen[slot].h = h; seen[slot].best = -1; }
+        if (slot < 0 || seen[slot].best >= 3) return; /* stop once this hwnd showed content */
+
+        if (FAILED(IDXGISwapChain_GetBuffer(rt->swapchain, 0, &IID_ID3D11Texture2D, (void **)&bb))) return;
+        ID3D11Texture2D_GetDevice(bb, &dev);
+        if (dev)
+        {
+            ID3D11Device_GetImmediateContext(dev, &ctx);
+            ID3D11Texture2D_GetDesc(bb, &desc);
+            desc.Usage = D3D11_USAGE_STAGING; desc.BindFlags = 0;
+            desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ; desc.MiscFlags = 0;
+            if (ctx && SUCCEEDED(ID3D11Device_CreateTexture2D(dev, &desc, NULL, &stg)))
+            {
+                ID3D11DeviceContext_CopyResource(ctx, (ID3D11Resource *)stg, (ID3D11Resource *)bb);
+                if (SUCCEEDED(hr = ID3D11DeviceContext_Map(ctx, (ID3D11Resource *)stg, 0, D3D11_MAP_READ, 0, &map)))
+                {
+                    const DWORD *row0 = (const DWORD *)map.pData;
+                    UINT W = desc.Width, H = desc.Height, gx, gy;
+                    DWORD ref = ((const DWORD *)((const BYTE *)map.pData + (SIZE_T)(H/2)*map.RowPitch))[W/2];
+                    int dd = 0;
+                    for (gy = 0; gy < 40; gy++)
+                    {
+                        const DWORD *r = (const DWORD *)((const BYTE *)map.pData + (SIZE_T)(H*gy/40)*map.RowPitch);
+                        for (gx = 0; gx < 40; gx++) if (r[W*gx/40] != ref) dd++;
+                    }
+                    (void)row0;
+                    if (dd > seen[slot].best)
+                    {
+                        seen[slot].best = dd;
+                        ERR("neutron-d2dui: PRESENT-TIME hwnd=%p %ux%u center=%08lx densegrid40=%d -> %s\n",
+                            rt->hwnd, W, H, ref, dd, dd >= 3 ? "HAS-CONTENT" : "BLACK/UNIFORM");
+                    }
+                    ID3D11DeviceContext_Unmap(ctx, (ID3D11Resource *)stg, 0);
+                }
+                ID3D11Texture2D_Release(stg);
+            }
+            if (ctx) ID3D11DeviceContext_Release(ctx);
+            ID3D11Device_Release(dev);
+        }
+        ID3D11Texture2D_Release(bb);
+    }
+}
+
+/* NEUTRON D2D DC-DIRECT: (re)create the GDI-compatible target bitmap sized to the
+ * window client and bind it as the device-context target (mirrors dc_render_target
+ * BindDC). Used at creation and on Resize. */
+static HRESULT neutron_dcdirect_set_bitmap(struct d2d_hwnd_render_target *rt, UINT w, UINT h)
+{
+    D2D1_BITMAP_PROPERTIES1 bd;
+    struct d2d_bitmap *bi;
+    IDXGISurface1 *surf;
+    ID2D1DeviceContext *ctx;
+    ID2D1Bitmap *bmp;
+    D2D1_SIZE_U sz;
+    HRESULT hr;
+
+    if (!w || !h)
+        return E_INVALIDARG;
+    if (FAILED(hr = ID2D1RenderTarget_QueryInterface(rt->dxgi_target, &IID_ID2D1DeviceContext, (void **)&ctx)))
+        return hr;
+    ID2D1DeviceContext_SetTarget(ctx, NULL);
+    sz.width = w; sz.height = h;
+    memset(&bd, 0, sizeof(bd));
+    bd.pixelFormat = rt->desc.pixelFormat;
+    bd.bitmapOptions = D2D1_BITMAP_OPTIONS_TARGET | D2D1_BITMAP_OPTIONS_CANNOT_DRAW | D2D1_BITMAP_OPTIONS_GDI_COMPATIBLE;
+    if (FAILED(hr = ID2D1DeviceContext_CreateBitmap(ctx, sz, NULL, 0, &bd, (ID2D1Bitmap1 **)&bmp)))
+    {
+        ID2D1DeviceContext_Release(ctx);
+        return hr;
+    }
+    bi = unsafe_impl_from_ID2D1Bitmap(bmp);
+    if (FAILED(hr = ID3D11Resource_QueryInterface(bi->resource, &IID_IDXGISurface1, (void **)&surf)))
+    {
+        ID2D1Bitmap_Release(bmp);
+        ID2D1DeviceContext_Release(ctx);
+        return hr;
+    }
+    ID2D1DeviceContext_SetTarget(ctx, (ID2D1Image *)bmp);
+    ID2D1Bitmap_Release(bmp);
+    ID2D1DeviceContext_Release(ctx);
+    if (rt->dxgi_surface)
+        IDXGISurface1_Release(rt->dxgi_surface);
+    rt->dxgi_surface = surf;
+    SetRect(&rt->dst_rect, 0, 0, w, h);
+    return S_OK;
+}
+
+/* NEUTRON D2D DC-DIRECT: pre-draw hook (invoked from the device-context BeginDraw).
+ * Grab the window DC and copy its current pixels into the D2D target bitmap so D2D
+ * composes OVER the GDI content (H4). The DC is held until present (H6: balanced
+ * GetDC/ReleaseDC per BeginDraw+present). */
+static void d2d_hwnd_render_target_begindraw(IUnknown *outer_unknown)
+{
+    struct d2d_hwnd_render_target *rt = impl_from_IUnknown(outer_unknown);
+    HDC bhdc;
+
+    if (!rt->dc_direct)
+        return;
+    if (neutron_perf())
+    {
+        LARGE_INTEGER a;
+
+        QueryPerformanceCounter(&a);
+        rt->perf_begin_qpc = a.QuadPart;
+        rt->perf_api_at_begin = neutron_api_ticks;
+        neutron_api_frame_reset();
+        neutron_lazytess_on = !neutron_lazytess_on;
+        rt->perf_lazy_which = neutron_lazytess_on;
+    }
+    /* NEUTRON: a DC-direct container spans its whole client area, INCLUDING the areas
+     * covered by its child windows (the timeline, panels, ...). A plain GetDC() only
+     * clips those out when the window carries WS_CLIPCHILDREN -- without it the
+     * container's blit-back STOMPS every child that draws itself, which is the prime
+     * suspect for the black timeline. DCX_CLIPCHILDREN clips them unconditionally
+     * (and subsumes the CEF/bridge exclude, at zero per-present cost). */
+    if (neutron_perf())
+    {
+        LARGE_INTEGER a, b;
+
+        QueryPerformanceCounter(&a);
+        rt->frame_hdc = neutron_clipchildren() ? GetDCEx(rt->hwnd, NULL, DCX_CACHE | DCX_CLIPCHILDREN)
+                                               : GetDC(rt->hwnd);
+        QueryPerformanceCounter(&b);
+        rt->perf_wdc += b.QuadPart - a.QuadPart;
+    }
+    else
+        rt->frame_hdc = neutron_clipchildren() ? GetDCEx(rt->hwnd, NULL, DCX_CACHE | DCX_CLIPCHILDREN)
+                                               : GetDC(rt->hwnd);
+    /* Full-client compose-read: OFF by default -- ~30 MB/frame on the big containers. */
+    if (neutron_dccomposeread() && rt->frame_hdc && rt->dxgi_surface
+            && SUCCEEDED(IDXGISurface1_GetDC(rt->dxgi_surface, TRUE, &bhdc)))
+    {
+        int w = rt->dst_rect.right - rt->dst_rect.left, h = rt->dst_rect.bottom - rt->dst_rect.top;
+
+        BitBlt(bhdc, 0, 0, w, h, rt->frame_hdc, 0, 0, SRCCOPY);
+        /* NEUTRON probe: does the window actually HAVE content, and did it land in the
+         * target bitmap? Sampling both sides of the copy is the only way to tell a stale
+         * bitmap (we stomp the panel with nothing) from a working compose. */
+        if (neutron_optrace() && w >= 3000 && h <= 700 && !(rt->pres_n % 60))
+        {
+            int xs[4], ys[4], i;
+            char wbuf[128] = {0}, bbuf[128] = {0};
+
+            xs[0] = w / 8;   ys[0] = h / 4;
+            xs[1] = w / 3;   ys[1] = h / 2;
+            xs[2] = w / 2;   ys[2] = h / 3;
+            xs[3] = w * 3/4; ys[3] = h / 2;
+            for (i = 0; i < 4; ++i)
+            {
+                char t[32];
+                sprintf(t, "%06x ", (unsigned)GetPixel(rt->frame_hdc, xs[i], ys[i]) & 0xffffff);
+                strcat(wbuf, t);
+                sprintf(t, "%06x ", (unsigned)GetPixel(bhdc, xs[i], ys[i]) & 0xffffff);
+                strcat(bbuf, t);
+            }
+            ERR("neutron-dr: TLPROBE hwnd=%p f=%u window=[ %s] bitmapAfterRead=[ %s]\n",
+                    rt->hwnd, rt->pres_n, wbuf, bbuf);
+        }
+        IDXGISurface1_ReleaseDC(rt->dxgi_surface, NULL);
+    }
+}
+
+/* NEUTRON D2D DC-DIRECT: a DC-direct container must NOT paint over a CEF/CEP
+ * bridge-delivered descendant. Such descendants are cross-process (the CEF renderer
+ * lives in its own process) and/or carry the plugin/Chrome classes. We ExcludeClipRect
+ * their rects from the container's blit-back so the bridge's content survives -- on
+ * Windows those children composite ON TOP of the container. */
+#define NEUTRON_EXCL_TTL 250   /* ms between rescans of the descendant list */
+
+struct neutron_excl_ctx
+{
+    struct d2d_hwnd_render_target *rt;
+    DWORD self_pid;
+    int log;                       /* emit the one-time per-hwnd diagnostic */
+};
+static BOOL CALLBACK neutron_exclude_bridge_child(HWND child, LPARAM lp)
+{
+    struct neutron_excl_ctx *c = (struct neutron_excl_ctx *)lp;
+    struct d2d_hwnd_render_target *rt = c->rt;
+    char cls[64];
+    DWORD pid = 0;
+    BOOL bridge;
+    RECT wr;
+
+    if (rt->excl_count >= ARRAY_SIZE(rt->excl_rects))
+        return FALSE;
+    if (!IsWindowVisible(child))
+        return TRUE;
+    cls[0] = 0;
+    GetClassNameA(child, cls, sizeof(cls));
+    if (!GetWindowThreadProcessId(child, &pid) || !pid)
+        return TRUE;               /* unknown owner: do NOT treat as a bridge child */
+    bridge = (pid != c->self_pid)
+            || strstr(cls, "Chrome_WidgetWin") || strstr(cls, "PlugPlug") || strstr(cls, "HTMLEXTENSION");
+    if (!bridge)
+        return TRUE;
+    if (!GetWindowRect(child, &wr) || IsRectEmpty(&wr))
+        return TRUE;
+    MapWindowPoints(NULL, rt->hwnd, (POINT *)&wr, 2);   /* screen -> container client */
+    if (!IntersectRect(&wr, &wr, &rt->dst_rect))
+        return TRUE;               /* fully outside this container: nothing to exclude */
+    rt->excl_rects[rt->excl_count++] = wr;
+    if (c->log)
+        ERR("neutron-dr: DC-DIRECT hwnd=%p EXCLUDE child=%p cls=\"%s\" pid=%lu%s rect=(%ld,%ld,%ld,%ld)\n",
+                rt->hwnd, child, cls, pid, pid != c->self_pid ? " CROSS-PROC" : "",
+                wr.left, wr.top, wr.right, wr.bottom);
+    return TRUE;
+}
+
+/* NEUTRON D2D DC-DIRECT: refresh (at most every NEUTRON_EXCL_TTL ms) the cached list of
+ * bridge/CEF descendant rects, then ExcludeClipRect them from the blit-back DC. */
+static int neutron_exclude_bridge_children(struct d2d_hwnd_render_target *rt, HDC hdc)
+{
+    DWORD now = GetTickCount();
+    int i;
+
+    if (!rt->excl_tick || (int)(now - rt->excl_tick) >= NEUTRON_EXCL_TTL)
+    {
+        struct neutron_excl_ctx ctx;
+
+        rt->excl_count = 0;
+        rt->excl_tick = now ? now : 1;
+        if (GetWindow(rt->hwnd, GW_CHILD))
+        {
+            ctx.rt = rt;
+            ctx.self_pid = GetCurrentProcessId();
+            ctx.log = !rt->excl_logged;
+            EnumChildWindows(rt->hwnd, neutron_exclude_bridge_child, (LPARAM)&ctx);
+            if (ctx.log)
+            {
+                rt->excl_logged = 1;
+                ERR("neutron-dr: DC-DIRECT hwnd=%p first exclude scan: %d bridge rect(s)\n",
+                        rt->hwnd, rt->excl_count);
+            }
+        }
+    }
+    for (i = 0; i < rt->excl_count; ++i)
+        ExcludeClipRect(hdc, rt->excl_rects[i].left, rt->excl_rects[i].top,
+                rt->excl_rects[i].right, rt->excl_rects[i].bottom);
+    return rt->excl_count;
+}
+
 static HRESULT d2d_hwnd_render_target_present(IUnknown *outer_unknown)
 {
     struct d2d_hwnd_render_target *render_target = impl_from_IUnknown(outer_unknown);
     HRESULT hr;
 
+    /* NEUTRON D2D DC-DIRECT present: blit the drawn region of the D2D target bitmap
+     * back into the window's paint DC (color_bits) -- NO swapchain, NO Present. The
+     * D2D chrome then composes with the window's GDI content in ONE surface. */
+    if (render_target->dc_direct)
+    {
+        RECT u = {0}; BOOL uv = FALSE;
+
+        /* Present-rate probe: a window presenting at hundreds/s is spinning, not drawing. */
+        if (!render_target->pres_tick0)
+            render_target->pres_tick0 = GetTickCount() | 1;
+        if (neutron_perf() && render_target->perf_n && !(render_target->pres_n % 200))
+        {
+            LARGE_INTEGER f;
+            LONGLONG us;
+
+            QueryPerformanceFrequency(&f);
+            us = f.QuadPart / 1000000;
+            if (us < 1)
+                us = 1;
+            {
+                unsigned prims = 0, draws = 0;
+                LONGLONG in_d2d = 0, worst_prim = 0, api = 0;
+
+                neutron_dr_get_draw_stats(render_target->dxgi_target, &prims, &draws, &in_d2d, &worst_prim);
+                api = render_target->perf_api;
+                if (render_target->perf_lazy_frames[0] && render_target->perf_lazy_frames[1])
+                ERR("neutron-lazy: hwnd=%p %dx%d | LAZY TESSELLATION ON: %lldus avg over %u frames"
+                    " | OFF: %lldus avg over %u frames\n",
+                        render_target->hwnd,
+                        (int)(render_target->dst_rect.right - render_target->dst_rect.left),
+                        (int)(render_target->dst_rect.bottom - render_target->dst_rect.top),
+                        render_target->perf_lazy_ticks[1] / render_target->perf_lazy_frames[1] / us,
+                        render_target->perf_lazy_frames[1],
+                        render_target->perf_lazy_ticks[0] / render_target->perf_lazy_frames[0] / us,
+                        render_target->perf_lazy_frames[0]);
+            ERR("neutron-perf: hwnd=%p %dx%d frames=%u | APP DRAW avg=%lldus worst=%lldus"
+                    " | frame gap avg=%lldus (%llu fps) | GPU draw calls=%u for %u primitives"
+                    " | INSIDE wine d2d1 draw path=%lldus | INSIDE d2d1 ENTIRELY=%lldus/frame (%u%% of the %lldus frame)"
+                    " worst primitive=%lldus\n",
+                        render_target->hwnd,
+                        (int)(render_target->dst_rect.right - render_target->dst_rect.left),
+                        (int)(render_target->dst_rect.bottom - render_target->dst_rect.top),
+                        render_target->perf_frames,
+                        render_target->perf_frames ? render_target->perf_draw / render_target->perf_frames / us : 0,
+                        render_target->perf_worst_draw / us,
+                        render_target->perf_frames ? render_target->perf_gap / render_target->perf_frames / us : 0,
+                        (render_target->perf_gap && render_target->perf_frames)
+                            ? 1000000ull / (unsigned long long)(render_target->perf_gap / render_target->perf_frames / us) : 0,
+                        draws, prims, in_d2d / us,
+                        render_target->perf_frames ? api / render_target->perf_frames / us : 0,
+                        render_target->perf_draw ? (unsigned)(api * 100 / render_target->perf_draw) : 0,
+                        render_target->perf_frames ? render_target->perf_draw / render_target->perf_frames / us : 0,
+                        worst_prim / us);
+                {
+                    unsigned i, j;
+
+                    for (j = 0; j < 8; ++j)
+                    {
+                        unsigned best = 0;
+                        LONGLONG bt = 0;
+
+                        for (i = 0; i < ARRAY_SIZE(neutron_api_slots); ++i)
+                        {
+                            if (neutron_api_slots[i].name && neutron_api_slots[i].ticks > bt)
+                            {
+                                bt = neutron_api_slots[i].ticks;
+                                best = i;
+                            }
+                        }
+                        if (!bt)
+                            break;
+                        ERR("neutron-perf:    #%u %-52s %8lldus in %u calls\n", j + 1,
+                                neutron_api_slots[best].name, bt / us, neutron_api_slots[best].calls);
+                        neutron_api_slots[best].ticks = 0;
+                        neutron_api_slots[best].calls = 0;
+                    }
+                }
+            }
+            ERR("neutron-perf: hwnd=%p %dx%d n=%u | GPU->CPU readback avg=%lldus worst=%lldus"
+                " | blit avg=%lldus | windowDC avg=%lldus | present avg=%lldus worst=%lldus"
+                " | readback share=%u%%\n",
+                    render_target->hwnd,
+                    (int)(render_target->dst_rect.right - render_target->dst_rect.left),
+                    (int)(render_target->dst_rect.bottom - render_target->dst_rect.top),
+                    render_target->perf_n,
+                    render_target->perf_readback / render_target->perf_n / us,
+                    render_target->perf_worst_readback / us,
+                    render_target->perf_blit / render_target->perf_n / us,
+                    render_target->perf_wdc / render_target->perf_n / us,
+                    render_target->perf_total / render_target->perf_n / us,
+                    render_target->perf_worst_total / us,
+                    render_target->perf_total ? (unsigned)(render_target->perf_readback * 100
+                            / render_target->perf_total) : 0);
+        }
+        if (!(++render_target->pres_n % 200))
+        {
+            unsigned int ms = (unsigned int)(GetTickCount() - render_target->pres_tick0);
+            ERR("neutron-dr: DC-DIRECT hwnd=%p presents=%u in %ums (%u/s) blitCoverage=%u%% avgMB/s=%u\n",
+                    render_target->hwnd, render_target->pres_n, ms,
+                    ms ? render_target->pres_n * 1000 / ms : 0,
+                    render_target->client_px
+                        ? (unsigned int)(render_target->union_px * 100 / render_target->client_px) : 0,
+                    ms ? (unsigned int)(render_target->union_px * 4 / 1024 / 1024 * 1000 / ms) : 0);
+        }
+
+        if (neutron_perf())
+        {
+            LARGE_INTEGER now;
+
+            QueryPerformanceCounter(&now);
+            if (render_target->perf_begin_qpc)
+            {
+                LONGLONG d = now.QuadPart - render_target->perf_begin_qpc;
+
+                render_target->perf_draw += d;
+                if (d > render_target->perf_worst_draw)
+                    render_target->perf_worst_draw = d;
+            }
+            render_target->perf_api += neutron_api_ticks - render_target->perf_api_at_begin;
+            if (render_target->perf_begin_qpc)
+            {
+                int w = render_target->perf_lazy_which;
+
+                render_target->perf_lazy_ticks[w] += now.QuadPart - render_target->perf_begin_qpc;
+                render_target->perf_lazy_frames[w]++;
+            }
+            /* Catch the spike frames -- zoom/scroll produces 130-175ms frames among 10-18ms ones. */
+            if (render_target->perf_begin_qpc)
+            {
+                LARGE_INTEGER f;
+                LONGLONG us, frame;
+
+                QueryPerformanceFrequency(&f);
+                us = f.QuadPart / 1000000;
+                if (us < 1)
+                    us = 1;
+                frame = (now.QuadPart - render_target->perf_begin_qpc) / us;
+                if (frame > 40000)
+                    neutron_api_dump_slow_frame(render_target->hwnd,
+                            render_target->dst_rect.right - render_target->dst_rect.left,
+                            render_target->dst_rect.bottom - render_target->dst_rect.top, frame);
+            }
+            if (render_target->perf_last_present)
+                render_target->perf_gap += now.QuadPart - render_target->perf_last_present;
+            render_target->perf_last_present = now.QuadPart;
+            ++render_target->perf_frames;
+        }
+
+        neutron_dr_get_union(render_target->dxgi_target, &u, &uv);
+
+        /* NEUTRON op-trace: for the TIMELINE ROWS, log what the app actually drew this
+         * frame. A frame that CLEARS the panel and then draws a handful of ops is the app
+         * wiping its own content (upstream of us). Capped so the log stays readable. */
+        if (neutron_optrace() && render_target->pres_n < 400
+                && (render_target->dst_rect.right - render_target->dst_rect.left) >= 3000
+                && (render_target->dst_rect.bottom - render_target->dst_rect.top) <= 700)
+        {
+            unsigned ops = 0, clears = 0;
+            char hist[512];
+            RECT cr;
+
+            neutron_dr_get_frame_stats(render_target->dxgi_target, &ops, &clears, &cr);
+            neutron_dr_format_hist(render_target->dxgi_target, hist, sizeof(hist));
+            ERR("neutron-dr: TL hwnd=%p f=%u ops=%u clears=%u union=%s(%ld,%ld,%ld,%ld) | %s\n",
+                    render_target->hwnd, render_target->pres_n, ops, clears, uv ? "" : "INVALID",
+                    u.left, u.top, u.right, u.bottom, hist);
+        }
+        if (uv)
+        {
+            int fw = render_target->dst_rect.right - render_target->dst_rect.left;
+            int fh = render_target->dst_rect.bottom - render_target->dst_rect.top;
+            u.left -= 2; u.top -= 2; u.right += 2; u.bottom += 2;   /* AA fringe */
+            if (u.left < 0) u.left = 0;
+            if (u.top < 0) u.top = 0;
+            if (u.right > fw) u.right = fw;
+            if (u.bottom > fh) u.bottom = fh;
+            if (u.right <= u.left || u.bottom <= u.top) uv = FALSE;
+        }
