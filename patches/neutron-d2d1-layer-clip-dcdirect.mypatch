+            {
+                if (neutron_perf())
+                {
+                    LONGLONG rb;
+
+                    QueryPerformanceCounter(&t2);
+                    rb = t2.QuadPart - t0.QuadPart;
+                    render_target->perf_readback += rb;
+                    render_target->perf_total += rb;
+                    if (rb > render_target->perf_worst_readback)
