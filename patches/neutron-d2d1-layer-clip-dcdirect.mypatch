+            int saved = 0;
+
+            /* Exclude CEF/CEP bridge-delivered (cross-proc) descendant rects so the
+             * container's blit-back does not cover them (fixes home screen/Captioneer
+             * going blank under DC-direct). Cached scan; A/B-able via NEUTRON_D2D_CEFEXCL=0. */
+            if (neutron_cefexcl())
+            {
+                saved = SaveDC(render_target->frame_hdc);
+                neutron_exclude_bridge_children(render_target, render_target->frame_hdc);
+            }
