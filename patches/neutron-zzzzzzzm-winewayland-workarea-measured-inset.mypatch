+/* NEUTRON workarea#1: the LOGICAL height the compositor last granted a MAXIMIZED toplevel
+ * (0 = never measured). display.c reserves a top inset from the monitor's work area so a
+ * maximized Win32 window matches what the compositor will actually accept; that inset used
+ * to be a hardcoded 32-logical-px guess. This is the measured replacement. Read atomically.
+ * See the work-area note in display.c for why a wrong inset makes the window unpaintable. */
+extern LONG neutron_maximized_logical_h;
+/* Report a measured maximized logical height to the DESKTOP process and ask it to rebuild the
+ * display devices. MUST be used instead of a plain global: rc_work is only ever computed in the
+ * desktop process (see display.c), while the measurement can only be taken in whichever process
+ * owns the maximized toplevel -- normally an app. A per-process global never crosses that gap,
+ * so the value rides in the existing WM_WAYLAND_INIT_DISPLAY_DEVICES message. */
+void wayland_report_maximized_logical_h(int logical_h);
 BOOL wayland_surface_config_is_compatible(struct wayland_surface_config *conf,
                                           int width, int height,
                                           enum wayland_surface_config_state state);
