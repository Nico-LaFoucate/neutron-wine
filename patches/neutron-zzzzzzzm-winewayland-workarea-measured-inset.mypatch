+/* NEUTRON workarea#1: hand a MEASURED maximized logical height to the desktop process.
+ *
+ * ⚠️ This deliberately does NOT go through maybe_init_display_devices(): that bails when we are
+ * not the desktop process, and "not the desktop process" is the normal case here. The monitor
+ * list -- and therefore rc_work -- is only ever built in the desktop process (see the note in
+ * display.c), but the measurement can only be taken where the maximized toplevel lives, which is
+ * an app process. A plain per-process global is invisible across that boundary: the desktop
+ * process's copy would stay 0, the guard in display.c would fail, and the inset would silently
+ * fall back to the old 32px estimate -- a no-op that looks exactly like a working fix on any
+ * machine whose compositor happens to reserve 32.
+ *
+ * So carry the value in wparam of the message the desktop process already handles. Caught in
+ * review by the build tester before this was ever built; it could not have been caught on the
+ * dev box, where measured and estimated insets are numerically identical. */
+void wayland_report_maximized_logical_h(int logical_h)
+{
+    HWND desktop_hwnd;
+
+    if (!process_wayland.initialized || logical_h <= 0) return;
+    if (!(desktop_hwnd = NtUserGetDesktopWindow())) return;
+
+    NtUserPostMessage(desktop_hwnd, WM_WAYLAND_INIT_DISPLAY_DEVICES, (WPARAM)logical_h, 0);
+}
+
 static void wayland_output_mode_free_rb(struct rb_entry *entry, void *ctx)
 {
     free(RB_ENTRY_VALUE(entry, struct wayland_output_mode, entry));
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -153,6 +153,35 @@
 
     TRACE("hwnd=%p %dx%d,%#x\n", hwnd, width, height, config_state);
 
+    /* NEUTRON workarea#1: MEASURE what the compositor actually grants a maximized toplevel.
+     *
+     * display.c has to reserve a top inset from the monitor work area, because a maximized
+     * Win32 window is sized to rc_work and the compositor will not accept a surface larger
+     * than the area it configured. That inset used to be a hardcoded 32-logical-px estimate
+     * of the KWin/Breeze titlebar. When the estimate is too LARGE the maximized window comes
+     * out shorter than the configure, wayland_surface_config_is_compatible() then fails on
+     * `height < conf->height` for the rest of the process's life, the surface never commits a
+     * buffer, and the window is a permanent blank rectangle that cannot even be resized.
+     *
+     * Found 2026-08-10 on a build tester's machine: their compositor reserves 30 logical px,
+     * ours reserves 32. The estimate was right here and 2 logical px too big there, which was
+     * enough to make Illustrator unusable while it worked perfectly on the dev box.
+     *
+     * This is the configure that carries the truth: for a MAXIMIZED toplevel, `height` IS the
+     * logical height the compositor is willing to give us. Record it and, when it changes,
+     * ask for a display-devices rebuild so rc_work is recomputed from the measurement instead
+     * of the guess.
+     *
+     * The value must be REPORTED to the desktop process, not merely stored: rc_work is built
+     * only there. The InterlockedExchange below is purely a per-process rate limit, so a stable
+     * compositor posts once rather than on every configure. */
+    if ((config_state & WAYLAND_SURFACE_CONFIG_STATE_MAXIMIZED) && height > 0 &&
+        InterlockedExchange(&neutron_maximized_logical_h, height) != height)
+    {
+        TRACE("neutron-workarea: measured maximized logical height %d\n", height);
+        wayland_report_maximized_logical_h(height);
+    }
+
     if (!(data = wayland_win_data_get(hwnd))) return;
 
     if ((surface = data->wayland_surface) && wayland_surface_is_toplevel(surface))
