+            inset = (int)(((double)logical_inset * mode_h) / logical_h + 0.5); /* -> device px */
         if (inset > 0 && inset < (monitor.rc_work.bottom - monitor.rc_work.top))
             monitor.rc_work.top += inset;
+
+        TRACE("neutron-workarea: logical_h=%d measured=%ld logical_inset=%d device_inset=%d\n",
+              logical_h, (long)measured, logical_inset, inset);
     }
 
