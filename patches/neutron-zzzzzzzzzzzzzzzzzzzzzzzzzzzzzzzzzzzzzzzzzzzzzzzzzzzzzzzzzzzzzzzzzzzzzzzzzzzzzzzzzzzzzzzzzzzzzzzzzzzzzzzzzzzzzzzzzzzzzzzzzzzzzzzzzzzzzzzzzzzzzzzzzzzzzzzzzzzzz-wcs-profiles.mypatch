+/* NEUTRON: the Windows Color System queries, answered from Wine's own profile store: the profiles installed in the
+ * color directory (EnumColorProfiles) and the per-class associations AssociateColorProfileWithDevice records under
+ * HKLM\Software\Microsoft\Windows NT\CurrentVersion\ICM, the same store gdi32's GetICMProfile reads for a display.
+ * Affinity (Canva) builds its color profile lists and picks up the display profile only through these; every call
+ * failed with ERROR_CALL_NOT_IMPLEMENTED. The answers follow the Windows 11 measurement: a device without an associated
+ * profile, and a NULL device, have no default (ERROR_FILE_NOT_FOUND; the caller falls back to
+ * GetStandardColorSpaceProfile), both scopes enumerate the same installed profiles, nobody uses per-user lists.
+ * Wine keeps no per-user association lists, no device-independent defaults and no WCS-format (DMP/CAMP/GMMP) profiles.
+ * NEUTRON_DISABLE_WCS_PROFILES=1 brings back the old answers (ERROR_CALL_NOT_IMPLEMENTED). */
+static BOOL wcs_enabled(void)
+{
+    static int enabled = -1;
+
+    if (enabled == -1)
+    {
+        const char *env = getenv( "NEUTRON_DISABLE_WCS_PROFILES" );
+        enabled = !(env && *env == '1');
+        if (!enabled) WARN( "WCS profile queries disabled by NEUTRON_DISABLE_WCS_PROFILES\n" );
+    }
+    return enabled;
+}
+
+static BOOL wcs_not_implemented(void)
+{
+    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    return FALSE;
+}
+
+/* the device class of a device name: a display's monitor device key, device ID or adapter name, a printer or an
+ * image (scanner) device key; 0 when the name says nothing about its class */
+static DWORD device_class( const WCHAR *name )
+{
+    if (!name) return 0;
+    if (StrStrIW( name, L"{4D36E96E-E325-11CE-BFC1-08002BE10318}" ) || !StrCmpNIW( name, L"\\\\.\\DISPLAY", 11 ) ||
+        !StrCmpNIW( name, L"MONITOR\\", 8 ))
+        return CLASS_MONITOR;
+    if (StrStrIW( name, L"{4D36E979-E325-11CE-BFC1-08002BE10318}" )) return CLASS_PRINTER;
+    if (StrStrIW( name, L"{6BDD1FC6-810F-11D0-BEC7-08002BE2092F}" )) return CLASS_SCANNER;
+    return 0;
+}
+
+static HKEY open_class_key( DWORD class )
+{
+    WCHAR path[MAX_PATH];
+    HKEY key;
+
+    swprintf( path, ARRAY_SIZE(path), L"Software\\Microsoft\\Windows NT\\CurrentVersion\\ICM\\%c%c%c%c",
+              (class >> 24) & 0xff, (class >> 16) & 0xff, (class >> 8) & 0xff, class & 0xff );
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_READ, &key )) return NULL;
+    return key;
+}
+
+/* the default profile of a device class: its first association (what GetICMProfile reports); none without one */
+static BOOL get_class_default_profile( DWORD class, WCHAR *name, DWORD len )
+{
+    DWORD size = len;
+    BOOL ret = FALSE;
+    HKEY key;
+
+    if ((key = open_class_key( class )))
+    {
+        ret = !RegEnumValueW( key, 0, name, &size, NULL, NULL, NULL, NULL );
+        RegCloseKey( key );
+    }
+    return ret;
+}
+
+static BOOL wcs_default_profile( WCS_PROFILE_MANAGEMENT_SCOPE scope, const WCHAR *device, COLORPROFILETYPE type,
+                                 COLORPROFILESUBTYPE subtype, WCHAR *name, DWORD len )
+{
+    DWORD class;
+
+    /* the Windows 11 measurement: an unknown profile type is an invalid parameter; device-independent defaults (NULL
+     * device) exist for the CAMP and GMMP types and the ICC working spaces only, so a NULL device with CPT_DMP or another
+     * ICC subtype is an invalid parameter too; for a device the scope and subtype are not checked */
+    if ((type != CPT_ICC && type != CPT_DMP && type != CPT_CAMP && type != CPT_GMMP) ||
+        (!device && (type == CPT_DMP || (type == CPT_ICC && subtype != CPST_RGB_WORKING_SPACE &&
+                                         subtype != CPST_CUSTOM_WORKING_SPACE))))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    /* Windows names its shipped WCS defaults here (D65.camp, Photo.gmmp); Wine has no WCS-format profiles to name */
+    if (type == CPT_CAMP || type == CPT_GMMP) FIXME( "no WCS (type %d) profiles in Wine's profile store\n", type );
+    /* a device's ICC default is its class's first association (no per-user lists: the same for both scopes). Without
+     * one there is no default, and Wine records no device-independent defaults (WcsSetDefaultColorProfile is a stub):
+     * ERROR_FILE_NOT_FOUND, what Windows answers for a display without an association and for a NULL device without a
+     * default */
+    if (!device || type != CPT_ICC || !(class = device_class( device )) ||
+        !get_class_default_profile( class, name, len ))
+    {
+        TRACE( "no default profile for %s, scope %d type %d subtype %d\n", debugstr_w(device), scope, type, subtype );
+        SetLastError( ERROR_FILE_NOT_FOUND );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL is_profile_file( const WCHAR *name )
+{
+    const WCHAR *ext = PathFindExtensionW( name );
+    return !wcsicmp( ext, L".icm" ) || !wcsicmp( ext, L".icc" );
+}
+
+static BOOL add_profile_name( WCHAR ***names, DWORD *count, DWORD *bytes, const WCHAR *name )
+{
+    WCHAR **tmp, *copy;
+
+    if (!(tmp = realloc( *names, (*count + 1) * sizeof(**names) ))) return FALSE;
+    *names = tmp;
+    if (!(copy = wcsdup( name ))) return FALSE;
+    (*names)[(*count)++] = copy;
+    *bytes += (wcslen( name ) + 1) * sizeof(WCHAR);
+    return TRUE;
+}
+
+static BOOL profile_matches( ENUMTYPEW *record, const WCHAR *name )
+{
+    ENUMTYPEW rest = *record;
+    PROFILEHEADER header;
+
+    if (!header_from_file( name, &header )) return FALSE;
+    if ((record->dwFields & ET_DEVICECLASS) && record->dwDeviceClass != header.phClass) return FALSE;
+    rest.dwFields &= ~(ET_DEVICENAME | ET_DEVICECLASS);
+    return match_profile( &rest, &header );
+}
+
+/* the MULTI_SZ list of profile names for WcsEnumColorProfiles(Size): every installed profile that matches the
+ * record, or with ET_DEVICENAME the profiles associated with that device's class */
+static BOOL wcs_enum_profiles( WCS_PROFILE_MANAGEMENT_SCOPE scope, ENUMTYPEW *record, BYTE *buffer, DWORD size,
+                               DWORD *needed, DWORD *number )
+{
+    WCHAR colordir[MAX_PATH], glob[MAX_PATH + 4], name[MAX_PATH], **names = NULL;
+    DWORD i, len = sizeof(colordir), count = 0, bytes = sizeof(WCHAR);
+    WIN32_FIND_DATAW data;
+    BOOL ret = FALSE;
+    HANDLE find;
+    HKEY key;
+
+    if ((scope != WCS_PROFILE_MANAGEMENT_SCOPE_SYSTEM_WIDE && scope != WCS_PROFILE_MANAGEMENT_SCOPE_CURRENT_USER) ||
+        !record || record->dwSize != sizeof(ENUMTYPEW) || record->dwVersion != ENUM_TYPE_VERSION)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    TRACE( "scope %d fields %#lx device %s class %s profile class %s color space %s\n", scope, record->dwFields,
+           record->dwFields & ET_DEVICENAME ? debugstr_w(record->pDeviceName) : "-",
+           record->dwFields & ET_DEVICECLASS ? debugstr_fourcc(record->dwDeviceClass) : "-",
+           record->dwFields & ET_CLASS ? debugstr_fourcc(record->dwClass) : "-",
+           record->dwFields & ET_DATACOLORSPACE ? debugstr_fourcc(record->dwDataColorSpace) : "-" );
+
+    /* both scopes list the same installed profiles (the Windows 11 measurement); Wine keeps no per-user associations */
+    if (record->dwFields & ET_DEVICENAME)
+    {
+        DWORD class = device_class( record->pDeviceName );
+
+        if (class && (key = open_class_key( class )))
+        {
+            for (i = 0; ; i++)
+            {
+                len = ARRAY_SIZE(name);
+                if (RegEnumValueW( key, i, name, &len, NULL, NULL, NULL, NULL )) break;
+                if (profile_matches( record, name ) && !add_profile_name( &names, &count, &bytes, name )) break;
+            }
+            RegCloseKey( key );
+        }
+        goto done;
+    }
+
+    if (!GetColorDirectoryW( NULL, colordir, &len )) goto exit;
+    swprintf( glob, ARRAY_SIZE(glob), L"%s\\*", colordir );
+    if ((find = FindFirstFileW( glob, &data )) != INVALID_HANDLE_VALUE)
+    {
+        do
+        {
+            if (data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY || !is_profile_file( data.cFileName )) continue;
+            if (!profile_matches( record, data.cFileName )) continue;
+            TRACE( "matching profile: %s\n", debugstr_w(data.cFileName) );
+            if (!add_profile_name( &names, &count, &bytes, data.cFileName )) break;
+        } while (FindNextFileW( find, &data ));
+        FindClose( find );
+    }
+
+done:
+    if (needed) *needed = bytes;
+    if (buffer)
+    {
+        WCHAR *p = (WCHAR *)buffer;
+
+        if (size < bytes)
+        {
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            goto exit;
+        }
+        for (i = 0; i < count; i++)
+        {
+            wcscpy( p, names[i] );
+            p += wcslen( names[i] ) + 1;
+        }
+        *p = 0;
+        if (number) *number = count;
+    }
+    TRACE( "%lu profile(s), %lu bytes\n", count, bytes );
+    ret = TRUE;
+
+exit:
+    for (i = 0; i < count; i++) free( names[i] );
+    free( names );
+    return ret;
+}
+
 /******************************************************************************
  * WcsGetUsePerUserProfiles               [MSCMS.@]
  */
 BOOL WINAPI WcsGetUsePerUserProfiles( const WCHAR* name, DWORD class, BOOL* use_per_user_profile )
 {
-    FIXME( "%s %s %p\n", debugstr_w(name), debugstr_fourcc(class), use_per_user_profile );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return FALSE;
+    TRACE( "%s %s %p\n", debugstr_w(name), debugstr_fourcc(class), use_per_user_profile );
+
+    if (!wcs_enabled()) return wcs_not_implemented();
+    if (!name || !use_per_user_profile ||
+        (class != CLASS_MONITOR && class != CLASS_PRINTER && class != CLASS_SCANNER))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    /* Wine keeps no per-user association lists, nobody can have chosen one */
+    *use_per_user_profile = FALSE;
+    return TRUE;
 }
 
 /******************************************************************************
@@ -1452,9 +1696,32 @@
  */
 BOOL WINAPI WcsEnumColorProfilesSize( WCS_PROFILE_MANAGEMENT_SCOPE scope, ENUMTYPEW *record, DWORD *size )
 {
-    FIXME( "%d %p %p\n", scope, record, size );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return FALSE;
+    TRACE( "%d %p %p\n", scope, record, size );
+
+    if (!wcs_enabled()) return wcs_not_implemented();
+    if (!size)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    return wcs_enum_profiles( scope, record, NULL, 0, size, NULL );
+}
+
+/******************************************************************************
+ * WcsEnumColorProfiles               [MSCMS.@]
+ */
+BOOL WINAPI WcsEnumColorProfiles( WCS_PROFILE_MANAGEMENT_SCOPE scope, ENUMTYPEW *record, BYTE *buffer, DWORD size,
+                                  DWORD *number )
+{
+    TRACE( "%d %p %p %lu %p\n", scope, record, buffer, size, number );
+
+    if (!wcs_enabled()) return wcs_not_implemented();
+    if (!buffer)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    return wcs_enum_profiles( scope, record, buffer, size, NULL, number );
 }
 
 /******************************************************************************
@@ -1464,9 +1731,27 @@
                                        COLORPROFILETYPE type, COLORPROFILESUBTYPE subtype,
                                        DWORD profile_id, DWORD size, LPWSTR name )
 {
-    FIXME( "%d, %s, %d, %d, %lu, %lu, %p\n", scope, debugstr_w(device_name), type, subtype, profile_id, size, name );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return FALSE;
+    WCHAR profile[MAX_PATH];
+    DWORD needed;
+
+    TRACE( "%d, %s, %d, %d, %lu, %lu, %p\n", scope, debugstr_w(device_name), type, subtype, profile_id, size, name );
+
+    if (!wcs_enabled()) return wcs_not_implemented();
+    if (!name)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!wcs_default_profile( scope, device_name, type, subtype, profile, ARRAY_SIZE(profile) )) return FALSE;
+    needed = (wcslen( profile ) + 1) * sizeof(WCHAR);
+    if (size < needed)
+    {
