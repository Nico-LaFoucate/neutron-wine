+/******************************************************************************
+ * WcsCreateIccProfile               [MSCMS.@]
+ */
+HPROFILE WINAPI WcsCreateIccProfile( HPROFILE source, DWORD options )
+{
+    TRACE( "%p, %#lx\n", source, options );
+
+    if (!wcs_enabled())
+    {
+        SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+        return NULL;
+    }
+    /* it makes an ICC profile from a WCS one (DMP + CAMP + GMMP). Every profile Wine opens is an ICC profile, which
+     * Windows refuses (the Windows 11 measurement: NULL, ERROR_INVALID_PARAMETER); Affinity calls it only for a WCS
+     * device model profile */
+    WARN( "%p: not a WCS profile\n", source );
+    SetLastError( ERROR_INVALID_PARAMETER );
+    return NULL;
 }
 
