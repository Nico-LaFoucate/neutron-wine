+/* NEUTRON: Color Management, registered only with NEUTRON_D2D_COLOR_MANAGEMENT=1 (see
+ * neutron_d2d_color_management() in device.c for why it is off by default).
+ * Lightroom (the cloud app) creates this effect while it sets up its
+ * drawing and quits with "CreateD2DDeviceResources failed. HResult: 0x88990028"
+ * (D2DERR_EFFECT_IS_NOT_REGISTERED) when it is missing. Like Unpremultiply it is a registration
+ * stub: it carries the real properties, in Windows' order, so the app can set and read them, and
+ * DrawImage() draws its input unchanged (see neutron_passthrough). No color conversion is done
+ * yet. The enum properties hold Windows' values: rendering intents PERCEPTUAL 0 ..
+ * ABSOLUTE_COLORIMETRIC 3, alpha mode PREMULTIPLIED 1 / STRAIGHT 2, quality PROPER 0 / BEST 1. */
+static const WCHAR color_management_description[] =
+L"<?xml version='1.0'?>                                                          \
+  <Effect>                                                                       \
+    <Property name='DisplayName' type='string' value='Color Management'/>        \
+    <Property name='Author'      type='string' value='The Wine Project'/>        \
+    <Property name='Category'    type='string' value='Stub'/>                    \
+    <Property name='Description' type='string' value='Color Management'/>        \
+    <Inputs >                                                                    \
+      <Input name='Source'/>                                                     \
+    </Inputs>                                                                    \
+    <Property name='SourceColorContext' type='colorcontext' />                   \
+    <Property name='SourceRenderingIntent' type='enum' />                        \
+    <Property name='DestinationColorContext' type='colorcontext' />              \
+    <Property name='DestinationRenderingIntent' type='enum' />                   \
+    <Property name='AlphaMode' type='enum' />                                    \
+    <Property name='Quality' type='enum' />                                      \
+  </Effect>";
+
+struct color_management_properties
+{
+    ID2D1ColorContext *source_color_context;
+    UINT32 source_rendering_intent;
+    ID2D1ColorContext *destination_color_context;
+    UINT32 destination_rendering_intent;
+    UINT32 alpha_mode;
+    UINT32 quality;
+};
+
+EFFECT_PROPERTY_RW(color_management, source_rendering_intent, ENUM)
+EFFECT_PROPERTY_RW(color_management, destination_rendering_intent, ENUM)
+EFFECT_PROPERTY_RW(color_management, alpha_mode, ENUM)
+EFFECT_PROPERTY_RW(color_management, quality, ENUM)
+
+/* The generic helpers copy bytes and know no size for color contexts, so the two context
+ * properties hold a reference of their own: set takes one, get hands one out. */
+static HRESULT color_management_set_context(ID2D1ColorContext **slot, const BYTE *data, UINT32 data_size)
+{
+    ID2D1ColorContext *context;
+
+    if (data_size != sizeof(context))
+        return E_INVALIDARG;
+    memcpy(&context, data, sizeof(context));
+    if (context)
+        ID2D1ColorContext_AddRef(context);
+    if (*slot)
+        ID2D1ColorContext_Release(*slot);
+    *slot = context;
+    return S_OK;
+}
+
+static HRESULT color_management_get_context(ID2D1ColorContext *context, BYTE *data, UINT32 data_size,
+        UINT32 *actual_size)
+{
+    if (actual_size)
+        *actual_size = sizeof(context);
+    if (!data || !data_size)
+        return S_OK;
+    if (data_size < sizeof(context))
+        return E_NOT_SUFFICIENT_BUFFER;
+    if (context)
+        ID2D1ColorContext_AddRef(context);
+    memcpy(data, &context, sizeof(context));
+    return S_OK;
+}
+
+#define COLOR_MANAGEMENT_CONTEXT_PROPERTY(prop) \
+    static HRESULT __stdcall color_management_##prop##_set(IUnknown *iface, const BYTE *data, UINT32 data_size) \
+    { \
+        struct d2d_effect_impl *effect = impl_from_ID2D1EffectImpl((ID2D1EffectImpl *)iface); \
+        struct color_management_properties *props = (struct color_management_properties *)(effect + 1); \
+        return color_management_set_context(&props->prop, data, data_size); \
+    } \
+    static HRESULT __stdcall color_management_##prop##_get(const IUnknown *iface, BYTE *data, \
+            UINT32 data_size, UINT32 *actual_size) \
+    { \
+        struct d2d_effect_impl *effect = impl_from_ID2D1EffectImpl((ID2D1EffectImpl *)iface); \
+        struct color_management_properties *props = (struct color_management_properties *)(effect + 1); \
+        return color_management_get_context(props->prop, data, data_size, actual_size); \
+    }
+
+COLOR_MANAGEMENT_CONTEXT_PROPERTY(source_color_context)
+COLOR_MANAGEMENT_CONTEXT_PROPERTY(destination_color_context)
+
+static const D2D1_PROPERTY_BINDING color_management_bindings[] =
+{
+    { L"SourceColorContext", BINDING_RW(color_management, source_color_context) },
+    { L"SourceRenderingIntent", BINDING_RW(color_management, source_rendering_intent) },
+    { L"DestinationColorContext", BINDING_RW(color_management, destination_color_context) },
+    { L"DestinationRenderingIntent", BINDING_RW(color_management, destination_rendering_intent) },
+    { L"AlphaMode", BINDING_RW(color_management, alpha_mode) },
+    { L"Quality", BINDING_RW(color_management, quality) },
+};
+
+static void color_management_cleanup(struct d2d_effect_impl *effect)
+{
+    struct color_management_properties *props = (struct color_management_properties *)(effect + 1);
+
+    if (props->source_color_context)
+        ID2D1ColorContext_Release(props->source_color_context);
+    if (props->destination_color_context)
+        ID2D1ColorContext_Release(props->destination_color_context);
+}
+
+static HRESULT __stdcall color_management_factory(IUnknown **effect)
+{
+    static const struct color_management_properties properties =
+    {
+        .alpha_mode = 1, /* D2D1_COLORMANAGEMENT_ALPHA_MODE_PREMULTIPLIED */
+    };
+    HRESULT hr;
+
+    if (SUCCEEDED(hr = d2d_effect_create_impl(effect, &properties, sizeof(properties))))
+        impl_from_ID2D1EffectImpl((ID2D1EffectImpl *)*effect)->cleanup = color_management_cleanup;
+    return hr;
+}
