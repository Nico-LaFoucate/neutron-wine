d2d1: Color Management effect (pass-through stub) and color contexts

Lightroom (the cloud app) quit during startup with "Error initializing Lightroom.
CreateD2DDeviceResources failed. HResult: 0x88990028". 0x88990028 is
D2DERR_EFFECT_IS_NOT_REGISTERED, and the only unregistered effect in the log was
CLSID_D2D1ColorManagement ({1a28524c-fdd6-4aa4-ae8f-837eb8267b37}).

- Register Color Management as a stub, the same way as Unpremultiply/Premultiply: its six real
  properties in Windows' order (source/destination color context, both rendering intents, alpha
  mode, quality), so the app can set and read them; the two color-context properties hold their
  own reference. It is added to the neutron_passthrough whitelist, so DrawImage() draws its input
  unchanged. No color conversion is done yet.
- Implement color contexts. All five CreateColorContext* methods returned E_NOTIMPL. A context
  now stores what it was created from (a D2D1_COLOR_SPACE plus an ICC profile, a DXGI color
  space, or a simple profile) and reports it back through ID2D1ColorContext1.
- Both are OFF unless NEUTRON_D2D_COLOR_MANAGEMENT=1, which only the Lightroom (cloud) launch
  profile sets. Premiere, After Effects, Media Encoder, Photoshop and Illustrator all reference
  CLSID_D2D1ColorManagement (aedisplay.dll, dynamic-torqnative.dll, FilmImpact plugins); today
  they get "not registered" and take their own fallback. A pass-through in its place would change
  what they draw, untested. With the switch off, d2d1 behaves exactly as before (same FIXMEs,
  same E_NOTIMPL, same D2DERR_EFFECT_IS_NOT_REGISTERED).

Verified 2026-10-09 in the clean room (fresh HOME, fresh prefix, Lightroom 9.6 installed by
Mud Hut), same prefix and runtime for both arms: switch off, the 0x88990028 dialog and
"Effect id {1a28524c-...} not found", exactly as with 11.10-99; switch on, Lightroom opens its
main window and Adobe's sign-in page.

--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -1593,6 +1593,7 @@
 };
 
 ID2D1Image *d2d_effect_image_get_source(ID2D1Image *iface);
+BOOL neutron_d2d_color_management(void);
 HRESULT d2d_effect_create(struct d2d_device_context *context, const CLSID *effect_id,
         ID2D1Effect **effect);
 void d2d_effect_init_properties(struct d2d_effect *effect, struct d2d_effect_properties *properties);
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -18,6 +18,7 @@
 
 #include <float.h>
 #include "d2d1_private.h"
+#include "wincodec.h"
 #include <d3dcompiler.h>
 
 WINE_DEFAULT_DEBUG_CHANNEL(d2d);
@@ -3948,32 +3949,356 @@
     return hr;
 }
 
+/* NEUTRON: NEUTRON_D2D_COLOR_MANAGEMENT=1 turns on the Color Management effect and color contexts.
+ * OFF by default, set only by the Lightroom (cloud) launch profile. The effect does not convert
+ * colors yet, and Premiere, After Effects, Media Encoder, Photoshop and Illustrator all reference
+ * CLSID_D2D1ColorManagement (aedisplay.dll, dynamic-torqnative.dll, FilmImpact plugins): today
+ * they get "not registered" and take their own fallback, which may do the conversion properly.
+ * Handing them a pass-through instead would change what they draw, untested. When the effect
+ * converts for real, make this the default. */
+BOOL neutron_d2d_color_management(void)
+{
+    static int v = -1;
+    if (v < 0) { const char *e = getenv("NEUTRON_D2D_COLOR_MANAGEMENT"); v = (e && e[0] == '1') ? 1 : 0; }
+    return v;
+}
+
+/* NEUTRON: color contexts. All five CreateColorContext* methods were stubs returning E_NOTIMPL,
+ * so an app that sets up color management could not start (Lightroom hands a source and a
+ * destination context to the Color Management effect). A context only describes a color space:
+ * a D2D1_COLOR_SPACE plus an ICC profile, a DXGI color space, or a simple profile. This object
+ * stores that description and reports it back; nothing converts colors with it yet. */
+struct d2d_color_context
+{
+    ID2D1ColorContext1 ID2D1ColorContext1_iface;
+    LONG refcount;
+
+    ID2D1Factory *factory;
+    D2D1_COLOR_CONTEXT_TYPE type;
+    D2D1_COLOR_SPACE space;
+    DXGI_COLOR_SPACE_TYPE dxgi_color_space;
+    D2D1_SIMPLE_COLOR_PROFILE simple_profile;
+    BYTE *profile;
+    UINT32 profile_size;
+};
+
+static inline struct d2d_color_context *impl_from_ID2D1ColorContext1(ID2D1ColorContext1 *iface)
+{
+    return CONTAINING_RECORD(iface, struct d2d_color_context, ID2D1ColorContext1_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_color_context_QueryInterface(ID2D1ColorContext1 *iface,
+        REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_ID2D1ColorContext1)
+            || IsEqualGUID(iid, &IID_ID2D1ColorContext)
+            || IsEqualGUID(iid, &IID_ID2D1Resource)
+            || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        ID2D1ColorContext1_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_color_context_AddRef(ID2D1ColorContext1 *iface)
+{
+    struct d2d_color_context *context = impl_from_ID2D1ColorContext1(iface);
+    ULONG refcount = InterlockedIncrement(&context->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", iface, refcount);
+    return refcount;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_color_context_Release(ID2D1ColorContext1 *iface)
+{
+    struct d2d_color_context *context = impl_from_ID2D1ColorContext1(iface);
+    ULONG refcount = InterlockedDecrement(&context->refcount);
+
+    TRACE("%p decreasing refcount to %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        ID2D1Factory_Release(context->factory);
+        free(context->profile);
+        free(context);
+    }
+    return refcount;
+}
+
+static void STDMETHODCALLTYPE d2d_color_context_GetFactory(ID2D1ColorContext1 *iface, ID2D1Factory **factory)
+{
+    struct d2d_color_context *context = impl_from_ID2D1ColorContext1(iface);
+
+    TRACE("iface %p, factory %p.\n", iface, factory);
+
+    ID2D1Factory_AddRef(*factory = context->factory);
+}
+
+static D2D1_COLOR_SPACE STDMETHODCALLTYPE d2d_color_context_GetColorSpace(ID2D1ColorContext1 *iface)
+{
+    TRACE("iface %p.\n", iface);
+
+    return impl_from_ID2D1ColorContext1(iface)->space;
+}
+
+static UINT32 STDMETHODCALLTYPE d2d_color_context_GetProfileSize(ID2D1ColorContext1 *iface)
+{
+    TRACE("iface %p.\n", iface);
+
+    return impl_from_ID2D1ColorContext1(iface)->profile_size;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_color_context_GetProfile(ID2D1ColorContext1 *iface, BYTE *profile, UINT32 size)
+{
+    struct d2d_color_context *context = impl_from_ID2D1ColorContext1(iface);
+
+    TRACE("iface %p, profile %p, size %u.\n", iface, profile, size);
+
+    if (size < context->profile_size)
+        return D2DERR_INSUFFICIENT_BUFFER;
+    if (context->profile_size)
+        memcpy(profile, context->profile, context->profile_size);
+    return S_OK;
+}
+
+static D2D1_COLOR_CONTEXT_TYPE STDMETHODCALLTYPE d2d_color_context_GetColorContextType(ID2D1ColorContext1 *iface)
+{
+    TRACE("iface %p.\n", iface);
+
+    return impl_from_ID2D1ColorContext1(iface)->type;
+}
+
+static DXGI_COLOR_SPACE_TYPE STDMETHODCALLTYPE d2d_color_context_GetDXGIColorSpace(ID2D1ColorContext1 *iface)
+{
+    TRACE("iface %p.\n", iface);
+
+    return impl_from_ID2D1ColorContext1(iface)->dxgi_color_space;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_color_context_GetSimpleColorProfile(ID2D1ColorContext1 *iface,
+        D2D1_SIMPLE_COLOR_PROFILE *simple_profile)
+{
+    struct d2d_color_context *context = impl_from_ID2D1ColorContext1(iface);
+
+    TRACE("iface %p, simple_profile %p.\n", iface, simple_profile);
+
+    if (context->type != D2D1_COLOR_CONTEXT_TYPE_SIMPLE)
+        return D2DERR_INVALID_PROPERTY;
+    *simple_profile = context->simple_profile;
+    return S_OK;
+}
+
+static const ID2D1ColorContext1Vtbl d2d_color_context_vtbl =
+{
+    d2d_color_context_QueryInterface,
+    d2d_color_context_AddRef,
+    d2d_color_context_Release,
+    d2d_color_context_GetFactory,
+    d2d_color_context_GetColorSpace,
+    d2d_color_context_GetProfileSize,
+    d2d_color_context_GetProfile,
+    d2d_color_context_GetColorContextType,
+    d2d_color_context_GetDXGIColorSpace,
+    d2d_color_context_GetSimpleColorProfile,
+};
+
+/* Takes ownership of `profile` (malloc'd), also on failure. */
+static HRESULT d2d_color_context_create(struct d2d_device_context *device_context, D2D1_COLOR_CONTEXT_TYPE type,
+        D2D1_COLOR_SPACE space, DXGI_COLOR_SPACE_TYPE dxgi_color_space, BYTE *profile, UINT32 profile_size,
+        const D2D1_SIMPLE_COLOR_PROFILE *simple_profile, ID2D1ColorContext1 **color_context)
+{
+    struct d2d_color_context *object;
+
+    if (!(object = calloc(1, sizeof(*object))))
+    {
+        free(profile);
+        return E_OUTOFMEMORY;
+    }
+
+    object->ID2D1ColorContext1_iface.lpVtbl = &d2d_color_context_vtbl;
+    object->refcount = 1;
+    ID2D1Factory_AddRef(object->factory = device_context->factory);
+    object->type = type;
+    object->space = space;
+    object->dxgi_color_space = dxgi_color_space;
+    object->profile = profile;
+    object->profile_size = profile_size;
+    if (simple_profile)
+        object->simple_profile = *simple_profile;
+
+    TRACE("Created color context %p, type %u, space %u, dxgi color space %u, profile size %u.\n",
+            object, type, space, dxgi_color_space, profile_size);
+    *color_context = &object->ID2D1ColorContext1_iface;
+    return S_OK;
+}
+
+/* The DXGI color space a D2D1_COLOR_SPACE context reports: sRGB and scRGB have one, an ICC
+ * profile does not. */
+static DXGI_COLOR_SPACE_TYPE d2d_color_space_to_dxgi(D2D1_COLOR_SPACE space)
+{
+    switch (space)
+    {
+        case D2D1_COLOR_SPACE_SRGB: return DXGI_COLOR_SPACE_RGB_FULL_G22_NONE_P709;
+        case D2D1_COLOR_SPACE_SCRGB: return DXGI_COLOR_SPACE_RGB_FULL_G10_NONE_P709;
+        default: return DXGI_COLOR_SPACE_CUSTOM;
+    }
+}
+
+static HRESULT d2d_color_context_create_icc(struct d2d_device_context *device_context, D2D1_COLOR_SPACE space,
+        BYTE *profile, UINT32 profile_size, ID2D1ColorContext **color_context)
+{
+    return d2d_color_context_create(device_context, D2D1_COLOR_CONTEXT_TYPE_ICC, space,
+            d2d_color_space_to_dxgi(space), profile, profile_size, NULL, (ID2D1ColorContext1 **)color_context);
+}
+
 static HRESULT STDMETHODCALLTYPE d2d_device_context_CreateColorContext(ID2D1DeviceContext6 *iface,
         D2D1_COLOR_SPACE space, const BYTE *profile, UINT32 profile_size, ID2D1ColorContext **color_context)
 {
     NEUTRON_API_TIME();
-    FIXME("iface %p, space %#x, profile %p, profile_size %u, color_context %p stub!\n",
+    struct d2d_device_context *context = impl_from_ID2D1DeviceContext(iface);
+    BYTE *copy = NULL;
+
+    if (!neutron_d2d_color_management())
+    {
+        FIXME("iface %p, space %#x, profile %p, profile_size %u, color_context %p stub!\n",
+                iface, space, profile, profile_size, color_context);
+        return E_NOTIMPL;
+    }
+
+    TRACE("iface %p, space %#x, profile %p, profile_size %u, color_context %p.\n",
             iface, space, profile, profile_size, color_context);
 
-    return E_NOTIMPL;
+    if (!color_context)
+        return E_POINTER;
+    *color_context = NULL;
+
+    switch (space)
+    {
+        case D2D1_COLOR_SPACE_CUSTOM:
+            if (!profile || !profile_size)
+                return E_INVALIDARG;
+            if (!(copy = malloc(profile_size)))
+                return E_OUTOFMEMORY;
+            memcpy(copy, profile, profile_size);
+            break;
+        case D2D1_COLOR_SPACE_SRGB:
+        case D2D1_COLOR_SPACE_SCRGB:
+            /* The space defines the colors; a profile passed along with it is not used. */
+            profile_size = 0;
+            break;
+        default:
+            WARN("Invalid color space %#x.\n", space);
+            return E_INVALIDARG;
+    }
+
+    return d2d_color_context_create_icc(context, space, copy, profile_size, color_context);
 }
 
 static HRESULT STDMETHODCALLTYPE d2d_device_context_CreateColorContextFromFilename(ID2D1DeviceContext6 *iface,
         const WCHAR *filename, ID2D1ColorContext **color_context)
 {
     NEUTRON_API_TIME();
-    FIXME("iface %p, filename %s, color_context %p stub!\n", iface, debugstr_w(filename), color_context);
+    struct d2d_device_context *context = impl_from_ID2D1DeviceContext(iface);
+    DWORD size, read;
+    BYTE *profile;
+    HANDLE file;
 
-    return E_NOTIMPL;
+    if (!neutron_d2d_color_management())
+    {
+        FIXME("iface %p, filename %s, color_context %p stub!\n", iface, debugstr_w(filename), color_context);
+        return E_NOTIMPL;
+    }
+
+    TRACE("iface %p, filename %s, color_context %p.\n", iface, debugstr_w(filename), color_context);
+
+    if (!color_context)
+        return E_POINTER;
+    *color_context = NULL;
+    if (!filename)
+        return E_INVALIDARG;
+
+    file = CreateFileW(filename, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    if (file == INVALID_HANDLE_VALUE)
+        return HRESULT_FROM_WIN32(GetLastError());
+    if ((size = GetFileSize(file, NULL)) == INVALID_FILE_SIZE || !size)
+    {
+        CloseHandle(file);
+        return E_INVALIDARG;
+    }
+    if (!(profile = malloc(size)))
+    {
+        CloseHandle(file);
+        return E_OUTOFMEMORY;
+    }
+    if (!ReadFile(file, profile, size, &read, NULL) || read != size)
+    {
+        HRESULT hr = HRESULT_FROM_WIN32(GetLastError());
+
+        CloseHandle(file);
+        free(profile);
+        return FAILED(hr) ? hr : E_FAIL;
+    }
+    CloseHandle(file);
+
+    return d2d_color_context_create_icc(context, D2D1_COLOR_SPACE_CUSTOM, profile, size, color_context);
 }
 
 static HRESULT STDMETHODCALLTYPE d2d_device_context_CreateColorContextFromWicColorContext(ID2D1DeviceContext6 *iface,
         IWICColorContext *wic_color_context, ID2D1ColorContext **color_context)
 {
     NEUTRON_API_TIME();
-    FIXME("iface %p, wic_color_context %p, color_context %p stub!\n", iface, wic_color_context, color_context);
+    struct d2d_device_context *context = impl_from_ID2D1DeviceContext(iface);
+    WICColorContextType type;
+    UINT size = 0, exif;
+    BYTE *profile;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    if (!neutron_d2d_color_management())
+    {
+        FIXME("iface %p, wic_color_context %p, color_context %p stub!\n", iface, wic_color_context, color_context);
+        return E_NOTIMPL;
+    }
+
+    TRACE("iface %p, wic_color_context %p, color_context %p.\n", iface, wic_color_context, color_context);
+
+    if (!color_context)
+        return E_POINTER;
+    *color_context = NULL;
+    if (!wic_color_context)
+        return E_INVALIDARG;
+
+    if (FAILED(hr = IWICColorContext_GetType(wic_color_context, &type)))
+        return hr;
+
+    if (type == WICColorContextExifColorSpace)
+    {
+        if (FAILED(hr = IWICColorContext_GetExifColorSpace(wic_color_context, &exif)))
+            return hr;
+        /* EXIF color space 1 is sRGB. Anything else is described only by a number. */
+        return d2d_color_context_create_icc(context, exif == 1 ? D2D1_COLOR_SPACE_SRGB : D2D1_COLOR_SPACE_CUSTOM,
+                NULL, 0, color_context);
+    }
+
+    if (FAILED(hr = IWICColorContext_GetProfileBytes(wic_color_context, 0, NULL, &size)))
+        return hr;
+    if (!size)
+        return E_INVALIDARG;
+    if (!(profile = malloc(size)))
+        return E_OUTOFMEMORY;
+    if (FAILED(hr = IWICColorContext_GetProfileBytes(wic_color_context, size, profile, &size)))
+    {
+        free(profile);
+        return hr;
+    }
+
+    return d2d_color_context_create_icc(context, D2D1_COLOR_SPACE_CUSTOM, profile, size, color_context);
 }
 
