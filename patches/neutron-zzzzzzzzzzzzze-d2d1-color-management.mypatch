+        case DXGI_COLOR_SPACE_RGB_FULL_G10_NONE_P709: space = D2D1_COLOR_SPACE_SCRGB; break;
+        default: space = D2D1_COLOR_SPACE_CUSTOM; break;
+    }
+
+    return d2d_color_context_create(context, D2D1_COLOR_CONTEXT_TYPE_DXGI, space, color_space,
+            NULL, 0, NULL, color_context);
 }
 
