--- a/dlls/winewayland.drv/opengl.c
+++ b/dlls/winewayland.drv/opengl.c
@@ -155,9 +155,21 @@
 static BOOL wayland_drawable_swap(struct opengl_drawable *base)
 {
     struct wayland_gl_drawable *gl = impl_from_opengl_drawable(base);
+    /* NEUTRON: a swap to a window Wayland isn't showing must not wait for Wayland. With a swap interval the EGL
+     * driver waits for the frame callback of the previous swap, and a hidden window's surface is detached
+     * (wayland_client_surface_update), so it never gets one: the second swap blocked forever. Illustrator 2026
+     * 30.6 (OpenGL renderer, GPU Performance on) draws a new document while its window is still hidden, as it
+     * does on Windows, and froze there. Windows never holds a present to a hidden window, so such swaps go out
+     * with interval 0 and the window's interval is restored after. Kill switch NEUTRON_GL_HIDDEN_NOWAIT=0. */
+    static int nowait = -1;
+    BOOL hidden;
 
+    if (nowait < 0) nowait = neutron_gate("NEUTRON_GL_HIDDEN_NOWAIT", TRUE);
     client_surface_present(base->client);
+    hidden = nowait && base->interval && !wayland_client_surface_is_attached(base->client);
+    if (hidden) funcs->p_eglSwapInterval(egl->display, 0);
     funcs->p_eglSwapBuffers(egl->display, gl->base.surface);
+    if (hidden) funcs->p_eglSwapInterval(egl->display, abs(base->interval));
 
     return TRUE;
 }
