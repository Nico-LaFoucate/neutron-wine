+/* NEUTRON: whether the window's client surface is in Wayland right now, as a subsurface of its toplevel (kept mapped
+ * below it counts). wayland_client_surface_update detaches a hidden window's surface, and a detached surface gets no
+ * frame callbacks. Takes win_data_mutex only: no user-lock calls inside. */
+BOOL wayland_client_surface_is_attached(struct client_surface *client)
+{
+    struct wayland_client_surface *surface = impl_from_client_surface(client);
+    struct wayland_win_data *data;
+    BOOL attached;
+
+    if (!(data = wayland_win_data_get(client->hwnd))) return FALSE;
+    attached = surface->wl_subsurface != NULL;
+    wayland_win_data_release(data);
+    return attached;
+}
+
