  * Returns TRUE if a list was installed. Conservative: any non-rectangle member, a non-WINDING
  * fill mode, more pieces than we hold, or ANY overlap between pieces (which would blend a
  * translucent draw twice) leaves the list empty and the bounding-box clip in force. */
+
+/* ---- NEUTRON GEOMETRIC LAYER MASKS (stencil) -------------------------------
+ *
+ * wine clipped a layer to its mask's BOUNDING BOX, refining that box only when
+ * the mask was a geometry group of plain rectangles. Every other mask shape --
+ * rounded rect, ellipse, path -- was therefore not applied at all: a rounded
+ * mask rounded nothing, and content kept its square corners. Rasterise the mask
+ * into a stencil buffer instead and stencil-test subsequent draws, which is
+ * shape-agnostic rather than one more special case. */
+
+static void d2d_device_context_release_stencil(struct d2d_device_context *context)
+{
+    if (context->stencil_dsv) { ID3D11DepthStencilView_Release(context->stencil_dsv); context->stencil_dsv = NULL; }
+    if (context->stencil_tex) { ID3D11Texture2D_Release(context->stencil_tex); context->stencil_tex = NULL; }
+    context->stencil_w = context->stencil_h = 0;
+}
+
+static BOOL d2d_device_context_ensure_stencil(struct d2d_device_context *context)
+{
+    D3D11_DEPTH_STENCIL_DESC dsd;
+    D3D11_TEXTURE2D_DESC td;
+    D3D11_BLEND_DESC bd;
+    HRESULT hr;
+
+    if (!context->target.bitmap)
+        return FALSE;
+
+    if (context->stencil_dsv
+            && context->stencil_w == context->pixel_size.width
+            && context->stencil_h == context->pixel_size.height)
+        return TRUE;
+
+    d2d_device_context_release_stencil(context);
+
+    memset(&td, 0, sizeof(td));
+    td.Width = context->pixel_size.width;
+    td.Height = context->pixel_size.height;
+    td.MipLevels = 1;
+    td.ArraySize = 1;
+    td.Format = DXGI_FORMAT_D24_UNORM_S8_UINT;
+    td.SampleDesc.Count = 1;
+    td.Usage = D3D11_USAGE_DEFAULT;
+    td.BindFlags = D3D11_BIND_DEPTH_STENCIL;
+    if (!td.Width || !td.Height)
+        return FALSE;
+    if (FAILED(hr = ID3D11Device1_CreateTexture2D(context->d3d_device, &td, NULL, &context->stencil_tex)))
+    {
+        WARN("Failed to create stencil texture, hr %#lx.\n", hr);
+        return FALSE;
+    }
+    if (FAILED(hr = ID3D11Device1_CreateDepthStencilView(context->d3d_device,
+            (ID3D11Resource *)context->stencil_tex, NULL, &context->stencil_dsv)))
+    {
+        WARN("Failed to create stencil view, hr %#lx.\n", hr);
+        d2d_device_context_release_stencil(context);
+        return FALSE;
+    }
+    context->stencil_w = td.Width;
+    context->stencil_h = td.Height;
+
+    if (!context->dss_incr)
+    {
+        memset(&dsd, 0, sizeof(dsd));
+        dsd.DepthEnable = FALSE;
+        dsd.DepthWriteMask = D3D11_DEPTH_WRITE_MASK_ZERO;
+        dsd.DepthFunc = D3D11_COMPARISON_ALWAYS;
+        dsd.StencilEnable = TRUE;
+        dsd.StencilReadMask = 0xff;
+        dsd.StencilWriteMask = 0xff;
+        dsd.FrontFace.StencilFailOp = D3D11_STENCIL_OP_KEEP;
+        dsd.FrontFace.StencilDepthFailOp = D3D11_STENCIL_OP_KEEP;
+        dsd.FrontFace.StencilPassOp = D3D11_STENCIL_OP_INCR_SAT;
+        dsd.FrontFace.StencilFunc = D3D11_COMPARISON_ALWAYS;
+        dsd.BackFace = dsd.FrontFace;
+        if (FAILED(ID3D11Device1_CreateDepthStencilState(context->d3d_device, &dsd, &context->dss_incr)))
+            goto fail;
+
+        dsd.FrontFace.StencilPassOp = D3D11_STENCIL_OP_DECR_SAT;
+        dsd.BackFace = dsd.FrontFace;
+        if (FAILED(ID3D11Device1_CreateDepthStencilState(context->d3d_device, &dsd, &context->dss_decr)))
+            goto fail;
+
+        /* Content draws: pass only where the pixel is inside every enclosing
+         * mask, i.e. where the stencil equals the masked-layer depth. */
+        dsd.StencilWriteMask = 0;
+        dsd.FrontFace.StencilPassOp = D3D11_STENCIL_OP_KEEP;
+        dsd.FrontFace.StencilFunc = D3D11_COMPARISON_EQUAL;
+        dsd.BackFace = dsd.FrontFace;
+        if (FAILED(ID3D11Device1_CreateDepthStencilState(context->d3d_device, &dsd, &context->dss_test)))
+            goto fail;
+    }
+
+    if (!context->bs_no_color)
+    {
+        memset(&bd, 0, sizeof(bd));
+        bd.RenderTarget[0].BlendEnable = FALSE;
+        bd.RenderTarget[0].RenderTargetWriteMask = 0;   /* stencil only, no colour */
+        if (FAILED(ID3D11Device1_CreateBlendState(context->d3d_device, &bd, &context->bs_no_color)))
+            goto fail;
+    }
+
+    return TRUE;
+
+fail:
+    d2d_device_context_release_stencil(context);
+    return FALSE;
+}
+
+static void d2d_device_context_fill_geometry(struct d2d_device_context *render_target,
+        const struct d2d_geometry *geometry, struct d2d_brush *brush, struct d2d_brush *opacity_brush);
+
+/* Rasterise one mask geometry into the stencil buffer, incrementing (push) or
+ * decrementing (pop) its covered area. Colour writes are masked off. */
+static BOOL d2d_device_context_stencil_mask(struct d2d_device_context *context,
+        ID2D1Geometry *mask, const D2D1_MATRIX_3X2_F *mask_transform, int op)
+{
+    const struct d2d_geometry *mask_impl;
+    D2D1_MATRIX_3X2_F saved;
+    struct d2d_brush *brush_impl;
+
+    if (!d2d_device_context_ensure_stencil(context))
+        return FALSE;
+
+    if (!context->stencil_brush)
+    {
+        D2D1_COLOR_F c = {1.0f, 1.0f, 1.0f, 1.0f};
+
+        if (FAILED(ID2D1DeviceContext6_CreateSolidColorBrush(&context->ID2D1DeviceContext6_iface,
+                &c, NULL, &context->stencil_brush)))
+            return FALSE;
+    }
+
+    mask_impl = unsafe_impl_from_ID2D1Geometry(mask);
+    if (!mask_impl)
+        return FALSE;
+
+    /* The mask is specified in the space the layer was pushed in; fold its own
+     * transform into the world transform for the duration of the rasterisation. */
+    saved = context->drawing_state.transform;
+    if (mask_transform)
+    {
+        D2D1_MATRIX_3X2_F m = *mask_transform;
+
+        d2d_matrix_multiply(&m, &saved);
+        context->drawing_state.transform = m;
+    }
+
+    brush_impl = unsafe_impl_from_ID2D1Brush((ID2D1Brush *)context->stencil_brush);
+    context->stencil_op = op;
+    d2d_device_context_fill_geometry(context, mask_impl, brush_impl, NULL);
+    context->stencil_op = 0;
+
+    context->drawing_state.transform = saved;
+    return TRUE;
+}
