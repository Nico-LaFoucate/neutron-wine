+    /* Refine the box to the mask's actual rectangles where we can; anything else
+     * goes through the stencil, which handles any shape. */
+    /* push_layer_clip runs BEFORE layer_depth is incremented -- the existing code
+     * above indexes layer_clipped[layer_depth] for the same reason -- so this
+     * layer's slot is layer_depth, not layer_depth - 1. */
+    if (mask && !d2d_device_context_install_mask_rects(context, mask, mask_transform)
+            && context->layer_depth < ARRAY_SIZE(context->layer_mask))
+    {
+        if (d2d_device_context_stencil_mask(context, mask, mask_transform, +1))
+        {
+            unsigned idx = context->layer_depth;
+            static LONG logged;
+
+            if (InterlockedIncrement(&logged) <= 200)
+                ERR("neutron-stencilmask: non-rectangular layer mask rasterised, "
+                    "bounds=%.1f,%.1f,%.1f,%.1f depth=%u\n",
+                    bounds.left, bounds.top, bounds.right, bounds.bottom, context->layer_depth);
+
+            ID2D1Geometry_AddRef(context->layer_mask[idx].mask = mask);
+            context->layer_mask[idx].transform = mask_transform ? *mask_transform : identity;
+            ++context->stencil_depth;
+        }
+    }
 }
 
