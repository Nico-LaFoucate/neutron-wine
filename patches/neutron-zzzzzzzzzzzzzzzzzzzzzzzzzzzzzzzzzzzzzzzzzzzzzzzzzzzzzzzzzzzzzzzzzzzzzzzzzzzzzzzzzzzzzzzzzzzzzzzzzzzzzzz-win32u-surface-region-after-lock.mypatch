win32u: apply a window's surface regions after the user lock

update_surface_region() set the shape and clip with the user lock held, twice
over from apply_window_pos(). Setting the shape takes surface->mutex and flushes
into the driver, and winewayland calls back into win32u with its own
win_data_mutex held, so one thread went user_lock -> win_data_mutex while another
went win_data_mutex -> user_lock.

Illustrator 30.6 hung at startup that way, 2 of 22 launches, read live with gdb:
the main thread owned user_mutex in NtUserSetWindowPos -> window_surface_set_shape
-> flush -> wayland_win_data_get; a second thread owned win_data_mutex in
WAYLAND_WindowPosChanged and waited on user_mutex. A thread pool worker exiting
with the loader lock waited behind them, so every other thread piled up on
loader_section.

Read the regions under the lock and apply them after it, and call this after
release_win_ptr() in apply_window_pos(). It was the only place in win32u touching
a surface under the user lock. NEUTRON_REGION_AFTER_LOCK=0 turns it off.

--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -2632,15 +2632,26 @@
 
 /***********************************************************************
  *           update_surface_region
+ *
+ * NEUTRON: the regions are read under the user lock and applied after it. Setting them takes
+ * surface->mutex and flushes into the driver, and winewayland calls back into win32u holding its
+ * own win_data_mutex, so applying them here was user_lock -> win_data_mutex on one thread against
+ * win_data_mutex -> user_lock on another. Illustrator 30.6 hung at startup that way (2 of 22
+ * launches): the main thread in NtUserSetWindowPos -> window_surface_set_shape -> flush, a second
+ * thread in WAYLAND_WindowPosChanged, and a thread pool worker exiting with the loader lock, stuck
+ * behind them on the user lock, so every other thread piled up on loader_section.
  */
 static void update_surface_region( HWND hwnd )
 {
     WND *win = get_win_ptr( hwnd );
-    HRGN region, shape = 0;
+    struct window_surface *surface = NULL;
+    HRGN region, shape = 0, clip = 0;
+    BOOL set_shape = FALSE, set_clip = FALSE;
     RECT visible;
 
     if (!win || win == WND_DESKTOP || win == WND_OTHER_PROCESS) return;
     if (!win->surface) goto done;
+    window_surface_add_ref( (surface = win->surface) );
 
     /* NEUTRON window-tree-shm: a top-level window with no window region and no custom pixel format in it or its
      * children: the server's surface region is its visible rect when it is visible, nothing otherwise
@@ -2650,8 +2661,6 @@
         if (neutron_tree_shm() && win->parent == get_desktop_window() &&
             get_shared_window_shape( hwnd, &has_region, &pixel_format ) && !has_region && !pixel_format)
         {
-            HRGN clip = 0;
-
             if (win->dwStyle & WS_VISIBLE)
                 clip = NtGdiCreateRectRgn( 0, 0, win->rects.visible.right - win->rects.visible.left,
                                            win->rects.visible.bottom - win->rects.visible.top );
@@ -2672,9 +2681,7 @@
                 }
                 if (check) NtGdiDeleteObjectApp( check );
             }
-            window_surface_set_shape( win->surface, 0 );
-            window_surface_set_clip( win->surface, clip );
-            if (clip) NtGdiDeleteObjectApp( clip );
+            set_shape = set_clip = TRUE;
             goto done;
         }
     }
@@ -2687,21 +2694,25 @@
         if (win->dwExStyle & WS_EX_LAYOUTRTL) NtUserMirrorRgn( hwnd, shape );
         NtGdiDeleteObjectApp( region );
     }
-    window_surface_set_shape( win->surface, shape );
+    set_shape = TRUE;
 
     if (get_window_region( hwnd, TRUE, &region, &visible )) goto done;
-    if (!region) window_surface_set_clip( win->surface, shape );
+    set_clip = TRUE;
+    if (!region) clip = shape;
     else
     {
         NtGdiOffsetRgn( region, -visible.left, -visible.top );
         if (shape) NtGdiCombineRgn( region, region, shape, RGN_AND );
-        window_surface_set_clip( win->surface, region );
-        NtGdiDeleteObjectApp( region );
+        clip = region;
     }
 
 done:
-    if (shape) NtGdiDeleteObjectApp( shape );
     release_win_ptr( win );
+    if (set_shape) window_surface_set_shape( surface, shape );
+    if (set_clip) window_surface_set_clip( surface, clip );
+    if (clip && clip != shape) NtGdiDeleteObjectApp( clip );
+    if (shape) NtGdiDeleteObjectApp( shape );
+    if (surface) window_surface_release( surface );
 }
 
 
@@ -3013,6 +3024,17 @@
  * copied one. Windows never shows a resized window blank: the contents follow the window. Lightroom Classic's Masks
  * panel resizes three times per Select Subject, and frame dumps show a whole-panel blank frame each time.
  * Copy first, then update the shape (and flush). Kill switch NEUTRON_COPY_BEFORE_SHAPE=0. */
+static BOOL neutron_region_after_lock(void)
+{
+    static int on = -1;
+    if (on < 0)
+    {
+        const char *e = getenv( "NEUTRON_REGION_AFTER_LOCK" );
+        on = !(e && e[0] == '0');
+    }
+    return on;
+}
+
 static BOOL neutron_copy_visible_only(void)  /* NEUTRON copy-visible-bits-only; kill switch NEUTRON_COPY_VISIBLE_ONLY=0 */
 {
     static int on = -1;
@@ -3047,7 +3069,7 @@
     UINT raw_dpi, monitor_dpi, dpi = get_thread_dpi();
     UINT old_raw_dpi = 0; /* NEUTRON: window's monitor raw dpi before the move (for WM_DPICHANGED) */
     HMONITOR monitor_override;  /* NEUTRON: driver-authoritative monitor, or 0 */
-    BOOL ret, is_layered, is_child, need_icons = FALSE;
+    BOOL ret, is_layered, is_child, need_icons = FALSE, update_region = FALSE;
     struct window_rects old_rects;
     RECT extra_rects[3];
     struct window_surface *old_surface;
@@ -3168,7 +3190,12 @@
         /* NEUTRON fresh-surface-no-blank: when the window got a NEW surface, update_surface_region() (which
          * flushes, window_surface_set_shape) runs below, after the old bits are copied into it. */
         if (old_surface == new_surface || !old_surface || !valid_rects || !neutron_copy_before_shape())
-            update_surface_region( surface_win );
+        {
+            /* NEUTRON: after release_win_ptr below, see update_surface_region. Kill switch
+             * NEUTRON_REGION_AFTER_LOCK=0. */
+            if (neutron_region_after_lock()) update_region = TRUE;
+            else update_surface_region( surface_win );
+        }
         if (((swp_flags & SWP_AGG_NOPOSCHANGE) != SWP_AGG_NOPOSCHANGE) ||
             (swp_flags & (SWP_HIDEWINDOW | SWP_SHOWWINDOW | SWP_STATECHANGED | SWP_FRAMECHANGED)))
             invalidate_dce( win, &old_rects.window );
@@ -3201,6 +3228,8 @@
 
     release_win_ptr( win );
 
+    if (update_region) update_surface_region( surface_win );
+
     /* NEUTRON copy-visible-bits-only: move the old visible region to the new position (screen coordinates) */
     if (vis_before && ret)
         NtGdiOffsetRgn( vis_before, new_rects->window.left - old_rects.window.left,
