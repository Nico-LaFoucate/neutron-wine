--- a/include/wine/gdi_driver.h
+++ b/include/wine/gdi_driver.h
@@ -266,6 +266,17 @@
     HWND                               hwnd;           /* window the surface was created for */
     LONG                               updated;        /* has been moved / resized / reparented */
     LONG                               offscreen;      /* client window is offscreen */
+    /* NEUTRON: size of the buffers presented to this surface, set by win32u before each Vulkan present
+     * (0 = unknown, e.g. OpenGL). Lets a driver crop the presented image safely: a crop that reaches past
+     * the buffer is a fatal wp_viewport out_of_buffer error on Wayland. */
+    UINT                               buffer_width;
+    UINT                               buffer_height;
+    /* NEUTRON: 1 while win32u presents to this surface (from just before update() until after present()). The
+     * host Vulkan WSI sends ALL its requests for the surface inside vkQueuePresentKHR (measured on NVIDIA,
+     * FIFO and MAILBOX: acquire/release points, attach, damage, commit); a driver that commits the surface
+     * itself must first set this 0 -> 1 with InterlockedCompareExchange, so it never lands in that sequence
+     * (a commit between set_acquire_point and attach is a fatal wp_linux_drm_syncobj error). */
+    LONG                               present_busy;
 };
 
 W32KAPI void *client_surface_create( UINT size, const struct client_surface_funcs *funcs, HWND hwnd );
