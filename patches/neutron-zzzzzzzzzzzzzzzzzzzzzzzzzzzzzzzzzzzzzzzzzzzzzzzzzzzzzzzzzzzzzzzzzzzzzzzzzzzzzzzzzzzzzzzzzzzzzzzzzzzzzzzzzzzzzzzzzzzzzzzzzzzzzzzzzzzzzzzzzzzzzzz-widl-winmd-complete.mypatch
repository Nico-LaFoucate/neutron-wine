+        for (i = 0; i < tables[TABLE_CUSTOMATTRIBUTE].count; i++)
+            if ((ca[i].parent & 0x1f) == 5) ca[i].parent = interfaceimpl_remap[ca[i].parent >> 5] << 5 | 5;
