+/* the assembly is named like the file, in the case of the namespace it holds ("Windows.Storage") */
+static char *get_assembly_name( const statement_list_t *stmt_list )
+{
+    const char *base = strrchr( metadata_name, '/' );
+    const statement_list_t *lists[2] = { stmt_list, metadata_import_stmts };
+    const statement_t *stmt;
+    char *name, *ptr;
+    size_t len;
+    UINT i;
+
+    name = xstrdup( base ? base + 1 : metadata_name );
+    if ((ptr = strrchr( name, '.' )) && !strcasecmp( ptr, ".winmd" )) *ptr = 0;
+    len = strlen( name );
+
+    for (i = 0; i < ARRAY_SIZE(lists); i++)
+    {
+        if (!lists[i]) continue;
+        LIST_FOR_EACH_ENTRY( stmt, lists[i], const statement_t, entry )
+        {
+            char *ns;
+            BOOL match;
+
+            if (stmt->type != STMT_TYPE || !stmt->u.type->namespace) continue;
+            ns = format_namespace( stmt->u.type->namespace, "", ".", NULL, NULL );
+            if ((match = !strncasecmp( ns, name, len ) && (!ns[len] || ns[len] == '.'))) memcpy( name, ns, len );
+            free( ns );
+            if (match) return name;
+        }
+    }
+    return name;
+}
