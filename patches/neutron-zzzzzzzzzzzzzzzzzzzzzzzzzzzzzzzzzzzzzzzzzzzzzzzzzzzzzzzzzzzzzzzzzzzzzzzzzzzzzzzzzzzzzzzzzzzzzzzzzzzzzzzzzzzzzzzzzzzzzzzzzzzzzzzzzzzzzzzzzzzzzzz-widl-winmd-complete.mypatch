+static UINT make_type_sig( const type_t *type, BYTE *buf );
+
+/* GENERICINST CLASS <generic type> <count> <arguments> (ECMA II.23.2.12) */
+static UINT make_generic_inst_sig( type_t *tmpl, typeref_list_t *args, BYTE *buf )
+{
+    type_t *def = get_template_definition( tmpl );
+    const typeref_t *arg;
+    UINT len = 0;
+
+    buf[len++] = ELEMENT_TYPE_GENERICINST;
+    buf[len++] = ELEMENT_TYPE_CLASS;
+    len += encode_int( typedef_or_ref(TABLE_TYPEREF, def->md.ref), buf + len );
+    len += encode_int( args ? list_count( args ) : 0, buf + len );
+    if (args) LIST_FOR_EACH_ENTRY( arg, args, const typeref_t, entry ) len += make_type_sig( arg->type, buf + len );
+    return len;
+}
+
+/* TypeDefOrRef token of a type used as an interface or event type: generic instances go through a TypeSpec */
+static UINT type_def_or_ref_token( const type_t *type )
+{
+    while (type_get_type( type ) == TYPE_POINTER) type = type_pointer_get_ref_type( type );
+    type = type_get_real_type( type );
+
+    if (type->md.generic_tmpl || is_partial_specialization( type ))
+    {
+        BYTE sig[256];
+        UINT size = make_type_sig( type, sig );
+        return typedef_or_ref( TABLE_TYPESPEC, add_typespec_row( add_blob(sig, size) ) );
+    }
+    return typedef_or_ref( TABLE_TYPEREF, type->md.ref );
+}
+
 static UINT make_type_sig( const type_t *type, BYTE *buf )
 {
     UINT len = 0;
@@ -1683,6 +1899,7 @@
