# neutron-widl-winmd-complete
#
# Touches: tools/widl/{metadata.c,parser.y,widl.c,widl.h,widltypes.h,typetree.c}, include/windows.foundation.idl,
# include/windows.applicationmodel.idl, include/Makefile.in, loader/wine.inf.in. Build-time only (widl + the installed
# winmd files); pairs with neutron-winrt-resolve-namespace, whose kill switch turns the whole path off at run time.
#
# WHAT WAS SEEN: Affinity dies when its Canva sign-in link comes back (see neutron-winrt-resolve-namespace).
#
# MECHANISM
# Once RoResolveNamespace answers, the .NET Framework CLR reads Wine's generated winmd files, and they could not describe
# SharedStorageAccessManager or what its signature uses:
# - DataTransfer (and every sub-namespace IDL: Windows.Storage.Streams, ...) was never written into its root winmd; there
#   was no windows.foundation.winmd at all (IAsyncOperation`1, IAsyncInfo, AsyncStatus, ...).
# - generics were never written (templates skipped as "Unhandled type", instances and interface types written as Object),
#   so RedeemTokenForFileAsync could not match Affinity's IAsyncOperation`1<StorageFile> reference.
# - assembly name was the build path ("include/windows.storage"); MethodImpl class column sized from a ROW NUMBER used as
#   a table index (garbage layout past 45 typedefs); SizeOfImage rounded to 8 KiB, not section end (BadImageFormat
#   0x800700C1 past ~60 KiB); NULL deref for a class method whose interface has no contract (the reported segfault) and
#   for types with neither version nor contract; 2nd+ [static] attributes pointed at MemberRef 0; a setter declared before
#   its getter added the getter twice; types of other files scoped to this Module; sorting InterfaceImpl rows detached
#   their DefaultAttribute rows.
# Fix: write each root's sub-namespaces (types of imported IDLs under the file's namespace; the root IDL imports its
# sub-namespace IDLs only when widl writes a winmd, __WIDL_WINMD__, so headers are unchanged), generic definitions
# ("Name`N" + GenericParam rows, ELEMENT_TYPE_VAR), instances (GENERICINST; TypeSpec for InterfaceImpl, event types and the
# MethodImpl parent, whose MemberRef carries the template's signature), interfaces as CLASS TypeRefs, plus the fixes above.
# windows.foundation.winmd is built and installed (Makefile.in, wine.inf [WinmdFiles]); asyncinfo.idl/eventtoken.idl's
# global-namespace IAsyncInfo, AsyncStatus, EventRegistrationToken go into it as Windows.Foundation types.
#
# WINDOWS (learn.microsoft.com/uwp/winrt-cref/winmd-files): file name = assembly name; a file holds its namespace and
# sub-namespaces; "with the longest name matching the namespace of the type"; parameterized interfaces/delegates are
# "Name`N" with one GenericParam row per parameter; instances are TypeSpecs/GENERICINST; interfaces are TypeRefs.
#
# DIFF OF THE GENERATED FILES (old 182af vs new, dumped with System.Reflection.Metadata): no type removed from any file;
# added types: applicationmodel 26->183, foundation 0->76 (new file), globalization 15->24, networking 11->60, storage 36->69,
# ui 11->14, ui.xaml 20->22, graphics/media/perception/system unchanged; changed method lines are signature corrections
# (Object -> the interface or IAsyncOperation`1<...>); assembly names now "Windows.X".
#
# NOT COVERED: Wine ships winmds for 11 roots only (no Windows.Security, Devices, AI, Data, ...): e.g. DataPackage loads
# but a method needs Windows.Security.EnterpriseData.* (not found); types Wine's IDLs lack (Windows.System.Launcher) stay
# missing. Roots other than Foundation/ApplicationModel/Storage merge only the sub-namespace IDLs they already import.
# AssemblyRef names for other files use the first two namespace parts (the CLR resolves WinRT refs by namespace; INFERRED).
#
# LAB EVIDENCE: .NET 4.8 reflection probe (Type.GetType(..., ContentType=WindowsRuntime), signatures printed):
# SharedStorageAccessManager (RedeemTokenForFileAsync -> IAsyncOperation`1[StorageFile]), StorageFile, IAsyncOperation`1,
# Package, Uri (projected to System.Uri), PropertySet, ValueSet, ApplicationData, StorageFolder, Calendar, HostName, Color,
# SystemMediaTransportControls load (old files: StorageFile fails on Windows.Storage.Streams, DataTransfer absent).
# Affinity callback: see neutron-winrt-resolve-namespace (alive 2/2 on, dead 2/2 with its kill switch, same build).
# wineboot -u installs windows.foundation.winmd (byte-identical) into system32 and syswow64 winmetadata.
--- a/tools/widl/metadata.c
+++ b/tools/widl/metadata.c
@@ -141,11 +141,6 @@
 
     put_data( &dos_header, sizeof(dos_header) );
 
-    image_size += nt_header.OptionalHeader.SizeOfHeaders + sizeof(section_header);
-    nt_header.OptionalHeader.SizeOfImage = (image_size + 0x1fff) & ~0x1fff;
-
-    put_data( &nt_header, sizeof(nt_header) );
-
     for (i = 0; i < WINMD_STREAM_MAX; i++)
     {
         if (!streams[i].data_size) continue;
@@ -158,6 +153,13 @@
     section_header.Misc.VirtualSize = sizeof(cor_header) + sizeof(metadata_header) + streams_size + 8;
     section_header.SizeOfRawData = (section_header.Misc.VirtualSize + FILE_ALIGNMENT - 1) & ~(FILE_ALIGNMENT - 1);
 
+    /* the image ends with the section, rounded up to the section alignment; a smaller SizeOfImage makes the
+       loader reject the file (ERROR_BAD_EXE_FORMAT) once the metadata grows past 60 KiB */
+    nt_header.OptionalHeader.SizeOfImage = section_header.VirtualAddress +
+        ((section_header.Misc.VirtualSize + SECTION_ALIGNMENT - 1) & ~(SECTION_ALIGNMENT - 1));
+
+    put_data( &nt_header, sizeof(nt_header) );
+
     put_data( &section_header, sizeof(section_header) );
 
     for (i = 0; i < FILE_ALIGNMENT - sizeof(dos_header) - sizeof(nt_header) - sizeof(section_header); i++)
@@ -802,6 +804,9 @@
