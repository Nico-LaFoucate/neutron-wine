+/* A WinMD file named N.winmd holds the types of namespace N and of its sub-namespaces (types live in the file
+   with the longest name matching their namespace). The file's own IDL imports the IDLs of its sub-namespaces,
+   so the types defined in imported files under N are written here too. */
+static BOOL namespace_in_root( const char *ns )
+{
+    size_t len = strlen( assembly_name );
+    return ns && !strncmp( ns, assembly_name, len ) && (!ns[len] || ns[len] == '.');
+}
+
+static BOOL type_in_root( const type_t *type )
+{
+    char *ns;
+    BOOL ret;
+
+    if (!type->namespace) return FALSE;
+    ns = format_namespace( type->namespace, "", ".", NULL, NULL );
+    ret = namespace_in_root( ns );
+    free( ns );
+    return ret;
+}
+
+static BOOL is_specialization( const type_t *type )
+{
+    return type->signature && !strncmp( type->signature, "pinterface", 10 );
+}
+
+static type_t **file_types;
+static UINT file_types_count, file_types_size;
+
+static void add_file_type( type_t *type )
+{
+    if (type->md.in_file) return;
+    type->md.in_file = 1;
+    if (type_get_type_detect_alias( type ) == TYPE_PARAMETERIZED_TYPE) get_template_definition( type )->md.in_file = 1;
+    if (file_types_count == file_types_size)
+    {
+        file_types_size = file_types_size ? file_types_size * 2 : 64;
+        file_types = xrealloc( file_types, file_types_size * sizeof(*file_types) );
+    }
+    file_types[file_types_count++] = type;
+}
+
+/* asyncinfo.idl and eventtoken.idl declare Windows.Foundation types (IAsyncInfo, AsyncStatus,
+   EventRegistrationToken) in the global namespace, like the SDK headers; their metadata belongs here */
+static BOOL is_global_foundation_type( const type_t *type )
+{
+    const char *file = type->where.input_name, *base;
+
+    if (strcmp( assembly_name, "Windows.Foundation" ) || !file) return FALSE;
+    if (type->namespace && !is_global_namespace( type->namespace )) return FALSE;
+    base = strrchr( file, '/' ) ? strrchr( file, '/' ) + 1 : file;
+    return !strcmp( base, "asyncinfo.idl" ) || !strcmp( base, "eventtoken.idl" );
+}
+
+static void collect_file_types( const statement_list_t *stmt_list )
+{
+    const statement_t *stmt;
+
+    if (stmt_list) LIST_FOR_EACH_ENTRY( stmt, stmt_list, const statement_t, entry )
+    {
+        if (stmt->type != STMT_TYPE || is_specialization( stmt->u.type )) continue;
+        add_file_type( stmt->u.type );
+    }
+    if (metadata_import_stmts) LIST_FOR_EACH_ENTRY( stmt, metadata_import_stmts, const statement_t, entry )
+    {
+        if (stmt->type == STMT_TYPEDEF && stmt->u.type_list)
+        {
+            const typeref_t *ref;
+            LIST_FOR_EACH_ENTRY( ref, stmt->u.type_list, const typeref_t, entry )
+            {
+                type_t *type = type_get_real_type( ref->type );
+                if ((type_get_type( type ) == TYPE_ENUM || type_get_type( type ) == TYPE_STRUCT) &&
+                    type->defined && is_global_foundation_type( type )) add_file_type( type );
+            }
+            continue;
+        }
+        if (stmt->type != STMT_TYPE || is_specialization( stmt->u.type )) continue;
+        if (!stmt->u.type->defined) continue;
+        if (!type_in_root( stmt->u.type ) && !is_global_foundation_type( stmt->u.type )) continue;
+        add_file_type( stmt->u.type );
+    }
+}
+
+static void add_parameterized_type_step1( type_t *type )
+{
+    type_t *def = get_template_definition( type );
+
+    generic_params = type->details.parameterized.params;
+    if (type_get_type( def ) == TYPE_DELEGATE) add_delegate_type_step1( def );
+    else add_interface_type_step1( def );
+    generic_params = NULL;
+}
+
+static void add_parameterized_type_step2( type_t *type )
+{
+    type_t *def = get_template_definition( type );
+    const typeref_t *param;
+    USHORT number = 0;
+
+    generic_params = type->details.parameterized.params;
+    if (type_get_type( def ) == TYPE_DELEGATE) add_delegate_type_step2( def );
+    else add_interface_type_step2( def );
+    generic_params = NULL;
+
+    /* one GenericParam row per type parameter, owner = the TypeDef (TypeOrMethodDef tag 0) */
+    if (type->details.parameterized.params)
+        LIST_FOR_EACH_ENTRY( param, type->details.parameterized.params, const typeref_t, entry )
+            add_genericparam_row( number++, def->md.def << 1, add_string(param->type->name) );
+}
+
