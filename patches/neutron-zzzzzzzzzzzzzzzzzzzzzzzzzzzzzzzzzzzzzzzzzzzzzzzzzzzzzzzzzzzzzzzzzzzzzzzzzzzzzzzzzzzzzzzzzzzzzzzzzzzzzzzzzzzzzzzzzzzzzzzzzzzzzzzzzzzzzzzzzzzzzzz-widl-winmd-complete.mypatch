 #define MAX_NAME        256
 
+/* formal parameters of the parameterized type whose definition is being written */
+static const typeref_list_t *generic_params;
+
+/* members of a generic instance that was only declared still use the template's parameters: substitute them */
+static const typeref_list_t *subst_params, *subst_args;
+
+static const type_t *get_subst_arg( const type_t *param )
+{
+    const typeref_t *ref, *arg;
+
+    if (!subst_params || !subst_args) return NULL;
+    arg = LIST_ENTRY( list_head( subst_args ), const typeref_t, entry );
+    LIST_FOR_EACH_ENTRY( ref, subst_params, const typeref_t, entry )
+    {
+        if (!arg) break;
+        if (ref->type == param || (ref->type->name && param->name && !strcmp( ref->type->name, param->name )))
+            return arg->type;
+        arg = LIST_ENTRY( list_next( subst_args, &arg->entry ), const typeref_t, entry );
+    }
+    return NULL;
+}
+
+static UINT generic_param_index( const type_t *param )
+{
+    const typeref_t *ref;
+    UINT i = 0;
+
+    if (generic_params) LIST_FOR_EACH_ENTRY( ref, generic_params, const typeref_t, entry )
+    {
+        if (ref->type == param || (ref->type->name && param->name && !strcmp( ref->type->name, param->name ))) return i;
+        i++;
+    }
+    error( "type parameter %s used outside of its parameterized type\n", param->name );
+    return 0;
+}
+
+/* the interface or delegate definition of a parameterized type template, with its winmd name "Name`N" */
+static type_t *get_template_definition( type_t *tmpl )
+{
+    type_t *def = tmpl->details.parameterized.type;
+
+    if (!def->winmd_short_name)
+    {
+        UINT count = tmpl->details.parameterized.params ? list_count( tmpl->details.parameterized.params ) : 0;
+        def->winmd_short_name = strmake( "%s`%u", tmpl->name, count );
+    }
+    if (!def->namespace) def->namespace = tmpl->namespace;
+    if (!def->attrs) def->attrs = tmpl->attrs; /* interface templates keep their attributes on the template */
+    return def;
+}
+
+/* a partial specialization (inside a template) points at its template; a template points at its definition */
+static BOOL is_partial_specialization( const type_t *type )
+{
+    return type_get_type_detect_alias( type ) == TYPE_PARAMETERIZED_TYPE &&
+           type_get_type_detect_alias( type->details.parameterized.type ) == TYPE_PARAMETERIZED_TYPE;
+}
+
 /* create a type reference if needed and store it in the base type */
 static void create_typeref( type_t *type )
 {
