+struct typespec_row
+{
+    UINT signature;
+};
+
+static UINT add_typespec_row( UINT signature )
+{
+    struct typespec_row row = { signature };
+    return add_row( TABLE_TYPESPEC, (const BYTE *)&row, sizeof(row) );
+}
+
+static void serialize_typespec_table( void )
+{
+    const struct typespec_row *row = (const struct typespec_row *)tables[TABLE_TYPESPEC].ptr;
+    UINT i;
+
+    for (i = 0; i < tables[TABLE_TYPESPEC].count; i++)
+    {
+        serialize_blob_idx( row->signature );
+        row++;
+    }
+}
+
+struct genericparam_row
+{
+    USHORT number;
+    USHORT flags;
+    UINT owner;
+    UINT name;
+};
+
+static UINT add_genericparam_row( USHORT number, UINT owner, UINT name )
+{
+    struct genericparam_row row = { number, 0, owner, name };
+    return add_row( TABLE_GENERICPARAM, (const BYTE *)&row, sizeof(row) );
+}
+
+static int cmp_genericparam_row( const void *a, const void *b )
+{
+    const struct genericparam_row *row = a, *row2 = b;
+    if (row->owner > row2->owner) return 1;
+    if (row->owner < row2->owner) return -1;
+    if (row->number > row2->number) return 1;
+    if (row->number < row2->number) return -1;
+    return 0;
+}
+
+/* sorted by owner, number */
+static void serialize_genericparam_table( void )
+{
+    const struct genericparam_row *row = (const struct genericparam_row *)tables[TABLE_GENERICPARAM].ptr;
+    UINT i;
+
+    qsort( tables[TABLE_GENERICPARAM].ptr, tables[TABLE_GENERICPARAM].count, sizeof(*row), cmp_genericparam_row );
+
+    for (i = 0; i < tables[TABLE_GENERICPARAM].count; i++)
+    {
+        serialize_ushort( row->number );
+        serialize_ushort( row->flags );
+        serialize_table_idx( row->owner, (row->owner & 1) ? TABLE_METHODDEF : TABLE_TYPEDEF );
+        serialize_string_idx( row->name );
+        row++;
+    }
+}
+
 struct memberref_row
 {
     UINT class;
