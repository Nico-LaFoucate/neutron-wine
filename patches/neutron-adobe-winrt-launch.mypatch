+static HRESULT WINAPI display_info_statics_interop_GetForWindow( IDisplayInformationStaticsInterop *iface,
+        HWND window, REFIID iid, void **info )
+{
+    IDisplayInformation *display_info;
+    HRESULT hr;
+
+    TRACE( "iface %p, window %p, iid %s, info %p.\n", iface, window, debugstr_guid( iid ), info );
+
+    if (FAILED(hr = display_information_create( &display_info ))) return hr;
+    hr = IDisplayInformation_QueryInterface( display_info, iid, info );
+    IDisplayInformation_Release( display_info );
+    return hr;
+}
