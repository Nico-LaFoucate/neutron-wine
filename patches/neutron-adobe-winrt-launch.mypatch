diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
index b3560f09c12..5467afd5e15 100644
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -2923,8 +2923,19 @@ static void STDMETHODCALLTYPE d2d_device_context_DrawGeometryRealization(ID2D1De
 {
     struct d2d_device_context *context = impl_from_ID2D1DeviceContext(iface);
     struct d2d_geometry_realization *r = unsafe_impl_from_ID2D1GeometryRealization(realization);
+    struct d2d_brush *brush_impl = unsafe_impl_from_ID2D1Brush(brush);
+    const struct d2d_geometry *geometry_impl;
+
+    TRACE("iface %p, realization %p, brush %p.\n", iface, realization, brush);
+
+    if (FAILED(context->error.code))
+        return;
 
-    FIXME("iface %p, realization %p, brush %p semi-stub!\n", iface, realization, brush);
+    if (context->target.type == D2D_TARGET_UNKNOWN)
+    {
+        d2d_device_context_set_error(context, D2DERR_WRONG_STATE);
+        return;
+    }
 
     if (context->target.type == D2D_TARGET_COMMAND_LIST)
     {
@@ -2939,6 +2950,14 @@ static void STDMETHODCALLTYPE d2d_device_context_DrawGeometryRealization(ID2D1De
         }
         return;
     }
+
+    /* Wine keeps the realization's source geometry rather than baking a separate
+     * mesh, so rendering it is equivalent to Fill/DrawGeometry on that geometry. */
+    geometry_impl = unsafe_impl_from_ID2D1Geometry(r->geometry);
+    if (r->filled)
+        d2d_device_context_fill_geometry(context, geometry_impl, brush_impl, NULL);
+    else
+        d2d_device_context_draw_geometry(context, geometry_impl, brush_impl, r->stroke_width);
 }
 
 static HRESULT STDMETHODCALLTYPE d2d_device_context_CreateInk(ID2D1DeviceContext6 *iface,
diff --git a/dlls/dwmapi/dwmapi_main.c b/dlls/dwmapi/dwmapi_main.c
index 49e05cd207e..faf006f2811 100644
--- a/dlls/dwmapi/dwmapi_main.c
+++ b/dlls/dwmapi/dwmapi_main.c
@@ -195,6 +195,59 @@ HRESULT WINAPI DwmGetWindowAttribute(HWND hwnd, DWORD attribute, PVOID pv_attrib
         return E_HANDLE;
 
     switch (attribute) {
+    case DWMWA_CAPTION_BUTTON_BOUNDS:
+    {
+        RECT *rect = (RECT *)pv_attribute;
+        RECT window_rect;
+        LONG style;
+
+        if (!rect)
+            return E_INVALIDARG;
+        if (size < sizeof(*rect))
+            return E_NOT_SUFFICIENT_BUFFER;
+        style = GetWindowLongW(hwnd, GWL_STYLE);
+        if (style & WS_CHILD)
+            return E_HANDLE;
+        if (!GetWindowRect(hwnd, &window_rect))
+            return HRESULT_FROM_WIN32(GetLastError());
+
+        if (style & WS_CAPTION)
+        {
+            /* Bounds of the caption buttons, relative to the window's top-left corner. */
+            int btn_w = GetSystemMetrics(SM_CXSIZE);
+            int btn_h = GetSystemMetrics(SM_CYSIZE);
+            int border_x = GetSystemMetrics(SM_CXSIZEFRAME) + GetSystemMetrics(SM_CXPADDEDBORDER);
+            int border_y = GetSystemMetrics(SM_CYSIZEFRAME) + GetSystemMetrics(SM_CXPADDEDBORDER);
+            int count = 1; /* close button */
+            int width = window_rect.right - window_rect.left;
+
+            if (style & WS_MINIMIZEBOX) count++;
+            if (style & WS_MAXIMIZEBOX) count++;
+
+            /* NEUTRON P2c: the caption-button bounds are window-relative, so only the
+             * window WIDTH matters here. Under winewayland a maximized window can carry a
+             * stale/garbage Win32 origin (Photoshop), making GetWindowRect degenerate
+             * (left > right, negative width) and the bounds land off-window -> the app
+             * paints its caption buttons in the wrong place (black box). Fall back to the
+             * client width, which stays correct, whenever the window width isn't sane. */
+            if (width <= 0)
+            {
+                RECT client_rect;
+                if (GetClientRect(hwnd, &client_rect))
+                    width = client_rect.right - client_rect.left;
+            }
+
+            rect->right = width - border_x;
+            rect->left = rect->right - count * btn_w;
+            rect->top = border_y;
+            rect->bottom = rect->top + btn_h;
+        }
+        else
+            SetRectEmpty(rect);
+
+        hr = S_OK;
+        break;
+    }
     case DWMWA_EXTENDED_FRAME_BOUNDS:
     {
         RECT *rect = (RECT *)pv_attribute;
