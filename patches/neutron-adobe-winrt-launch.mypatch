diff --git a/dlls/windows.graphics/main.c b/dlls/windows.graphics/main.c
index 25a571975e5..4dfbdd04479 100644
--- a/dlls/windows.graphics/main.c
+++ b/dlls/windows.graphics/main.c
@@ -22,10 +22,649 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(display);
 
+/* From windows.graphics.display.interop.h (not present in Wine's headers).
+ * Desktop (non-CoreWindow) apps get DisplayInformation through this interop
+ * interface on the activation factory instead of GetForCurrentView(). */
+DEFINE_GUID( IID_IDisplayInformationStaticsInterop, 0x7449121c, 0x382b, 0x4705,
+             0x8d, 0xa7, 0xa7, 0x95, 0xba, 0x48, 0x20, 0x13 );
+
+typedef struct IDisplayInformationStaticsInterop IDisplayInformationStaticsInterop;
+
+struct IDisplayInformationStaticsInteropVtbl
+{
+    /* IUnknown methods */
+    HRESULT (WINAPI *QueryInterface)( IDisplayInformationStaticsInterop *iface, REFIID iid, void **out );
+    ULONG (WINAPI *AddRef)( IDisplayInformationStaticsInterop *iface );
+    ULONG (WINAPI *Release)( IDisplayInformationStaticsInterop *iface );
+    /* IInspectable methods */
+    HRESULT (WINAPI *GetIids)( IDisplayInformationStaticsInterop *iface, ULONG *iid_count, IID **iids );
+    HRESULT (WINAPI *GetRuntimeClassName)( IDisplayInformationStaticsInterop *iface, HSTRING *class_name );
+    HRESULT (WINAPI *GetTrustLevel)( IDisplayInformationStaticsInterop *iface, TrustLevel *trust_level );
+    /* IDisplayInformationStaticsInterop methods */
+    HRESULT (WINAPI *GetForWindow)( IDisplayInformationStaticsInterop *iface, HWND window, REFIID iid, void **info );
+    HRESULT (WINAPI *GetForMonitor)( IDisplayInformationStaticsInterop *iface, HMONITOR monitor, REFIID iid, void **info );
+};
+
+struct IDisplayInformationStaticsInterop
+{
+    const struct IDisplayInformationStaticsInteropVtbl *lpVtbl;
+};
+
+static LONG64 next_event_token;
+
+static EventRegistrationToken dummy_token(void)
+{
+    EventRegistrationToken token;
+    token.value = InterlockedIncrement64( &next_event_token );
+    return token;
+}
+
+static void get_screen_size( UINT32 *width, UINT32 *height )
+{
+    INT w = GetSystemMetrics( SM_CXSCREEN );
+    INT h = GetSystemMetrics( SM_CYSCREEN );
+    if (w <= 0) w = 1920;
+    if (h <= 0) h = 1080;
+    *width = w;
+    *height = h;
+}
+
+static float get_logical_dpi(void)
+{
+    UINT dpi = GetDpiForSystem();
+    if (!dpi) dpi = 96;
+    return (float)dpi;
+}
+
+/*
+ * AdvancedColorInfo: a standard dynamic range (sRGB / Rec.709) display.
+ */
+struct advanced_color_info
+{
+    IAdvancedColorInfo IAdvancedColorInfo_iface;
+    LONG ref;
+};
+
+static inline struct advanced_color_info *impl_from_IAdvancedColorInfo( IAdvancedColorInfo *iface )
+{
+    return CONTAINING_RECORD( iface, struct advanced_color_info, IAdvancedColorInfo_iface );
+}
+
+static HRESULT WINAPI advanced_color_info_QueryInterface( IAdvancedColorInfo *iface, REFIID iid, void **out )
+{
+    struct advanced_color_info *impl = impl_from_IAdvancedColorInfo( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown )
+        || IsEqualGUID( iid, &IID_IInspectable )
+        || IsEqualGUID( iid, &IID_IAgileObject )
+        || IsEqualGUID( iid, &IID_IAdvancedColorInfo ))
+    {
+        *out = &impl->IAdvancedColorInfo_iface;
+        IAdvancedColorInfo_AddRef( *out );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI advanced_color_info_AddRef( IAdvancedColorInfo *iface )
+{
+    struct advanced_color_info *impl = impl_from_IAdvancedColorInfo( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI advanced_color_info_Release( IAdvancedColorInfo *iface )
+{
+    struct advanced_color_info *impl = impl_from_IAdvancedColorInfo( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI advanced_color_info_GetIids( IAdvancedColorInfo *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI advanced_color_info_GetRuntimeClassName( IAdvancedColorInfo *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( RuntimeClass_Windows_Graphics_Display_AdvancedColorInfo,
+                                wcslen( RuntimeClass_Windows_Graphics_Display_AdvancedColorInfo ), class_name );
+}
+
+static HRESULT WINAPI advanced_color_info_GetTrustLevel( IAdvancedColorInfo *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI advanced_color_info_get_CurrentAdvancedColorKind( IAdvancedColorInfo *iface,
+        AdvancedColorKind *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    *value = AdvancedColorKind_StandardDynamicRange;
+    return S_OK;
+}
+
+static HRESULT WINAPI advanced_color_info_get_RedPrimary( IAdvancedColorInfo *iface, Point *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    value->X = 0.64f;
+    value->Y = 0.33f;
+    return S_OK;
+}
+
+static HRESULT WINAPI advanced_color_info_get_GreenPrimary( IAdvancedColorInfo *iface, Point *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    value->X = 0.30f;
+    value->Y = 0.60f;
+    return S_OK;
+}
+
+static HRESULT WINAPI advanced_color_info_get_BluePrimary( IAdvancedColorInfo *iface, Point *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    value->X = 0.15f;
+    value->Y = 0.06f;
+    return S_OK;
+}
+
+static HRESULT WINAPI advanced_color_info_get_WhitePoint( IAdvancedColorInfo *iface, Point *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    value->X = 0.3127f;
+    value->Y = 0.3290f;
+    return S_OK;
+}
+
+static HRESULT WINAPI advanced_color_info_get_MaxLuminanceInNits( IAdvancedColorInfo *iface, FLOAT *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    *value = 350.0f;
+    return S_OK;
+}
+
+static HRESULT WINAPI advanced_color_info_get_MinLuminanceInNits( IAdvancedColorInfo *iface, FLOAT *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    *value = 0.5f;
+    return S_OK;
+}
+
+static HRESULT WINAPI advanced_color_info_get_MaxAverageFullFrameLuminanceInNits( IAdvancedColorInfo *iface,
+        FLOAT *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    *value = 350.0f;
+    return S_OK;
+}
+
+static HRESULT WINAPI advanced_color_info_get_SdrWhiteLevelInNits( IAdvancedColorInfo *iface, FLOAT *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+    *value = 80.0f;
+    return S_OK;
+}
+
+static HRESULT WINAPI advanced_color_info_IsHdrMetadataFormatCurrentlySupported( IAdvancedColorInfo *iface,
+        HdrMetadataFormat format, boolean *result )
+{
+    TRACE( "iface %p, format %d, result %p.\n", iface, format, result );
+    *result = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI advanced_color_info_IsAdvancedColorKindAvailable( IAdvancedColorInfo *iface,
+        AdvancedColorKind kind, boolean *result )
+{
+    TRACE( "iface %p, kind %d, result %p.\n", iface, kind, result );
+    *result = (kind == AdvancedColorKind_StandardDynamicRange);
+    return S_OK;
+}
+
+static const struct IAdvancedColorInfoVtbl advanced_color_info_vtbl =
+{
+    advanced_color_info_QueryInterface,
+    advanced_color_info_AddRef,
+    advanced_color_info_Release,
+    /* IInspectable methods */
+    advanced_color_info_GetIids,
+    advanced_color_info_GetRuntimeClassName,
+    advanced_color_info_GetTrustLevel,
+    /* IAdvancedColorInfo methods */
+    advanced_color_info_get_CurrentAdvancedColorKind,
+    advanced_color_info_get_RedPrimary,
+    advanced_color_info_get_GreenPrimary,
+    advanced_color_info_get_BluePrimary,
+    advanced_color_info_get_WhitePoint,
+    advanced_color_info_get_MaxLuminanceInNits,
+    advanced_color_info_get_MinLuminanceInNits,
+    advanced_color_info_get_MaxAverageFullFrameLuminanceInNits,
+    advanced_color_info_get_SdrWhiteLevelInNits,
+    advanced_color_info_IsHdrMetadataFormatCurrentlySupported,
+    advanced_color_info_IsAdvancedColorKindAvailable,
+};
+
+static HRESULT advanced_color_info_create( IAdvancedColorInfo **out )
+{
+    struct advanced_color_info *impl;
+
+    if (!(impl = calloc( 1, sizeof( *impl ) ))) return E_OUTOFMEMORY;
+    impl->IAdvancedColorInfo_iface.lpVtbl = &advanced_color_info_vtbl;
+    impl->ref = 1;
+
+    *out = &impl->IAdvancedColorInfo_iface;
+    return S_OK;
+}
+
+/*
+ * DisplayInformation instance object.
+ */
+struct display_information
+{
+    IDisplayInformation IDisplayInformation_iface;
+    IDisplayInformation2 IDisplayInformation2_iface;
+    IDisplayInformation3 IDisplayInformation3_iface;
+    IDisplayInformation4 IDisplayInformation4_iface;
+    IDisplayInformation5 IDisplayInformation5_iface;
+    struct weak_reference_source weak_reference_source;
+};
+
+static inline struct display_information *impl_from_IDisplayInformation( IDisplayInformation *iface )
+{
+    return CONTAINING_RECORD( iface, struct display_information, IDisplayInformation_iface );
+}
+
+static HRESULT WINAPI display_info_QueryInterface( IDisplayInformation *iface, REFIID iid, void **out )
+{
+    struct display_information *impl = impl_from_IDisplayInformation( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown )
+        || IsEqualGUID( iid, &IID_IInspectable )
+        || IsEqualGUID( iid, &IID_IAgileObject )
+        || IsEqualGUID( iid, &IID_IDisplayInformation ))
+    {
+        *out = &impl->IDisplayInformation_iface;
+        IDisplayInformation_AddRef( *out );
+        return S_OK;
+    }
+    else if (IsEqualGUID( iid, &IID_IDisplayInformation2 ))
+    {
+        *out = &impl->IDisplayInformation2_iface;
+        IDisplayInformation2_AddRef( *out );
+        return S_OK;
+    }
+    else if (IsEqualGUID( iid, &IID_IDisplayInformation3 ))
+    {
+        *out = &impl->IDisplayInformation3_iface;
+        IDisplayInformation3_AddRef( *out );
+        return S_OK;
+    }
+    else if (IsEqualGUID( iid, &IID_IDisplayInformation4 ))
+    {
+        *out = &impl->IDisplayInformation4_iface;
+        IDisplayInformation4_AddRef( *out );
+        return S_OK;
+    }
+    else if (IsEqualGUID( iid, &IID_IDisplayInformation5 ))
+    {
+        *out = &impl->IDisplayInformation5_iface;
+        IDisplayInformation5_AddRef( *out );
+        return S_OK;
+    }
+    else if (IsEqualGUID( iid, &IID_IWeakReferenceSource ))
+    {
+        *out = &impl->weak_reference_source.IWeakReferenceSource_iface;
+        IWeakReferenceSource_AddRef( *out );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI display_info_AddRef( IDisplayInformation *iface )
+{
+    struct display_information *impl = impl_from_IDisplayInformation( iface );
+    ULONG ref = weak_reference_strong_add_ref( &impl->weak_reference_source );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI display_info_Release( IDisplayInformation *iface )
+{
+    struct display_information *impl = impl_from_IDisplayInformation( iface );
+    ULONG ref = weak_reference_strong_release( &impl->weak_reference_source );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI display_info_GetIids( IDisplayInformation *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI display_info_GetRuntimeClassName( IDisplayInformation *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( RuntimeClass_Windows_Graphics_Display_DisplayInformation,
+                                wcslen( RuntimeClass_Windows_Graphics_Display_DisplayInformation ), class_name );
+}
+
