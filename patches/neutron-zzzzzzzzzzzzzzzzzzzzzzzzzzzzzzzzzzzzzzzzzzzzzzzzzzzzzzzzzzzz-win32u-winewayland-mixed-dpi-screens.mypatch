         if (wayland_surface_viewport_destination(surface, &dest_width, &dest_height))
             wp_viewport_set_destination(surface->wp_viewport, dest_width, dest_height);
+        else if (neutron_attach_dest())
+        {
+            /* NEUTRON attach-dest: the buffer covers the window, so present it at the window's size -- the destination
+             * wayland_surface_reconfigure() sets. Reconfigure runs BEFORE this attach and measured the PREVIOUS
+             * buffer: a window that changed monitor and buffer size in one flush kept the destination of the old,
+             * smaller buffer until its next paint. A maximized window dragged from a 100% screen back to a 175%
+             * one was shown at 1317x731 of its 2194x1202 (the 2304x1280 buffer of the 100% screen, at 1.75).
+             * Kill switch NEUTRON_ATTACH_DEST=0. */
+            wayland_surface_coords_from_window(surface, surface->window.rect.right - surface->window.rect.left,
+                                               surface->window.rect.bottom - surface->window.rect.top,
+                                               &dest_width, &dest_height);
+            wayland_surface_reconfigure_size(surface, dest_width, dest_height);
+        }
+    }
+
+    /* NEUTRON diag: one line whenever the presented buffer or window size changes (NEUTRON_WL_DIAG=1). */
+    if (neutron_wl_surf_diag() &&
+        (win_width != surface->content_width || win_height != surface->content_height ||
+         surface->neutron_diag_buf_w != shm_buffer->width || surface->neutron_diag_buf_h != shm_buffer->height))
+    {
+        ERR("neutron-attach: hwnd=%p buffer=%dx%d window=%s scale=%.4f src=%dx%d\n", surface->hwnd,
+            shm_buffer->width, shm_buffer->height, wine_dbgstr_rect(&surface->window.rect), surface->window.scale,
+            win_width, win_height);
+        surface->neutron_diag_buf_w = shm_buffer->width;
+        surface->neutron_diag_buf_h = shm_buffer->height;
     }
 
     surface->content_width = win_width;
