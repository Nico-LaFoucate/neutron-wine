+/* NEUTRON surface-crop-dpi: visible_rect is in the thread's dpi coordinates (get_window_surface works in them), so
+ * the virtual screen it is cropped to must be too. Against the RAW virtual screen, a system-dpi-aware window (168 dpi)
+ * on a 96-dpi second screen -- whose coordinates are 1.75x its raw pixels -- was cut to the part left of the raw
+ * desktop's right edge: a maximized 3840x2160 window was drawn into a 640x1280 surface (Lightroom Classic run with the
+ * Windows "System" DPI override, on a 100% Cintiq next to a 175% screen). Per-monitor-aware threads use raw
+ * coordinates, so for them nothing changes. Kill switch NEUTRON_SURFACE_CROP_DPI=0. */
+static BOOL neutron_surface_crop_dpi(void)
+{
+    static int on = -1;
+    if (on < 0)
+    {
+        const char *e = getenv( "NEUTRON_SURFACE_CROP_DPI" );
+        on = !e || e[0] != '0';
+        if (!on) ERR( "neutron-gateresolved: NEUTRON_SURFACE_CROP_DPI = 0 (environment)\n" );
+    }
+    return on;
+}
+
 static BOOL get_surface_rect( const RECT *visible_rect, RECT *surface_rect )
 {
-    RECT virtual_rect = get_virtual_screen_rect( 0, MDT_RAW_DPI );
+    RECT virtual_rect = neutron_surface_crop_dpi() ? get_virtual_screen_rect( get_thread_dpi(), MDT_DEFAULT )
+                                                   : get_virtual_screen_rect( 0, MDT_RAW_DPI );
 
     *surface_rect = *visible_rect;
 
@@ -7396,11 +7415,75 @@
     return TRUE;
 }
 
+/* NEUTRON normal-follows-monitor; kill switch NEUTRON_NORMAL_FOLLOWS_MONITOR=0 (see set_raw_window_pos). */
+static BOOL neutron_normal_follows_monitor(void)
+{
+    static int on = -1;
+    if (on < 0)
+    {
+        const char *e = getenv( "NEUTRON_NORMAL_FOLLOWS_MONITOR" );
+        on = !e || e[0] != '0';
+        if (!on) ERR( "neutron-gateresolved: NEUTRON_NORMAL_FOLLOWS_MONITOR = 0 (environment)\n" );
+    }
+    return on;
+}
+
+/* NEUTRON normal-follows-monitor: the graphics driver moved a maximized window to the monitor the compositor shows
+ * it on (on Wayland the compositor, not the app, picks the output). Windows keeps a maximized window's restore rect
+ * on the monitor it is maximized on, so carry the restore rect over: same offset from the work area, scaled by the
+ * dpi ratio, kept inside the new work area. Without it Lightroom Classic, maximized on a 100% screen, saved a restore
+ * rect on the 175% primary and took its whole UI scale from that rect at the next launch (substrate.dll
+ * MonitorFromRect(normalPosition) -> GetDpiForMonitor). Per-monitor-aware windows only: their restore rect is in
+ * raw coordinates. */
+static void neutron_move_normal_rect( HWND hwnd, RECT new_raw )
+{
+    MONITORINFO old_info, new_info;
+    UINT old_dpi, new_dpi, raw_dpi;
+    RECT normal;
+    LONG w, h, x, y, work_w, work_h;
+    WND *win;
+
+    if (!neutron_normal_follows_monitor()) return;
+    if (!NTUSER_DPI_CONTEXT_IS_MONITOR_AWARE( get_window_dpi_awareness_context( hwnd ) )) return;
+    if (!(win = get_win_ptr( hwnd )) || win == WND_OTHER_PROCESS || win == WND_DESKTOP) return;
+    normal = win->normal_rect;
+    if (!(win->dwStyle & WS_MAXIMIZE) || (win->dwStyle & WS_CHILD) || IsRectEmpty( &normal ))
+    {
+        release_win_ptr( win );
+        return;
+    }
+    release_win_ptr( win );
+
+    old_info = monitor_info_from_rect( normal, 0 );
+    new_info = monitor_info_from_rect( new_raw, 0 );
+    if (EqualRect( &old_info.rcMonitor, &new_info.rcMonitor ) || IsRectEmpty( &new_info.rcWork )) return;
+    if (!(old_dpi = monitor_dpi_from_rect( normal, 0, &raw_dpi ))) return;
+    if (!(new_dpi = monitor_dpi_from_rect( new_raw, 0, &raw_dpi ))) return;
+
+    work_w = new_info.rcWork.right - new_info.rcWork.left;
+    work_h = new_info.rcWork.bottom - new_info.rcWork.top;
+    w = min( muldiv( normal.right - normal.left, new_dpi, old_dpi ), work_w );
+    h = min( muldiv( normal.bottom - normal.top, new_dpi, old_dpi ), work_h );
+    x = new_info.rcWork.left + muldiv( normal.left - old_info.rcWork.left, new_dpi, old_dpi );
+    y = new_info.rcWork.top + muldiv( normal.top - old_info.rcWork.top, new_dpi, old_dpi );
+    x = max( new_info.rcWork.left, min( x, new_info.rcWork.right - w ) );
+    y = max( new_info.rcWork.top, min( y, new_info.rcWork.bottom - h ) );
+
+    if (!(win = get_win_ptr( hwnd )) || win == WND_OTHER_PROCESS || win == WND_DESKTOP) return;
+    ERR( "neutron-normal-follows: hwnd=%p restore rect %s -> (%d,%d)-(%d,%d), dpi %u -> %u\n", hwnd,
+         wine_dbgstr_rect( &normal ), (int)x, (int)y, (int)(x + w), (int)(y + h), old_dpi, new_dpi );
+    SetRect( &win->normal_rect, x, y, x + w, y + h );
+    release_win_ptr( win );
+}
+
 static BOOL set_raw_window_pos( HWND hwnd, RECT rect, UINT flags, BOOL internal )
 {
+    RECT raw = rect;
+    BOOL ret;
+
     TRACE( "hwnd %p, rect %s, flags %#x, internal %u\n", hwnd, wine_dbgstr_rect(&rect), flags, internal );
 
-    rect = map_rect_raw_to_virt( rect, get_thread_dpi() );
+    rect = map_window_rect_raw_to_virt( rect, get_thread_dpi() );
 
     if (internal)
     {
@@ -7408,7 +7491,9 @@
         return TRUE;
     }
 
-    return NtUserSetWindowPos( hwnd, 0, rect.left, rect.top, rect.right - rect.left, rect.bottom - rect.top, flags );
+    ret = NtUserSetWindowPos( hwnd, 0, rect.left, rect.top, rect.right - rect.left, rect.bottom - rect.top, flags );
+    if (ret && !(flags & SWP_NOMOVE)) neutron_move_normal_rect( hwnd, raw );
+    return ret;
 }
 
 BOOL get_present_rect( HWND hwnd, RECT *rect, UINT dpi )
