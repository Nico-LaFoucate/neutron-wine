     size_t stream_size;
     const BYTE *stream_start;
-    int next_i;
     int next_r;
 };
 
 struct patch_file_header {
     DWORD flags;
+    DWORD flags_2;
     DWORD timestamp;
+    DWORD coff_base;
+    DWORD coff_timestamp;
+    DWORD resource_timestamp;
+    size_t window_size;
     size_t patched_size;
     DWORD patched_crc32;
     unsigned input_file_count;
@@ -144,6 +156,33 @@
     | PATCH_OPTION_EXTRA_FLAGS)
 
 
+/* read a byte-aligned little-endian UINT16 from input and set error if eof
+ */
+static inline UINT16 read_raw_uint16(struct patch_file_header *ph)
+{
+    const BYTE *src = ph->src;
+
+    ph->src += 2;
+    if (ph->src > ph->end)
+    {
+        ph->err = ERROR_PATCH_CORRUPT;
+        return 0;
+    }
+    return src[0] | (src[1] << 8);
+}
+
+/* read a byte and set error if eof
+ */
+static inline BYTE read_raw_byte(struct patch_file_header *ph)
+{
+    if (ph->src >= ph->end)
+    {
+        ph->err = ERROR_PATCH_CORRUPT;
+        return 0;
+    }
+    return *ph->src++;
+}
+
 /* read a byte-aligned little-endian UINT32 from input and set error if eof
  */
 static inline UINT32 read_raw_uint32(struct patch_file_header *ph)
@@ -257,6 +296,60 @@
     return 0;
 }
 
+/* Read the table of (old RVA, new RVA) pairs used by the PE transform
+ */
+static int read_rift_table(struct patch_file_header *ph, struct input_file_info *fi)
+{
+    ULONG old_rva = 0;
+    ULONG new_rva = 0;
+    UINT64 count;
+    ULONG i;
+
+    count = read_uvli(ph);
+    if (ph->err != ERROR_SUCCESS)
+        return -1;
+
+    /* each entry takes at least two bytes */
+    if (count > (UINT64)(ph->end - ph->src) / 2)
+    {
+        ph->err = ERROR_PATCH_CORRUPT;
+        return -1;
+    }
+    if (count == 0)
+        return 0;
+
+    TRACE("rift table of %u entries\n", (unsigned)count);
+
+    fi->rift_table = malloc(count * sizeof(fi->rift_table[0]));
+    if (fi->rift_table == NULL)
+    {
+        ph->err = ERROR_OUTOFMEMORY;
+        return -1;
+    }
+    fi->rift_count = (ULONG)count;
+
+    for (i = 0; i < fi->rift_count; ++i)
+    {
+        old_rva += (ULONG)read_uvli(ph);
+        new_rva += (ULONG)read_svli(ph);
+        fi->rift_table[i].old_rva = old_rva;
+        fi->rift_table[i].new_rva = new_rva;
+    }
+    return (ph->err == ERROR_SUCCESS) ? 0 : -1;
+}
+
+static void free_header(struct patch_file_header *ph)
+{
+    unsigned i;
+
+    if (ph->file_table == NULL)
+        return;
+    for (i = 0; i < ph->input_file_count; ++i)
+        free(ph->file_table[i].rift_table);
+    free(ph->file_table);
+    ph->file_table = NULL;
+}
+
 static int read_header(struct patch_file_header *ph, const BYTE *buf, size_t size)
 {
     unsigned fileno;
