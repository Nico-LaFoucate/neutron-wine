+/* Get the LZX window size: given in the patch, or derived from the file sizes
+ * as the smallest sufficient power of two */
+static size_t get_window_size(const struct patch_file_header *ph, ULONG old_file_size)
+{
+    size_t window = (ph->flags & PATCH_OPTION_USE_LZX_LARGE) ? MAX_LARGE_WINDOW : MAX_NORMAL_WINDOW;
+    /* round up the old file size per the lzxd spec */
+    size_t total = (((size_t)old_file_size + 0x7FFF) & ~(size_t)0x7FFF) + ph->patched_size;
+
+    if (ph->window_size != 0)
+        return ph->window_size;
+
+    if (total <= MIN_DERIVED_WINDOW)
+        return MIN_DERIVED_WINDOW;
+
+    while (total <= window / 2)
+        window /= 2;
+    return window;
