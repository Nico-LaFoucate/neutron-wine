+
+struct rift_entry {
+    ULONG old_rva;
+    ULONG new_rva;
+};
+
+enum pe_normalize_result {
+    PE_UNCHANGED,
+    PE_CHANGED,
+    PE_MALFORMED,
+};
+
+enum pe_normalize_result pe_normalize(BYTE *buf, ULONG size, ULONG option_flags,
+    ULONG new_image_base, ULONG new_timestamp);
