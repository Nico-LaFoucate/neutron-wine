--- a/dlls/mspatcha/pe.c
+++ b/dlls/mspatcha/pe.c
@@ -0,0 +1,1368 @@
+/*
+ * PatchAPI processing of 32-bit PE images
+ *
+ * Copyright 2026 AdobeWine
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ *
+ * Two kinds of processing are done on old files which are 32-bit PE images:
+ *
+ * - Normalization undoes the changes that installing an image usually makes
+ *   to it (rebasing, binding, lock prefix removal, checksum), so the old file
+ *   CRC recorded in a patch can be checked against any installed copy.
+ *
+ * - The rift transform moves the addresses in the old image to where they
+ *   are in the new image, following a table of (old RVA, new RVA) pairs
+ *   stored in the patch, so the old image makes a better LZX dictionary.
+ *   The patch creator does the same, so the transform must match exactly.
+ *
+ * All offsets here are into the file as stored on disk, not a mapped image.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winnt.h"
+#include "wine/debug.h"
+
+#include "patchapi.h"
+
+#include "pa19.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mspatcha);
+
+/* transform bits in the second patch option field */
+#define TRANSFORM_NO_RELOCS     0x0001
+#define TRANSFORM_NO_IMPORTS    0x0002
+#define TRANSFORM_NO_EXPORTS    0x0004
+#define TRANSFORM_NO_JUMPS      0x0008
+#define TRANSFORM_NO_CALLS      0x0010
+#define TRANSFORM_NO_RESOURCES  0x0020
+#define TRANSFORM_RESOURCES_V2  0x0100
+#define TRANSFORM_RELOCS_V2     0x0200
+
+/* byte map flags */
+#define MAP_DONE        0x01  /* already handled, or not code */
+#define MAP_DIRECTORY   0x02  /* headers and data directories */
+
+/* resource directories nested deeper than this are not followed */
+#define MAX_RESOURCE_DEPTH 32
+
+static inline UINT16 get_word(const BYTE *p)
+{
+    return p[0] | (p[1] << 8);
+}
+
+static inline UINT32 get_dword(const BYTE *p)
+{
+    return p[0] | (p[1] << 8) | (p[2] << 16) | ((UINT32)p[3] << 24);
+}
+
+static inline void put_word(BYTE *p, UINT16 v)
+{
+    p[0] = (BYTE)v;
+    p[1] = (BYTE)(v >> 8);
+}
+
+static inline void put_dword(BYTE *p, UINT32 v)
+{
+    p[0] = (BYTE)v;
+    p[1] = (BYTE)(v >> 8);
+    p[2] = (BYTE)(v >> 16);
+    p[3] = (BYTE)(v >> 24);
+}
+
+struct pe_image
+{
+    BYTE *base;
+    ULONG size;
+    IMAGE_NT_HEADERS32 *nt;
+    IMAGE_SECTION_HEADER *sections;
+    unsigned int section_count;
+    ULONG dir_count;
+};
+
+/* Validate the headers of a PE32 image held in a file buffer */
+static BOOL pe_image_init(struct pe_image *img, BYTE *buf, ULONG size)
+{
+    IMAGE_NT_HEADERS32 *nt;
+    ULONG nt_offset;
+    UINT64 sections_offset;
+    UINT64 dirs_offset;
+
+    if (buf == NULL || size < 0x200)
+        return FALSE;
+    if (get_word(buf) != IMAGE_DOS_SIGNATURE)
+        return FALSE;
+
+    nt_offset = get_dword(buf + FIELD_OFFSET(IMAGE_DOS_HEADER, e_lfanew));
+    if (nt_offset >= size || size - nt_offset < sizeof(IMAGE_NT_HEADERS32))
+        return FALSE;
+
+    nt = (IMAGE_NT_HEADERS32 *)(buf + nt_offset);
+    if (nt->Signature != IMAGE_NT_SIGNATURE || nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR32_MAGIC)
+        return FALSE;
+
+    sections_offset = (UINT64)nt_offset + FIELD_OFFSET(IMAGE_NT_HEADERS32, OptionalHeader)
+        + nt->FileHeader.SizeOfOptionalHeader;
+    if (sections_offset <= nt_offset
+        || sections_offset + (UINT64)nt->FileHeader.NumberOfSections * sizeof(IMAGE_SECTION_HEADER) > size)
+        return FALSE;
+
+    dirs_offset = (UINT64)nt_offset + FIELD_OFFSET(IMAGE_NT_HEADERS32, OptionalHeader.DataDirectory);
+    if (dirs_offset + (UINT64)nt->OptionalHeader.NumberOfRvaAndSizes * sizeof(IMAGE_DATA_DIRECTORY) > size)
+        return FALSE;
+
+    img->base = buf;
+    img->size = size;
+    img->nt = nt;
+    img->sections = (IMAGE_SECTION_HEADER *)(buf + sections_offset);
+    img->section_count = nt->FileHeader.NumberOfSections;
+    img->dir_count = nt->OptionalHeader.NumberOfRvaAndSizes;
+    return TRUE;
+}
+
+/* Translate an RVA to a file offset. Zero means the RVA has no file data. */
+static ULONG pe_rva_to_offset(const struct pe_image *img, ULONG rva)
+{
+    unsigned int i;
+
+    if (rva < img->nt->OptionalHeader.SizeOfHeaders)
+        return rva;
+
+    for (i = 0; i < img->section_count; ++i)
+    {
+        const IMAGE_SECTION_HEADER *sec = img->sections + i;
+        if (rva >= sec->VirtualAddress && rva - sec->VirtualAddress < sec->SizeOfRawData)
+            return sec->PointerToRawData + (rva - sec->VirtualAddress);
+    }
+    return 0;
+}
+
+static IMAGE_DATA_DIRECTORY *pe_directory(const struct pe_image *img, unsigned int index)
+{
+    if (index >= img->dir_count)
+        return NULL;
+    return img->nt->OptionalHeader.DataDirectory + index;
+}
+
+/* Get the file offset of a data directory whose contents lie wholly in the
+ * file, or zero if there is none */
+static ULONG pe_directory_in_file(const struct pe_image *img, unsigned int index, ULONG *dir_size)
+{
+    IMAGE_DATA_DIRECTORY *dir = pe_directory(img, index);
+    ULONG offset;
+
+    if (dir == NULL || dir->VirtualAddress == 0)
+        return 0;
+    offset = pe_rva_to_offset(img, dir->VirtualAddress);
+    if (offset == 0 || offset >= img->size || (UINT64)offset + dir->Size > img->size)
+        return 0;
+    *dir_size = dir->Size;
+    return offset;
+}
+
+/* Compare a section name with an 8-byte name, folding case and treating NUL
+ * padding as space padding */
+static BOOL section_name_is(const IMAGE_SECTION_HEADER *sec, const char *name)
+{
+    unsigned int i;
+
+    for (i = 0; i < IMAGE_SIZEOF_SHORT_NAME; ++i)
+    {
+        if ((sec->Name[i] | 0x20) != (BYTE)name[i])
+            return FALSE;
+    }
+    return TRUE;
+}
+
+/***********************************************************************************
+ *  Normalization
+ */
+
+static BOOL normalize_rebase(struct pe_image *img, ULONG new_base)
+{
+    BYTE *buf = img->base;
+    ULONG size = img->size;
+    ULONG dir_size = 0;
+    ULONG pos = pe_directory_in_file(img, IMAGE_DIRECTORY_ENTRY_BASERELOC, &dir_size);
+    LONG remaining;
+    UINT32 delta;
+
+    if (pos == 0 || size - pos < sizeof(IMAGE_BASE_RELOCATION))
+        return FALSE;
+
+    delta = new_base - img->nt->OptionalHeader.ImageBase;
+    img->nt->OptionalHeader.ImageBase = new_base;
+
+    remaining = dir_size;
+    while (remaining > 0)
+    {
+        ULONG page = get_dword(buf + pos);
+        ULONG block_size = get_dword(buf + pos + 4);
+        ULONG page_offset;
+        ULONG entry_pos;
+        ULONG count;
+
+        if (block_size > (ULONG)remaining || block_size <= sizeof(IMAGE_BASE_RELOCATION))
+            break;
+
+        page_offset = pe_rva_to_offset(img, page);
+        entry_pos = pos + sizeof(IMAGE_BASE_RELOCATION);
+
+        /* A HIGHADJ entry takes the following entry as its low part and counts
+         * it, even when it is the last entry of the block. The count then wraps
+         * around and Windows goes on reading entries up to the end of the file,
+         * before going on with the next block as usual. */
+        for (count = (block_size - sizeof(IMAGE_BASE_RELOCATION)) / 2; count != 0; --count)
+        {
+            UINT16 entry;
+            UINT64 target;
+            UINT32 value;
+            INT16 low = 0;
+
+            if ((UINT64)entry_pos + 2 > size)
+                break;
+            entry = get_word(buf + entry_pos);
+            entry_pos += 2;
+            target = (UINT64)page_offset + (entry & 0xfff);
+
+            if ((entry >> 12) == IMAGE_REL_BASED_HIGHADJ)
+            {
+                if ((UINT64)entry_pos + 2 <= size)
+                    low = (INT16)get_word(buf + entry_pos);
+                entry_pos += 2;
+                --count;
+            }
+
+            if (target + 2 > size)
+                continue;
+
+            switch (entry >> 12)
+            {
+            case IMAGE_REL_BASED_HIGH:
+                value = ((UINT32)get_word(buf + target) << 16) + delta;
+                put_word(buf + target, (UINT16)(value >> 16));
+                break;
+            case IMAGE_REL_BASED_LOW:
+                put_word(buf + target, (UINT16)(get_word(buf + target) + delta));
+                break;
+            case IMAGE_REL_BASED_HIGHLOW:
+                if (target + 4 <= size)
+                    put_dword(buf + target, get_dword(buf + target) + delta);
+                break;
+            case IMAGE_REL_BASED_HIGHADJ:
+                value = ((UINT32)get_word(buf + target) << 16) + low + 0x8000 + delta;
+                put_word(buf + target, (UINT16)(value >> 16));
+                break;
+            default:
+                break;
+            }
+        }
+
+        pos += block_size;
+        remaining -= block_size;
+        if ((UINT64)pos + sizeof(IMAGE_BASE_RELOCATION) > size)
+            break;
+    }
+
+    /* reported as a change even when the table turned out to be truncated */
+    return TRUE;
+}
+
+static BOOL normalize_binding(struct pe_image *img)
+{
+    BYTE *buf = img->base;
+    ULONG size = img->size;
+    ULONG dir_size = 0;
+    ULONG offset;
+    BOOL changed = FALSE;
+    unsigned int i;
+
+    offset = pe_directory_in_file(img, IMAGE_DIRECTORY_ENTRY_BOUND_IMPORT, &dir_size);
+    if (offset != 0)
+    {
+        IMAGE_DATA_DIRECTORY *dir = pe_directory(img, IMAGE_DIRECTORY_ENTRY_BOUND_IMPORT);
+        memset(buf + offset, 0, dir_size);
+        dir->VirtualAddress = 0;
+        dir->Size = 0;
+        changed = TRUE;
+    }
+
+    offset = pe_directory_in_file(img, IMAGE_DIRECTORY_ENTRY_IMPORT, &dir_size);
+    if (offset != 0)
+    {
+        ULONG desc;
+
+        for (desc = offset; (UINT64)desc + sizeof(IMAGE_IMPORT_DESCRIPTOR) <= size;
+             desc += sizeof(IMAGE_IMPORT_DESCRIPTOR))
+        {
+            ULONG original_thunk = get_dword(buf + desc);
+            ULONG first_thunk = get_dword(buf + desc + 16);
+
+            if (original_thunk == 0)
+                break;
+
+            if (get_dword(buf + desc + 4) != 0)
+            {
+                ULONG src = pe_rva_to_offset(img, original_thunk);
+                ULONG dst = pe_rva_to_offset(img, first_thunk);
+
+                /* unbind: restore the import address table from the lookup table */
+                put_dword(buf + desc + 4, 0);
+                changed = TRUE;
+                if (src != 0 && src < size && dst != 0 && dst < size)
+                {
+                    while ((UINT64)src + 4 <= size && (UINT64)dst + 4 <= size)
+                    {
+                        UINT32 thunk = get_dword(buf + src);
+                        if (thunk == 0)
+                            break;
+                        put_dword(buf + dst, thunk);
+                        src += 4;
+                        dst += 4;
+                    }
+                }
+            }
+            if (get_dword(buf + desc + 8) != 0)
+            {
+                put_dword(buf + desc + 8, 0);
+                changed = TRUE;
+            }
+        }
+    }
+
+    /* binding makes the import section writable; make it so in every copy */
+    for (i = 0; i < img->section_count; ++i)
+    {
+        IMAGE_SECTION_HEADER *sec = img->sections + i;
+
+        if (!section_name_is(sec, ".idata  "))
+            continue;
+        if (!(sec->Characteristics & IMAGE_SCN_MEM_WRITE))
+        {
+            sec->Characteristics |= IMAGE_SCN_MEM_READ | IMAGE_SCN_MEM_WRITE;
+            changed = TRUE;
+        }
+        break;
+    }
+
+    return changed;
+}
+
+/* Restore lock prefixes that may have been replaced with NOPs on single-processor systems */
+static enum pe_normalize_result normalize_lock_prefixes(struct pe_image *img)
+{
+    BYTE *buf = img->base;
+    ULONG size = img->size;
+    ULONG image_base = img->nt->OptionalHeader.ImageBase;
+    ULONG dir_size = 0;
+    ULONG offset;
+    ULONG table_va;
+    ULONG pos;
+    BOOL changed = FALSE;
+
+    offset = pe_directory_in_file(img, IMAGE_DIRECTORY_ENTRY_LOAD_CONFIG, &dir_size);
+    if (offset == 0 || (UINT64)offset + 0x24 > size)
+        return PE_UNCHANGED;
+
+    table_va = get_dword(buf + offset + 0x20);
+    if (table_va == 0)
+        return PE_UNCHANGED;
+    if (table_va < image_base)
+        return PE_MALFORMED;
+
+    pos = pe_rva_to_offset(img, table_va - image_base);
+    if (pos == 0 || pos >= size)
+        return PE_UNCHANGED;
+
+    for (;;)
+    {
+        ULONG va, target;
+
+        if ((UINT64)pos + 4 > size)
+            return PE_MALFORMED;  /* no terminator */
+
+        va = get_dword(buf + pos);
+        if (va == 0)
+            break;
+        if (va < image_base)
+            return PE_MALFORMED;
+
+        target = pe_rva_to_offset(img, va - image_base);
+        if (target != 0 && target < size && buf[target] != 0xf0)
+        {
+            buf[target] = 0xf0;
+            changed = TRUE;
+        }
+        pos += 4;
+    }
+    return changed ? PE_CHANGED : PE_UNCHANGED;
+}
+
+static UINT32 pe_checksum(const BYTE *buf, ULONG size)
+{
+    UINT32 sum = 0;
+    ULONG i;
+
+    for (i = 0; i + 1 < size; i += 2)
+    {
+        sum += get_word(buf + i);
+        sum = (sum & 0xffff) + (sum >> 16);
+    }
+    if (size & 1)
+    {
+        sum += buf[size - 1];
+        sum = (sum & 0xffff) + (sum >> 16);
+    }
+    sum = (sum & 0xffff) + (sum >> 16);
+    return sum + size;
+}
+
+/* Normalize a 32-bit PE image in place. Images of other kinds are left unchanged.
+ * PE_MALFORMED means normalization stopped part way; callers treat it as a change. */
+enum pe_normalize_result pe_normalize(BYTE *buf, ULONG size, ULONG option_flags,
+    ULONG new_image_base, ULONG new_timestamp)
+{
+    struct pe_image img;
+    BOOL changed = FALSE;
+
+    if (!pe_image_init(&img, buf, size))
+        return PE_UNCHANGED;
+
+    if (!(option_flags & PATCH_OPTION_NO_REBASE))
+    {
+        if (new_timestamp != 0 && new_timestamp != img.nt->FileHeader.TimeDateStamp)
+        {
+            img.nt->FileHeader.TimeDateStamp = new_timestamp;
+            changed = TRUE;
+        }
+        if (new_image_base != 0 && new_image_base != img.nt->OptionalHeader.ImageBase)
+            changed |= normalize_rebase(&img, new_image_base);
+    }
+
+    if (!(option_flags & PATCH_OPTION_NO_BINDFIX))
+        changed |= normalize_binding(&img);
+
+    if (!(option_flags & PATCH_OPTION_NO_LOCKFIX))
+    {
+        enum pe_normalize_result res = normalize_lock_prefixes(&img);
+
+        /* a malformed table ends normalization; the checksum is not updated */
+        if (res == PE_MALFORMED)
+            return PE_MALFORMED;
+        if (res == PE_CHANGED)
+            changed = TRUE;
+    }
+
+    if (!(option_flags & PATCH_OPTION_NO_CHECKSUM))
+    {
+        if (changed)
+        {
+            img.nt->OptionalHeader.CheckSum = 0;
+            img.nt->OptionalHeader.CheckSum = pe_checksum(buf, size);
+        }
+    }
+    else if (img.nt->OptionalHeader.CheckSum != 0)
+    {
+        img.nt->OptionalHeader.CheckSum = 0;
+        changed = TRUE;
+    }
+
+    return changed ? PE_CHANGED : PE_UNCHANGED;
+}
+
+/***********************************************************************************
+ *  Rift transform
+ */
+
+struct transform
+{
+    struct pe_image img;
+    BYTE *map;
+    const struct rift_entry *rifts;
+    ULONG rift_count;
+    ULONG bits;
+    BOOL v2;
+};
+
+/* Move an old RVA to its place in the new image */
+static ULONG rift_map(const struct transform *t, ULONG rva)
+{
+    ULONG lo = 0, hi = t->rift_count;
+
+    /* find the last entry whose old RVA is not above rva */
+    while (lo < hi)
+    {
+        ULONG mid = lo + (hi - lo) / 2;
+        if (t->rifts[mid].old_rva <= rva)
+            lo = mid + 1;
+        else
+            hi = mid;
+    }
+    if (lo == 0)
+        return rva;
+    return rva + (t->rifts[lo - 1].new_rva - t->rifts[lo - 1].old_rva);
+}
+
+static void map_mark(struct transform *t, UINT64 offset, UINT64 length, BYTE flags)
+{
+    UINT64 end = offset + length;
+
+    if (offset >= t->img.size)
+        return;
+    if (end > t->img.size)
+        end = t->img.size;
+    for (; offset < end; ++offset)
+        t->map[offset] |= flags;
+}
+
+static BOOL map_any(const struct transform *t, ULONG offset, ULONG length, BYTE flags)
+{
+    ULONG i;
+    for (i = 0; i < length; ++i)
+    {
+        if (t->map[offset + i] & flags)
+            return TRUE;
+    }
+    return FALSE;
+}
+
+/* Replace an absolute address at a file offset with its new address, if it moves */
+static void remap_address(struct transform *t, ULONG offset)
+{
+    ULONG image_base = t->img.nt->OptionalHeader.ImageBase;
+    UINT32 va = get_dword(t->img.base + offset);
+    UINT32 new_va = rift_map(t, va - image_base) + image_base;
+
+    if (new_va != va)
+        put_dword(t->img.base + offset, new_va);
+}
+
+/* Replace an RVA at a file offset with its new value */
+static void remap_rva(struct transform *t, ULONG offset)
+{
+    UINT32 rva = get_dword(t->img.base + offset);
+    UINT32 new_rva = rift_map(t, rva);
+
+    if (new_rva != rva)
+        put_dword(t->img.base + offset, new_rva);
+}
+
+static void transform_mark_non_code(struct transform *t)
+{
+    IMAGE_OPTIONAL_HEADER32 *opt = &t->img.nt->OptionalHeader;
+    unsigned int i;
+    ULONG count;
+
+    for (i = 0; i < t->img.section_count; ++i)
+    {
+        const IMAGE_SECTION_HEADER *sec = t->img.sections + i;
+        if (!(sec->Characteristics & IMAGE_SCN_MEM_EXECUTE) && sec->PointerToRawData < t->img.size)
+            map_mark(t, sec->PointerToRawData, sec->SizeOfRawData, MAP_DONE);
+    }
+
+    if (opt->SizeOfHeaders > t->img.size)
+        opt->SizeOfHeaders = t->img.size;
+    map_mark(t, 0, opt->SizeOfHeaders, MAP_DONE | MAP_DIRECTORY);
+
+    count = min(t->img.dir_count, IMAGE_NUMBEROF_DIRECTORY_ENTRIES);
+    for (i = 0; i < count; ++i)
+    {
+        const IMAGE_DATA_DIRECTORY *dir = opt->DataDirectory + i;
+        ULONG offset;
+
+        if (dir->VirtualAddress == 0 || dir->Size == 0)
+            continue;
+        offset = pe_rva_to_offset(&t->img, dir->VirtualAddress);
+        if (offset == 0 && t->v2)
+            continue;
+        map_mark(t, offset, dir->Size, MAP_DONE | MAP_DIRECTORY);
+    }
+}
+
+/* Without a relocation table, treat every value that looks like an address
+ * inside the image as one */
+static void transform_address_scan(struct transform *t, ULONG start, ULONG low, ULONG high, BOOL v2)
+{
+    BYTE *buf = t->img.base;
+    ULONG size = t->img.size;
+    ULONG pos = start;
+
+    if (size < 5)
+        return;
+
+    while (pos < size - 4)
+    {
+        UINT32 value = get_dword(buf + pos);
+        BOOL in_range = v2 ? (value > low && value < high) : (value >= low && value < high);
+
+        if (in_range && !(v2 && map_any(t, pos, 4, MAP_DIRECTORY)))
+        {
+            map_mark(t, pos, 4, MAP_DONE);
+            remap_address(t, pos);
+            pos += 4;
+        }
+        else
+        {
+            ++pos;
+        }
+    }
+}
+
+struct reloc_record
+{
+    ULONG rva;
+    BYTE type;
+    UINT16 extra;
+};
+
+static inline void swap_records(struct reloc_record *a, struct reloc_record *b)
+{
+    struct reloc_record tmp = *a;
+    *a = *b;
+    *b = tmp;
+}
+
+/* Quicksort with the partitioning used by the patch creator. Records with
+ * equal RVAs keep the relative order this produces, which is written back. */
+static void sort_reloc_records(struct reloc_record *rec, LONG lo, LONG hi)
+{
+    while (hi > lo)
+    {
+        LONG mid = lo + (hi - lo) / 2;
+        ULONG pivot = rec[mid].rva;
+        LONG l = lo, r = hi;
+        LONG p;
+
+        for (;;)
+        {
+            if (r < l)
+                break;
+            while (l <= r && rec[l].rva <= pivot)
+                ++l;
+            while (l <= r && pivot <= rec[r].rva)
+                --r;
+            if (l < r)
+            {
+                swap_records(rec + l, rec + r);
+                ++l;
+                --r;
+                if (l <= r)
+                    continue;
+                break;
+            }
+            if (l == r)
+                continue;
+            break;
+        }
+
+        p = mid;
+        if (l < mid)
+        {
+            swap_records(rec + l, rec + mid);
+            p = l;
+        }
+        else if (r > mid)
+        {
+            swap_records(rec + r, rec + mid);
+            p = r;
+        }
+
+        /* the two parts are independent; recurse into the smaller one */
+        if (p - lo < hi - p)
+        {
+            if (p - 1 > lo)
+                sort_reloc_records(rec, lo, p - 1);
+            lo = p + 1;
+        }
+        else
+        {
+            if (hi > p + 1)
+                sort_reloc_records(rec, p + 1, hi);
+            hi = p - 1;
+        }
+    }
+}
+
+static DWORD transform_relocs(struct transform *t)
+{
+    BYTE *buf = t->img.base;
+    ULONG size = t->img.size;
+    ULONG dir_size = 0;
+    ULONG dir_offset = pe_directory_in_file(&t->img, IMAGE_DIRECTORY_ENTRY_BASERELOC, &dir_size);
+    struct reloc_record *records;
+    ULONG record_count = 0;
+    ULONG pos, room, out, index;
+    LONG remaining;
+    unsigned int i;
+
+    if (dir_offset == 0)
+    {
+        IMAGE_FILE_HEADER *fh = &t->img.nt->FileHeader;
+        IMAGE_OPTIONAL_HEADER32 *opt = &t->img.nt->OptionalHeader;
+
+        if (fh->Machine == IMAGE_FILE_MACHINE_I386 && t->img.section_count != 0)
+        {
+            transform_address_scan(t, t->img.sections[0].PointerToRawData,
+                opt->ImageBase + t->img.sections[0].VirtualAddress, opt->ImageBase + opt->SizeOfImage,
+                (t->bits & TRANSFORM_RELOCS_V2) != 0);
+        }
+        return ERROR_SUCCESS;
+    }
+
+    map_mark(t, dir_offset, dir_size, MAP_DONE | MAP_DIRECTORY);
+
+    records = malloc((dir_size / 2 + 1) * sizeof(*records));
+    if (records == NULL)
+        return ERROR_OUTOFMEMORY;
+
+    /* collect the relocations at their new RVAs, moving the addresses they point to */
+    pos = dir_offset;
+    remaining = dir_size;
+    while (remaining > 0)
+    {
+        ULONG page, block_size, page_offset, entry_count;
+
+        if ((UINT64)pos + sizeof(IMAGE_BASE_RELOCATION) > size)
+            goto fail;
+
+        page = get_dword(buf + pos);
+        block_size = get_dword(buf + pos + 4);
+        if (block_size > (ULONG)remaining || block_size < sizeof(IMAGE_BASE_RELOCATION) + 1)
+            break;
+
+        page_offset = pe_rva_to_offset(&t->img, page);
+        entry_count = (block_size - sizeof(IMAGE_BASE_RELOCATION)) / 2;
+
+        for (index = 0; index < entry_count; ++index)
+        {
+            ULONG entry_pos = pos + sizeof(IMAGE_BASE_RELOCATION) + index * 2;
+            struct reloc_record *rec = records + record_count;
+            UINT16 entry;
+            UINT64 target;
+
+            if ((UINT64)entry_pos + 2 > size)
+                goto fail;
+
+            entry = get_word(buf + entry_pos);
+            if ((entry >> 12) == IMAGE_REL_BASED_ABSOLUTE)
+                continue;
+
+            rec->rva = rift_map(t, page + (entry & 0xfff));
+            rec->type = entry >> 12;
+            rec->extra = 0;
+            ++record_count;
+
+            target = (UINT64)page_offset + (entry & 0xfff);
+            switch (rec->type)
+            {
+            case IMAGE_REL_BASED_HIGH:
+            case IMAGE_REL_BASED_LOW:
+                if (target + 2 < size)
+                    map_mark(t, target, 2, MAP_DONE);
+                break;
+            case IMAGE_REL_BASED_HIGHLOW:
+                if (target + 4 <= size)
+                {
+                    map_mark(t, target, 4, MAP_DONE);
+                    remap_address(t, target);
+                }
+                break;
+            case IMAGE_REL_BASED_HIGHADJ:
+                if (target + 2 < size)
+                    map_mark(t, target, 2, MAP_DONE);
+                if (index + 1 < entry_count)
+                {
+                    ++index;
+                    entry_pos += 2;
+                    if ((UINT64)entry_pos + 2 > size)
+                        goto fail;
+                    rec->extra = get_word(buf + entry_pos);
+                }
+                break;
+            default:
+                break;
+            }
+        }
+
+        pos += block_size;
+        remaining -= block_size;
+    }
+
+    if (record_count > 1)
+        sort_reloc_records(records, 0, record_count - 1);
+
+    /* write the table back in place */
+    room = dir_size;
+    for (i = 0; i < t->img.section_count; ++i)
+    {
+        const IMAGE_SECTION_HEADER *sec = t->img.sections + i;
+
+        if (section_name_is(sec, ".reloc  ") && dir_offset >= sec->PointerToRawData
+            && dir_offset - sec->PointerToRawData < sec->SizeOfRawData)
+        {
+            UINT64 end = (UINT64)sec->PointerToRawData + sec->SizeOfRawData;
+            if (end > size)
+                end = size;
+            room = end - dir_offset;
+            break;
+        }
+    }
+    room &= ~1u;
+
+    out = dir_offset;
+    index = 0;
+    while (room > sizeof(IMAGE_BASE_RELOCATION) && index < record_count)
+    {
+        ULONG block = out;
+        ULONG page = records[index].rva & ~0xfffu;
+
+        put_dword(buf + block, page);
+        room -= sizeof(IMAGE_BASE_RELOCATION);
+        out = block + sizeof(IMAGE_BASE_RELOCATION);
+
+        while (room > 0)
+        {
+            if (index >= record_count || (records[index].rva & ~0xfffu) != page)
+            {
+                /* pad blocks to a multiple of four bytes */
+                if (out & 2)
+                {
+                    put_word(buf + out, 0);
+                    out += 2;
+                    room -= 2;
+                }
+                break;
+            }
+            put_word(buf + out, (records[index].type << 12) | (records[index].rva & 0xfff));
+            ++index;
+            out += 2;
+            room -= 2;
+        }
+        put_dword(buf + block + 4, out - block);
+    }
+
+    free(records);
+    return ERROR_SUCCESS;
+
+fail:
+    TRACE("relocation table runs past the end of the file\n");
+    free(records);
+    return ERROR_PATCH_CORRUPT;
+}
+
+static BOOL transform_thunks(struct transform *t, ULONG thunk_rva)
+{
+    BYTE *buf = t->img.base;
+    ULONG size = t->img.size;
+    ULONG start = pe_rva_to_offset(&t->img, thunk_rva);
+    ULONG pos;
+
+    for (pos = start; (UINT64)pos + 4 <= size; pos += 4)
+    {
+        UINT32 thunk = get_dword(buf + pos);
+        ULONG hint_name, name_end;
+
+        if (thunk == 0)
+            break;
+        if (thunk & IMAGE_ORDINAL_FLAG32)
+            continue;
+
+        hint_name = pe_rva_to_offset(&t->img, thunk);
+        if ((UINT64)hint_name + 2 >= size || (UINT64)hint_name + 4 > size)
+            return FALSE;
+
+        for (name_end = hint_name + 2; name_end < size && buf[name_end]; ++name_end)
+            ;
+        if (name_end >= size)
+            return FALSE;
+
+        /* hint, name and terminator */
+        map_mark(t, hint_name, name_end + 1 - hint_name, MAP_DONE | MAP_DIRECTORY);
+        remap_rva(t, pos);
+    }
+
+    if (pos > start)
+        map_mark(t, start, pos - start, MAP_DONE | MAP_DIRECTORY);
+    return TRUE;
+}
+
+static BOOL transform_imports(struct transform *t)
+{
+    BYTE *buf = t->img.base;
+    ULONG dir_size = 0;
+    ULONG offset = pe_directory_in_file(&t->img, IMAGE_DIRECTORY_ENTRY_IMPORT, &dir_size);
+    ULONG desc;
+
+    if (offset == 0)
+        return TRUE;
+
+    map_mark(t, offset, dir_size, MAP_DONE | MAP_DIRECTORY);
+
+    for (desc = offset; (UINT64)desc + sizeof(IMAGE_IMPORT_DESCRIPTOR) <= t->img.size;
+         desc += sizeof(IMAGE_IMPORT_DESCRIPTOR))
+    {
+        ULONG original_thunk = get_dword(buf + desc);
+
+        if (original_thunk == 0)
+            break;
+
+        if (get_dword(buf + desc + 4) == 0)
+        {
+            if (!transform_thunks(t, original_thunk))
+                return FALSE;
+            if (!transform_thunks(t, get_dword(buf + desc + 16)))
+                return FALSE;
+        }
+        remap_rva(t, desc + 12);  /* Name */
+        remap_rva(t, desc);       /* OriginalFirstThunk */
+        remap_rva(t, desc + 16);  /* FirstThunk */
+    }
+    return TRUE;
+}
+
+static void transform_rva_array(struct transform *t, ULONG rva, ULONG count)
+{
+    ULONG offset = pe_rva_to_offset(&t->img, rva);
+    ULONG i;
+
+    if ((UINT64)offset + (UINT64)count * 4 <= t->img.size)
+        map_mark(t, offset, (UINT64)count * 4, MAP_DONE | MAP_DIRECTORY);
+
+    for (i = 0; i < count && (UINT64)offset + 4 * (UINT64)i + 4 <= t->img.size; ++i)
+        remap_rva(t, offset + 4 * i);
+}
+
+static void transform_exports(struct transform *t)
+{
+    BYTE *buf = t->img.base;
+    ULONG dir_size = 0;
+    ULONG offset = pe_directory_in_file(&t->img, IMAGE_DIRECTORY_ENTRY_EXPORT, &dir_size);
+    IMAGE_EXPORT_DIRECTORY *exports;
+    ULONG ordinals;
+
+    if (offset == 0 || (UINT64)offset + sizeof(IMAGE_EXPORT_DIRECTORY) > t->img.size)
+        return;
+
+    map_mark(t, offset, dir_size, MAP_DONE | MAP_DIRECTORY);
+    exports = (IMAGE_EXPORT_DIRECTORY *)(buf + offset);
+
+    transform_rva_array(t, exports->AddressOfFunctions, exports->NumberOfFunctions);
+    transform_rva_array(t, exports->AddressOfNames, exports->NumberOfNames);
+
+    ordinals = pe_rva_to_offset(&t->img, exports->AddressOfNameOrdinals);
+    if ((UINT64)ordinals + (UINT64)exports->NumberOfNames * 2 <= t->img.size)
+        map_mark(t, ordinals, (UINT64)exports->NumberOfNames * 2, MAP_DONE | MAP_DIRECTORY);
+
+    remap_rva(t, offset + FIELD_OFFSET(IMAGE_EXPORT_DIRECTORY, Name));
+    remap_rva(t, offset + FIELD_OFFSET(IMAGE_EXPORT_DIRECTORY, AddressOfFunctions));
+    remap_rva(t, offset + FIELD_OFFSET(IMAGE_EXPORT_DIRECTORY, AddressOfNames));
+    remap_rva(t, offset + FIELD_OFFSET(IMAGE_EXPORT_DIRECTORY, AddressOfNameOrdinals));
+}
+
+/* Check the target of a relative branch at section offset 'at' (the opcode
+ * position) and compute its new displacement. */
+static BOOL branch_new_displacement(struct transform *t, const IMAGE_SECTION_HEADER *sec, ULONG at,
+    INT32 displacement, INT32 *new_displacement)
+{
+    ULONG ip = sec->VirtualAddress + at + 5;
+    ULONG target = ip + displacement;
+    ULONG target_offset;
+
+    if (target >= t->img.nt->OptionalHeader.SizeOfImage)
+        return FALSE;
+    target_offset = pe_rva_to_offset(&t->img, target);
+    if (target_offset >= t->img.size || (t->map[target_offset] & MAP_DONE))
+        return FALSE;
+
+    *new_displacement = rift_map(t, target) - rift_map(t, ip);
+    return TRUE;
+}
+
+/* Get the scan range of an executable section, or FALSE if it has none */
+static BOOL code_section_range(const struct transform *t, const IMAGE_SECTION_HEADER *sec, ULONG *len)
+{
+    if (!(sec->Characteristics & IMAGE_SCN_MEM_EXECUTE) || sec->PointerToRawData >= t->img.size)
+        return FALSE;
+    *len = min(sec->Misc.VirtualSize, sec->SizeOfRawData);
+    if ((UINT64)sec->PointerToRawData + *len > t->img.size || *len <= 5)
+        return FALSE;
+    return TRUE;
+}
+
+static void transform_jumps(struct transform *t)
+{
+    BYTE *buf = t->img.base;
+    unsigned int i;
+
+    for (i = 0; i < t->img.section_count; ++i)
+    {
+        const IMAGE_SECTION_HEADER *sec = t->img.sections + i;
+        BYTE *code = buf + sec->PointerToRawData;
+        BYTE *map = t->map + sec->PointerToRawData;
+        ULONG len, at;
+
+        if (!code_section_range(t, sec, &len))
+            continue;
+
+        for (at = 0; at < len - 5; ++at)
+        {
+            INT32 displacement, new_displacement;
+            BOOL near_jcc = FALSE;
+
+            if (code[at] == 0x0f && (code[at + 1] & 0xf0) == 0x80)
+            {
+                /* jcc rel32: continue from the second opcode byte */
+                if (map[at] & MAP_DONE)
+                    continue;
+                ++at;
+                if (at >= len - 5)
+                    continue;
+                near_jcc = TRUE;
+            }
+            else if (code[at] != 0xe9)
+            {
+                continue;
+            }
+
+            if (map_any(t, sec->PointerToRawData + at, 5, MAP_DONE))
+                continue;
+
+            displacement = (INT32)get_dword(code + at + 1);
+            if (displacement >= -128 && displacement <= 127)
+                continue;  /* could have been a short jump; not one we look at */
+
+            if (!branch_new_displacement(t, sec, at, displacement, &new_displacement))
+                continue;
+
+            if (new_displacement >= -128 && new_displacement <= 127)
+            {
+                /* the patch creator rewrites it as a short jump in place */
+                if (near_jcc)
+                {
+                    code[at - 1] = 0x70 | (code[at] & 0x0f);
+                    code[at] = (BYTE)new_displacement;
+                }
+                else
+                {
+                    code[at] = 0xeb;
+                    code[at + 1] = (BYTE)new_displacement;
+                }
+            }
+            else if (new_displacement != displacement)
+            {
+                put_dword(code + at + 1, new_displacement);
+            }
+            at += 4;
+        }
+    }
+}
+
+static void transform_calls(struct transform *t)
+{
+    BYTE *buf = t->img.base;
+    unsigned int i;
+
+    for (i = 0; i < t->img.section_count; ++i)
+    {
+        const IMAGE_SECTION_HEADER *sec = t->img.sections + i;
+        BYTE *code = buf + sec->PointerToRawData;
+        ULONG len, at;
+
+        if (!code_section_range(t, sec, &len))
+            continue;
+
+        for (at = 0; at < len - 5; ++at)
+        {
+            INT32 displacement, new_displacement;
+
+            if (code[at] != 0xe8 || map_any(t, sec->PointerToRawData + at, 5, MAP_DONE))
+                continue;
+
+            displacement = (INT32)get_dword(code + at + 1);
+            if (!branch_new_displacement(t, sec, at, displacement, &new_displacement))
+                continue;
+
+            if (new_displacement != displacement)
+                put_dword(code + at + 1, new_displacement);
+            at += 4;
+        }
+    }
+}
+
+struct resource_walk
+{
+    struct transform *t;
+    ULONG start;        /* file offset of the resource directory */
+    ULONG limit;        /* end of the directory, clipped to the file */
+    ULONG size;         /* directory size */
+    ULONG used;
+    ULONG timestamp;
+    ULONG rva;
+    ULONG mapped_rva;
+    BOOL stop;
+    BOOL error;
+};
+
+/* Remap a directory-relative offset field, keeping its top bit */
+static void resource_remap_offset(struct resource_walk *w, ULONG field)
+{
+    BYTE *p = w->t->img.base + field;
+    UINT32 value = get_dword(p);
+    UINT32 mapped = rift_map(w->t, w->rva + (value & 0x7fffffff)) - w->mapped_rva;
+    UINT32 new_value = (value & 0x80000000) | (mapped & 0x7fffffff);
+
+    if (new_value != value)
+        put_dword(p, new_value);
+}
+
+static void resource_set_timestamp(struct resource_walk *w, ULONG table)
+{
+    BYTE *p = w->t->img.base + table + FIELD_OFFSET(IMAGE_RESOURCE_DIRECTORY, TimeDateStamp);
+
+    if (get_dword(p) != w->timestamp)
+        put_dword(p, w->timestamp);
+}
+
+static void resource_walk_classic(struct resource_walk *w, UINT64 table, unsigned int depth)
+{
+    BYTE *buf = w->t->img.base;
+    unsigned int count, i;
+
+    if (table >= w->limit || table + sizeof(IMAGE_RESOURCE_DIRECTORY) > w->limit
+        || (UINT64)w->used + sizeof(IMAGE_RESOURCE_DIRECTORY) > w->size || depth > MAX_RESOURCE_DEPTH)
+        return;
+
+    resource_set_timestamp(w, table);
+
+    count = get_word(buf + table + FIELD_OFFSET(IMAGE_RESOURCE_DIRECTORY, NumberOfNamedEntries))
+        + get_word(buf + table + FIELD_OFFSET(IMAGE_RESOURCE_DIRECTORY, NumberOfIdEntries));
+
+    for (i = 0; i < count; ++i)
+    {
+        ULONG entry = table + sizeof(IMAGE_RESOURCE_DIRECTORY) + i * sizeof(IMAGE_RESOURCE_DIRECTORY_ENTRY);
+        UINT32 name, offset;
+
+        if ((UINT64)entry + sizeof(IMAGE_RESOURCE_DIRECTORY_ENTRY) >= w->limit)
+            break;
+
+        name = get_dword(buf + entry);
+        offset = get_dword(buf + entry + 4);
+
+        if (offset & 0x80000000)
+        {
+            resource_walk_classic(w, (UINT64)w->start + (offset & 0x7fffffff), depth + 1);
+            if (w->stop)
+                return;
+        }
+        else
+        {
+            UINT64 data = (UINT64)w->start + offset;
+
+            if (data > w->start && data + sizeof(IMAGE_RESOURCE_DATA_ENTRY) < w->limit)
+            {
+                w->used += get_dword(buf + data + FIELD_OFFSET(IMAGE_RESOURCE_DATA_ENTRY, Size));
+                if (w->used > w->size)
+                {
+                    w->stop = TRUE;
+                    return;
+                }
+                remap_rva(w->t, data + FIELD_OFFSET(IMAGE_RESOURCE_DATA_ENTRY, OffsetToData));
+            }
+        }
+
+        resource_remap_offset(w, entry + 4);
+        if (name & 0x80000000)
+            resource_remap_offset(w, entry);
+
+        w->used += sizeof(IMAGE_RESOURCE_DIRECTORY_ENTRY);
+        if (w->used > w->size)
+        {
+            w->stop = TRUE;
+            return;
+        }
+    }
+}
+
+static void resource_walk_v2(struct resource_walk *w, UINT64 table, unsigned int depth)
+{
+    BYTE *buf = w->t->img.base;
+    unsigned int count, i;
+
+    if (table < w->start || table > w->limit - sizeof(IMAGE_RESOURCE_DIRECTORY)
+        || (UINT64)w->used + sizeof(IMAGE_RESOURCE_DIRECTORY) > w->size || depth > MAX_RESOURCE_DEPTH)
+    {
+        w->error = TRUE;
+        return;
+    }
+
+    resource_set_timestamp(w, table);
+
+    count = get_word(buf + table + FIELD_OFFSET(IMAGE_RESOURCE_DIRECTORY, NumberOfNamedEntries))
+        + get_word(buf + table + FIELD_OFFSET(IMAGE_RESOURCE_DIRECTORY, NumberOfIdEntries));
+
+    for (i = 0; i < count; ++i)
+    {
+        ULONG entry = table + sizeof(IMAGE_RESOURCE_DIRECTORY) + i * sizeof(IMAGE_RESOURCE_DIRECTORY_ENTRY);
+        UINT32 name, offset;
+
+        if ((UINT64)entry + sizeof(IMAGE_RESOURCE_DIRECTORY_ENTRY) > w->limit
+            || (UINT64)w->used + sizeof(IMAGE_RESOURCE_DIRECTORY_ENTRY) > w->size)
+        {
+            w->error = TRUE;
+            w->stop = TRUE;
+            return;
+        }
+
+        name = get_dword(buf + entry);
+        offset = get_dword(buf + entry + 4);
+
+        if (offset & 0x80000000)
+        {
+            ULONG sub = offset & 0x7fffffff;
+
+            if (w->size < sizeof(IMAGE_RESOURCE_DIRECTORY) || sub > w->size - sizeof(IMAGE_RESOURCE_DIRECTORY))
+            {
+                w->error = TRUE;
+            }
+            else
+            {
+                resource_walk_v2(w, (UINT64)w->start + sub, depth + 1);
+                if (w->stop)
+                    return;
+                if (w->used > w->size)
+                {
+                    w->error = TRUE;
+                    w->stop = TRUE;
+                    return;
+                }
+            }
+        }
+        else
+        {
+            UINT64 data = (UINT64)w->start + offset;
+
+            if (data < w->start || data + sizeof(IMAGE_RESOURCE_DATA_ENTRY) > w->limit)
+                w->error = TRUE;
+            else
+                remap_rva(w->t, data + FIELD_OFFSET(IMAGE_RESOURCE_DATA_ENTRY, OffsetToData));
+        }
+
+        resource_remap_offset(w, entry + 4);
+        if (name & 0x80000000)
+            resource_remap_offset(w, entry);
+
+        w->used += sizeof(IMAGE_RESOURCE_DIRECTORY_ENTRY);
+    }
+}
+
+static void transform_resources(struct transform *t, ULONG resource_time)
+{
+    struct resource_walk w;
+    ULONG dir_size = 0;
+    ULONG offset = pe_directory_in_file(&t->img, IMAGE_DIRECTORY_ENTRY_RESOURCE, &dir_size);
+
+    if (offset == 0 || dir_size < sizeof(IMAGE_RESOURCE_DIRECTORY))
+        return;
+
+    w.t = t;
+    w.start = offset;
+    w.limit = min(t->img.size, offset + dir_size);
+    w.size = dir_size;
+    w.used = 0;
+    w.timestamp = resource_time;
+    w.rva = pe_directory(&t->img, IMAGE_DIRECTORY_ENTRY_RESOURCE)->VirtualAddress;
+    w.mapped_rva = rift_map(t, w.rva);
+    w.stop = FALSE;
+    w.error = FALSE;
+
+    if (t->bits & TRANSFORM_RESOURCES_V2)
+        resource_walk_v2(&w, offset, 0);
+    else
+        resource_walk_classic(&w, offset, 0);
+
+    if (w.error)
+        TRACE("malformed resource directory\n");
+}
+
+/* Apply the rift transform to a normalized 32-bit PE image in place */
+DWORD pe_transform(BYTE *buf, ULONG size, ULONG transform_bits, ULONG resource_time,
+    const struct rift_entry *rifts, ULONG rift_count)
+{
+    struct transform t;
+    DWORD err = ERROR_SUCCESS;
+
+    if (!pe_image_init(&t.img, buf, size))
+        return ERROR_SUCCESS;
+
+    t.map = calloc(size, 1);
+    if (t.map == NULL)
+        return ERROR_OUTOFMEMORY;
+    t.rifts = rifts;
+    t.rift_count = rift_count;
+    t.bits = transform_bits;
+    t.v2 = (transform_bits & (TRANSFORM_RESOURCES_V2 | TRANSFORM_RELOCS_V2)) != 0;
+
+    transform_mark_non_code(&t);
+
+    if (!t.v2)
+    {
+        if (!(t.bits & TRANSFORM_NO_RELOCS))
+            err = transform_relocs(&t);
+        if (!err && !(t.bits & TRANSFORM_NO_IMPORTS) && !transform_imports(&t))
+            err = ERROR_PATCH_CORRUPT;
+        if (!err)
+        {
+            if (!(t.bits & TRANSFORM_NO_EXPORTS))
+                transform_exports(&t);
+            if (t.img.nt->FileHeader.Machine == IMAGE_FILE_MACHINE_I386)
+            {
+                if (!(t.bits & TRANSFORM_NO_JUMPS))
+                    transform_jumps(&t);
+                if (!(t.bits & TRANSFORM_NO_CALLS))
+                    transform_calls(&t);
+            }
+            if (!(t.bits & TRANSFORM_NO_RESOURCES))
+                transform_resources(&t, resource_time);
+        }
+    }
+    else
+    {
+        if (!(t.bits & TRANSFORM_NO_IMPORTS) && !transform_imports(&t))
+            err = ERROR_PATCH_CORRUPT;
+        if (!err)
+        {
+            if (!(t.bits & TRANSFORM_NO_EXPORTS))
+                transform_exports(&t);
+            if (!(t.bits & TRANSFORM_NO_RESOURCES))
+                transform_resources(&t, resource_time);
+            if (!(t.bits & TRANSFORM_NO_RELOCS))
+                err = transform_relocs(&t);
+        }
+        if (!err && t.img.nt->FileHeader.Machine == IMAGE_FILE_MACHINE_I386)
+        {
+            if (!(t.bits & TRANSFORM_NO_JUMPS))
+                transform_jumps(&t);
+            if (!(t.bits & TRANSFORM_NO_CALLS))
+                transform_calls(&t);
+        }
+    }
+
+    free(t.map);
+    return err;
+}
