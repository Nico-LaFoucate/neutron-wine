--- a/dlls/msi/files.c	2026-11-05 11:32:10.387820731 -0500
+++ b/dlls/msi/files.c	2026-11-08 17:55:48.952878409 -0500
@@ -148,6 +148,216 @@
     return ret;
 }
 
+/* Rollback, as Windows Installer does it: while the script runs, each file this install
+ * writes is recorded with what it was before (missing, or a copy saved under Config.Msi on
+ * the system drive); a failed install then undoes exactly those writes. Files the install
+ * kept (newer, same version or hash match, not scheduled) have no record and stay as they
+ * were. NEUTRON_MSI_NO_ROLLBACK_RECORD=1 restores the previous behavior (rollback removes
+ * every file of every component that was not installed before). */
+BOOL msi_rollback_is_recorded( void )
+{
+    static int recorded = -1;
+
+    if (recorded < 0)
+    {
+        char buf[8];
+        DWORD len = GetEnvironmentVariableA( "NEUTRON_MSI_NO_ROLLBACK_RECORD", buf, sizeof(buf) );
+        recorded = !(len && len < sizeof(buf) && buf[0] == '1');
+        if (!recorded) WARN( "rollback records disabled (NEUTRON_MSI_NO_ROLLBACK_RECORD)\n" );
+    }
+    return recorded;
+}
+
+static BOOL rollback_should_record( MSIPACKAGE *package )
+{
+    return msi_rollback_is_recorded() && !package->need_rollback &&
+           !msi_get_property_int( package->db, L"RollbackDisabled", 0 );
+}
+
+static WCHAR *create_rollback_backup_name( MSIPACKAGE *package )
+{
+    WCHAR dir[MAX_PATH], *name;
+    UINT len = GetWindowsDirectoryW( dir, MAX_PATH );
+
+    if (len < 3 || len >= MAX_PATH || dir[1] != ':') return NULL;
+    lstrcpyW( dir + 3, L"Config.Msi" );
+    if (CreateDirectoryW( dir, NULL ))
+        SetFileAttributesW( dir, FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_SYSTEM );
+    if (!(name = malloc( MAX_PATH * sizeof(WCHAR) ))) return NULL;
+    if (!GetTempFileNameW( dir, L"rbf", 0, name ))
+    {
+        free( name );
+        return NULL;
+    }
+    return name;
+}
+
+/* called before this install writes file->TargetPath */
+static void record_file_rollback( MSIPACKAGE *package, MSIFILE *file )
+{
+    MSIFILE *other;
+    WCHAR *backup;
+
+    if (file->rollback != FILE_ROLLBACK_NONE || !rollback_should_record( package )) return;
+
+    /* the first write to a path records its state before the install; File rows that
+     * target the same path later must not record the intermediate state */
+    LIST_FOR_EACH_ENTRY( other, &package->files, MSIFILE, entry )
+    {
+        if (other != file && other->rollback != FILE_ROLLBACK_NONE && !wcsicmp( other->TargetPath, file->TargetPath ))
+        {
+            TRACE( "rollback record: %s already recorded\n", debugstr_w(file->TargetPath) );
+            return;
+        }
+    }
+
+    if (msi_get_file_attributes( package, file->TargetPath ) == INVALID_FILE_ATTRIBUTES)
+    {
+        TRACE( "rollback record: %s is new\n", debugstr_w(file->TargetPath) );
+        file->rollback = FILE_ROLLBACK_CREATED;
+        return;
+    }
+    if ((backup = create_rollback_backup_name( package )))
+    {
+        if (msi_copy_file( package, file->TargetPath, backup, FALSE ))
+        {
+            TRACE( "rollback record: %s saved as %s\n", debugstr_w(file->TargetPath), debugstr_w(backup) );
+            file->rollback = FILE_ROLLBACK_REPLACED;
+            file->rollback_backup = backup;
+            return;
+        }
+        DeleteFileW( backup );
+        free( backup );
+    }
+    WARN( "could not save %s for rollback (%lu)\n", debugstr_w(file->TargetPath), GetLastError() );
+}
+
+/* undo what this install did to its files; returns TRUE if records are in use */
+static BOOL rollback_files( MSIPACKAGE *package )
+{
+    MSIFILE *file;
+
+    if (!msi_rollback_is_recorded()) return FALSE;
+
+    LIST_FOR_EACH_ENTRY( file, &package->files, MSIFILE, entry )
+    {
+        switch (file->rollback)
+        {
+        case FILE_ROLLBACK_CREATED:
+            TRACE( "rollback: removing %s\n", debugstr_w(file->TargetPath) );
+            msi_set_file_attributes( package, file->TargetPath, FILE_ATTRIBUTE_NORMAL );
+            if (!msi_delete_file( package, file->TargetPath ) && GetLastError() != ERROR_FILE_NOT_FOUND)
+                WARN( "failed to delete %s (%lu)\n", debugstr_w(file->TargetPath), GetLastError() );
+            file->state = msifs_missing;
+            break;
+        case FILE_ROLLBACK_REPLACED:
+            TRACE( "rollback: restoring %s\n", debugstr_w(file->TargetPath) );
+            msi_set_file_attributes( package, file->TargetPath, FILE_ATTRIBUTE_NORMAL );
+            if (msi_move_file( package, file->rollback_backup, file->TargetPath,
+                               MOVEFILE_REPLACE_EXISTING | MOVEFILE_COPY_ALLOWED ))
+            {
+                free( file->rollback_backup );
+                file->rollback_backup = NULL;
+            }
+            else
+            {
+                /* keep the saved copy on disk */
+                ERR( "failed to restore %s from %s (%lu)\n", debugstr_w(file->TargetPath),
+                     debugstr_w(file->rollback_backup), GetLastError() );
+                free( file->rollback_backup );
+                file->rollback_backup = NULL;
+            }
+            break;
+        default:
+            break;
+        }
+        file->rollback = FILE_ROLLBACK_NONE;
+    }
+    return TRUE;
+}
+
+struct dir_rollback
+{
+    struct list entry;
+    WCHAR *path;
+};
+
+/* called before this install creates path: remember each level of it that does not exist yet */
+static void record_dir_rollback( MSIPACKAGE *package, const WCHAR *path )
+{
+    struct dir_rollback *rec;
+    WCHAR *dir, *p;
+    int len;
+
+    if (!rollback_should_record( package ) || !(dir = wcsdup( path ))) return;
+    while ((len = lstrlenW( dir )) && dir[len - 1] == '\\') dir[len - 1] = 0;
+
+    while (lstrlenW( dir ) > 3 && msi_get_file_attributes( package, dir ) == INVALID_FILE_ATTRIBUTES)
+    {
+        BOOL known = FALSE;
+
+        LIST_FOR_EACH_ENTRY( rec, &package->rollback_dirs, struct dir_rollback, entry )
+            if (!wcsicmp( rec->path, dir )) known = TRUE;
+        if (!known && (rec = malloc( sizeof(*rec) )))
+        {
+            if ((rec->path = wcsdup( dir )))
+            {
+                TRACE( "rollback record: folder %s is new\n", debugstr_w(dir) );
+                list_add_tail( &package->rollback_dirs, &rec->entry );
+            }
+            else free( rec );
+        }
+        if (!(p = wcsrchr( dir, '\\' ))) break;
+        *p = 0;
+    }
+    free( dir );
+}
+
+/* remove the folders this install created, deepest first; a folder that is not empty stays */
+static void rollback_dirs( MSIPACKAGE *package )
+{
+    struct dir_rollback *rec, *deepest;
+
+    while (!list_empty( &package->rollback_dirs ))
+    {
+        deepest = NULL;
+        LIST_FOR_EACH_ENTRY( rec, &package->rollback_dirs, struct dir_rollback, entry )
+            if (!deepest || lstrlenW( rec->path ) > lstrlenW( deepest->path )) deepest = rec;
+
+        TRACE( "rollback: removing folder %s\n", debugstr_w(deepest->path) );
+        if (!msi_remove_directory( package, deepest->path ))
+            TRACE( "folder %s kept (%lu)\n", debugstr_w(deepest->path), GetLastError() );
+        list_remove( &deepest->entry );
+        free( deepest->path );
+        free( deepest );
+    }
+}
+
+void msi_free_dir_rollback( MSIPACKAGE *package )
+{
+    struct dir_rollback *rec, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( rec, next, &package->rollback_dirs, struct dir_rollback, entry )
+    {
+        list_remove( &rec->entry );
+        free( rec->path );
+        free( rec );
+    }
+}
+
+void msi_free_file_rollback( MSIPACKAGE *package, MSIFILE *file )
+{
+    /* install finished or rolled back: the saved copy is no longer needed */
+    if (file->rollback_backup)
+    {
+        SetFileAttributesW( file->rollback_backup, FILE_ATTRIBUTE_NORMAL );
+        DeleteFileW( file->rollback_backup );
+        free( file->rollback_backup );
+        file->rollback_backup = NULL;
+    }
+    file->rollback = FILE_ROLLBACK_NONE;
+}
+
