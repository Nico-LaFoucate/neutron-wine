+static void get_pf_path(const char *rel, char *path)
+{
+    sprintf(path, "%s\\%s", PROG_FILES_DIR, rel);
+}
+
+static BOOL pf_file_matches(const char *rel, const char *reference)
+{
+    char path[MAX_PATH], *a = NULL, *b = NULL;
+    HANDLE ha, hb;
+    DWORD sa, sb, read;
+    BOOL ret = FALSE;
+
+    get_pf_path(rel, path);
+    ha = CreateFileA(path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    hb = CreateFileA(reference, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    if (ha != INVALID_HANDLE_VALUE && hb != INVALID_HANDLE_VALUE)
+    {
+        sa = GetFileSize(ha, NULL);
+        sb = GetFileSize(hb, NULL);
+        if (sa == sb && (a = malloc(sa)) && (b = malloc(sb)) &&
+            ReadFile(ha, a, sa, &read, NULL) && read == sa &&
+            ReadFile(hb, b, sb, &read, NULL) && read == sb)
+            ret = !memcmp(a, b, sa);
+    }
+    if (ha != INVALID_HANDLE_VALUE) CloseHandle(ha);
+    if (hb != INVALID_HANDLE_VALUE) CloseHandle(hb);
+    free(a);
+    free(b);
+    return ret;
+}
+
+static DWORD get_shared_dll_count(const char *rel)
+{
+    char path[MAX_PATH];
+    DWORD count = 0, size = sizeof(count);
+    HKEY hkey;
+
+    get_pf_path(rel, path);
+    if (!RegOpenKeyExA(HKEY_LOCAL_MACHINE, "Software\\Microsoft\\Windows\\CurrentVersion\\SharedDLLs", 0,
+                       KEY_READ | KEY_WOW64_32KEY, &hkey))
+    {
+        if (RegQueryValueExA(hkey, path, NULL, NULL, (BYTE *)&count, &size)) count = 0;
+        RegCloseKey(hkey);
+    }
+    return count;
+}
+
+/* A failed install must leave the machine as it was: files it did not write stay, files it
+ * replaced come back, files it created go (also when two File rows write the same path), and a
+ * component shared with an installed product keeps that product's registration and SharedDLLs
+ * count. */
+static void test_rollback(void)
+{
+    static const char product1[] = "{0D3B2E5A-6C1F-4B7A-9E21-5F0C8A1D7B01}";
+    static const char product2[] = "{0D3B2E5A-6C1F-4B7A-9E21-5F0C8A1D7B02}";
+    static const char shared_comp[] = "{7F1E2D3C-4B5A-4968-8776-A5B4C3D2E1F0}";
+    char sysdll[MAX_PATH], path[MAX_PATH];
+    INSTALLSTATE state;
+    DWORD count;
+    int pass;
+    UINT r;
+
+    if (!is_process_elevated())
+    {
+        skip("process is limited\n");
+        return;
+    }
+    GetSystemDirectoryA(sysdll, MAX_PATH);
+    lstrcatA(sysdll, "\\kernel32.dll");
+
+    MsiSetInternalUI(INSTALLUILEVEL_NONE, NULL);
+
+    for (pass = 0; pass < 2; pass++)
+    {
+        winetest_push_context(pass ? "cab" : "uncompressed");
+
+        CreateDirectoryA("msitest", NULL);
+        create_file("msitest\\shared.txt", 1000);
+        create_database_wordcount(msifile, rb1_tables, ARRAY_SIZE(rb1_tables),
+                                  100, 0, ";1033", "{2A6B1C3D-0E4F-4A5B-8C7D-9E0F1A2B3C41}");
+
+        r = MsiInstallProductA(msifile, NULL);
+        ok(r == ERROR_SUCCESS, "got %u\n", r);
+        ok(pf_exists("msitest\\shared.txt"), "file not installed\n");
+        count = get_shared_dll_count("msitest\\shared.txt");
+        ok(count == 1, "got count %lu\n", count);
+
+        /* files the second product finds in place */
+        create_file_data("same.ref", "pre-existing", 1000);
+        get_pf_path("msitest\\same.txt", path);
+        CopyFileA("same.ref", path, FALSE);
+        get_pf_path("msitest\\older.dll", path);
+        CopyFileA(sysdll, path, FALSE);
+        get_pf_path("msitest\\newer.dll", path);
+        CopyFileA(sysdll, path, FALSE);
+
+        if (pass)
+        {
+            create_file("shared", 1000);
+            create_file("new", 1000);
+            create_file("same", 1000);
+            create_file("older", 1000);
+            create_file("newer", 1000);
+            create_file("new2", 1000);
+            create_file("older2", 1000);
+            create_cab_file("test1.cab", MEDIA_SIZE, "shared\0new\0same\0older\0newer\0new2\0older2\0");
+            DeleteFileA("new2");
+            DeleteFileA("older2");
+            DeleteFileA("shared");
+            DeleteFileA("new");
+            DeleteFileA("same");
+            DeleteFileA("older");
+            DeleteFileA("newer");
+            create_database_wordcount(msifile2, rb2_cab_tables, ARRAY_SIZE(rb2_cab_tables),
+                                      100, 0, ";1033", "{2A6B1C3D-0E4F-4A5B-8C7D-9E0F1A2B3C43}");
+        }
+        else
+        {
+            create_file("msitest\\new.txt", 1000);
+            create_file("msitest\\same.txt", 1000);
+            create_file("msitest\\older.dll", 1000);
+            create_file("msitest\\newer.dll", 1000);
+            create_database_wordcount(msifile2, rb2_tables, ARRAY_SIZE(rb2_tables),
+                                      100, 0, ";1033", "{2A6B1C3D-0E4F-4A5B-8C7D-9E0F1A2B3C42}");
+        }
+
+        r = MsiInstallProductA(msifile2, "FAIL_INSTALL=1");
+        ok(r == ERROR_INSTALL_FAILURE, "got %u\n", r);
+
+        state = MsiQueryProductStateA(product2);
+        ok(state == INSTALLSTATE_UNKNOWN, "got state %d\n", state);
+        ok(!pf_exists("msitest\\new.txt"), "file created by the failed install not removed\n");
+        ok(pf_exists("msitest\\shared.txt"), "file of the shared component removed\n");
+        ok(pf_file_matches("msitest\\same.txt", "same.ref"), "unchanged file not kept\n");
+        ok(pf_file_matches("msitest\\newer.dll", sysdll), "newer file not kept\n");
+        ok(pf_file_matches("msitest\\older.dll", sysdll), "replaced file not restored\n");
+        count = get_shared_dll_count("msitest\\shared.txt");
+        ok(count == 1, "got count %lu\n", count);
+        state = MsiGetComponentPathA(product1, shared_comp, NULL, NULL);
+        ok(state == INSTALLSTATE_LOCAL, "got state %d\n", state);
+        state = MsiGetComponentPathA(product2, shared_comp, NULL, NULL);
+        ok(state == INSTALLSTATE_UNKNOWN, "got state %d\n", state);
+
+        r = MsiInstallProductA(msifile, "REMOVE=ALL");
+        ok(r == ERROR_SUCCESS, "got %u\n", r);
+        ok(!pf_exists("msitest\\shared.txt"), "file not removed\n");
+        count = get_shared_dll_count("msitest\\shared.txt");
+        ok(!count, "got count %lu\n", count);
+
+        delete_pf("msitest\\new.txt", TRUE);
+        delete_pf("msitest\\same.txt", TRUE);
+        delete_pf("msitest\\older.dll", TRUE);
+        delete_pf("msitest\\newer.dll", TRUE);
+        delete_pf("msitest\\shared.txt", TRUE);
+        delete_pf("msitest", FALSE);
+        DeleteFileA("msitest\\shared.txt");
+        DeleteFileA("msitest\\new.txt");
+        DeleteFileA("msitest\\same.txt");
+        DeleteFileA("msitest\\older.dll");
+        DeleteFileA("msitest\\newer.dll");
+        RemoveDirectoryA("msitest");
+        DeleteFileA("test1.cab");
+        DeleteFileA("same.ref");
+        DeleteFileA(msifile);
+        DeleteFileA(msifile2);
+
+        winetest_pop_context();
+    }
+}
+
