         {
             if (file->Component == comp)
+            {
+                record_shared_dll( package, comp, file->TargetPath );
                 write_shared_dlls_count( comp, file->TargetPath, count );
+            }
         }
     }
 
@@ -3284,7 +3325,80 @@
