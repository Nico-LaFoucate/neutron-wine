     if (write)
+    {
+        record_shared_dll( package, comp, comp->FullKeypath );
         write_shared_dlls_count( comp, comp->FullKeypath, comp->RefCount );
+    }
+}
+
+void msi_free_shared_dll_rollback( struct list *entry )
+{
+    struct shared_dll_rollback *rec = LIST_ENTRY( entry, struct shared_dll_rollback, entry );
+    free( rec->path );
+    free( rec );
+}
+
+static const WCHAR *component_user_sid( MSIPACKAGE *package )
+{
+    return package->Context == MSIINSTALLCONTEXT_MACHINE ? L"S-1-5-18" : NULL;
+}
+
+/* remember the component's registration before ProcessComponents changes it */
+static void record_component( MSIPACKAGE *package, MSICOMPONENT *comp, const WCHAR *squashed_pc )
+{
+    HKEY hkey;
+
+    if (comp->rollback_recorded || package->need_rollback || !msi_rollback_is_recorded() ||
+        msi_get_property_int( package->db, L"RollbackDisabled", 0 )) return;
+
+    comp->rollback_recorded = 1;
+    if (MSIREG_OpenUserDataComponentKey( comp->ComponentId, component_user_sid( package ), &hkey, FALSE ))
+        return;
+
+    comp->rollback_key_existed = 1;
+    if ((comp->rollback_client = msi_reg_get_val_str( hkey, squashed_pc )))
+        comp->rollback_client_existed = 1;
+    if (!RegQueryValueExW( hkey, L"00000000000000000000000000000000", NULL, NULL, NULL, NULL ))
+        comp->rollback_permanent_existed = 1;
+    RegCloseKey( hkey );
+}
+
+/* rollback of ProcessComponents: put back what record_component and record_shared_dll saw */
+static void rollback_component( MSIPACKAGE *package, MSICOMPONENT *comp, const WCHAR *squashed_pc )
+{
+    struct shared_dll_rollback *rec, *next;
+    HKEY hkey;
+
+    LIST_FOR_EACH_ENTRY_SAFE( rec, next, &comp->rollback_shared_dlls, struct shared_dll_rollback, entry )
+    {
+        TRACE( "rollback: SharedDLLs %s -> %s %lu\n", debugstr_w(rec->path), rec->present ? "count" : "absent",
+               rec->count );
+        if ((hkey = open_shared_dlls_key( comp, rec->present, KEY_SET_VALUE )))
+        {
+            if (rec->present) msi_reg_set_val_dword( hkey, rec->path, rec->count );
+            else RegDeleteValueW( hkey, rec->path );
+            RegCloseKey( hkey );
+        }
+        list_remove( &rec->entry );
+        free( rec->path );
+        free( rec );
+    }
+
+    TRACE( "rollback: component %s key %s, client %s\n", debugstr_w(comp->Component),
+           comp->rollback_key_existed ? "kept" : "removed", debugstr_w(comp->rollback_client) );
+    if (!comp->rollback_key_existed)
+        MSIREG_DeleteUserDataComponentKey( comp->ComponentId, component_user_sid( package ) );
+    else if (!MSIREG_OpenUserDataComponentKey( comp->ComponentId, component_user_sid( package ), &hkey, TRUE ))
+    {
+        if (comp->rollback_client_existed) msi_reg_set_val_str( hkey, squashed_pc, comp->rollback_client );
+        else RegDeleteValueW( hkey, squashed_pc );
+        if (!comp->rollback_permanent_existed) RegDeleteValueW( hkey, L"00000000000000000000000000000000" );
+        RegCloseKey( hkey );
+    }
+    free( comp->rollback_client );
+    comp->rollback_client = NULL;
+    comp->rollback_recorded = comp->rollback_key_existed = 0;
+    comp->rollback_client_existed = comp->rollback_permanent_existed = 0;
 }
 
 static WCHAR *build_full_keypath( MSIPACKAGE *package, MSICOMPONENT *comp )
@@ -3330,6 +3444,15 @@
