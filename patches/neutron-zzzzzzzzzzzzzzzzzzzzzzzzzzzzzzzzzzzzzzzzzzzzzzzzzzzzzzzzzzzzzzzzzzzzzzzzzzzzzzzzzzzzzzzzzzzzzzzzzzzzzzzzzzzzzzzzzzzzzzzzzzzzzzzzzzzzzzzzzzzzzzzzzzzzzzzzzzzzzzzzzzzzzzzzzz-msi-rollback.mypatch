 }
 
+struct shared_dll_rollback
+{
+    struct list entry;
+    WCHAR *path;
+    DWORD count;
+    BOOL present;
+};
+
+/* remember a SharedDLLs value before ProcessComponents changes it */
+static void record_shared_dll( MSIPACKAGE *package, MSICOMPONENT *comp, const WCHAR *path )
+{
+    struct shared_dll_rollback *rec;
+    DWORD type, count, sz = sizeof(count);
+    HKEY hkey;
+
+    if (!comp->rollback_recorded || package->need_rollback || !path) return;
+    LIST_FOR_EACH_ENTRY( rec, &comp->rollback_shared_dlls, struct shared_dll_rollback, entry )
+        if (!wcsicmp( rec->path, path )) return;
+
+    if (!(rec = calloc( 1, sizeof(*rec) ))) return;
+    if (!(rec->path = wcsdup( path )))
+    {
+        free( rec );
+        return;
+    }
+    if ((hkey = open_shared_dlls_key( comp, FALSE, KEY_READ )))
+    {
+        if (!RegQueryValueExW( hkey, path, NULL, &type, (BYTE *)&count, &sz ))
+        {
+            rec->present = TRUE;
+            rec->count = count;
+        }
+        RegCloseKey( hkey );
+    }
+    list_add_tail( &comp->rollback_shared_dlls, &rec->entry );
+}
+
