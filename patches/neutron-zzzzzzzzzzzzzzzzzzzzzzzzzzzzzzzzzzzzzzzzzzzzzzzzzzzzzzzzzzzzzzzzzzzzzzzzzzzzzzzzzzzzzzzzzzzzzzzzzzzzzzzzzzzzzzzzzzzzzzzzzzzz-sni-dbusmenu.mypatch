 #define WATCHER_PATH      "/StatusNotifierWatcher"
 #define NOTIFY_NAME       "org.freedesktop.Notifications"
 #define NOTIFY_PATH       "/org/freedesktop/Notifications"
+#define DBUSMENU_INTERFACE "com.canonical.dbusmenu"
+#define DBUSMENU_PATH     "/MenuBar"
+#define MENU_PLACEHOLDER_ID 0x7ffffff0  /* the only item until the application's menu comes, for hosts that need one */
+
+/* NEUTRON sni-dbusmenu: the icon's context menu, drawn by the tray at the icon (see dlls/win32u/menu.c) */
+enum sni_menu_state
+{
+    MENU_IDLE,
+    MENU_WAITING,      /* AboutToShow pending: the right click went to the application, its menu has not come */
+    MENU_SHOWN,        /* the tray shows the application's menu */
+    MENU_CLOSING,      /* the tray said "closed"; a "clicked" may still follow */
+};
+
+struct sni_menu
+{
+    enum sni_menu_state state;
+    UINT             request;         /* WINE_SYSTRAY_MENU_PROP value, 16 bits, never 0 */
+    DBusMessage     *about_to_show;   /* the pending AboutToShow / AboutToShowGroup call */
+    BOOL             group;           /* it was AboutToShowGroup */
+    ULONGLONG        deadline;        /* MENU_WAITING: give up; MENU_CLOSING: cancel */
+    BOOL             click_pending;   /* the right click waits for the application to leave its previous menu */
+    DBusMessage     *pending;         /* an AboutToShow not yet known to be the user's: GNOME's extension calls it */
+    BOOL             pending_group;   /*   to prefetch, the user's opening comes with an "opened" event */
+    ULONGLONG        pending_until;
+    ULONGLONG        opened_at;       /* the last "opened" event on the root */
+    ULONGLONG        registered_at;   /* the item was (re)announced to the watcher */
+    BOOL             host_prefetches; /* the host asked ahead of time (GNOME): it opens only a non-empty menu */
+    BOOL             foreign;         /* a right click brought no Win32 menu: the application shows its own */
+    struct systray_menu_data *data;   /* the application's menu */
+    dbus_uint32_t    revision;
+};
 
