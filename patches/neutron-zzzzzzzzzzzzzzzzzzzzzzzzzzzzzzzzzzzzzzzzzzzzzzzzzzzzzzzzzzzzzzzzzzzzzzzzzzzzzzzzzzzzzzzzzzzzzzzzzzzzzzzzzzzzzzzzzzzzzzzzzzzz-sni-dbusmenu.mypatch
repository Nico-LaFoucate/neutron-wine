+/* NEUTRON sni-dbusmenu: a tray menu handed to the desktop's tray instead of being shown by the application.
+ * While the shell waits for a tray icon's context menu, it sets WINE_SYSTRAY_MENU_PROP (a non-zero request number)
+ * on the icon's window and relays the right click. TrackPopupMenu on that window then sends its menu, after the
+ * usual WM_INITMENUPOPUP, to Shell_TrayWnd as WM_COPYDATA with dwData WINE_SYSTRAY_MENU_DATA (wParam: the window);
+ * explorer passes it to the display driver as WINE_SYSTRAY_NOTIFY_ICON with that dwData as the "message". When the
+ * menu closes the shell sets WINE_SYSTRAY_MENU_RESULT_PROP to MAKELONG(item index + 1 or 0, request number) and
+ * posts WM_NULL to the window. */
+#define WINE_SYSTRAY_MENU_DATA         0x4e544d31  /* 'NTM1' */
+/* initializers for WCHAR arrays: unix code has no 16-bit L"" literals */
+#define WINE_SYSTRAY_MENU_PROP_INIT \
+    {'_','_','w','i','n','e','_','s','y','s','t','r','a','y','_','m','e','n','u',0}
+#define WINE_SYSTRAY_MENU_RESULT_PROP_INIT \
+    {'_','_','w','i','n','e','_','s','y','s','t','r','a','y','_','m','e','n','u','_','r','e','s','u','l','t',0}
+
+struct systray_menu_item
+{
+    INT   parent;          /* index of the submenu item this one is in, -1 at the top */
+    UINT  type;            /* MFT_* (MFT_SEPARATOR, MFT_RADIOCHECK, ...), plus MF_POPUP for a submenu */
+    UINT  state;           /* MFS_* */
+    UINT  text;            /* offset of the text in WCHARs after the items, ~0u for none */
+};
+
+struct systray_menu_data
+{
+    UINT  size;            /* total bytes */
+    UINT  request;         /* the WINE_SYSTRAY_MENU_PROP value it answers */
+    UINT  count;           /* items */
+    struct systray_menu_item items[1];
+    /* then the NUL-terminated texts */
+};
+
 /* NtUserDragDropCall calls */
 enum wine_drag_drop_call
 {
--- a/programs/explorer/systray.c
+++ b/programs/explorer/systray.c
@@ -851,6 +851,18 @@
     NOTIFYICONDATAW nid;
     int ret = FALSE;
 
+    /* NEUTRON sni-dbusmenu: a tray icon's menu for the display driver's tray (see ntuser.h) */
+    if (cds->dwData == WINE_SYSTRAY_MENU_DATA)
+    {
+        const struct systray_menu_data *menu = cds->lpData;
+        if (cds->cbData < offsetof( struct systray_menu_data, items ) || menu->size != cds->cbData ||
+            !menu->count || menu->count > (cds->cbData - offsetof( struct systray_menu_data, items )) /
+                                          sizeof(menu->items[0]))
+            return FALSE;
+        return NtUserMessageCall( hwndSource, WINE_SYSTRAY_NOTIFY_ICON, WINE_SYSTRAY_MENU_DATA, 0,
+                                  (void *)menu, NtUserSystemTrayCall, FALSE ) == TRUE;
+    }
+
     if (cds->cbData < sizeof(*data)) return FALSE;
     data = cds->lpData;
     icon_data = data->icon_data;
