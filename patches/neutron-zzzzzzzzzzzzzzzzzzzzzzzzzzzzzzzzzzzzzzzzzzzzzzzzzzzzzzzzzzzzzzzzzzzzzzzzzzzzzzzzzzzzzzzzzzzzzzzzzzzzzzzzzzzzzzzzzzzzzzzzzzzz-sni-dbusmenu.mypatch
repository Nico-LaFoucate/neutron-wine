+/* ---- the context menu (com.canonical.dbusmenu) ---------------------------------------------------------------- */
+
+/* NEUTRON sni-dbusmenu (2026-11-04, his C178). Windows opens a tray icon's menu at the icon. The application's own
+ * menu window cannot be placed there on Wayland (KWin centered it, with a taskbar entry), but the tray draws a
+ * dbusmenu at the icon. So the item's Menu is a dbusmenu: when the tray is about to show it (AboutToShow on the
+ * root), the right click goes to the application as before, with WINE_SYSTRAY_MENU_PROP on the icon's window; the
+ * application's TrackPopupMenu sends its menu here instead of showing it (dlls/win32u/menu.c, through explorer's
+ * WM_COPYDATA), the reply tells the tray to fetch the layout, and the tray's "clicked" / "closed" events end the
+ * application's TrackPopupMenu with that item or none. An application that shows anything else (a Qt menu, its own
+ * window) sends nothing; after a second the tray is told there is nothing new and the application's window shows
+ * as before. */
+
+static const char dbusmenu_introspection[] =
+    DBUS_INTROSPECT_1_0_XML_DOCTYPE_DECL_NODE
+    "<node>\n"
+    " <interface name='org.freedesktop.DBus.Introspectable'>\n"
+    "  <method name='Introspect'><arg name='data' direction='out' type='s'/></method>\n"
+    " </interface>\n"
+    " <interface name='org.freedesktop.DBus.Properties'>\n"
+    "  <method name='Get'><arg name='interface' direction='in' type='s'/><arg name='name' direction='in' type='s'/>"
+    "<arg name='value' direction='out' type='v'/></method>\n"
+    "  <method name='GetAll'><arg name='interface' direction='in' type='s'/>"
+    "<arg name='properties' direction='out' type='a{sv}'/></method>\n"
+    " </interface>\n"
+    " <interface name='" DBUSMENU_INTERFACE "'>\n"
+    "  <property name='Version' type='u' access='read'/>\n"
+    "  <property name='TextDirection' type='s' access='read'/>\n"
+    "  <property name='Status' type='s' access='read'/>\n"
+    "  <property name='IconThemePath' type='as' access='read'/>\n"
+    "  <method name='GetLayout'><arg type='i' name='parentId' direction='in'/>"
+    "<arg type='i' name='recursionDepth' direction='in'/><arg type='as' name='propertyNames' direction='in'/>"
+    "<arg type='u' name='revision' direction='out'/><arg type='(ia{sv}av)' name='layout' direction='out'/></method>\n"
+    "  <method name='GetGroupProperties'><arg type='ai' name='ids' direction='in'/>"
+    "<arg type='as' name='propertyNames' direction='in'/><arg type='a(ia{sv})' name='properties' direction='out'/></method>\n"
+    "  <method name='GetProperty'><arg type='i' name='id' direction='in'/><arg type='s' name='name' direction='in'/>"
+    "<arg type='v' name='value' direction='out'/></method>\n"
+    "  <method name='Event'><arg type='i' name='id' direction='in'/><arg type='s' name='eventId' direction='in'/>"
+    "<arg type='v' name='data' direction='in'/><arg type='u' name='timestamp' direction='in'/></method>\n"
+    "  <method name='EventGroup'><arg type='a(isvu)' name='events' direction='in'/>"
+    "<arg type='ai' name='idErrors' direction='out'/></method>\n"
+    "  <method name='AboutToShow'><arg type='i' name='id' direction='in'/>"
+    "<arg type='b' name='needUpdate' direction='out'/></method>\n"
+    "  <method name='AboutToShowGroup'><arg type='ai' name='ids' direction='in'/>"
+    "<arg type='ai' name='updatesNeeded' direction='out'/><arg type='ai' name='idErrors' direction='out'/></method>\n"
+    "  <signal name='ItemsPropertiesUpdated'><arg type='a(ia{sv})' name='updatedProps'/>"
+    "<arg type='a(ias)' name='removedProps'/></signal>\n"
+    "  <signal name='LayoutUpdated'><arg type='u' name='revision'/><arg type='i' name='parent'/></signal>\n"
+    "  <signal name='ItemActivationRequested'><arg type='i' name='id'/><arg type='u' name='timestamp'/></signal>\n"
+    " </interface>\n"
+    "</node>\n";
+
+/* the text of an item, NULL for none (checked when the menu arrived) */
+static const WCHAR *menu_item_text( const struct systray_menu_data *data, UINT index )
+{
+    if (data->items[index].text == ~0u) return NULL;
+    return (const WCHAR *)&data->items[data->count] + data->items[index].text;
+}
+
+/* Item ids carry the menu's revision: (revision << 16) | (index + 1). A host updating an item it already has keeps
+ * properties the new layout leaves out or clears (Plasma kept an unchecked item checkable), so every menu from the
+ * application gets items the host has never seen. */
+static int menu_item_id( const struct sni_icon *icon, UINT index )
+{
+    return (int)(((icon->menu.revision % 0x7ffe) + 1) << 16 | (index + 1));
+}
+
+/* the item index of a dbusmenu id, -1 for none (the root, the placeholder, an old revision) */
+static int menu_item_index( const struct sni_icon *icon, int id )
+{
+    UINT index = (id & 0xffff) - 1;
+    if (id <= 0 || id == MENU_PLACEHOLDER_ID || !icon->menu.data) return -1;
+    if ((UINT)id >> 16 != (icon->menu.revision % 0x7ffe) + 1 || index >= icon->menu.data->count) return -1;
+    return index;
+}
+
+/* a Win32 item text as a dbusmenu label: "&Open\tCtrl+O" -> "_Open", "&&" -> "&", "_" -> "__" */
+static char *menu_label( const WCHAR *text )
+{
+    const WCHAR *s;
+    WCHAR *buf, *p;
+    char *ret;
+    int len = 0;
+
+    if (!text) return NULL;
+    while (text[len]) len++;
+    if (!(buf = malloc( (len * 2 + 1) * sizeof(WCHAR) ))) return NULL;
+    for (s = text, p = buf; *s && *s != '\t'; s++)
+    {
+        if (*s == '&')
+        {
+            if (s[1] == '&') { *p++ = '&'; s++; }
+            else *p++ = '_';
+        }
+        else if (*s == '_') { *p++ = '_'; *p++ = '_'; }
+        else *p++ = *s;
+    }
+    *p = 0;
+    ret = utf8_from_wide( buf, p - buf );
+    free( buf );
+    return ret;
+}
+
+static void append_entry_variant( DBusMessageIter *dict, const char *key, int type, const void *value )
+{
+    DBusMessageIter entry, var;
+    char sig[2] = { type, 0 };
+
+    p_dbus_message_iter_open_container( dict, DBUS_TYPE_DICT_ENTRY, NULL, &entry );
+    p_dbus_message_iter_append_basic( &entry, DBUS_TYPE_STRING, &key );
+    p_dbus_message_iter_open_container( &entry, DBUS_TYPE_VARIANT, sig, &var );
+    p_dbus_message_iter_append_basic( &var, type, value );
+    p_dbus_message_iter_close_container( &entry, &var );
+    p_dbus_message_iter_close_container( dict, &entry );
+}
+
+/* the a{sv} of item id (0 = the root, n = item n - 1, MENU_PLACEHOLDER_ID) */
+static void append_menu_properties( DBusMessageIter *iter, const struct sni_icon *icon, int id )
+{
+    const struct systray_menu_data *data = icon->menu.data;
+    const struct systray_menu_item *item;
+    DBusMessageIter dict;
+    const char *str;
+
+    int index = menu_item_index( icon, id );
+
+    p_dbus_message_iter_open_container( iter, DBUS_TYPE_ARRAY, "{sv}", &dict );
+    if (id == MENU_PLACEHOLDER_ID)
+    {
+        dbus_bool_t no = FALSE;
+        str = icon->tip && icon->tip[0] ? icon->tip : "\xe2\x80\xa6";  /* the tooltip, or an ellipsis */
+        append_entry_variant( &dict, "label", DBUS_TYPE_STRING, &str );
+        append_entry_variant( &dict, "enabled", DBUS_TYPE_BOOLEAN, &no );
+    }
+    else if (index < 0)
+    {
+        str = "submenu";
+        append_entry_variant( &dict, "children-display", DBUS_TYPE_STRING, &str );
+    }
+    else if ((item = &data->items[index])->type & MFT_SEPARATOR)
+    {
+        str = "separator";
+        append_entry_variant( &dict, "type", DBUS_TYPE_STRING, &str );
+    }
+    else
+    {
+        char *label = menu_label( menu_item_text( data, index ));
+        str = label ? label : "";
+        append_entry_variant( &dict, "label", DBUS_TYPE_STRING, &str );
+        free( label );
+        if (item->state & (MFS_GRAYED | MFS_DISABLED))
+        {
+            dbus_bool_t no = FALSE;
+            append_entry_variant( &dict, "enabled", DBUS_TYPE_BOOLEAN, &no );
+        }
+        {
+            /* Windows shows no box on an unchecked item, so only a checked one is a toggle; "" says so outright
+             * (hosts that patch properties between layouts, libdbusmenu-gtk, otherwise keep an old toggle) */
+            dbus_int32_t on = !!(item->state & MFS_CHECKED);
+            str = !on ? "" : (item->type & MFT_RADIOCHECK) ? "radio" : "checkmark";
+            append_entry_variant( &dict, "toggle-type", DBUS_TYPE_STRING, &str );
+            append_entry_variant( &dict, "toggle-state", DBUS_TYPE_INT32, &on );
+        }
+        if (item->type & MF_POPUP)
+        {
+            str = "submenu";
+            append_entry_variant( &dict, "children-display", DBUS_TYPE_STRING, &str );
+        }
+    }
+    p_dbus_message_iter_close_container( iter, &dict );
+}
+
+/* (ia{sv}av) of item id with depth levels of children (-1: all). Until the application's menu first comes, the
+ * root has one disabled item: GNOME's extension opens only a non-empty menu, and waybar shows what it has at once.
+ * Hosts that ask first (Plasma) replace it before showing anything; once an application has shown it uses its own
+ * menu (a Qt one), those get an empty root, so they show nothing next to the application's menu. */
+static void append_menu_layout( DBusMessageIter *iter, const struct sni_icon *icon, int id, int depth )
+{
+    const struct systray_menu_data *data = icon->menu.data;
+    DBusMessageIter strct, children, var;
+    dbus_int32_t i32 = id;
+    UINT i;
+
+    p_dbus_message_iter_open_container( iter, DBUS_TYPE_STRUCT, NULL, &strct );
+    p_dbus_message_iter_append_basic( &strct, DBUS_TYPE_INT32, &i32 );
+    append_menu_properties( &strct, icon, id );
+    p_dbus_message_iter_open_container( &strct, DBUS_TYPE_ARRAY, DBUS_TYPE_VARIANT_AS_STRING, &children );
+    if (depth && data && id != MENU_PLACEHOLDER_ID)
+    {
+        int parent = id ? menu_item_index( icon, id ) : -1;
+        for (i = 0; i < data->count; i++)
+        {
+            if (data->items[i].parent != parent || (id && parent < 0)) continue;
+            p_dbus_message_iter_open_container( &children, DBUS_TYPE_VARIANT, "(ia{sv}av)", &var );
+            append_menu_layout( &var, icon, menu_item_id( icon, i ), depth < 0 ? -1 : depth - 1 );
+            p_dbus_message_iter_close_container( &children, &var );
+        }
+    }
+    else if (depth && !id && !data && (icon->menu.host_prefetches || !icon->menu.foreign))
+    {
+        p_dbus_message_iter_open_container( &children, DBUS_TYPE_VARIANT, "(ia{sv}av)", &var );
+        append_menu_layout( &var, icon, MENU_PLACEHOLDER_ID, 0 );
+        p_dbus_message_iter_close_container( &children, &var );
+    }
+    p_dbus_message_iter_close_container( &strct, &children );
+    p_dbus_message_iter_close_container( iter, &strct );
+}
+
+static void reply_about_to_show( DBusConnection *conn, DBusMessage *msg, BOOL need_update, BOOL group )
+{
+    DBusMessageIter iter, array;
+    DBusMessage *reply;
+    dbus_bool_t update = need_update;
+    dbus_int32_t root = 0;
+
+    if (!conn || !msg || !(reply = p_dbus_message_new_method_return( msg ))) return;
+    p_dbus_message_iter_init_append( reply, &iter );
+    if (!group) p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_BOOLEAN, &update );
+    else
+    {
+        p_dbus_message_iter_open_container( &iter, DBUS_TYPE_ARRAY, DBUS_TYPE_INT32_AS_STRING, &array );
+        if (need_update) p_dbus_message_iter_append_basic( &array, DBUS_TYPE_INT32, &root );
+        p_dbus_message_iter_close_container( &iter, &array );
+        p_dbus_message_iter_open_container( &iter, DBUS_TYPE_ARRAY, DBUS_TYPE_INT32_AS_STRING, &array );
+        p_dbus_message_iter_close_container( &iter, &array );
+    }
+    p_dbus_connection_send( conn, reply, NULL );
+    p_dbus_message_unref( reply );
+    p_dbus_connection_flush( conn );
+}
+
+/* end the application's TrackPopupMenu: value is the item index + 1, 0 for none; called without sni_mutex */
+static void finish_app_menu( HWND owner, UINT request, UINT value )
+{
+    TRACE( "menu request %u of %p ends with item %u\n", request, owner, value );
+    NtUserSetProp( owner, menu_resultW, ULongToHandle( MAKELONG( value, request )));
+    NtUserPostMessage( owner, WM_NULL, 0, 0 );
+}
+
+/* the right click that makes the application open its menu, as ContextMenu relays it */
+static void relay_context_menu( UINT handle )
+{
+    struct sni_target t;
+    struct sni_icon *icon;
+    POINT pt = { 0, 0 };
+
+    pthread_mutex_lock( &sni_mutex );
+    if (!(icon = find_icon_by_handle( handle )))
+    {
+        pthread_mutex_unlock( &sni_mutex );
+        return;
+    }
+    t.owner = icon->owner;
+    t.id = icon->id;
+    t.callback = icon->callback;
+    t.version = icon->version;
+    pthread_mutex_unlock( &sni_mutex );
+    /* the tray does not say where the click was; the pointer is where it is */
+    NtUserGetCursorPos( &pt );
+    send_click( &t, WM_RBUTTONDOWN, WM_RBUTTONUP, pt );
+}
+
+/* the user opens the menu: ask the application for it, reply to the held AboutToShow when it comes (or after a second) */
+static void menu_start_request( DBusConnection *conn, UINT handle )
+{
+    DBusMessage *stale = NULL, *msg;
+    BOOL stale_group = FALSE, group, had_open = FALSE;
+    UINT old_request = 0, request;
+    struct sni_icon *icon;
+    HWND owner;
+
+    pthread_mutex_lock( &sni_mutex );
+    if (!(icon = find_icon_by_handle( handle )) || !(msg = icon->menu.pending))
+    {
+        pthread_mutex_unlock( &sni_mutex );
+        return;
+    }
+    group = icon->menu.pending_group;
+    icon->menu.pending = NULL;
+    if (icon->menu.state == MENU_WAITING)
+    {
+        stale = icon->menu.about_to_show;
+        stale_group = icon->menu.group;
+    }
+    if (icon->menu.state == MENU_SHOWN || icon->menu.state == MENU_CLOSING)
+    {
+        had_open = TRUE;
+        old_request = icon->menu.request;
+    }
+    if (!(request = ++sni_menu_counter & 0xffff)) request = ++sni_menu_counter & 0xffff;
+    icon->menu.state = MENU_WAITING;
+    icon->menu.request = request;
+    icon->menu.about_to_show = msg;
+    icon->menu.group = group;
+    icon->menu.click_pending = had_open;
+    icon->menu.deadline = sni_ticks() + (had_open ? 2000 : 1000);
+    owner = icon->owner;
+    pthread_mutex_unlock( &sni_mutex );
+
+    if (stale)
+    {
+        reply_about_to_show( conn, stale, FALSE, stale_group );
+        p_dbus_message_unref( stale );
+    }
+    TRACE( "menu request %u for %p\n", request, owner );
+    /* a host that never said "closed" left the application in its previous menu: end that one first */
+    if (had_open) finish_app_menu( owner, old_request, 0 );
+    NtUserSetProp( owner, menu_propW, ULongToHandle( request ));
+    if (!had_open) relay_context_menu( handle );
+    sni_wakeup();
+}
+
+/* AboutToShow on the root. On Windows the application hears of its tray menu only when the user clicks, so a host
+ * asking ahead of time (GNOME's extension does, right after the item registers) gets "nothing new" and the
+ * application nothing; the user's opening comes with an "opened" event (before it from GNOME, just after it from
+ * Plasma). A host that sends no "opened" gets the menu when it asks later than 3 s after the item appeared. */
+static void menu_about_to_show( DBusConnection *conn, DBusMessage *msg, UINT handle, BOOL group )
+{
+    DBusMessage *stale = NULL;
+    BOOL stale_group = FALSE, user;
+    struct sni_icon *icon;
+    ULONGLONG now = sni_ticks();
+
+    pthread_mutex_lock( &sni_mutex );
+    if (!(icon = find_icon_by_handle( handle )))
+    {
+        pthread_mutex_unlock( &sni_mutex );
+        reply_about_to_show( conn, msg, FALSE, group );
+        return;
+    }
+    if (icon->menu.pending)
+    {
+        stale = icon->menu.pending;
+        stale_group = icon->menu.pending_group;
+    }
+    icon->menu.pending = p_dbus_message_ref( msg );
+    icon->menu.pending_group = group;
+    icon->menu.pending_until = now + 200;
+    user = icon->menu.opened_at && now - icon->menu.opened_at <= 1000;
+    pthread_mutex_unlock( &sni_mutex );
+
+    if (stale)
+    {
+        reply_about_to_show( conn, stale, FALSE, stale_group );
+        p_dbus_message_unref( stale );
+    }
+    if (user) menu_start_request( conn, handle );
+    sni_wakeup();
+}
+
+static void menu_event( DBusConnection *conn, UINT handle, int id, const char *event )
+{
+    struct sni_icon *icon;
+    HWND owner = 0;
+    UINT request = 0, value = 0;
+    BOOL finish = FALSE, start = FALSE;
+
+    pthread_mutex_lock( &sni_mutex );
+    if (!id && !strcmp( event, "opened" ) && (icon = find_icon_by_handle( handle )))
+    {
+        icon->menu.opened_at = sni_ticks();
+        start = icon->menu.pending != NULL;
+    }
+    if ((icon = find_icon_by_handle( handle )) && icon->menu.data &&
+        (icon->menu.state == MENU_SHOWN || icon->menu.state == MENU_CLOSING))
+    {
+        int index = menu_item_index( icon, id );
+        if (!strcmp( event, "clicked" ) && index >= 0 &&
+            !(icon->menu.data->items[index].type & (MF_POPUP | MFT_SEPARATOR)))
+        {
+            finish = TRUE;
+            value = index + 1;
+        }
+        else if (!strcmp( event, "closed" ) && !id && icon->menu.state == MENU_SHOWN)
+        {
+            /* Qt menus say "closed" before "clicked" */
+            icon->menu.state = MENU_CLOSING;
+            icon->menu.deadline = sni_ticks() + 400;
+        }
+        if (finish)
+        {
+            icon->menu.state = MENU_IDLE;
+            owner = icon->owner;
+            request = icon->menu.request;
+        }
+    }
+    pthread_mutex_unlock( &sni_mutex );
+    TRACE( "event %s on item %d%s\n", event, id, finish ? ", ends the menu" : start ? ", the user opens it" : "" );
+    if (finish) finish_app_menu( owner, request, value );
+    if (start) menu_start_request( conn, handle );
+    sni_wakeup();
+}
+
+static DBusHandlerResult menu_message( DBusConnection *conn, DBusMessage *msg, void *user_data )
+{
+    UINT handle = (UINT)(UINT_PTR)user_data;
+    DBusMessageIter iter, array, sub;
+    DBusMessage *reply = NULL;
+    struct sni_icon *icon;
+    const char *iface, *name, *event;
+    dbus_int32_t id = 0, depth = -1;
+    DBusError error;
+
+    p_dbus_error_init( &error );
+    if (p_dbus_message_is_method_call( msg, "org.freedesktop.DBus.Introspectable", "Introspect" ))
+    {
+        const char *xml = dbusmenu_introspection;
+        reply = p_dbus_message_new_method_return( msg );
+        p_dbus_message_append_args( reply, DBUS_TYPE_STRING, &xml, DBUS_TYPE_INVALID );
+    }
+    else if (p_dbus_message_is_method_call( msg, "org.freedesktop.DBus.Properties", "Get" ) ||
+             p_dbus_message_is_method_call( msg, "org.freedesktop.DBus.Properties", "GetAll" ))
+    {
+        static const char *props[] = { "Version", "TextDirection", "Status", "IconThemePath" };
+        BOOL all = !strcmp( p_dbus_message_get_member( msg ), "GetAll" );
+        DBusMessageIter dict, entry, var, strs;
+        dbus_uint32_t version = 3;
+        unsigned int i;
+
+        name = NULL;
+        if (!all && !p_dbus_message_get_args( msg, &error, DBUS_TYPE_STRING, &iface, DBUS_TYPE_STRING, &name,
+                                             DBUS_TYPE_INVALID ))
+            reply = p_dbus_message_new_error( msg, DBUS_ERROR_INVALID_ARGS, error.message );
+        else
+        {
+            reply = p_dbus_message_new_method_return( msg );
+            p_dbus_message_iter_init_append( reply, &iter );
+            if (all) p_dbus_message_iter_open_container( &iter, DBUS_TYPE_ARRAY, "{sv}", &dict );
+            for (i = 0; i < ARRAY_SIZE(props); i++)
+            {
+                DBusMessageIter *target = &iter;
+                if (!all && strcmp( name, props[i] )) continue;
+                if (all)
+                {
+                    p_dbus_message_iter_open_container( &dict, DBUS_TYPE_DICT_ENTRY, NULL, &entry );
+                    p_dbus_message_iter_append_basic( &entry, DBUS_TYPE_STRING, &props[i] );
+                    target = &entry;
+                }
+                if (i == 0)
+                {
+                    p_dbus_message_iter_open_container( target, DBUS_TYPE_VARIANT, DBUS_TYPE_UINT32_AS_STRING, &var );
+                    p_dbus_message_iter_append_basic( &var, DBUS_TYPE_UINT32, &version );
+                    p_dbus_message_iter_close_container( target, &var );
+                }
+                else if (i == 3)
+                {
+                    p_dbus_message_iter_open_container( target, DBUS_TYPE_VARIANT, "as", &var );
+                    p_dbus_message_iter_open_container( &var, DBUS_TYPE_ARRAY, DBUS_TYPE_STRING_AS_STRING, &strs );
+                    p_dbus_message_iter_close_container( &var, &strs );
+                    p_dbus_message_iter_close_container( target, &var );
+                }
+                else append_variant_string( target, i == 1 ? "ltr" : "normal" );
+                if (all) p_dbus_message_iter_close_container( &dict, &entry );
+                else break;
+            }
+            if (all) p_dbus_message_iter_close_container( &iter, &dict );
+            else if (i == ARRAY_SIZE(props))
+            {
+                p_dbus_message_unref( reply );
+                reply = p_dbus_message_new_error( msg, DBUS_ERROR_UNKNOWN_PROPERTY, name );
+            }
+        }
+    }
+    else if (p_dbus_message_is_method_call( msg, DBUSMENU_INTERFACE, "GetLayout" ))
+    {
+        p_dbus_message_iter_init( msg, &iter );
+        if (p_dbus_message_iter_get_arg_type( &iter ) == DBUS_TYPE_INT32)
+        {
+            p_dbus_message_iter_get_basic( &iter, &id );
+            if (p_dbus_message_iter_next( &iter ) && p_dbus_message_iter_get_arg_type( &iter ) == DBUS_TYPE_INT32)
+                p_dbus_message_iter_get_basic( &iter, &depth );
+        }
+        pthread_mutex_lock( &sni_mutex );
+        icon = find_icon_by_handle( handle );
+        if (!icon || (id && id != MENU_PLACEHOLDER_ID && menu_item_index( icon, id ) < 0))
+            reply = p_dbus_message_new_error( msg, DBUS_ERROR_INVALID_ARGS, "no such item" );
+        else
+        {
+            dbus_uint32_t revision = icon->menu.revision;
+            reply = p_dbus_message_new_method_return( msg );
+            p_dbus_message_iter_init_append( reply, &iter );
+            p_dbus_message_iter_append_basic( &iter, DBUS_TYPE_UINT32, &revision );
+            append_menu_layout( &iter, icon, id, depth );
+        }
+        pthread_mutex_unlock( &sni_mutex );
+    }
+    else if (p_dbus_message_is_method_call( msg, DBUSMENU_INTERFACE, "GetGroupProperties" ))
+    {
+        DBusMessageIter out, strct;
+        reply = p_dbus_message_new_method_return( msg );
+        p_dbus_message_iter_init_append( reply, &out );
+        p_dbus_message_iter_open_container( &out, DBUS_TYPE_ARRAY, "(ia{sv})", &array );
+        pthread_mutex_lock( &sni_mutex );
+        if ((icon = find_icon_by_handle( handle )) && p_dbus_message_iter_init( msg, &iter ) &&
+            p_dbus_message_iter_get_arg_type( &iter ) == DBUS_TYPE_ARRAY)
+        {
+            p_dbus_message_iter_recurse( &iter, &sub );
+            while (p_dbus_message_iter_get_arg_type( &sub ) == DBUS_TYPE_INT32)
+            {
+                p_dbus_message_iter_get_basic( &sub, &id );
+                if (!id || id == MENU_PLACEHOLDER_ID || menu_item_index( icon, id ) >= 0)
+                {
+                    p_dbus_message_iter_open_container( &array, DBUS_TYPE_STRUCT, NULL, &strct );
+                    p_dbus_message_iter_append_basic( &strct, DBUS_TYPE_INT32, &id );
+                    append_menu_properties( &strct, icon, id );
+                    p_dbus_message_iter_close_container( &array, &strct );
+                }
+                if (!p_dbus_message_iter_next( &sub )) break;
+            }
+        }
+        pthread_mutex_unlock( &sni_mutex );
+        p_dbus_message_iter_close_container( &out, &array );
+    }
+    else if (p_dbus_message_is_method_call( msg, DBUSMENU_INTERFACE, "GetProperty" ))
+        reply = p_dbus_message_new_error( msg, DBUS_ERROR_NOT_SUPPORTED, "use GetGroupProperties" );
+    else if (p_dbus_message_is_method_call( msg, DBUSMENU_INTERFACE, "Event" ))
+    {
+        if (p_dbus_message_iter_init( msg, &iter ) && p_dbus_message_iter_get_arg_type( &iter ) == DBUS_TYPE_INT32)
+        {
+            p_dbus_message_iter_get_basic( &iter, &id );
+            if (p_dbus_message_iter_next( &iter ) && p_dbus_message_iter_get_arg_type( &iter ) == DBUS_TYPE_STRING)
+            {
+                p_dbus_message_iter_get_basic( &iter, &event );
+                menu_event( conn, handle, id, event );
+            }
+        }
+        reply = p_dbus_message_new_method_return( msg );
+    }
+    else if (p_dbus_message_is_method_call( msg, DBUSMENU_INTERFACE, "EventGroup" ))
+    {
+        DBusMessageIter out, errors;
+        if (p_dbus_message_iter_init( msg, &iter ) && p_dbus_message_iter_get_arg_type( &iter ) == DBUS_TYPE_ARRAY)
+        {
+            p_dbus_message_iter_recurse( &iter, &array );
+            while (p_dbus_message_iter_get_arg_type( &array ) == DBUS_TYPE_STRUCT)
+            {
+                p_dbus_message_iter_recurse( &array, &sub );
+                if (p_dbus_message_iter_get_arg_type( &sub ) == DBUS_TYPE_INT32)
+                {
+                    p_dbus_message_iter_get_basic( &sub, &id );
+                    if (p_dbus_message_iter_next( &sub ) && p_dbus_message_iter_get_arg_type( &sub ) == DBUS_TYPE_STRING)
+                    {
+                        p_dbus_message_iter_get_basic( &sub, &event );
+                        menu_event( conn, handle, id, event );
+                    }
+                }
+                if (!p_dbus_message_iter_next( &array )) break;
+            }
+        }
+        reply = p_dbus_message_new_method_return( msg );
+        p_dbus_message_iter_init_append( reply, &out );
+        p_dbus_message_iter_open_container( &out, DBUS_TYPE_ARRAY, DBUS_TYPE_INT32_AS_STRING, &errors );
+        p_dbus_message_iter_close_container( &out, &errors );
+    }
+    else if (p_dbus_message_is_method_call( msg, DBUSMENU_INTERFACE, "AboutToShow" ))
+    {
+        p_dbus_message_get_args( msg, &error, DBUS_TYPE_INT32, &id, DBUS_TYPE_INVALID );
+        if (!id)
+        {
+            menu_about_to_show( conn, msg, handle, FALSE );  /* replied later */
+            p_dbus_error_free( &error );
+            return DBUS_HANDLER_RESULT_HANDLED;
+        }
+        reply_about_to_show( conn, msg, FALSE, FALSE );  /* submenus came with the menu */
+    }
+    else if (p_dbus_message_is_method_call( msg, DBUSMENU_INTERFACE, "AboutToShowGroup" ))
+    {
+        BOOL root = FALSE;
+        if (p_dbus_message_iter_init( msg, &iter ) && p_dbus_message_iter_get_arg_type( &iter ) == DBUS_TYPE_ARRAY)
+        {
+            p_dbus_message_iter_recurse( &iter, &sub );
+            while (p_dbus_message_iter_get_arg_type( &sub ) == DBUS_TYPE_INT32)
+            {
+                p_dbus_message_iter_get_basic( &sub, &id );
+                if (!id) root = TRUE;
+                if (!p_dbus_message_iter_next( &sub )) break;
+            }
+        }
+        if (root)
+        {
+            menu_about_to_show( conn, msg, handle, TRUE );
+            p_dbus_error_free( &error );
+            return DBUS_HANDLER_RESULT_HANDLED;
+        }
+        reply_about_to_show( conn, msg, FALSE, TRUE );
+    }
+    else
+    {
+        p_dbus_error_free( &error );
+        return DBUS_HANDLER_RESULT_NOT_YET_HANDLED;
+    }
+
+    if (reply)
+    {
+        p_dbus_connection_send( conn, reply, NULL );
+        p_dbus_message_unref( reply );
+    }
+    p_dbus_error_free( &error );
+    return DBUS_HANDLER_RESULT_HANDLED;
+}
+
+/* a menu from the application's TrackPopupMenu (explorer's WM_COPYDATA); TRUE when the tray shows it */
+static LRESULT menu_offered( HWND hwnd, const struct systray_menu_data *data )
+{
+    struct systray_menu_data *copy;
+    UINT i, text_len, header;
+    struct sni_icon *icon;
+    DBusConnection *conn = NULL;
+    DBusMessage *msg = NULL, *signal;
+    dbus_uint32_t revision = 0;
+    dbus_int32_t root = 0;
+    BOOL group = FALSE;
+    const WCHAR *text;
+
+    /* the application's data: everything it points at must be inside it */
+    header = offsetof( struct systray_menu_data, items[data->count] );
+    if (data->size < header || (data->size - header) % sizeof(WCHAR)) return FALSE;
+    text_len = (data->size - header) / sizeof(WCHAR);
+    text = (const WCHAR *)&data->items[data->count];
+    if (text_len && text[text_len - 1]) return FALSE;
+    for (i = 0; i < data->count; i++)
+        if (data->items[i].parent >= (INT)i || data->items[i].parent < -1 ||
+            (data->items[i].text != ~0u && data->items[i].text >= text_len))
+            return FALSE;
+    if (!(copy = malloc( data->size ))) return FALSE;
+    memcpy( copy, data, data->size );
+
+    pthread_mutex_lock( &sni_mutex );
+    LIST_FOR_EACH_ENTRY( icon, &sni_icons, struct sni_icon, entry )
+    {
+        if (icon->menu.state != MENU_WAITING || icon->menu.click_pending || !icon->conn) continue;
+        if ((UINT)(UINT_PTR)icon->owner != (UINT)(UINT_PTR)hwnd) continue;
+        if (icon->menu.request != LOWORD( data->request )) continue;
+        free( icon->menu.data );
+        icon->menu.data = copy;
+        copy = NULL;
+        icon->menu.state = MENU_SHOWN;
+        revision = ++icon->menu.revision;
+        msg = icon->menu.about_to_show;
+        group = icon->menu.group;
+        icon->menu.about_to_show = NULL;
+        conn = p_dbus_connection_ref( icon->conn );
+        break;
+    }
+    pthread_mutex_unlock( &sni_mutex );
+    free( copy );
+    if (!conn)
+    {
+        TRACE( "no tray waits for the menu of %p (request %u)\n", hwnd, data->request );
+        return FALSE;
+    }
+
+    TRACE( "menu of %p, %u items, revision %u\n", hwnd, data->count, revision );
+    if ((signal = p_dbus_message_new_signal( DBUSMENU_PATH, DBUSMENU_INTERFACE, "LayoutUpdated" )))
+    {
+        p_dbus_message_append_args( signal, DBUS_TYPE_UINT32, &revision, DBUS_TYPE_INT32, &root, DBUS_TYPE_INVALID );
+        p_dbus_connection_send( conn, signal, NULL );
+        p_dbus_message_unref( signal );
+    }
+    reply_about_to_show( conn, msg, TRUE, group );
+    if (msg) p_dbus_message_unref( msg );
+    p_dbus_connection_unref( conn );
+    sni_wakeup();
+    return TRUE;
+}
+
+/* WAITING past the deadline, a deferred right click, CLOSING past its grace; called without sni_mutex */
+static BOOL menu_timeouts(void)
+{
+    struct { UINT handle; HWND owner; UINT request; int what; DBusMessage *msg; BOOL group; DBusConnection *conn; }
+        work[16];
+    struct { UINT handle; DBusMessage *msg; BOOL group; BOOL user; DBusConnection *conn; } held[16];
+    unsigned int held_count = 0;
+    struct sni_icon *icon;
+    ULONGLONG now = sni_ticks();
+    unsigned int i, count = 0;
+    BOOL active = FALSE;
+
+    pthread_mutex_lock( &sni_mutex );
+    LIST_FOR_EACH_ENTRY( icon, &sni_icons, struct sni_icon, entry )
+    {
+        if (icon->menu.pending)
+        {
+            active = TRUE;
+            if (now >= icon->menu.pending_until && held_count < ARRAY_SIZE(held))
+            {
+                held[held_count].handle = icon->handle;
+                held[held_count].user = now - icon->menu.registered_at >= 3000;
+                held[held_count].msg = NULL;
+                held[held_count].conn = icon->conn ? p_dbus_connection_ref( icon->conn ) : NULL;
+                if (!held[held_count].user)
+                {
+                    /* asked ahead of time: nothing for the application. The host opens only a non-empty menu:
+                     * have it fetch the placeholder (or the last menu) */
+                    held[held_count].msg = icon->menu.pending;
+                    held[held_count].group = icon->menu.pending_group;
+                    icon->menu.pending = NULL;
+                    icon->menu.host_prefetches = TRUE;
+                }
+                held_count++;
+            }
+        }
+        if (icon->menu.state == MENU_IDLE) continue;
+        active = TRUE;
+        if (count == ARRAY_SIZE(work)) break;
+        work[count].handle = icon->handle;
+        work[count].owner = icon->owner;
+        work[count].request = icon->menu.request;
+        work[count].msg = NULL;
+        work[count].conn = NULL;
+        work[count].what = 0;
+        if (icon->menu.state == MENU_WAITING && now >= icon->menu.deadline)
+        {
+            /* the application showed no Win32 menu (or no menu at all) */
+            work[count].what = 1;
+            if (!icon->menu.data) icon->menu.foreign = TRUE;
+            work[count].msg = icon->menu.about_to_show;
+            work[count].group = icon->menu.group;
+            work[count].conn = icon->conn ? p_dbus_connection_ref( icon->conn ) : NULL;
+            icon->menu.about_to_show = NULL;
+            icon->menu.state = MENU_IDLE;
+        }
+        else if (icon->menu.state == MENU_WAITING && icon->menu.click_pending) work[count].what = 2;
+        else if (icon->menu.state == MENU_CLOSING && now >= icon->menu.deadline)
+        {
+            work[count].what = 3;
+            icon->menu.state = MENU_IDLE;
+        }
+        if (work[count].what) count++;
+    }
+    pthread_mutex_unlock( &sni_mutex );
+
+    for (i = 0; i < held_count; i++)
+    {
+        if (held[i].user) menu_start_request( held[i].conn, held[i].handle );
+        else
+        {
+            TRACE( "AboutToShow ahead of time on item %u\n", held[i].handle );
+            reply_about_to_show( held[i].conn, held[i].msg, TRUE, held[i].group );
+            p_dbus_message_unref( held[i].msg );
+        }
+        if (held[i].conn) p_dbus_connection_unref( held[i].conn );
+    }
+
+    for (i = 0; i < count; i++)
+    {
+        switch (work[i].what)
+        {
+        case 1:
+            TRACE( "no menu came from %p for request %u\n", work[i].owner, work[i].request );
+            NtUserRemoveProp( work[i].owner, menu_propW );
+            /* "update": a host showing the placeholder drops it (Plasma then shows nothing) */
+            reply_about_to_show( work[i].conn, work[i].msg, TRUE, work[i].group );
+            if (work[i].msg) p_dbus_message_unref( work[i].msg );
+            if (work[i].conn) p_dbus_connection_unref( work[i].conn );
+            break;
+        case 2:
+            /* the application has left its previous menu once it took that result */
+            if (!NtUserGetProp( work[i].owner, menu_resultW ))
+            {
+                BOOL relay = FALSE;
+                pthread_mutex_lock( &sni_mutex );
+                if ((icon = find_icon_by_handle( work[i].handle )) && icon->menu.state == MENU_WAITING &&
+                    icon->menu.click_pending)
+                {
+                    icon->menu.click_pending = FALSE;
+                    icon->menu.deadline = sni_ticks() + 1000;
+                    relay = TRUE;
+                }
+                pthread_mutex_unlock( &sni_mutex );
+                if (relay) relay_context_menu( work[i].handle );
+            }
+            break;
+        case 3:
+            finish_app_menu( work[i].owner, work[i].request, 0 );
+            break;
+        }
+    }
+    return active;
+}
