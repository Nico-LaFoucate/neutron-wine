+/* free an icon that is off the list; called without sni_mutex */
+static void free_icon( struct sni_icon *icon )
+{
+    /* an application still in a menu the tray showed for this icon gets "nothing chosen" */
+    if (icon->menu.state == MENU_SHOWN || icon->menu.state == MENU_CLOSING)
+        finish_app_menu( icon->owner, icon->menu.request, 0 );
+    if (icon->menu.about_to_show) p_dbus_message_unref( icon->menu.about_to_show );
+    if (icon->menu.pending) p_dbus_message_unref( icon->menu.pending );
+    free( icon->menu.data );
+    close_balloon( icon->balloon );
+    close_connection( icon->conn );
+    free( icon->tip );
+    free( icon->argb );
+    free( icon );
+}
