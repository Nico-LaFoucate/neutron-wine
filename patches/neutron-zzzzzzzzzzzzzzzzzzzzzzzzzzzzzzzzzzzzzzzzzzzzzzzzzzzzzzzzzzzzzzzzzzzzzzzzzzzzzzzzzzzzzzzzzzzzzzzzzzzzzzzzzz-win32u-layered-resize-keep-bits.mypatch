--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -3024,6 +3024,24 @@
  * copied one. Windows never shows a resized window blank: the contents follow the window. Lightroom Classic's Masks
  * panel resizes three times per Select Subject, and frame dumps show a whole-panel blank frame each time.
  * Copy first, then update the shape (and flush). Kill switch NEUTRON_COPY_BEFORE_SHAPE=0. */
+/* NEUTRON: a layered window keeps its contents across a resize on Windows, whatever SWP_NOCOPYBITS says, but
+ * here a new surface starts as the dark fill, and with no valid_rects nothing was copied in. Photoshop
+ * resizes a floating panel, a layered window, that way and redraws through its own queue, not WM_PAINT, so
+ * the resize hold saw nothing to wait for and the empty surface went on screen as dark grey blocks, shrinking
+ * as well as growing. The copy takes the invalid area too: all of a window's own pixels are invalid after such
+ * a resize, its title row and edges here, and only its children would be kept. Kill switch
+ * NEUTRON_LAYERED_KEEP_BITS=0. */
+static BOOL neutron_layered_keep_bits(void)
+{
+    static int on = -1;
+    if (on < 0)
+    {
+        const char *e = getenv( "NEUTRON_LAYERED_KEEP_BITS" );
+        on = !(e && e[0] == '0');
+    }
+    return on;
+}
+
