         NtGdiDeleteObjectApp( surface->shape_region );
         surface->shape_region = 0;
-        surface->bounds = surface->rect;
+        /* NEUTRON: an edge hold reads the bounds as what was drawn, and publishes everything when it ends */
+        if (!neutron_resize_hold_edges_waiting( surface )) surface->bounds = surface->rect;
     }
     else if (shape_region && !NtGdiEqualRgn( shape_region, surface->shape_region ))
     {
         if (!surface->shape_region) surface->shape_region = NtGdiCreateRectRgn( 0, 0, 0, 0 );
         NtGdiCombineRgn( surface->shape_region, shape_region, 0, RGN_COPY );
-        surface->bounds = surface->rect;
+        if (!neutron_resize_hold_edges_waiting( surface )) surface->bounds = surface->rect;
     }
 
     window_surface_unlock( surface );
@@ -2024,11 +2026,17 @@
  * Windows' compositor keeps showing a resized window's previous frame until the window has redrawn (INFERRED,
  * not verified); do the same: hold the grown surface back until no window in its tree still needs painting,
  * and never longer than NEUTRON_RESIZE_HOLD_MAX_MS. Kill switch NEUTRON_RESIZE_HOLD=0; NEUTRON_RESIZE_HOLD_TRACE=1
- * logs each hold. */
+ * logs each hold.
+ *
+ * A layered window can be redrawn through the app's own queue instead of WM_PAINT, Photoshop's floating panels are,
+ * so nothing in the update region says a paint is coming. Those wait for drawing to reach the new edges of the
+ * window instead (neutron_resize_hold_edges), for at most NEUTRON_RESIZE_HOLD_EDGES_MS from the first step of a drag,
+ * so that a fast drag still moves. Kill switch NEUTRON_RESIZE_HOLD_EDGES=0. */
 #define NEUTRON_RESIZE_HOLD_MAX_MS 250
+#define NEUTRON_RESIZE_HOLD_EDGES_MS 34
 #define NEUTRON_RESIZE_HOLD_SLOTS 8
 
-static struct { struct window_surface *surface; HWND hwnd; DWORD start; } neutron_holds[NEUTRON_RESIZE_HOLD_SLOTS];
+static struct { struct window_surface *surface; HWND hwnd; DWORD start; int right, bottom; } neutron_holds[NEUTRON_RESIZE_HOLD_SLOTS];
 static pthread_mutex_t neutron_hold_lock = PTHREAD_MUTEX_INITIALIZER;
 
 static int neutron_resize_hold_on(void)
@@ -2062,38 +2070,120 @@
     neutron_holds[slot].surface = surface;
     neutron_holds[slot].hwnd = hwnd;
     neutron_holds[slot].start = now;
+    neutron_holds[slot].right = neutron_holds[slot].bottom = 0;
     pthread_mutex_unlock( &neutron_hold_lock );
     if (neutron_resize_hold_trace()) ERR( "neutron-resize-hold: t=%u HOLD %p surface %p\n", (UINT)now, hwnd, surface );
 }
 
+static BOOL neutron_resize_hold_edges_waiting( struct window_surface *surface )
+{
+    BOOL ret = FALSE;
+    int i;
+
+    pthread_mutex_lock( &neutron_hold_lock );
+    for (i = 0; i < NEUTRON_RESIZE_HOLD_SLOTS; i++)
+        if (neutron_holds[i].surface == surface) ret = neutron_holds[i].right || neutron_holds[i].bottom;
+    pthread_mutex_unlock( &neutron_hold_lock );
+    return ret;
+}
+
+BOOL neutron_resize_hold_edges_on(void)
+{
+    static int v = -1;
+    if (v < 0) { const char *e = getenv( "NEUTRON_RESIZE_HOLD_EDGES" ); v = !(e && e[0] == '0'); }
+    return v && neutron_resize_hold_on();
+}
+
+void neutron_resize_hold_edges( struct window_surface *surface, HWND hwnd, int right, int bottom )
+{
+    int i, slot = 0;
+    DWORD now, start;
+
+    if (!surface || surface == &dummy_surface) return;
+    start = now = NtGetTickCount();
+    pthread_mutex_lock( &neutron_hold_lock );
+    for (i = 0; i < NEUTRON_RESIZE_HOLD_SLOTS; i++)
+    {
+        if (neutron_holds[i].surface && neutron_holds[i].hwnd == hwnd)
+        {
+            /* the next step of a drag: the wait keeps counting from the first one. Photoshop sets a panel's
+             * width and height in two calls, so the edges add up. */
+            slot = i;
+            if (neutron_holds[i].right || neutron_holds[i].bottom)
+            {
+                start = neutron_holds[i].start;
+                right = max( right, neutron_holds[i].right );
+                bottom = max( bottom, neutron_holds[i].bottom );
+            }
+            break;
+        }
+        if (!neutron_holds[i].surface ||
+            (int)(now - neutron_holds[i].start) > (int)(now - neutron_holds[slot].start)) slot = i;
+    }
+    neutron_holds[slot].surface = surface;
+    neutron_holds[slot].hwnd = hwnd;
+    neutron_holds[slot].start = start;
+    neutron_holds[slot].right = right;
+    neutron_holds[slot].bottom = bottom;
+    pthread_mutex_unlock( &neutron_hold_lock );
+    if (neutron_resize_hold_trace())
+        ERR( "neutron-resize-hold: t=%u HOLD edges %p surface %p to %d,%d\n", (UINT)now, hwnd, surface, right, bottom );
+}
+
 static BOOL neutron_resize_hold_active( struct window_surface *surface )
 {
     HWND hwnd = 0, child = 0;
     UINT flags = UPDATE_PAINT | UPDATE_ALLCHILDREN;
     DWORD now, start = 0;
-    int i, slot = -1;
+    int i, slot = -1, right = 0, bottom = 0, cap = NEUTRON_RESIZE_HOLD_MAX_MS;
     BOOL hold = FALSE;
 
     if (!neutron_resize_hold_on()) return FALSE;
     pthread_mutex_lock( &neutron_hold_lock );
     for (i = 0; i < NEUTRON_RESIZE_HOLD_SLOTS; i++)
-        if (neutron_holds[i].surface == surface) { slot = i; hwnd = neutron_holds[i].hwnd; start = neutron_holds[i].start; break; }
+        if (neutron_holds[i].surface == surface)
+        {
+            slot = i; hwnd = neutron_holds[i].hwnd; start = neutron_holds[i].start;
+            right = neutron_holds[i].right; bottom = neutron_holds[i].bottom;
+            break;
+        }
     pthread_mutex_unlock( &neutron_hold_lock );
     if (slot < 0) return FALSE;
 
     now = NtGetTickCount();
-    if ((int)(now - start) < NEUTRON_RESIZE_HOLD_MAX_MS && surface->hwnd == hwnd &&
-        get_update_flags( hwnd, &child, &flags ) && (flags & UPDATE_PAINT))
+    if (right || bottom)
+    {
+        RECT bounds;
+
+        cap = NEUTRON_RESIZE_HOLD_EDGES_MS;
+        window_surface_lock( surface );
+        bounds = surface->bounds;
+        window_surface_unlock( surface );
+        if ((int)(now - start) < cap && surface->hwnd == hwnd && (bounds.right < right || bounds.bottom < bottom))
+            hold = TRUE;
+    }
+    else if ((int)(now - start) < NEUTRON_RESIZE_HOLD_MAX_MS && surface->hwnd == hwnd &&
+             get_update_flags( hwnd, &child, &flags ) && (flags & UPDATE_PAINT))
         hold = TRUE;
 
     if (!hold)
     {
         pthread_mutex_lock( &neutron_hold_lock );
-        if (neutron_holds[slot].surface == surface) neutron_holds[slot].surface = NULL, neutron_holds[slot].hwnd = 0;
+        if (neutron_holds[slot].surface == surface)
+        {
+            neutron_holds[slot].surface = NULL, neutron_holds[slot].hwnd = 0;
+            neutron_holds[slot].right = neutron_holds[slot].bottom = 0;
+        }
         pthread_mutex_unlock( &neutron_hold_lock );
+        if (right || bottom)
+        {
+            window_surface_lock( surface );
+            surface->bounds = surface->rect;
+            window_surface_unlock( surface );
+        }
         if (neutron_resize_hold_trace())
             ERR( "neutron-resize-hold: t=%u RELEASE %p after %u ms (%s)\n", (UINT)now, hwnd, (UINT)(now - start),
-                 (int)(now - start) >= NEUTRON_RESIZE_HOLD_MAX_MS ? "cap" : "painted" );
+                 (int)(now - start) >= cap ? "cap" : "painted" );
     }
     return hold;
 }
