+/* ----------------------------------------------------------------------
+ * Presentation registry + background blit thread.
+ *
+ * DirectComposition apps update content by Present()ing the swapchain, not
+ * by Commit()ing every frame, so we cannot rely on Commit to drive the
+ * blit. Instead, when a swapchain is bound to a visual that is rooted in a
+ * target, we register (hwnd, swapchain) and a worker thread copies the
+ * swapchain's current frame onto the window continuously.
+ * -------------------------------------------------------------------- */
+
+struct presentation
+{
+    struct list entry;
+    HWND hwnd;
+    IDXGISwapChain *swapchain;
+};
+
+static struct list presentations = LIST_INIT(presentations);
+static CRITICAL_SECTION presentations_cs;
+static INIT_ONCE presentations_once = INIT_ONCE_STATIC_INIT;
+static HANDLE presentations_thread;
+
+static void dump_bmp(const void *bgra, UINT w, UINT h)
+{
+    BITMAPFILEHEADER fh;
+    BITMAPINFOHEADER ih;
+    DWORD written;
+    HANDLE f;
+
+    f = CreateFileA("C:\\dcomp_capture.bmp", GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
+    if (f == INVALID_HANDLE_VALUE)
+        return;
+    memset(&fh, 0, sizeof(fh));
+    memset(&ih, 0, sizeof(ih));
+    ih.biSize = sizeof(ih);
+    ih.biWidth = w;
+    ih.biHeight = -(LONG)h; /* top-down */
+    ih.biPlanes = 1;
+    ih.biBitCount = 32;
+    ih.biCompression = BI_RGB;
+    fh.bfType = 0x4D42; /* 'BM' */
+    fh.bfOffBits = sizeof(fh) + sizeof(ih);
+    fh.bfSize = fh.bfOffBits + (DWORD)w * 4 * h;
+    WriteFile(f, &fh, sizeof(fh), &written, NULL);
+    WriteFile(f, &ih, sizeof(ih), &written, NULL);
+    WriteFile(f, bgra, (DWORD)w * 4 * h, &written, NULL);
+    CloseHandle(f);
+}
+
+static void blit_swapchain_to_hwnd(IDXGISwapChain *swapchain, HWND hwnd)
+{
+    ID3D11Texture2D *backbuffer = NULL, *staging = NULL;
+    ID3D11Device *d3d_device = NULL;
+    ID3D11DeviceContext *ctx = NULL;
+    ID3D10Multithread *mt = NULL;
+    D3D11_TEXTURE2D_DESC desc;
+    D3D11_MAPPED_SUBRESOURCE map;
+    BITMAPINFO bmi;
+    void *packed = NULL;
+    HDC hdc;
+    RECT rc;
+    UINT y;
+    HRESULT hr;
+    static LONG diag_n;
+    DWORD center = 0;
+    LONG n;
+    BOOL diag;
+
+    n = InterlockedIncrement(&diag_n);
+    diag = (n % 120 == 1);
+
+    if (FAILED(hr = IDXGISwapChain_GetBuffer(swapchain, 0, &IID_ID3D11Texture2D, (void **)&backbuffer)))
+    {
+        if (diag) ERR("diag: GetBuffer failed hr %#lx\n", hr);
+        return;
+    }
+
+    ID3D11Texture2D_GetDevice(backbuffer, &d3d_device);
+    if (!d3d_device)
+        goto done;
+    ID3D11Device_GetImmediateContext(d3d_device, &ctx);
+
+    if (FAILED(ID3D11DeviceContext_QueryInterface(ctx, &IID_ID3D10Multithread, (void **)&mt)))
+        ID3D11Device_QueryInterface(d3d_device, &IID_ID3D10Multithread, (void **)&mt);
+    if (mt)
+    {
+        ID3D10Multithread_SetMultithreadProtected(mt, TRUE);
+        ID3D10Multithread_Enter(mt);
+    }
+
+    ID3D11Texture2D_GetDesc(backbuffer, &desc);
+    if (diag) ERR("diag: backbuffer %ux%u fmt %d usage %d\n", desc.Width, desc.Height, desc.Format, desc.Usage);
+    desc.Usage = D3D11_USAGE_STAGING;
+    desc.BindFlags = 0;
+    desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    desc.MiscFlags = 0;
+    if (FAILED(hr = ID3D11Device_CreateTexture2D(d3d_device, &desc, NULL, &staging)))
+    {
+        if (diag) ERR("diag: CreateTexture2D(staging) failed hr %#lx\n", hr);
+        goto unlock;
+    }
+
+    ID3D11DeviceContext_CopyResource(ctx, (ID3D11Resource *)staging, (ID3D11Resource *)backbuffer);
+
+    if (FAILED(hr = ID3D11DeviceContext_Map(ctx, (ID3D11Resource *)staging, 0, D3D11_MAP_READ, 0, &map)))
+    {
+        if (diag) ERR("diag: Map failed hr %#lx\n", hr);
+        goto unlock;
+    }
+
+    if (diag && desc.Height && desc.Width)
+        center = ((DWORD *)((BYTE *)map.pData + (desc.Height / 2) * map.RowPitch))[desc.Width / 2];
+
+    if ((packed = malloc((SIZE_T)desc.Width * 4 * desc.Height)))
+    {
+        for (y = 0; y < desc.Height; y++)
+            memcpy((BYTE *)packed + (SIZE_T)y * desc.Width * 4,
+                   (BYTE *)map.pData + (SIZE_T)y * map.RowPitch,
+                   (SIZE_T)desc.Width * 4);
+    }
+
+    ID3D11DeviceContext_Unmap(ctx, (ID3D11Resource *)staging, 0);
+
+unlock:
+    if (mt)
+    {
+        ID3D10Multithread_Leave(mt);
+        ID3D10Multithread_Release(mt);
+    }
+
+    if (packed)
+    {
+        if (diag)
+        {
+            UINT *px = packed;
+            UINT corner = px[0];
+            ULONG i, total = (ULONG)desc.Width * desc.Height, diffcount = 0;
+            for (i = 0; i < total; i++)
+                if ((px[i] & 0xffffff) != (corner & 0xffffff)) diffcount++;
+            ERR("diag: corner=%08x pixels-differing-from-corner %lu / %lu; dumping C:\\dcomp_capture.bmp\n",
+                corner, diffcount, total);
+            dump_bmp(packed, desc.Width, desc.Height);
+        }
+
+        memset(&bmi, 0, sizeof(bmi));
+        bmi.bmiHeader.biSize = sizeof(BITMAPINFOHEADER);
+        bmi.bmiHeader.biWidth = desc.Width;
+        bmi.bmiHeader.biHeight = -(LONG)desc.Height; /* top-down */
+        bmi.bmiHeader.biPlanes = 1;
+        bmi.bmiHeader.biBitCount = 32;
+        bmi.bmiHeader.biCompression = BI_RGB;
+
+        if ((hdc = GetDC(hwnd)))
+        {
+            int sb;
+            GetClientRect(hwnd, &rc);
+            SetStretchBltMode(hdc, COLORONCOLOR);
+            sb = StretchDIBits(hdc, 0, 0, rc.right - rc.left, rc.bottom - rc.top,
+                          0, 0, desc.Width, desc.Height,
+                          packed, &bmi, DIB_RGB_COLORS, SRCCOPY);
+            if (diag) ERR("diag: hwnd %p client %ldx%ld center=%08lx StretchDIBits=%d\n",
+                          hwnd, rc.right - rc.left, rc.bottom - rc.top, center, sb);
+            ReleaseDC(hwnd, hdc);
+        }
+        else if (diag) ERR("diag: GetDC(%p) returned NULL\n", hwnd);
+        free(packed);
+    }
+
+done:
+    if (staging) ID3D11Texture2D_Release(staging);
+    if (ctx) ID3D11DeviceContext_Release(ctx);
+    if (d3d_device) ID3D11Device_Release(d3d_device);
+    if (backbuffer) ID3D11Texture2D_Release(backbuffer);
+}
+
+static DWORD WINAPI presentations_proc(void *arg)
+{
+    for (;;)
+    {
+        struct presentation *p;
+
+        EnterCriticalSection(&presentations_cs);
+        LIST_FOR_EACH_ENTRY(p, &presentations, struct presentation, entry)
+        {
+            if (p->swapchain && p->hwnd && IsWindow(p->hwnd))
+                blit_swapchain_to_hwnd(p->swapchain, p->hwnd);
+        }
+        LeaveCriticalSection(&presentations_cs);
+        Sleep(16);
+    }
+    return 0;
+}
+
+static BOOL CALLBACK presentations_init(INIT_ONCE *once, void *param, void **ctx)
+{
+    InitializeCriticalSection(&presentations_cs);
+    presentations_thread = CreateThread(NULL, 0, presentations_proc, NULL, 0, NULL);
+    return TRUE;
+}
+
+static void register_presentation(HWND hwnd, IUnknown *content)
+{
+    IDXGISwapChain *swapchain = NULL;
+    struct presentation *p;
+
+    if (!hwnd || !content)
+        return;
+    if (FAILED(IUnknown_QueryInterface(content, &IID_IDXGISwapChain, (void **)&swapchain)))
+        return;
+
+    InitOnceExecuteOnce(&presentations_once, presentations_init, NULL, NULL);
+
+    EnterCriticalSection(&presentations_cs);
+    LIST_FOR_EACH_ENTRY(p, &presentations, struct presentation, entry)
+    {
+        if (p->hwnd == hwnd)
+        {
+            if (p->swapchain != swapchain)
+            {
+                if (p->swapchain) IDXGISwapChain_Release(p->swapchain);
+                p->swapchain = swapchain; /* take QI ref */
+            }
+            else IDXGISwapChain_Release(swapchain);
+            LeaveCriticalSection(&presentations_cs);
+            return;
+        }
+    }
+
+    if ((p = calloc(1, sizeof(*p))))
+    {
+        p->hwnd = hwnd;
+        p->swapchain = swapchain; /* take QI ref */
+        list_add_tail(&presentations, &p->entry);
+        TRACE("registered presentation hwnd %p swapchain %p.\n", hwnd, swapchain);
+    }
+    else IDXGISwapChain_Release(swapchain);
+    LeaveCriticalSection(&presentations_cs);
+}
+
+static void unregister_presentations_for_hwnd(HWND hwnd)
+{
+    struct presentation *p, *next;
+
+    InitOnceExecuteOnce(&presentations_once, presentations_init, NULL, NULL);
+
+    EnterCriticalSection(&presentations_cs);
+    LIST_FOR_EACH_ENTRY_SAFE(p, next, &presentations, struct presentation, entry)
+    {
+        if (p->hwnd == hwnd)
+        {
+            list_remove(&p->entry);
+            if (p->swapchain) IDXGISwapChain_Release(p->swapchain);
+            free(p);
+        }
+    }
+    LeaveCriticalSection(&presentations_cs);
+}
+
+/* Walk a visual subtree and register any swapchain content against hwnd. */
+static void visual_register(struct composition_visual *visual, HWND hwnd)
+{
+    struct composition_visual *child;
+
+    if (visual->content)
+        register_presentation(hwnd, visual->content);
+
+    LIST_FOR_EACH_ENTRY(child, &visual->children, struct composition_visual, entry)
+        visual_register(child, hwnd);
+}
+
+/* ----------------------------------------------------------------------
+ * IDCompositionVisual2
+ * -------------------------------------------------------------------- */
+
+static const IDCompositionVisual2Vtbl composition_visual_vtbl;
+
+static HRESULT WINAPI visual_QueryInterface(IDCompositionVisual2 *iface, REFIID iid, void **out)
+{
+    struct composition_visual *visual = impl_visual_from_IDCompositionVisual2(iface);
+
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown)
+            || IsEqualGUID(iid, &IID_IDCompositionVisual)
+            || IsEqualGUID(iid, &IID_IDCompositionVisual2))
+    {
+        IDCompositionVisual2_AddRef(&visual->IDCompositionVisual2_iface);
+        *out = &visual->IDCompositionVisual2_iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI visual_AddRef(IDCompositionVisual2 *iface)
+{
+    struct composition_visual *visual = impl_visual_from_IDCompositionVisual2(iface);
+    return InterlockedIncrement(&visual->refcount);
+}
+
+static ULONG WINAPI visual_Release(IDCompositionVisual2 *iface)
+{
+    struct composition_visual *visual = impl_visual_from_IDCompositionVisual2(iface);
+    ULONG refcount = InterlockedDecrement(&visual->refcount);
+    struct composition_visual *child, *next;
+
+    if (!refcount)
+    {
+        if (visual->content) IUnknown_Release(visual->content);
+        LIST_FOR_EACH_ENTRY_SAFE(child, next, &visual->children, struct composition_visual, entry)
+        {
+            list_remove(&child->entry);
+            IDCompositionVisual2_Release(&child->IDCompositionVisual2_iface);
+        }
+        free(visual);
+    }
+    return refcount;
+}
+
