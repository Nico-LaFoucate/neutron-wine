+
+static HRESULT WINAPI visual_SetContent(IDCompositionVisual2 *iface, IUnknown *content)
+{
+    struct composition_visual *visual = impl_visual_from_IDCompositionVisual2(iface);
+
+    TRACE("%p, %p.\n", iface, content);
+
+    if (content) IUnknown_AddRef(content);
+    if (visual->content) IUnknown_Release(visual->content);
+    visual->content = content;
+
+    if (content)
+    {
+        IDXGISwapChain *swapchain;
+        if (SUCCEEDED(IUnknown_QueryInterface(content, &IID_IDXGISwapChain, (void **)&swapchain)))
+        {
+            TRACE("content %p is an IDXGISwapChain.\n", content);
+            IDXGISwapChain_Release(swapchain);
+        }
+        else
+            FIXME("content %p is not a swapchain - surface content not yet handled.\n", content);
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI visual_AddVisual(IDCompositionVisual2 *iface, IDCompositionVisual *child,
+        BOOL insert_above, IDCompositionVisual *reference)
+{
+    struct composition_visual *visual = impl_visual_from_IDCompositionVisual2(iface);
+    struct composition_visual *child_impl;
+
+    TRACE("%p, %p, %d, %p.\n", iface, child, insert_above, reference);
+
+    if (!child) return E_INVALIDARG;
+    child_impl = CONTAINING_RECORD((IDCompositionVisual2 *)child, struct composition_visual, IDCompositionVisual2_iface);
+    IDCompositionVisual2_AddRef(&child_impl->IDCompositionVisual2_iface);
+    list_add_tail(&visual->children, &child_impl->entry);
+    return S_OK;
+}
+
+static HRESULT WINAPI visual_RemoveVisual(IDCompositionVisual2 *iface, IDCompositionVisual *child)
+{
+    struct composition_visual *child_impl;
+
+    TRACE("%p, %p.\n", iface, child);
+
+    if (!child) return E_INVALIDARG;
+    child_impl = CONTAINING_RECORD((IDCompositionVisual2 *)child, struct composition_visual, IDCompositionVisual2_iface);
+    list_remove(&child_impl->entry);
+    IDCompositionVisual2_Release(&child_impl->IDCompositionVisual2_iface);
+    return S_OK;
+}
+
+static HRESULT WINAPI visual_RemoveAllVisuals(IDCompositionVisual2 *iface)
+{
+    struct composition_visual *visual = impl_visual_from_IDCompositionVisual2(iface);
+    struct composition_visual *child, *next;
+
+    TRACE("%p.\n", iface);
+
+    LIST_FOR_EACH_ENTRY_SAFE(child, next, &visual->children, struct composition_visual, entry)
+    {
+        list_remove(&child->entry);
+        IDCompositionVisual2_Release(&child->IDCompositionVisual2_iface);
+    }
+    return S_OK;
+}
+
