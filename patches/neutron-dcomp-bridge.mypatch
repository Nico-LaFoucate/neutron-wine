+};
+
+static HRESULT create_visual(struct composition_visual **out)
+{
+    struct composition_visual *visual;
+
+    if (!(visual = calloc(1, sizeof(*visual))))
+        return E_OUTOFMEMORY;
+    visual->IDCompositionVisual2_iface.lpVtbl = &composition_visual_vtbl;
+    visual->refcount = 1;
+    list_init(&visual->children);
+    *out = visual;
+    return S_OK;
+}
+
+/* ----------------------------------------------------------------------
+ * IDCompositionTarget
+ * -------------------------------------------------------------------- */
+
+static const IDCompositionTargetVtbl composition_target_vtbl;
+
+static HRESULT WINAPI target_QueryInterface(IDCompositionTarget *iface, REFIID iid, void **out)
+{
+    struct composition_target *target = impl_target_from_IDCompositionTarget(iface);
+
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IDCompositionTarget))
+    {
+        IDCompositionTarget_AddRef(&target->IDCompositionTarget_iface);
+        *out = &target->IDCompositionTarget_iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI target_AddRef(IDCompositionTarget *iface)
+{
+    struct composition_target *target = impl_target_from_IDCompositionTarget(iface);
+    return InterlockedIncrement(&target->refcount);
+}
+
+static ULONG WINAPI target_Release(IDCompositionTarget *iface)
+{
+    struct composition_target *target = impl_target_from_IDCompositionTarget(iface);
+    ULONG refcount = InterlockedDecrement(&target->refcount);
+
+    if (!refcount)
+    {
+        struct composition_device *device = target->device;
+        unregister_presentations_for_hwnd(target->hwnd);
+        EnterCriticalSection(&device->cs);
+        list_remove(&target->entry);
+        LeaveCriticalSection(&device->cs);
+        if (target->root) IDCompositionVisual2_Release(target->root);
+        IDCompositionDesktopDevice_Release(&device->IDCompositionDesktopDevice_iface);
+        free(target);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI target_SetRoot(IDCompositionTarget *iface, IDCompositionVisual *visual)
+{
+    struct composition_target *target = impl_target_from_IDCompositionTarget(iface);
+    IDCompositionVisual2 *visual2 = (IDCompositionVisual2 *)visual;
+
+    TRACE("%p, %p.\n", iface, visual);
+
+    if (visual2) IDCompositionVisual2_AddRef(visual2);
+    if (target->root) IDCompositionVisual2_Release(target->root);
+    target->root = visual2;
+    return S_OK;
+}
+
+static const IDCompositionTargetVtbl composition_target_vtbl =
+{
+    target_QueryInterface,
+    target_AddRef,
+    target_Release,
+    target_SetRoot,
+};
+
+/* ----------------------------------------------------------------------
+ * IDCompositionDesktopDevice (covers IDCompositionDevice2)
+ * -------------------------------------------------------------------- */
+
+static const IDCompositionDesktopDeviceVtbl composition_device_vtbl;
+
+static HRESULT WINAPI device_QueryInterface(IDCompositionDesktopDevice *iface, REFIID iid, void **out)
+{
+    struct composition_device *device = impl_device_from_IDCompositionDesktopDevice(iface);
+
+    TRACE("%p, %s, %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_IUnknown)
+            || IsEqualGUID(iid, &IID_IDCompositionDevice2)
+            || IsEqualGUID(iid, &IID_IDCompositionDesktopDevice))
+    {
+        IDCompositionDesktopDevice_AddRef(&device->IDCompositionDesktopDevice_iface);
+        *out = &device->IDCompositionDesktopDevice_iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented.\n", debugstr_guid(iid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI device_AddRef(IDCompositionDesktopDevice *iface)
+{
+    struct composition_device *device = impl_device_from_IDCompositionDesktopDevice(iface);
+    return InterlockedIncrement(&device->refcount);
+}
+
+static ULONG WINAPI device_Release(IDCompositionDesktopDevice *iface)
+{
+    struct composition_device *device = impl_device_from_IDCompositionDesktopDevice(iface);
+    ULONG refcount = InterlockedDecrement(&device->refcount);
+
+    if (!refcount)
+    {
+        if (device->rendering_device) IUnknown_Release(device->rendering_device);
+        DeleteCriticalSection(&device->cs);
+        free(device);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI device_Commit(IDCompositionDesktopDevice *iface)
 {
-    FIXME("%p, %s, %p.\n", dxgi_device, debugstr_guid(iid), device);
+    struct composition_device *device = impl_device_from_IDCompositionDesktopDevice(iface);
+    struct composition_target *target;
 
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&device->cs);
+    LIST_FOR_EACH_ENTRY(target, &device->targets, struct composition_target, entry)
+    {
+        if (target->root && target->hwnd)
+            visual_register(impl_visual_from_IDCompositionVisual2(target->root), target->hwnd);
+    }
+    LeaveCriticalSection(&device->cs);
+    return S_OK;
+}
