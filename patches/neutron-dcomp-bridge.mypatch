+};
+
+static HRESULT create_device(IUnknown *rendering_device, REFIID iid, void **out)
+{
+    struct composition_device *device;
+    HRESULT hr;
+
+    if (!(device = calloc(1, sizeof(*device))))
+        return E_OUTOFMEMORY;
+    device->IDCompositionDesktopDevice_iface.lpVtbl = &composition_device_vtbl;
+    device->refcount = 1;
+    device->rendering_device = rendering_device;
+    if (rendering_device) IUnknown_AddRef(rendering_device);
+    list_init(&device->targets);
+    InitializeCriticalSection(&device->cs);
+
+    hr = IDCompositionDesktopDevice_QueryInterface(&device->IDCompositionDesktopDevice_iface, iid, out);
+    IDCompositionDesktopDevice_Release(&device->IDCompositionDesktopDevice_iface);
+    return hr;
+}
+
+/* HWND side-channel for the vkd3d-proton bridge. The program monitor presents
+ * through vkd3d-proton's own D3D12 swapchain, which knows its Vulkan surface
+ * but not the HWND. DXVK builds that surface from the HWND, so DXVK records the
+ * window here right before vkd3d creates the surface, and vkd3d reads it back at
+ * swapchain-init. Creation is synchronous on one thread, so a plain global is
+ * sufficient and avoids cross-DLL TLS quirks. */
+static HWND pending_hwnd;
+
+void dcomp_set_pending_hwnd(HWND hwnd)
+{
+    pending_hwnd = hwnd;
+}
+
+HWND dcomp_get_pending_hwnd(void)
+{
+    return pending_hwnd;
+}
+
+/* External entry point: lets DXVK (or any module) hand us a real windowed
+ * swapchain so the blit thread can present it to its window via GDI. Used for
+ * surfaces that bypass DirectComposition (e.g. Premiere's program monitor),
+ * which otherwise present to an invisible Vulkan child-window surface. */
+void dcomp_register_external(HWND hwnd, IUnknown *swapchain)
+{
+    /* gluon-register-fallback: composition swapchains present with m_window == 0.
+     * Fall back to the pending hwnd (set by the surface factory) so the blit
+     * worker presents to the correct window (UXP composition panels / program monitor). */
+    if (!hwnd)
+    {
+        hwnd = pending_hwnd;
+        ERR("gluon-register-fallback: null hwnd -> using pending_hwnd %p for swapchain %p\n",
+            hwnd, swapchain);
+    }
+    TRACE("%p, %p.\n", hwnd, swapchain);
+    register_presentation(hwnd, swapchain);
+}
+
+HRESULT WINAPI DCompositionCreateDevice(IDXGIDevice *dxgi_device, REFIID iid, void **device)
+{
+    TRACE("%p, %s, %p.\n", dxgi_device, debugstr_guid(iid), device);
+    return create_device((IUnknown *)dxgi_device, iid, device);
+}
+
+HRESULT WINAPI DCompositionCreateDevice2(IUnknown *rendering_device, REFIID iid, void **device)
+{
+    TRACE("%p, %s, %p.\n", rendering_device, debugstr_guid(iid), device);
+    return create_device(rendering_device, iid, device);
+}
+
+HRESULT WINAPI DCompositionCreateDevice3(IUnknown *rendering_device, REFIID iid, void **device)
+{
+    TRACE("%p, %s, %p.\n", rendering_device, debugstr_guid(iid), device);
+    return create_device(rendering_device, iid, device);
+}
