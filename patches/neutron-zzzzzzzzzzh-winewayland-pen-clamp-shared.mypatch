+        /* NEUTRON: was an UNCONDITIONAL copy of the pointer's clamp -- pinning pen motion to the
+         * focused window's edge however far outside it really was. The pen has the same implicit
+         * grab as the mouse: while the tip is down, focus stays on the surface that received the
+         * contact, so any pen drag that leaves its source surface (out of a popup, off a panel)
+         * was reported as never having left it and the drop target never saw the pen. Identical
+         * mechanism to the Button Editor drag fixed for the mouse in 11.10-50; the pen was left
+         * on the old behaviour deliberately so that test stayed clean, and then not revisited.
+         * Shared helper now -- see wayland_clamp_rounding_overshoot() in wayland_pointer.c. */
+        wayland_clamp_rounding_overshoot(&screen, window_rect);
         wayland_win_data_release(window_data);
         /* NEUTRON: record; the mouse MOVE is injected in wayland_wintab_frame after
          * the packet, so per-sample mouse+packet stay paired and ordered. */
