+
+#pragma makedep register
+
+import "imapi2_private.idl";
+
+[
+    helpstring("Microsoft IMAPI v2 Disc Master"),
+    threading(both),
+    progid("IMAPI2.MsftDiscMaster2"),
+    uuid(2735412e-7f64-5b0f-8f00-5d77afbe261e)
+]
+coclass MsftDiscMaster2 { interface IDiscMaster2; }
--- a/dlls/imapi2/imapi2_private.idl
+++ b/dlls/imapi2/imapi2_private.idl
@@ -0,0 +1,43 @@
+/*
+ * Image Mastering API v2 (IMAPI2) interfaces implemented by imapi2.dll
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#pragma makedep header
+
+import "oaidl.idl";
+
+[
+    object,
+    uuid(27354130-7f64-5b0f-8f00-5d77afbe261e),
+    dual,
+    nonextensible,
+    pointer_default(unique)
+]
+interface IDiscMaster2 : IDispatch
+{
+    [propget, id(DISPID_NEWENUM), restricted, hidden]
+    HRESULT _NewEnum([out, retval] IEnumVARIANT **ppunk);
+
+    [propget, id(DISPID_VALUE)]
+    HRESULT Item([in] LONG index, [out, retval] BSTR *value);
+
+    [propget, id(1)]
+    HRESULT Count([out, retval] LONG *value);
+
+    [propget, id(2)]
+    HRESULT IsSupportedEnvironment([out, retval] VARIANT_BOOL *value);
+}
