--- a/dlls/d2d1/geometry.c
+++ b/dlls/d2d1/geometry.c
@@ -1384,8 +1384,18 @@
     m._32 = 0.5f * (arc->point.y + start_point->y);
     if (!zero_center)
     {
-        m._31 += (m._11 * center.x + m._12 * center.y);
-        m._32 += (m._21 * center.x + m._22 * center.y);
+        /* Offset by the arc centre, which lives in the pre-transform (unit
+         * circle) space. d2d_point_transform pairs (_11,_21) for x and
+         * (_12,_22) for y, so the centre must be mapped with that pairing --
+         * the code used the TRANSPOSE. At rotationAngle 0 or 180 the
+         * off-diagonal terms are zero and the two agree, which is why this went
+         * unnoticed; at any other angle the centre lands mirrored and the arc
+         * bulges the wrong way, turning each rounded corner into an outward
+         * lobe. Premiere passes rotationAngle=90 on every arc (a no-op for the
+         * circular arcs it uses), so every rounded rectangle came out
+         * bone-shaped. */
+        m._31 += (m._11 * center.x + m._21 * center.y);
+        m._32 += (m._12 * center.x + m._22 * center.y);
     }
 
     cPieces = d2d_arc_get_piece_count(&ptStart, &ptEnd, large_arc, sweep_up, &rCosArcAngle, &rSinArcAngle);
