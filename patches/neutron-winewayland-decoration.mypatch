+/* Whether a window should get server-side decorations: a captioned window that
+ * isn't a layered (transparent/splash) window.
+ *
+ * NEUTRON divergence from upstream EM: upstream also excludes WS_EX_TOOLWINDOW.
+ * Adobe's Premiere home/Welcome window is a WS_EX_TOOLWINDOW that nonetheless
+ * carries a full WS_CAPTION|WS_SYSMENU|WS_THICKFRAME and is a primary, user-
+ * facing toplevel. Excluding it leaves it with Wine's built-in (Win95) frame
+ * while every other window gets the themed compositor frame. Since the user
+ * opted into themed decorations for all managed windows, allow tool windows
+ * that present a real caption (i.e. have WS_SYSMENU, distinguishing them from
+ * thin-frame tooltip/palette helpers) to get server-side decorations too. */
+static inline BOOL is_decoration_enabled(DWORD style, DWORD ex_style)
+{
+    if (ex_style & WS_EX_LAYERED) return FALSE;
+
+    if ((ex_style & WS_EX_TOOLWINDOW) && !(style & WS_SYSMENU)) return FALSE;
+
+    if ((style & WS_CAPTION) == WS_CAPTION)
+        return TRUE;
+
+    return FALSE;
+}
+
 RGNDATA *get_region_data(HRGN region);
 
 /**********************************************************************
@@ -488,6 +518,8 @@ void WAYLAND_WindowPosChanged(HWND hwnd, HWND insert_after, HWND owner_hint, UIN
                               const struct window_rects *new_rects, struct window_surface *surface);
 BOOL WAYLAND_WindowPosChanging(HWND hwnd, UINT swp_flags, BOOL shaped, const struct window_rects *rects);
 BOOL WAYLAND_CreateWindowSurface(HWND hwnd, BOOL layered, const RECT *surface_rect, struct window_surface **surface);
+BOOL WAYLAND_GetWindowStyleMasks(HWND hwnd, UINT style, UINT ex_style, UINT *style_mask, UINT *ex_style_mask);
+BOOL WAYLAND_HasWindowManager(const char *name);
 UINT WAYLAND_VulkanInit(UINT version, void *vulkan_handle, const struct vulkan_driver_funcs **driver_funcs);
 UINT WAYLAND_OpenGLInit(UINT version, const struct opengl_funcs *opengl_funcs, const struct opengl_driver_funcs **driver_funcs);
 
diff --git a/dlls/winewayland.drv/wayland.c b/dlls/winewayland.drv/wayland.c
index eb7bd805425..43c4d1345b4 100644
--- a/dlls/winewayland.drv/wayland.c
+++ b/dlls/winewayland.drv/wayland.c
@@ -86,6 +86,25 @@ static const struct wl_seat_listener seat_listener =
     wl_seat_handle_name
 };
 
+/* Server-side (compositor-drawn) decorations are OPT-IN. Neutron defaults to
+ * client-side decorations — Wine draws its own non-client frame — which is
+ * self-contained in the prefix, never overflows the monitor, and doesn't inherit
+ * the compositor's global window-decoration theme. Set WAYLANDDRV_SSD=1 to opt
+ * into compositor-drawn (xdg-decoration) frames instead. */
+static int wayland_disable_ssd(void)
+{
+    static int disabled = -1;
+    const char *env;
+
+    if (disabled == -1)
+    {
+        env = getenv("WAYLANDDRV_SSD");
+        disabled = !(env && !strcmp(env, "1"));
+    }
+
+    return disabled;
+}
+
 /**********************************************************************
  *          Registry handling
  */
@@ -168,6 +187,23 @@ static void registry_handle_global(void *data, struct wl_registry *registry,
         process_wayland.wp_fractional_scale_manager_v1 =
             wl_registry_bind(registry, id, &wp_fractional_scale_manager_v1_interface, 1);
     }
+    else if (strcmp(interface, "zxdg_decoration_manager_v1") == 0)
+    {
+        /* Server-side decorations: let the compositor draw the title bar with
+         * the desktop theme. Gated to compositors known to honor it well (KDE),
+         * unless the protocol is new enough (v2) to be trusted broadly. */
+        if (wayland_disable_ssd()) return;
+        if (version >= 2)
+        {
+            process_wayland.zxdg_decoration_manager_v1 =
+                wl_registry_bind(registry, id, &zxdg_decoration_manager_v1_interface, 2);
+        }
+        else if (WAYLAND_HasWindowManager("KDE"))
+        {
+            process_wayland.zxdg_decoration_manager_v1 =
+                wl_registry_bind(registry, id, &zxdg_decoration_manager_v1_interface, 1);
+        }
+    }
     else if (strcmp(interface, "wl_subcompositor") == 0)
     {
         process_wayland.wl_subcompositor =
@@ -328,6 +364,9 @@ BOOL wayland_process_init(void)
     }
 
     /* Check for optional globals. */
+    if (!process_wayland.zxdg_decoration_manager_v1)
+        WARN("Wayland compositor doesn't support optional zxdg_decoration_manager_v1 (server-side decorations won't work)\n");
+
     if (!process_wayland.zwp_pointer_constraints_v1)
         ERR("Wayland compositor doesn't support optional zwp_pointer_constraints_v1 (pointer locking/confining won't work)\n");
 
