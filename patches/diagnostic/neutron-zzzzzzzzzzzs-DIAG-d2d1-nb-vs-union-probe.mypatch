+            neutron_dr_get_union_parts(render_target->dxgi_target, &nb, &nbv, &nc, &ncv);
+            if (nbv)
+            {
+                nb.left -= 2; nb.top -= 2; nb.right += 2; nb.bottom += 2;   /* same AA fringe as u */
+                if (nb.left < 0) nb.left = 0;
+                if (nb.top < 0) nb.top = 0;
+                if (nb.right > fw) nb.right = fw;
+                if (nb.bottom > fh) nb.bottom = fh;
+                if (nb.right > nb.left && nb.bottom > nb.top)
+                {
+                    render_target->nb_px += (unsigned long long)(nb.right - nb.left) * (nb.bottom - nb.top);
+                    render_target->nb_frames++;
+                }
+            }
+            if (ncv)
+            {
+                if (nc.left < 0) nc.left = 0;
+                if (nc.top < 0) nc.top = 0;
+                if (nc.right > fw) nc.right = fw;
+                if (nc.bottom > fh) nc.bottom = fh;
+                render_target->nc_frames++;
