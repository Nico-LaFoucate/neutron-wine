+static HRESULT WINAPI input_ReadAsync( IInputStream *iface, IBuffer *buffer, UINT32 count,
+        InputStreamOptions options, IAsyncOperationWithProgress_IBuffer_UINT32 **operation )
+{
+    struct memory_stream *impl = impl_from_IInputStream( iface );
+    IBufferByteAccess *byte_access;
+    UINT32 capacity, to_read;
+    UINT64 available;
+    BYTE *dst;
+    HRESULT hr;
+
+    TRACE( "iface %p, buffer %p, count %u, options %#x, operation %p.\n", iface, buffer, count, options, operation );
+
+    *operation = NULL;
+    if (!buffer) return E_POINTER;
+    if (FAILED(hr = IBuffer_QueryInterface( buffer, &IID_IBufferByteAccess, (void **)&byte_access ))) return hr;
+    hr = IBufferByteAccess_Buffer( byte_access, &dst );
+    IBufferByteAccess_Release( byte_access );
+    if (FAILED(hr)) return hr;
+
+    if (FAILED(hr = IBuffer_get_Capacity( buffer, &capacity ))) return hr;
+    if (count > capacity) count = capacity;
+
+    available = impl->position < impl->data->size ? impl->data->size - impl->position : 0;
+    to_read = available < count ? (UINT32)available : count;
+    if (to_read) memcpy( dst, impl->data->bytes + impl->position, to_read );
+    impl->position += to_read;
+
+    if (FAILED(hr = IBuffer_put_Length( buffer, to_read ))) return hr;
+
+    return async_read_create( buffer, operation );
+}
+static const struct IInputStreamVtbl memory_stream_input_vtbl =
