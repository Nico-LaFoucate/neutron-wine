+/* ===================================================================
+ * The memory stream object itself. One shared byte buffer, per-object
+ * cursor. Exposes the full IRandomAccessStream contract plus the
+ * IRandomAccessStreamWithContentType facet that OpenReadAsync yields.
+ * =================================================================== */
+struct memory_stream
+{
+    IRandomAccessStreamWithContentType IRandomAccessStreamWithContentType_iface;
+    IRandomAccessStream IRandomAccessStream_iface;
+    IInputStream IInputStream_iface;
+    IOutputStream IOutputStream_iface;
+    IClosable IClosable_iface;
+    IContentTypeProvider IContentTypeProvider_iface;
+    LONG ref;
+
+    struct stream_data *data;
+    UINT64 position;
+    boolean can_write;
+};
+
+static const struct IRandomAccessStreamVtbl memory_stream_random_access_vtbl;
+
+static struct memory_stream *memory_stream_alloc( struct stream_data *data, UINT64 position, boolean can_write );
+
+static inline struct memory_stream *impl_from_IRandomAccessStream( IRandomAccessStream *iface )
+{
+    return CONTAINING_RECORD( iface, struct memory_stream, IRandomAccessStream_iface );
+}
+
+/* central QueryInterface shared by all facets */
+static HRESULT memory_stream_query_interface( struct memory_stream *impl, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IRandomAccessStream ))
+    {
+        IInspectable_AddRef( (*out = &impl->IRandomAccessStream_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IRandomAccessStreamWithContentType ))
+    {
+        IInspectable_AddRef( (*out = &impl->IRandomAccessStreamWithContentType_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IInputStream ))
+    {
+        IInspectable_AddRef( (*out = &impl->IInputStream_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IOutputStream ))
+    {
+        IInspectable_AddRef( (*out = &impl->IOutputStream_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IClosable ))
+    {
+        IInspectable_AddRef( (*out = &impl->IClosable_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IContentTypeProvider ))
+    {
+        IInspectable_AddRef( (*out = &impl->IContentTypeProvider_iface) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG memory_stream_addref( struct memory_stream *impl )
+{
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG memory_stream_release( struct memory_stream *impl )
+{
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        stream_data_release( impl->data );
+        free( impl );
+    }
+    return ref;
+}
