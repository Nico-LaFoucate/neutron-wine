+/* ===================================================================
+ * Entry points consumed by streams.c / main.c.
+ * =================================================================== */
+
+/* RandomAccessStreamReference.CreateFromStream */
+HRESULT memory_stream_reference_create( IRandomAccessStream *stream, IRandomAccessStreamReference **out )
+{
+    struct stream_reference *impl;
+    struct stream_data *data;
+
+    *out = NULL;
+    if (!stream) return E_POINTER;
+
+    if (!(data = memory_stream_data_from( stream )))
+    {
+        FIXME( "CreateFromStream over a foreign IRandomAccessStream %p is not supported yet.\n", stream );
+        return E_NOTIMPL;
+    }
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IRandomAccessStreamReference_iface.lpVtbl = &stream_reference_vtbl;
+    impl->ref = 1;
+    impl->data = stream_data_addref( data );
+
+    *out = &impl->IRandomAccessStreamReference_iface;
+    return S_OK;
+}
