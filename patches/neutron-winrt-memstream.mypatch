+static HRESULT WINAPI data_writer_WriteDateTime( IDataWriter *iface, DateTime value )
+{
+    return data_writer_append_value( impl_from_IDataWriter( iface ), &value.UniversalTime, sizeof(value.UniversalTime) );
+}
+static HRESULT WINAPI data_writer_WriteTimeSpan( IDataWriter *iface, TimeSpan value )
+{
+    return data_writer_append_value( impl_from_IDataWriter( iface ), &value.Duration, sizeof(value.Duration) );
+}
+static HRESULT WINAPI data_writer_WriteString( IDataWriter *iface, HSTRING value, UINT32 *code_unit_count )
+{
+    struct data_writer_instance *impl = impl_from_IDataWriter( iface );
+    const WCHAR *str;
+    UINT32 str_len, utf8_len;
+    char *utf8;
+    HRESULT hr;
+
+    str = WindowsGetStringRawBuffer( value, &str_len );
+    utf8_len = WideCharToMultiByte( CP_UTF8, 0, str, str_len, NULL, 0, NULL, NULL );
+    if (!(utf8 = malloc( utf8_len ? utf8_len : 1 ))) return E_OUTOFMEMORY;
+    WideCharToMultiByte( CP_UTF8, 0, str, str_len, utf8, utf8_len, NULL, NULL );
+    hr = data_writer_append( impl, (BYTE *)utf8, utf8_len );
+    free( utf8 );
+    if (SUCCEEDED(hr) && code_unit_count) *code_unit_count = utf8_len;
+    return hr;
+}
+static HRESULT WINAPI data_writer_MeasureString( IDataWriter *iface, HSTRING value, UINT32 *code_unit_count )
+{
+    const WCHAR *str;
+    UINT32 str_len;
+    str = WindowsGetStringRawBuffer( value, &str_len );
+    *code_unit_count = WideCharToMultiByte( CP_UTF8, 0, str, str_len, NULL, 0, NULL, NULL );
+    return S_OK;
+}
+static HRESULT WINAPI data_writer_StoreAsync( IDataWriter *iface, IAsyncOperation_UINT32 **operation )
+{
+    struct data_writer_instance *impl = impl_from_IDataWriter( iface );
+    IActivationFactory *buffer_factory = buffer_activation_factory;
+    IBufferFactory *ibuf_factory = NULL;
+    IBufferByteAccess *bba = NULL;
+    IBuffer *buffer = NULL;
+    IAsyncOperationWithProgress_UINT32_UINT32 *write_op = NULL;
+    UINT32 stored = impl->len, written = 0;
+    BYTE *dst;
+    HRESULT hr;
+
+    TRACE( "iface %p, operation %p (len %u).\n", iface, operation, impl->len );
+
+    *operation = NULL;
+    if (!impl->stream) return E_UNEXPECTED;
+
+    if (!impl->len) return store_async_create( 0, operation );
+
+    if (FAILED(hr = IActivationFactory_QueryInterface( buffer_factory, &IID_IBufferFactory, (void **)&ibuf_factory )))
+        return hr;
+    if (FAILED(hr = IBufferFactory_Create( ibuf_factory, impl->len, &buffer ))) goto done;
+    if (FAILED(hr = IBuffer_QueryInterface( buffer, &IID_IBufferByteAccess, (void **)&bba ))) goto done;
+    if (FAILED(hr = IBufferByteAccess_Buffer( bba, &dst ))) goto done;
+    memcpy( dst, impl->buf, impl->len );
+    if (FAILED(hr = IBuffer_put_Length( buffer, impl->len ))) goto done;
+
+    if (FAILED(hr = IOutputStream_WriteAsync( impl->stream, buffer, &write_op ))) goto done;
+    IAsyncOperationWithProgress_UINT32_UINT32_GetResults( write_op, &written );
+
+    impl->len = 0; /* bytes have been committed to the stream */
+    hr = store_async_create( stored, operation );
+
+done:
+    if (write_op) IAsyncOperationWithProgress_UINT32_UINT32_Release( write_op );
+    if (bba) IBufferByteAccess_Release( bba );
+    if (buffer) IBuffer_Release( buffer );
+    if (ibuf_factory) IBufferFactory_Release( ibuf_factory );
+    return hr;
+}
+static HRESULT WINAPI data_writer_FlushAsync( IDataWriter *iface, IAsyncOperation_boolean **operation )
+{
+    struct data_writer_instance *impl = impl_from_IDataWriter( iface );
+    IAsyncOperation_boolean *flush = NULL;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, operation %p.\n", iface, operation );
+
+    *operation = NULL;
+    if (impl->stream) hr = IOutputStream_FlushAsync( impl->stream, &flush );
+    if (SUCCEEDED(hr)) *operation = flush;
+    return hr;
+}
+static HRESULT WINAPI data_writer_DetachBuffer( IDataWriter *iface, IBuffer **buffer )
+{
+    struct data_writer_instance *impl = impl_from_IDataWriter( iface );
+    IBufferFactory *ibuf_factory = NULL;
+    IBufferByteAccess *bba = NULL;
+    BYTE *dst;
+    HRESULT hr;
+
+    TRACE( "iface %p, buffer %p.\n", iface, buffer );
+
+    *buffer = NULL;
+    if (FAILED(hr = IActivationFactory_QueryInterface( buffer_activation_factory, &IID_IBufferFactory, (void **)&ibuf_factory )))
+        return hr;
+    if (FAILED(hr = IBufferFactory_Create( ibuf_factory, impl->len, buffer ))) goto done;
+    if (impl->len)
+    {
+        if (FAILED(hr = IBuffer_QueryInterface( *buffer, &IID_IBufferByteAccess, (void **)&bba ))) goto done;
+        if (SUCCEEDED(hr = IBufferByteAccess_Buffer( bba, &dst )))
+        {
+            memcpy( dst, impl->buf, impl->len );
+            hr = IBuffer_put_Length( *buffer, impl->len );
+        }
+    }
+    if (SUCCEEDED(hr)) impl->len = 0;
+
+done:
+    if (bba) IBufferByteAccess_Release( bba );
+    if (ibuf_factory) IBufferFactory_Release( ibuf_factory );
+    if (FAILED(hr) && *buffer) { IBuffer_Release( *buffer ); *buffer = NULL; }
+    return hr;
+}
+static HRESULT WINAPI data_writer_DetachStream( IDataWriter *iface, IOutputStream **output_stream )
+{
+    struct data_writer_instance *impl = impl_from_IDataWriter( iface );
+
+    TRACE( "iface %p, output_stream %p.\n", iface, output_stream );
+
+    if ((*output_stream = impl->stream))
+    {
+        IOutputStream_AddRef( impl->stream );
+        IOutputStream_Release( impl->stream );
+        impl->stream = NULL;
+    }
+    return S_OK;
+}
+static const struct IDataWriterVtbl data_writer_instance_vtbl =
+{
+    data_writer_QueryInterface,
+    data_writer_AddRef,
+    data_writer_Release,
+    data_writer_GetIids,
+    data_writer_GetRuntimeClassName,
+    data_writer_GetTrustLevel,
+    data_writer_get_UnstoredBufferLength,
+    data_writer_get_UnicodeEncoding,
+    data_writer_put_UnicodeEncoding,
+    data_writer_get_ByteOrder,
+    data_writer_put_ByteOrder,
+    data_writer_WriteByte,
+    data_writer_WriteBytes,
+    data_writer_WriteBuffer,
+    data_writer_WriteBufferRange,
+    data_writer_WriteBoolean,
+    data_writer_WriteGuid,
+    data_writer_WriteInt16,
+    data_writer_WriteInt32,
+    data_writer_WriteInt64,
+    data_writer_WriteUInt16,
+    data_writer_WriteUInt32,
+    data_writer_WriteUInt64,
+    data_writer_WriteSingle,
+    data_writer_WriteDouble,
+    data_writer_WriteDateTime,
+    data_writer_WriteTimeSpan,
+    data_writer_WriteString,
+    data_writer_MeasureString,
+    data_writer_StoreAsync,
+    data_writer_FlushAsync,
+    data_writer_DetachBuffer,
+    data_writer_DetachStream,
+};
