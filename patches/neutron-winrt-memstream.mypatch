+static struct memory_stream *memory_stream_alloc( struct stream_data *data, UINT64 position, boolean can_write )
+{
+    struct memory_stream *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+        return NULL;
+    impl->IRandomAccessStreamWithContentType_iface.lpVtbl = &memory_stream_with_content_type_vtbl;
+    impl->IRandomAccessStream_iface.lpVtbl = &memory_stream_random_access_vtbl;
+    impl->IInputStream_iface.lpVtbl = &memory_stream_input_vtbl;
+    impl->IOutputStream_iface.lpVtbl = &memory_stream_output_vtbl;
+    impl->IClosable_iface.lpVtbl = &memory_stream_closable_vtbl;
+    impl->IContentTypeProvider_iface.lpVtbl = &memory_stream_content_type_vtbl;
+    impl->ref = 1;
+    impl->data = data;
+    impl->position = position;
+    impl->can_write = can_write;
+    return impl;
+}
+
+/* If iface is one of ours, return its shared data (not addref'd), else NULL. */
+static struct stream_data *memory_stream_data_from( IRandomAccessStream *iface )
+{
+    if (!iface || iface->lpVtbl != &memory_stream_random_access_vtbl) return NULL;
+    return impl_from_IRandomAccessStream( iface )->data;
+}
