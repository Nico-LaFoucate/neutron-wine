+/* ===================================================================
+ * The DataWriter object: buffers writes, flushes to a bound
+ * IOutputStream on StoreAsync.
+ * =================================================================== */
+struct data_writer_instance
+{
+    IDataWriter IDataWriter_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+
+    IOutputStream *stream;
+    BYTE *buf;
+    UINT32 len;
+    UINT32 cap;
+    ByteOrder byte_order;
+    UnicodeEncoding encoding;
+};
+
+static inline struct data_writer_instance *impl_from_IDataWriter( IDataWriter *iface )
+{
+    return CONTAINING_RECORD( iface, struct data_writer_instance, IDataWriter_iface );
+}
+static inline struct data_writer_instance *impl_from_IClosable( IClosable *iface )
+{
+    return CONTAINING_RECORD( iface, struct data_writer_instance, IClosable_iface );
+}
+
+static HRESULT data_writer_append( struct data_writer_instance *impl, const BYTE *bytes, UINT32 count )
+{
+    if (impl->len + count > impl->cap)
+    {
+        UINT32 cap = impl->cap ? impl->cap : 256;
+        BYTE *p;
+        while (cap < impl->len + count) cap *= 2;
+        if (!(p = realloc( impl->buf, cap ))) return E_OUTOFMEMORY;
+        impl->buf = p;
+        impl->cap = cap;
+    }
+    memcpy( impl->buf + impl->len, bytes, count );
+    impl->len += count;
+    return S_OK;
+}
+
+/* append a fixed-width value honouring the configured byte order (default BE) */
+static HRESULT data_writer_append_value( struct data_writer_instance *impl, const void *value, UINT32 size )
+{
+    const BYTE *src = value;
+    BYTE tmp[8];
+    UINT32 i;
+
+    if (impl->byte_order == ByteOrder_BigEndian)
+    {
+        for (i = 0; i < size; i++) tmp[i] = src[size - 1 - i];
+        return data_writer_append( impl, tmp, size );
+    }
+    return data_writer_append( impl, src, size );
+}
+
+static HRESULT WINAPI data_writer_QueryInterface( IDataWriter *iface, REFIID iid, void **out )
+{
+    struct data_writer_instance *impl = impl_from_IDataWriter( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IDataWriter ))
+    {
+        IInspectable_AddRef( (*out = &impl->IDataWriter_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IClosable ))
+    {
+        IInspectable_AddRef( (*out = &impl->IClosable_iface) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI data_writer_AddRef( IDataWriter *iface )
+{
+    return InterlockedIncrement( &impl_from_IDataWriter( iface )->ref );
+}
+static ULONG WINAPI data_writer_Release( IDataWriter *iface )
+{
+    struct data_writer_instance *impl = impl_from_IDataWriter( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        if (impl->stream) IOutputStream_Release( impl->stream );
+        free( impl->buf );
+        free( impl );
+    }
+    return ref;
+}
+static HRESULT WINAPI data_writer_GetIids( IDataWriter *iface, ULONG *count, IID **iids )
+{
+    FIXME( "iface %p stub!\n", iface );
+    return E_NOTIMPL;
+}
+static HRESULT WINAPI data_writer_GetRuntimeClassName( IDataWriter *iface, HSTRING *name )
+{
+    return WindowsCreateString( L"Windows.Storage.Streams.DataWriter",
+                                ARRAY_SIZE(L"Windows.Storage.Streams.DataWriter") - 1, name );
+}
+static HRESULT WINAPI data_writer_GetTrustLevel( IDataWriter *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+static HRESULT WINAPI data_writer_get_UnstoredBufferLength( IDataWriter *iface, UINT32 *value )
+{
+    *value = impl_from_IDataWriter( iface )->len;
+    return S_OK;
+}
+static HRESULT WINAPI data_writer_get_UnicodeEncoding( IDataWriter *iface, UnicodeEncoding *value )
+{
+    *value = impl_from_IDataWriter( iface )->encoding;
+    return S_OK;
+}
+static HRESULT WINAPI data_writer_put_UnicodeEncoding( IDataWriter *iface, UnicodeEncoding value )
+{
+    impl_from_IDataWriter( iface )->encoding = value;
+    return S_OK;
+}
+static HRESULT WINAPI data_writer_get_ByteOrder( IDataWriter *iface, ByteOrder *value )
+{
+    *value = impl_from_IDataWriter( iface )->byte_order;
+    return S_OK;
+}
+static HRESULT WINAPI data_writer_put_ByteOrder( IDataWriter *iface, ByteOrder value )
+{
+    impl_from_IDataWriter( iface )->byte_order = value;
+    return S_OK;
+}
+static HRESULT WINAPI data_writer_WriteByte( IDataWriter *iface, BYTE value )
+{
+    return data_writer_append( impl_from_IDataWriter( iface ), &value, 1 );
+}
+static HRESULT WINAPI data_writer_WriteBytes( IDataWriter *iface, UINT32 value_size, BYTE *value )
+{
+    struct data_writer_instance *impl = impl_from_IDataWriter( iface );
+    TRACE( "iface %p, value_size %u, value %p.\n", iface, value_size, value );
+    return data_writer_append( impl, value, value_size );
+}
+static HRESULT WINAPI data_writer_WriteBuffer( IDataWriter *iface, IBuffer *buffer )
+{
+    struct data_writer_instance *impl = impl_from_IDataWriter( iface );
+    IBufferByteAccess *bba;
+    UINT32 length;
+    BYTE *bytes;
+    HRESULT hr;
+
+    if (!buffer) return E_POINTER;
+    if (FAILED(hr = IBuffer_get_Length( buffer, &length ))) return hr;
+    if (FAILED(hr = IBuffer_QueryInterface( buffer, &IID_IBufferByteAccess, (void **)&bba ))) return hr;
+    hr = IBufferByteAccess_Buffer( bba, &bytes );
+    IBufferByteAccess_Release( bba );
+    if (FAILED(hr)) return hr;
+    return data_writer_append( impl, bytes, length );
+}
+static HRESULT WINAPI data_writer_WriteBufferRange( IDataWriter *iface, IBuffer *buffer, UINT32 start, UINT32 count )
+{
+    struct data_writer_instance *impl = impl_from_IDataWriter( iface );
+    IBufferByteAccess *bba;
+    UINT32 length;
+    BYTE *bytes;
+    HRESULT hr;
+
+    if (!buffer) return E_POINTER;
+    if (FAILED(hr = IBuffer_get_Length( buffer, &length ))) return hr;
+    if (start > length || count > length - start) return E_INVALIDARG;
+    if (FAILED(hr = IBuffer_QueryInterface( buffer, &IID_IBufferByteAccess, (void **)&bba ))) return hr;
+    hr = IBufferByteAccess_Buffer( bba, &bytes );
+    IBufferByteAccess_Release( bba );
+    if (FAILED(hr)) return hr;
+    return data_writer_append( impl, bytes + start, count );
+}
+static HRESULT WINAPI data_writer_WriteBoolean( IDataWriter *iface, boolean value )
+{
+    BYTE b = value ? 1 : 0;
+    return data_writer_append( impl_from_IDataWriter( iface ), &b, 1 );
+}
+static HRESULT WINAPI data_writer_WriteGuid( IDataWriter *iface, GUID value )
+{
+    FIXME( "iface %p stub!\n", iface );
+    return E_NOTIMPL;
+}
+static HRESULT WINAPI data_writer_WriteInt16( IDataWriter *iface, INT16 value )
+{
+    return data_writer_append_value( impl_from_IDataWriter( iface ), &value, sizeof(value) );
+}
+static HRESULT WINAPI data_writer_WriteInt32( IDataWriter *iface, INT32 value )
+{
+    return data_writer_append_value( impl_from_IDataWriter( iface ), &value, sizeof(value) );
+}
