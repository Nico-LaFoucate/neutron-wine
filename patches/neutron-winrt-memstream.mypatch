+static ULONG WINAPI async_stream_Release( IAsyncOperation_IRandomAccessStreamWithContentType *iface )
+{
+    struct async_stream *impl = impl_from_async_stream( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        if (impl->handler) IAsyncOperationCompletedHandler_IRandomAccessStreamWithContentType_Release( impl->handler );
+        if (impl->result) IRandomAccessStreamWithContentType_Release( impl->result );
+        free( impl );
