+/* ===================================================================
+ * Shared, refcounted byte storage backing a family of memory streams.
+ * A stream reference and every clone/view share the same bytes; each
+ * stream object keeps its own cursor position.
+ * =================================================================== */
+struct stream_data
+{
+    LONG ref;
+    BYTE *bytes;
+    UINT64 size;
+    UINT64 capacity;
+};
+
+static struct stream_data *stream_data_create( void )
+{
+    struct stream_data *data;
+    if (!(data = calloc( 1, sizeof(*data) ))) return NULL;
+    data->ref = 1;
+    return data;
+}
+
+static struct stream_data *stream_data_addref( struct stream_data *data )
+{
+    InterlockedIncrement( &data->ref );
+    return data;
+}
+
+static void stream_data_release( struct stream_data *data )
+{
+    if (!InterlockedDecrement( &data->ref ))
+    {
+        free( data->bytes );
+        free( data );
+    }
+}
+
+static HRESULT stream_data_reserve( struct stream_data *data, UINT64 needed )
+{
+    UINT64 capacity = data->capacity ? data->capacity : 256;
+    BYTE *bytes;
+
+    if (needed <= data->capacity) return S_OK;
+    while (capacity < needed) capacity *= 2;
+    if (!(bytes = realloc( data->bytes, capacity ))) return E_OUTOFMEMORY;
+    data->bytes = bytes;
+    data->capacity = capacity;
+    return S_OK;
+}
+
+/* Shared IAsyncInfo tail for our born-completed async operations. All of
+ * ours complete synchronously with S_OK, so the info surface is constant. */
+#define DEFINE_COMPLETED_ASYNC_INFO( pfx, container, info_member, main_member )                     \
+    static inline struct container *info_impl_from_##pfx( IAsyncInfo *iface )                       \
+    {                                                                                              \
+        return CONTAINING_RECORD( iface, struct container, info_member );                           \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_info_QueryInterface( IAsyncInfo *iface, REFIID iid, void **out )    \
+    {                                                                                              \
+        struct container *impl = info_impl_from_##pfx( iface );                                     \
+        return IInspectable_QueryInterface( (IInspectable *)&impl->main_member, iid, out );         \
+    }                                                                                              \
+    static ULONG WINAPI pfx##_info_AddRef( IAsyncInfo *iface )                                      \
+    {                                                                                              \
+        struct container *impl = info_impl_from_##pfx( iface );                                     \
+        return IInspectable_AddRef( (IInspectable *)&impl->main_member );                           \
+    }                                                                                              \
+    static ULONG WINAPI pfx##_info_Release( IAsyncInfo *iface )                                     \
+    {                                                                                              \
+        struct container *impl = info_impl_from_##pfx( iface );                                     \
+        return IInspectable_Release( (IInspectable *)&impl->main_member );                          \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_info_GetIids( IAsyncInfo *iface, ULONG *count, IID **iids )         \
+    {                                                                                              \
+        FIXME( "iface %p stub!\n", iface );                                                         \
+        return E_NOTIMPL;                                                                           \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_info_GetRuntimeClassName( IAsyncInfo *iface, HSTRING *name )        \
+    {                                                                                              \
+        FIXME( "iface %p stub!\n", iface );                                                         \
+        return E_NOTIMPL;                                                                           \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_info_GetTrustLevel( IAsyncInfo *iface, TrustLevel *level )          \
+    {                                                                                              \
+        *level = BaseTrust;                                                                         \
+        return S_OK;                                                                                \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_info_get_Id( IAsyncInfo *iface, UINT32 *id )                        \
+    {                                                                                              \
+        *id = 1;                                                                                    \
+        return S_OK;                                                                                \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_info_get_Status( IAsyncInfo *iface, AsyncStatus *status )           \
+    {                                                                                              \
+        *status = Completed;                                                                        \
+        return S_OK;                                                                                \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_info_get_ErrorCode( IAsyncInfo *iface, HRESULT *error )             \
+    {                                                                                              \
+        *error = S_OK;                                                                              \
+        return S_OK;                                                                                \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_info_Cancel( IAsyncInfo *iface ) { return S_OK; }                   \
+    static HRESULT WINAPI pfx##_info_Close( IAsyncInfo *iface ) { return S_OK; }                    \
+    static const struct IAsyncInfoVtbl pfx##_info_vtbl =                                            \
+    {                                                                                              \
+        pfx##_info_QueryInterface, pfx##_info_AddRef, pfx##_info_Release,                           \
+        pfx##_info_GetIids, pfx##_info_GetRuntimeClassName, pfx##_info_GetTrustLevel,               \
+        pfx##_info_get_Id, pfx##_info_get_Status, pfx##_info_get_ErrorCode,                         \
+        pfx##_info_Cancel, pfx##_info_Close,                                                        \
+    };
+
+/* ===================================================================
+ * IAsyncOperationWithProgress<IBuffer*, UINT32> — result of ReadAsync.
+ * =================================================================== */
+struct async_read
+{
+    IAsyncOperationWithProgress_IBuffer_UINT32 IAsyncOperationWithProgress_IBuffer_UINT32_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    IBuffer *result;
+    IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32 *handler;
+};
+
+DEFINE_COMPLETED_ASYNC_INFO( async_read, async_read, IAsyncInfo_iface,
+                             IAsyncOperationWithProgress_IBuffer_UINT32_iface )
+
+static inline struct async_read *impl_from_async_read( IAsyncOperationWithProgress_IBuffer_UINT32 *iface )
+{
+    return CONTAINING_RECORD( iface, struct async_read, IAsyncOperationWithProgress_IBuffer_UINT32_iface );
+}
+
+static HRESULT WINAPI async_read_QueryInterface( IAsyncOperationWithProgress_IBuffer_UINT32 *iface, REFIID iid, void **out )
+{
+    struct async_read *impl = impl_from_async_read( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IAsyncOperationWithProgress_IBuffer_UINT32 ))
+    {
+        IInspectable_AddRef( (*out = &impl->IAsyncOperationWithProgress_IBuffer_UINT32_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+    {
+        IInspectable_AddRef( (*out = &impl->IAsyncInfo_iface) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI async_read_AddRef( IAsyncOperationWithProgress_IBuffer_UINT32 *iface )
+{
+    struct async_read *impl = impl_from_async_read( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI async_read_Release( IAsyncOperationWithProgress_IBuffer_UINT32 *iface )
+{
+    struct async_read *impl = impl_from_async_read( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        if (impl->handler) IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32_Release( impl->handler );
+        if (impl->result) IBuffer_Release( impl->result );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI async_read_GetIids( IAsyncOperationWithProgress_IBuffer_UINT32 *iface, ULONG *count, IID **iids )
+{
+    FIXME( "iface %p stub!\n", iface );
+    return E_NOTIMPL;
+}
+static HRESULT WINAPI async_read_GetRuntimeClassName( IAsyncOperationWithProgress_IBuffer_UINT32 *iface, HSTRING *name )
+{
+    FIXME( "iface %p stub!\n", iface );
+    return E_NOTIMPL;
+}
+static HRESULT WINAPI async_read_GetTrustLevel( IAsyncOperationWithProgress_IBuffer_UINT32 *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+static HRESULT WINAPI async_read_put_Progress( IAsyncOperationWithProgress_IBuffer_UINT32 *iface,
+        IAsyncOperationProgressHandler_IBuffer_UINT32 *handler )
+{
+    return S_OK;
+}
+static HRESULT WINAPI async_read_get_Progress( IAsyncOperationWithProgress_IBuffer_UINT32 *iface,
+        IAsyncOperationProgressHandler_IBuffer_UINT32 **handler )
+{
+    *handler = NULL;
+    return S_OK;
+}
+static HRESULT WINAPI async_read_put_Completed( IAsyncOperationWithProgress_IBuffer_UINT32 *iface,
+        IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32 *handler )
+{
+    struct async_read *impl = impl_from_async_read( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if (impl->handler) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    if ((impl->handler = handler))
+    {
+        IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32_AddRef( handler );
+        IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32_Invoke( handler, iface, Completed );
+    }
+    return S_OK;
+}
+static HRESULT WINAPI async_read_get_Completed( IAsyncOperationWithProgress_IBuffer_UINT32 *iface,
+        IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32 **handler )
+{
+    struct async_read *impl = impl_from_async_read( iface );
+    if ((*handler = impl->handler)) IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32_AddRef( *handler );
+    return S_OK;
+}
+static HRESULT WINAPI async_read_GetResults( IAsyncOperationWithProgress_IBuffer_UINT32 *iface, IBuffer **results )
+{
+    struct async_read *impl = impl_from_async_read( iface );
+
+    TRACE( "iface %p, results %p.\n", iface, results );
+
+    if ((*results = impl->result)) IBuffer_AddRef( impl->result );
+    return S_OK;
+}
+
+static const struct IAsyncOperationWithProgress_IBuffer_UINT32Vtbl async_read_vtbl =
+{
+    async_read_QueryInterface,
+    async_read_AddRef,
+    async_read_Release,
+    async_read_GetIids,
+    async_read_GetRuntimeClassName,
+    async_read_GetTrustLevel,
+    async_read_put_Progress,
+    async_read_get_Progress,
+    async_read_put_Completed,
+    async_read_get_Completed,
+    async_read_GetResults,
+};
+
+static HRESULT async_read_create( IBuffer *result, IAsyncOperationWithProgress_IBuffer_UINT32 **out )
+{
+    struct async_read *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IAsyncOperationWithProgress_IBuffer_UINT32_iface.lpVtbl = &async_read_vtbl;
+    impl->IAsyncInfo_iface.lpVtbl = &async_read_info_vtbl;
+    impl->ref = 1;
+    if ((impl->result = result)) IBuffer_AddRef( result );
+
+    *out = &impl->IAsyncOperationWithProgress_IBuffer_UINT32_iface;
+    return S_OK;
+}
