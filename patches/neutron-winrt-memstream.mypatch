+/* ===================================================================
+ * IAsyncOperation<IRandomAccessStreamWithContentType*> — OpenReadAsync.
+ * (Defined after the stream so it can hold the concrete result type.)
+ * =================================================================== */
+struct async_stream
+{
+    IAsyncOperation_IRandomAccessStreamWithContentType IAsyncOperation_IRandomAccessStreamWithContentType_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    IRandomAccessStreamWithContentType *result;
+    IAsyncOperationCompletedHandler_IRandomAccessStreamWithContentType *handler;
+};
