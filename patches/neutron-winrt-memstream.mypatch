+static HRESULT WINAPI output_WriteAsync( IOutputStream *iface, IBuffer *buffer,
+        IAsyncOperationWithProgress_UINT32_UINT32 **operation )
+{
+    struct memory_stream *impl = impl_from_IOutputStream( iface );
+    IBufferByteAccess *byte_access;
+    UINT32 length;
+    BYTE *src;
+    HRESULT hr;
+
+    TRACE( "iface %p, buffer %p, operation %p.\n", iface, buffer, operation );
+
+    *operation = NULL;
+    if (!buffer) return E_POINTER;
+    if (FAILED(hr = IBuffer_get_Length( buffer, &length ))) return hr;
+    if (FAILED(hr = IBuffer_QueryInterface( buffer, &IID_IBufferByteAccess, (void **)&byte_access ))) return hr;
+    hr = IBufferByteAccess_Buffer( byte_access, &src );
+    IBufferByteAccess_Release( byte_access );
+    if (FAILED(hr)) return hr;
+
+    if (length)
+    {
+        if (FAILED(hr = stream_data_reserve( impl->data, impl->position + length ))) return hr;
+        memcpy( impl->data->bytes + impl->position, src, length );
+        impl->position += length;
+        if (impl->position > impl->data->size) impl->data->size = impl->position;
+    }
+
+    return async_write_create( length, operation );
+}
+static HRESULT WINAPI output_FlushAsync( IOutputStream *iface, IAsyncOperation_boolean **operation )
+{
+    TRACE( "iface %p, operation %p.\n", iface, operation );
+    return async_bool_create( TRUE, operation );
+}
