+/* ===================================================================
+ * RandomAccessStreamReference produced by CreateFromStream. Holds the
+ * shared bytes; OpenReadAsync hands back a fresh read view.
+ * =================================================================== */
+struct stream_reference
+{
+    IRandomAccessStreamReference IRandomAccessStreamReference_iface;
+    LONG ref;
+    struct stream_data *data;
+};
+
+static inline struct stream_reference *impl_from_IRandomAccessStreamReference( IRandomAccessStreamReference *iface )
+{
+    return CONTAINING_RECORD( iface, struct stream_reference, IRandomAccessStreamReference_iface );
+}
+
+static HRESULT WINAPI stream_reference_QueryInterface( IRandomAccessStreamReference *iface, REFIID iid, void **out )
+{
+    struct stream_reference *impl = impl_from_IRandomAccessStreamReference( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IRandomAccessStreamReference ))
+    {
+        IInspectable_AddRef( (*out = &impl->IRandomAccessStreamReference_iface) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+static ULONG WINAPI stream_reference_AddRef( IRandomAccessStreamReference *iface )
+{
+    struct stream_reference *impl = impl_from_IRandomAccessStreamReference( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+static ULONG WINAPI stream_reference_Release( IRandomAccessStreamReference *iface )
+{
+    struct stream_reference *impl = impl_from_IRandomAccessStreamReference( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        stream_data_release( impl->data );
+        free( impl );
+    }
+    return ref;
+}
+static HRESULT WINAPI stream_reference_GetIids( IRandomAccessStreamReference *iface, ULONG *count, IID **iids )
+{
+    FIXME( "iface %p stub!\n", iface );
+    return E_NOTIMPL;
+}
+static HRESULT WINAPI stream_reference_GetRuntimeClassName( IRandomAccessStreamReference *iface, HSTRING *name )
+{
+    return WindowsCreateString( L"Windows.Storage.Streams.RandomAccessStreamReference",
+                                ARRAY_SIZE(L"Windows.Storage.Streams.RandomAccessStreamReference") - 1, name );
+}
+static HRESULT WINAPI stream_reference_GetTrustLevel( IRandomAccessStreamReference *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+static HRESULT WINAPI stream_reference_OpenReadAsync( IRandomAccessStreamReference *iface,
+        IAsyncOperation_IRandomAccessStreamWithContentType **operation )
+{
+    struct stream_reference *impl = impl_from_IRandomAccessStreamReference( iface );
+    struct memory_stream *view;
+    HRESULT hr;
+
+    TRACE( "iface %p, operation %p.\n", iface, operation );
+
+    *operation = NULL;
+    if (!(view = memory_stream_alloc( stream_data_addref( impl->data ), 0, FALSE )))
+    {
+        stream_data_release( impl->data );
+        return E_OUTOFMEMORY;
+    }
+    hr = async_stream_create( &view->IRandomAccessStreamWithContentType_iface, operation );
+    IRandomAccessStreamWithContentType_Release( &view->IRandomAccessStreamWithContentType_iface );
+    return hr;
+}
+
+static const struct IRandomAccessStreamReferenceVtbl stream_reference_vtbl =
+{
+    stream_reference_QueryInterface,
