+static HRESULT WINAPI random_access_put_Size( IRandomAccessStream *iface, UINT64 value )
+{
+    struct memory_stream *impl = impl_from_IRandomAccessStream( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, value %I64u.\n", iface, value );
+
+    if (FAILED(hr = stream_data_reserve( impl->data, value ))) return hr;
+    if (value > impl->data->size)
+        memset( impl->data->bytes + impl->data->size, 0, value - impl->data->size );
+    impl->data->size = value;
+    return S_OK;
+}
