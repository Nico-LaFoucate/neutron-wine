  * swapchain so the blit thread can present it to its window via GDI. Used for
  * surfaces that bypass DirectComposition (e.g. Premiere's program monitor),
  * which otherwise present to an invisible Vulkan child-window surface. */
+/* The DXGI swapchain object behind a pointer, for comparison only (no reference kept). A visual's
+ * content is DXVK's DxgiSwapChainDispatcher; its Present reports the DxgiSwapChain inside it. The
+ * dispatcher answers IUnknown itself but forwards ID3DDestructionNotifier to the inner swapchain, so
+ * that interface names the same object from both pointers. */
+static void *swapchain_identity(IUnknown *swapchain)
+{
+    IUnknown *unk = NULL;
+
+    if (SUCCEEDED(IUnknown_QueryInterface(swapchain, &IID_ID3DDestructionNotifier, (void **)&unk))
+            || SUCCEEDED(IUnknown_QueryInterface(swapchain, &IID_IUnknown, (void **)&unk)))
+        IUnknown_Release(unk);
+    return unk;
+}
+
+/* A Present on a composition swapchain that a committed visual already registered against a window:
+ * mark that presentation for the blit worker and report TRUE. */
+static BOOL mark_present_for_swapchain(IUnknown *swapchain)
+{
+    struct presentation *p;
+    void *want;
+    BOOL found = FALSE;
+
+    if (!swapchain || !(want = swapchain_identity(swapchain)))
+        return FALSE;
+    InitOnceExecuteOnce(&presentations_once, presentations_init, NULL, NULL);
+    EnterCriticalSection(&presentations_cs);
+    LIST_FOR_EACH_ENTRY(p, &presentations, struct presentation, entry)
+    {
+        if (p->swapchain && swapchain_identity((IUnknown *)p->swapchain) == want)
+        {
+            InterlockedExchange(&p->pending_blit, TRUE);
+            found = TRUE;
+            break;
+        }
+    }
+    LeaveCriticalSection(&presentations_cs);
+    return found;
+}
+
 void dcomp_register_external(HWND hwnd, IUnknown *swapchain)
 {
     /* gluon-register-fallback: composition swapchains present with m_window == 0.
@@ -2132,6 +2335,11 @@
      * worker presents to the correct window (UXP composition panels / program monitor). */
     if (!hwnd)
     {
+        /* NEUTRON 2026-11-03: a composition swapchain already set as a visual's content and committed
+         * to a target belongs to THAT target's window: this Present is for it. The pending hwnd is the window
+         * DXVK last built a surface for -- for a dummy composition swapchain, DXVK's own hidden 320x240
+         * DXVKDUMMYWINDOW, so every WebView2 frame went to a window nobody sees. */
+        if (mark_present_for_swapchain(swapchain)) return;
         hwnd = pending_hwnd;
         ERR("gluon-register-fallback: null hwnd -> using pending_hwnd %p for swapchain %p\n",
             hwnd, swapchain);
--- a/dlls/winewayland.drv/dllmain.c
+++ b/dlls/winewayland.drv/dllmain.c
@@ -235,12 +235,16 @@
             for (i = 0; i < n; i++)
             {
                 HWND hwnd = (HWND)(ULONG_PTR)reg->hwnds[i];
-                DWORD pid = 0;
+                DWORD pid = 0, root_pid = 0;
                 if (!hwnd) continue;
                 GetWindowThreadProcessId(hwnd, &pid);
+                /* NEUTRON 2026-11-03: also a window of another process inside OUR top-level window
+                 * (Chromium's "Intermediate D3D Window" in a WebView2 host app): its pixels belong in
+                 * our window_surface, and GetDC on it here draws there, clipped to it. */
+                if (pid != self) GetWindowThreadProcessId(GetAncestor(hwnd, GA_ROOT), &root_pid);
                 /* Gate on IsWindowVisible: Premiere keeps multiple CEP hosts registered (e.g. a
                  * tabbed-away/hidden panel that still renders); only present the on-screen one. */
-                if (pid == self && IsWindow(hwnd) && IsWindowVisible(hwnd))
+                if ((pid == self || root_pid == self) && IsWindow(hwnd) && IsWindowVisible(hwnd))
                     neutron_consumer_present(hwnd);
             }
         }
