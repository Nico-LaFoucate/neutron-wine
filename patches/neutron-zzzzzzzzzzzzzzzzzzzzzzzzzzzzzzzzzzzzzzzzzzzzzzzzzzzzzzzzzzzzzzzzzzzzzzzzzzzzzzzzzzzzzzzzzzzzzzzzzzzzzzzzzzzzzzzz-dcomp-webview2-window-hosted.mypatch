+#define DEVICE1_FORWARD(name, params, args) \
+static HRESULT WINAPI device1_##name params \
+{ \
+    struct composition_device *device = impl_device_from_IDCompositionDevice(iface); \
+    return device_##name args; \
+}
+
+static HRESULT WINAPI device1_QueryInterface(IDCompositionDevice *iface, REFIID iid, void **out)
+{
+    struct composition_device *device = impl_device_from_IDCompositionDevice(iface);
+    return device_QueryInterface(&device->IDCompositionDesktopDevice_iface, iid, out);
+}
+
+static ULONG WINAPI device1_AddRef(IDCompositionDevice *iface)
+{
+    struct composition_device *device = impl_device_from_IDCompositionDevice(iface);
+    return device_AddRef(&device->IDCompositionDesktopDevice_iface);
+}
+
+static ULONG WINAPI device1_Release(IDCompositionDevice *iface)
+{
+    struct composition_device *device = impl_device_from_IDCompositionDevice(iface);
+    return device_Release(&device->IDCompositionDesktopDevice_iface);
+}
+
+DEVICE1_FORWARD(Commit, (IDCompositionDevice *iface), (&device->IDCompositionDesktopDevice_iface))
