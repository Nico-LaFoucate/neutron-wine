     IDCompositionDesktopDevice IDCompositionDesktopDevice_iface;
+    /* The original (Windows 8) device interface. DCompositionCreateDevice(NULL, IID_IDCompositionDevice) is how
+     * Chromium's software compositor gets its device (viz OutputDeviceBacking::GetOrCreateDXObjects), and a failure
+     * there is a CHECK: WebView2 154's GPU process died on every start and the browser gave up ("GPU process isn't
+     * usable. Goodbye."). Same object, same targets and visuals; every method forwards to the desktop device. */
+    IDCompositionDevice IDCompositionDevice_iface;
     LONG refcount;
     IUnknown *rendering_device;
     struct list targets;
@@ -77,6 +82,11 @@
