+/* NEUTRON FONT-METRICS DIAG (env NEUTRON_DWRITE_FONTMETRICS=1) -----------------
+ * Premiere's Effect Controls panel overlaps its title with the first control row, in GPU
+ * mode only. The working model: the row height an Adobe drawbot uses is
+ *
+ *     the font's ascent + descent, read through THIS function
+ *     (IDWriteFont::GetMetrics)
+ *
+ * -- not IDWriteTextLayout, which is why four earlier theories all died while being
+ * consistent with the symptom.
+ *
+ * What is NOT known is WHICH FONT FAMILY Premiere asks for. Assuming "Segoe UI" and testing
+ * that assumption instead of the app is exactly the mistake that produced a retracted
+ * "root cause" on 2026-07-31: for Segoe UI, Wine's builtin dwrite and gdi32 agree
+ * (15.024 DIPs vs 15 px), so that font is not the culprit.
+ *
+ * So log what the app ACTUALLY asks for. DISTINCT combinations only -- Premiere calls this
+ * constantly and per-call logging would bury the answer and skew timing. */
+static void neutron_fontmetrics_note(struct dwrite_font *font, const DWRITE_FONT_METRICS *m)
+{
+    static int enabled = -1;
+    static struct { UINT16 upem, asc, desc; WCHAR name[64]; } seen[48];
+    static LONG nseen;
+    WCHAR name[64] = L"?";
+    LONG i, n;
+
+    if (enabled < 0)
+    {
+        char b[8];
+        enabled = (GetEnvironmentVariableA("NEUTRON_DWRITE_FONTMETRICS", b, sizeof(b)) && b[0] == '1') ? 1 : 0;
+    }
+    if (!enabled) return;
+
+    if (font->family && font->family->data && font->family->data->familyname)
+    {
+        UINT32 len = 0;
+        IDWriteLocalizedStrings_GetStringLength(font->family->data->familyname, 0, &len);
+        if (len < 63)
+            IDWriteLocalizedStrings_GetString(font->family->data->familyname, 0, name, len + 1);
+    }
+
+    n = nseen;
+    for (i = 0; i < n && i < 48; i++)
+        if (seen[i].upem == m->designUnitsPerEm && seen[i].asc == m->ascent
+                && seen[i].desc == m->descent && !wcscmp(seen[i].name, name))
+            return;
+    if (n < 48)
+    {
+        seen[n].upem = m->designUnitsPerEm; seen[n].asc = m->ascent; seen[n].desc = m->descent;
+        lstrcpynW(seen[n].name, name, 64);
+        InterlockedIncrement(&nseen);
+        /* ascent+descent in DIPs at em 12 and 15 -- the sizes Premiere's panels use -- so the
+         * numbers can be compared straight against the gdi32 side without arithmetic. */
+        ERR("neutron-fontmetrics: family=%s upem=%u ascent=%u descent=%u lineGap=%d "
+            "=> ascent+descent @em12=%.3f @em15=%.3f\n", debugstr_w(name),
+            m->designUnitsPerEm, m->ascent, m->descent, m->lineGap,
+            (m->ascent + m->descent) * 12.0 / (double)m->designUnitsPerEm,
+            (m->ascent + m->descent) * 15.0 / (double)m->designUnitsPerEm);
+    }
+}
+
 static void WINAPI dwritefont_GetMetrics(IDWriteFont3 *iface, DWRITE_FONT_METRICS *metrics)
 {
     struct dwrite_font *font = impl_from_IDWriteFont3(iface);
@@ -2445,6 +2510,7 @@
     TRACE("%p, %p.\n", iface, metrics);
 
     memcpy(metrics, &font->data->metrics, sizeof(*metrics));
+    neutron_fontmetrics_note(font, metrics);
 }
 
