+/* NEUTRON DWRITE LAYOUT TRACE (env NEUTRON_DWRITE_LAYOUTTRACE=1|2) ---------------------------
+ * AME/AE multi-word titles wrap onto several rows. The working model: the D2D drawbot
+ * (a) measures natural width with CreateTextLayout(maxW=maxH=10000) + GetMetrics().width and
+ * (b) draws with CreateTextLayout(maxW=<that width>) leaving word wrapping at the default
+ * WRAP mode. An offline harness proved Wine upholds the required invariant (relayout at own
+ * natural width never wraps), so the decisive unknown is WHAT maxWidth the app passes for
+ * the strings that wrap, and who computed it. These helpers log exactly that, with the
+ * CALLER MODULE so dvaui/UIFramework/dvaworkspace paths can be told apart.
+ *   level 1: multi-word strings only (contains a space, no newline), deduplicated
+ *   level 2: everything, no dedup
+ * Uses ERR so no WINEDEBUG channel setup is needed; OFF (zero overhead) without the env var. */
+static inline int neutron_ltrace_level(void)
+{
+    static int level = -1;
+    if (level < 0)
+    {
+        char b[8];
+        if (GetEnvironmentVariableA("NEUTRON_DWRITE_LAYOUTTRACE", b, sizeof(b)))
+            level = b[0] == '2' ? 2 : (b[0] == '1' ? 1 : 0);
+        else
+            level = 0;
+    }
+    return level;
+}
+
+static inline BOOL neutron_ltrace_want(const WCHAR *text, UINT32 len, BOOL need_space)
+{
+    UINT32 i;
+    BOOL space = FALSE;
+    if (neutron_ltrace_level() >= 2) return TRUE;
+    if (neutron_ltrace_level() < 1) return FALSE;
+    if (!text || !len || len > 200) return FALSE;
+    for (i = 0; i < len; ++i)
+    {
+        if (text[i] == ' ') space = TRUE;
+        else if (text[i] == '\n' || text[i] == '\r') return FALSE;
+    }
+    return need_space ? space : TRUE;
+}
+
+/* TRUE = already reported (suppress). Racy by design; a lost update only repeats a line. */
+static inline BOOL neutron_ltrace_dedup(unsigned int site, const WCHAR *text, UINT32 len, float w)
+{
+    static unsigned int seen[512];
+    unsigned int h = 2166136261u, i;
+    union { float f; unsigned int u; } uw;
+    if (neutron_ltrace_level() >= 2) return FALSE;
+    uw.f = w;
+    for (i = 0; i < len; ++i) h = (h ^ text[i]) * 16777619u;
+    h = (h ^ site) * 16777619u;
+    h = (h ^ uw.u) * 16777619u;
+    if (!h) h = 1;
+    i = h & 511;
+    if (seen[i] == h) return TRUE;
+    seen[i] = h;
+    return FALSE;
+}
+
+/* Resolve a return address to "module.dll"+offset; namebuf gets the basename. */
+static inline void neutron_ltrace_modname(void *ret, char *namebuf, DWORD n, ULONG_PTR *off)
+{
+    void *base = NULL;
+    char path[MAX_PATH];
+    const char *name = "?";
+    *off = 0;
+    RtlPcToFileHeader(ret, &base);
+    if (base && GetModuleFileNameA((HMODULE)base, path, sizeof(path)))
+    {
+        char *p = strrchr(path, '\\');
+        name = p ? p + 1 : path;
+        *off = (ULONG_PTR)ret - (ULONG_PTR)base;
+    }
+    lstrcpynA(namebuf, name, n);
+}
