# neutron-zzz6-dwrite-fontface-keepalive
#
# Keep the N most recently used IDWriteFontFace objects alive so their RASTERISED GLYPH CACHES
# survive, instead of dying with the face and being re-rasterised through FreeType.
# Touches: dlls/dwrite/main.c, dlls/dwrite/font.c.
#
# ORDERING: zzz6 -- applies after neutron-zzz5-dwrite-parsed-font-cache, whose factory-level
# cache it sits beside and mirrors in shape.
#
# THE PROBLEM
# dwrite's glyph cache lives on the fontface. The factory's fontface cache tracks faces but holds
# NO REFERENCE -- a face unlinks itself when destroyed. Code that builds text layouts per frame
# therefore destroys and recreates faces constantly, and every new face starts with an EMPTY
# glyph cache.
#
# MEASURED (preserved-fixes/harnesses/glyphbench.c -- 5 text formats, 10 timeline-like strings,
# 40 frames), before -> after:
#   fontfaces created   2189  ->     1
#   glyph cache misses 39,824 ->   318
#   hit rate              66% ->   99%
#   ms/frame (best)      2.14 ->  1.47      (-31%)
#
# Motivated by a CPU profile of Premiere's timeline zoom (2026-07-30, runtime 11.10-16) which put
# ~19.6% of the UI thread in font rasterisation: libfreetype 8.98% plus another 10.6% of libc
# called FROM libfreetype (its allocation traffic).
#
# ⚠️ THE OBVIOUS FIX WAS WRONG, AND THIS IS WHY THE INSTRUMENTATION SHIPS WITH IT.
# The code carried a long comment arguing the 32 KB glyph cache was far too small and should be
# "a few MB". It is not the constraint: a sweep from 32 KB to 4 MB moved nothing (2.06-2.16
# ms/frame), because with faces dying constantly the cache never filled -- peak 3 KB, ZERO
# evictions. Capacity was never the problem; object LIFETIME was. Raising the cap would have been
# a no-op that looked like progress. Only after this patch does the cache actually fill (peak
# 32 KB), and even then a re-sweep shows no further gain, so the default is left ALONE.
# `NEUTRON_DWRITE_GLYPH_CACHE_KB` exists to re-measure that in a real app rather than guess.
#
# WHY NOT SHARE ONE GLYPH CACHE AT FACTORY LEVEL (the "obvious" bigger fix):
# cache entries are MUTATED after lookup (entry->advance, entry->bitmap) under the caller's
# fontface->cs. Sharing one cache across faces would require restructuring that locking across
# three hot call sites in a DLL every Adobe app loads -- reopening the freeze/deadlock class this
# project has spent months closing. Keeping the face alive gets the same glyph reuse and changes
# NO locking: each face still owns its cache under its own cs.
#
# BOUNDED at 24 faces. The evicted face is released OUTSIDE factory->cs, because a face's
# destructor takes that same lock to unlink itself from the fontface cache -- releasing the last
# reference while holding it would self-deadlock.
#
# Also included: TRACE-gated counters on the `nglyph` channel (hits/misses/evictions/peak, plus
# faces created/cleared). They are what proved the size hypothesis wrong and identified lifetime
# as the real mechanism; a statistic that never prints is not a measurement.
diff --git a/dlls/dwrite/font.c b/dlls/dwrite/font.c
index d33bc61c70e..4457568d5a3 100644
#
# MEASURED IN PREMIERE (30 s zoom, GPU mode, one build A/B'd via NEUTRON_DWRITE_FACE_KEEPALIVE):
#   fontfaces created  88,980 -> 5      (~3,000 faces/sec created while zooming)
#   glyph cache misses 587,522 -> 424   (63% -> 99% hit)
#   evictions               0 -> 0      peak 13 KB -> 17 KB of a 32 KB cap
# User-confirmed the keepalive-OFF arm was 'a little choppier' (test was NOT blind --
# corroboration, not proof; the counters are the evidence).
# The synthetic benchmark understated the churn by 40x (2189 vs 88,980) -- it got the
# mechanism right and the magnitude badly wrong. Confirm synthetics in the real app.
--- a/dlls/dwrite/main.c
+++ b/dlls/dwrite/main.c
@@ -621,6 +621,9 @@
      * profile. Caching the parsed font here fixes that without touching any COM
      * refcount: caching the fontface itself would make the factory and its faces
      * reference each other and neither would ever be freed. */
+    /* NEUTRON: bounded keep-alive for recently used fontfaces. */
+    struct list fontface_keepalive;
+    unsigned int fontface_keepalive_count;
     struct list font_objects;
     unsigned int font_object_count;
 
@@ -635,6 +638,8 @@
     return CONTAINING_RECORD(iface, struct dwritefactory, IDWriteFactory7_iface);
 }
 
+static void factory_release_keepalive(struct dwritefactory *factory);
+
 static void release_fontface_cache(struct list *fontfaces)
 {
     struct fontfacecached *fontface, *fontface2;
@@ -672,6 +677,7 @@
     EnterCriticalSection(&factory->cs);
     release_fontface_cache(&factory->localfontfaces);
     LeaveCriticalSection(&factory->cs);
+    factory_release_keepalive(factory);
     factory_release_font_objects(&factory->IDWriteFactory7_iface);
 
     LIST_FOR_EACH_ENTRY_SAFE(loader, loader2, &factory->collection_loaders, struct collectionloader, entry) {
@@ -972,6 +978,106 @@
     void *key;
 };
 
+/* NEUTRON: KEEP RECENTLY USED FONTFACES ALIVE.
+ *
+ * The factory's fontface cache (localfontfaces / fileloader->fontfaces) tracks faces but holds
+ * NO REFERENCE -- a face removes itself from the list when it is destroyed. dwrite's rasterised
+ * GLYPH cache lives on the fontface, so every time the app drops a face those glyph bitmaps die
+ * with it and the next draw re-rasterises them through FreeType.
+ *
+ * MEASURED (harnesses/glyphbench.c, 5 text formats, 40 frames): 2189 fontfaces created and 2188
+ * destroyed, 39,824 glyph-cache misses -- with ZERO evictions and a peak cache size of 3 KB
+ * against a 32 KB cap. Capacity was never the constraint; object lifetime was. A CPU profile of
+ * Premiere's timeline zoom put ~19.6% of the UI thread in font rasterisation (libfreetype plus
+ * the libc allocation traffic underneath it).
+ *
+ * ⚠️ This is why the obvious fix was wrong: the code carried a long comment arguing the 32 KB
+ * glyph cache was far too small, and a sweep from 32 KB to 4 MB moved nothing (2.06-2.16
+ * ms/frame). Raising it would have been a no-op that looked like progress.
+ *
+ * So hold a reference to the N most recently used faces. Their glyph caches survive, and nothing
+ * about the glyph cache's own locking changes -- each face still owns its cache under its own cs,
+ * which is what keeps this off the deadlock path. Bounded, so memory cannot run away. */
+#define NEUTRON_FONTFACE_KEEPALIVE_MAX 24
+
+struct neutron_keepalive
+{
+    struct list entry;
+    IDWriteFontFace5 *fontface;
+};
+
+/* Default ON -- this is a fix, not an experiment. The gate exists so a single build can be
+ * A/B'd inside one app session with counters on BOTH arms; comparing against a counter-less
+ * baseline would mean comparing measured numbers to remembered ones. */
+static BOOL factory_keepalive_enabled(void)
+{
+    static int v = -1;
+    if (v < 0)
+    {
+        char buf[8];
+        DWORD n = GetEnvironmentVariableA("NEUTRON_DWRITE_FACE_KEEPALIVE", buf, sizeof(buf));
+        v = (n && n < sizeof(buf) && buf[0] == '0') ? 0 : 1;
+    }
+    return v;
+}
+
+static void factory_keepalive_touch(struct dwritefactory *factory, IDWriteFontFace5 *fontface)
+{
+    struct neutron_keepalive *ka, *ka2, *evicted = NULL;
+
+    /* caller holds factory->cs */
+    if (!factory_keepalive_enabled()) return;
+    LIST_FOR_EACH_ENTRY_SAFE(ka, ka2, &factory->fontface_keepalive, struct neutron_keepalive, entry)
+    {
+        if (ka->fontface != fontface) continue;
+        list_remove(&ka->entry);                       /* move to front (most recent) */
+        list_add_head(&factory->fontface_keepalive, &ka->entry);
+        return;
+    }
+
+    if (!(ka = malloc(sizeof(*ka)))) return;
+    ka->fontface = fontface;
+    IDWriteFontFace5_AddRef(fontface);
+    list_add_head(&factory->fontface_keepalive, &ka->entry);
+    factory->fontface_keepalive_count++;
+
+    if (factory->fontface_keepalive_count > NEUTRON_FONTFACE_KEEPALIVE_MAX)
+    {
+        evicted = LIST_ENTRY(list_tail(&factory->fontface_keepalive), struct neutron_keepalive, entry);
+        list_remove(&evicted->entry);
+        factory->fontface_keepalive_count--;
+    }
+    if (evicted)
+    {
+        IDWriteFontFace5 *face = evicted->fontface;
+        free(evicted);
+        /* Release OUTSIDE the lock: the face's destructor takes factory->cs to unlink itself
+         * from the fontface cache, so releasing the last reference here would self-deadlock. */
+        LeaveCriticalSection(&factory->cs);
+        IDWriteFontFace5_Release(face);
+        EnterCriticalSection(&factory->cs);
+    }
+}
+
+static void factory_release_keepalive(struct dwritefactory *factory)
+{
+    struct neutron_keepalive *ka, *ka2;
+    struct list local;
+
+    list_init(&local);
+    EnterCriticalSection(&factory->cs);
+    list_move_tail(&local, &factory->fontface_keepalive);
+    factory->fontface_keepalive_count = 0;
+    LeaveCriticalSection(&factory->cs);
+
+    LIST_FOR_EACH_ENTRY_SAFE(ka, ka2, &local, struct neutron_keepalive, entry)
+    {
+        list_remove(&ka->entry);
+        IDWriteFontFace5_Release(ka->fontface);
+        free(ka);
+    }
+}
+
 static void release_cached_font_object(struct cached_font_object *cached)
 {
     struct release_font_object_params params = { cached->object };
@@ -1128,6 +1234,7 @@
                 WARN("Failed to get %s from fontface, hr %#lx.\n", debugstr_guid(riid), hr);
 
             TRACE("returning cached fontface %p\n", cached->fontface);
+            factory_keepalive_touch(factory, cached->fontface);
             break;
         }
     }
@@ -1150,6 +1257,7 @@
     cached->fontface = fontface;
     EnterCriticalSection(&factory->cs);
     list_add_tail(fontfaces, &cached->entry);
+    factory_keepalive_touch(factory, fontface);
     LeaveCriticalSection(&factory->cs);
 
     return cached;
@@ -2366,6 +2474,8 @@
     list_init(&factory->collection_loaders);
     list_init(&factory->file_loaders);
     list_init(&factory->localfontfaces);
+    list_init(&factory->fontface_keepalive);
+    factory->fontface_keepalive_count = 0;
     list_init(&factory->font_objects);
 
     InitializeCriticalSectionEx(&factory->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
--- a/dlls/dwrite/font.c
+++ b/dlls/dwrite/font.c
@@ -29,6 +29,30 @@
 #include "unixlib.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(dwrite);
+WINE_DECLARE_DEBUG_CHANNEL(nglyph);
+
+/* NEUTRON: glyph-cache instrumentation + tunable size.
+ * The size was argued for in the comment below and then never actually changed -- it stayed at
+ * 32 KB. Rather than swap one guessed constant for another, make it tunable
+ * (NEUTRON_DWRITE_GLYPH_CACHE_KB) and count hits/misses/evictions so the right value comes from
+ * the measured working set. Counters are reported on the `nglyph` channel. */
+static LONG neutron_glyph_hits, neutron_glyph_misses, neutron_glyph_evicts;
+static LONG neutron_glyph_peak;
+static LONG neutron_face_inits, neutron_face_clears;
+
+static size_t neutron_glyph_cache_max(void)
+{
+    static size_t v;
+    if (!v)
+    {
+        char buf[16];
+        DWORD n = GetEnvironmentVariableA("NEUTRON_DWRITE_GLYPH_CACHE_KB", buf, sizeof(buf));
+        unsigned kb = (n && n < sizeof(buf)) ? (unsigned)atoi(buf) : 0;
+        v = kb ? (size_t)kb * 1024 : 0x8000;   /* 32 KB = the historical default */
+    }
+    return v;
+}
+
 WINE_DECLARE_DEBUG_CHANNEL(dwrite_file);
 
 #define MS_HEAD_TAG DWRITE_MAKE_OPENTYPE_TAG('h','e','a','d')
@@ -99,6 +123,7 @@
 
     if (!(e = wine_rb_get(&fontface->cache.tree, key)))
     {
+        InterlockedIncrement(&neutron_glyph_misses);
         if (!(entry = calloc(1, sizeof(*entry)))) return NULL;
         entry->key = *key;
         list_init(&entry->mru);
@@ -111,6 +136,7 @@
             fontface->cache.size -= (old_entry->bitmap_size + sizeof(*old_entry));
             wine_rb_remove(&fontface->cache.tree, &old_entry->entry);
             list_remove(&old_entry->mru);
+            InterlockedIncrement(&neutron_glyph_evicts);
             fontface_release_cache_entry(old_entry);
         }
 
@@ -122,13 +148,22 @@
         }
 
         fontface->cache.size += size;
+        if ((LONG)fontface->cache.size > neutron_glyph_peak) neutron_glyph_peak = fontface->cache.size;
     }
     else
+    {
+        InterlockedIncrement(&neutron_glyph_hits);
         entry = WINE_RB_ENTRY_VALUE(e, struct cache_entry, entry);
+    }
 
     list_remove(&entry->mru);
     list_add_head(&fontface->cache.mru, &entry->mru);
 
+    /* Report periodically. The first version defined neutron_glyph_report() and never called it,
+     * so a size sweep produced no counters at all -- indistinguishable from "the size does not
+     * matter". A statistic that never prints is not a measurement. */
+    if (!((neutron_glyph_hits + neutron_glyph_misses) % 4096)) neutron_glyph_report();
+
     return entry;
 }
 
@@ -261,6 +296,16 @@
     return memcmp(&key->m, &key2->m, sizeof(key->m));
 }
 
+void neutron_glyph_report(void)
+{
+    LONG h = neutron_glyph_hits, m = neutron_glyph_misses;
+    if (!TRACE_ON(nglyph) || !(h + m)) return;
+    TRACE_(nglyph)("neutron-glyph: hits=%ld misses=%ld (%ld%% hit) evictions=%ld peak=%ld KB cap=%u KB\n",
+                   h, m, h * 100 / (h + m), neutron_glyph_evicts,
+                   neutron_glyph_peak / 1024, (unsigned)(neutron_glyph_cache_max() / 1024));
+    TRACE_(nglyph)("neutron-glyph: faces_created=%ld faces_cleared=%ld\n", neutron_face_inits, neutron_face_clears);
+}
+
 static void fontface_cache_init(struct dwrite_fontface *fontface)
 {
     wine_rb_init(&fontface->cache.tree, fontface_cache_compare);
@@ -274,11 +319,13 @@
      * re-rasterises them through FreeType every time. Measured: libfreetype was
      * 12.2% of a saturated UI thread. A few MB is nothing next to the font data
      * already resident and holds a realistic working set. */
-    fontface->cache.max_size = 0x8000;
+    fontface->cache.max_size = neutron_glyph_cache_max();
+    InterlockedIncrement(&neutron_face_inits);
 }
 
 static void fontface_cache_clear(struct dwrite_fontface *fontface)
 {
+    InterlockedIncrement(&neutron_face_clears);
     struct cache_entry *entry, *entry2;
 
     LIST_FOR_EACH_ENTRY_SAFE(entry, entry2, &fontface->cache.mru, struct cache_entry, mru)
