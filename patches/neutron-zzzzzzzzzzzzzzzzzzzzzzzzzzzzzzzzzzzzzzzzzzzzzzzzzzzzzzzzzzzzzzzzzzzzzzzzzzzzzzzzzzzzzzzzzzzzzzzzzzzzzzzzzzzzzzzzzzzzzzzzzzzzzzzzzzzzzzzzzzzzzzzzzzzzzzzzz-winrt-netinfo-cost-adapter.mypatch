# neutron-winrt-netinfo-cost-adapter
#
# Touches: dlls/windows.networking.connectivity/{network_information.c,Makefile.in,tests/connectivity.c}.
#
# WHAT HAPPENED (lab, 11-05/11-06, Topaz Photo 1.7.1 through `neutron programs launch`)
# Every start logs "Failed to obtain network adapter: COM error 0x80004001: Not implemented." and "Failed to obtain
# connection cost: ...0x80004001...". Qt 6.10's network-information backend (plugins/networkinformation,
# networklistmanager) asks Windows.Networking.Connectivity: NetworkInformation.GetInternetConnectionProfile(), then
# ConnectionProfile.NetworkAdapter -> IanaInterfaceType and ConnectionProfile.GetConnectionCost() -> NetworkCostType
# (+connectivity trace). Both were E_NOTIMPL stubs, so Qt reported transport "unknown" and metered "false" by default.
#
# MECHANISM / FIX
# GetConnectionCost returns a ConnectionCost built, as on Windows, on the NLM cost of the connection
# (INetworkCostManager::GetCost of the profile's NetworkListManager; netprofm reports NLM_CONNECTION_COST_UNRESTRICTED):
# NetworkCostType Unrestricted/Fixed/Variable/Unknown, Roaming, OverDataLimit, ApproachingDataLimit from the NLM flags.
# NetworkAdapter returns the adapter of the NLM connection the profile stands for (first connection with internet
# connectivity, else the first connected one -- the set GetNetworkConnectivityLevel reports on): NetworkAdapterId = its
# interface GUID (= INetworkConnection::GetAdapterId), IanaInterfaceType = IP_ADAPTER_ADDRESSES.IfType, Outbound/Inbound
# MaxBitsPerSecond = Transmit/ReceiveLinkSpeed. Imports iphlpapi.
# WINDOWS: per Microsoft's documentation of ConnectionProfile.GetConnectionCost / NetworkAdapter, ConnectionCost and
# NetworkAdapter; the new conformance checks (tests/connectivity.c) compare against NLM and are written to hold on Windows.
#
# NOT COVERED: IConnectionCost2 (BackgroundDataUsageRestricted; not declared in Wine's IDL), NetworkAdapter.NetworkItem and
# GetConnectedProfileAsync (FIXME stubs), GetConnectionProfiles, NetworkStatusChanged events (still a stub cookie).
# Ableton Live: no call at all from startup -> Welcome -> Save/Export Disabled -> Learn View (+connectivity trace, 0 lines,
# n=1); only Max's libcef.dll names the class (INFERRED: Max for Live devices), not exercised.
#
# LAB EVIDENCE (11.10-183g = 183rc + this module + wininet + icon font; desk l; prefixes from PgV-tz1)
#   Topaz fix on:                    2/2 launches 0 warnings (SgT-tz1, SgT-tz2; tz2 trace: adapter type 71, cost 0x1)
#   NEUTRON_WINRT_NETINFO=0:         2/2 launches both warnings (SgT-tz3 x2)
#   Wine test connectivity (standalone build): fix on 69 tests 0 failures; switch=0 1 failure (0x80004001);
#   unmodified test 37 tests 0 failures on 183g and on 183rc.
# Kill switch: NEUTRON_WINRT_NETINFO=0 (app environment).
--- a/dlls/windows.networking.connectivity/Makefile.in
+++ b/dlls/windows.networking.connectivity/Makefile.in
@@ -1,5 +1,5 @@
 MODULE        = windows.networking.connectivity.dll
-IMPORTS       = combase
+IMPORTS       = combase iphlpapi
 EXTRAIDLFLAGS = -DDO_NO_IMPORTS
 
 SOURCES = \
--- a/dlls/windows.networking.connectivity/network_information.c
+++ b/dlls/windows.networking.connectivity/network_information.c
@@ -20,6 +20,10 @@
 #include "private.h"
 #include "initguid.h"
 #include "netlistmgr.h"
+#include "winsock2.h"
+#include "ws2ipdef.h"
+#include "iphlpapi.h"
+#include "netioapi.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(connectivity);
 
@@ -200,6 +204,365 @@
     return E_NOTIMPL;
 }
 
+/* Neutron: ConnectionProfile.GetConnectionCost and ConnectionProfile.NetworkAdapter, built on the
+ * NLM connection the profile reports (netprofm), the way Windows builds them on NLM. The kill
+ * switch NEUTRON_WINRT_NETINFO=0 restores the E_NOTIMPL stubs. */
+static BOOL netinfo_enabled(void)
+{
+    WCHAR buf[8];
+    DWORD len = GetEnvironmentVariableW( L"NEUTRON_WINRT_NETINFO", buf, ARRAY_SIZE(buf) );
+    return !(len == 1 && buf[0] == '0');
+}
+
+struct connection_cost
+{
+    IConnectionCost IConnectionCost_iface;
+    LONG ref;
+    DWORD cost; /* NLM_CONNECTION_COST flags */
+};
+
+static inline struct connection_cost *impl_from_IConnectionCost( IConnectionCost *iface )
+{
+    return CONTAINING_RECORD( iface, struct connection_cost, IConnectionCost_iface );
+}
+
+static HRESULT WINAPI connection_cost_QueryInterface( IConnectionCost *iface, REFIID iid, void **out )
+{
+    struct connection_cost *impl = impl_from_IConnectionCost( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IConnectionCost ))
+    {
+        *out = &impl->IConnectionCost_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI connection_cost_AddRef( IConnectionCost *iface )
+{
+    struct connection_cost *impl = impl_from_IConnectionCost( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p increasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI connection_cost_Release( IConnectionCost *iface )
+{
+    struct connection_cost *impl = impl_from_IConnectionCost( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI connection_cost_GetIids( IConnectionCost *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI connection_cost_GetRuntimeClassName( IConnectionCost *iface, HSTRING *class_name )
+{
+    static const WCHAR name[] = L"Windows.Networking.Connectivity.ConnectionCost";
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( name, ARRAY_SIZE(name) - 1, class_name );
+}
+
+static HRESULT WINAPI connection_cost_GetTrustLevel( IConnectionCost *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI connection_cost_get_NetworkCostType( IConnectionCost *iface, NetworkCostType *value )
+{
+    struct connection_cost *impl = impl_from_IConnectionCost( iface );
+
+    TRACE( "iface %p, value %p, cost %#lx.\n", iface, value, impl->cost );
+
+    if (!value) return E_POINTER;
+    if (impl->cost & NLM_CONNECTION_COST_UNRESTRICTED) *value = NetworkCostType_Unrestricted;
+    else if (impl->cost & NLM_CONNECTION_COST_FIXED) *value = NetworkCostType_Fixed;
+    else if (impl->cost & NLM_CONNECTION_COST_VARIABLE) *value = NetworkCostType_Variable;
+    else *value = NetworkCostType_Unknown;
+    return S_OK;
+}
+
+static HRESULT WINAPI connection_cost_get_Roaming( IConnectionCost *iface, boolean *value )
+{
+    struct connection_cost *impl = impl_from_IConnectionCost( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = !!(impl->cost & NLM_CONNECTION_COST_ROAMING);
+    return S_OK;
+}
+
+static HRESULT WINAPI connection_cost_get_OverDataLimit( IConnectionCost *iface, boolean *value )
+{
+    struct connection_cost *impl = impl_from_IConnectionCost( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = !!(impl->cost & NLM_CONNECTION_COST_OVERDATALIMIT);
+    return S_OK;
+}
+
+static HRESULT WINAPI connection_cost_get_ApproachingDataLimit( IConnectionCost *iface, boolean *value )
+{
+    struct connection_cost *impl = impl_from_IConnectionCost( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = !!(impl->cost & NLM_CONNECTION_COST_APPROACHINGDATALIMIT);
+    return S_OK;
+}
+
+static const struct IConnectionCostVtbl connection_cost_vtbl =
+{
+    connection_cost_QueryInterface,
+    connection_cost_AddRef,
+    connection_cost_Release,
+    /* IInspectable methods */
+    connection_cost_GetIids,
+    connection_cost_GetRuntimeClassName,
+    connection_cost_GetTrustLevel,
+    /* IConnectionCost methods */
+    connection_cost_get_NetworkCostType,
+    connection_cost_get_Roaming,
+    connection_cost_get_OverDataLimit,
+    connection_cost_get_ApproachingDataLimit,
+};
+
