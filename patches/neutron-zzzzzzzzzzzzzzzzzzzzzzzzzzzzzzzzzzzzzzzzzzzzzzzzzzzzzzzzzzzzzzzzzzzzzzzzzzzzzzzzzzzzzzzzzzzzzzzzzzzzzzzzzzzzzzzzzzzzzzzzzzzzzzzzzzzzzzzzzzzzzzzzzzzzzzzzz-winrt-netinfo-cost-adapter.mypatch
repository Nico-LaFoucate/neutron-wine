+/* The NLM connection behind the internet profile: the first one with internet connectivity,
+ * else the first connected one (the set GetNetworkConnectivityLevel reports on). */
+static HRESULT profile_connection_adapter_id( INetworkListManager *manager, GUID *id )
+{
+    IEnumNetworkConnections *connections;
+    INetworkConnection *connection;
+    NLM_CONNECTIVITY connectivity;
+    BOOL found = FALSE, found_internet = FALSE;
+    ULONG fetched;
+    HRESULT hr;
+    GUID guid;
+
+    if (FAILED(hr = INetworkListManager_GetNetworkConnections( manager, &connections ))) return hr;
+    while (!found_internet && IEnumNetworkConnections_Next( connections, 1, &connection, &fetched ) == S_OK && fetched)
+    {
+        if (SUCCEEDED(INetworkConnection_GetConnectivity( connection, &connectivity )) &&
+            connectivity != NLM_CONNECTIVITY_DISCONNECTED &&
+            SUCCEEDED(INetworkConnection_GetAdapterId( connection, &guid )))
+        {
+            if (connectivity & (NLM_CONNECTIVITY_IPV4_INTERNET | NLM_CONNECTIVITY_IPV6_INTERNET))
+            {
+                *id = guid;
+                found = found_internet = TRUE;
+            }
+            else if (!found)
+            {
+                *id = guid;
+                found = TRUE;
+            }
+        }
+        INetworkConnection_Release( connection );
+    }
+    IEnumNetworkConnections_Release( connections );
+    return found ? S_OK : HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+}
+
+static HRESULT create_network_adapter( const GUID *id, INetworkAdapter **value )
+{
+    ULONG flags = GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST | GAA_FLAG_SKIP_DNS_SERVER;
+    IP_ADAPTER_ADDRESSES *buf = NULL, *aa;
+    struct network_adapter *impl;
+    ULONG size = 0, err;
+    GUID guid;
+
+    err = GetAdaptersAddresses( AF_UNSPEC, flags, NULL, NULL, &size );
+    while (err == ERROR_BUFFER_OVERFLOW)
+    {
+        free( buf );
+        if (!(buf = malloc( size ))) return E_OUTOFMEMORY;
+        err = GetAdaptersAddresses( AF_UNSPEC, flags, NULL, buf, &size );
+    }
+    if (err)
+    {
+        free( buf );
+        return HRESULT_FROM_WIN32( err );
+    }
+
+    for (aa = buf; aa; aa = aa->Next)
+        if (!ConvertInterfaceLuidToGuid( &aa->Luid, &guid ) && IsEqualGUID( &guid, id )) break;
+    if (!aa)
+    {
+        free( buf );
+        WARN( "no adapter for %s\n", debugstr_guid( id ) );
+        return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    }
+
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+    {
+        free( buf );
+        return E_OUTOFMEMORY;
+    }
+    impl->INetworkAdapter_iface.lpVtbl = &network_adapter_vtbl;
+    impl->ref = 1;
+    impl->id = guid;
+    impl->iana_type = aa->IfType;
+    impl->outbound_bps = aa->TransmitLinkSpeed;
+    impl->inbound_bps = aa->ReceiveLinkSpeed;
+    TRACE( "adapter %s type %u out %I64u in %I64u\n", debugstr_guid( &guid ), impl->iana_type,
+           impl->outbound_bps, impl->inbound_bps );
+    free( buf );
+
+    *value = &impl->INetworkAdapter_iface;
+    return S_OK;
+}
+
