+static void test_connection_cost_and_adapter( IConnectionProfile *connection_profile, INetworkListManager *network_list_manager )
+{
+    IEnumNetworkConnections *connections;
+    INetworkCostManager *cost_manager;
+    INetworkConnection *connection;
+    INetworkAdapter *adapter = (void *)0xdeadbeef;
+    IConnectionCost *cost = (void *)0xdeadbeef;
+    NetworkCostType cost_type = 0xdeadbeef;
+    DWORD nlm_cost = 0xdeadbeef;
+    BOOL found = FALSE;
+    UINT32 iana_type = 0xdeadbeef;
+    UINT64 bps = 0xdeadbeef;
+    boolean flag;
+    ULONG fetched;
+    GUID id, conn_id;
+    HRESULT hr;
+    LONG ref;
+
+    hr = IConnectionProfile_GetConnectionCost( connection_profile, &cost );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (FAILED(hr)) return;
+    ok( cost != NULL && cost != (void *)0xdeadbeef, "got cost %p.\n", cost );
+    check_interface( cost, &IID_IUnknown );
+    check_interface( cost, &IID_IInspectable );
+    check_interface( cost, &IID_IAgileObject );
+    check_interface( cost, &IID_IConnectionCost );
+
+    hr = IConnectionCost_get_NetworkCostType( cost, &cost_type );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( cost_type <= NetworkCostType_Variable, "got cost type %d.\n", cost_type );
+    trace( "NetworkCostType %d\n", cost_type );
+
+    hr = INetworkListManager_QueryInterface( network_list_manager, &IID_INetworkCostManager, (void **)&cost_manager );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (SUCCEEDED(hr))
+    {
+        hr = INetworkCostManager_GetCost( cost_manager, &nlm_cost, NULL );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        if (nlm_cost & NLM_CONNECTION_COST_UNRESTRICTED)
+            ok( cost_type == NetworkCostType_Unrestricted, "got cost type %d for NLM cost %#lx.\n", cost_type, nlm_cost );
+        else if (nlm_cost & NLM_CONNECTION_COST_FIXED)
+            ok( cost_type == NetworkCostType_Fixed, "got cost type %d for NLM cost %#lx.\n", cost_type, nlm_cost );
+        else if (nlm_cost & NLM_CONNECTION_COST_VARIABLE)
+            ok( cost_type == NetworkCostType_Variable, "got cost type %d for NLM cost %#lx.\n", cost_type, nlm_cost );
+        flag = 0xcc;
+        hr = IConnectionCost_get_Roaming( cost, &flag );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        ok( flag == !!(nlm_cost & NLM_CONNECTION_COST_ROAMING), "got Roaming %d for NLM cost %#lx.\n", flag, nlm_cost );
+        flag = 0xcc;
+        hr = IConnectionCost_get_OverDataLimit( cost, &flag );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        ok( flag == !!(nlm_cost & NLM_CONNECTION_COST_OVERDATALIMIT), "got OverDataLimit %d for NLM cost %#lx.\n", flag, nlm_cost );
+        flag = 0xcc;
+        hr = IConnectionCost_get_ApproachingDataLimit( cost, &flag );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        ok( flag == !!(nlm_cost & NLM_CONNECTION_COST_APPROACHINGDATALIMIT), "got ApproachingDataLimit %d for NLM cost %#lx.\n", flag, nlm_cost );
+        INetworkCostManager_Release( cost_manager );
+    }
+    ref = IConnectionCost_Release( cost );
+    ok( ref == 0, "got ref %ld.\n", ref );
+
+    hr = IConnectionProfile_get_NetworkAdapter( connection_profile, &adapter );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (FAILED(hr)) return;
+    ok( adapter != NULL && adapter != (void *)0xdeadbeef, "got adapter %p.\n", adapter );
+    check_interface( adapter, &IID_IUnknown );
+    check_interface( adapter, &IID_IInspectable );
+    check_interface( adapter, &IID_IAgileObject );
+    check_interface( adapter, &IID_INetworkAdapter );
+
+    hr = INetworkAdapter_get_IanaInterfaceType( adapter, &iana_type );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( iana_type != 0 && iana_type != 0xdeadbeef, "got type %u.\n", iana_type );
+    hr = INetworkAdapter_get_InboundMaxBitsPerSecond( adapter, &bps );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = INetworkAdapter_get_OutboundMaxBitsPerSecond( adapter, &bps );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    memset( &id, 0, sizeof(id) );
+    hr = INetworkAdapter_get_NetworkAdapterId( adapter, &id );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    trace( "adapter %s type %u\n", wine_dbgstr_guid( &id ), iana_type );
+
+    /* the adapter is the one of a connected NLM connection */
+    hr = INetworkListManager_GetNetworkConnections( network_list_manager, &connections );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    while (SUCCEEDED(hr) && !found && IEnumNetworkConnections_Next( connections, 1, &connection, &fetched ) == S_OK && fetched)
+    {
+        if (SUCCEEDED(INetworkConnection_GetAdapterId( connection, &conn_id )) && IsEqualGUID( &conn_id, &id )) found = TRUE;
+        INetworkConnection_Release( connection );
+    }
+    if (SUCCEEDED(hr)) IEnumNetworkConnections_Release( connections );
+    ok( found, "adapter %s is not the adapter of an NLM connection.\n", wine_dbgstr_guid( &id ) );
+
+    ref = INetworkAdapter_Release( adapter );
+    ok( ref == 0, "got ref %ld.\n", ref );
+}
+
 static void test_NetworkInformationStatics(void)
 {
     static const WCHAR *network_information_statics_name = L"Windows.Networking.Connectivity.NetworkInformation";
@@ -187,6 +285,8 @@
     else
         ok( network_connectivity_level == NetworkConnectivityLevel_ConstrainedInternetAccess, "got network_connectivity_level %d.\n", network_connectivity_level );
 
+    test_connection_cost_and_adapter( connection_profile, network_list_manager );
+
     ref = IConnectionProfile_Release( connection_profile );
     ok( ref == 0, "got ref %ld.\n", ref );
 cleanup:
