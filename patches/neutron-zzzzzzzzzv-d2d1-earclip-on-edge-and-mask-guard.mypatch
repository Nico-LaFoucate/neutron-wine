d2d1: tolerate on-edge points when ear clipping, and make the mask guard ask the right question

Three changes, two fixes and the testability that should have come first.

1. EAR CLIPPING: a point ON an ear's edge must not block it.

   d2d_ear_clip_contains already claimed this in a comment, but `!(neg && pos)` returns CONTAINED
   for a point exactly on an edge -- one d is zero, the others share a sign. That is what jammed the
   last four declines a session: fans of curve samples where every candidate ear has neighbours
   sitting on its edges. Now: mixed signs still mean outside; otherwise the point only blocks the
   ear if it is inside by a real margin -- |d| over the edge length is the perpendicular distance,
   required to exceed a millionth of the triangle's longest edge.

   ⚠️ THE FIRST ATTEMPT AT THIS WAS BACKWARDS AND IS WORTH RECORDING. It zeroed each d that was
   within tolerance of its edge, before the sign test. That REMOVES the evidence a point is outside:
   a clearly-outside point has mixed signs, and zeroing one collapses it to a single sign, which
   reads as contained. Recovery went 396/400 -> 0/232 -- every ear blocked, the fallback dead. The
   tolerance belongs on the CONCLUSION, not the inputs.

2. PATH-MASK STENCIL: the guard now resolves the tessellation before asking about it.

   A mask whose fill tessellation is empty writes nothing to the stencil, so no pixel reaches the
   new depth and everything inside the layer is clipped away -- content vanishing. An earlier guard
   read face_count directly, but tessellation is LAZY (d2d_geometry_require_tessellation), so it
   read 0 for masks that stencil perfectly well and disabled the feature. It now resolves first,
   exactly as the fill path does, so an untessellatable mask falls back to the bounding-box clip
   instead of blanking its layer.

3. NEUTRON_FORCE_EARCLIP=1 stands the CDT down so the fallback can be exercised from a harness.

   The fallback only runs when the CDT fails, and no synthetic geometry provokes that: a comb and a
   flattened bezier circle at the measured failing dimensions (1177x13, 105 verts; r=7.5) both
   tessellate cleanly. So every change here was being validated by launching Premiere -- which is
   how change 1 shipped backwards and cost a run. Forced, the harness shows the comb clipping 103
   vertices into 55 faces and rendering 25/25 teeth with 0 gaps, and the circle 8 into 6.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>

--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -3273,6 +3273,27 @@
 /* NEUTRON PATH-MASK STENCIL: write (dir=+1) or unwrite (dir=-1) a mask geometry into the stencil.
  * Reuses the ordinary geometry tessellation -- the same code that already draws the histogram's
  * curve outlines correctly -- with colour writes masked off. */
+/* NEUTRON PATH-MASK STENCIL: can this mask actually be stencilled?
+ *
+ * If its fill tessellation is empty, writing it to the stencil writes nothing, no pixel reaches the
+ * new depth, and every draw inside the layer is clipped away -- content vanishing, which is worse
+ * than the bounding box this replaced. Wine's tessellator does fail on real geometry.
+ *
+ * ⚠️ Tessellation is LAZY (d2d_geometry_require_tessellation), so face_count is 0 before anything
+ * has needed it. An earlier version of this guard read the counts directly, saw 0 for a mask that
+ * stencils perfectly well, and disabled the feature -- the check has to RESOLVE the tessellation
+ * first and then ask, which is exactly what the fill path does. */
+static BOOL d2d_device_context_mask_is_stencillable(ID2D1Geometry *mask)
+{
+    struct d2d_geometry *geometry;
+
+    if (!(geometry = unsafe_impl_from_ID2D1Geometry(mask)))
+        return FALSE;
+    if (FAILED(d2d_geometry_require_tessellation(geometry)))
+        return FALSE;
+    return geometry->fill.face_count || geometry->fill.bezier_vertex_count;
+}
+
 static void d2d_device_context_stencil_mask(struct d2d_device_context *context,
         ID2D1Geometry *mask, const D2D1_MATRIX_3X2_F *mask_transform, int dir)
 {
@@ -3322,6 +3343,7 @@
     if (layer_parameters && layer_parameters->geometricMask && !context->mask_rect_count
             && context->layer_depth < ARRAY_SIZE(context->stencil_mask)
             && context->target.type == D2D_TARGET_BITMAP
+            && d2d_device_context_mask_is_stencillable(layer_parameters->geometricMask)
             && d2d_device_context_ensure_stencil(context))
     {
         unsigned int slot = context->layer_depth;
@@ -4538,6 +4560,7 @@
     if (layer_parameters && layer_parameters->geometricMask && !context->mask_rect_count
             && context->layer_depth < ARRAY_SIZE(context->stencil_mask)
             && context->target.type == D2D_TARGET_BITMAP
+            && d2d_device_context_mask_is_stencillable(layer_parameters->geometricMask)
             && d2d_device_context_ensure_stencil(context))
     {
         unsigned int slot = context->layer_depth;
--- a/dlls/d2d1/geometry.c
+++ b/dlls/d2d1/geometry.c
@@ -2966,18 +2966,51 @@
 static BOOL d2d_ear_clip_contains(const D2D1_POINT_2F *a, const D2D1_POINT_2F *b,
         const D2D1_POINT_2F *c, const D2D1_POINT_2F *p)
 {
-    double d1, d2, d3;
+    double d1, d2, d3, lab, lbc, lca, longest, eps, dist;
     BOOL neg, pos;
 
     d1 = ((double)p->x - b->x) * ((double)a->y - b->y) - ((double)a->x - b->x) * ((double)p->y - b->y);
     d2 = ((double)p->x - c->x) * ((double)b->y - c->y) - ((double)b->x - c->x) * ((double)p->y - c->y);
     d3 = ((double)p->x - a->x) * ((double)c->y - a->y) - ((double)c->x - a->x) * ((double)p->y - a->y);
 
+    /* 🚨 ...and EXACTLY on the edge is not the test either -- but the FIRST attempt at that got
+     * the logic backwards and is worth recording, because it looked reasonable and destroyed the
+     * whole fallback: zeroing a d to mean "on the edge" REMOVES the evidence that a point is
+     * outside. A point clearly outside has mixed signs; zero one of them and it can collapse to a
+     * single sign, which !(neg && pos) then reads as CONTAINED. Measured effect: recovery went
+     * from 396/400 to 0/232 -- every ear blocked, the fallback dead.
+     *
+     * The tolerance has to be applied to the CONCLUSION, not the inputs. Mixed signs still mean
+     * outside. Otherwise the point is inside or on the boundary, and it should only block the ear
+     * if it is inside by a real margin: |d| for an edge is twice the area of (p, edge), so |d|
+     * divided by that edge's length is p's perpendicular distance from it. Require that distance
+     * to exceed a millionth of the triangle's longest edge.
+     *
+     * This also makes the function do what its own comment always claimed. `!(neg && pos)` returns
+     * CONTAINED for a point exactly on an edge (one d is zero, the others share a sign), so
+     * on-edge vertices were blocking ears despite the comment saying they did not -- which is
+     * precisely what jammed the last four declines a session: fans of curve samples where every
+     * candidate ear has its neighbours sitting on its edges. */
     neg = d1 < 0.0 || d2 < 0.0 || d3 < 0.0;
     pos = d1 > 0.0 || d2 > 0.0 || d3 > 0.0;
 
-    /* Strictly inside only: a vertex lying exactly on an edge does not block the ear. */
-    return !(neg && pos);
+    if (neg && pos)
+        return FALSE;               /* unambiguously outside */
+
+    lab = hypot((double)a->x - b->x, (double)a->y - b->y);
+    lbc = hypot((double)b->x - c->x, (double)b->y - c->y);
+    lca = hypot((double)c->x - a->x, (double)c->y - a->y);
+    longest = lab > lbc ? lab : lbc;
+    if (lca > longest) longest = lca;
+    eps = 1e-7 * longest;
+
+    /* perpendicular distance to the nearest of the three edges */
+    dist = DBL_MAX;
+    if (lab > 0.0 && fabs(d1) / lab < dist) dist = fabs(d1) / lab;
+    if (lbc > 0.0 && fabs(d2) / lbc < dist) dist = fabs(d2) / lbc;
+    if (lca > 0.0 && fabs(d3) / lca < dist) dist = fabs(d3) / lca;
+
+    return dist > eps;              /* inside, but only blocks if it is properly inside */
 }
 
 static BOOL d2d_path_geometry_ear_clip(struct d2d_geometry *geometry,
@@ -3288,6 +3321,27 @@
         return S_OK;
     }
 
+    /* NEUTRON TESTABILITY (NEUTRON_FORCE_EARCLIP=1): the ear-clip fallback runs only when the CDT
+     * fails, and no synthetic geometry provokes that -- a comb and a flattened bezier circle at the
+     * measured failing dimensions both tessellate cleanly. Every change to the fallback was
+     * therefore validated by launching Premiere, and one of them inverted the containment test and
+     * killed it outright (recovery 396/400 -> 0/232) before a run caught it. This stands the CDT
+     * down so a harness can exercise the fallback directly. Diagnostic only, off by default.
+     * Placed HERE, not earlier: the fallback needs the sorted `vertices` built above. */
+    {
+        static int force = -1;
+
+        if (force < 0)
+        {
+            WCHAR v[8];
+            force = GetEnvironmentVariableW(L"NEUTRON_FORCE_EARCLIP", v, ARRAY_SIZE(v)) > 0;
+            if (force)
+                ERR("neutron-earclip: NEUTRON_FORCE_EARCLIP=1 -- CDT bypassed, fallback under test\n");
+        }
+        if (force)
+            goto fallback;
+    }
+
     cdt.free_edge = ~0u;
     cdt.vertices = vertices;
 
