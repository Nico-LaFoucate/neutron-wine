+    if (!(orig_flags & SWP_NOSENDCHANGING) && !(winpos->flags & SWP_NOZORDER) && neutron_owner_group() &&
+        NtUserGetAncestor( winpos->hwnd, GA_PARENT ) == get_desktop_window())
+        neutron_notify_owner_group( winpos );
