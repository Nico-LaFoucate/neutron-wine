# neutron-zzz8-winewayland-pxdouble
#
# The consumer half of the double-buffered CEP pixel handoff. Pairs with
# neutron-dcomp-zzz2-direct-publish, which is the producer.
#
# ORDERING: "zzz8" so it sorts AFTER neutron-winewayland.mypatch, whose code it edits.
# Note that a name like "neutron-winewayland-zzz-*" would NOT work: '-' (0x2d) sorts
# before '.' (0x2e), so it would land before neutron-winewayland.mypatch, not after.
#
# WHY: the producer writes the frame while this side may be blitting straight out of the
# same memory, so a blit can catch a half-written frame. That was true before AND after the
# direct-publish patch; publishing from the mapped GPU staging merely lengthened the write
# (~1 ms memcpy -> ~1.6 ms of strided rows) and so widened the window.
#
# ⚠️ This is a race fix on its own merits. It is NOT known to fix any reported symptom: the
# "panel flicker" that prompted it turned out to be an animated caution symbol and a broken
# Activate-button animation -- specific widgets, not torn frames -- which is unattributed
# and may predate all of this. Do not cite this patch as fixing that.
#
# Now: two slots. Read `active` ONCE per blit -- a producer publishing mid-blit must not
# make this side switch slots halfway. Anything other than 0/1 means a producer that
# predates the double buffer, so fall back to slot 0 rather than reading out of bounds.
--- a/dlls/winewayland.drv/dllmain.c
+++ b/dlls/winewayland.drv/dllmain.c
@@ -103,8 +103,12 @@
  * GUI thread's surface lifecycle during the startup window-creation storm. */
 #define NEUTRON_PX_MAXW 4096
 #define NEUTRON_PX_MAXH 2304
-struct neutron_px_shbuf { LONG seq, width, height, reserved; BYTE pixels[1]; };
-#define NEUTRON_PX_BYTES (sizeof(struct neutron_px_shbuf) + (SIZE_T)NEUTRON_PX_MAXW * NEUTRON_PX_MAXH * 4)
+/* NEUTRON DOUBLE BUFFER -- must match dlls/dcomp/device.c exactly; staged together. The
+ * producer fills the slot this one is not reading and publishes `active` atomically, so a
+ * blit can never catch a half-written frame. */
+struct neutron_px_shbuf { LONG seq, width, height, active; BYTE pixels[1]; };
+#define NEUTRON_PX_SLOT  ((SIZE_T)NEUTRON_PX_MAXW * NEUTRON_PX_MAXH * 4)
+#define NEUTRON_PX_BYTES (sizeof(struct neutron_px_shbuf) + 2 * NEUTRON_PX_SLOT)
 #define NEUTRON_REG_MAX 64
 struct neutron_registry { LONG count; DWORD hwnds[NEUTRON_REG_MAX]; };
 
@@ -180,8 +184,15 @@
         GetClientRect(hwnd, &rc);
         if (p_SetStretchBltMode) p_SetStretchBltMode(hdc, COLORONCOLOR);
         if (p_StretchDIBits)
+        {
+            /* Read `active` ONCE. A producer publishing mid-blit must not make us switch
+             * slots halfway. Anything other than 0/1 means a producer that predates the
+             * double buffer -- fall back to slot 0 rather than reading out of bounds. */
+            LONG act = sh->active;
+            const BYTE *src = (const BYTE *)sh->pixels + ((act == 1) ? NEUTRON_PX_SLOT : 0);
             p_StretchDIBits(hdc, 0, 0, rc.right - rc.left, rc.bottom - rc.top,
-                            0, 0, w, h, sh->pixels, &bmi, DIB_RGB_COLORS, SRCCOPY);
+                            0, 0, w, h, src, &bmi, DIB_RGB_COLORS, SRCCOPY);
+        }
         ReleaseDC(hwnd, hdc);
         /* GetDC(host) drew into the TOPLEVEL window_surface (clipped to the child); flush it to commit
          * (the GUI thread does not reliably flush a region dirtied by our cross-thread GDI blit -- without
