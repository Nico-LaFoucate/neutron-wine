-static void neutron_paint_crumbs(FileDialogImpl *This, HDC hdc)
+/*
+ * Lay the breadcrumb out and, when `paint` is set, draw it. One routine for both so a segment's
+ * hit rect always comes from the same arithmetic as its pixels. Each segment's rect is the text
+ * plus a little air, as tall as a nav button and centred in the band; the hot segment gets the
+ * same round fill the nav buttons use (NEUTRON_NAV_HOT / NEUTRON_NAV_PRESSED). Only ancestors
+ * are targets: the last segment is the folder already shown.
+ */
+static void neutron_layout_crumbs(FileDialogImpl *This, HDC hdc, BOOL paint)
 {
     static const WCHAR sepW[] = L" \x203a ";      /* " > " */
     static const WCHAR ellW[] = L"\x2026";        /* "..." */
     HFONT font = (HFONT)SendMessageW(This->dlg_hwnd, WM_GETFONT, 0, 0), old_font = NULL;
-    int widths[64], total = 0, avail, x, y, old_mode;
+    int widths[64], xs[64], total = 0, avail, x, y, old_mode;
+    const int pad = neutron_scale(5, This->dpi_x);
+    const int fill_h = neutron_scale(NEUTRON_NAV_BTN_H, This->dpi_y);
+    const int fill_top = (This->rc_crumbs.top + This->rc_crumbs.bottom - fill_h) / 2;
+    BOOL clickable = neutron_crumb_click_on();
     SIZE sz, sep_sz, ell_sz;
     UINT i, first = 0, last;
 
-    TRACE("neutron: painting %u crumbs in %s\n", This->crumb_count, wine_dbgstr_rect(&This->rc_crumbs));
-    if (!This->crumb_count) return;
+    if (!This->crumb_count || !This->crumb_rects) return;
     last = This->crumb_count - 1;
+    neutron_reset_crumb_rects(This);
 
     if (font) old_font = SelectObject(hdc, font);
     old_mode = SetBkMode(hdc, TRANSPARENT);
@@ -1938,26 +2034,44 @@
         first++;
     }
 
+    /* positions and hit rects first ... */
     x = This->rc_crumbs.left;
-    y = (This->rc_crumbs.top + This->rc_crumbs.bottom - sep_sz.cy) / 2;
-    SetTextColor(hdc, NEUTRON_CRUMB_DIM);
-    if (first)
-    {
-        TextOutW(hdc, x, y, ellW, 1);
-        x += ell_sz.cx;
-        TextOutW(hdc, x, y, sepW, 3);
-        x += sep_sz.cx;
-    }
+    if (first) x += ell_sz.cx + sep_sz.cx;
     for (i = first; i <= last; i++)
     {
-        SetTextColor(hdc, i == last ? NEUTRON_CRUMB_CURRENT : NEUTRON_CRUMB_DIM);
-        TextOutW(hdc, x, y, This->crumbs[i], lstrlenW(This->crumbs[i]));
-        x += widths[i];
-        if (i < last)
-        {
-            SetTextColor(hdc, NEUTRON_CRUMB_DIM);
-            TextOutW(hdc, x, y, sepW, 3);
-            x += sep_sz.cx;
+        xs[i] = x;
+        if (clickable && i < last)
+            SetRect(&This->crumb_rects[i], x - pad, fill_top, x + widths[i] + pad, fill_top + fill_h);
+        x += widths[i] + (i < last ? sep_sz.cx : 0);
+    }
+
+    if (paint)
+    {
+        /* ... then the hover fill, under everything ... */
+        if (This->crumb_hot >= first && (UINT)This->crumb_hot < last && clickable)
+            neutron_round_rect(hdc, &This->crumb_rects[This->crumb_hot],
+                               This->crumb_hot == This->crumb_pressed ? NEUTRON_NAV_PRESSED
+                                                                      : NEUTRON_NAV_HOT,
+                               CLR_NONE, neutron_scale(4, This->dpi_x));
+
+        /* ... then the text */
+        y = (This->rc_crumbs.top + This->rc_crumbs.bottom - sep_sz.cy) / 2;
+        SetTextColor(hdc, NEUTRON_CRUMB_DIM);
+        if (first)
+        {
+            x = This->rc_crumbs.left;
+            TextOutW(hdc, x, y, ellW, 1);
+            TextOutW(hdc, x + ell_sz.cx, y, sepW, 3);
+        }
+        for (i = first; i <= last; i++)
+        {
+            SetTextColor(hdc, i == last ? NEUTRON_CRUMB_CURRENT : NEUTRON_CRUMB_DIM);
+            TextOutW(hdc, xs[i], y, This->crumbs[i], lstrlenW(This->crumbs[i]));
+            if (i < last)
+            {
+                SetTextColor(hdc, NEUTRON_CRUMB_DIM);
+                TextOutW(hdc, xs[i] + widths[i], y, sepW, 3);
+            }
         }
     }
 
@@ -1965,6 +2079,225 @@
     if (old_font) SelectObject(hdc, old_font);
 }
 
+static void neutron_paint_crumbs(FileDialogImpl *This, HDC hdc)
+{
+    TRACE("neutron: painting %u crumbs in %s\n", This->crumb_count, wine_dbgstr_rect(&This->rc_crumbs));
+    neutron_layout_crumbs(This, hdc, TRUE);
+}
+
+/* index of the ancestor segment under a dialog-client point, or -1 */
+static int neutron_crumb_hit(FileDialogImpl *This, int x, int y)
+{
+    POINT pt = { x, y };
+    UINT i;
+
+    if (!neutron_crumb_click_on() || This->crumb_count < 2 || !This->crumb_rects) return -1;
+    if (!PtInRect(&This->rc_crumbs, pt)) return -1;
+    for (i = 0; i + 1 < This->crumb_count; i++)
+        if (!IsRectEmpty(&This->crumb_rects[i]) && PtInRect(&This->crumb_rects[i], pt)) return i;
+    return -1;
+}
+
+static void neutron_set_crumb_hot(FileDialogImpl *This, int hot)
+{
+    if (hot == This->crumb_hot) return;
+    if (This->crumb_hot >= 0 && (UINT)This->crumb_hot < This->crumb_count)
+        InvalidateRect(This->dlg_hwnd, &This->crumb_rects[This->crumb_hot], TRUE);
+    This->crumb_hot = hot;
+    if (hot >= 0 && (UINT)hot < This->crumb_count)
+        InvalidateRect(This->dlg_hwnd, &This->crumb_rects[hot], TRUE);
+}
+
+/* Browse to the folder a segment names -- the same IExplorerBrowser call the Up button and
+ * SetFolder use, so nothing about what the dialog returns changes. OnNavigationComplete rebuilds
+ * the crumbs, so copy what the diagnostic needs before the call. */
+static void neutron_crumb_navigate(FileDialogImpl *This, int index)
+{
+    IShellItem *item;
+    WCHAR name[64];
+    HRESULT hr;
+
+    if (!This->peb || index < 0 || (UINT)index >= This->crumb_count || !This->crumb_items) return;
+    item = This->crumb_items[index];
+    if (!item) return;
+    lstrcpynW(name, This->crumbs[index], ARRAY_SIZE(name));
+    IShellItem_AddRef(item);
+    hr = IExplorerBrowser_BrowseToObject(This->peb, (IUnknown *)item, SBSP_DEFBROWSER);
+    IShellItem_Release(item);
+    TRACE("neutron: crumb %d %s -> %#lx\n", index, debugstr_w(name), hr);
+    if (neutron_wl_diag())
+        ERR("neutron-crumb-nav: segment %d %s -> hr %#lx\n", index, debugstr_w(name), hr);
+}
+
+static LRESULT on_crumb_mousemove(FileDialogImpl *This, LPARAM lparam)
+{
+    int hit = neutron_crumb_hit(This, (short)LOWORD(lparam), (short)HIWORD(lparam));
+
+    /* while a segment is pressed only that one lights, and only while the pointer is on it */
+    if (This->crumb_pressed >= 0 && hit != This->crumb_pressed) hit = -1;
+    neutron_set_crumb_hot(This, hit);
+    if (hit >= 0 && !This->crumb_tracking)
+    {
+        TRACKMOUSEEVENT tme = { sizeof(tme), TME_LEAVE, This->dlg_hwnd, 0 };
+        This->crumb_tracking = TrackMouseEvent(&tme);
+    }
+    return FALSE;
+}
+
+static LRESULT on_crumb_mouseleave(FileDialogImpl *This)
+{
+    This->crumb_tracking = FALSE;
+    neutron_set_crumb_hot(This, -1);
+    return FALSE;
+}
+
+static LRESULT on_crumb_lbuttondown(FileDialogImpl *This, LPARAM lparam)
+{
+    int hit = neutron_crumb_hit(This, (short)LOWORD(lparam), (short)HIWORD(lparam));
+
+    if (hit < 0) return FALSE;
+    This->crumb_pressed = hit;
+    SetCapture(This->dlg_hwnd);
+    neutron_set_crumb_hot(This, hit);
+    InvalidateRect(This->dlg_hwnd, &This->crumb_rects[hit], TRUE);
+    SetWindowLongPtrW(This->dlg_hwnd, DWLP_MSGRESULT, 0);
+    return TRUE;
+}
+
+static LRESULT on_crumb_lbuttonup(FileDialogImpl *This, LPARAM lparam)
+{
+    int pressed = This->crumb_pressed, hit;
+
+    if (pressed < 0) return FALSE;
+    This->crumb_pressed = -1;
+    if (GetCapture() == This->dlg_hwnd) ReleaseCapture();
+    hit = neutron_crumb_hit(This, (short)LOWORD(lparam), (short)HIWORD(lparam));
+    if ((UINT)pressed < This->crumb_count)
+        InvalidateRect(This->dlg_hwnd, &This->crumb_rects[pressed], TRUE);
+    if (hit == pressed) neutron_crumb_navigate(This, pressed);
+    SetWindowLongPtrW(This->dlg_hwnd, DWLP_MSGRESULT, 0);
+    return TRUE;
+}
+
+static LRESULT on_crumb_capturechanged(FileDialogImpl *This)
+{
+    int pressed = This->crumb_pressed;
+
+    if (pressed < 0) return FALSE;
+    This->crumb_pressed = -1;
+    if ((UINT)pressed < This->crumb_count)
+        InvalidateRect(This->dlg_hwnd, &This->crumb_rects[pressed], TRUE);
+    return FALSE;
+}
+
+static LRESULT on_crumb_setcursor(FileDialogImpl *This, WPARAM wparam, LPARAM lparam)
+{
+    POINT pt;
+
+    if ((HWND)wparam != This->dlg_hwnd || LOWORD(lparam) != HTCLIENT) return FALSE;
+    GetCursorPos(&pt);
+    ScreenToClient(This->dlg_hwnd, &pt);
+    if (neutron_crumb_hit(This, pt.x, pt.y) < 0) return FALSE;
+    SetCursor(LoadCursorW(NULL, (LPCWSTR)IDC_HAND));
+    SetWindowLongPtrW(This->dlg_hwnd, DWLP_MSGRESULT, TRUE);
+    return TRUE;
+}
+
+/*
+ * The nav arrows, drawn at the dialog's dpi.
+ *
+ * comctl32 draws a toolbar's standard bitmaps at their native 24px whatever the dpi, and
+ * top-anchors the image at padding/2 (3px) rather than centring it; TB_SETBUTTONSIZE is
+ * clamped to padding + bitmap (31x30) so at 96 dpi that happens to be centred. At the 163 dpi
+ * our prefixes run (LogPixels = round(96 * 1.7)) the requested 51x44 button wins the clamp, the
+ * 24px image stays where it was, and the arrows read as too small and too high -- exactly the
+ * operator's report. Rather than change the shared strip (every toolbar in every app draws it),
+ * this dialog paints its three glyphs itself, from the strip's own path data, scaled to the dpi
+ * and centred in the button.
+ *
+ * Path data is the 24-box design in build/art/gen_toolbar_icons.py (HIST_BACK, HIST_FORWARD,
+ * VIEW_PARENTFOLDER): stroke 2/24 of the cell, round caps and joins. Rendered 6x supersampled
+ * with a geometric pen, box-filtered to coverage and alpha-blended, so it is anti-aliased at
+ * any size without a second raster asset.
+ */
+struct neutron_stroke { float pt[3][2]; int n; };
+static const struct neutron_stroke neutron_nav_back[] =
+    { {{{17, 12}, {7, 12}}, 2}, {{{12, 7}, {7, 12}, {12, 17}}, 3} };
+static const struct neutron_stroke neutron_nav_forward[] =
+    { {{{7, 12}, {17, 12}}, 2}, {{{12, 7}, {17, 12}, {12, 17}}, 3} };
+static const struct neutron_stroke neutron_nav_up[] =
+    { {{{12, 19}, {12, 6}}, 2}, {{{6.5f, 11.5f}, {12, 6}, {17.5f, 11.5f}}, 3} };
+
+static void neutron_draw_nav_glyph(HDC hdc, const RECT *btn, const struct neutron_stroke *strokes,
+                                   int nstrokes, int cell, COLORREF color, BOOL disabled)
+{
+    enum { SS = 6 };                     /* supersample factor: 36 coverage levels */
+    const int big = cell * SS;
+    const float f = (float)big / NEUTRON_NAV_CELL;
+    BITMAPINFO big_bmi = {{ sizeof(BITMAPINFOHEADER), big, -big, 1, 32, BI_RGB }};
+    BITMAPINFO out_bmi = {{ sizeof(BITMAPINFOHEADER), cell, -cell, 1, 32, BI_RGB }};
+    DWORD *big_bits = NULL, *out_bits = NULL;
+    HBITMAP big_bmp = NULL, out_bmp = NULL, old_big, old_out;
+    HDC big_dc = NULL, out_dc = NULL;
+    LOGBRUSH lb = { BS_SOLID, RGB(255, 255, 255), 0 };
+    BLENDFUNCTION bf = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+    HPEN pen, old_pen;
+    int i, x, y, r = GetRValue(color), g = GetGValue(color), b = GetBValue(color);
+
+    if (cell <= 0) return;
+    if (!(big_dc = CreateCompatibleDC(hdc)) || !(out_dc = CreateCompatibleDC(hdc))) goto done;
+    if (!(big_bmp = CreateDIBSection(big_dc, &big_bmi, DIB_RGB_COLORS, (void **)&big_bits, NULL, 0)) ||
+        !(out_bmp = CreateDIBSection(out_dc, &out_bmi, DIB_RGB_COLORS, (void **)&out_bits, NULL, 0)))
+        goto done;
+    old_big = SelectObject(big_dc, big_bmp);
+    old_out = SelectObject(out_dc, out_bmp);
+    memset(big_bits, 0, (size_t)big * big * 4);
+
+    pen = ExtCreatePen(PS_GEOMETRIC | PS_SOLID | PS_ENDCAP_ROUND | PS_JOIN_ROUND,
+                       max(1, (int)(2.0f * f + 0.5f)), &lb, 0, NULL);
+    old_pen = SelectObject(big_dc, pen);
+    for (i = 0; i < nstrokes; i++)
+    {
+        POINT pt[3];
+        int k;
+        for (k = 0; k < strokes[i].n; k++)
+        {
+            pt[k].x = (int)(strokes[i].pt[k][0] * f + 0.5f);
+            pt[k].y = (int)(strokes[i].pt[k][1] * f + 0.5f);
+        }
+        Polyline(big_dc, pt, strokes[i].n);
+    }
+    SelectObject(big_dc, old_pen);
+    DeleteObject(pen);
+    GdiFlush();
+
+    /* box-filter to coverage; premultiply for AlphaBlend */
+    for (y = 0; y < cell; y++)
+        for (x = 0; x < cell; x++)
+        {
+            unsigned int sum = 0, a;
+            int sx, sy;
+            for (sy = 0; sy < SS; sy++)
+                for (sx = 0; sx < SS; sx++)
+                    sum += big_bits[(y * SS + sy) * big + x * SS + sx] & 0xff;
+            a = sum / (SS * SS);
+            if (disabled) a = a * 2 / 5;
+            out_bits[y * cell + x] = (a << 24) | ((r * a / 255) << 16) | ((g * a / 255) << 8) | (b * a / 255);
+        }
+
+    GdiAlphaBlend(hdc, btn->left + (btn->right - btn->left - cell) / 2,
+                  btn->top + (btn->bottom - btn->top - cell) / 2, cell, cell,
+                  out_dc, 0, 0, cell, cell, bf);
+
+    SelectObject(big_dc, old_big);
+    SelectObject(out_dc, old_out);
+done:
+    if (big_bmp) DeleteObject(big_bmp);
+    if (out_bmp) DeleteObject(out_bmp);
+    if (big_dc) DeleteDC(big_dc);
+    if (out_dc) DeleteDC(out_dc);
+}
