+    int crumb_hot, crumb_pressed;   /* segment index, or -1 */
+    BOOL crumb_tracking;        /* TrackMouseEvent(TME_LEAVE) armed on the dialog */
+    BOOL nav_glyph_reported;    /* NEUTRON_WL_DIAG: one metrics line per dialog, after the first draw */
