 }
 
+/*
+ * Kill switches, no rebuild needed:
+ *   NEUTRON_CRUMB_CLICK=0  the breadcrumb is static text again (no hover, no navigation)
+ *   NEUTRON_NAV_GLYPH=0    the nav arrows go back to comctl32's 24px standard bitmaps at their
+ *                          native size and the 30x26 button request
+ * NEUTRON_WL_DIAG=1 reports at the outcome: the HRESULT of each crumb navigation, and the nav
+ * button/glyph metrics once per dialog after the first glyph has been drawn.
+ */
+static BOOL neutron_env_on(const char *name, int *cache)
+{
+    if (*cache < 0)
+    {
+        const char *e = getenv(name);
+        *cache = e ? (e[0] != '0') : 1;
+        ERR("neutron-gateresolved: %s = %d (%s)\n", name, *cache, e ? "environment" : "default");
+    }
+    return *cache;
+}
+
+static BOOL neutron_crumb_click_on(void)
+{
+    static int on = -1;
+    return neutron_env_on("NEUTRON_CRUMB_CLICK", &on);
+}
+
+static BOOL neutron_nav_glyph_on(void)
+{
+    static int on = -1;
+    return neutron_env_on("NEUTRON_NAV_GLYPH", &on);
+}
+
+static BOOL neutron_wl_diag(void)
+{
+    static int v = -1;
+    if (v < 0) { const char *e = getenv("NEUTRON_WL_DIAG"); v = (e && e[0] == '1') ? 1 : 0; }
+    return v;
+}
+
 static void neutron_free_crumbs(FileDialogImpl *This)
 {
     UINT i;
-    for (i = 0; i < This->crumb_count; i++) CoTaskMemFree(This->crumbs[i]);
+    for (i = 0; i < This->crumb_count; i++)
+    {
+        CoTaskMemFree(This->crumbs[i]);
+        if (This->crumb_items && This->crumb_items[i]) IShellItem_Release(This->crumb_items[i]);
+    }
     free(This->crumbs);
+    free(This->crumb_items);
+    free(This->crumb_rects);
     This->crumbs = NULL;
+    This->crumb_items = NULL;
+    This->crumb_rects = NULL;
     This->crumb_count = 0;
+    This->crumb_hot = This->crumb_pressed = -1;
+}
+
+/* the rects are only as good as the last paint; a relayout empties them until the next one */
+static void neutron_reset_crumb_rects(FileDialogImpl *This)
+{
+    UINT i;
+    for (i = 0; This->crumb_rects && i < This->crumb_count; i++)
+        SetRectEmpty(&This->crumb_rects[i]);
 }
 
 /* Rebuild the breadcrumb from psi_folder: the folder and its filesystem ancestors, stopping
@@ -1850,6 +1913,7 @@
 static void neutron_update_crumbs(FileDialogImpl *This)
 {
     IShellItem *item, *parent, *grandparent;
+    IShellItem *items[64];
     LPWSTR names[64];
     UINT count = 0, i;
 
@@ -1874,7 +1938,11 @@
                 memmove(name, name + len - 3, 3 * sizeof(WCHAR));
             }
         }
-        names[count++] = name;
+        names[count] = name;
+        /* keep the folder itself: clicking the segment browses to it */
+        IShellItem_AddRef(item);
+        items[count] = item;
+        count++;
 
         if (FAILED(IShellItem_GetParent(item, &parent))) parent = NULL;
         IShellItem_Release(item);
@@ -1895,28 +1963,56 @@
     if (item) IShellItem_Release(item);
 
     if (!count) return;
-    if (!(This->crumbs = malloc(count * sizeof(*This->crumbs))))
-    {
-        for (i = 0; i < count; i++) CoTaskMemFree(names[i]);
+    This->crumbs = malloc(count * sizeof(*This->crumbs));
+    This->crumb_items = calloc(count, sizeof(*This->crumb_items));
+    This->crumb_rects = calloc(count, sizeof(*This->crumb_rects));
+    if (!This->crumbs || !This->crumb_items || !This->crumb_rects)
+    {
+        for (i = 0; i < count; i++)
+        {
+            CoTaskMemFree(names[i]);
