     void **ppv)
@@ -254,6 +326,13 @@ static HRESULT WINAPI BitmapImpl_QueryInterface(IWICBitmap *iface, REFIID iid,
     {
         *ppv = &This->IMILBitmap_iface;
     }
+    else if (IsEqualIID(&IID_INeutronWicGpuBitmap, iid))
+    {
+        /* NEUTRON: private, and deliberately only answered by Wine's own bitmap. A
