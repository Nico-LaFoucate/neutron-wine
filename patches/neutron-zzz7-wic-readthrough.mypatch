+#include "wine/neutron_wicgpu.h"
+
 WINE_DEFAULT_DEBUG_CHANNEL(wincodecs);
+WINE_DECLARE_DEBUG_CHANNEL(nwicgpu);
 
 /* WARNING: .NET Media Integration Layer (MIL) directly dereferences
  * BitmapImpl members and depends on its exact layout.
@@ -56,6 +59,14 @@ typedef struct BitmapImpl {
     WICPixelFormatGUID pixelformat;
     double dpix, dpiy;
     CRITICAL_SECTION cs;
+    /* NEUTRON: appended AFTER every field MIL knows about, so the layout the warning
+     * above protects is untouched. See wine/neutron_wicgpu.h for the whole rationale --
+     * in short, when Direct2D renders into this bitmap on the GPU it hands the mapping
+     * over instead of copying, and CopyPixels serves the app straight out of it. */
+    INeutronWicGpuBitmap INeutronWicGpuBitmap_iface;
+    const struct neutron_wicgpu_source *gpu_ops;    /* NULL => ordinary CPU bitmap */
+    void *gpu_ctx;
+    BOOL gpu_was_read;      /* diagnostic only: did anyone actually read this frame? */
 } BitmapImpl;
 
 typedef struct BitmapLockImpl {
@@ -119,6 +130,67 @@ static void BitmapImpl_ReleaseLock(BitmapImpl *This)
     }
 }
 
+/* ---- NEUTRON: pixels served straight from GPU-resident memory ---------------
+ * Rationale, measurements and the two safety rules live in wine/neutron_wicgpu.h.
+ * Everything here is a no-op unless a producer has attached a source, so an ordinary
+ * WIC bitmap is unaffected. */
+static LONG nwg_attached, nwg_served, nwg_declined, nwg_materialized, nwg_dropped_unread;
+
+static void neutron_wicgpu_report(void)
+{
+    LONG n = nwg_attached + nwg_served;
+
+    if (!TRACE_ON(nwicgpu)) return;
+    /* Powers of two, then every 512 -- a pure modulo prints nothing at all on a short
+     * run, which reads exactly like "the path never executed". */
+    if (n > 8 && (n & (n - 1)) && n % 512) return;
+    TRACE_(nwicgpu)("neutron-wicgpu: attached=%ld served=%ld declined=%ld materialized=%ld dropped_unread=%ld\n",
+            nwg_attached, nwg_served, nwg_declined, nwg_materialized, nwg_dropped_unread);
+}
+
+/* Give the source back without performing the deferred download. Only correct when the
+ * pixels are genuinely not wanted -- the caller is about to overwrite them all, or the
+ * bitmap is being destroyed. Caller holds This->cs (or owns the last reference). */
+static void bitmap_gpu_drop(BitmapImpl *This, BOOL count_waste)
+{
+    const struct neutron_wicgpu_source *ops = This->gpu_ops;
+    void *ctx = This->gpu_ctx;
+
+    if (!ops) return;
+    This->gpu_ops = NULL;
+    This->gpu_ctx = NULL;
+    /* Only a frame nobody ever read is waste. Counting every drop would count the
+     * ordinary read-then-redraw cycle as waste too, and the resulting number would look
+     * alarming while meaning nothing -- the same way an over-broad "orphan" count made
+     * 38% of downloads look wasted when the real figure was ~0. */
+    if (count_waste && !This->gpu_was_read) InterlockedIncrement(&nwg_dropped_unread);
+    This->gpu_was_read = FALSE;
+    ops->release(ctx);
+}
+
+/* Perform the download the producer deferred, into the bitmap's own buffer, and drop the
+ * source. After this the bitmap is an ordinary CPU bitmap again. Caller holds This->cs.
+ *
+ * A failure here would leave stale pixels rather than crash, so it is reported loudly and
+ * the source is still dropped -- staying attached to a mapping we cannot read would turn
+ * one bad frame into a permanently broken bitmap. */
+static void bitmap_gpu_materialize(BitmapImpl *This)
+{
+    const struct neutron_wicgpu_source *ops = This->gpu_ops;
+    void *ctx = This->gpu_ctx;
+    HRESULT hr;
+
+    if (!ops) return;
+    This->gpu_ops = NULL;
+    This->gpu_ctx = NULL;
+    This->gpu_was_read = TRUE;
+    InterlockedIncrement(&nwg_materialized);
+    if (FAILED(hr = ops->materialize(ctx, This->data, This->stride, This->height,
+            (This->bpp * This->width + 7) / 8)))
+        ERR("Failed to materialize deferred pixels, hr %#lx -- bitmap %p may show a stale frame.\n", hr, This);
+    ops->release(ctx);
+}
+
 
