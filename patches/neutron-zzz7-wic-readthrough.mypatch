         if (IsEqualIID(&IID_CMetaBitmapRenderTarget, iid))
@@ -287,6 +366,10 @@ static ULONG WINAPI BitmapImpl_Release(IWICBitmap *iface)
 
     if (ref == 0)
     {
+        /* NEUTRON: nobody will ever read these pixels, so give the mapping back without
+         * downloading it. Done before the critical section goes away, and without taking
+         * it -- we hold the last reference. */
+        bitmap_gpu_drop(This, TRUE);
         if (This->palette) IWICPalette_Release(This->palette);
         This->cs.DebugInfo->Spare[0] = 0;
         DeleteCriticalSection(&This->cs);
@@ -364,6 +447,44 @@ static HRESULT WINAPI BitmapImpl_CopyPixels(IWICBitmap *iface,
     BitmapImpl *This = impl_from_IWICBitmap(iface);
     TRACE("(%p,%s,%u,%u,%p)\n", iface, debug_wic_rect(prc), cbStride, cbBufferSize, pbBuffer);
 
+    /* NEUTRON: this is the copy the whole exercise exists to remove. If the pixels are
+     * still sitting in GPU-resident memory, hand them to the caller from there rather
+     * than downloading them into this bitmap first and copying again. The unlocked read
+     * of gpu_ops is a fast reject for the overwhelmingly common ordinary-bitmap case;
+     * the decision is re-made under the lock. */
+    if (This->gpu_ops)
+    {
+        HRESULT hr = S_FALSE;
+
+        EnterCriticalSection(&This->cs);
+        if (This->gpu_ops)
+        {
+            hr = This->gpu_ops->copy_pixels(This->gpu_ctx, This->bpp, This->width,
+                    This->height, prc, cbStride, cbBufferSize, pbBuffer);
+            if (hr == S_FALSE)
+            {
+                /* The producer cannot serve this shape. Pay the download once and fall
+                 * through; every later read comes from ordinary memory. Reported every
+                 * time rather than on a sampling boundary -- this is meant to be rare,
+                 * so if it is not, that is the finding. */
+                InterlockedIncrement(&nwg_declined);
+                bitmap_gpu_materialize(This);
+                if (TRACE_ON(nwicgpu))
+                    TRACE_(nwicgpu)("neutron-wicgpu: DECLINED bitmap %p %ux%u bpp=%u rect=%p "
+                            "dst_stride=%u (declined=%ld so far)\n", This, This->width,
+                            This->height, This->bpp, prc, cbStride, nwg_declined);
+            }
+            else
+            {
+                This->gpu_was_read = TRUE;
+                InterlockedIncrement(&nwg_served);
+                neutron_wicgpu_report();
+            }
+        }
+        LeaveCriticalSection(&This->cs);
+        if (hr != S_FALSE) return hr;
+    }
+
     return copy_pixels(This->bpp, This->data, This->width, This->height,
         This->stride, prc, cbStride, cbBufferSize, pbBuffer);
 }
@@ -398,6 +519,17 @@ static HRESULT WINAPI BitmapImpl_Lock(IWICBitmap *iface, const WICRect *prcLock,
         return E_FAIL;
     }
 
+    /* NEUTRON: a lock hands out a raw pointer into This->data, so anything still
+     * deferred has to be brought down into real memory first. Both directions need it:
+     * a reader would otherwise see the previous frame, and a writer is entitled to
+     * modify only part of the image and leave the rest intact. */
+    if (This->gpu_ops)
+    {
+        EnterCriticalSection(&This->cs);
+        bitmap_gpu_materialize(This);
+        LeaveCriticalSection(&This->cs);
+    }
+
     result = malloc(sizeof(BitmapLockImpl));
     if (!result)
         return E_OUTOFMEMORY;
@@ -465,6 +597,62 @@ static HRESULT WINAPI BitmapImpl_SetResolution(IWICBitmap *iface,
     return S_OK;
 }
 
+/* ---- NEUTRON: INeutronWicGpuBitmap ------------------------------------------
+ * Lifetime and refcount are the bitmap's; this is a view onto it, not an object. */
+static inline BitmapImpl *impl_from_INeutronWicGpuBitmap(INeutronWicGpuBitmap *iface)
+{
+    return CONTAINING_RECORD(iface, BitmapImpl, INeutronWicGpuBitmap_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE neutron_wicgpu_QueryInterface(INeutronWicGpuBitmap *iface,
+        REFIID iid, void **out)
+{
+    BitmapImpl *This = impl_from_INeutronWicGpuBitmap(iface);
+    return IWICBitmap_QueryInterface(&This->IWICBitmap_iface, iid, out);
+}
+
+static ULONG STDMETHODCALLTYPE neutron_wicgpu_AddRef(INeutronWicGpuBitmap *iface)
+{
+    BitmapImpl *This = impl_from_INeutronWicGpuBitmap(iface);
+    return IWICBitmap_AddRef(&This->IWICBitmap_iface);
+}
+
+static ULONG STDMETHODCALLTYPE neutron_wicgpu_Release(INeutronWicGpuBitmap *iface)
+{
+    BitmapImpl *This = impl_from_INeutronWicGpuBitmap(iface);
+    return IWICBitmap_Release(&This->IWICBitmap_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE neutron_wicgpu_SetSource(INeutronWicGpuBitmap *iface,
+        const struct neutron_wicgpu_source *ops, void *ctx)
+{
+    BitmapImpl *This = impl_from_INeutronWicGpuBitmap(iface);
+
+    EnterCriticalSection(&This->cs);
+    /* Whatever was attached is about to be superseded: the producer only calls this
+     * after rendering the WHOLE image, so the previous frame's pixels are dead and
+     * downloading them would be pure waste. */
+    bitmap_gpu_drop(This, TRUE);
+    This->gpu_ops = ops;
+    This->gpu_ctx = ctx;
+    LeaveCriticalSection(&This->cs);
+
+    if (ops)
+    {
+        InterlockedIncrement(&nwg_attached);
+        neutron_wicgpu_report();
+    }
+    return S_OK;
+}
+
+static const INeutronWicGpuBitmapVtbl neutron_wicgpu_vtbl =
+{
+    neutron_wicgpu_QueryInterface,
+    neutron_wicgpu_AddRef,
