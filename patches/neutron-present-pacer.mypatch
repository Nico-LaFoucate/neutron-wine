# neutron-present-pacer
#
# X11 software frame pacer in winex11.drv:X11DRV_client_surface_present (snap-to-next-refresh
# before the StretchBlt, per-monitor rate via xcb-randr, gated to active program-monitor playback,
# VRR-aware). Env-gated NEUTRON_PRESENT_PACE=1; quiet unless NEUTRON_PRESENT_DEBUG=1. X11-only
# best-effort (Wayland gets native pacing). Regenerated against the staging base. Touches:
# dlls/winex11.drv/{Makefile.in,init.c,neutron_pacer.c}.

diff --git a/dlls/winex11.drv/Makefile.in b/dlls/winex11.drv/Makefile.in
index b10be2c519b..ce3f18ef0b0 100644
--- a/dlls/winex11.drv/Makefile.in
+++ b/dlls/winex11.drv/Makefile.in
@@ -1,7 +1,7 @@
 MODULE    = winex11.drv
 UNIXLIB   = winex11.so
 UNIX_CFLAGS  = $(X_CFLAGS) $(XKBREGISTRY_CFLAGS)
-UNIX_LIBS    = -lwin32u $(X_LIBS) $(PTHREAD_LIBS) -lm
+UNIX_LIBS    = -lwin32u $(X_LIBS) $(PTHREAD_LIBS) -lm -lxcb -lxcb-randr
 
 VER_FILEDESCRIPTION_STR = "Wine X11 driver"
 
@@ -17,6 +17,7 @@ SOURCES = \
 	init.c \
 	keyboard.c \
 	mouse.c \
+	neutron_pacer.c \
 	opengl.c \
 	palette.c \
 	pen.c \
diff --git a/dlls/winex11.drv/init.c b/dlls/winex11.drv/init.c
index 09ef2bf8664..f43531743b3 100644
--- a/dlls/winex11.drv/init.c
+++ b/dlls/winex11.drv/init.c
@@ -26,6 +26,9 @@
 
 #include <stdarg.h>
 #include <string.h>
+#include <stdlib.h>    /* NEUTRON_PRESENT_TIMING (getenv/atoi) */
+#include <time.h>      /* NEUTRON_PRESENT_TIMING */
+#include <pthread.h>   /* NEUTRON_PRESENT_TIMING */
 
 #include "windef.h"
 #include "winbase.h"
@@ -38,6 +41,25 @@ WINE_DEFAULT_DEBUG_CHANNEL(x11drv);
 
 Display *gdi_display;  /* display to use for all GDI functions */
 
+/* NEUTRON_PRESENT_TIMING: shared state for the present-cadence + blit-duration probe */
+static pthread_mutex_t neutron_pt_lock = PTHREAD_MUTEX_INITIALIZER;
+static struct neutron_pt_slot { HWND hwnd; int w, h; ULONGLONG last_ns; unsigned long n;
+    double sum, sumsq, mn, mx; double bsum, bsumsq, bmn, bmx; ULONGLONG sched_ns;
+    ULONGLONG sched_base_ns; long sched_f; } neutron_pt[16];
+static ULONGLONG neutron_now_ns(void)
+{
+    struct timespec ts;
+    clock_gettime( CLOCK_MONOTONIC, &ts );
+    return (ULONGLONG)ts.tv_sec * 1000000000ull + ts.tv_nsec;
+}
+
+/* NEUTRON software pacer support (neutron_pacer.c, xcb-randr): precise refresh of the
+ * monitor the panel is on, and best-effort VRR detection. (True vblank phase-lock is not
+ * reachable for an X11 client under a compositor -- proven 2026-06-15 -- so the X11 path
+ * keeps the software grid pacer, just fed the real per-monitor rate and gated.) */
+extern double neutron_refresh_hz( unsigned long toplevel, int panel_cx, int panel_cy );
+extern int neutron_vrr_active( unsigned long toplevel, int panel_cx, int panel_cy );
+
 static int palette_size;
 
 static Pixmap stock_bitmap_pixmap;  /* phys bitmap for the default stock bitmap */
@@ -456,9 +478,166 @@ static void X11DRV_client_surface_present( struct client_surface *client, HDC hd
         set_dc_drawable( surface->hdc_dst, window, &rect_dst, IncludeInferiors );
     if (region) NtGdiExtSelectClipRgn( surface->hdc_dst, region, RGN_COPY );
 
-    NtGdiStretchBlt( surface->hdc_dst, 0, 0, rect_dst.right - rect_dst.left, rect_dst.bottom - rect_dst.top,
-                     surface->hdc_src, 0, 0, surface->rect.right, surface->rect.bottom, SRCCOPY, 0 );
-    XFlush( gdi_display );
+    /* NEUTRON_UXP_PRESENT_PROBE: read hdc_src for big UXP surfaces before the blit */
+    {
+        int _uw = surface->rect.right - surface->rect.left;
+        int _uh = surface->rect.bottom - surface->rect.top;
+        static LONG _uxp_n = 0;
+        if (_uw >= 1900 && _uh >= 900 && InterlockedIncrement(&_uxp_n) <= 12)
+        {
+            COLORREF _uc = NtGdiGetPixel( surface->hdc_src, _uw / 2, _uh / 2 );
+            COLORREF _uq = NtGdiGetPixel( surface->hdc_src, _uw / 4, _uh / 4 );
+            COLORREF _ue = NtGdiGetPixel( surface->hdc_src, _uw - 8, _uh - 8 );
+            ERR("NEUTRON_UXP_PRESENT_PROBE: hwnd %p offscreen %d src %dx%d dst_drawable %lx rect_dst (%ld,%ld)-(%ld,%ld) srcpix_c 0x%08x srcpix_q 0x%08x srcpix_e 0x%08x\n",
+                hwnd, (int)surface->client.offscreen, _uw, _uh,
+                (unsigned long)window, rect_dst.left, rect_dst.top, rect_dst.right, rect_dst.bottom,
+                (unsigned)_uc, (unsigned)_uq, (unsigned)_ue);
+        }
+    }
+    /* NEUTRON software frame pacer (X11 universal floor), env-gated by NEUTRON_PRESENT_PACE.
+     * True vblank back-pressure is unreachable for a Wine window under a compositor (proven
+     * 2026-06-15: Xwayland reports our present COPY complete instantly, no real vblank), so
+     * we keep the software grid pacer but HARDEN it:
+     *   - rate = the PRECISE refresh of the monitor the panel is on (xcb-randr), not 60;
+     *     override with NEUTRON_PRESENT_PACE=<hz> (>=24) for A/B.
+     *   - engage ONLY for the offscreen program monitor during ACTIVE playback (prev present
+     *     < 200ms) -> scrubbing/editing/UI keep the zero-latency blit, no added latency.
+     *   - SKIP when VRR is active (a fixed grid fights adaptive sync).
+     *   - NEUTRON_PRESENT_RATE=<fps> (optional) keeps the min-spacing 2:3 refinement.
+     * Caveat: this paces to a CLOCK_MONOTONIC grid, not the real vblank phase -> residual
+     * drift remains; true phase-lock is a winewayland.drv (wp_presentation) concern.
+     * Then time on-screen cadence (blit-to-blit) + blit duration, active only. */
+    {
+        int _w = surface->rect.right - surface->rect.left;
+        int _h = surface->rect.bottom - surface->rect.top;
+        ULONGLONG _now0 = neutron_now_ns(), _bstart, _bend, _target = 0;
+        int _i;
+        static int _pace_on = -1, _pace_force = 0;
+        static double _pace_rate = -1.0;
+        static int _dbg = -1;
+        ULONGLONG _last = 0;
+        int _engage;
+
+        if (_pace_on < 0)
+        {
+            const char *_pe = getenv( "NEUTRON_PRESENT_PACE" );
+            _pace_on = (_pe && atoi( _pe ) != 0) ? 1 : 0;
+            _pace_force = _pe ? atoi( _pe ) : 0;          /* >=24 => explicit-rate override */
+            const char *_re = getenv( "NEUTRON_PRESENT_RATE" ); _pace_rate = _re ? atof( _re ) : 0.0;
+            const char *_de = getenv( "NEUTRON_PRESENT_DEBUG" ); _dbg = (_de && atoi( _de )) ? 1 : 0;
+        }
+
+        pthread_mutex_lock( &neutron_pt_lock );
+        for (_i = 0; _i < 16; _i++) if (neutron_pt[_i].hwnd == hwnd) break;
+        if (_i == 16) { for (_i = 0; _i < 16; _i++)
+            if (!neutron_pt[_i].hwnd) { neutron_pt[_i].hwnd = hwnd;
+                neutron_pt[_i].mn = neutron_pt[_i].bmn = 1e30; break; } }
+        if (_i < 16) _last = neutron_pt[_i].last_ns;
+        pthread_mutex_unlock( &neutron_pt_lock );
+
+        /* gate: offscreen program monitor, actively playing */
+        _engage = _pace_on && surface->client.offscreen &&
+                  _last && (_now0 - _last) < 200000000ull && _i < 16;
+
+        if (_engage)
+        {
+            int _pw = rect_dst.right - rect_dst.left, _ph = rect_dst.bottom - rect_dst.top;
+            int _cx = rect_dst.left + _pw / 2, _cy = rect_dst.top + _ph / 2;
+            double _hz = _pace_force >= 24 ? (double)_pace_force
+                                           : neutron_refresh_hz( window, _cx, _cy );
+            /* VRR check, throttled (it's a server round-trip) */
+            static LONG _vc = 0; static int _vrr = 0;
+            if ((InterlockedIncrement(&_vc) & 0xff) == 1)
+                _vrr = neutron_vrr_active( window, _cx, _cy );
+
+            static LONG _pdbg = 0; LONG _pn = InterlockedIncrement(&_pdbg);
+            if (_dbg && (_pn <= 3 || (_pn % 240) == 0))
+                ERR( "NEUTRON_PACE_DBG: hwnd %p %dx%d hz %.3f vrr %d force %d engaged %d\n",
+                     hwnd, _pw, _ph, _hz, _vrr, _pace_force, (_hz > 1.0 && !_vrr) );
+
+            if (_hz > 1.0 && !_vrr)
+            {
+                ULONGLONG _rp = (ULONGLONG)(1000000000.0 / _hz);   /* refresh period */
+                if (_pace_rate > 0.0)
+                {
+                    /* GRID 2:3 scheduler: content frame N targets tick round(N*hz/content)
+                     * on a tick-aligned base -> deterministic 3-2-3-2 (no 1- or 4-refresh
+                     * holds). Re-anchor on a stall/seek gap or if the schedule slips >2
+                     * refreshes behind now, so drift can never accumulate a catch-up hold. */
+                    double _ratio = _hz / _pace_rate;              /* refresh ticks / frame */
+                    ULONGLONG _gap = _last ? (_now0 - _last) : 0;
+                    pthread_mutex_lock( &neutron_pt_lock );
+                    if (!neutron_pt[_i].sched_base_ns ||
+                        _gap > (ULONGLONG)(2.0 * 1000000000.0 / _pace_rate))
+                    {
+                        neutron_pt[_i].sched_base_ns = ((_now0 / _rp) + 1) * _rp;
+                        neutron_pt[_i].sched_f = 0;
+                    }
+                    else neutron_pt[_i].sched_f++;
+
+                    {
+                        ULONGLONG _off = (ULONGLONG)(neutron_pt[_i].sched_f * _ratio + 0.5);
+                        _target = neutron_pt[_i].sched_base_ns + _off * _rp;
+                        if (_now0 > _target + 2 * _rp)   /* slipped: resync to next tick */
+                        {
+                            neutron_pt[_i].sched_base_ns = ((_now0 / _rp) + 1) * _rp;
+                            neutron_pt[_i].sched_f = 0;
+                            _target = neutron_pt[_i].sched_base_ns;
+                        }
+                    }
+                    pthread_mutex_unlock( &neutron_pt_lock );
+                }
+                else _target = ((_now0 / _rp) + 1) * _rp;          /* simple snap (fallback) */
+            }
+        }
+
+        if (_target > _now0)
+        {
+            struct timespec _wts = { (time_t)(_target / 1000000000ull), (long)(_target % 1000000000ull) };
+            clock_nanosleep( CLOCK_MONOTONIC, TIMER_ABSTIME, &_wts, NULL );
+        }
+
+        _bstart = neutron_now_ns();
+        NtGdiStretchBlt( surface->hdc_dst, 0, 0, rect_dst.right - rect_dst.left, rect_dst.bottom - rect_dst.top,
+                         surface->hdc_src, 0, 0, surface->rect.right, surface->rect.bottom, SRCCOPY, 0 );
+        XFlush( gdi_display );
+        _bend = neutron_now_ns();
+
+        pthread_mutex_lock( &neutron_pt_lock );
+        if (_i < 16)
+        {
+            neutron_pt[_i].w = _w; neutron_pt[_i].h = _h;
+            if (neutron_pt[_i].last_ns)
+            {
+                double _dt = (double)(_bstart - neutron_pt[_i].last_ns) / 1000.0; /* us, blit-to-blit */
+                if (_dt < 200000.0)   /* active playback only */
+                {
+                    double _bdur = (double)(_bend - _bstart) / 1000.0;
+                    neutron_pt[_i].n++;
+                    neutron_pt[_i].sum += _dt; neutron_pt[_i].sumsq += _dt * _dt;
+                    if (_dt < neutron_pt[_i].mn) neutron_pt[_i].mn = _dt;
+                    if (_dt > neutron_pt[_i].mx) neutron_pt[_i].mx = _dt;
+                    neutron_pt[_i].bsum += _bdur;
+                    if (_bdur > neutron_pt[_i].bmx) neutron_pt[_i].bmx = _bdur;
+                    if (neutron_pt[_i].n >= 120)
+                    {
+                        double _im = neutron_pt[_i].sum / neutron_pt[_i].n;
+                        double _iv = neutron_pt[_i].sumsq / neutron_pt[_i].n - _im * _im;
+                        double _bm = neutron_pt[_i].bsum / neutron_pt[_i].n;
+                        if (_dbg) ERR( "NEUTRON_PRESENT_TIMING: hwnd %p %dx%d off %d pace %d force %d rate %.3f WINDOW n %lu | INTERVAL mean %.1f min %.1f max %.1f p2p %.1f var %.0f | BLIT mean %.1f max %.1f (us)\n",
+                             hwnd, _w, _h, (int)surface->client.offscreen, _pace_on, _pace_force, _pace_rate, neutron_pt[_i].n,
+                             _im, neutron_pt[_i].mn, neutron_pt[_i].mx, neutron_pt[_i].mx - neutron_pt[_i].mn, _iv,
+                             _bm, neutron_pt[_i].bmx );
+                        neutron_pt[_i].n = 0;
+                        neutron_pt[_i].sum = neutron_pt[_i].sumsq = 0; neutron_pt[_i].mn = 1e30; neutron_pt[_i].mx = 0;
+                        neutron_pt[_i].bsum = 0; neutron_pt[_i].bmx = 0;
+                    }
+                }
+            }
+            neutron_pt[_i].last_ns = _bstart;
+        }
+        pthread_mutex_unlock( &neutron_pt_lock );
+    }
 
 done:
     if (region) NtGdiDeleteObjectApp( region );
diff --git a/dlls/winex11.drv/neutron_pacer.c b/dlls/winex11.drv/neutron_pacer.c
new file mode 100644
index 00000000000..d25d278ce6b
--- /dev/null
+++ b/dlls/winex11.drv/neutron_pacer.c
@@ -0,0 +1,184 @@
+/*
+ * NEUTRON software frame-pacer support: per-monitor refresh + VRR query (xcb-randr).
+ *
+ * Background (proven 2026-06-15): true vblank back-pressure via the X Present extension
+ * is impossible for a Wine window under a compositing desktop -- Xwayland/any compositor
+ * redirects app windows and reports our present COPY complete instantly (no real vblank).
+ * So the X11 path keeps the *software* pacer (clock_nanosleep to a refresh-period grid in
+ * init.c) but hardens it: instead of a hardcoded 60 Hz, it asks here for the PRECISE rate
+ * of the monitor the program-monitor panel is actually on (these displays are 59.97 vs
+ * 59.98 Hz), and skips pacing when VRR is active (a fixed grid fights VRR). True phase-lock
+ * remains a winewayland.drv concern (wp_presentation). Owns its own xcb connection.
+ */
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stdlib.h>
+#include <string.h>
+#include <pthread.h>
+
+#include <xcb/xcb.h>
+#include <xcb/randr.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "x11drv.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(x11drv);
+
+/* prototypes match the externs in init.c */
+double neutron_refresh_hz( unsigned long toplevel, int panel_cx, int panel_cy );
+int neutron_vrr_active( unsigned long toplevel, int panel_cx, int panel_cy );
+
+static pthread_mutex_t rr_lock = PTHREAD_MUTEX_INITIALIZER;
+static int rr_inited;                 /* 0 untried, 1 ready, -1 disabled */
+static xcb_connection_t *rr_conn;
+static xcb_window_t rr_root;
+
+/* lock held */
+static int rr_init(void)
+{
+    const xcb_query_extension_reply_t *ext;
+    if (rr_inited) return rr_inited > 0;
+
+    rr_conn = xcb_connect( NULL, NULL );
+    if (!rr_conn || xcb_connection_has_error( rr_conn )) { rr_inited = -1; return 0; }
+    ext = xcb_get_extension_data( rr_conn, &xcb_randr_id );
+    if (!ext || !ext->present) { rr_inited = -1; return 0; }
+    rr_root = xcb_setup_roots_iterator( xcb_get_setup( rr_conn ) ).data->root;
+    rr_inited = 1;
+    return 1;
+}
+
+/* Translate the panel-center (toplevel coords) to root coords. Returns 0 on success. */
+static int rr_panel_root_point( unsigned long toplevel, int cx, int cy, int *rx, int *ry )
+{
+    xcb_translate_coordinates_reply_t *tr =
+        xcb_translate_coordinates_reply( rr_conn,
+            xcb_translate_coordinates( rr_conn, (xcb_window_t)toplevel, rr_root, cx, cy ), NULL );
+    if (!tr) return -1;
+    *rx = tr->dst_x; *ry = tr->dst_y; free( tr );
+    return 0;
+}
+
+/* Find the CRTC covering (rx,ry); fill its precise refresh and the crtc's first output.
+ * Returns refresh Hz (0 on failure). lock held. */
+static double rr_refresh_for_point( int rx, int ry, xcb_randr_output_t *out_first )
+{
+    xcb_randr_get_screen_resources_current_reply_t *res;
+    xcb_randr_crtc_t *crtcs;
+    xcb_randr_mode_info_t *modes;
+    int ncrtcs, nmodes, i, j;
+    double best = 0.0;
+
+    res = xcb_randr_get_screen_resources_current_reply( rr_conn,
+            xcb_randr_get_screen_resources_current( rr_conn, rr_root ), NULL );
+    if (!res) return 0.0;
+    crtcs  = xcb_randr_get_screen_resources_current_crtcs( res );
+    ncrtcs = xcb_randr_get_screen_resources_current_crtcs_length( res );
+    modes  = xcb_randr_get_screen_resources_current_modes( res );
+    nmodes = xcb_randr_get_screen_resources_current_modes_length( res );
+
+    for (i = 0; i < ncrtcs; i++)
+    {
+        xcb_randr_get_crtc_info_reply_t *ci = xcb_randr_get_crtc_info_reply( rr_conn,
+            xcb_randr_get_crtc_info( rr_conn, crtcs[i], res->config_timestamp ), NULL );
+        if (!ci) continue;
+        if (ci->mode && ci->width && ci->height &&
+            rx >= ci->x && rx < ci->x + ci->width &&
+            ry >= ci->y && ry < ci->y + ci->height)
+        {
+            for (j = 0; j < nmodes; j++)
+            {
+                if (modes[j].id == ci->mode && modes[j].htotal && modes[j].vtotal)
+                {
+                    double vt = modes[j].vtotal;
+                    /* interlaced doubles the field rate; doublescan halves the line rate */
+                    if (modes[j].mode_flags & XCB_RANDR_MODE_FLAG_INTERLACE) vt /= 2.0;
+                    if (modes[j].mode_flags & XCB_RANDR_MODE_FLAG_DOUBLE_SCAN) vt *= 2.0;
+                    best = (double)modes[j].dot_clock / ((double)modes[j].htotal * vt);
+                    break;
+                }
+            }
+            if (out_first)
+            {
+                xcb_randr_output_t *o = xcb_randr_get_crtc_info_outputs( ci );
+                int no = xcb_randr_get_crtc_info_outputs_length( ci );
+                *out_first = no > 0 ? o[0] : 0;
+            }
+            free( ci );
+            break;
+        }
+        free( ci );
+    }
+    free( res );
+    return best;
+}
+
+/* cache: refresh is stable; re-query occasionally to catch mode / monitor changes. */
+static double cached_hz;
+static unsigned cache_tick;
+
+double neutron_refresh_hz( unsigned long toplevel, int panel_cx, int panel_cy )
+{
+    double hz = 0.0;
+    int rx, ry;
+
+    pthread_mutex_lock( &rr_lock );
+    if (rr_init() && (!cached_hz || (cache_tick++ & 0xff) == 0))
+    {
+        if (!rr_panel_root_point( toplevel, panel_cx, panel_cy, &rx, &ry ))
+        {
+            double q = rr_refresh_for_point( rx, ry, NULL );
+            if (q > 1.0) cached_hz = q;
+        }
+    }
+    hz = cached_hz;
+    pthread_mutex_unlock( &rr_lock );
+    return hz;
+}
+
+/* Best-effort VRR detection: read the output's "VRR_ENABLED" property (KDE/Mutter set it
+ * on the output when adaptive sync is on). Absent/unreadable -> treat as not VRR.
+ * NOTE: VRR exposure over RandR/Xwayland is inconsistent across compositors; this is a
+ * conservative guard, not authoritative. */
+int neutron_vrr_active( unsigned long toplevel, int panel_cx, int panel_cy )
+{
+    int rx, ry, active = 0;
+    xcb_randr_output_t out = 0;
+    xcb_intern_atom_reply_t *atom;
+    xcb_randr_get_output_property_reply_t *prop;
+
+    pthread_mutex_lock( &rr_lock );
+    if (!rr_init()) { pthread_mutex_unlock( &rr_lock ); return 0; }
+    if (rr_panel_root_point( toplevel, panel_cx, panel_cy, &rx, &ry ))
+    { pthread_mutex_unlock( &rr_lock ); return 0; }
+    rr_refresh_for_point( rx, ry, &out );
+    if (!out) { pthread_mutex_unlock( &rr_lock ); return 0; }
+
+    atom = xcb_intern_atom_reply( rr_conn,
+        xcb_intern_atom( rr_conn, 1 /*only_if_exists*/, 11, "VRR_ENABLED" ), NULL );
+    if (atom)
+    {
+        if (atom->atom)
+        {
+            prop = xcb_randr_get_output_property_reply( rr_conn,
+                xcb_randr_get_output_property( rr_conn, out, atom->atom,
+                    XCB_ATOM_NONE, 0, 4, 0, 0 ), NULL );
+            if (prop)
+            {
+                int len = xcb_randr_get_output_property_data_length( prop );
+                uint8_t *d = xcb_randr_get_output_property_data( prop );
+                if (len >= 1 && d && d[0]) active = 1;
+                free( prop );
+            }
+        }
+        free( atom );
+    }
+    pthread_mutex_unlock( &rr_lock );
+    return active;
+}
