-                                       unsigned char def_char, int avg_width )
+                                       unsigned char def_char, int avg_width, int int_leading )
 {
     FT_Face face;
     int ascent = 0, il, el, width_bytes = 0, space_size, max_width = 0;
@@ -551,6 +551,10 @@
         il = 0;
     else if (!strcmp(face->family_name, "Fixedsys"))
         il = 3;
+    /* a strike shared by fonts of two resolutions can need two values (Windows' MS Sans Serif 29 px strike:
+     * 5 at 96 dpi, 6 at 120 dpi), so the command line may give it like the average width */
+    if (int_leading >= 0)
+        il = int_leading;
 
     /* Japanese System font has an external leading */
     if (!strcmp(face->family_name, "System") && enc == 932)
@@ -835,7 +839,8 @@
