--- a/dlls/win32u/freetype.c
+++ b/dlls/win32u/freetype.c
@@ -1016,6 +1016,23 @@
     free( This );
 }
 
+/* Neutron: MS Sans Serif ships Windows' six sizes per resolution (sserife.fon 13-37 px at 96 dpi, sseriff.fon
+ * 16-46 px at 120 dpi; Wine's had 13/16/20 and 16/20). Kill switch NEUTRON_MSSANS_STRIKES=0 leaves the new
+ * strikes (cells above 20 px) unregistered, i.e. the font selection of the old files. */
+static const WCHAR ms_sans_serifW[] = {'M','S',' ','S','a','n','s',' ','S','e','r','i','f',0};
+
+static BOOL neutron_mssans_strikes(void)
+{
+    static int on = -1;
+    if (on < 0)
+    {
+        const char *e = getenv( "NEUTRON_MSSANS_STRIKES" );
+        on = e ? (e[0] != '0') : 1;
+        if (!on) ERR( "neutron-gateresolved: NEUTRON_MSSANS_STRIKES = 0 (environment)\n" );
+    }
+    return on;
+}
+
 static int add_unix_face( const char *unix_name, const WCHAR *file, void *data_ptr, SIZE_T data_size,
                           DWORD face_index, DWORD flags, DWORD *num_faces )
 {
@@ -1033,6 +1050,14 @@
         unix_face_destroy( unix_face );
         return 0;
     }
+
+    if (!unix_face->scalable && unix_face->size.height > 20 && !wcsicmp( unix_face->family_name, ms_sans_serifW ) &&
+        !neutron_mssans_strikes())
+    {
+        if (num_faces) *num_faces = unix_face->num_faces;
+        unix_face_destroy( unix_face );
+        return 0;
+    }
 
     if (!HIWORD( flags )) flags |= ADDFONT_AA_FLAGS( default_aa_flags );
 
