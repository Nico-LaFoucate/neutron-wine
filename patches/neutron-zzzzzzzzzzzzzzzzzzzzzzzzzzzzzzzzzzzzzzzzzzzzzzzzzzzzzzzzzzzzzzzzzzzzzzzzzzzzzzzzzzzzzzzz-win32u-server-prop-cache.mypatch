     lparam_t             user_data;        /* user-specific data (GWLP_USERDATA) */
     data_size_t          extra_size;       /* number of extra bytes (cbWndExtra) */
-    unsigned int         __pad2;
+    unsigned int         prop_serial;      /* NEUTRON prop-cache: bumped on every change to the window's properties */
     char                 extra[];          /* extra bytes storage (offsets >= 0) */
 } window_shm_t;
 
@@ -2943,6 +2943,9 @@
