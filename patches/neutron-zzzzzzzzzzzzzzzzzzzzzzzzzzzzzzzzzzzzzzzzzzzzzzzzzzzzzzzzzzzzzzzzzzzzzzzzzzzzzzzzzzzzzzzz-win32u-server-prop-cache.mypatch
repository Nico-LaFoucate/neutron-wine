+/* NEUTRON prop-cache: publish that the window's properties changed. A process answers GetProp on its own windows from
+ * its copy of their properties (win32u) while this serial still matches the one its last own change returned, the
+ * way Windows reads the property list from the desktop heap instead of asking the kernel; a change made by any other
+ * process moves the serial and sends that process back to the server. */
+static unsigned int bump_prop_serial( struct window *win )
+{
+    unsigned int serial;
+
+    if (!win->shared) return 0;
+    if (!(serial = win->shared->prop_serial + 1)) serial = 1;
+    SHARED_WRITE_BEGIN( win->shared, window_shm_t )
+    {
+        shared->prop_serial = serial;
+    }
+    SHARED_WRITE_END;
+    return serial;
+}
+
 /* detach a window from its owner thread but keep the window around */
 static void detach_window_thread( struct window *win )
 {
@@ -808,6 +827,7 @@
         shared->instance        = win->instance;
         shared->user_data       = win->user_data;
         shared->extra_size      = extra_bytes;
+        shared->prop_serial     = 0;  /* NEUTRON prop-cache */
         memset( (void *)shared->extra, 0, extra_bytes );
     }
     SHARED_WRITE_END;
@@ -3269,10 +3289,23 @@
         if (atom)
         {
             set_property( win, atom, req->data, PROP_TYPE_STRING );
+            if (!get_error() && get_property( win, atom ) == req->data)
+            {
+                reply->atom = atom;
+                reply->prop_serial = bump_prop_serial( win );
+            }
             release_atom( table, atom );
         }
     }
-    else set_property( win, req->atom, req->data, PROP_TYPE_ATOM );
+    else
+    {
+        set_property( win, req->atom, req->data, PROP_TYPE_ATOM );
+        if (!get_error() && get_property( win, req->atom ) == req->data)
+        {
+            reply->atom = req->atom;
+            reply->prop_serial = bump_prop_serial( win );
+        }
+    }
 }
 
 
@@ -3286,7 +3319,9 @@
     if (win)
     {
         atom_t atom = name.len ? find_atom( table, &name ) : req->atom;
-        if (atom) reply->data = remove_property( win, atom );
+        int removed = 0;
+        if (atom) reply->data = remove_property( win, atom, &removed );
+        reply->prop_serial = removed ? bump_prop_serial( win ) : (win->shared ? win->shared->prop_serial : 0);
     }
 }
 
