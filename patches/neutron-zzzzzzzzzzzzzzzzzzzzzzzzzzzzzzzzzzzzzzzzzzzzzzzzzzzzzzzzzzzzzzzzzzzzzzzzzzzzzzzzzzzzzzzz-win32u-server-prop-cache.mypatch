+    atom_t         atom;          /* NEUTRON: the property's atom */
 @END
 
 
@@ -2953,6 +2956,7 @@
     VARARG(name,unicode_str);     /* property name */
 @REPLY
     lparam_t       data;          /* data stored in property */
+    unsigned int   prop_serial;   /* NEUTRON: the window's prop_serial after this call, 0 if not published */
 @END
 
 
