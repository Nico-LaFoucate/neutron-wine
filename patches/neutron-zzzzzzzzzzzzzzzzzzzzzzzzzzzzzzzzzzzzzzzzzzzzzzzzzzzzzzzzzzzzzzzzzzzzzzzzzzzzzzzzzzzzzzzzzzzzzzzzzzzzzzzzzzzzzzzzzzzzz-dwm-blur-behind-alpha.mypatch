--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -2908,6 +2908,20 @@
         window_surface_set_layered( new_surface, key, alpha_bits, 0 );
     }
 
+    /* NEUTRON dwm-alpha */
+    if (new_surface && new_surface != &dummy_surface)
+    {
+        WND *win = get_win_ptr( hwnd );
+        BOOL dwm_alpha = FALSE;
+
+        if (win && win != WND_OTHER_PROCESS && win != WND_DESKTOP)
+        {
+            dwm_alpha = win->dwm_alpha;
+            release_win_ptr( win );
+        }
+        window_surface_set_dwm_alpha( new_surface, dwm_alpha );
+    }
+
     return new_surface;
 }
 
@@ -7655,6 +7669,32 @@
     }
 }
 
+/* NEUTRON dwm-alpha: DwmEnableBlurBehindWindow. Windows' compositor then blends the window with its
+ * pixels' alpha (a GPU-drawn translucent window, Qt's "translucent background" for OpenGL/Direct3D
+ * windows, relies on it); the window stays hit-tested as a whole. The flag lives on the window and
+ * is copied to each of its surfaces, which the driver reads when it flushes. */
+static BOOL set_window_dwm_alpha( HWND hwnd, BOOL enable )
+{
+    struct window_surface *surface = NULL;
+    WND *win = get_win_ptr( hwnd );
+
+    if (!win || win == WND_DESKTOP) return FALSE;
+    if (win == WND_OTHER_PROCESS)
+    {
+        FIXME( "not supported on other process window %p\n", hwnd );
+        return FALSE;
+    }
+    win->dwm_alpha = enable;
+    if ((surface = win->surface)) window_surface_add_ref( surface );
+    release_win_ptr( win );
+    if (surface)
+    {
+        window_surface_set_dwm_alpha( surface, enable );
+        window_surface_release( surface );
+    }
+    return TRUE;
+}
+
 /*****************************************************************************
  *           NtUserCallHwndParam (win32u.@)
  */
@@ -7787,6 +7827,9 @@
         return get_window_long_size( hwnd, params->offset, params->size, FALSE, TRUE );
     }
 
+    case NtUserCallHwndParam_SetDwmAlpha: /* NEUTRON dwm-alpha */
+        return set_window_dwm_alpha( hwnd, !!param );
+
     case NtUserCallHwndParam_SetPrivateData:
     {
         struct set_private_data_params *params = (void *)param;
