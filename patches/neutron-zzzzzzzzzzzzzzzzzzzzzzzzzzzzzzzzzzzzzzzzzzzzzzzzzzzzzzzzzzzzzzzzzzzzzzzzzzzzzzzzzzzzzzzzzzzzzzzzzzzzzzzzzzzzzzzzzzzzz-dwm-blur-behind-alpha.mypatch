     }
 
-    buffer_format = (shape_bits || wws->layered) ? WL_SHM_FORMAT_ARGB8888 : WL_SHM_FORMAT_XRGB8888;
+    buffer_format = (shape_bits || wws->layered || window_surface->dwm_alpha) ?
+                    WL_SHM_FORMAT_ARGB8888 : WL_SHM_FORMAT_XRGB8888;
     if (wws->wayland_buffer_queue->format != buffer_format)
     {
         int width = wws->wayland_buffer_queue->width;
@@ -772,6 +773,16 @@
             if (xo < 0) { const char *e = getenv("NEUTRON_XRGB_OPAQUE"); xo = !(e && e[0] == '0'); }
             alpha_bits = (shape_bits || xo) ? 0xff000000 : 0;
         }
+        /* NEUTRON dwm-alpha: DwmEnableBlurBehindWindow -- the compositor blends the window with its
+         * pixels' alpha (Windows does the same). A GPU-drawn translucent window (Qt) leaves its window
+         * surface unpainted, so it must come out transparent, not black, under the GPU content. GDI
+         * pixels (alpha 0 with a color) stay opaque, as for per-pixel layered windows; a constant
+         * layered alpha below 255 is not applied on top. */
+        if (window_surface->dwm_alpha)
+        {
+            alpha_bits = 0;
+            sanitize = TRUE;
+        }
         {   /* NEUTRON layer-trace (NEUTRON_LAYER_TRACE=1)
              *
              * ⛔ NEVER CALL WIN32U FROM IN HERE. THIS TRACE DEADLOCKED PHOTOSHOP (2026-09-09).
--- a/include/ntuser.h
+++ b/include/ntuser.h
@@ -1421,6 +1421,7 @@
