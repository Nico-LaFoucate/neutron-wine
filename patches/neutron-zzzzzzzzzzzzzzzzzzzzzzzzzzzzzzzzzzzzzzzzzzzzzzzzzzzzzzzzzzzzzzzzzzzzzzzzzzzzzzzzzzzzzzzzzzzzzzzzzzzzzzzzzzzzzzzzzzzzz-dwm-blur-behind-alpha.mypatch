     NtUserCallHwndParam_SetPrivateData,
     NtUserCallHwndParam_SetWinMonitor, /* NEUTRON: driver sets a window's authoritative monitor */
+    NtUserCallHwndParam_SetDwmAlpha,   /* NEUTRON dwm-alpha: DwmEnableBlurBehindWindow */
 };
 
