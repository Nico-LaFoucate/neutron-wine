+cl_int WINAPI clGetMemObjectInfo( cl_mem memobj, cl_mem_info name, size_t size, void *value, size_t *ret_size )
+{
+    struct clGetMemObjectInfo_params params = { memobj, name, size, value, ret_size };
+    cl_int ret;
+
+    TRACE( "(%p, %u, %Iu, %p, %p)\n", memobj, name, size, value, ret_size );
+
+    if (d3d11_get_mem_info( memobj, name, size, value, ret_size, &ret )) return ret;
+    return OPENCL_CALL( clGetMemObjectInfo, &params );
+}
