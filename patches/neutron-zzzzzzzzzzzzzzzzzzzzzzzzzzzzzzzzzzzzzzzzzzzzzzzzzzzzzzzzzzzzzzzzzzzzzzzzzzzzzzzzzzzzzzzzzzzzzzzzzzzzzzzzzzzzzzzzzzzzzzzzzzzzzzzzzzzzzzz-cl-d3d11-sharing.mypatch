+cl_int WINAPI clReleaseContext( cl_context context )
+{
+    struct clReleaseContext_params params = { context };
+    cl_int ret;
+
+    TRACE( "(%p)\n", context );
+
+    if (!(ret = OPENCL_CALL( clReleaseContext, &params ))) d3d11_context_released( context );
+    return ret;
+}
