+
+
+cl_context WINAPI clCreateContextFromType( const cl_context_properties *properties, cl_device_type device_type,
+        void (WINAPI *pfn_notify)(const char *errinfo, const void *private_info, size_t cb, void *user_data),
+        void *user_data, cl_int *errcode_ret )
+{
+    TRACE( "(%p, %s, %p, %p, %p)\n", properties, wine_dbgstr_longlong(device_type), pfn_notify, user_data, errcode_ret );
+    return d3d11_create_context( properties, 0, NULL, device_type, TRUE, pfn_notify, user_data, errcode_ret );
+}
