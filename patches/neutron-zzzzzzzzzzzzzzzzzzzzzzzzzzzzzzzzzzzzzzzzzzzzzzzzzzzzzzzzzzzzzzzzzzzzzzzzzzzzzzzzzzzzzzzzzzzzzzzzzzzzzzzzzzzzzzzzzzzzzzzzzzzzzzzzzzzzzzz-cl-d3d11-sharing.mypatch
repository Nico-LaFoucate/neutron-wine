+cl_int WINAPI clReleaseMemObject( cl_mem memobj )
+{
+    struct clReleaseMemObject_params params = { memobj };
+    cl_int ret;
+
+    TRACE( "(%p)\n", memobj );
+
+    if (!(ret = OPENCL_CALL( clReleaseMemObject, &params ))) d3d11_mem_released( memobj );
+    return ret;
+}
