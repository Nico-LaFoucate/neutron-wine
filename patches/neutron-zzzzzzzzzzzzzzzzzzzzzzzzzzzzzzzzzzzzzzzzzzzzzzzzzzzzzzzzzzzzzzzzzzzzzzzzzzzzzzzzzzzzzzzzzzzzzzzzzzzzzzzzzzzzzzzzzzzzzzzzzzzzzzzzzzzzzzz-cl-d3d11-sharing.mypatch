+cl_context WINAPI clCreateContext( const cl_context_properties *properties, cl_uint num_devices,
+        const cl_device_id *devices, void (WINAPI *pfn_notify)(const char *errinfo, const void *private_info,
+        size_t cb, void *user_data), void *user_data, cl_int *errcode_ret )
