-#define SERVER_PROTOCOL_VERSION 947
+#define SERVER_PROTOCOL_VERSION 948
 
 #endif /* __WINE_WINE_SERVER_PROTOCOL_H */
--- a/server/event.c
+++ b/server/event.c
@@ -392,6 +392,8 @@
         else
             reply->handle = alloc_handle_no_access_check( current->process, event,
                                                           req->access, objattr->attributes );
+        if (req->send_inproc_fd && reply->handle)  /* NEUTRON: see send_new_inproc_sync_fd() */
+            reply->inproc_type = send_new_inproc_sync_fd( &event->obj, reply->handle, &reply->inproc_access );
         release_object( event );
     }
 
--- a/server/inproc_sync.c
+++ b/server/inproc_sync.c
@@ -290,6 +290,21 @@
 
 #endif /* NTSYNC_IOC_EVENT_READ */
 
+/* NEUTRON: send a just-created object's in-process sync fd along with the create reply and return its type (0 if it
+ * has none). On Windows, creating an event, mutex or semaphore never leaves the kernel; here the handle comes from the
+ * server, and the client then fetched the fd with a second request (get_inproc_sync_fd) on first use. Illustrator's
+ * color engine creates ~23k semaphores per new document, so that second round trip per object showed up on the critical
+ * path. Same fd and access as get_inproc_sync_fd would report. */
+int send_new_inproc_sync_fd( struct object *obj, obj_handle_t handle, unsigned int *access )
+{
+    int type = 0, fd;
+
+    if (!handle || (fd = get_obj_inproc_sync( obj, &type )) < 0) return 0;
+    *access = get_handle_access( current->process, handle );
+    send_client_fd( current->process, fd, handle );
+    return type;
+}
+
 DECL_HANDLER(get_inproc_sync_fd)
 {
     struct object *obj;
--- a/server/mutex.c
+++ b/server/mutex.c
@@ -295,6 +295,8 @@
         else
             reply->handle = alloc_handle_no_access_check( current->process, mutex,
                                                           req->access, objattr->attributes );
+        if (req->send_inproc_fd && reply->handle)  /* NEUTRON: see send_new_inproc_sync_fd() */
+            reply->inproc_type = send_new_inproc_sync_fd( &mutex->obj, reply->handle, &reply->inproc_access );
         release_object( mutex );
     }
 
