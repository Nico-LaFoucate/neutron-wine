ntdll, server: send a new event/mutex/semaphore's in-process sync fd with the create reply

On Windows, creating an event, mutex or semaphore never leaves the kernel. Here the handle comes from the wineserver, and the
client then fetched the object's ntsync fd with a second request (get_inproc_sync_fd) the first time it waited on or signaled
it. Illustrator makes a new document with Adobe Color Engine's thread pool, whose coordinator thread creates ~23k semaphores
per document: 3 wineserver round trips each (create, fetch, close), ~69k blocking requests on the path the main thread waits
for (lab trace, 2025 and 2026). The create request now asks for the fd and the reply carries it, so it is cached at once.
Measured (Illustrator 2025, lab, same binary, NEUTRON_SYNC_FD_ON_CREATE on vs off, 3 docs each): the coordinator's
voluntary switches 112-114k vs 134-138k per document, the artboard centered 0.12-0.19 s earlier. Protocol 948.
What stays: create and close are still one round trip each; Windows needs none.
Kill switch NEUTRON_SYNC_FD_ON_CREATE=0 (the fd is fetched on first use, as before).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -773,6 +773,34 @@
     }
 }
 
+/* NEUTRON: ask the server to send a new event/mutex/semaphore's in-process sync fd with the create reply and cache it at
+ * once, instead of fetching it with a second request (get_inproc_sync_fd) on first use. On Windows, creating these never
+ * leaves the kernel; Illustrator's color engine creates ~23k semaphores per new document, so the second round trip per
+ * object was on the critical path. NEUTRON_SYNC_FD_ON_CREATE=0 restores the fetch on first use. */
+static BOOL neutron_sync_fd_on_create(void)
+{
+    static int on = -1;
+    if (on < 0) { const char *e = getenv( "NEUTRON_SYNC_FD_ON_CREATE" ); on = !(e && e[0] == '0'); }
+    return on;
+}
+
+/* caller must hold fd_cache_mutex: the fd was sent with the create reply and is next on the fd socket */
+static void cache_new_inproc_sync( HANDLE handle, int type, unsigned int access )
+{
+    struct inproc_sync stack, *sync;
+    obj_handle_t fd_handle;
+
+    stack.fd = wine_server_receive_fd( &fd_handle );
+    assert( wine_server_ptr_handle(fd_handle) == handle );
+    stack.refcount = 1;
+    stack.access = access;
+    stack.type = type;
+    stack.closed = 0;
+    /* drop the caller's reference: the cache keeps the handle's, or the fd is closed if it could not be cached */
+    sync = cache_inproc_sync( handle, &stack );
+    release_inproc_sync( sync );
+}
+
 static NTSTATUS inproc_release_semaphore( HANDLE handle, ULONG count, ULONG *prev_count )
 {
     struct inproc_sync stack, *sync;
@@ -968,6 +996,8 @@
     unsigned int ret;
     data_size_t len;
     struct object_attributes *objattr;
+    BOOL send_fd = inproc_device_fd >= 0 && neutron_sync_fd_on_create();
+    sigset_t sigset;
 
     TRACE( "access %#x, name %s, initial %d, max %d\n", access,
            attr ? debugstr_us(attr->ObjectName) : "(null)", initial, max );
@@ -976,16 +1006,20 @@
     if (max <= 0 || initial < 0 || initial > max) return STATUS_INVALID_PARAMETER;
     if ((ret = alloc_object_attributes( attr, &objattr, &len ))) return ret;
 
+    if (send_fd) server_enter_uninterrupted_section( &fd_cache_mutex, &sigset );
     SERVER_START_REQ( create_semaphore )
     {
         req->access  = access;
         req->initial = initial;
         req->max     = max;
         wine_server_add_data( req, objattr, len );
+        req->send_inproc_fd = send_fd;
         ret = wine_server_call( req );
         *handle = wine_server_ptr_handle( reply->handle );
+        if (reply->inproc_type) cache_new_inproc_sync( *handle, reply->inproc_type, reply->inproc_access );
     }
     SERVER_END_REQ;
+    if (send_fd) server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
 
     free( objattr );
     return ret;
@@ -1094,6 +1128,8 @@
     unsigned int ret;
     data_size_t len;
     struct object_attributes *objattr;
+    BOOL send_fd = inproc_device_fd >= 0 && neutron_sync_fd_on_create();
+    sigset_t sigset;
 
     TRACE( "access %#x, name %s, type %u, state %u\n", access,
            attr ? debugstr_us(attr->ObjectName) : "(null)", type, state );
@@ -1102,16 +1138,20 @@
     if (type != NotificationEvent && type != SynchronizationEvent) return STATUS_INVALID_PARAMETER;
     if ((ret = alloc_object_attributes( attr, &objattr, &len ))) return ret;
 
+    if (send_fd) server_enter_uninterrupted_section( &fd_cache_mutex, &sigset );
     SERVER_START_REQ( create_event )
     {
         req->access = access;
         req->manual_reset = (type == NotificationEvent);
         req->initial_state = state;
         wine_server_add_data( req, objattr, len );
+        req->send_inproc_fd = send_fd;
         ret = wine_server_call( req );
         *handle = wine_server_ptr_handle( reply->handle );
+        if (reply->inproc_type) cache_new_inproc_sync( *handle, reply->inproc_type, reply->inproc_access );
     }
     SERVER_END_REQ;
+    if (send_fd) server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
 
     free( objattr );
     return ret;
@@ -1285,6 +1325,8 @@
     unsigned int ret;
     data_size_t len;
     struct object_attributes *objattr;
+    BOOL send_fd = inproc_device_fd >= 0 && neutron_sync_fd_on_create();
+    sigset_t sigset;
 
     TRACE( "access %#x, name %s, owned %u\n", access,
            attr ? debugstr_us(attr->ObjectName) : "(null)", owned );
@@ -1292,15 +1334,19 @@
     *handle = 0;
     if ((ret = alloc_object_attributes( attr, &objattr, &len ))) return ret;
 
+    if (send_fd) server_enter_uninterrupted_section( &fd_cache_mutex, &sigset );
     SERVER_START_REQ( create_mutex )
     {
         req->access  = access;
         req->owned   = owned;
         wine_server_add_data( req, objattr, len );
+        req->send_inproc_fd = send_fd;
         ret = wine_server_call( req );
         *handle = wine_server_ptr_handle( reply->handle );
+        if (reply->inproc_type) cache_new_inproc_sync( *handle, reply->inproc_type, reply->inproc_access );
     }
     SERVER_END_REQ;
+    if (send_fd) server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
 
     free( objattr );
     return ret;
