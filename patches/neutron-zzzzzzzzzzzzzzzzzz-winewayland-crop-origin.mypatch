 /**********************************************************************
+ *          wayland_surface_content_origin
+ *
+ * NEUTRON: the window position of surface-local (0,0). The frame-spill crop (wayland_surface_attach_shm) shows a
+ * window that hangs off its monitor -- a maximized Premiere's 3850x2114 rect at (-5,51) -- from an inner origin, so
+ * surface-local (0,0) is window (5,0), not (0,0). Measured 2026-10-13: GPU child windows (Premiere's Program
+ * Monitor) were placed 5 device px right of where they belong, leaving their first 5 columns unpainted (a black
+ * line), and pointer input landed 5 px left of the pointer (ptrcheck "overhang0": crosshair left of the pointer at
+ * every position; the operator saw it too). Add this when converting a surface-local position to the window,
+ * subtract it the other way. Kill switch NEUTRON_CROP_ORIGIN=0.
+ */
+void wayland_surface_content_origin(struct wayland_surface *surface, int *x, int *y)
+{
+    static int on = -1;
+
+    if (on < 0) on = neutron_gate("NEUTRON_CROP_ORIGIN", TRUE);
+    *x = on ? surface->content_x : 0;
+    *y = on ? surface->content_y : 0;
+}
+
+/**********************************************************************
  *          wayland_surface_coords_to_window
  *
  * Converts the surface-local coordinates to window (logical) coordinates.
