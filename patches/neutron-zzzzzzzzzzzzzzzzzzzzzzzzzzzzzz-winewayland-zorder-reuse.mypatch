+/* NEUTRON zgen (2026-10-15): bumped whenever the Win32 stacking that the subsurface mirror follows can have changed:
+ * a z-order move, a show or hide, a destroy, a style change, a client (GPU) surface attached or (re)created. The
+ * mirror's tree walk is reused while it is unchanged (wayland_surface.c, neutron_zorder_get). */
+extern LONG neutron_zorder_generation;
+static inline void neutron_zorder_changed(void) { InterlockedIncrement(&neutron_zorder_generation); }
 BOOL neutron_workarea_save_output(const char *name, int logical_h);
 void wayland_report_output_maximized_h(uint32_t output_id, int logical_h);
 BOOL wayland_surface_config_is_compatible(struct wayland_surface_config *conf,
