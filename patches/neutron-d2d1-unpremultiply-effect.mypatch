+        ID2D1Image *source;
+
+        if (!(source = d2d_effect_image_get_source(image)))
+            break;
+        image = source;
+    }
+
     if (context->target.type == D2D_TARGET_COMMAND_LIST)
     {
         d2d_command_list_draw_image(context->target.command_list, image, target_offset, image_rect,
