+static HRESULT WINAPI playback_item_get_Source( IMediaPlaybackItem *iface, IMediaSource2 **value )
+{
+    struct playback_item *impl = impl_from_IMediaPlaybackItem( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if ((*value = impl->source)) IMediaSource2_AddRef( *value );
+    return S_OK;
+}
