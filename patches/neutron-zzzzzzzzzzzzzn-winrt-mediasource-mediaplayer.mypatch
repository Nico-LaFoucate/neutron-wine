+static HRESULT WINAPI media_player3_get_AudioBalance( IMediaPlayer3 *iface, DOUBLE *value )
+{
+    struct media_player *impl = impl_from_IMediaPlayer3( iface );
+
+    EnterCriticalSection( &impl->cs );
+    *value = impl->balance;
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI media_player3_put_AudioBalance( IMediaPlayer3 *iface, DOUBLE value )
+{
+    struct media_player *impl = impl_from_IMediaPlayer3( iface );
+    IMFMediaEngineEx *engine_ex;
+
+    TRACE( "iface %p, value %f.\n", iface, value );
+
+    EnterCriticalSection( &impl->cs );
+    impl->balance = value;
+    if (impl->engine && SUCCEEDED(IMFMediaEngine_QueryInterface( impl->engine, &IID_IMFMediaEngineEx, (void **)&engine_ex )))
+    {
+        IMFMediaEngineEx_SetBalance( engine_ex, value );
+        IMFMediaEngineEx_Release( engine_ex );
+    }
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
