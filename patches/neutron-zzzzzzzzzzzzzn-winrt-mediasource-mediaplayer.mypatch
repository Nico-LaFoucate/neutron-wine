+/* Called by the media engine (see the threading note at the top): record and queue only. */
+static void media_player_on_engine_event( struct media_player *impl, IMFMediaEngine *engine,
+                                          DWORD event, DWORD_PTR param1, DWORD param2 )
+{
+    switch (event)
+    {
+    case MF_MEDIA_ENGINE_EVENT_LOADSTART:
+        media_player_set_state( impl, MediaPlaybackState_Opening );
+        break;
+    case MF_MEDIA_ENGINE_EVENT_LOADEDMETADATA:
