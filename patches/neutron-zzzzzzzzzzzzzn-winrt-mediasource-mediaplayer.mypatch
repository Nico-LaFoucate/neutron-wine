+static const struct IAsyncInfoVtbl adaptive_operation_info_vtbl =
+{
+    adaptive_operation_info_QueryInterface,
+    adaptive_operation_info_AddRef,
+    adaptive_operation_info_Release,
+    adaptive_operation_info_GetIids,
+    adaptive_operation_info_GetRuntimeClassName,
+    adaptive_operation_info_GetTrustLevel,
+    adaptive_operation_info_get_Id,
+    adaptive_operation_info_get_Status,
+    adaptive_operation_info_get_ErrorCode,
+    adaptive_operation_info_Cancel,
+    adaptive_operation_info_Close,
+};
+
+static HRESULT adaptive_operation_create( AdaptiveMediaSourceCreationStatus status, HRESULT error,
+                                          IAsyncOperation_AdaptiveMediaSourceCreationResult **out )
+{
+    struct adaptive_operation *impl;
+    struct adaptive_result *result;
+
+    if (!(result = calloc( 1, sizeof(*result) ))) return E_OUTOFMEMORY;
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+    {
+        free( result );
+        return E_OUTOFMEMORY;
+    }
+    result->IAdaptiveMediaSourceCreationResult_iface.lpVtbl = &adaptive_result_vtbl;
+    result->IAdaptiveMediaSourceCreationResult2_iface.lpVtbl = &adaptive_result2_vtbl;
+    result->ref = 1;
+    result->status = status;
+    result->error = error;
+
+    impl->IAsyncOperation_AdaptiveMediaSourceCreationResult_iface.lpVtbl = &adaptive_operation_vtbl;
+    impl->IAsyncInfo_iface.lpVtbl = &adaptive_operation_info_vtbl;
+    impl->ref = 1;
+    impl->result = &result->IAdaptiveMediaSourceCreationResult_iface;
+    *out = &impl->IAsyncOperation_AdaptiveMediaSourceCreationResult_iface;
+    return S_OK;
+}
+
+struct adaptive_statics
+{
+    IActivationFactory IActivationFactory_iface;
