+DEFINE_IINSPECTABLE( adaptive_result2, IAdaptiveMediaSourceCreationResult2, struct adaptive_result,
+                     IAdaptiveMediaSourceCreationResult_iface )
+
+static HRESULT WINAPI adaptive_result2_get_ExtendedError( IAdaptiveMediaSourceCreationResult2 *iface, HRESULT *value )
+{
+    *value = impl_from_IAdaptiveMediaSourceCreationResult2( iface )->error;
+    return S_OK;
+}
+
+static const struct IAdaptiveMediaSourceCreationResult2Vtbl adaptive_result2_vtbl =
+{
+    adaptive_result2_QueryInterface,
+    adaptive_result2_AddRef,
+    adaptive_result2_Release,
+    adaptive_result2_GetIids,
+    adaptive_result2_GetRuntimeClassName,
+    adaptive_result2_GetTrustLevel,
+    adaptive_result2_get_ExtendedError,
+};
+
+/* IAsyncOperation<AdaptiveMediaSourceCreationResult>, already complete */
+
+struct adaptive_operation
+{
+    IAsyncOperation_AdaptiveMediaSourceCreationResult IAsyncOperation_AdaptiveMediaSourceCreationResult_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    IAsyncOperationCompletedHandler_AdaptiveMediaSourceCreationResult *handler;
+    IAdaptiveMediaSourceCreationResult *result;
+};
+
+static inline struct adaptive_operation *impl_from_IAsyncOperation_AdaptiveMediaSourceCreationResult(
+        IAsyncOperation_AdaptiveMediaSourceCreationResult *iface )
+{
+    return CONTAINING_RECORD( iface, struct adaptive_operation, IAsyncOperation_AdaptiveMediaSourceCreationResult_iface );
+}
+
+static HRESULT WINAPI adaptive_operation_QueryInterface( IAsyncOperation_AdaptiveMediaSourceCreationResult *iface,
+                                                         REFIID iid, void **out )
+{
+    struct adaptive_operation *impl = impl_from_IAsyncOperation_AdaptiveMediaSourceCreationResult( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IAsyncOperation_AdaptiveMediaSourceCreationResult ))
+        *out = &impl->IAsyncOperation_AdaptiveMediaSourceCreationResult_iface;
+    else if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+        *out = &impl->IAsyncInfo_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI adaptive_operation_AddRef( IAsyncOperation_AdaptiveMediaSourceCreationResult *iface )
+{
+    return InterlockedIncrement( &impl_from_IAsyncOperation_AdaptiveMediaSourceCreationResult( iface )->ref );
+}
+
+static ULONG WINAPI adaptive_operation_Release( IAsyncOperation_AdaptiveMediaSourceCreationResult *iface )
+{
+    struct adaptive_operation *impl = impl_from_IAsyncOperation_AdaptiveMediaSourceCreationResult( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->handler) IAsyncOperationCompletedHandler_AdaptiveMediaSourceCreationResult_Release( impl->handler );
+        IAdaptiveMediaSourceCreationResult_Release( impl->result );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI adaptive_operation_GetIids( IAsyncOperation_AdaptiveMediaSourceCreationResult *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI adaptive_operation_GetRuntimeClassName( IAsyncOperation_AdaptiveMediaSourceCreationResult *iface, HSTRING *name )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI adaptive_operation_GetTrustLevel( IAsyncOperation_AdaptiveMediaSourceCreationResult *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI adaptive_operation_put_Completed( IAsyncOperation_AdaptiveMediaSourceCreationResult *iface,
+        IAsyncOperationCompletedHandler_AdaptiveMediaSourceCreationResult *handler )
+{
+    struct adaptive_operation *impl = impl_from_IAsyncOperation_AdaptiveMediaSourceCreationResult( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if (!handler) return E_POINTER;
+    if (impl->handler) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    impl->handler = handler;
+    IAsyncOperationCompletedHandler_AdaptiveMediaSourceCreationResult_AddRef( handler );
+    return IAsyncOperationCompletedHandler_AdaptiveMediaSourceCreationResult_Invoke( handler, iface, Completed );
+}
+
+static HRESULT WINAPI adaptive_operation_get_Completed( IAsyncOperation_AdaptiveMediaSourceCreationResult *iface,
+        IAsyncOperationCompletedHandler_AdaptiveMediaSourceCreationResult **handler )
+{
+    struct adaptive_operation *impl = impl_from_IAsyncOperation_AdaptiveMediaSourceCreationResult( iface );
+
+    if ((*handler = impl->handler)) IAsyncOperationCompletedHandler_AdaptiveMediaSourceCreationResult_AddRef( *handler );
+    return S_OK;
+}
+
+static HRESULT WINAPI adaptive_operation_GetResults( IAsyncOperation_AdaptiveMediaSourceCreationResult *iface,
+                                                     IAdaptiveMediaSourceCreationResult **results )
+{
+    struct adaptive_operation *impl = impl_from_IAsyncOperation_AdaptiveMediaSourceCreationResult( iface );
+
+    TRACE( "iface %p, results %p.\n", iface, results );
+
+    *results = impl->result;
+    IAdaptiveMediaSourceCreationResult_AddRef( *results );
+    return S_OK;
+}
+
+static const struct IAsyncOperation_AdaptiveMediaSourceCreationResultVtbl adaptive_operation_vtbl =
+{
+    adaptive_operation_QueryInterface,
+    adaptive_operation_AddRef,
+    adaptive_operation_Release,
+    adaptive_operation_GetIids,
+    adaptive_operation_GetRuntimeClassName,
+    adaptive_operation_GetTrustLevel,
+    adaptive_operation_put_Completed,
