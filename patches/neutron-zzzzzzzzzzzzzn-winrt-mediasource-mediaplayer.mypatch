+static HRESULT get_system_media_transport_controls( HWND *window, ISystemMediaTransportControls **controls );
+
 DEFINE_IINSPECTABLE( media_player2, IMediaPlayer2, struct media_player, IMediaPlayer_iface )
 
 static HRESULT WINAPI media_player2_get_SystemMediaTransportControls( IMediaPlayer2 *iface, ISystemMediaTransportControls **value )
 {
     struct media_player *impl = impl_from_IMediaPlayer2( iface );
+    HRESULT hr = S_OK;
 
     TRACE( "iface %p, value %p\n", iface, value );
 
-    *value = impl->controls;
-    ISystemMediaTransportControls_AddRef( *value );
-    return S_OK;
+    /* NEUTRON: created on first use rather than in the constructor. It needs a window, and the
+     * player is often created on a thread that never pumps messages; failing here used to fail
+     * the whole player, which apps that never touch the transport controls do not expect. */
+    EnterCriticalSection( &impl->cs );
+    if (!impl->controls) hr = get_system_media_transport_controls( &impl->window, &impl->controls );
+    if (SUCCEEDED(hr))
+    {
+        *value = impl->controls;
+        ISystemMediaTransportControls_AddRef( *value );
+    }
+    LeaveCriticalSection( &impl->cs );
+    return hr;
 }
 
