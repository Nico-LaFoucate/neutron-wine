+DEFINE_IINSPECTABLE_( adaptive_operation_info, IAsyncInfo, struct adaptive_operation, adaptive_operation_from_IAsyncInfo,
+                      IAsyncInfo_iface, &impl->IAsyncOperation_AdaptiveMediaSourceCreationResult_iface )
+
+static HRESULT WINAPI adaptive_operation_info_get_Id( IAsyncInfo *iface, UINT32 *id )
+{
+    *id = 1;
+    return S_OK;
+}
