+{
+    return WindowsCreateString( RuntimeClass_Windows_Media_Playback_MediaPlaybackItem,
+                                wcslen( RuntimeClass_Windows_Media_Playback_MediaPlaybackItem ), name );
+}
+
+static HRESULT WINAPI playback_item_GetTrustLevel( IMediaPlaybackItem *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI playback_item_add_AudioTracksChanged( IMediaPlaybackItem *iface,
+        ITypedEventHandler_MediaPlaybackItem_IVectorChangedEventArgs *handler, EventRegistrationToken *token )
+{
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+    return event_handlers_add( &impl_from_IMediaPlaybackItem( iface )->audio_tracks_changed, (IUnknown *)handler, token );
+}
+
+static HRESULT WINAPI playback_item_remove_AudioTracksChanged( IMediaPlaybackItem *iface, EventRegistrationToken token )
+{
+    return event_handlers_remove( &impl_from_IMediaPlaybackItem( iface )->audio_tracks_changed, token );
+}
+
