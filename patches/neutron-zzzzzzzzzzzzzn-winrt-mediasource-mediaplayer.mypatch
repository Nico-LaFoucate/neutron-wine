+        if (engine) IMFMediaEngine_GetNativeVideoSize( engine, &cx, &cy );
+        AcquireSRWLockExclusive( &impl->state_lock );
+        impl->video_width = cx;
+        impl->video_height = cy;
+        ReleaseSRWLockExclusive( &impl->state_lock );
+        TRACE( "player %p: metadata loaded, video %lux%lu.\n", impl, cx, cy );
+        media_player_queue( impl, PLAYER_EVENT_METADATA, S_OK, 0 );
+        break;
+    }
+    case MF_MEDIA_ENGINE_EVENT_CANPLAY:
+    {
+        BOOL first;
+        AcquireSRWLockExclusive( &impl->state_lock );
+        first = !impl->opened;
+        impl->opened = TRUE;
+        ReleaseSRWLockExclusive( &impl->state_lock );
+        if (first)
+        {
+            media_player_queue( impl, PLAYER_EVENT_OPENED, S_OK, 0 );
+            if (media_player_get_state( impl ) != MediaPlaybackState_Playing)
+                media_player_set_state( impl, MediaPlaybackState_Paused );
+        }
+        break;
+    }
+    case MF_MEDIA_ENGINE_EVENT_PLAYING:
+        media_player_set_state( impl, MediaPlaybackState_Playing );
+        if (impl->worker_wake) SetEvent( impl->worker_wake );
+        break;
+    case MF_MEDIA_ENGINE_EVENT_PAUSE:
+        media_player_set_state( impl, MediaPlaybackState_Paused );
+        break;
+    case MF_MEDIA_ENGINE_EVENT_WAITING:
+        media_player_set_state( impl, MediaPlaybackState_Buffering );
+        break;
+    case MF_MEDIA_ENGINE_EVENT_ENDED:
+        media_player_queue( impl, PLAYER_EVENT_ENDED, S_OK, 0 );
+        media_player_set_state( impl, MediaPlaybackState_Paused );
+        break;
+    case MF_MEDIA_ENGINE_EVENT_ERROR:
+        WARN( "player %p: media engine error %Iu, hr %#lx.\n", impl, param1, param2 );
+        media_player_queue( impl, PLAYER_EVENT_FAILED, param2, param1 );
+        media_player_set_state( impl, MediaPlaybackState_None );
+        break;
+    case MF_MEDIA_ENGINE_EVENT_SEEKED:
+        media_player_queue( impl, PLAYER_EVENT_SEEKED, S_OK, 0 );
+        break;
+    case MF_MEDIA_ENGINE_EVENT_DURATIONCHANGE:
+        media_player_queue( impl, PLAYER_EVENT_DURATION, S_OK, 0 );
+        break;
+    case MF_MEDIA_ENGINE_EVENT_VOLUMECHANGE:
+        media_player_queue( impl, PLAYER_EVENT_VOLUME, S_OK, 0 );
+        break;
+    case MF_MEDIA_ENGINE_EVENT_RATECHANGE:
+        media_player_queue( impl, PLAYER_EVENT_RATE, S_OK, 0 );
+        break;
+    case MF_MEDIA_ENGINE_EVENT_TIMEUPDATE:
+        media_player_queue( impl, PLAYER_EVENT_POSITION, S_OK, 0 );
+        break;
+    default:
+        TRACE( "player %p: engine event %lu.\n", impl, event );
+        break;
+    }
