+static HRESULT WINAPI media_source2_get_ExternalTimedMetadataTracks( IMediaSource2 *iface, IInspectable **value )
+{
+    FIXME( "iface %p, value %p stub!\n", iface, value );
+    *value = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IMediaSource2Vtbl media_source2_vtbl =
+{
+    media_source2_QueryInterface,
+    media_source2_AddRef,
+    media_source2_Release,
+    media_source2_GetIids,
+    media_source2_GetRuntimeClassName,
+    media_source2_GetTrustLevel,
+    media_source2_add_OpenOperationCompleted,
+    media_source2_remove_OpenOperationCompleted,
+    media_source2_get_CustomProperties,
+    media_source2_get_Duration,
+    media_source2_get_IsOpen,
+    media_source2_get_ExternalTimedTextSources,
+    media_source2_get_ExternalTimedMetadataTracks,
+};
