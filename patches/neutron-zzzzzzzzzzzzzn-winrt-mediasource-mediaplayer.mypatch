+static HRESULT WINAPI statics_CreateFromStreamReference( IMediaSourceStatics *iface, IRandomAccessStreamReference *stream,
+                                                         HSTRING content_type, IMediaSource2 **result )
+{
+    FIXME( "iface %p, stream %p, content_type %s, result %p stub!\n", iface, stream, debugstr_hstring( content_type ), result );
+    *result = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI statics_CreateFromUri( IMediaSourceStatics *iface, IUriRuntimeClass *uri, IMediaSource2 **result )
+{
+    HSTRING str = NULL;
+    HRESULT hr;
+
+    TRACE( "iface %p, uri %p, result %p.\n", iface, uri, result );
+
+    if (!uri || !result) return E_POINTER;
+    *result = NULL;
+
+    /* the absolute form is what the media engine's source resolver parses (file:///C:/...) */
+    if (FAILED(hr = IUriRuntimeClass_get_AbsoluteUri( uri, &str )) || !WindowsGetStringLen( str ))
+    {
+        WindowsDeleteString( str );
+        str = NULL;
+        if (FAILED(hr = IUriRuntimeClass_get_RawUri( uri, &str ))) return hr;
+    }
+
+    hr = media_source_create_from_url( uri, WindowsGetStringRawBuffer( str, NULL ), result );
+    WindowsDeleteString( str );
+    return hr;
+}
