+#define PLAYER_EVENT_ACCESSORS( name, list, handler_type )                                              \
+    static HRESULT WINAPI media_player_add_##name( IMediaPlayer *iface, handler_type *handler,          \
+                                                   EventRegistrationToken *token )                      \
+    {                                                                                                   \
+        TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );                            \
+        return event_handlers_add( &impl_from_IMediaPlayer( iface )->list, (IUnknown *)handler, token ); \
+    }                                                                                                   \
+    static HRESULT WINAPI media_player_remove_##name( IMediaPlayer *iface, EventRegistrationToken token ) \
+    {                                                                                                   \
+        TRACE( "iface %p, token %#I64x.\n", iface, token.value );                                       \
+        return event_handlers_remove( &impl_from_IMediaPlayer( iface )->list, token );                 \
+    }
+
+PLAYER_EVENT_ACCESSORS( MediaOpened, media_opened, ITypedEventHandler_MediaPlayer_IInspectable )
+PLAYER_EVENT_ACCESSORS( MediaEnded, media_ended, ITypedEventHandler_MediaPlayer_IInspectable )
+PLAYER_EVENT_ACCESSORS( MediaFailed, media_failed, ITypedEventHandler_MediaPlayer_MediaPlayerFailedEventArgs )
+PLAYER_EVENT_ACCESSORS( CurrentStateChanged, current_state_changed, ITypedEventHandler_MediaPlayer_IInspectable )
+PLAYER_EVENT_ACCESSORS( PlaybackMediaMarkerReached, marker_reached, ITypedEventHandler_MediaPlayer_PlaybackMediaMarkerReachedEventArgs )
+PLAYER_EVENT_ACCESSORS( MediaPlayerRateChanged, rate_changed, ITypedEventHandler_MediaPlayer_MediaPlayerRateChangedEventArgs )
+PLAYER_EVENT_ACCESSORS( VolumeChanged, volume_changed, ITypedEventHandler_MediaPlayer_IInspectable )
+PLAYER_EVENT_ACCESSORS( SeekCompleted, seek_completed, ITypedEventHandler_MediaPlayer_IInspectable )
