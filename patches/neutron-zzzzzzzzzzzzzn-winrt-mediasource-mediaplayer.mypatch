+
+static HRESULT WINAPI statics_CreateFromMediaStreamSource( IMediaSourceStatics *iface, IInspectable *source, IMediaSource2 **result )
+{
+    FIXME( "iface %p, source %p, result %p stub!\n", iface, source, result );
+    *result = NULL;
+    return E_NOTIMPL;
+}
