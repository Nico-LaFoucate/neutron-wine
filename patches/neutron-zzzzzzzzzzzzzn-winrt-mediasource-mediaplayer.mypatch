-static HRESULT WINAPI media_player_get_Volume( IMediaPlayer *iface, DOUBLE *value )
+static ULONG WINAPI media_player_Release( IMediaPlayer *iface )
 {
-    FIXME( "iface %p, value %p stub!\n", iface, value );
-    return E_NOTIMPL;
+    struct media_player *impl = impl_from_IMediaPlayer( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        if (impl->worker)
+        {
+            SetEvent( impl->worker_stop );
+            if (GetCurrentThreadId() != impl->worker_tid) WaitForSingleObject( impl->worker, INFINITE );
+            CloseHandle( impl->worker );
+        }
+
+        /* no engine callback runs past this point, and none reaches the player again */
+        AcquireSRWLockExclusive( &impl->notify->lock );
+        impl->notify->player = NULL;
+        ReleaseSRWLockExclusive( &impl->notify->lock );
+
+        media_player_shutdown( impl );
+        if (impl->engine) IMFMediaEngine_Release( impl->engine );
+        IMFMediaEngineNotify_Release( &impl->notify->IMFMediaEngineNotify_iface );
+
+        playback_session_detach( impl->session );
+        IMediaPlaybackSession_Release( impl->session );
+        if (impl->source) IMediaPlaybackSource_Release( impl->source );
+        if (impl->media_source) IUnknown_Release( impl->media_source );
+        if (impl->item) IUnknown_Release( impl->item );
+        if (impl->frame_cache) IWICBitmap_Release( impl->frame_cache );
+
+        event_handlers_clear( &impl->media_opened );
+        event_handlers_clear( &impl->media_ended );
+        event_handlers_clear( &impl->media_failed );
+        event_handlers_clear( &impl->current_state_changed );
+        event_handlers_clear( &impl->marker_reached );
+        event_handlers_clear( &impl->rate_changed );
+        event_handlers_clear( &impl->volume_changed );
+        event_handlers_clear( &impl->seek_completed );
+        event_handlers_clear( &impl->buffering_started );
+        event_handlers_clear( &impl->buffering_ended );
+        event_handlers_clear( &impl->is_muted_changed );
+        event_handlers_clear( &impl->source_changed );
+        event_handlers_clear( &impl->video_frame_available );
+
+        if (impl->controls) ISystemMediaTransportControls_Release( impl->controls );
+        if (impl->window) DestroyWindow( impl->window );
+        if (impl->worker_wake) CloseHandle( impl->worker_wake );
+        if (impl->worker_stop) CloseHandle( impl->worker_stop );
+        if (impl->mf_started) MFShutdown();
+        impl->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &impl->cs );
+        free( impl );
+    }
+    return ref;
 }
 
