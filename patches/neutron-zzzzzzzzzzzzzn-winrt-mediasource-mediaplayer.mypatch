+/* Windows.Media.Streaming.Adaptive.AdaptiveMediaSource statics.
+ *
+ * NEUTRON: no adaptive (HLS/DASH) streaming. Apps that try an adaptive source first and fall back
+ * to a plain MediaSource -- Lightroom Classic's video toolkit does this for every video, and calls
+ * CreateFromUriAsync without checking that the factory exists -- get what Windows answers for
+ * content that is not a manifest: the operation completes at once with
+ * UnsupportedManifestContentType. */
+
+struct adaptive_result
+{
+    IAdaptiveMediaSourceCreationResult IAdaptiveMediaSourceCreationResult_iface;
+    IAdaptiveMediaSourceCreationResult2 IAdaptiveMediaSourceCreationResult2_iface;
+    LONG ref;
+    AdaptiveMediaSourceCreationStatus status;
+    HRESULT error;
+};
+
+static inline struct adaptive_result *impl_from_IAdaptiveMediaSourceCreationResult( IAdaptiveMediaSourceCreationResult *iface )
+{
+    return CONTAINING_RECORD( iface, struct adaptive_result, IAdaptiveMediaSourceCreationResult_iface );
+}
+
+static HRESULT WINAPI adaptive_result_QueryInterface( IAdaptiveMediaSourceCreationResult *iface, REFIID iid, void **out )
+{
+    struct adaptive_result *impl = impl_from_IAdaptiveMediaSourceCreationResult( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IAdaptiveMediaSourceCreationResult ))
+        *out = &impl->IAdaptiveMediaSourceCreationResult_iface;
+    else if (IsEqualGUID( iid, &IID_IAdaptiveMediaSourceCreationResult2 ))
+        *out = &impl->IAdaptiveMediaSourceCreationResult2_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI adaptive_result_AddRef( IAdaptiveMediaSourceCreationResult *iface )
+{
+    return InterlockedIncrement( &impl_from_IAdaptiveMediaSourceCreationResult( iface )->ref );
+}
+
+static ULONG WINAPI adaptive_result_Release( IAdaptiveMediaSourceCreationResult *iface )
+{
+    struct adaptive_result *impl = impl_from_IAdaptiveMediaSourceCreationResult( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI adaptive_result_GetIids( IAdaptiveMediaSourceCreationResult *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI adaptive_result_GetRuntimeClassName( IAdaptiveMediaSourceCreationResult *iface, HSTRING *name )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI adaptive_result_GetTrustLevel( IAdaptiveMediaSourceCreationResult *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI adaptive_result_get_Status( IAdaptiveMediaSourceCreationResult *iface, AdaptiveMediaSourceCreationStatus *value )
+{
+    *value = impl_from_IAdaptiveMediaSourceCreationResult( iface )->status;
+    TRACE( "iface %p, status %d.\n", iface, *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI adaptive_result_get_MediaSource( IAdaptiveMediaSourceCreationResult *iface, IAdaptiveMediaSource **value )
+{
+    *value = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI adaptive_result_get_HttpResponseMessage( IAdaptiveMediaSourceCreationResult *iface, IInspectable **value )
+{
+    *value = NULL;
+    return S_OK;
+}
+
+static const struct IAdaptiveMediaSourceCreationResultVtbl adaptive_result_vtbl =
+{
+    adaptive_result_QueryInterface,
+    adaptive_result_AddRef,
+    adaptive_result_Release,
+    adaptive_result_GetIids,
+    adaptive_result_GetRuntimeClassName,
+    adaptive_result_GetTrustLevel,
+    adaptive_result_get_Status,
+    adaptive_result_get_MediaSource,
+    adaptive_result_get_HttpResponseMessage,
+};
