+{
+    PLAYER_EVENT_OPENED,
+    PLAYER_EVENT_METADATA,
+    PLAYER_EVENT_STATE,
+    PLAYER_EVENT_ENDED,
+    PLAYER_EVENT_FAILED,
+    PLAYER_EVENT_SEEKED,
+    PLAYER_EVENT_DURATION,
+    PLAYER_EVENT_VOLUME,
+    PLAYER_EVENT_RATE,
+    PLAYER_EVENT_POSITION,
+    PLAYER_EVENT_SOURCE,
+    PLAYER_EVENT_MUTED,
+};
+
+struct queued_event
+{
+    enum player_event type;
+    HRESULT hr;
+    UINT error;
