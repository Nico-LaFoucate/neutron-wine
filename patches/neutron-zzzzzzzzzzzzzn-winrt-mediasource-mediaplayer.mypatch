+static DWORD WINAPI media_player_worker( void *arg )
 {
-    FIXME( "iface %p, value %p stub!\n", iface, value );
-    return E_NOTIMPL;
+    struct media_player *impl = arg;
+    HANDLE handles[2] = { impl->worker_stop, impl->worker_wake };
+
+    CoInitializeEx( NULL, COINIT_MULTITHREADED );
+    SetThreadDescription( GetCurrentThread(), L"wine_mediaplayer_worker" );
+
+    for (;;)
+    {
+        struct queued_event event;
+        IMFMediaEngine *engine;
+        BOOL pump, have;
+        LONGLONG pts;
+
+        AcquireSRWLockShared( &impl->state_lock );
+        pump = impl->frame_server && impl->state == MediaPlaybackState_Playing && !impl->closed;
+        ReleaseSRWLockShared( &impl->state_lock );
+
+        if (WaitForMultipleObjects( 2, handles, FALSE, pump ? 4 : INFINITE ) == WAIT_OBJECT_0) break;
+
+        /* hold a reference while app code runs: a handler may release the last one */
+        if (!media_player_try_addref( impl )) continue;
+
+        for (;;)
+        {
+            AcquireSRWLockExclusive( &impl->state_lock );
+            if ((have = impl->queue_count > 0))
+            {
+                event = impl->queue[impl->queue_head];
+                impl->queue_head = (impl->queue_head + 1) % EVENT_QUEUE_SIZE;
+                impl->queue_count--;
+            }
+            ReleaseSRWLockExclusive( &impl->state_lock );
+            if (!have) break;
+            media_player_dispatch( impl, &event );
+        }
+
+        /* OnVideoStreamTick keeps answering S_OK for a frame nobody has copied yet; Windows raises
+         * VideoFrameAvailable once per new frame, so only a new timestamp counts */
+        if (pump && (engine = ReadPointerAcquire( (void **)&impl->engine ))
+                && IMFMediaEngine_OnVideoStreamTick( engine, &pts ) == S_OK && pts != impl->last_frame_pts)
+        {
+            impl->last_frame_pts = pts;
+            event_handlers_invoke( &impl->video_frame_available, (IInspectable *)&impl->IMediaPlayer_iface, NULL );
+        }
+
+        /* that may have been the last reference; the player is gone then, and so is this loop */
+        if (!IMediaPlayer_Release( &impl->IMediaPlayer_iface )) return 0;
+    }
+
+    CoUninitialize();
+    return 0;
 }
 
