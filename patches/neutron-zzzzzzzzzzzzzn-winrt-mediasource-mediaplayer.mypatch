+/* Copy the media engine's current frame into a D3D11 surface, scaled to fit. */
+HRESULT media_engine_copy_frame_to_surface( IMFMediaEngine *engine, IWICBitmap **cache,
+                                            IDirect3DSurface *surface, const RECT *target );
+
