+static HRESULT WINAPI media_source2_get_IsOpen( IMediaSource2 *iface, boolean *value )
+{
+    struct media_source *impl = impl_from_IMediaSource2( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
