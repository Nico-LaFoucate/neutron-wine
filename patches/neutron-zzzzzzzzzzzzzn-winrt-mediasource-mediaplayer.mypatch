+
+static HRESULT WINAPI engine_notify_QueryInterface( IMFMediaEngineNotify *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IMFMediaEngineNotify ))
+    {
+        *out = iface;
+        IMFMediaEngineNotify_AddRef( iface );
+        return S_OK;
+    }
     *out = NULL;
     return E_NOINTERFACE;
 }
 
