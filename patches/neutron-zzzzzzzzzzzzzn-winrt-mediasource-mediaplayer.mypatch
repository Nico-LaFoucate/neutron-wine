+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if ((*value = impl->uri)) IUriRuntimeClass_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI media_source4_OpenAsync( IMediaSource4 *iface, IAsyncAction **operation )
+{
+    struct media_source *impl = impl_from_IMediaSource4( iface );
+
+    TRACE( "iface %p, operation %p.\n", iface, operation );
+
+    if (impl->state == MediaSourceState_Initial) impl->state = MediaSourceState_Opened;
+    return completed_action_create( operation );
+}
