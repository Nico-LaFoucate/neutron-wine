+/* IMFMediaEngineNotify: a separate object holding the player weakly, so that the engine's
+ * reference to its callback does not keep the player alive. */
+
+static inline struct engine_notify *impl_from_IMFMediaEngineNotify( IMFMediaEngineNotify *iface )
+{
+    return CONTAINING_RECORD( iface, struct engine_notify, IMFMediaEngineNotify_iface );
