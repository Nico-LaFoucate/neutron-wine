+DEFINE_IINSPECTABLE( playback_item_source, IMediaPlaybackSource, struct playback_item, IMediaPlaybackItem_iface )
+
+static const struct IMediaPlaybackSourceVtbl playback_item_source_vtbl =
+{
+    playback_item_source_QueryInterface,
+    playback_item_source_AddRef,
+    playback_item_source_Release,
+    playback_item_source_GetIids,
+    playback_item_source_GetRuntimeClassName,
+    playback_item_source_GetTrustLevel,
+};
+
+static HRESULT playback_item_create( IMediaSource2 *source, IMediaPlaybackItem **out )
+{
+    struct playback_item *impl;
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    if (FAILED(hr = video_track_list_create( &impl->video_tracks )))
+    {
+        free( impl );
+        return hr;
+    }
+    impl->IMediaPlaybackItem_iface.lpVtbl = &playback_item_vtbl;
+    impl->IMediaPlaybackSource_iface.lpVtbl = &playback_item_source_vtbl;
+    impl->ref = 1;
+    event_handlers_init( &impl->audio_tracks_changed );
+    event_handlers_init( &impl->video_tracks_changed );
+    event_handlers_init( &impl->metadata_tracks_changed );
+    if ((impl->source = source)) IMediaSource2_AddRef( source );
+
+    TRACE( "created item %p for source %p.\n", impl, source );
+    *out = &impl->IMediaPlaybackItem_iface;
+    return S_OK;
+}
+
+HRESULT playback_item_get_source( IUnknown *item, IUnknown **source )
+{
+    struct playback_item *impl;
+
+    if (!(impl = unsafe_impl_from_unknown( item ))) return E_INVALIDARG;
+    if (!(*source = (IUnknown *)impl->source)) return E_INVALIDARG;
+    IUnknown_AddRef( *source );
+    return S_OK;
+}
+
+void playback_item_set_video_track( IUnknown *item, UINT32 width, UINT32 height )
+{
+    struct playback_item *impl;
+    struct video_track_list *list;
+    IInspectable *args;
+    IMediaTrack *track;
+    BOOL added = FALSE;
+
+    if (!(impl = unsafe_impl_from_unknown( item ))) return;
+    list = impl->video_tracks;
+
+    if (FAILED(video_track_create( &impl->IMediaPlaybackItem_iface, width, height, &track ))) return;
+
+    AcquireSRWLockExclusive( &list->lock );
+    if (!list->track)
+    {
+        list->track = track;
+        list->selected = 0;
+        added = TRUE;
+    }
+    ReleaseSRWLockExclusive( &list->lock );
+
+    if (!added)
+    {
+        IMediaTrack_Release( track );
+        return;
+    }
+
+    TRACE( "item %p: video track %ux%u.\n", impl, width, height );
+    if (SUCCEEDED(vector_changed_event_args_create( CollectionChange_ItemInserted, 0, &args )))
+    {
+        event_handlers_invoke( &impl->video_tracks_changed, (IInspectable *)&impl->IMediaPlaybackItem_iface, args );
+        IInspectable_Release( args );
+    }
+}
+
+/* The factory: IActivationFactory + IMediaPlaybackItemFactory */
+
+struct playback_item_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    IMediaPlaybackItemFactory IMediaPlaybackItemFactory_iface;
+    LONG ref;
+};
+
+static inline struct playback_item_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct playback_item_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct playback_item_statics *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IMediaPlaybackItemFactory ))
+        *out = &impl->IMediaPlaybackItemFactory_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    return InterlockedIncrement( &impl_from_IActivationFactory( iface )->ref );
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    return InterlockedDecrement( &impl_from_IActivationFactory( iface )->ref );
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *name )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    FIXME( "iface %p, instance %p: MediaPlaybackItem has no default constructor.\n", iface, instance );
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( item_factory, IMediaPlaybackItemFactory, struct playback_item_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI item_factory_Create( IMediaPlaybackItemFactory *iface, IMediaSource2 *source, IMediaPlaybackItem **value )
+{
+    TRACE( "iface %p, source %p, value %p.\n", iface, source, value );
+
+    if (!source || !value) return E_POINTER;
+    return playback_item_create( source, value );
+}
+
+static const struct IMediaPlaybackItemFactoryVtbl item_factory_vtbl =
+{
+    item_factory_QueryInterface,
+    item_factory_AddRef,
+    item_factory_Release,
+    item_factory_GetIids,
+    item_factory_GetRuntimeClassName,
+    item_factory_GetTrustLevel,
+    item_factory_Create,
+};
+
+static struct playback_item_statics playback_item_statics =
+{
+    {&factory_vtbl},
+    {&item_factory_vtbl},
+    1,
+};
+
+IActivationFactory *playback_item_factory = &playback_item_statics.IActivationFactory_iface;
