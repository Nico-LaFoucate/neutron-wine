+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdlib.h>
+
+#include "private.h"
+#include "oleauto.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mediaplayer);
+
+/* NEUTRON: a MediaSource here is a URL the media engine can open: CreateFromUri is the
+ * constructor Lightroom Classic uses (its video toolkit plays the in-app help videos this way).
+ * The other constructors need stream sources Wine does not have and still fail. */
+
+/* An IAsyncAction that has already completed, for OpenAsync: the source is opened by the media
+ * engine when a player loads it, so there is nothing to wait for here. */
+struct completed_action
+{
+    IAsyncAction IAsyncAction_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    IAsyncActionCompletedHandler *handler;
+};
+
+static inline struct completed_action *impl_from_IAsyncAction( IAsyncAction *iface )
+{
+    return CONTAINING_RECORD( iface, struct completed_action, IAsyncAction_iface );
+}
+
+static HRESULT WINAPI completed_action_QueryInterface( IAsyncAction *iface, REFIID iid, void **out )
+{
+    struct completed_action *impl = impl_from_IAsyncAction( iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IAsyncAction ))
+        *out = &impl->IAsyncAction_iface;
+    else if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+        *out = &impl->IAsyncInfo_iface;
+    else
+    {
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI completed_action_AddRef( IAsyncAction *iface )
+{
+    return InterlockedIncrement( &impl_from_IAsyncAction( iface )->ref );
+}
+
+static ULONG WINAPI completed_action_Release( IAsyncAction *iface )
+{
+    struct completed_action *impl = impl_from_IAsyncAction( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->handler) IAsyncActionCompletedHandler_Release( impl->handler );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI completed_action_GetIids( IAsyncAction *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI completed_action_GetRuntimeClassName( IAsyncAction *iface, HSTRING *name )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI completed_action_GetTrustLevel( IAsyncAction *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI completed_action_put_Completed( IAsyncAction *iface, IAsyncActionCompletedHandler *handler )
+{
+    struct completed_action *impl = impl_from_IAsyncAction( iface );
+
+    if (!handler) return E_POINTER;
+    if (impl->handler) return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    impl->handler = handler;
+    IAsyncActionCompletedHandler_AddRef( handler );
+    /* already complete: the handler runs at once, as on Windows */
+    return IAsyncActionCompletedHandler_Invoke( handler, iface, Completed );
+}
+
+static HRESULT WINAPI completed_action_get_Completed( IAsyncAction *iface, IAsyncActionCompletedHandler **handler )
+{
+    struct completed_action *impl = impl_from_IAsyncAction( iface );
+
+    if ((*handler = impl->handler)) IAsyncActionCompletedHandler_AddRef( *handler );
+    return S_OK;
+}
+
+static HRESULT WINAPI completed_action_GetResults( IAsyncAction *iface )
+{
+    return S_OK;
+}
+
+static const struct IAsyncActionVtbl completed_action_vtbl =
+{
+    completed_action_QueryInterface,
+    completed_action_AddRef,
+    completed_action_Release,
+    completed_action_GetIids,
+    completed_action_GetRuntimeClassName,
+    completed_action_GetTrustLevel,
+    completed_action_put_Completed,
+    completed_action_get_Completed,
+    completed_action_GetResults,
+};
+
+DEFINE_IINSPECTABLE( completed_action_info, IAsyncInfo, struct completed_action, IAsyncAction_iface )
+
+static HRESULT WINAPI completed_action_info_get_Id( IAsyncInfo *iface, UINT32 *id )
+{
+    *id = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI completed_action_info_get_Status( IAsyncInfo *iface, AsyncStatus *status )
+{
+    *status = Completed;
+    return S_OK;
+}
+
+static HRESULT WINAPI completed_action_info_get_ErrorCode( IAsyncInfo *iface, HRESULT *error_code )
+{
+    *error_code = S_OK;
+    return S_OK;
+}
+
+static HRESULT WINAPI completed_action_info_Cancel( IAsyncInfo *iface )
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI completed_action_info_Close( IAsyncInfo *iface )
+{
+    return S_OK;
+}
+
+static const struct IAsyncInfoVtbl completed_action_info_vtbl =
+{
+    completed_action_info_QueryInterface,
+    completed_action_info_AddRef,
+    completed_action_info_Release,
+    completed_action_info_GetIids,
+    completed_action_info_GetRuntimeClassName,
+    completed_action_info_GetTrustLevel,
+    completed_action_info_get_Id,
+    completed_action_info_get_Status,
+    completed_action_info_get_ErrorCode,
+    completed_action_info_Cancel,
+    completed_action_info_Close,
+};
+
+static HRESULT completed_action_create( IAsyncAction **out )
+{
+    struct completed_action *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IAsyncAction_iface.lpVtbl = &completed_action_vtbl;
+    impl->IAsyncInfo_iface.lpVtbl = &completed_action_info_vtbl;
+    impl->ref = 1;
+    *out = &impl->IAsyncAction_iface;
+    return S_OK;
+}
+
+/* MediaSource */
+
+struct media_source
+{
+    IMediaSource2 IMediaSource2_iface;
+    IMediaSource IMediaSource_iface;
+    IMediaSource3 IMediaSource3_iface;
+    IMediaSource4 IMediaSource4_iface;
+    IMediaPlaybackSource IMediaPlaybackSource_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+
+    IUriRuntimeClass *uri;
+    WCHAR *url;
+    MediaSourceState state;
+    struct event_handlers open_completed;
+    struct event_handlers state_changed;
+};
+
+static const struct IMediaSource2Vtbl media_source2_vtbl;
+
+static inline struct media_source *impl_from_IMediaSource2( IMediaSource2 *iface )
+{
+    return CONTAINING_RECORD( iface, struct media_source, IMediaSource2_iface );
+}
+
+static struct media_source *unsafe_impl_from_unknown( IUnknown *source )
+{
+    IMediaSource2 *source2;
+    struct media_source *impl;
+
+    if (!source || FAILED(IUnknown_QueryInterface( source, &IID_IMediaSource2, (void **)&source2 ))) return NULL;
+    impl = source2->lpVtbl == &media_source2_vtbl ? impl_from_IMediaSource2( source2 ) : NULL;
+    IMediaSource2_Release( source2 );
+    return impl;
+}
+
+static HRESULT WINAPI media_source2_QueryInterface( IMediaSource2 *iface, REFIID iid, void **out )
+{
+    struct media_source *impl = impl_from_IMediaSource2( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IMediaSource2 ))
+        *out = &impl->IMediaSource2_iface;
+    else if (IsEqualGUID( iid, &IID_IMediaSource ))
+        *out = &impl->IMediaSource_iface;
+    else if (IsEqualGUID( iid, &IID_IMediaSource3 ))
+        *out = &impl->IMediaSource3_iface;
+    else if (IsEqualGUID( iid, &IID_IMediaSource4 ))
+        *out = &impl->IMediaSource4_iface;
+    else if (IsEqualGUID( iid, &IID_IMediaPlaybackSource ))
+        *out = &impl->IMediaPlaybackSource_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &impl->IClosable_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI media_source2_AddRef( IMediaSource2 *iface )
+{
+    struct media_source *impl = impl_from_IMediaSource2( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p increasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI media_source2_Release( IMediaSource2 *iface )
+{
+    struct media_source *impl = impl_from_IMediaSource2( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        event_handlers_clear( &impl->open_completed );
+        event_handlers_clear( &impl->state_changed );
+        if (impl->uri) IUriRuntimeClass_Release( impl->uri );
+        free( impl->url );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI media_source2_GetIids( IMediaSource2 *iface, ULONG *count, IID **iids )
+{
+    FIXME( "iface %p, count %p, iids %p stub!\n", iface, count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI media_source2_GetRuntimeClassName( IMediaSource2 *iface, HSTRING *name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_Media_Core_MediaSource,
+                                wcslen( RuntimeClass_Windows_Media_Core_MediaSource ), name );
+}
+
+static HRESULT WINAPI media_source2_GetTrustLevel( IMediaSource2 *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI media_source2_add_OpenOperationCompleted( IMediaSource2 *iface,
+        ITypedEventHandler_MediaSource_MediaSourceOpenOperationCompletedEventArgs *handler, EventRegistrationToken *token )
+{
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+    return event_handlers_add( &impl_from_IMediaSource2( iface )->open_completed, (IUnknown *)handler, token );
+}
+
+static HRESULT WINAPI media_source2_remove_OpenOperationCompleted( IMediaSource2 *iface, EventRegistrationToken token )
+{
+    TRACE( "iface %p, token %#I64x.\n", iface, token.value );
+    return event_handlers_remove( &impl_from_IMediaSource2( iface )->open_completed, token );
+}
+
+static HRESULT WINAPI media_source2_get_CustomProperties( IMediaSource2 *iface, IPropertySet **value )
+{
+    FIXME( "iface %p, value %p stub!\n", iface, value );
+    *value = NULL;
+    return E_NOTIMPL;
+}
