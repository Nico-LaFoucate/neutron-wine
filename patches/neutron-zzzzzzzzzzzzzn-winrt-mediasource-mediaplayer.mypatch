+
+#include <stdlib.h>
+
+#include "private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mediaplayer);
+
+/* NEUTRON: a MediaPlaybackItem wraps a MediaSource and exposes its tracks. The video track
+ * appears once the player has opened the media (playback_item_set_video_track), raising
+ * VideoTracksChanged as on Windows, where tracks are only known after the source is resolved. */
+
+/* VideoTrack */
+
+struct video_track
+{
+    IMediaTrack IMediaTrack_iface;
+    IVideoTrack IVideoTrack_iface;
+    LONG ref;
+
+    IMediaPlaybackItem *item; /* weak: the item owns the list that owns the track */
+    UINT32 width, height;
+    HSTRING label;
+};
+
+static inline struct video_track *impl_from_IMediaTrack( IMediaTrack *iface )
+{
+    return CONTAINING_RECORD( iface, struct video_track, IMediaTrack_iface );
+}
+
+static HRESULT WINAPI video_track_QueryInterface( IMediaTrack *iface, REFIID iid, void **out )
+{
+    struct video_track *impl = impl_from_IMediaTrack( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IMediaTrack ))
+        *out = &impl->IMediaTrack_iface;
+    else if (IsEqualGUID( iid, &IID_IVideoTrack ))
+        *out = &impl->IVideoTrack_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI video_track_AddRef( IMediaTrack *iface )
+{
+    return InterlockedIncrement( &impl_from_IMediaTrack( iface )->ref );
+}
+
+static ULONG WINAPI video_track_Release( IMediaTrack *iface )
+{
+    struct video_track *impl = impl_from_IMediaTrack( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->label );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI video_track_GetIids( IMediaTrack *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI video_track_GetRuntimeClassName( IMediaTrack *iface, HSTRING *name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_Media_Core_VideoTrack,
+                                wcslen( RuntimeClass_Windows_Media_Core_VideoTrack ), name );
+}
+
+static HRESULT WINAPI video_track_GetTrustLevel( IMediaTrack *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI video_track_get_Id( IMediaTrack *iface, HSTRING *value )
+{
+    return WindowsCreateString( L"1", 1, value );
+}
+
+static HRESULT WINAPI video_track_get_Language( IMediaTrack *iface, HSTRING *value )
+{
+    *value = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI video_track_get_TrackKind( IMediaTrack *iface, MediaTrackKind *value )
+{
+    *value = MediaTrackKind_Video;
+    return S_OK;
+}
+
+static HRESULT WINAPI video_track_put_Label( IMediaTrack *iface, HSTRING value )
+{
+    struct video_track *impl = impl_from_IMediaTrack( iface );
+    HSTRING copy;
+    HRESULT hr;
+
+    if (FAILED(hr = WindowsDuplicateString( value, &copy ))) return hr;
+    WindowsDeleteString( impl->label );
+    impl->label = copy;
+    return S_OK;
+}
+
+static HRESULT WINAPI video_track_get_Label( IMediaTrack *iface, HSTRING *value )
+{
+    return WindowsDuplicateString( impl_from_IMediaTrack( iface )->label, value );
+}
+
+static const struct IMediaTrackVtbl video_track_vtbl =
+{
+    video_track_QueryInterface,
+    video_track_AddRef,
+    video_track_Release,
+    video_track_GetIids,
+    video_track_GetRuntimeClassName,
+    video_track_GetTrustLevel,
+    video_track_get_Id,
+    video_track_get_Language,
+    video_track_get_TrackKind,
+    video_track_put_Label,
+    video_track_get_Label,
+};
+
+DEFINE_IINSPECTABLE( video_track2, IVideoTrack, struct video_track, IMediaTrack_iface )
+
+static HRESULT WINAPI video_track2_add_OpenFailed( IVideoTrack *iface, IInspectable *handler, EventRegistrationToken *token )
+{
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+    /* the track is only created once it has opened, so this never fires */
+    token->value = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI video_track2_remove_OpenFailed( IVideoTrack *iface, EventRegistrationToken token )
+{
+    return S_OK;
+}
+
+static HRESULT WINAPI video_track2_GetEncodingProperties( IVideoTrack *iface, IInspectable **value )
+{
+    FIXME( "iface %p, value %p stub!\n", iface, value );
+    *value = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI video_track2_get_PlaybackItem( IVideoTrack *iface, IInspectable **value )
+{
+    struct video_track *impl = impl_from_IVideoTrack( iface );
+
+    if ((*value = (IInspectable *)impl->item)) IInspectable_AddRef( *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI video_track2_get_Name( IVideoTrack *iface, HSTRING *value )
+{
+    *value = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI video_track2_get_SupportInfo( IVideoTrack *iface, IInspectable **value )
+{
+    FIXME( "iface %p, value %p stub!\n", iface, value );
+    *value = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IVideoTrackVtbl video_track2_vtbl =
+{
+    video_track2_QueryInterface,
+    video_track2_AddRef,
+    video_track2_Release,
+    video_track2_GetIids,
+    video_track2_GetRuntimeClassName,
+    video_track2_GetTrustLevel,
+    video_track2_add_OpenFailed,
+    video_track2_remove_OpenFailed,
+    video_track2_GetEncodingProperties,
+    video_track2_get_PlaybackItem,
+    video_track2_get_Name,
+    video_track2_get_SupportInfo,
+};
+
+static HRESULT video_track_create( IMediaPlaybackItem *item, UINT32 width, UINT32 height, IMediaTrack **out )
+{
+    struct video_track *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IMediaTrack_iface.lpVtbl = &video_track_vtbl;
+    impl->IVideoTrack_iface.lpVtbl = &video_track2_vtbl;
+    impl->ref = 1;
+    impl->item = item;
+    impl->width = width;
+    impl->height = height;
+    *out = &impl->IMediaTrack_iface;
+    return S_OK;
+}
+
+/* MediaPlaybackVideoTrackList: IVectorView<VideoTrack>, IIterable<VideoTrack>,
+ * ISingleSelectMediaTrackList. At most one track. */
+
+struct video_track_list
+{
+    IVectorView_VideoTrack IVectorView_VideoTrack_iface;
+    IIterable_VideoTrack IIterable_VideoTrack_iface;
+    ISingleSelectMediaTrackList ISingleSelectMediaTrackList_iface;
+    LONG ref;
+
+    SRWLOCK lock;
+    IMediaTrack *track;
+    INT32 selected;
+    struct event_handlers selected_changed;
+};
+
+static inline struct video_track_list *impl_from_IVectorView_VideoTrack( IVectorView_VideoTrack *iface )
+{
+    return CONTAINING_RECORD( iface, struct video_track_list, IVectorView_VideoTrack_iface );
+}
+
+static HRESULT WINAPI track_list_QueryInterface( IVectorView_VideoTrack *iface, REFIID iid, void **out )
+{
+    struct video_track_list *impl = impl_from_IVectorView_VideoTrack( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IVectorView_VideoTrack ))
+        *out = &impl->IVectorView_VideoTrack_iface;
+    else if (IsEqualGUID( iid, &IID_IIterable_VideoTrack ))
+        *out = &impl->IIterable_VideoTrack_iface;
+    else if (IsEqualGUID( iid, &IID_ISingleSelectMediaTrackList ))
+        *out = &impl->ISingleSelectMediaTrackList_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI track_list_AddRef( IVectorView_VideoTrack *iface )
+{
+    return InterlockedIncrement( &impl_from_IVectorView_VideoTrack( iface )->ref );
+}
+
+static ULONG WINAPI track_list_Release( IVectorView_VideoTrack *iface )
+{
+    struct video_track_list *impl = impl_from_IVectorView_VideoTrack( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        event_handlers_clear( &impl->selected_changed );
+        if (impl->track) IMediaTrack_Release( impl->track );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI track_list_GetIids( IVectorView_VideoTrack *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI track_list_GetRuntimeClassName( IVectorView_VideoTrack *iface, HSTRING *name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_Media_Playback_MediaPlaybackVideoTrackList,
+                                wcslen( RuntimeClass_Windows_Media_Playback_MediaPlaybackVideoTrackList ), name );
+}
+
+static HRESULT WINAPI track_list_GetTrustLevel( IVectorView_VideoTrack *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI track_list_GetAt( IVectorView_VideoTrack *iface, UINT32 index, IMediaTrack **value )
+{
+    struct video_track_list *impl = impl_from_IVectorView_VideoTrack( iface );
+    HRESULT hr = E_BOUNDS;
+
+    TRACE( "iface %p, index %u, value %p.\n", iface, index, value );
+
+    *value = NULL;
+    AcquireSRWLockShared( &impl->lock );
+    if (!index && impl->track)
+    {
+        *value = impl->track;
+        IMediaTrack_AddRef( *value );
+        hr = S_OK;
+    }
+    ReleaseSRWLockShared( &impl->lock );
+    return hr;
+}
+
+static HRESULT WINAPI track_list_get_Size( IVectorView_VideoTrack *iface, UINT32 *value )
+{
+    struct video_track_list *impl = impl_from_IVectorView_VideoTrack( iface );
+
+    AcquireSRWLockShared( &impl->lock );
+    *value = impl->track ? 1 : 0;
+    ReleaseSRWLockShared( &impl->lock );
+    TRACE( "iface %p, size %u.\n", iface, *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI track_list_IndexOf( IVectorView_VideoTrack *iface, IMediaTrack *element, UINT32 *index, boolean *found )
+{
+    struct video_track_list *impl = impl_from_IVectorView_VideoTrack( iface );
+
+    AcquireSRWLockShared( &impl->lock );
+    *found = impl->track && impl->track == element;
+    ReleaseSRWLockShared( &impl->lock );
+    *index = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI track_list_GetMany( IVectorView_VideoTrack *iface, UINT32 start, UINT32 size,
+                                          IMediaTrack **items, UINT32 *count )
+{
+    struct video_track_list *impl = impl_from_IVectorView_VideoTrack( iface );
+
+    *count = 0;
+    AcquireSRWLockShared( &impl->lock );
+    if (!start && size && impl->track)
+    {
+        items[0] = impl->track;
+        IMediaTrack_AddRef( items[0] );
+        *count = 1;
+    }
+    ReleaseSRWLockShared( &impl->lock );
+    return S_OK;
+}
+
+static const struct IVectorView_VideoTrackVtbl track_list_vtbl =
+{
+    track_list_QueryInterface,
+    track_list_AddRef,
+    track_list_Release,
+    track_list_GetIids,
+    track_list_GetRuntimeClassName,
+    track_list_GetTrustLevel,
+    track_list_GetAt,
+    track_list_get_Size,
+    track_list_IndexOf,
+    track_list_GetMany,
+};
+
+/* IIterator<VideoTrack> over the list */
+
+struct track_iterator
+{
+    IIterator_VideoTrack IIterator_VideoTrack_iface;
+    LONG ref;
+    IVectorView_VideoTrack *view;
+    UINT32 index, size;
+};
+
+static inline struct track_iterator *impl_from_IIterator_VideoTrack( IIterator_VideoTrack *iface )
+{
+    return CONTAINING_RECORD( iface, struct track_iterator, IIterator_VideoTrack_iface );
+}
+
+static HRESULT WINAPI track_iterator_QueryInterface( IIterator_VideoTrack *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IIterator_VideoTrack ))
+    {
+        *out = iface;
+        IInspectable_AddRef( (IInspectable *)iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI track_iterator_AddRef( IIterator_VideoTrack *iface )
+{
+    return InterlockedIncrement( &impl_from_IIterator_VideoTrack( iface )->ref );
+}
+
+static ULONG WINAPI track_iterator_Release( IIterator_VideoTrack *iface )
+{
+    struct track_iterator *impl = impl_from_IIterator_VideoTrack( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        IVectorView_VideoTrack_Release( impl->view );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI track_iterator_GetIids( IIterator_VideoTrack *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI track_iterator_GetRuntimeClassName( IIterator_VideoTrack *iface, HSTRING *name )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI track_iterator_GetTrustLevel( IIterator_VideoTrack *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI track_iterator_get_Current( IIterator_VideoTrack *iface, IMediaTrack **value )
+{
+    struct track_iterator *impl = impl_from_IIterator_VideoTrack( iface );
+    return IVectorView_VideoTrack_GetAt( impl->view, impl->index, value );
+}
+
+static HRESULT WINAPI track_iterator_get_HasCurrent( IIterator_VideoTrack *iface, boolean *value )
+{
+    struct track_iterator *impl = impl_from_IIterator_VideoTrack( iface );
+    *value = impl->index < impl->size;
+    return S_OK;
+}
+
+static HRESULT WINAPI track_iterator_MoveNext( IIterator_VideoTrack *iface, boolean *value )
+{
+    struct track_iterator *impl = impl_from_IIterator_VideoTrack( iface );
+    if (impl->index < impl->size) impl->index++;
+    *value = impl->index < impl->size;
+    return S_OK;
+}
+
+static HRESULT WINAPI track_iterator_GetMany( IIterator_VideoTrack *iface, UINT32 items_size,
+                                              IMediaTrack **items, UINT32 *count )
+{
+    struct track_iterator *impl = impl_from_IIterator_VideoTrack( iface );
+    return IVectorView_VideoTrack_GetMany( impl->view, impl->index, items_size, items, count );
+}
+
+static const struct IIterator_VideoTrackVtbl track_iterator_vtbl =
+{
+    track_iterator_QueryInterface,
+    track_iterator_AddRef,
+    track_iterator_Release,
+    track_iterator_GetIids,
+    track_iterator_GetRuntimeClassName,
+    track_iterator_GetTrustLevel,
+    track_iterator_get_Current,
+    track_iterator_get_HasCurrent,
+    track_iterator_MoveNext,
+    track_iterator_GetMany,
+};
+
+DEFINE_IINSPECTABLE( track_list_iterable, IIterable_VideoTrack, struct video_track_list, IVectorView_VideoTrack_iface )
+
+static HRESULT WINAPI track_list_iterable_First( IIterable_VideoTrack *iface, IIterator_VideoTrack **value )
+{
+    struct video_track_list *impl = impl_from_IIterable_VideoTrack( iface );
+    struct track_iterator *iter;
+
+    if (!(iter = calloc( 1, sizeof(*iter) ))) return E_OUTOFMEMORY;
+    iter->IIterator_VideoTrack_iface.lpVtbl = &track_iterator_vtbl;
+    iter->ref = 1;
+    iter->view = &impl->IVectorView_VideoTrack_iface;
+    IVectorView_VideoTrack_AddRef( iter->view );
+    IVectorView_VideoTrack_get_Size( iter->view, &iter->size );
+    *value = &iter->IIterator_VideoTrack_iface;
+    return S_OK;
+}
+
+static const struct IIterable_VideoTrackVtbl track_list_iterable_vtbl =
+{
+    track_list_iterable_QueryInterface,
+    track_list_iterable_AddRef,
+    track_list_iterable_Release,
+    track_list_iterable_GetIids,
+    track_list_iterable_GetRuntimeClassName,
+    track_list_iterable_GetTrustLevel,
+    track_list_iterable_First,
+};
+
+DEFINE_IINSPECTABLE( track_list_select, ISingleSelectMediaTrackList, struct video_track_list, IVectorView_VideoTrack_iface )
+
+static HRESULT WINAPI track_list_select_add_SelectedIndexChanged( ISingleSelectMediaTrackList *iface,
+        ITypedEventHandler_ISingleSelectMediaTrackList_IInspectable *handler, EventRegistrationToken *token )
+{
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+    return event_handlers_add( &impl_from_ISingleSelectMediaTrackList( iface )->selected_changed, (IUnknown *)handler, token );
+}
+
+static HRESULT WINAPI track_list_select_remove_SelectedIndexChanged( ISingleSelectMediaTrackList *iface, EventRegistrationToken token )
+{
+    return event_handlers_remove( &impl_from_ISingleSelectMediaTrackList( iface )->selected_changed, token );
+}
+
+static HRESULT WINAPI track_list_select_put_SelectedIndex( ISingleSelectMediaTrackList *iface, INT32 value )
+{
+    struct video_track_list *impl = impl_from_ISingleSelectMediaTrackList( iface );
+    BOOL changed;
+
+    TRACE( "iface %p, value %d.\n", iface, value );
+
+    AcquireSRWLockExclusive( &impl->lock );
+    changed = impl->selected != value;
+    impl->selected = value;
+    ReleaseSRWLockExclusive( &impl->lock );
+
+    if (changed) event_handlers_invoke( &impl->selected_changed, (IInspectable *)iface, NULL );
+    return S_OK;
+}
+
+static HRESULT WINAPI track_list_select_get_SelectedIndex( ISingleSelectMediaTrackList *iface, INT32 *value )
+{
+    struct video_track_list *impl = impl_from_ISingleSelectMediaTrackList( iface );
+
+    AcquireSRWLockShared( &impl->lock );
+    *value = impl->selected;
+    ReleaseSRWLockShared( &impl->lock );
+    TRACE( "iface %p, selected %d.\n", iface, *value );
+    return S_OK;
+}
+
+static const struct ISingleSelectMediaTrackListVtbl track_list_select_vtbl =
+{
+    track_list_select_QueryInterface,
+    track_list_select_AddRef,
+    track_list_select_Release,
+    track_list_select_GetIids,
+    track_list_select_GetRuntimeClassName,
+    track_list_select_GetTrustLevel,
+    track_list_select_add_SelectedIndexChanged,
+    track_list_select_remove_SelectedIndexChanged,
+    track_list_select_put_SelectedIndex,
+    track_list_select_get_SelectedIndex,
+};
+
+static HRESULT video_track_list_create( struct video_track_list **out )
+{
+    struct video_track_list *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IVectorView_VideoTrack_iface.lpVtbl = &track_list_vtbl;
+    impl->IIterable_VideoTrack_iface.lpVtbl = &track_list_iterable_vtbl;
+    impl->ISingleSelectMediaTrackList_iface.lpVtbl = &track_list_select_vtbl;
+    impl->ref = 1;
+    impl->selected = -1;
+    InitializeSRWLock( &impl->lock );
+    event_handlers_init( &impl->selected_changed );
+    *out = impl;
+    return S_OK;
+}
+
+/* MediaPlaybackItem */
+
+struct playback_item
+{
+    IMediaPlaybackItem IMediaPlaybackItem_iface;
+    IMediaPlaybackSource IMediaPlaybackSource_iface;
+    LONG ref;
+
+    IMediaSource2 *source;
+    struct video_track_list *video_tracks;
+    struct event_handlers audio_tracks_changed;
+    struct event_handlers video_tracks_changed;
+    struct event_handlers metadata_tracks_changed;
+};
+
+static const struct IMediaPlaybackItemVtbl playback_item_vtbl;
+
+static inline struct playback_item *impl_from_IMediaPlaybackItem( IMediaPlaybackItem *iface )
+{
+    return CONTAINING_RECORD( iface, struct playback_item, IMediaPlaybackItem_iface );
+}
+
+static struct playback_item *unsafe_impl_from_unknown( IUnknown *unknown )
+{
+    IMediaPlaybackItem *item;
+    struct playback_item *impl;
+
+    if (!unknown || FAILED(IUnknown_QueryInterface( unknown, &IID_IMediaPlaybackItem, (void **)&item ))) return NULL;
+    impl = item->lpVtbl == &playback_item_vtbl ? impl_from_IMediaPlaybackItem( item ) : NULL;
+    IMediaPlaybackItem_Release( item );
+    return impl;
+}
+
+static HRESULT WINAPI playback_item_QueryInterface( IMediaPlaybackItem *iface, REFIID iid, void **out )
+{
+    struct playback_item *impl = impl_from_IMediaPlaybackItem( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IMediaPlaybackItem ))
+        *out = &impl->IMediaPlaybackItem_iface;
+    else if (IsEqualGUID( iid, &IID_IMediaPlaybackSource ))
+        *out = &impl->IMediaPlaybackSource_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI playback_item_AddRef( IMediaPlaybackItem *iface )
+{
+    struct playback_item *impl = impl_from_IMediaPlaybackItem( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p increasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI playback_item_Release( IMediaPlaybackItem *iface )
+{
+    struct playback_item *impl = impl_from_IMediaPlaybackItem( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        event_handlers_clear( &impl->audio_tracks_changed );
+        event_handlers_clear( &impl->video_tracks_changed );
+        event_handlers_clear( &impl->metadata_tracks_changed );
+        IVectorView_VideoTrack_Release( &impl->video_tracks->IVectorView_VideoTrack_iface );
+        if (impl->source) IMediaSource2_Release( impl->source );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI playback_item_GetIids( IMediaPlaybackItem *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
