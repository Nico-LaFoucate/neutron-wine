+        IUriRuntimeClass *uri, HSTRING content_type, IAsyncOperation_AdaptiveMediaSourceCreationResult **result )
+{
+    TRACE( "iface %p, stream %p, uri %p, content_type %s, result %p.\n", iface, stream, uri, debugstr_hstring( content_type ), result );
+    return adaptive_operation_create( AdaptiveMediaSourceCreationStatus_UnsupportedManifestContentType,
+                                      MF_E_UNSUPPORTED_FORMAT, result );
+}
+
+static HRESULT WINAPI adaptive_statics_CreateFromStreamWithDownloaderAsync( IAdaptiveMediaSourceStatics *iface, IInspectable *stream,
+        IUriRuntimeClass *uri, HSTRING content_type, IInspectable *http_client, IAsyncOperation_AdaptiveMediaSourceCreationResult **result )
+{
+    TRACE( "iface %p, stream %p, uri %p, content_type %s, http_client %p, result %p.\n", iface, stream, uri,
