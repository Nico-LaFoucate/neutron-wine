+static HRESULT WINAPI adaptive_statics_IsContentTypeSupported( IAdaptiveMediaSourceStatics *iface, HSTRING content_type, boolean *result )
+{
+    static const WCHAR *manifests[] =
+    {
+        L"application/vnd.apple.mpegurl", L"application/x-mpegurl", L"audio/mpegurl", L"audio/x-mpegurl",
+        L"application/dash+xml", L"application/vnd.ms-sstr+xml",
+    };
+    const WCHAR *type = WindowsGetStringRawBuffer( content_type, NULL );
+    UINT i;
+
+    *result = FALSE;
+    for (i = 0; i < ARRAY_SIZE(manifests); ++i) if (!wcsicmp( type, manifests[i] )) *result = TRUE;
+    TRACE( "iface %p, content_type %s -> %d.\n", iface, debugstr_w( type ), *result );
+    return S_OK;
+}
+
+static HRESULT WINAPI adaptive_statics_CreateFromUriAsync( IAdaptiveMediaSourceStatics *iface, IUriRuntimeClass *uri,
+        IAsyncOperation_AdaptiveMediaSourceCreationResult **result )
+{
+    TRACE( "iface %p, uri %p, result %p: no adaptive streaming, completing as not a manifest.\n", iface, uri, result );
+    return adaptive_operation_create( AdaptiveMediaSourceCreationStatus_UnsupportedManifestContentType,
+                                      MF_E_UNSUPPORTED_FORMAT, result );
+}
