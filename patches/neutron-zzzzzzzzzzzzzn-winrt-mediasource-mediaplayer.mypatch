+DEFINE_IINSPECTABLE( media_player5, IMediaPlayer5, struct media_player, IMediaPlayer_iface )
+
+static HRESULT WINAPI media_player5_add_VideoFrameAvailable( IMediaPlayer5 *iface,
+        ITypedEventHandler_MediaPlayer_IInspectable *handler, EventRegistrationToken *token )
+{
+    struct media_player *impl = impl_from_IMediaPlayer5( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+
+    hr = event_handlers_add( &impl->video_frame_available, (IUnknown *)handler, token );
+    if (impl->worker_wake) SetEvent( impl->worker_wake );
+    return hr;
+}
+
+static HRESULT WINAPI media_player5_remove_VideoFrameAvailable( IMediaPlayer5 *iface, EventRegistrationToken token )
+{
+    return event_handlers_remove( &impl_from_IMediaPlayer5( iface )->video_frame_available, token );
+}
+
+static HRESULT WINAPI media_player5_get_IsVideoFrameServerEnabled( IMediaPlayer5 *iface, boolean *value )
+{
+    struct media_player *impl = impl_from_IMediaPlayer5( iface );
+
+    AcquireSRWLockShared( &impl->state_lock );
+    *value = impl->frame_server;
+    ReleaseSRWLockShared( &impl->state_lock );
+    return S_OK;
+}
+
+static HRESULT WINAPI media_player5_put_IsVideoFrameServerEnabled( IMediaPlayer5 *iface, boolean value )
+{
+    struct media_player *impl = impl_from_IMediaPlayer5( iface );
+
+    TRACE( "iface %p, value %d.\n", iface, value );
+
+    AcquireSRWLockExclusive( &impl->state_lock );
+    impl->frame_server = value;
+    ReleaseSRWLockExclusive( &impl->state_lock );
+    if (impl->worker_wake) SetEvent( impl->worker_wake );
+    return S_OK;
+}
+
+static HRESULT copy_frame( struct media_player *impl, IDirect3DSurface *destination, const RECT *target )
+{
+    HRESULT hr = MF_E_INVALIDREQUEST;
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->engine) hr = media_engine_copy_frame_to_surface( impl->engine, &impl->frame_cache, destination, target );
+    LeaveCriticalSection( &impl->cs );
+
+    if (FAILED(hr)) WARN( "player %p: frame copy failed, hr %#lx.\n", impl, hr );
+    return hr;
+}
+
+static HRESULT WINAPI media_player5_CopyFrameToVideoSurface( IMediaPlayer5 *iface, IDirect3DSurface *destination )
+{
+    TRACE( "iface %p, destination %p.\n", iface, destination );
+    return copy_frame( impl_from_IMediaPlayer5( iface ), destination, NULL );
+}
+
+static HRESULT WINAPI media_player5_CopyFrameToVideoSurfaceWithTargetRectangle( IMediaPlayer5 *iface,
+        IDirect3DSurface *destination, Rect target_rectangle )
+{
+    RECT target;
+
+    TRACE( "iface %p, destination %p, target (%f,%f %fx%f).\n", iface, destination, target_rectangle.X,
+           target_rectangle.Y, target_rectangle.Width, target_rectangle.Height );
+
+    target.left = target_rectangle.X;
+    target.top = target_rectangle.Y;
+    target.right = target_rectangle.X + target_rectangle.Width;
+    target.bottom = target_rectangle.Y + target_rectangle.Height;
+    return copy_frame( impl_from_IMediaPlayer5( iface ), destination, &target );
+}
+
+static HRESULT WINAPI media_player5_CopyFrameToStereoscopicVideoSurfaces( IMediaPlayer5 *iface,
+        IDirect3DSurface *left, IDirect3DSurface *right )
+{
+    struct media_player *impl = impl_from_IMediaPlayer5( iface );
+    HRESULT hr;
+
+    FIXME( "iface %p, left %p, right %p: copying the mono frame to both.\n", iface, left, right );
+
+    if (FAILED(hr = copy_frame( impl, left, NULL ))) return hr;
+    return copy_frame( impl, right, NULL );
+}
+
+static const struct IMediaPlayer5Vtbl media_player5_vtbl =
+{
+    media_player5_QueryInterface,
+    media_player5_AddRef,
