+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    FIXME( "iface %p, instance %p: MediaSource has no default constructor.\n", iface, instance );
+    return E_NOTIMPL;
+}
