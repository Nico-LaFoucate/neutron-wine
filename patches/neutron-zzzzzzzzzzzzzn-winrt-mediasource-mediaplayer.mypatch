+    hr = media_source_create_from_url( value, WindowsGetStringRawBuffer( str, NULL ), &media_source );
+    WindowsDeleteString( str );
+    if (FAILED(hr)) return hr;
+
+    IMediaSource2_QueryInterface( media_source, &IID_IMediaPlaybackSource, (void **)&source );
+    IMediaSource2_Release( media_source );
+    hr = media_player_set_source( impl, source );
+    IMediaPlaybackSource_Release( source );
+    return hr;
 }
 
