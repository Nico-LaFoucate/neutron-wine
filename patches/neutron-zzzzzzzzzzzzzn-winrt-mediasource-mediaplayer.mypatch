+#include <stdlib.h>
+
+#include "private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mediaplayer);
+
+/* NEUTRON: the session reports its MediaPlayer's state. It holds the player weakly (the player
+ * owns the session); once the player is gone it reports an empty session. */
+
+struct playback_session
+{
+    IMediaPlaybackSession IMediaPlaybackSession_iface;
+    IMediaPlaybackSession3 IMediaPlaybackSession3_iface;
+    LONG ref;
+
+    SRWLOCK lock;
+    struct media_player *player;
+    struct event_handlers events[SESSION_EVENT_COUNT];
+    Rect normalized_rect;
+    INT32 rotation;
+};
+
+static const struct IMediaPlaybackSessionVtbl session_vtbl;
+
+static inline struct playback_session *impl_from_IMediaPlaybackSession( IMediaPlaybackSession *iface )
+{
+    return CONTAINING_RECORD( iface, struct playback_session, IMediaPlaybackSession_iface );
+}
+
+/* Returns the player with the session lock held shared; release with session_unlock. */
+static struct media_player *session_lock( struct playback_session *impl )
+{
+    AcquireSRWLockShared( &impl->lock );
+    return impl->player;
+}
+
+static void session_unlock( struct playback_session *impl )
+{
+    ReleaseSRWLockShared( &impl->lock );
+}
+
+static HRESULT WINAPI session_QueryInterface( IMediaPlaybackSession *iface, REFIID iid, void **out )
+{
+    struct playback_session *impl = impl_from_IMediaPlaybackSession( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IMediaPlaybackSession ))
+        *out = &impl->IMediaPlaybackSession_iface;
+    else if (IsEqualGUID( iid, &IID_IMediaPlaybackSession3 ))
+        *out = &impl->IMediaPlaybackSession3_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI session_AddRef( IMediaPlaybackSession *iface )
+{
+    return InterlockedIncrement( &impl_from_IMediaPlaybackSession( iface )->ref );
+}
+
+static ULONG WINAPI session_Release( IMediaPlaybackSession *iface )
+{
+    struct playback_session *impl = impl_from_IMediaPlaybackSession( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    UINT i;
+
+    if (!ref)
+    {
+        for (i = 0; i < SESSION_EVENT_COUNT; ++i) event_handlers_clear( &impl->events[i] );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI session_GetIids( IMediaPlaybackSession *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI session_GetRuntimeClassName( IMediaPlaybackSession *iface, HSTRING *name )
+{
+    return WindowsCreateString( RuntimeClass_Windows_Media_Playback_MediaPlaybackSession,
+                                wcslen( RuntimeClass_Windows_Media_Playback_MediaPlaybackSession ), name );
+}
+
+static HRESULT WINAPI session_GetTrustLevel( IMediaPlaybackSession *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+#define SESSION_EVENT( name, event )                                                                  \
+    static HRESULT WINAPI session_add_##name( IMediaPlaybackSession *iface,                            \
+            ITypedEventHandler_MediaPlaybackSession_IInspectable *handler, EventRegistrationToken *token ) \
+    {                                                                                                  \
+        TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );                           \
+        return event_handlers_add( &impl_from_IMediaPlaybackSession( iface )->events[event],          \
+                                   (IUnknown *)handler, token );                                       \
+    }                                                                                                  \
+    static HRESULT WINAPI session_remove_##name( IMediaPlaybackSession *iface, EventRegistrationToken token ) \
+    {                                                                                                  \
+        return event_handlers_remove( &impl_from_IMediaPlaybackSession( iface )->events[event], token ); \
+    }
+
+SESSION_EVENT( PlaybackStateChanged, SESSION_EVENT_STATE )
+SESSION_EVENT( PlaybackRateChanged, SESSION_EVENT_RATE )
+SESSION_EVENT( SeekCompleted, SESSION_EVENT_SEEK )
+SESSION_EVENT( BufferingStarted, SESSION_EVENT_BUFFERING_STARTED )
+SESSION_EVENT( BufferingEnded, SESSION_EVENT_BUFFERING_ENDED )
+SESSION_EVENT( BufferingProgressChanged, SESSION_EVENT_BUFFERING_PROGRESS )
+SESSION_EVENT( DownloadProgressChanged, SESSION_EVENT_DOWNLOAD_PROGRESS )
+SESSION_EVENT( NaturalDurationChanged, SESSION_EVENT_DURATION )
+SESSION_EVENT( PositionChanged, SESSION_EVENT_POSITION )
+SESSION_EVENT( NaturalVideoSizeChanged, SESSION_EVENT_VIDEO_SIZE )
+
+#undef SESSION_EVENT
+
+static HRESULT WINAPI session_get_MediaPlayer( IMediaPlaybackSession *iface, IMediaPlayer **value )
+{
+    struct playback_session *impl = impl_from_IMediaPlaybackSession( iface );
+    struct media_player *player = session_lock( impl );
+
+    if (player)
+    {
+        *value = media_player_get_iface( player );
+        IMediaPlayer_AddRef( *value );
+    }
+    else *value = NULL;
+    session_unlock( impl );
+    return S_OK;
+}
+
+static HRESULT WINAPI session_get_NaturalDuration( IMediaPlaybackSession *iface, TimeSpan *value )
+{
+    struct playback_session *impl = impl_from_IMediaPlaybackSession( iface );
+    struct media_player *player = session_lock( impl );
+    HRESULT hr = S_OK;
+
+    if (player) hr = media_player_get_duration( player, value );
+    else value->Duration = 0;
+    session_unlock( impl );
+    return hr;
+}
+
+static HRESULT WINAPI session_get_Position( IMediaPlaybackSession *iface, TimeSpan *value )
+{
+    struct playback_session *impl = impl_from_IMediaPlaybackSession( iface );
+    struct media_player *player = session_lock( impl );
+    HRESULT hr = S_OK;
+
+    if (player) hr = media_player_get_position( player, value );
+    else value->Duration = 0;
+    session_unlock( impl );
+    return hr;
+}
+
+static HRESULT WINAPI session_put_Position( IMediaPlaybackSession *iface, TimeSpan value )
+{
+    struct playback_session *impl = impl_from_IMediaPlaybackSession( iface );
+    struct media_player *player = session_lock( impl );
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, value %I64d.\n", iface, value.Duration );
+
+    if (player) hr = media_player_set_position( player, value );
+    session_unlock( impl );
+    return hr;
+}
+
+static HRESULT WINAPI session_get_PlaybackState( IMediaPlaybackSession *iface, MediaPlaybackState *value )
+{
+    struct playback_session *impl = impl_from_IMediaPlaybackSession( iface );
+    struct media_player *player = session_lock( impl );
+
+    *value = player ? media_player_get_state( player ) : MediaPlaybackState_None;
+    session_unlock( impl );
+    TRACE( "iface %p, state %d.\n", iface, *value );
+    return S_OK;
+}
+
+static HRESULT WINAPI session_get_CanSeek( IMediaPlaybackSession *iface, boolean *value )
+{
+    struct playback_session *impl = impl_from_IMediaPlaybackSession( iface );
+    struct media_player *player = session_lock( impl );
+
+    *value = player && media_player_can_seek( player );
+    session_unlock( impl );
+    return S_OK;
+}
+
+static HRESULT WINAPI session_get_CanPause( IMediaPlaybackSession *iface, boolean *value )
+{
+    *value = TRUE;
+    return S_OK;
+}
+
+static HRESULT WINAPI session_get_IsProtected( IMediaPlaybackSession *iface, boolean *value )
+{
+    *value = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI session_get_PlaybackRate( IMediaPlaybackSession *iface, DOUBLE *value )
+{
+    struct playback_session *impl = impl_from_IMediaPlaybackSession( iface );
+    struct media_player *player = session_lock( impl );
+    HRESULT hr = S_OK;
+
+    if (player) hr = media_player_get_rate( player, value );
+    else *value = 1.0;
+    session_unlock( impl );
+    return hr;
+}
+
+static HRESULT WINAPI session_put_PlaybackRate( IMediaPlaybackSession *iface, DOUBLE value )
+{
+    struct playback_session *impl = impl_from_IMediaPlaybackSession( iface );
+    struct media_player *player = session_lock( impl );
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, value %f.\n", iface, value );
+
+    if (player) hr = media_player_set_rate( player, value );
+    session_unlock( impl );
+    return hr;
+}
+
+static HRESULT WINAPI session_get_BufferingProgress( IMediaPlaybackSession *iface, DOUBLE *value )
+{
+    *value = 1.0;
+    return S_OK;
+}
+
+static HRESULT WINAPI session_get_DownloadProgress( IMediaPlaybackSession *iface, DOUBLE *value )
+{
+    *value = 1.0;
+    return S_OK;
+}
+
+static HRESULT WINAPI session_get_NaturalVideoHeight( IMediaPlaybackSession *iface, UINT32 *value )
+{
+    struct playback_session *impl = impl_from_IMediaPlaybackSession( iface );
+    struct media_player *player = session_lock( impl );
+    UINT32 width = 0;
+
+    *value = 0;
+    if (player) media_player_get_video_size( player, &width, value );
+    session_unlock( impl );
+    return S_OK;
+}
+
+static HRESULT WINAPI session_get_NaturalVideoWidth( IMediaPlaybackSession *iface, UINT32 *value )
+{
+    struct playback_session *impl = impl_from_IMediaPlaybackSession( iface );
+    struct media_player *player = session_lock( impl );
+    UINT32 height = 0;
+
+    *value = 0;
+    if (player) media_player_get_video_size( player, value, &height );
+    session_unlock( impl );
+    return S_OK;
+}
+
+static HRESULT WINAPI session_get_NormalizedSourceRect( IMediaPlaybackSession *iface, Rect *value )
+{
+    *value = impl_from_IMediaPlaybackSession( iface )->normalized_rect;
+    return S_OK;
+}
+
+static HRESULT WINAPI session_put_NormalizedSourceRect( IMediaPlaybackSession *iface, Rect value )
+{
+    FIXME( "iface %p: source rect (%f,%f %fx%f) not applied.\n", iface, value.X, value.Y, value.Width, value.Height );
+    impl_from_IMediaPlaybackSession( iface )->normalized_rect = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI session_get_StereoscopicVideoPackingMode( IMediaPlaybackSession *iface, INT32 *value )
+{
+    *value = 0; /* StereoscopicVideoPackingMode_None */
+    return S_OK;
+}
+
+static HRESULT WINAPI session_put_StereoscopicVideoPackingMode( IMediaPlaybackSession *iface, INT32 value )
+{
+    if (value) FIXME( "iface %p, packing mode %d not supported.\n", iface, value );
+    return S_OK;
+}
+
+static const struct IMediaPlaybackSessionVtbl session_vtbl =
+{
+    session_QueryInterface,
+    session_AddRef,
+    session_Release,
+    session_GetIids,
+    session_GetRuntimeClassName,
+    session_GetTrustLevel,
+    session_add_PlaybackStateChanged,
+    session_remove_PlaybackStateChanged,
+    session_add_PlaybackRateChanged,
+    session_remove_PlaybackRateChanged,
+    session_add_SeekCompleted,
+    session_remove_SeekCompleted,
+    session_add_BufferingStarted,
+    session_remove_BufferingStarted,
+    session_add_BufferingEnded,
+    session_remove_BufferingEnded,
+    session_add_BufferingProgressChanged,
+    session_remove_BufferingProgressChanged,
+    session_add_DownloadProgressChanged,
+    session_remove_DownloadProgressChanged,
+    session_add_NaturalDurationChanged,
+    session_remove_NaturalDurationChanged,
+    session_add_PositionChanged,
+    session_remove_PositionChanged,
+    session_add_NaturalVideoSizeChanged,
+    session_remove_NaturalVideoSizeChanged,
+    session_get_MediaPlayer,
+    session_get_NaturalDuration,
+    session_get_Position,
+    session_put_Position,
+    session_get_PlaybackState,
+    session_get_CanSeek,
+    session_get_CanPause,
+    session_get_IsProtected,
+    session_get_PlaybackRate,
+    session_put_PlaybackRate,
+    session_get_BufferingProgress,
+    session_get_DownloadProgress,
+    session_get_NaturalVideoHeight,
+    session_get_NaturalVideoWidth,
+    session_get_NormalizedSourceRect,
+    session_put_NormalizedSourceRect,
+    session_get_StereoscopicVideoPackingMode,
+    session_put_StereoscopicVideoPackingMode,
+};
+
+DEFINE_IINSPECTABLE( session3, IMediaPlaybackSession3, struct playback_session, IMediaPlaybackSession_iface )
+
+static HRESULT WINAPI session3_get_PlaybackRotation( IMediaPlaybackSession3 *iface, INT32 *value )
+{
+    *value = impl_from_IMediaPlaybackSession3( iface )->rotation;
+    return S_OK;
+}
+
+static HRESULT WINAPI session3_put_PlaybackRotation( IMediaPlaybackSession3 *iface, INT32 value )
+{
+    if (value) FIXME( "iface %p, rotation %d not applied.\n", iface, value );
+    impl_from_IMediaPlaybackSession3( iface )->rotation = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI session3_GetOutputDegradationPolicyState( IMediaPlaybackSession3 *iface, IInspectable **value )
+{
+    FIXME( "iface %p, value %p stub!\n", iface, value );
+    *value = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IMediaPlaybackSession3Vtbl session3_vtbl =
+{
+    session3_QueryInterface,
+    session3_AddRef,
+    session3_Release,
+    session3_GetIids,
+    session3_GetRuntimeClassName,
+    session3_GetTrustLevel,
+    session3_get_PlaybackRotation,
+    session3_put_PlaybackRotation,
+    session3_GetOutputDegradationPolicyState,
+};
+
+HRESULT playback_session_create( struct media_player *player, IMediaPlaybackSession **out )
+{
+    struct playback_session *impl;
+    UINT i;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IMediaPlaybackSession_iface.lpVtbl = &session_vtbl;
+    impl->IMediaPlaybackSession3_iface.lpVtbl = &session3_vtbl;
+    impl->ref = 1;
+    InitializeSRWLock( &impl->lock );
+    impl->player = player;
+    impl->normalized_rect.Width = 1.0f;
+    impl->normalized_rect.Height = 1.0f;
+    for (i = 0; i < SESSION_EVENT_COUNT; ++i) event_handlers_init( &impl->events[i] );
+    *out = &impl->IMediaPlaybackSession_iface;
+    return S_OK;
+}
+
+void playback_session_detach( IMediaPlaybackSession *session )
+{
+    struct playback_session *impl = impl_from_IMediaPlaybackSession( session );
+
+    AcquireSRWLockExclusive( &impl->lock );
+    impl->player = NULL;
+    ReleaseSRWLockExclusive( &impl->lock );
+}
+
+void playback_session_fire( IMediaPlaybackSession *session, int event )
+{
+    struct playback_session *impl = impl_from_IMediaPlaybackSession( session );
+
+    if (event < 0 || event >= SESSION_EVENT_COUNT) return;
+    event_handlers_invoke( &impl->events[event], (IInspectable *)session, NULL );
+}
