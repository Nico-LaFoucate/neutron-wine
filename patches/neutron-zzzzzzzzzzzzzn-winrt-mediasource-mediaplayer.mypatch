+/* NEUTRON: shared pieces of the WinRT playback stack (MediaSource, MediaPlaybackItem,
+ * MediaPlaybackSession and the MediaPlayer frame server), built on IMFMediaEngine. */
+
+/* A list of event handlers. Every WinRT typed event handler is IUnknown + Invoke(sender, args),
+ * so one list serves all of them. */
+struct event_handlers
+{
+    SRWLOCK lock;
+    struct event_handler_entry *entries;
+    UINT count, capacity;
+    LONGLONG next_token;
+};
+
+void event_handlers_init( struct event_handlers *list );
+void event_handlers_clear( struct event_handlers *list );
+HRESULT event_handlers_add( struct event_handlers *list, IUnknown *handler, EventRegistrationToken *token );
+HRESULT event_handlers_remove( struct event_handlers *list, EventRegistrationToken token );
+void event_handlers_invoke( struct event_handlers *list, IInspectable *sender, IInspectable *args );
+
+HRESULT vector_changed_event_args_create( CollectionChange change, UINT32 index, IInspectable **out );
+HRESULT media_player_failed_event_args_create( MediaPlayerError error, HRESULT code, IInspectable **out );
