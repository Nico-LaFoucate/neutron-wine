+HRESULT media_source_create_from_url( IUriRuntimeClass *uri, const WCHAR *url, IMediaSource2 **out )
+{
+    struct media_source *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    if (!(impl->url = wcsdup( url )))
+    {
+        free( impl );
+        return E_OUTOFMEMORY;
+    }
+    impl->IMediaSource2_iface.lpVtbl = &media_source2_vtbl;
+    impl->IMediaSource_iface.lpVtbl = &media_source_vtbl;
+    impl->IMediaSource3_iface.lpVtbl = &media_source3_vtbl;
+    impl->IMediaSource4_iface.lpVtbl = &media_source4_vtbl;
+    impl->IMediaPlaybackSource_iface.lpVtbl = &media_source_playback_vtbl;
+    impl->IClosable_iface.lpVtbl = &media_source_closable_vtbl;
+    impl->ref = 1;
+    impl->state = MediaSourceState_Initial;
+    event_handlers_init( &impl->open_completed );
+    event_handlers_init( &impl->state_changed );
+    if ((impl->uri = uri)) IUriRuntimeClass_AddRef( uri );
+
+    TRACE( "created source %p for %s.\n", impl, debugstr_w( url ) );
+    *out = &impl->IMediaSource2_iface;
+    return S_OK;
+}
+
+HRESULT media_source_get_url( IUnknown *source, BSTR *url )
+{
+    struct media_source *impl;
+
+    if (!(impl = unsafe_impl_from_unknown( source ))) return E_INVALIDARG;
+    if (!(*url = SysAllocString( impl->url ))) return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+void media_source_set_state( IUnknown *source, MediaSourceState state )
+{
+    struct media_source *impl;
+
+    if ((impl = unsafe_impl_from_unknown( source ))) impl->state = state;
+}
+
+/* The static factory: IActivationFactory + IMediaSourceStatics */
+
+struct media_source_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    IMediaSourceStatics IMediaSourceStatics_iface;
+    LONG ref;
+};
+
+static inline struct media_source_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct media_source_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct media_source_statics *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &impl->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_IMediaSourceStatics ))
+        *out = &impl->IMediaSourceStatics_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    return InterlockedIncrement( &impl_from_IActivationFactory( iface )->ref );
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    return InterlockedDecrement( &impl_from_IActivationFactory( iface )->ref );
+}
