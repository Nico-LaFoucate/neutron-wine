+/* The frame server copy.
+ *
+ * The media engine runs without a device of its own (frame server mode, software frames), so its
+ * GPU transfer path -- which needs the engine's device to BE the destination's device, and draws
+ * with that device's immediate context without restoring the app's pipeline state -- is not used.
+ * Instead the frame comes out at its native size into a WIC bitmap, is scaled here (bilinear,
+ * letterboxed to keep its aspect, as TransferVideoFrame does), and goes up with UpdateSubresource,
+ * which is a plain copy and leaves the app's bound state alone. */
+
+static void scale_bgra( const BYTE *src, UINT src_stride, UINT src_w, UINT src_h,
+                        BYTE *dst, UINT dst_stride, UINT dst_w, UINT dst_h, BOOL swap_rb )
+{
+    UINT x, y;
+
+    for (y = 0; y < dst_h; ++y)
+    {
+        /* 16.16 fixed point, pixel centres aligned */
+        LONG fy = (LONG)(((LONGLONG)(2 * y + 1) * src_h * 65536) / (2 * dst_h)) - 32768;
+        UINT y0, y1, wy;
+        BYTE *out = dst + y * dst_stride;
+
+        if (fy < 0) fy = 0;
+        y0 = fy >> 16;
+        wy = (fy & 0xffff) >> 8;
+        if (y0 >= src_h - 1) { y0 = src_h - 1; wy = 0; }
+        y1 = min( y0 + 1, src_h - 1 );
+
+        for (x = 0; x < dst_w; ++x)
+        {
+            LONG fx = (LONG)(((LONGLONG)(2 * x + 1) * src_w * 65536) / (2 * dst_w)) - 32768;
+            const BYTE *p00, *p01, *p10, *p11;
+            UINT x0, x1, wx, c;
+
+            if (fx < 0) fx = 0;
+            x0 = fx >> 16;
+            wx = (fx & 0xffff) >> 8;
+            if (x0 >= src_w - 1) { x0 = src_w - 1; wx = 0; }
+            x1 = min( x0 + 1, src_w - 1 );
+
+            p00 = src + y0 * src_stride + x0 * 4;
+            p01 = src + y0 * src_stride + x1 * 4;
+            p10 = src + y1 * src_stride + x0 * 4;
+            p11 = src + y1 * src_stride + x1 * 4;
+
+            for (c = 0; c < 3; ++c)
+            {
+                UINT top = p00[c] * (256 - wx) + p01[c] * wx;
+                UINT bottom = p10[c] * (256 - wx) + p11[c] * wx;
+                out[x * 4 + (swap_rb && c != 1 ? 2 - c : c)] = (top * (256 - wy) + bottom * wy) >> 16;
+            }
+            out[x * 4 + 3] = 0xff;
+        }
+    }
+}
+
+static HRESULT get_frame_bitmap( IMFMediaEngine *engine, IWICBitmap **cache, UINT *width, UINT *height )
+{
+    IWICImagingFactory *factory;
+    DWORD cx = 0, cy = 0;
+    UINT bw = 0, bh = 0;
+    RECT rect;
+    HRESULT hr;
+
+    if (FAILED(hr = IMFMediaEngine_GetNativeVideoSize( engine, &cx, &cy ))) return hr;
+    if (!cx || !cy) return MF_E_INVALIDREQUEST;
+
+    if (*cache) IWICBitmap_GetSize( *cache, &bw, &bh );
+    if (!*cache || bw != cx || bh != cy)
+    {
+        if (*cache) IWICBitmap_Release( *cache );
+        *cache = NULL;
+        if (FAILED(hr = WICCreateImagingFactory_Proxy( WINCODEC_SDK_VERSION, &factory ))) return hr;
+        hr = IWICImagingFactory_CreateBitmap( factory, cx, cy, &GUID_WICPixelFormat32bppBGRA,
+                                              WICBitmapCacheOnLoad, cache );
+        IWICImagingFactory_Release( factory );
+        if (FAILED(hr)) return hr;
+    }
+
+    SetRect( &rect, 0, 0, cx, cy );
+    if (FAILED(hr = IMFMediaEngine_TransferVideoFrame( engine, (IUnknown *)*cache, NULL, &rect, NULL )))
+        return hr;
+
+    *width = cx;
+    *height = cy;
+    return S_OK;
+}
+
+HRESULT media_engine_copy_frame_to_surface( IMFMediaEngine *engine, IWICBitmap **cache,
+                                            IDirect3DSurface *surface, const RECT *target )
+{
+    IDirect3DDxgiInterfaceAccess *access = NULL;
+    UINT src_w, src_h, src_stride, src_size, out_w, out_h, fit_w, fit_h, fit_x, fit_y, pitch;
+    ID3D11Texture2D *texture = NULL;
+    ID3D11DeviceContext *context;
+    D3D11_TEXTURE2D_DESC desc;
+    IWICBitmapLock *lock = NULL;
+    ID3D11Device *device;
+    BYTE *src, *buffer = NULL;
+    BOOL swap_rb;
+    RECT dst;
+    HRESULT hr;
+
+    if (!surface) return E_POINTER;
+
+    if (FAILED(hr = IDirect3DSurface_QueryInterface( surface, &IID_IDirect3DDxgiInterfaceAccess, (void **)&access )))
+    {
+        WARN( "surface %p is not a DXGI surface, hr %#lx.\n", surface, hr );
+        return hr;
+    }
+    hr = IDirect3DDxgiInterfaceAccess_GetInterface( access, &IID_ID3D11Texture2D, (void **)&texture );
+    IDirect3DDxgiInterfaceAccess_Release( access );
+    if (FAILED(hr))
+    {
+        WARN( "surface %p has no D3D11 texture, hr %#lx.\n", surface, hr );
+        return hr;
+    }
+
+    ID3D11Texture2D_GetDesc( texture, &desc );
+    switch (desc.Format)
+    {
+    case DXGI_FORMAT_B8G8R8A8_UNORM:
+    case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+    case DXGI_FORMAT_B8G8R8X8_UNORM:
+    case DXGI_FORMAT_B8G8R8X8_UNORM_SRGB:
+        swap_rb = FALSE;
+        break;
+    case DXGI_FORMAT_R8G8B8A8_UNORM:
+    case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+        swap_rb = TRUE;
+        break;
+    default:
+        FIXME( "unsupported destination format %#x.\n", desc.Format );
+        ID3D11Texture2D_Release( texture );
+        return MF_E_INVALIDMEDIATYPE;
+    }
+
+    if (target) dst = *target;
+    else SetRect( &dst, 0, 0, desc.Width, desc.Height );
+    dst.left = max( dst.left, 0 );
+    dst.top = max( dst.top, 0 );
+    dst.right = min( dst.right, (LONG)desc.Width );
+    dst.bottom = min( dst.bottom, (LONG)desc.Height );
+    if (dst.right <= dst.left || dst.bottom <= dst.top)
+    {
+        ID3D11Texture2D_Release( texture );
+        return S_OK;
+    }
+    out_w = dst.right - dst.left;
+    out_h = dst.bottom - dst.top;
+
+    if (FAILED(hr = get_frame_bitmap( engine, cache, &src_w, &src_h ))) goto done;
+    if (FAILED(hr = IWICBitmap_Lock( *cache, NULL, WICBitmapLockRead, &lock ))) goto done;
+    if (FAILED(hr = IWICBitmapLock_GetStride( lock, &src_stride ))) goto done;
+    if (FAILED(hr = IWICBitmapLock_GetDataPointer( lock, &src_size, &src ))) goto done;
+
+    /* letterbox: keep the frame's aspect inside the target */
+    if ((ULONGLONG)src_w * out_h > (ULONGLONG)src_h * out_w)
+    {
+        fit_w = out_w;
+        fit_h = max( 1, (UINT)((ULONGLONG)src_h * out_w / src_w) );
+    }
+    else
+    {
+        fit_h = out_h;
+        fit_w = max( 1, (UINT)((ULONGLONG)src_w * out_h / src_h) );
+    }
+    fit_x = (out_w - fit_w) / 2;
+    fit_y = (out_h - fit_h) / 2;
+
+    pitch = out_w * 4;
+    if (!(buffer = calloc( out_h, pitch )))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    if (fit_w != out_w || fit_h != out_h)
+    {
+        UINT i;
+        for (i = 0; i < out_w * out_h; ++i) buffer[i * 4 + 3] = 0xff;
+    }
+    scale_bgra( src, src_stride, src_w, src_h, buffer + fit_y * pitch + fit_x * 4, pitch, fit_w, fit_h, swap_rb );
+
+    ID3D11Texture2D_GetDevice( texture, &device );
+    ID3D11Device_GetImmediateContext( device, &context );
+    if (desc.Usage == D3D11_USAGE_DEFAULT)
+    {
+        D3D11_BOX box = { dst.left, dst.top, 0, dst.right, dst.bottom, 1 };
+        ID3D11DeviceContext_UpdateSubresource( context, (ID3D11Resource *)texture, 0, &box, buffer, pitch, 0 );
+    }
+    else if (desc.Usage == D3D11_USAGE_DYNAMIC || desc.Usage == D3D11_USAGE_STAGING)
+    {
+        D3D11_MAPPED_SUBRESOURCE map;
+        D3D11_MAP type = desc.Usage == D3D11_USAGE_DYNAMIC ? D3D11_MAP_WRITE_DISCARD : D3D11_MAP_WRITE;
+
+        if (SUCCEEDED(hr = ID3D11DeviceContext_Map( context, (ID3D11Resource *)texture, 0, type, 0, &map )))
+        {
+            UINT y;
+            for (y = 0; y < out_h; ++y)
+                memcpy( (BYTE *)map.pData + (dst.top + y) * map.RowPitch + dst.left * 4, buffer + y * pitch, pitch );
+            ID3D11DeviceContext_Unmap( context, (ID3D11Resource *)texture, 0 );
+        }
+    }
+    else
+    {
+        FIXME( "unsupported destination usage %#x.\n", desc.Usage );
+        hr = E_INVALIDARG;
+    }
+    ID3D11DeviceContext_Release( context );
+    ID3D11Device_Release( device );
+
+done:
+    free( buffer );
+    if (lock) IWICBitmapLock_Release( lock );
+    ID3D11Texture2D_Release( texture );
+    return hr;
+}
