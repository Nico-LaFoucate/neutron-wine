+/* exported by windowscodecs; creates the factory without needing COM on the calling thread */
+HRESULT WINAPI WICCreateImagingFactory_Proxy( UINT version, IWICImagingFactory **factory );
+
+/* Every TypedEventHandler<TSender, TArgs> has this layout: IUnknown, then Invoke(sender, args). */
+struct generic_handler;
+struct generic_handler_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)( struct generic_handler *iface, REFIID iid, void **out );
+    ULONG (WINAPI *AddRef)( struct generic_handler *iface );
+    ULONG (WINAPI *Release)( struct generic_handler *iface );
+    HRESULT (WINAPI *Invoke)( struct generic_handler *iface, IInspectable *sender, IInspectable *args );
+};
+struct generic_handler
+{
+    const struct generic_handler_vtbl *lpVtbl;
+};
+
+struct event_handler_entry
+{
+    LONGLONG token;
+    IUnknown *handler;
+};
+
+void event_handlers_init( struct event_handlers *list )
+{
+    InitializeSRWLock( &list->lock );
+    list->entries = NULL;
+    list->count = list->capacity = 0;
+    list->next_token = 1;
+}
+
+void event_handlers_clear( struct event_handlers *list )
+{
+    UINT i;
+
+    AcquireSRWLockExclusive( &list->lock );
+    for (i = 0; i < list->count; ++i) IUnknown_Release( list->entries[i].handler );
+    free( list->entries );
+    list->entries = NULL;
+    list->count = list->capacity = 0;
+    ReleaseSRWLockExclusive( &list->lock );
+}
+
+HRESULT event_handlers_add( struct event_handlers *list, IUnknown *handler, EventRegistrationToken *token )
+{
+    HRESULT hr = S_OK;
+
+    if (!handler || !token) return E_POINTER;
+
+    AcquireSRWLockExclusive( &list->lock );
+    if (list->count == list->capacity)
+    {
+        UINT capacity = list->capacity ? list->capacity * 2 : 4;
+        struct event_handler_entry *entries = realloc( list->entries, capacity * sizeof(*entries) );
+        if (!entries) hr = E_OUTOFMEMORY;
+        else
+        {
+            list->entries = entries;
+            list->capacity = capacity;
+        }
+    }
+    if (SUCCEEDED(hr))
+    {
+        IUnknown_AddRef( handler );
+        list->entries[list->count].handler = handler;
+        list->entries[list->count].token = list->next_token;
+        token->value = list->next_token++;
+        list->count++;
+    }
+    ReleaseSRWLockExclusive( &list->lock );
+    return hr;
+}
+
+HRESULT event_handlers_remove( struct event_handlers *list, EventRegistrationToken token )
+{
+    IUnknown *handler = NULL;
+    UINT i;
+
+    AcquireSRWLockExclusive( &list->lock );
+    for (i = 0; i < list->count; ++i)
+    {
+        if (list->entries[i].token != token.value) continue;
+        handler = list->entries[i].handler;
+        memmove( &list->entries[i], &list->entries[i + 1], (list->count - i - 1) * sizeof(*list->entries) );
+        list->count--;
+        break;
+    }
+    ReleaseSRWLockExclusive( &list->lock );
+
+    if (handler) IUnknown_Release( handler );
+    return S_OK;
+}
+
+void event_handlers_invoke( struct event_handlers *list, IInspectable *sender, IInspectable *args )
+{
+    IUnknown *stack[8], **handlers = stack;
+    UINT i, count;
+
+    /* Call the handlers without the lock held: a handler may add or remove handlers. */
+    AcquireSRWLockShared( &list->lock );
+    count = list->count;
+    if (count > ARRAY_SIZE(stack) && !(handlers = malloc( count * sizeof(*handlers) ))) count = 0;
+    for (i = 0; i < count; ++i)
+    {
+        handlers[i] = list->entries[i].handler;
+        IUnknown_AddRef( handlers[i] );
+    }
+    ReleaseSRWLockShared( &list->lock );
+
+    for (i = 0; i < count; ++i)
+    {
+        struct generic_handler *handler = (struct generic_handler *)handlers[i];
+        HRESULT hr = handler->lpVtbl->Invoke( handler, sender, args );
+        if (FAILED(hr)) WARN( "handler %p returned %#lx.\n", handler, hr );
+        IUnknown_Release( handlers[i] );
+    }
+    if (handlers != stack) free( handlers );
+}
+
+/* IVectorChangedEventArgs */
+
+struct vector_changed_args
+{
+    IVectorChangedEventArgs IVectorChangedEventArgs_iface;
+    LONG ref;
+    CollectionChange change;
+    UINT32 index;
+};
+
+static inline struct vector_changed_args *impl_from_IVectorChangedEventArgs( IVectorChangedEventArgs *iface )
+{
+    return CONTAINING_RECORD( iface, struct vector_changed_args, IVectorChangedEventArgs_iface );
+}
+
+static HRESULT WINAPI vector_changed_args_QueryInterface( IVectorChangedEventArgs *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IVectorChangedEventArgs ))
+    {
+        *out = iface;
+        IInspectable_AddRef( (IInspectable *)iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI vector_changed_args_AddRef( IVectorChangedEventArgs *iface )
+{
+    return InterlockedIncrement( &impl_from_IVectorChangedEventArgs( iface )->ref );
+}
+
+static ULONG WINAPI vector_changed_args_Release( IVectorChangedEventArgs *iface )
+{
+    struct vector_changed_args *impl = impl_from_IVectorChangedEventArgs( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI vector_changed_args_GetIids( IVectorChangedEventArgs *iface, ULONG *count, IID **iids )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI vector_changed_args_GetRuntimeClassName( IVectorChangedEventArgs *iface, HSTRING *name )
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI vector_changed_args_GetTrustLevel( IVectorChangedEventArgs *iface, TrustLevel *level )
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_changed_args_get_CollectionChange( IVectorChangedEventArgs *iface, CollectionChange *value )
+{
+    *value = impl_from_IVectorChangedEventArgs( iface )->change;
+    return S_OK;
+}
+
+static HRESULT WINAPI vector_changed_args_get_Index( IVectorChangedEventArgs *iface, UINT32 *value )
+{
+    *value = impl_from_IVectorChangedEventArgs( iface )->index;
+    return S_OK;
+}
+
+static const struct IVectorChangedEventArgsVtbl vector_changed_args_vtbl =
+{
+    vector_changed_args_QueryInterface,
+    vector_changed_args_AddRef,
+    vector_changed_args_Release,
+    vector_changed_args_GetIids,
+    vector_changed_args_GetRuntimeClassName,
+    vector_changed_args_GetTrustLevel,
+    vector_changed_args_get_CollectionChange,
+    vector_changed_args_get_Index,
+};
+
+HRESULT vector_changed_event_args_create( CollectionChange change, UINT32 index, IInspectable **out )
+{
+    struct vector_changed_args *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IVectorChangedEventArgs_iface.lpVtbl = &vector_changed_args_vtbl;
+    impl->ref = 1;
+    impl->change = change;
+    impl->index = index;
+    *out = (IInspectable *)&impl->IVectorChangedEventArgs_iface;
+    return S_OK;
+}
