win32u: readable text on the selected owner-drawn menu item too (InDesign font menu)

Operator, on the Windows 10 InDesign font menu: "Why does the highlighted text become black?"

The readable-text rule (owner-drawn-menu-readable-text) repaints InDesign's black text only when at
least half the row is exactly COLOR_MENU. The hovered row is not: InDesign fills it with
COLOR_MENUHILIGHT (64 in Neutron's palette) and draws the name and "Sample" in black, so the rule
skipped it and the text stayed black on dark gray (411 near-black pixels in that row). On the
Windows 11 path it looked fine only because InDesign's highlight bar covered a fraction of the row.

The selected item may now instead be mostly COLOR_MENUHILIGHT; its text is then mapped to
COLOR_HIGHLIGHTTEXT, the color Windows puts on that background, with the same three conditions
(dark neutral background whose text color reads on it, at least half the row is that color,
near-black pixels present). Rows that are mostly COLOR_MENU behave exactly as before. With Windows'
default light palette COLOR_MENUHILIGHT is blue, not neutral, so the rule still never acts.

Harness preserved-fixes/harnesses/odmenu-text.c, new row 4 (selected by keyboard, filled with
COLOR_MENUHILIGHT, black text): dark palette on 11.10-136 FAILS (darkest 0, lightest 64), patched
PASSES (darkest 64, lightest 255), rows 1-3 unchanged; light palette passes before and after (black
kept). InDesign 2026 (Windows 10 mode, 175%): the hovered row is background 64 with text up to 255
and nothing darker than the background.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

--- a/dlls/win32u/menu.c
+++ b/dlls/win32u/menu.c
@@ -2244,20 +2244,35 @@
  *   - the row contains near-black pixels (the app drew black text, not a light-on-dark design).
  * Then every neutral pixel darker than the menu color is mapped from "black text over the menu color"
  * to "menu text over the menu color" with the same coverage, so antialiasing is kept. Colored pixels
- * (color previews, emoji) and anything lighter than the background are left alone. */
-static void neutron_readable_owner_drawn_menu_item( HDC hdc, const RECT *rect )
+ * (color previews, emoji) and anything lighter than the background are left alone.
+ *
+ * The selected item may instead be filled with COLOR_MENUHILIGHT, as Windows' flat menus fill it and as
+ * InDesign fills its own selected row; its text is then mapped to COLOR_HIGHLIGHTTEXT, the color Windows
+ * puts on that background. The same three conditions apply to that pair. */
+static void neutron_readable_owner_drawn_menu_item( HDC hdc, const RECT *rect, BOOL selected )
 {
-    COLORREF menu = get_sys_color( COLOR_MENU ), text = get_sys_color( COLOR_MENUTEXT );
-    int w = rect->right - rect->left, h = rect->bottom - rect->top, bg = GetGValue( menu ), fg = GetGValue( text );
+    static const int back_index[2] = { COLOR_MENU, COLOR_MENUHILIGHT };
+    static const int text_index[2] = { COLOR_MENUTEXT, COLOR_HIGHLIGHTTEXT };
+    int w = rect->right - rect->left, h = rect->bottom - rect->top, back[2], fore[2], k, bg, fg;
     BITMAPINFO info = {{ sizeof(BITMAPINFOHEADER) }};
-    unsigned int i, n, at_bg = 0, near_black = 0, *px;
+    unsigned int i, n, at_back[2] = { 0, 0 }, near_black = 0, *px;
     void *bits = NULL;
     HBITMAP dib;
     HGDIOBJ old;
     HDC mem;
 
     if (w <= 0 || h <= 0) return;
-    if (GetRValue( menu ) != bg || GetBValue( menu ) != bg || bg >= 96 || fg < 2 * bg + 64) return;
+    /* back[k] = -1: that background is not a dark neutral one with readable text, so leave it alone */
+    for (k = 0; k < 2; k++)
+    {
+        COLORREF b = get_sys_color( back_index[k] ), t = get_sys_color( text_index[k] );
+        back[k] = GetGValue( b );
+        fore[k] = GetGValue( t );
+        if (GetRValue( b ) != back[k] || GetBValue( b ) != back[k] || back[k] >= 96 || fore[k] < 2 * back[k] + 64)
+            back[k] = -1;
+    }
+    if (!selected) back[1] = -1;
+    if (back[0] < 0 && back[1] < 0) return;
 
     if (!(mem = NtGdiCreateCompatibleDC( hdc ))) return;
     info.bmiHeader.biWidth = w;
@@ -2279,10 +2294,14 @@
     for (i = 0; i < n; i++)
     {
         unsigned int c = px[i] & 0xffffff;
-        if (c == (bg << 16 | bg << 8 | bg)) at_bg++;
+        if (back[0] >= 0 && c == (back[0] << 16 | back[0] << 8 | back[0])) at_back[0]++;
+        else if (back[1] >= 0 && c == (back[1] << 16 | back[1] << 8 | back[1])) at_back[1]++;
         else if (((c >> 16) & 0xff) < 24 && ((c >> 8) & 0xff) < 24 && (c & 0xff) < 24) near_black++;
     }
-    if (at_bg * 2 >= n && near_black)
+    k = at_back[1] > at_back[0] ? 1 : 0;
+    bg = back[k];
+    fg = fore[k];
+    if (bg >= 0 && at_back[k] * 2 >= n && near_black)
     {
         for (i = 0; i < n; i++)
         {
@@ -2555,7 +2574,7 @@
         NtGdiGetDCDword( hdc, NtGdiGetBkColor, &old_bk );
         NtGdiGetDCDword( hdc, NtGdiGetTextColor, &old_text );
         send_message( owner, WM_DRAWITEM, 0, (LPARAM)&dis );
-        neutron_readable_owner_drawn_menu_item( hdc, &rect );
+        neutron_readable_owner_drawn_menu_item( hdc, &rect, !!(item->fState & MF_HILITE) );
         /* Draw the popup-menu arrow */
         NtGdiGetAndSetDCDword( hdc, NtGdiGetBkColor, old_bk, NULL );
         NtGdiGetAndSetDCDword( hdc, NtGdiGetTextColor, old_text, NULL );
