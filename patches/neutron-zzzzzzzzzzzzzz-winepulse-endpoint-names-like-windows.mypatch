         LIST_FOR_EACH_ENTRY_SAFE(dev, dev_next, *list, PhysDevice, entry) {
             free(dev->name);
+            free(dev->endpoint_name);
+            free(dev->adapter_name);
             free(dev);
         }
     } while (*(++list));
@@ -573,6 +576,90 @@
