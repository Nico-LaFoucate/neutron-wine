winepulse/mmdevapi: name endpoints "<endpoint> (<card>)" like Windows (no two MME names alike)

Premiere's Audio Hardware list showed every device cut to 31 characters, and both inputs of a
Scarlett Solo as the same "Microphone (Scarlett Solo (3rd " (found by the operator while testing
Neutron#17). That list uses only MME: WAVEINCAPS/WAVEOUTCAPS szPname, MAXPNAMELEN (32) WCHARs,
which winmm fills with the endpoint's DEVPKEY_Device_FriendlyName cut to fit. Windows cuts there
too, but its friendly name is "<endpoint> (<adapter>)" ("Microphone (Realtek(R) Audio)"), so what
tells a card's endpoints apart comes first. mmdevapi named every endpoint "Microphone (<x>)" or
"Speakers (<x>)", with <x> PulseAudio's whole description, "<card> <endpoint>"
("Scarlett Solo (3rd Gen.) Input 1 Mic"); the cut kept only the card.

winepulse now splits the description into the card (PipeWire's device.description, or for
PulseAudio the part before device.profile.description) and the endpoint, and returns them for
DEVPKEY_Device_DeviceDesc and DEVPKEY_DeviceInterface_FriendlyName; a monitor keeps "Monitor of "
in front of its endpoint part. mmdevapi builds the friendly name from the two when the driver
supplies them: "Input 1 Mic (Scarlett Solo (3rd Gen.))". Descriptions that do not split (virtual
devices, the default "PulseAudio Input/Output") keep their names. Endpoint GUIDs are keyed by the
PulseAudio node name and do not change. Kill switch: NEUTRON_ENDPOINT_NAMES=0.

Harness: preserved-fixes/harnesses/mme-device-names.c lists each MME name next to its endpoint's
names and fails on a collision. On the operator's machine, 116: 12 of 14 names cut, the two
Scarlett inputs identical (FAILED); patched: "Input 1 Mic (Scarlett Solo (3rd" and
"Input 2 Inst/Line (Scarlett Sol", "Analog Stereo (Built-in Audio)" whole, no collision (PASSED);
patched with NEUTRON_ENDPOINT_NAMES=0: the 116 names exactly. A null sink described
"Neutron Test Card Line Out" with profile "Line Out" (the PulseAudio form) gives
"Line Out (Neutron Test Card)". Premiere 2025 (clean room, operator): the Audio Hardware lists
show the new names with no duplicates; the Scarlett output's "(Not working)" label appears with
the kill switch too, so it is not this change.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

--- a/dlls/mmdevapi/devenum.c
+++ b/dlls/mmdevapi/devenum.c
@@ -497,12 +497,29 @@
         if (!RegCreateKeyExW(key, L"Properties", 0, NULL, 0, KEY_WRITE|KEY_READ|KEY_WOW64_64KEY, NULL, &keyprop, NULL))
         {
             PROPVARIANT pv;
-            WCHAR *type;
+            WCHAR *type, *adapter = cur->drv_id;
+            PROPVARIANT desc_pv = { VT_EMPTY }, adapter_pv = { VT_EMPTY };
             DWORD len;
 
             pv.vt = VT_LPWSTR;
             pv.pwszVal = cur->drv_id;
 
+            /* Neutron: a driver that names the endpoint and its adapter separately (winepulse's
+             * get_endpoint_names) gets Windows' "<endpoint> (<adapter>)" friendly name, so the
+             * part that tells endpoints apart survives MME's 31-character cut. */
+            if (!(SUCCEEDED(set_driver_prop_value(id, flow, (const PROPERTYKEY*)&DEVPKEY_Device_DeviceDesc))
+                    && SUCCEEDED(MMDevice_GetPropValue(id, flow, (const PROPERTYKEY*)&DEVPKEY_Device_DeviceDesc, &desc_pv))
+                    && desc_pv.vt == VT_LPWSTR
+                    && SUCCEEDED(set_driver_prop_value(id, flow, (const PROPERTYKEY*)&DEVPKEY_DeviceInterface_FriendlyName))
+                    && SUCCEEDED(MMDevice_GetPropValue(id, flow, (const PROPERTYKEY*)&DEVPKEY_DeviceInterface_FriendlyName, &adapter_pv))
+                    && adapter_pv.vt == VT_LPWSTR))
+            {
+                PropVariantClear(&desc_pv);
+                PropVariantClear(&adapter_pv);
+            }
+            else
+                pv.pwszVal = adapter = adapter_pv.pwszVal;
+
             if (SUCCEEDED(set_driver_prop_value(id, flow, &devicepath_key))) {
                 PROPVARIANT pv2;
 
@@ -519,15 +536,21 @@
 
             MMDevice_SetPropValue(id, flow, (const PROPERTYKEY*)&DEVPKEY_DeviceInterface_FriendlyName, &pv);
 
-            pv.pwszVal = type = (WCHAR *)(flow == eCapture ? L"Microphone" : L"Speakers");
+            if (desc_pv.vt == VT_LPWSTR)
+                type = desc_pv.pwszVal;
+            else
+                type = (WCHAR *)(flow == eCapture ? L"Microphone" : L"Speakers");
+            pv.pwszVal = type;
             MMDevice_SetPropValue(id, flow, (const PROPERTYKEY*)&DEVPKEY_Device_DeviceDesc, &pv);
 
-            len = (wcslen(type) + wcslen(cur->drv_id) + wcslen(L" ()") + 1);
+            len = (wcslen(type) + wcslen(adapter) + wcslen(L" ()") + 1);
             pv.vt = VT_LPWSTR;
             pv.pwszVal = CoTaskMemAlloc(len * sizeof(WCHAR));
-            swprintf(pv.pwszVal, len, L"%ls (%ls)", type, cur->drv_id);
+            swprintf(pv.pwszVal, len, L"%ls (%ls)", type, adapter);
             MMDevice_SetPropValue(id, flow, (const PROPERTYKEY*)&DEVPKEY_Device_FriendlyName, &pv);
             CoTaskMemFree(pv.pwszVal);
+            PropVariantClear(&desc_pv);
+            PropVariantClear(&adapter_pv);
 
             pv.pwszVal = guidstr;
             MMDevice_SetPropValue(id, flow, &deviceinterface_key, &pv);
--- a/dlls/winepulse.drv/pulse.c
