 }
 
+static WCHAR *utf8_to_wstr(const char *str, size_t len)
+{
+    WCHAR *ret = malloc((len + 1) * sizeof(WCHAR));
+
+    if (!ret)
+        return NULL;
+    len = ntdll_umbstowcs(str, len, ret, len);
+    ret[len] = 0;
+    return ret;
+}
+
+/* Neutron: Windows names an endpoint "<endpoint> (<adapter>)" -- "Microphone (Realtek(R) Audio)",
+ * "DELL P2715Q (NVIDIA High Definition Audio)" -- and MME apps (Premiere's Audio Hardware list) get
+ * that name cut to MAXPNAMELEN - 1 = 31 characters, so what tells a card's endpoints apart survives
+ * the cut. mmdevapi named every endpoint "Microphone (<description>)" / "Speakers (<description>)",
+ * and PulseAudio's description is "<card> <endpoint>" ("Scarlett Solo (3rd Gen.) Input 1 Mic"): the
+ * cut kept only the card, and both Scarlett inputs became "Microphone (Scarlett Solo (3rd ".
+ * When the description splits into the card and the rest, mmdevapi gets the two parts as DeviceDesc
+ * and DeviceInterface_FriendlyName: "Input 1 Mic (Scarlett Solo (3rd Gen.))". A monitor keeps
+ * "Monitor of " in front of its endpoint part. Anything else (virtual devices, the default
+ * "PulseAudio Input/Output") keeps its name. Kill switch: NEUTRON_ENDPOINT_NAMES=0. */
+static void get_endpoint_names(PhysDevice *dev, const char *desc, pa_proplist *proplist)
+{
+    static const char monitor_of[] = "Monitor of ";
+    const size_t monitor_len = sizeof(monitor_of) - 1;
+    const char *card, *profile, *class, *endpoint = NULL, *env;
+    size_t card_len = 0, desc_len, profile_len = 0, endpoint_len;
+    BOOL monitor;
+    char *buf;
+
+    dev->endpoint_name = dev->adapter_name = NULL;
+    if (!proplist || !desc || ((env = getenv("NEUTRON_ENDPOINT_NAMES")) && *env == '0'))
+        return;
+
+    class = pa_proplist_gets(proplist, PA_PROP_DEVICE_CLASS);
+    monitor = class && !strcmp(class, "monitor");
+    if (monitor && !strncmp(desc, monitor_of, monitor_len))
+        desc += monitor_len;
+    desc_len = strlen(desc);
+    profile = pa_proplist_gets(proplist, PA_PROP_DEVICE_PROFILE_DESCRIPTION);
+    if (profile)
+        profile_len = strlen(profile);
+
+    /* PipeWire: device.description is the card's name ("Built-in Audio") */
+    card = pa_proplist_gets(proplist, PA_PROP_DEVICE_DESCRIPTION);
+    if (card && (card_len = strlen(card)) && card_len + 1 < desc_len
+            && !strncmp(desc, card, card_len) && desc[card_len] == ' ')
+        endpoint = desc + card_len + 1;
+    /* PulseAudio: the description ends with the profile's ("Analog Stereo") */
+    else if (profile_len && profile_len + 1 < desc_len && desc[desc_len - profile_len - 1] == ' '
+            && !strcmp(desc + desc_len - profile_len, profile))
+    {
+        card = desc;
+        card_len = desc_len - profile_len - 1;
+        endpoint = profile;
+    }
+    if (!endpoint)
+        return;
+
+    /* stay within get_device_name's limit; an HDMI node's rest carries the monitor's name too
+       ("Digital Stereo (HDMI) [DELL P2715Q]"), its profile alone is shorter */
+    endpoint_len = strlen(endpoint);
+    if (card_len + endpoint_len > MAX_DEVICE_NAME_LEN && profile_len && endpoint != profile)
+    {
+        endpoint = profile;
+        endpoint_len = profile_len;
+    }
+    if ((monitor ? monitor_len : 0) + endpoint_len + card_len > MAX_DEVICE_NAME_LEN)
+        return;
+
+    if (!(buf = malloc(monitor_len + endpoint_len + 1)))
+        return;
+    sprintf(buf, "%s%s", monitor ? monitor_of : "", endpoint);
+    dev->endpoint_name = utf8_to_wstr(buf, strlen(buf));
+    dev->adapter_name = utf8_to_wstr(card, card_len);
+    free(buf);
+    if (!dev->endpoint_name || !dev->adapter_name)
+    {
+        free(dev->endpoint_name);
+        free(dev->adapter_name);
+        dev->endpoint_name = dev->adapter_name = NULL;
+    }
+}
+
 static void fill_device_info(PhysDevice *dev, pa_proplist *p)
 {
     const char *buffer;
@@ -611,6 +698,7 @@
         free(dev);
         return;
     }
+    get_endpoint_names(dev, desc, proplist);
     dev->form = form;
     dev->index = index;
     dev->channel_mask = channel_mask;
@@ -2476,6 +2564,21 @@
     return TRUE;
 }
 
+static void get_string_prop(const WCHAR *str, struct get_prop_value_params *params)
+{
+    unsigned int size = (wcslen(str) + 1) * sizeof(WCHAR);
+
+    if (*params->buffer_size < size) {
+        params->result = E_NOT_SUFFICIENT_BUFFER;
+        *params->buffer_size = size;
+        return;
+    }
+    params->value->vt = VT_LPWSTR;
+    params->value->pwszVal = params->buffer;
+    memcpy(params->buffer, str, size);
+    params->result = S_OK;
+}
+
 static NTSTATUS pulse_get_prop_value(void *args)
 {
     static const GUID PKEY_AudioEndpoint_GUID = {
@@ -2484,6 +2587,12 @@
     static const PROPERTYKEY devicepath_key = { /* undocumented? - {b3f8fa53-0004-438e-9003-51a46e139bfc},2 */
         {0xb3f8fa53, 0x0004, 0x438e, {0x90, 0x03, 0x51, 0xa4, 0x6e, 0x13, 0x9b, 0xfc}}, 2
     };
+    static const PROPERTYKEY devicedesc_key = { /* DEVPKEY_Device_DeviceDesc */
+        {0xa45c254e, 0xdf1c, 0x4efd, {0x80, 0x20, 0x67, 0xd1, 0x46, 0xa8, 0x50, 0xe0}}, 2
+    };
+    static const PROPERTYKEY interfacename_key = { /* DEVPKEY_DeviceInterface_FriendlyName */
+        {0x026e516e, 0xb814, 0x414b, {0x83, 0xcd, 0x85, 0x6d, 0x6f, 0xef, 0x48, 0x22}}, 2
+    };
     struct get_prop_value_params *params = args;
     struct list *list = (params->flow == eRender) ? &g_phys_speakers : &g_phys_sources;
     PhysDevice *dev;
@@ -2494,6 +2603,12 @@
         if (IsEqualPropertyKey(*params->prop, devicepath_key)) {
             get_device_path(dev, params);
             return STATUS_SUCCESS;
+        } else if (dev->endpoint_name && IsEqualPropertyKey(*params->prop, devicedesc_key)) {
+            get_string_prop(dev->endpoint_name, params);
+            return STATUS_SUCCESS;
+        } else if (dev->adapter_name && IsEqualPropertyKey(*params->prop, interfacename_key)) {
+            get_string_prop(dev->adapter_name, params);
+            return STATUS_SUCCESS;
         } else if (IsEqualGUID(&params->prop->fmtid, &PKEY_AudioEndpoint_GUID)) {
             switch (params->prop->pid) {
             case 0:   /* FormFactor */
