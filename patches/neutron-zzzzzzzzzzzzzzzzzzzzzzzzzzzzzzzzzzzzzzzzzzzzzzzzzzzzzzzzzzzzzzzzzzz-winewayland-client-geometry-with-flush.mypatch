--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -378,6 +378,42 @@
     return region;
 }
 
+/* NEUTRON client-geom-batch (see winewayland's neutron_client_geom_batch): the driver leaves a client surface's new
+ * geometry for the window's next commit, the window surface flush. After a SetWindowPos that updated on-screen client
+ * surfaces (`moved` and its subtree, or every one of the toplevel's when `moved` is 0, as update_client_surfaces), queue
+ * the toplevel's window surface so the next real flush (window_surface_publish_geometry, dce.c) makes that commit even
+ * when nothing was painted. Kill switch NEUTRON_CLIENT_GEOM_BATCH=0. */
+static void publish_client_geometry( HWND toplevel, HWND moved )
+{
+    static int on = -1;
+    struct client_surface *surface;
+    struct window_surface *window_surface = NULL;
+    BOOL found = FALSE;
+    WND *win;
+
+    if (on < 0) { const char *e = getenv( "NEUTRON_CLIENT_GEOM_BATCH" ); on = !(e && e[0] == '0'); }
+    if (!on || !toplevel) return;
+
+    pthread_mutex_lock( &surfaces_lock );
+    LIST_FOR_EACH_ENTRY( surface, &client_surfaces, struct client_surface, entry )
+    {
+        if (!surface->hwnd || surface->offscreen) continue;
+        if (NtUserGetAncestor( surface->hwnd, GA_ROOT ) != toplevel) continue;
+        if (moved && surface->hwnd != moved && !is_child( moved, surface->hwnd )) continue;
+        found = TRUE;
+        break;
+    }
+    pthread_mutex_unlock( &surfaces_lock );
+    if (!found) return;
+
+    if (!(win = get_win_ptr( toplevel )) || win == WND_DESKTOP || win == WND_OTHER_PROCESS) return;
+    if ((window_surface = win->surface)) window_surface_add_ref( window_surface );
+    release_win_ptr( win );
+    if (!window_surface) return;
+    window_surface_publish_geometry( window_surface );
+    window_surface_release( window_surface );
+}
+
 void *client_surface_create( UINT size, const struct client_surface_funcs *funcs, HWND hwnd )
 {
     struct client_surface *surface;
@@ -3086,6 +3122,8 @@
          * toplevel; anything else only moves `hwnd`'s own subtree. */
         update_client_surfaces( toplevel, (swp_flags & SWP_NOZORDER) &&
                                           !(swp_flags & (SWP_SHOWWINDOW | SWP_HIDEWINDOW)) ? hwnd : 0 );
+        publish_client_geometry( toplevel, (swp_flags & SWP_NOZORDER) &&
+                                           !(swp_flags & (SWP_SHOWWINDOW | SWP_HIDEWINDOW)) ? hwnd : 0 );
 
         /* NEUTRON: if this move took a per-monitor-DPI-aware top-level window onto a monitor with a
          * different dpi, tell it so it re-renders its UI at the new dpi. Wine has no WM_DPICHANGED
--- a/dlls/winewayland.drv/waylanddrv.h
+++ b/dlls/winewayland.drv/waylanddrv.h
@@ -371,7 +371,11 @@
     wl_fixed_t vp_src[4];
     int vp_dst_w, vp_dst_h;
     LONG vp_dirty;
+    /* NEUTRON client-geom-batch: window management changed the position or crop and left it for the toplevel's next
+     * commit (see neutron_client_geom_batch) */
+    BOOL geom_pending;
 };
+BOOL neutron_client_geom_batch(void);
 
 struct wayland_shm_buffer
 {
--- a/dlls/winewayland.drv/wayland_surface.c
+++ b/dlls/winewayland.drv/wayland_surface.c
@@ -3895,6 +3895,26 @@
     return NULL;
 }
 
+/* NEUTRON client-geom-batch (2026-10-22, Premiere Pro media bin: "the image of another thumbnail would flicker over the
+ * place of another thumbnail for a split second"). A GPU child window's new position or crop from window management
+ * (SetWindowPos, a container scrolling) used to be committed to the compositor at once, one parent commit per call. An
+ * app that moves a window and hides it straight after then shows the move: Premiere moves its hover preview, still
+ * visible, to a parking spot and hides it ~0.5 ms later, and the preview's frame flashed there (5 frames in 133 such
+ * moves on the nested desk, 0 with the commit left out). Wine already publishes a window's GDI content in batches, when
+ * the thread goes idle (flush_window_surfaces); this publishes child geometry with that same commit, so the
+ * compositor sees the window and its children together, as DWM composes a window's surface and its child visuals in
+ * one frame. win32u marks the window surface dirty after such a change (publish_client_geometry), so the commit comes
+ * at the latest with the next idle flush (50 ms on a thread that never idles); a present to any of the window's client
+ * surfaces commits it sooner. A crop change is committed synchronized with that commit
+ * (set_window_surface_contents), keeping crop and position together. Kill switch NEUTRON_CLIENT_GEOM_BATCH=0 (read by
+ * win32u too). */
+BOOL neutron_client_geom_batch(void)
+{
+    static int on = -1;
+    if (on < 0) on = neutron_gate("NEUTRON_CLIENT_GEOM_BATCH", TRUE);
+    return on;
+}
+
 /* NEUTRON round-34 lock-order fix: variant taking a PRE-COMPUTED client rect so
  * the vkQueuePresent-thread caller (wayland_client_surface_update) can perform
  * all user-lock queries BEFORE taking win_data_mutex. rect==NULL keeps the
@@ -3980,6 +4000,15 @@
 
     wayland_surface_reconfigure_client(surface, client, &client_rect, clip);
 
+    /* NEUTRON client-geom-batch: window management (not a present) leaves the new position and crop for the
+     * toplevel's next commit, see neutron_client_geom_batch(). Only when the toplevel publishes window surface contents:
+     * without them no flush would ever make that commit. */
+    if (neutron_client_geom_batch() && !client->client.present_busy && toplevel_data->window_contents)
+    {
+        client->geom_pending = TRUE;
+        return;
+    }
+
     /* NEUTRON: a viewport change (crop/size) is CLIENT-surface state and shows only when that surface commits; the
      * position is parent state and shows with the commit below. Left to the app's next present, a container
      * scrolling a video moved it at once but cropped it a frame late (flicker at the clip edge), and a paused
--- a/dlls/winewayland.drv/window.c
+++ b/dlls/winewayland.drv/window.c
@@ -2451,8 +2451,35 @@
     {
         if (wayland_surface_reconfigure(wayland_surface))
         {
+            /* NEUTRON client-geom-batch: this commit applies the positions window management left pending for this
+             * window's client subsurfaces; their pending crops go out synchronized with it. Same sequence as
+             * wayland_client_surface_attach_rect's, never inside a present (present_busy). */
+            struct wayland_client_surface *synced[32];
+            struct wayland_win_data *d;
+            UINT i, nsynced = 0;
+
+            RB_FOR_EACH_ENTRY(d, &win_data_rb, struct wayland_win_data, entry)
+            {
+                struct wayland_client_surface *c = d->client_surface;
+
+                if (!c || !c->geom_pending || c->toplevel_wl_surface != wayland_surface->wl_surface) continue;
+                c->geom_pending = FALSE;
+                if (nsynced < ARRAY_SIZE(synced) && c->vp_dirty && c->client.buffer_width && c->wl_subsurface &&
+                    !InterlockedCompareExchange(&c->client.present_busy, 1, 0))
+                {
+                    wl_subsurface_set_sync(c->wl_subsurface);
+                    wl_surface_commit(c->wl_surface);
+                    synced[nsynced++] = c;
+                }
+            }
             wayland_surface_attach_shm(wayland_surface, shm_buffer, damage_region);
             wl_surface_commit(wayland_surface->wl_surface);
+            for (i = 0; i < nsynced; i++)
+            {
+                wl_subsurface_set_desync(synced[i]->wl_subsurface);
+                InterlockedExchange(&synced[i]->vp_dirty, 0);
+                InterlockedExchange(&synced[i]->client.present_busy, 0);
+            }
             committed = TRUE;
         }
         else
