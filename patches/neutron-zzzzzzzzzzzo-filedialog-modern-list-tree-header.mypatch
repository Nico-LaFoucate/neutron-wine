 /* used to handle collapse main item column case */
 static inline BOOL LISTVIEW_DrawFocusRect(const LISTVIEW_INFO *infoPtr, HDC hdc)
 {
+    /* NEUTRON: skip the dotted rectangle when the focused item is also selected -- with
+     * LVS_EX_FULLROWSELECT the highlight already marks the row, and the marching ants inside it
+     * are the last Win9x tell. Focus on an UNSELECTED item still draws, because nothing else
+     * would show where the keyboard is. */
+    if (infoPtr->nFocusedItem >= 0
+        && (LISTVIEW_GetItemState(infoPtr, infoPtr->nFocusedItem, LVIS_SELECTED) & LVIS_SELECTED))
+        return FALSE;
+
     return (infoPtr->rcFocus.left < infoPtr->rcFocus.right) ?
             DrawFocusRect(hdc, &infoPtr->rcFocus) : FALSE;
 }
