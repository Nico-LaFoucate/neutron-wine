--- a/dlls/shell32/shlview.c
+++ b/dlls/shell32/shlview.c
@@ -382,6 +382,25 @@
 	if(!This->hWndList)
 	  return FALSE;
 
+        /* NEUTRON: forward FWF_FULLROWSELECT, which was being dropped on the floor.
+         *
+         * ebrowser.c already ORs FWF_FULLROWSELECT into fs.fFlags before CreateViewWindow, and
+         * the listview implements full-row select correctly in its classic path — but nothing
+         * here ever translated the shell flag into LVS_EX_FULLROWSELECT, so the file dialog's
+         * selection was a text-width blob rather than a row. That is the single most 1995-looking
+         * thing about it, and it was a missing translation rather than missing support.
+         *
+         * LVS_EX_DOUBLEBUFFER comes along because the hover state added in comctl32 invalidates a
+         * row with erase on every mouse move, and the list has no back buffer otherwise.
+         *
+         * ⚠️ Behaviour, deliberately: clicking the blank area to the right of a name now selects
+         * that row. That is what Windows does. Selection STATE and everything the dialog reads
+         * back are untouched — this changes which rectangle is painted and hit-tested. */
+        if (This->FolderSettings.fFlags & FWF_FULLROWSELECT)
+            SendMessageW(This->hWndList, LVM_SETEXTENDEDLISTVIEWSTYLE,
+                         LVS_EX_FULLROWSELECT | LVS_EX_DOUBLEBUFFER,
+                         LVS_EX_FULLROWSELECT | LVS_EX_DOUBLEBUFFER);
+
         This->ListViewSortInfo.bIsAscending = TRUE;
         This->ListViewSortInfo.nHeaderID = -1;
         This->ListViewSortInfo.nLastHeaderID = -1;
