   case WM_LBUTTONUP:
     return LISTVIEW_LButtonUp(infoPtr, (WORD)wParam, (SHORT)LOWORD(lParam), (SHORT)HIWORD(lParam));
 
+  case WM_MOUSELEAVE:
+    /* NEUTRON: drop the hover tint when the pointer leaves the list. Requested via TME_LEAVE in
+     * LISTVIEW_MouseMove; without this the last hovered row stays tinted. */
+    if (infoPtr->nHotItem != -1)
+    {
+        INT old_hot = infoPtr->nHotItem;
+        infoPtr->nHotItem = -1;
+        LISTVIEW_InvalidateItem(infoPtr, old_hot);
+    }
+    return 0;
+
   case WM_MOUSEMOVE:
     return LISTVIEW_MouseMove (infoPtr, (WORD)wParam, (SHORT)LOWORD(lParam), (SHORT)HIWORD(lParam));
 
