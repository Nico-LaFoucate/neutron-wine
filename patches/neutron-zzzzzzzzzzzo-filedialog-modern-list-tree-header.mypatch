+     * HDS_HOTTRACK (LISTVIEW_CreateHeader), so a file list's column headers could never hover.
+     * Requiring HDS_BUTTONS alone is enough to keep headers that are not buttons inert. */
     BOOL  hotTrackEnabled =
-        ((infoPtr->dwStyle & HDS_BUTTONS) && (infoPtr->dwStyle & HDS_HOTTRACK))
+        (infoPtr->dwStyle & HDS_BUTTONS)
