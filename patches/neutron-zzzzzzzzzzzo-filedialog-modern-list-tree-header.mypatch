     INT oldHotItem = infoPtr->iHotItem;
 
--- a/dlls/comctl32/listview.c
+++ b/dlls/comctl32/listview.c
@@ -347,6 +347,12 @@
 
 /* padding for items in list, report and small icon display modes */
 #define HEIGHT_PADDING 1
+/* NEUTRON: extra breathing room for REPORT/LIST/SMALLICON rows only (see
+ * LISTVIEW_CalculateItemHeight). HEIGHT_PADDING itself is left alone because it also sizes icon
+ * view labels and is reported through LVM_GETITEMSPACING. With 16px shell icons a row was 17px;
+ * this makes it ~23px, which is what stops a file list reading as 1995. An owner-draw app that
+ * sets nMeasureItemHeight still wins -- that override is applied after this. */
+#define ROW_PADDING 6
 
 /* offset of items in report display mode */
 #define REPORT_MARGINX 2
@@ -1108,6 +1114,12 @@
                 textcolor = comctl32_color.clrBtnText;
             }
         }
+        /* NEUTRON: hovered-but-unselected rows get the shared tint. customdraw_fill already sets
