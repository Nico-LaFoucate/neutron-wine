@@ -4194,6 +4216,34 @@
         notify_listview(infoPtr, LVN_HOTTRACK, &nmlv);
     }
 
+    /* NEUTRON: track the hovered row for PAINTING, independently of LISTVIEW_IsHotTracking().
+     *
+     * A file list is created without LVS_EX_TRACKSELECT/ONECLICK/TWOCLICK, so the block above
+     * never runs and nHotItem was only ever set by an explicit LVM_SETHOTITEM -- i.e. rows had no
+     * hover state at all. This sets nHotItem for drawing only: no LVN_HOTTRACK is sent, so
+     * LISTVIEW_SetCursor does not switch to the hand cursor and LISTVIEW_MouseHover's
+     * hover-selects-the-item behaviour stays off. Purely visual. */
+    {
+        TRACKMOUSEEVENT tme;
+        LVHITTESTINFO hot;
+
+        hot.pt = pt;
+        LISTVIEW_HitTest(infoPtr, &hot, TRUE, TRUE);
+
+        if (hot.iItem != infoPtr->nHotItem)
+        {
+            LISTVIEW_InvalidateItem(infoPtr, infoPtr->nHotItem);
+            infoPtr->nHotItem = hot.iItem;
+            LISTVIEW_InvalidateItem(infoPtr, infoPtr->nHotItem);
+        }
+
+        /* so the tint is cleared when the pointer leaves the control entirely */
+        tme.cbSize = sizeof(tme);
+        tme.dwFlags = TME_LEAVE;
+        tme.hwndTrack = infoPtr->hwndSelf;
+        _TrackMouseEvent(&tme);
+    }
+
     return 0;
 }
 
