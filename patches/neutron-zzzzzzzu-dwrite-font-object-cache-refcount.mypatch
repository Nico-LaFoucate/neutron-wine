--- a/dlls/dwrite/main.c
+++ b/dlls/dwrite/main.c
@@ -965,6 +965,32 @@
  * does NOT copy the font data, so the mapping has to outlive the face. Bounded,
  * least-recently-used first out, so a client that walks a font menu cannot grow
  * it without limit. */
+/* 🚨 THE ENTRY IS REFCOUNTED, AND IT HAS TO BE. The first cut of this cache handed
+ * `object` to a fontface and kept no count of who was using it. A fontface stores the
+ * value in fontface->font_object and dwrite_fontface_get_font_object() short-circuits on
+ * it being non-zero, so the face NEVER consults this cache again -- every later glyph load
+ * goes straight to that FT_Face. Eviction meanwhile called FT_Done_Face on it and released
+ * the stream fragment the face reads out of, while the face was still live and rendering.
+ *
+ * That is a use-after-free, and its signature is subtle rather than a crash: glyphs already
+ * rasterised sit in the fontface's own glyph cache and keep drawing correctly, so exactly
+ * the NEXT NOT-YET-CACHED CHARACTER comes back wrong. Observed in Premiere 2026-08-13 as one
+ * digit of a title rendering in Arial while the rest of the string stayed in the selected
+ * face -- and it survived until the app was restarted.
+ *
+ * It was aimed at the worst possible victim, too. Entries are promoted to the head only in
+ * factory_get_cached_font_object(), which is reachable only while fontface->font_object is
+ * still 0 -- i.e. once, at face creation. A long-lived, heavily-rendering face is therefore
+ * never promoted, drifts to the tail, and is evicted FIRST. The LRU was inverted with respect
+ * to actual use.
+ *
+ * So: every fontface holding `object` owns a reference. Eviction unlinks but destroys only
+ * when the last user lets go, and it will not choose a live entry at all. That second rule
+ * also retires the inverted-LRU problem without touching the glyph hot path -- an actively
+ * rendering face has refcount > 0 and simply cannot be picked.
+ *
+ * ⚠️ Do NOT "simplify" this back to freeing on eviction, and do NOT raise the cap instead.
+ * The cap was never the bug. */
 #define DWRITE_FONT_OBJECT_CACHE_MAX 48
 
 struct cached_font_object
@@ -976,6 +1002,8 @@
     UINT32 index;
     UINT32 key_size;
     void *key;
+    LONG refcount;   /* live fontfaces using ->object */
+    BOOL unlinked;   /* evicted from the list, awaiting its last user */
 };
 
