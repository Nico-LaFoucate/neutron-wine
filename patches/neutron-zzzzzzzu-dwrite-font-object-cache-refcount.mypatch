+void factory_release_font_object(IDWriteFactory7 *iface, void *entry)
+{
+    struct dwritefactory *factory = impl_from_IDWriteFactory7(iface);
+    struct cached_font_object *cached = entry;
+    BOOL destroy = FALSE;
+
+    if (!cached) return;
+
+    EnterCriticalSection(&factory->cs);
+    if (--cached->refcount <= 0 && cached->unlinked)
+        destroy = TRUE;
+    LeaveCriticalSection(&factory->cs);
+
+    if (destroy)
+        release_cached_font_object(cached);
+}
